;; =============================================================================
;; src/structures_csg.carp — Subterranean Dungeon Structure Value Types
;;   Loads the shared `src/csg.carp` 3D SDF & `MatSDF` combinator kit and defines
;;   zero-allocation stack types (`CSGSample`, `CSGRaw`, `StructureDesc`,
;;   `LinkSeg`, `VertShaft`, `ChunkCSG`) for subterranean ruin complexes.
;; =============================================================================

(load "csg.carp")

;; `mode`:
;;   0 = `CSG_NONE`       (outside structure + collar; keep Simplex voxel untouched)
;;   1 = `CSG_SOLID`      (CSG masonry / rib / septum / pipe wall / bullion)
;;   2 = `CSG_AIR_OR_VAT` (carved room air, pipe bore, fluid vat, or doorway apron)
;;   3 = `CSG_COLLAR`     (3.5m smooth Euclidean SDF collar into surrounding cave rock/air)
;;   4 = `CSG_FOUNDATION` (battered Obsidian sub-foundation / viaduct piers over cave air)
(deftype CSGSample [
  mode Int
  sdf Float
  wall-sdf Float
  mat Float
  fluid Float
])

;; Intermediate unbaked CSG fields for boolean composition across intersecting connectors/shafts
(deftype CSGRaw [
  d-wall Double
  d-walk Double
  d-vat Double
  d-plinth Double
  mat Float
  fluid Float
])

(deftype StructureDesc [
  active Bool
  kind Int
  rot Int
  variant Int
  biome Int
  sx Double
  sy Double
  sz Double
  hx Double
  hy Double
  hz Double
])

;; Precomputed Axis-Aligned (`axis = 0` along X, `axis = 1` along Z) Human-Scale Corridor Leg
(deftype LinkSeg [
  active Bool
  axis Int
  style Int
  biome Int
  liq Float
  a0 Double
  a1 Double
  c-pos Double
  y0 Double
  y1 Double
  min-x Double
  max-x Double
  min-y Double
  max-y Double
  min-z Double
  max-z Double
])

;; Precomputed Vertical Helical Drop-Shaft (`ry <-> ry - 1` within a single `192m` segment)
(deftype VertShaft [
  active Bool
  biome Int
  vx Double
  vz Double
  y-top Double
  y-bot Double
  ang0 Double
  min-y Double
  max-y Double
])

;; Per-Chunk Pre-Culled CSG Descriptor (allocated on the C stack once per `32^3` chunk)
(deftype ChunkCSG [
  any-active Bool
  has-struct Bool
  sdesc StructureDesc
  keep-r Double
  s-min-x Double
  s-max-x Double
  s-min-y Double
  s-max-y Double
  s-min-z Double
  s-max-z Double
  leg-cnt Int
  l0 LinkSeg
  l1 LinkSeg
  l2 LinkSeg
  l3 LinkSeg
  l4 LinkSeg
  l5 LinkSeg
  l6 LinkSeg
  l7 LinkSeg
  vs0 VertShaft
  vs1 VertShaft
])

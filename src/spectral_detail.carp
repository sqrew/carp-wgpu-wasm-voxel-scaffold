;; =============================================================================
;; src/spectral_detail.carp — 3D Spectral IFFT Surface & SDF Imperfections
;;   Powered by `carp-math/fft.carp` (`Complex` + `FFT.fft!`).
;;   Synthesizes C-infinity seamlessly periodic 64x64x64 zero-mean fields:
;;     - Band A (`make-sdf-volume`): Near-Nyquist geometric SDF facets & crags
;;     - Band B (`make-gpu-rgba-volume`): 4 sculpted above-Nyquist micro-surface
;;       channels (.r granular pits, .g fibrous/strata flutes, .b cleavage
;;       facets, .a micro-cavity pores & Voronoi crack toothiness).
;; =============================================================================

(load "../../carp-math/fft.carp")

(defmodule SpectralDetail
  (defn lcg-next [s]
    (Double.mod (+ (* s 1664525.0) 1013904223.0) 4294967296.0))

  (defn k-coord [i]
    (Double.from-int (if (< i 32) i (- i 64))))

  (defn band-weight [band kx ky kz]
    (if (= band 1)
      ;; Channel .g: Anisotropic fibrous / stratified band (high k_xz, low k_y)
      (let [k-xz (Double.sqrt (+ (* kx kx) (* kz kz)))
            aky (Double.abs ky)]
        (if (or (< k-xz 3.5) (or (> k-xz 26.0) (> aky 8.0)))
          0.0
          (let [dr (/ (- k-xz 14.0) 4.2)
                dy (/ ky 1.7)]
            (* (Double.exp (* -0.5 (* dr dr)))
               (Double.exp (* -0.5 (* dy dy)))))))
      (let [kr (Double.sqrt (+ (* kx kx) (+ (* ky ky) (* kz kz))))]
        (if (= band 0)
          ;; Channel .r: Isotropic high-k granular / pitting ring
          (if (or (< kr 4.0) (> kr 25.0))
            0.0
            (let [d (/ (- kr 12.5) 4.0)]
              (Double.exp (* -0.5 (* d d)))))
          (if (= band 2)
            ;; Channel .b: Polyhedral cleavage & conchoidal facet harmonics
            (if (or (< kr 4.0) (> kr 16.0))
              0.0
              (let [ax (Double.abs kx)
                    ay (Double.abs ky)
                    az (Double.abs kz)
                    cube-sum (+ (* ax (* ax ax)) (+ (* ay (* ay ay)) (* az (* az az))))
                    kr3 (Double.max 1.0 (* kr (* kr kr)))
                    oct-lobe (+ 0.55 (* 0.45 (/ cube-sum kr3)))]
                (* (Double.pow kr -1.35) oct-lobe)))
            (if (= band 3)
              ;; Channel .a: Ultra-high-k micro-cavity & pre-fracture crackle
              (if (or (< kr 12.0) (> kr 28.0))
                0.0
                (let [d (/ (- kr 19.5) 3.6)]
                  (Double.exp (* -0.5 (* d d)))))
              ;; Band 4 (CPU SDF): Near-Nyquist geometric rock facets & crags
              (if (or (< kr 5.0) (> kr 16.0))
                0.0
                (let [d (/ (- kr 9.5) 3.0)]
                  (Double.exp (* -0.5 (* d d)))))))))))

  ;; Zero-inner-allocation 3D 64^3 inverse FFT using a single reusable 64-complex pencil
  (defn ifft3d-64! [vol line]
    (do
      ;; 1. X-pencils (4,096 lines)
      (for [z 0 64]
        (let [z-off (* z 4096)]
          (for [y 0 64]
            (let [row-off (+ z-off (* y 64))]
              (do
                (for [x 0 64]
                  (Array.aset! line x @(Array.unsafe-nth vol (+ row-off x))))
                (FFT.fft! line true)
                (for [x 0 64]
                  (Array.aset! vol (+ row-off x) @(Array.unsafe-nth line x))))))))
      ;; 2. Y-pencils (4,096 lines)
      (for [z 0 64]
        (let [z-off (* z 4096)]
          (for [x 0 64]
            (let [zx-off (+ z-off x)]
              (do
                (for [y 0 64]
                  (Array.aset! line y @(Array.unsafe-nth vol (+ zx-off (* y 64)))))
                (FFT.fft! line true)
                (for [y 0 64]
                  (Array.aset! vol (+ zx-off (* y 64)) @(Array.unsafe-nth line y))))))))
      ;; 3. Z-pencils (4,096 lines)
      (for [y 0 64]
        (let [y-off (* y 64)]
          (for [x 0 64]
            (let [yx-off (+ y-off x)]
              (do
                (for [z 0 64]
                  (Array.aset! line z @(Array.unsafe-nth vol (+ (* z 4096) yx-off))))
                (FFT.fft! line true)
                (for [z 0 64]
                  (Array.aset! vol (+ (* z 4096) yx-off) @(Array.unsafe-nth line z))))))))))

  ;; Populates `vol` in k-space for `(seed, band)`, runs 3D IFFT, and returns `0.65 / rms`
  (defn synthesize-band! [vol line seed band]
    (let [s0 (Double.mod
               (+ (* (Double.from-int (Int.abs seed)) 747796405.0)
                  (* (Double.from-int (+ band 1)) 2891336453.0))
               4294967296.0)
          s (SpectralDetail.lcg-next (SpectralDetail.lcg-next s0))
          two-pi (* 2.0 Double.pi)]
      (do
        (for [iz 0 64]
          (let [kz (SpectralDetail.k-coord iz)
                z-off (* iz 4096)]
            (for [iy 0 64]
              (let [ky (SpectralDetail.k-coord iy)
                    zy-off (+ z-off (* iy 64))]
                (for [ix 0 64]
                  (let [idx (+ zy-off ix)]
                    (do
                      (set! s (SpectralDetail.lcg-next s))
                      (if (and (= ix 0) (and (= iy 0) (= iz 0)))
                        (Array.aset! vol idx (Complex.zero))
                        (let [kx (SpectralDetail.k-coord ix)
                              w (SpectralDetail.band-weight band kx ky kz)]
                          (if (<= w 0.000001)
                            (Array.aset! vol idx (Complex.zero))
                            (let [phi (* two-pi (/ s 4294967296.0))]
                              (Array.aset! vol idx (Complex.from-polar w phi)))))))))))))
        (SpectralDetail.ifft3d-64! vol line)
        (let [sum-sq 0.0]
          (do
            (for [i 0 262144]
              (let [re @(Complex.real (Array.unsafe-nth vol i))]
                (set! sum-sq (+ sum-sq (* re re)))))
            (let [sigma (Double.sqrt (/ sum-sq 262144.0))]
              (/ 0.65 (Double.max sigma 0.000000001))))))))

  ;; Generates interleaved 64x64x64 RGBA float volume (1,048,576 floats in (-1, +1))
  (defn make-gpu-rgba-volume [seed]
    (let [vol (Array.replicate 262144 &(Complex.zero))
          line (Array.replicate 64 &(Complex.zero))
          out (Array.allocate 1048576)]
      (do
        (for [band 0 4]
          (let [inv-sig (SpectralDetail.synthesize-band! &vol &line seed band)]
            (for [idx 0 262144]
              (let [re @(Complex.real (Array.unsafe-nth &vol idx))
                    val (Double.to-float (Double.tanh (* re inv-sig)))]
                (Array.aset! &out (+ (* idx 4) band) val)))))
        out)))

  ;; Generates 64x64x64 scalar float volume (262,144 floats in (-1, +1)) for near-Nyquist SDF crags
  (defn make-sdf-volume [seed]
    (let [vol (Array.replicate 262144 &(Complex.zero))
          line (Array.replicate 64 &(Complex.zero))
          out (Array.allocate 262144)
          inv-sig (SpectralDetail.synthesize-band! &vol &line seed 4)]
      (do
        (for [idx 0 262144]
          (let [re @(Complex.real (Array.unsafe-nth &vol idx))
                val (Double.to-float (Double.tanh (* re inv-sig)))]
            (Array.aset! &out idx val)))
        out)))

  ;; Seamless periodic trilinear sampler on [0, 64)^3 with exact bitwise-and 63 wrap
  (defn sample-sdf-3d [vol sx sy sz]
    (let [ux (- sx (* 64.0 (Double.floor (/ sx 64.0))))
          uy (- sy (* 64.0 (Double.floor (/ sy 64.0))))
          uz (- sz (* 64.0 (Double.floor (/ sz 64.0))))
          flx (Double.floor ux)
          fly (Double.floor uy)
          flz (Double.floor uz)
          ix0 (Int.bit-and (Double.to-int flx) 63)
          iy0 (Int.bit-and (Double.to-int fly) 63)
          iz0 (Int.bit-and (Double.to-int flz) 63)
          ix1 (Int.bit-and (+ ix0 1) 63)
          iy1 (Int.bit-and (+ iy0 1) 63)
          iz1 (Int.bit-and (+ iz0 1) 63)
          fx (- ux flx)
          fy (- uy fly)
          fz (- uz flz)
          z0 (* iz0 4096)
          z1 (* iz1 4096)
          y0 (* iy0 64)
          y1 (* iy1 64)
          c000 (Double.from-float @(Array.unsafe-nth vol (+ z0 (+ y0 ix0))))
          c100 (Double.from-float @(Array.unsafe-nth vol (+ z0 (+ y0 ix1))))
          c010 (Double.from-float @(Array.unsafe-nth vol (+ z0 (+ y1 ix0))))
          c110 (Double.from-float @(Array.unsafe-nth vol (+ z0 (+ y1 ix1))))
          c001 (Double.from-float @(Array.unsafe-nth vol (+ z1 (+ y0 ix0))))
          c101 (Double.from-float @(Array.unsafe-nth vol (+ z1 (+ y0 ix1))))
          c011 (Double.from-float @(Array.unsafe-nth vol (+ z1 (+ y1 ix0))))
          c111 (Double.from-float @(Array.unsafe-nth vol (+ z1 (+ y1 ix1))))
          c00 (+ c000 (* fx (- c100 c000)))
          c10 (+ c010 (* fx (- c110 c010)))
          c01 (+ c001 (* fx (- c101 c001)))
          c11 (+ c011 (* fx (- c111 c011)))
          c0 (+ c00 (* fy (- c10 c00)))
          c1 (+ c01 (* fy (- c11 c01)))]
      (+ c0 (* fz (- c1 c0)))))
)

          c100 (Double.from-float @(Array.unsafe-nth bank (+ (* (+ z0 (+ y0 ix1)) 4) ch)))
          c010 (Double.from-float @(Array.unsafe-nth bank (+ (* (+ z0 (+ y1 ix0)) 4) ch)))

(defmodule ShadersRaycast
(def raycast-wgsl
  "
struct Entity {
    pos_type: vec4<f32>,
    extents_rad: vec4<f32>,
    color: vec4<f32>,
}
struct Material {
    id: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32,
    density: f32,
    toughness: f32,
    tags: u32,
}
struct Uniforms {
    time: f32,
    width: f32,
    height: f32,
    brush_radius: f32,
    cam_pos: vec4<f32>,
    cam_dir: vec4<f32>,
    cam_right: vec4<f32>,
    cam_up: vec4<f32>,
    sun_dir: vec4<f32>,
    hit_pos: vec4<f32>,
    edit_params: vec4<f32>,
    solid_params: vec4<f32>,
    entity_count: f32,
    pad1: f32,
    pad2: f32,
    pad3: f32,
    view_proj: mat4x4<f32>,
    flask_pos: vec4<f32>,
    flask_action: vec4<f32>,
    matches: array<vec4<f32>, 8>,
    match_info: vec4<f32>,
    critter_pos: vec4<f32>,
    critter_action: vec4<f32>,
    critter_lights: array<vec4<f32>, 16>,
    critter_colors: array<vec4<f32>, 16>,
    vox_pos: array<vec4<f32>, 64>,
    vox_act: array<vec4<f32>, 64>,
    hopper_pos: array<vec4<f32>, 16>,
    mancer_pos: array<vec4<f32>, 4>,
    mancer_mat: array<vec4<f32>, 4>,
    wake_p0: array<vec4<f32>, 32>,
    wake_p1: array<vec4<f32>, 32>,
    wake_vel: array<vec4<f32>, 32>,
    spell_lights: array<vec4<f32>, 32>,
    spell_colors: array<vec4<f32>, 32>,
}

@group(0) @binding(0) var<storage, read>       dummy0: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read>       dummy1: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> hit_buffer: array<vec4<f32>>;
@group(0) @binding(4) var<storage, read>       materials: array<Material>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;
@group(0) @binding(8) var<storage, read> s_entities: array<Entity>;
@group(0) @binding(9) var light_texture:       texture_3d<f32>;
@group(0) @binding(10) var vel_texture:        texture_3d<f32>;

fn wrap_world(p: vec3<f32>) -> vec3<i32> {
    let w = p - floor(p / 160.0) * 160.0;
    return vec3<i32>(clamp(w, vec3<f32>(0.0), vec3<f32>(159.0)));
}

fn get_solid_world(p: vec3<f32>) -> vec4<f32> {
    return textureLoad(solid_texture, wrap_world(p), 0);
}

fn get_liquid_world(p: vec3<f32>) -> vec4<f32> {
    return textureLoad(liquid_texture, wrap_world(p), 0);
}

fn get_gas_world(p: vec3<f32>) -> vec4<f32> {
    return textureLoad(gas_texture, wrap_world(p), 0);
}

fn get_light_world(p: vec3<f32>) -> vec4<f32> {
    return textureLoad(light_texture, wrap_world(p), 0);
}

fn get_vel_world(p: vec3<f32>) -> vec4<f32> {
    return textureLoad(vel_texture, wrap_world(p), 0);
}

fn sample_entity_vel(p: vec3<f32>, box_min: vec3<f32>, box_max: vec3<f32>) -> vec4<f32> {
    if (p.x <= box_min.x + 2.0 || p.x >= box_max.x - 2.0 ||
        p.y <= box_min.y + 2.0 || p.y >= box_max.y - 2.0 ||
        p.z <= box_min.z + 2.0 || p.z >= box_max.z - 2.0) {
        return vec4<f32>(0.0);
    }
    let offs = array<vec3<f32>, 7>(
        vec3<f32>(0.0, 0.0, 0.0),
        vec3<f32>(0.0, 0.65, 0.0),
        vec3<f32>(0.0, -0.65, 0.0),
        vec3<f32>(0.65, 0.0, 0.0),
        vec3<f32>(-0.65, 0.0, 0.0),
        vec3<f32>(0.0, 0.0, 0.65),
        vec3<f32>(0.0, 0.0, -0.65)
    );
    var best = vec4<f32>(0.0);
    var best_e: f32 = 0.0;
    for (var i = 0u; i < 7u; i = i + 1u) {
        let rv = get_vel_world(p + offs[i]);
        let cp = clamp(rv.w, -3.8, 3.8);
        let e = dot(rv.xyz, rv.xyz) + abs(cp) * 0.35;
        if (e > best_e) {
            best_e = e;
            best = vec4<f32>(rv.xyz, cp);
        }
    }
    return best;
}

fn probe_detonation_2x2(c: vec3<f32>, box_min: vec3<f32>, box_max: vec3<f32>) -> vec4<f32> {
    if (c.x <= box_min.x + 3.0 || c.x >= box_max.x - 3.0 ||
        c.y <= box_min.y + 3.0 || c.y >= box_max.y - 3.0 ||
        c.z <= box_min.z + 3.0 || c.z >= box_max.z - 3.0) {
        return vec4<f32>(0.0);
    }
    let base = floor(c);
    var best = vec4<f32>(0.0);
    for (var dx = -1; dx <= 1; dx = dx + 2) {
        for (var dy = -1; dy <= 1; dy = dy + 2) {
            for (var dz = -1; dz <= 1; dz = dz + 2) {
                let sp = base + vec3<f32>(f32(dx), f32(dy), f32(dz)) * 0.5 + vec3<f32>(0.5);
                let pv = get_vel_world(sp);
                if (pv.w >= 4.3) {
                    let yld = clamp((pv.w - 4.4) / 1.5, 0.45, 1.10);
                    if (yld > best.w) { best = vec4<f32>(sp, yld); }
                }
            }
        }
    }
    let cv = get_vel_world(base + vec3<f32>(0.5));
    if (cv.w >= 4.3) {
        let yld = clamp((cv.w - 4.4) / 1.5, 0.45, 1.10);
        if (yld > best.w) { best = vec4<f32>(base + vec3<f32>(0.5), yld); }
    }
    return best;
}

fn probe_detonation_3x3(c: vec3<f32>, box_min: vec3<f32>, box_max: vec3<f32>) -> vec4<f32> {
    if (c.x <= box_min.x + 3.0 || c.x >= box_max.x - 3.0 ||
        c.y <= box_min.y + 3.0 || c.y >= box_max.y - 3.0 ||
        c.z <= box_min.z + 3.0 || c.z >= box_max.z - 3.0) {
        return vec4<f32>(0.0);
    }
    let base = floor(c) + vec3<f32>(0.5);
    var best = vec4<f32>(0.0);
    for (var dx = -1; dx <= 1; dx = dx + 1) {
        for (var dy = -1; dy <= 1; dy = dy + 1) {
            for (var dz = -1; dz <= 1; dz = dz + 1) {
                let sp = base + vec3<f32>(f32(dx), f32(dy), f32(dz));
                let pv = get_vel_world(sp);
                if (pv.w >= 4.3) {
                    let yld = clamp((pv.w - 4.4) / 1.5, 0.45, 1.10);
                    if (yld > best.w) { best = vec4<f32>(sp, yld); }
                }
            }
        }
    }
    return best;
}

fn get_field_world(p: vec3<f32>) -> vec4<f32> {
    let ip = wrap_world(p);
    if (textureLoad(solid_texture, ip, 0).y <= 0.0) {
        return vec4<f32>(0.0);
    }
    let idx = u32(ip.x) + u32(ip.y) * 160u + u32(ip.z) * 25600u;
    let f = dummy1[idx];
    if (f.w > -0.5) {
        return vec4<f32>(0.0);
    }
    return f;
}

fn unpack_pair(p: f32) -> vec2<f32> {
    let cp = max(0.0, p);
    let qa = floor(cp);
    let qb = (cp - qa) / 0.9992;
    return vec2<f32>(clamp(qa / 4095.0, 0.0, 1.0), clamp(qb, 0.0, 1.0));
}

fn unpack_quartet(p: f32) -> vec4<f32> {
    let cp = max(0.0, floor(p + 0.5));
    let qx = cp % 64.0;
    let qy = floor(cp / 64.0) % 64.0;
    let qz = floor(cp / 4096.0) % 64.0;
    let qw = floor(cp / 262144.0) % 64.0;
    return clamp(vec4<f32>(qx, qy, qz, qw) / 63.0, vec4<f32>(0.0), vec4<f32>(1.0));
}

fn eval_chemo_score(p: vec3<f32>) -> vec2<f32> {
    let f = get_field_world(p);
    if (f.w > -0.5) { return vec2<f32>(0.0); }
    let rec = unpack_quartet(-f.w - 1.0);
    let score = rec.x + 1.85 * rec.y - 1.35 * rec.z;
    return vec2<f32>(score, rec.y);
}

@compute @workgroup_size(1)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    if (global_id.x > 0u) { return; }
    let hack0 = dummy0[0];
    let hack1 = dummy1[0];
    let hack4 = vec4<f32>(materials[0].id);
    let hack6 = textureLoad(liquid_texture, vec3<i32>(0), 0);
    let hack7 = textureLoad(gas_texture, vec3<i32>(0), 0);
    let hack8 = s_entities[0].pos_type;
    let hack9 = textureLoad(light_texture, vec3<i32>(0), 0);
    let hack10 = textureLoad(vel_texture, vec3<i32>(0), 0);
    if (hack0.x == 9999.9) { hit_buffer[0] = hack1 + hack4 + hack6 + hack7 + hack8 + hack9 + hack10; }

    let ro = u.cam_pos.xyz;
    let rd = normalize(u.cam_dir.xyz);

    let cx = floor(u.cam_pos.x / 32.0);
    let cy = floor(u.cam_pos.y / 32.0);
    let cz = floor(u.cam_pos.z / 32.0);
    let box_min = vec3<f32>(cx - 2.0, cy - 2.0, cz - 2.0) * 32.0;
    let box_max = box_min + 160.0;

    let inv_rd = 1.0 / rd;
    let t0 = (box_min - ro) * inv_rd;
    let t1 = (box_max - ro) * inv_rd;
    let tmin = min(t0, t1);
    let tmax = max(t0, t1);

    let t_near = max(max(max(tmin.x, tmin.y), tmin.z), 0.0);
    let t_far  = min(min(tmax.x, tmax.y), tmax.z);

    // -------------------------------------------------------------------------
    // 1. Solid Crosshair Raymarch -> hit_buffer[0]
    // -------------------------------------------------------------------------
    var hit = false;
    var t = t_near;
    var p = ro;

    if (t_near < t_far) {
        for (var i = 0; i < 220; i = i + 1) {
            p = ro + rd * t;
            let sdf_val = get_solid_world(p);
            let d = sdf_val.y * 0.5;
            if (d <= 0.008) {
                hit = true;
                break;
            }
            if (t > t_far || t > 80.0) {
                break;
            }
            var step_size = max(d, 0.04);
            if (sdf_val.x < 0.0 || sdf_val.x == 5.0 || d < 0.25) {
                step_size = clamp(step_size, 0.005, 0.35);
            }
            t = t + step_size;
        }
    }

    if (hit) {
        hit_buffer[0] = vec4<f32>(p.x, p.y, p.z, 1.0);
    } else {
        hit_buffer[0] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
    }

    // -------------------------------------------------------------------------
    // 2. Triple-Stack Rig RMB Probe -> hit_buffer[1]
    //    u.flask_action.z = active vessel's locked material ID (0 = empty)
    //    u.flask_action.w = active rig slot (0 = Solid Sack, 1 = Liquid Flask, 2 = Gas Bellows)
    // -------------------------------------------------------------------------
    let locked_mat = select(0.0, round(u.flask_action.z), u.match_info.y > 0.002);
    let rig_slot = i32(round(u.flask_action.w));

    let offsets = array<vec3<f32>, 7>(
        vec3<f32>( 0.0,  0.0,  0.0),
        vec3<f32>( 0.0,  0.8,  0.0),
        vec3<f32>( 0.0, -0.8,  0.0),
        vec3<f32>( 0.8,  0.0,  0.0),
        vec3<f32>(-0.8,  0.0,  0.0),
        vec3<f32>( 0.0,  0.0,  0.8),
        vec3<f32>( 0.0,  0.0, -0.8)
    );

    if (rig_slot == 0) {
        // [1] SOLID SACK: Multi-depth + 3x3x3 neighborhood probe catches shallow hillside Soil, SDF walls & loose CA grains up to 65m!
        var found_locked_id: f32 = 0.0;
        var found_locked_pos = p;
        var found_any_id: f32 = 0.0;
        var found_pos = p;
        if (hit && t <= 65.0) {
            let depth_offs = array<f32, 7>(0.0, 0.35, 0.75, 1.25, 1.85, 2.45, -0.25);
            for (var di = 0u; di < 7u; di = di + 1u) {
                if (found_locked_id > 0.5 || (locked_mat < 0.5 && found_any_id > 0.5)) { break; }
                let dig_center = p + rd * depth_offs[di];
                for (var k = 0u; k < 7u; k = k + 1u) {
                    let sp = dig_center + offsets[k] * 1.05;
                    if (sp.x <= box_min.x + 2.0 || sp.x >= box_max.x - 2.0 ||
                        sp.y <= box_min.y + 2.0 || sp.y >= box_max.y - 2.0 ||
                        sp.z <= box_min.z + 2.0 || sp.z >= box_max.z - 2.0) {
                        continue;
                    }
                    let sol = get_solid_world(sp);
                    let s_raw = round(abs(sol.x));
                    if (s_raw >= 0.5 && s_raw < 254.5 && s_raw != 18.0) {
                        if (found_any_id < 0.5) {
                            found_any_id = s_raw;
                            found_pos = sp;
                        }
                        if (locked_mat > 0.5 && (s_raw == locked_mat || s_raw == 5.0)) {
                            found_locked_id = s_raw;
                            found_locked_pos = sp;
                            break;
                        }
                        if (locked_mat < 0.5) {
                            break;
                        }
                    }
                }
            }
            if (found_locked_id < 0.5 && (locked_mat > 0.5 || found_any_id < 0.5)) {
                let base_c = floor(p + rd * 0.45) + vec3<f32>(0.5);
                for (var dy = -2; dy <= 1; dy = dy + 1) {
                    for (var dx = -1; dx <= 1; dx = dx + 1) {
                        for (var dz = -1; dz <= 1; dz = dz + 1) {
                            let sp = base_c + vec3<f32>(f32(dx), f32(dy), f32(dz));
                            let sol = get_solid_world(sp);
                            let s_raw = round(abs(sol.x));
                            if (s_raw >= 0.5 && s_raw < 254.5 && s_raw != 18.0) {
                                if (found_any_id < 0.5) {
                                    found_any_id = s_raw;
                                    found_pos = sp;
                                }
                                if (locked_mat > 0.5 && (s_raw == locked_mat || s_raw == 5.0) && found_locked_id < 0.5) {
                                    found_locked_id = s_raw;
                                    found_locked_pos = sp;
                                }
                            }
                        }
                    }
                }
            }
        }
        let use_sol_lock = found_locked_id > 0.5;
        let out_sol_id = select(found_any_id, found_locked_id, use_sol_lock);
        let out_sol_pos = select(found_pos, found_locked_pos, use_sol_lock);
        if (out_sol_id > 0.5) {
            hit_buffer[1] = vec4<f32>(out_sol_pos, out_sol_id);
        } else {
            hit_buffer[1] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
        }
    } else if (rig_slot == 1) {
        // [2] LIQUID FLASK: Probe Liquids (257..271) through steam/smoke up to 65m (including thin surface puddles!)
        let max_succ_t = min(select(65.0, t + 1.25, hit), 65.0);
        var found_locked_id: f32 = 0.0;
        var found_locked_pos = vec3<f32>(0.0);
        var found_any_id: f32 = 0.0;
        var found_any_pos = vec3<f32>(0.0);
        var st: f32 = 0.0;
        for (var s = 0; s < 112; s = s + 1) {
            if (st > max_succ_t || found_locked_id > 0.5 || (locked_mat < 0.5 && found_any_id > 0.5)) { break; }
            let base_p = ro + rd * st;
            for (var k = 0u; k < 7u; k = k + 1u) {
                let sp = base_p + offsets[k] * 1.35;
                if (sp.x <= box_min.x + 1.0 || sp.x >= box_max.x - 1.0 ||
                    sp.y <= box_min.y + 1.0 || sp.y >= box_max.y - 1.0 ||
                    sp.z <= box_min.z + 1.0 || sp.z >= box_max.z - 1.0) {
                    continue;
                }
                let liq = get_liquid_world(sp);
                let l_raw = round(abs(liq.x));
                if (l_raw > 0.5 && liq.y > 0.012) {
                    let l_mat = 256.0 + l_raw;
                    let c_pos = floor(sp) + vec3<f32>(0.5);
                    if (found_any_id < 0.5) {
                        found_any_id = l_mat;
                        found_any_pos = c_pos;
                    }
                    if (locked_mat > 0.5 && l_mat == locked_mat) {
                        found_locked_id = l_mat;
                        found_locked_pos = c_pos;
                        break;
                    }
                    if (locked_mat < 0.5) {
                        break;
                    }
                }
            }
            st = st + 0.58;
        }
        if (hit && t <= 65.0 && found_locked_id < 0.5 && (locked_mat > 0.5 || found_any_id < 0.5)) {
            let surf_c = array<vec3<f32>, 3>(p - rd * 0.45, p, p + vec3<f32>(0.0, 0.75, 0.0));
            for (var si = 0u; si < 3u; si = si + 1u) {
                if (found_locked_id > 0.5 || (locked_mat < 0.5 && found_any_id > 0.5)) { break; }
                for (var k = 0u; k < 7u; k = k + 1u) {
                    let sp = surf_c[si] + offsets[k] * 1.35;
                    if (sp.x <= box_min.x + 1.0 || sp.x >= box_max.x - 1.0 ||
                        sp.y <= box_min.y + 1.0 || sp.y >= box_max.y - 1.0 ||
                        sp.z <= box_min.z + 1.0 || sp.z >= box_max.z - 1.0) {
                        continue;
                    }
                    let liq = get_liquid_world(sp);
                    let l_raw = round(abs(liq.x));
                    if (l_raw > 0.5 && liq.y > 0.010) {
                        let l_mat = 256.0 + l_raw;
                        let c_pos = floor(sp) + vec3<f32>(0.5);
                        if (found_any_id < 0.5) {
                            found_any_id = l_mat;
                            found_any_pos = c_pos;
                        }
                        if (locked_mat > 0.5 && l_mat == locked_mat) {
                            found_locked_id = l_mat;
                            found_locked_pos = c_pos;
                            break;
                        }
                        if (locked_mat < 0.5) {
                            break;
                        }
                    }
                }
            }
        }
        let use_locked = found_locked_id > 0.5;
        let out_id = select(found_any_id, found_locked_id, use_locked);
        let out_pos = select(found_any_pos, found_locked_pos, use_locked);
        if (out_id > 0.5) {
            hit_buffer[1] = vec4<f32>(out_pos, out_id);
        } else {
            hit_buffer[1] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
        }
    } else if (rig_slot == 2) {
        // [3] GAS BELLOWS: Wide-cone Gas intake (513..525) up to 65m + direct lit [Z] Match Fire siphon!
        let max_gas_t = min(select(65.0, t + 1.35, hit), 65.0);
        var found_locked_id: f32 = 0.0;
        var found_locked_pos = vec3<f32>(0.0);
        var found_pref_id: f32 = 0.0;
        var found_pref_pos = vec3<f32>(0.0);
        var found_any_id: f32 = 0.0;
        var found_any_pos = vec3<f32>(0.0);
        var st: f32 = 0.0;
        for (var s = 0; s < 112; s = s + 1) {
            if (st > max_gas_t || found_locked_id > 0.5 || (locked_mat < 0.5 && found_pref_id > 0.5)) { break; }
            let base_p = ro + rd * st;
            for (var k = 0u; k < 7u; k = k + 1u) {
                let sp = base_p + offsets[k] * 1.85;
                if (sp.x <= box_min.x + 1.0 || sp.x >= box_max.x - 1.0 ||
                    sp.y <= box_min.y + 1.0 || sp.y >= box_max.y - 1.0 ||
                    sp.z <= box_min.z + 1.0 || sp.z >= box_max.z - 1.0) {
                    continue;
                }
                let gas = get_gas_world(sp);
                let g_raw = round(abs(gas.x));
                if (g_raw > 0.5 && gas.y > 0.012) {
                    let g_mat = 512.0 + g_raw;
                    let c_pos = floor(sp) + vec3<f32>(0.5);
                    if (found_any_id < 0.5) {
                        found_any_id = g_mat;
                        found_any_pos = c_pos;
                    }
                    if (g_mat != 514.0 && found_pref_id < 0.5) {
                        found_pref_id = g_mat;
                        found_pref_pos = c_pos;
                    }
                    if (locked_mat > 0.5 && g_mat == locked_mat) {
                        found_locked_id = g_mat;
                        found_locked_pos = c_pos;
                        break;
                    }
                    if (locked_mat < 0.5 && found_pref_id > 0.5) {
                        break;
                    }
                }
            }
            st = st + 0.58;
        }
        if (hit && t <= 65.0 && found_locked_id < 0.5 && (locked_mat > 0.5 || found_pref_id < 0.5)) {
            let surf_g = array<vec3<f32>, 3>(p - rd * 0.45, p, p + vec3<f32>(0.0, 0.85, 0.0));
            for (var si = 0u; si < 3u; si = si + 1u) {
                if (found_locked_id > 0.5 || (locked_mat < 0.5 && found_pref_id > 0.5)) { break; }
                for (var k = 0u; k < 7u; k = k + 1u) {
                    let sp = surf_g[si] + offsets[k] * 1.85;
                    if (sp.x <= box_min.x + 1.0 || sp.x >= box_max.x - 1.0 ||
                        sp.y <= box_min.y + 1.0 || sp.y >= box_max.y - 1.0 ||
                        sp.z <= box_min.z + 1.0 || sp.z >= box_max.z - 1.0) {
                        continue;
                    }
                    let gas = get_gas_world(sp);
                    let g_raw = round(abs(gas.x));
                    if (g_raw > 0.5 && gas.y > 0.010) {
                        let g_mat = 512.0 + g_raw;
                        let c_pos = floor(sp) + vec3<f32>(0.5);
                        if (found_any_id < 0.5) {
                            found_any_id = g_mat;
                            found_any_pos = c_pos;
                        }
                        if (g_mat != 514.0 && found_pref_id < 0.5) {
                            found_pref_id = g_mat;
                            found_pref_pos = c_pos;
                        }
                        if (locked_mat > 0.5 && g_mat == locked_mat) {
                            found_locked_id = g_mat;
                            found_locked_pos = c_pos;
                            break;
                        }
                        if (locked_mat < 0.5 && found_pref_id > 0.5) {
                            break;
                        }
                    }
                }
            }
        }
        let use_g_lock = found_locked_id > 0.5;
        let use_g_pref = !use_g_lock && (found_pref_id > 0.5);
        var found_gas_id = select(select(found_any_id, found_pref_id, use_g_pref), found_locked_id, use_g_lock);
        var found_gas_pos = select(select(found_any_pos, found_pref_pos, use_g_pref), found_locked_pos, use_g_lock);
        if (found_gas_id < 0.5 && u.match_info.x > 0.5 && (locked_mat < 0.5 || locked_mat == 515.0)) {
            let max_m_t = min(select(45.0, t + 1.5, hit), 45.0);
            for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
                let m = u.matches[mi];
                if (m.w > 0.01) {
                    let rel_m = m.xyz - ro;
                    let proj_m = dot(rel_m, rd);
                    if (proj_m > 0.0 && proj_m <= max_m_t) {
                        let perp_m = length(rel_m - rd * proj_m);
                        if (perp_m <= 2.65) {
                            found_gas_id = 515.0;
                            found_gas_pos = m.xyz + vec3<f32>(0.0, 0.35, 0.0);
                            break;
                        }
                    }
                }
            }
        }
        if (found_gas_id > 0.5) {
            hit_buffer[1] = vec4<f32>(found_gas_pos, found_gas_id);
        } else {
            hit_buffer[1] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
        }
    } else {
        // [4] GAUNTLET & BOOT: CPU handles entity targeting; hit_buffer[3].yzw supplies terrain mat, stress & puddle splash
        hit_buffer[1] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
    }

    // -------------------------------------------------------------------------
    // 3. Phase-Tailored LMB Ballistic / Cone Arc -> hit_buffer[2]
    //    Slot 0 (Solid Sack):   Heavy lob (speed 21, loft +2.2, grav -22), ignores water so you can pack bridges!
    //    Slot 1 (Liquid Flask): High-pressure parabolic stream (speed 26, loft +1.8, grav -18)
    //    Slot 2 (Gas Bellows):  Buoyant flamethrower/gust cone (speed 19, grav +1.6) that sweeps 2..9m in open air!
    // -------------------------------------------------------------------------
    let right_n = normalize(u.cam_right.xyz);
    let up_n    = normalize(u.cam_up.xyz);
    var jpos = ro + right_n * 0.36 - up_n * 0.22 + rd * 0.65;
    var jvel = rd * 26.0 + vec3<f32>(0.0, 1.8, 0.0);
    var jgrav: f32 = -18.0;
    var max_jsteps: i32 = 88;
    if (rig_slot == 0) {
        jvel = rd * 21.0 + vec3<f32>(0.0, 2.2, 0.0);
        jgrav = -22.0;
    } else if (rig_slot == 2) {
        jvel = rd * 19.0 + vec3<f32>(0.0, 0.6, 0.0);
        jgrav = 1.6;
        // Sweep open-air gas/fire bloom continuously along the 2m..9m cone at 60 Hz!
        max_jsteps = 5 + i32(15.0 * fract(u.time * 11.37));
    }
    let jdt: f32 = 0.024;
    let ent_count = u32(max(0.0, u.entity_count));

    var jet_code: f32 = 0.0;
    var jet_impact = jpos;

    for (var step = 0; step < 88; step = step + 1) {
        if (step >= max_jsteps) {
            // Gas Bellows open-air plume bloom!
            jet_impact = jpos;
            jet_code = 1.0;
            break;
        }
        let prev_pos = jpos;
        jvel.y = jvel.y + jgrav * jdt;
        jpos = jpos + jvel * jdt;

        if (jpos.x <= box_min.x + 1.5 || jpos.x >= box_max.x - 1.5 ||
            jpos.y <= box_min.y + 1.5 || jpos.y >= box_max.y - 1.5 ||
            jpos.z <= box_min.z + 1.5 || jpos.z >= box_max.z - 1.5) {
            jet_impact = prev_pos;
            jet_code = 1.0;
            break;
        }
        if (jpos.y <= -191.2) {
            jet_impact = vec3<f32>(jpos.x, -190.8, jpos.z);
            jet_code = 1.0;
            break;
        }

        if (step > 1 && ent_count > 0u) {
            let hit_pad = select(0.45, 0.95, rig_slot == 2);
            for (var ei: u32 = 0u; ei < ent_count && ei < 256u; ei = ei + 1u) {
                let e = s_entities[ei];
                let pl = jpos - e.pos_type.xyz;
                var ed: f32 = 1000.0;
                if (e.pos_type.w > 4.5) {
                    ed = length(vec3<f32>(pl.x, pl.y * 0.56, pl.z)) - e.extents_rad.w;
                } else if (e.pos_type.w < 0.5 || e.pos_type.w >= 1.5) {
                    ed = length(pl) - e.extents_rad.w;
                } else {
                    let q = abs(pl) - e.extents_rad.xyz;
                    ed = length(max(q, vec3<f32>(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
                }
                if (ed <= hit_pad) {
                    jet_impact = jpos;
                    jet_code = 2.0 + f32(ei);
                    break;
                }
            }
            if (jet_code > 0.5) { break; }
        }

        let sv = get_solid_world(jpos);
        let liq_here = get_liquid_world(jpos);
        if (sv.y * 0.5 <= 0.06 || (rig_slot == 1 && step > 3 && liq_here.y > 0.65)) {
            jet_impact = prev_pos + vec3<f32>(0.0, select(0.0, 0.35, rig_slot <= 1), 0.0);
            jet_code = 1.0;
            break;
        }
    }

    if (jet_code < 0.5) {
        if (hit && t <= 58.0) {
            jet_impact = p - rd * 0.45 + vec3<f32>(0.0, 0.35, 0.0);
            jet_code = 1.0;
        } else {
            jet_impact = ro + rd * select(9.5, 6.5, rig_slot == 0);
            jet_code = 1.0;
        }
    }

    hit_buffer[2] = vec4<f32>(jet_impact, jet_code);

    // -------------------------------------------------------------------------
    // 4. Match Snuff Mask + [4] Gauntlet & Boot Terrain/Stress/Splash Probe -> hit_buffer[3]
    //    .x = snuff_mask, .y = hit_sol_mat (1..255), .z = hit_stress (0..1), .w = splash_mat (257..264)
    // -------------------------------------------------------------------------
    var snuff_mask: u32 = 0u;
    if (u.match_info.x > 0.5) {
        for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
            let m = u.matches[mi];
            if (m.w > 0.01) {
                let l0 = get_liquid_world(m.xyz);
                let l1 = get_liquid_world(m.xyz - vec3<f32>(0.0, 0.35, 0.0));
                let r0 = u32(clamp(round(abs(l0.x)), 0.0, 255.0));
                let r1 = u32(clamp(round(abs(l1.x)), 0.0, 255.0));
                var wet = false;
                if (r0 > 0u && l0.y > 0.08 && (materials[256u + r0].tags & 8388608u) != 0u) {
                    wet = true;
                }
                if (r1 > 0u && l1.y > 0.08 && (materials[256u + r1].tags & 8388608u) != 0u) {
                    wet = true;
                }
                let mv_snuff = sample_entity_vel(m.xyz, box_min, box_max);
                if (mv_snuff.w > 0.85 || length(mv_snuff.xyz) > 2.75 || mv_snuff.w < -1.35) {
                    wet = true; // LMB airblast, shockwave, or Baromancer deep vacuum blows out the match!
                }
                if (wet) {
                    snuff_mask = snuff_mask | (1u << mi);
                }
            }
        }
    }

    var hit_sol_mat: f32 = 0.0;
    var hit_stress: f32 = 0.0;
    if (hit && t <= 65.0) {
        let probe_c = p + rd * 0.45;
        for (var k = 0u; k < 7u; k = k + 1u) {
            let sp = probe_c + offsets[k] * 0.85;
            if (sp.x <= box_min.x + 2.0 || sp.x >= box_max.x - 2.0 ||
                sp.y <= box_min.y + 2.0 || sp.y >= box_max.y - 2.0 ||
                sp.z <= box_min.z + 2.0 || sp.z >= box_max.z - 2.0 || sp.y <= -191.0) {
                continue;
            }
            let sol = get_solid_world(sp);
            let s_raw = round(abs(sol.x));
            if (hit_sol_mat < 0.5 && s_raw >= 0.5 && s_raw < 254.5 && s_raw != 18.0) {
                hit_sol_mat = s_raw;
            }
            let st_val = get_light_world(sp).a;
            if (st_val > hit_stress) {
                hit_stress = st_val;
            }
        }
        if (hit_sol_mat < 0.5) {
            let sol_below = get_solid_world(p + vec3<f32>(0.0, -1.2, 0.0));
            let sb_raw = round(abs(sol_below.x));
            if (sb_raw >= 0.5 && sb_raw < 254.5 && sb_raw != 18.0) {
                hit_sol_mat = sb_raw;
            }
        }
    }

    var splash_mat: f32 = 0.0;
    let max_boot_t = min(select(4.6, t + 0.35, hit), 4.6);
    var bst: f32 = 0.65;
    for (var bs = 0; bs < 10; bs = bs + 1) {
        if (bst > max_boot_t) { break; }
        let bp = ro + rd * bst;
        let bl = get_liquid_world(bp);
        let bl_raw = round(abs(bl.x));
        if (bl_raw > 0.5 && bl.y > 0.10) {
            splash_mat = 256.0 + bl_raw;
            break;
        }
        bst = bst + 0.44;
    }

    hit_buffer[3] = vec4<f32>(f32(snuff_mask), hit_sol_mat, hit_stress, splash_mat);

    // -------------------------------------------------------------------------
    // 5. Ditto-Amoeba Chemoreception & Contact Hazard Probe -> hit_buffer[4 .. 35]
    //    Slot k (0..15):
    //      hit_buffer[4 + 2*k] = vec4(best_snack_x, best_snack_y, best_snack_z, best_snack_mat)
    //      hit_buffer[5 + 2*k] = vec4(touch_liq_mat, touch_gas_mat, touch_igniter, touch_extinguisher)
    // -------------------------------------------------------------------------
    for (var ak: u32 = 0u; ak < 16u; ak = ak + 1u) {
        let c_info = u.critter_lights[ak];
        let out_smell = 4u + ak * 2u;
        let out_touch = 5u + ak * 2u;
        if (c_info.w < 0.5) {
            hit_buffer[out_smell] = vec4<f32>(0.0);
            hit_buffer[out_touch] = vec4<f32>(0.0);
            continue;
        }

        let apos = c_info.xyz;
        let my_mat = round(c_info.w - 1.0);
        let arad = clamp(u.critter_colors[ak].w, 0.32, 1.05);

        // 5a. Direct body contact probe (liquids, gases, igniters, extinguishers, lit matches)
        var touch_liq: f32 = 0.0;
        var touch_gas: f32 = 0.0;
        var touch_ign: f32 = 0.0;
        var touch_ext: f32 = 0.0;

        if (u.match_info.x > 0.5) {
            for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
                let m = u.matches[mi];
                if (m.w > 0.01 && distance(apos, m.xyz) <= arad + 1.35) {
                    touch_ign = 1.0;
                }
            }
        }

        for (var pk = 0u; pk < 7u; pk = pk + 1u) {
            let cp = apos + offsets[pk] * (arad + 0.35);
            if (cp.x <= box_min.x + 2.0 || cp.x >= box_max.x - 2.0 ||
                cp.y <= box_min.y + 2.0 || cp.y >= box_max.y - 2.0 ||
                cp.z <= box_min.z + 2.0 || cp.z >= box_max.z - 2.0) {
                continue;
            }
            let cl = get_liquid_world(cp);
            let cl_id = u32(clamp(round(abs(cl.x)), 0.0, 255.0));
            if (cl_id > 0u && cl.y > 0.08) {
                let lmat = 256.0 + f32(cl_id);
                if (touch_liq < 0.5 || cl_id != 1u) { touch_liq = lmat; }
                let ltags = materials[256u + cl_id].tags;
                if ((ltags & 2u) != 0u) { touch_ign = 1.0; }
                if ((ltags & 8388608u) != 0u) { touch_ext = 1.0; }
            }
            let cg = get_gas_world(cp);
            let cg_id = u32(clamp(round(abs(cg.x)), 0.0, 255.0));
            if (cg_id > 0u && cg.y > 0.08) {
                let gmat = 512.0 + f32(cg_id);
                if (touch_gas < 0.5 || cg_id == 3u || cg_id == 6u || cg_id == 8u) { touch_gas = gmat; }
                let gtags = materials[512u + cg_id].tags;
                if ((gtags & 2u) != 0u) { touch_ign = 1.0; }
            }
        }
        hit_buffer[out_touch] = vec4<f32>(touch_liq, touch_gas, touch_ign, touch_ext);

        // 5b. 3D Chemoreceptor Smell Scan (24 golden-sphere rays across 1.1m .. 7.8m)
        var best_score: f32 = 0.0;
        var best_pos = vec3<f32>(0.0);
        var best_mat: f32 = 0.0;
        let phase = u.time * 2.9 + f32(ak) * 1.73;

        for (var si: u32 = 0u; si < 24u; si = si + 1u) {
            let fi = f32(si);
            let y_dir = 1.0 - (fi + 0.5) * (2.0 / 24.0);
            let r_xy = sqrt(max(0.0, 1.0 - y_dir * y_dir));
            let theta = fi * 2.399963 + phase;
            let sdir = vec3<f32>(cos(theta) * r_xy, y_dir, sin(theta) * r_xy);

            for (var tier: u32 = 0u; tier < 3u; tier = tier + 1u) {
                let dist = select(select(arad + 0.85, arad + 2.65, tier == 1u), arad + 5.85, tier == 2u);
                let sp = apos + sdir * dist;
                if (sp.x <= box_min.x + 2.5 || sp.x >= box_max.x - 2.5 ||
                    sp.y <= box_min.y + 2.5 || sp.y >= box_max.y - 2.5 ||
                    sp.z <= box_min.z + 2.5 || sp.z >= box_max.z - 2.5 || sp.y <= -190.5) {
                    continue;
                }

                var cand_mat: f32 = 0.0;
                var appetite: f32 = 0.0;

                // Liquids are juicy, easy to slurp, and great player bait!
                let sl = get_liquid_world(sp);
                let sl_raw = round(abs(sl.x));
                if (sl_raw >= 0.5 && sl.y > 0.08) {
                    cand_mat = 256.0 + sl_raw;
                    appetite = select(16.0, 25.0, sl_raw >= 2.0);
                    if (sl_raw == 6.0 || sl_raw == 7.0) { appetite = 32.0; }
                } else {
                    // Reactive cave solids (skip dull filler Stone 1, Soil 2, Sand 6, Obsidian 16, Bedrock 255)
                    let ss = get_solid_world(sp);
                    let ss_raw = round(abs(ss.x));
                    if (ss.y <= 0.18 && ss_raw >= 2.5 && ss_raw < 254.5 && ss_raw != 6.0 && ss_raw != 16.0) {
                        cand_mat = ss_raw;
                        appetite = 16.0;
                        if (ss_raw == 10.0 || ss_raw == 13.0 || ss_raw == 14.0 || ss_raw == 15.0 || ss_raw == 17.0) {
                            appetite = 27.0;
                        } else if (ss_raw == 4.0 || ss_raw == 5.0 || ss_raw == 7.0 || ss_raw == 12.0) {
                            appetite = 23.0;
                        }
                    } else {
                        // Dense energetic gases (Steam 513, Acid Vapor 517, Methane 518, Spore Cloud 520, Hydrogen 521, Butane 522, Chlorine 523, Acetylene 525)
                        let sg = get_gas_world(sp);
                        let sg_raw = round(abs(sg.x));
                        if (sg.y > 0.16 && (sg_raw == 1.0 || sg_raw == 5.0 || sg_raw == 6.0 || sg_raw == 8.0 || sg_raw == 9.0 || sg_raw == 10.0 || sg_raw == 11.0 || sg_raw == 13.0)) {
                            cand_mat = 512.0 + sg_raw;
                            appetite = 18.0;
                        }
                    }
                }

                if (cand_mat > 0.5) {
                    var diet_ok = false;
                    if (my_mat < 0.5) {
                        // Grey Slime: curious stem-cell omnivore for any reactive element!
                        diet_ok = true;
                    } else {
                        // Element-Locked Slime: strictly craves its locked element family (or golden Ambrosia 262!)
                        let exact = abs(cand_mat - my_mat) < 0.5;
                        let ambrosia = abs(cand_mat - 262.0) < 0.5;
                        let hydro = (my_mat == 8.0 || my_mat == 257.0 || my_mat == 271.0 || my_mat == 513.0) && (cand_mat == 8.0 || cand_mat == 257.0 || cand_mat == 271.0 || cand_mat == 513.0);
                        let acid_fam = (my_mat == 23.0 || my_mat == 259.0 || my_mat == 517.0 || my_mat == 523.0) && (cand_mat == 23.0 || cand_mat == 259.0 || cand_mat == 517.0 || cand_mat == 523.0);
                        let spore_fam = (my_mat == 13.0 || my_mat == 520.0) && (cand_mat == 13.0 || cand_mat == 520.0);
                        let pyro_fam = (my_mat == 258.0 || my_mat == 515.0 || my_mat == 519.0) && (cand_mat == 258.0 || cand_mat == 515.0 || cand_mat == 519.0);
                        let boom_fam = (my_mat == 7.0 || my_mat == 12.0 || my_mat == 263.0 || my_mat == 270.0 || my_mat == 518.0 || my_mat == 525.0) && (cand_mat == 7.0 || cand_mat == 12.0 || cand_mat == 263.0 || cand_mat == 270.0 || cand_mat == 518.0 || cand_mat == 525.0);
                        let alkali_fam = (my_mat == 20.0 || my_mat == 21.0 || my_mat == 22.0 || my_mat == 269.0) && (cand_mat == 20.0 || cand_mat == 21.0 || cand_mat == 22.0 || cand_mat == 269.0);
                        let oil_fam = (my_mat == 19.0 || my_mat == 260.0 || my_mat == 265.0 || my_mat == 266.0 || my_mat == 267.0 || my_mat == 522.0) && (cand_mat == 19.0 || cand_mat == 260.0 || cand_mat == 265.0 || cand_mat == 266.0 || cand_mat == 267.0 || cand_mat == 522.0);
                        let sponge_drink = (my_mat == 11.0) && (cand_mat >= 256.5 && cand_mat <= 271.5);
                        diet_ok = exact || ambrosia || hydro || acid_fam || spore_fam || pyro_fam || boom_fam || alkali_fam || oil_fam || sponge_drink;
                        if (exact) { appetite = appetite + 16.0; }
                    }

                    if (diet_ok) {
                        let score = appetite / (1.0 + 0.24 * dist);
                        if (score > best_score) {
                            best_score = score;
                            best_pos = sp;
                            best_mat = cand_mat;
                        }
                    }
                }
            }
        }
        hit_buffer[out_smell] = vec4<f32>(best_pos, best_mat);
    }

    // -------------------------------------------------------------------------
    // 6. Player CA Contact Probe -> hit_buffer[36] (feet + torso + head)
    //    vec4(touch_liq_mat, touch_gas_mat, touch_igniter, touch_healing)
    // -------------------------------------------------------------------------
    var p_liq: f32 = 0.0;
    var p_gas: f32 = 0.0;
    var p_ign: f32 = 0.0;
    var p_heal: f32 = 0.0;
    let p_samples = array<vec3<f32>, 4>(
        ro - vec3<f32>(0.0, 1.25, 0.0),
        ro - vec3<f32>(0.0, 0.72, 0.0),
        ro - vec3<f32>(0.0, 0.20, 0.0),
        ro + vec3<f32>(0.0, 0.15, 0.0)
    );
    for (var pi: u32 = 0u; pi < 4u; pi = pi + 1u) {
        let pp = p_samples[pi];
        if (pp.x <= box_min.x + 1.5 || pp.x >= box_max.x - 1.5 ||
            pp.y <= box_min.y + 1.5 || pp.y >= box_max.y - 1.5 ||
            pp.z <= box_min.z + 1.5 || pp.z >= box_max.z - 1.5) {
            continue;
        }
        let pl = get_liquid_world(pp);
        let pl_id = u32(clamp(round(abs(pl.x)), 0.0, 255.0));
        if (pl_id > 0u && pl.y > 0.08) {
            let lmat = 256.0 + f32(pl_id);
            let ltags = materials[256u + pl_id].tags;
            let l_haz = (ltags & (2u | 128u | 32768u)) != 0u;
            if (p_liq < 0.5 || l_haz) { p_liq = lmat; }
            if ((ltags & 2u) != 0u) { p_ign = max(p_ign, 1.0); }
            if ((ltags & 65536u) != 0u) { p_heal = 1.0; }
            if (pl.z > 0.18) { p_ign = max(p_ign, 2.0); }
        }
        let pg = get_gas_world(pp);
        let pg_id = u32(clamp(round(abs(pg.x)), 0.0, 255.0));
        if (pg_id > 0u && pg.y > 0.08) {
            let gmat = 512.0 + f32(pg_id);
            let gtags = materials[512u + pg_id].tags;
            let g_haz = (gtags & (2u | 128u | 32768u)) != 0u;
            if (p_gas < 0.5 || g_haz) { p_gas = gmat; }
            if ((gtags & 2u) != 0u) { p_ign = max(p_ign, 1.0); }
        }
        let pf = get_field_world(pp);
        if (unpack_pair(pf.y).x > 0.42) {
            p_ign = max(p_ign, 2.0);
        }
    }
    if (p_liq < 0.5) {
        let f_sol0 = get_solid_world(ro - vec3<f32>(0.0, 1.55, 0.0));
        let f_sol1 = get_solid_world(ro - vec3<f32>(0.0, 1.25, 0.0));
        let stain_z = select(f_sol1.z, f_sol0.z, f_sol0.z >= 2.5);
        if (stain_z >= 2.5) {
            let st_lid = clamp(round(stain_z) - 2.0, 1.0, 15.0);
            p_liq = 256.0 + st_lid;
            if (st_lid == 6.0) { p_heal = 1.0; }
        }
    }
    hit_buffer[36u] = vec4<f32>(p_liq, p_gas, p_ign, p_heal);

    // -------------------------------------------------------------------------
    // 7. 16-Slot Cave Hopper Probes -> hit_buffer[37 .. 52]
    //    vec4(touch_liq_mat, touch_gas_mat, has_los_or_chemo_angle, touch_ign_or_shock)
    // -------------------------------------------------------------------------
    let hop_offs = array<vec3<f32>, 5>(
        vec3<f32>(0.0, 0.0, 0.0),
        vec3<f32>(0.0, -1.0, 0.0),
        vec3<f32>(0.0, 0.85, 0.0),
        vec3<f32>(0.85, 0.0, 0.0),
        vec3<f32>(0.0, 0.0, 0.85)
    );
    for (var hk: u32 = 0u; hk < 16u; hk = hk + 1u) {
        let hinfo = u.hopper_pos[hk];
        let out_h = 37u + hk;
        if (hinfo.w < 0.05) {
            hit_buffer[out_h] = vec4<f32>(0.0);
            continue;
        }
        let hpos = hinfo.xyz;
        let hrad = hinfo.w;
        var h_liq: f32 = 0.0;
        var h_gas: f32 = 0.0;
        var h_ign: f32 = 0.0;

        for (var hi: u32 = 0u; hi < 5u; hi = hi + 1u) {
            let hp = hpos + hop_offs[hi] * (hrad + 0.28);
            if (hp.x <= box_min.x + 1.5 || hp.x >= box_max.x - 1.5 ||
                hp.y <= box_min.y + 1.5 || hp.y >= box_max.y - 1.5 ||
                hp.z <= box_min.z + 1.5 || hp.z >= box_max.z - 1.5) {
                continue;
            }
            let hl = get_liquid_world(hp);
            let hl_id = u32(clamp(round(abs(hl.x)), 0.0, 255.0));
            if (hl_id > 0u && hl.y > 0.08) {
                let lmat = 256.0 + f32(hl_id);
                let ltags = materials[256u + hl_id].tags;
                let l_haz = (ltags & (2u | 128u | 32768u)) != 0u;
                if (h_liq < 0.5 || l_haz) { h_liq = lmat; }
                if ((ltags & 2u) != 0u) { h_ign = max(h_ign, 1.0); }
                if (hl.z > 0.18) { h_ign = max(h_ign, 2.0); }
            }
            let hg = get_gas_world(hp);
            let hg_id = u32(clamp(round(abs(hg.x)), 0.0, 255.0));
            if (hg_id > 0u && hg.y > 0.08) {
                let gmat = 512.0 + f32(hg_id);
                let gtags = materials[512u + hg_id].tags;
                let g_haz = (gtags & (2u | 128u | 32768u)) != 0u;
                if (h_gas < 0.5 || g_haz) { h_gas = gmat; }
                if ((gtags & 2u) != 0u) { h_ign = max(h_ign, 1.0); }
            }
            let hf = get_field_world(hp);
            if (unpack_pair(hf.y).x > 0.42) {
                h_ign = max(h_ign, 2.0);
            }
        }

        // Fast SDF Line-of-Sight check from Hopper eye to Player eye
        var h_los: f32 = 0.0;
        let to_p = ro - (hpos + vec3<f32>(0.0, 0.22, 0.0));
        let p_dist = length(to_p);
        if (p_dist < 28.0) {
            h_los = 1.0;
            if (p_dist > 1.25) {
                let l_dir = to_p / p_dist;
                var lt: f32 = hrad + 0.35;
                let l_end = p_dist - 0.55;
                for (var ls: i32 = 0; ls < 40; ls = ls + 1) {
                    if (lt >= l_end) { break; }
                    let lp = hpos + vec3<f32>(0.0, 0.22, 0.0) + l_dir * lt;
                    if (lp.x <= box_min.x + 1.0 || lp.x >= box_max.x - 1.0 ||
                        lp.y <= box_min.y + 1.0 || lp.y >= box_max.y - 1.0 ||
                        lp.z <= box_min.z + 1.0 || lp.z >= box_max.z - 1.0) {
                        h_los = 0.0;
                        break;
                    }
                    let sd = get_solid_world(lp).y * 0.5;
                    if (sd < 0.06) {
                        h_los = 0.0;
                        break;
                    }
                    lt = lt + clamp(sd, 0.32, 1.85);
                }
            }
        }

        // 4-Receptor Biochemistry Chemotaxis Steering (around blind corners OR when Siren/Pussy-Stank G overrides sight!)
        let c_px = eval_chemo_score(hpos + vec3<f32>(1.5, 0.25, 0.0));
        let c_nx = eval_chemo_score(hpos + vec3<f32>(-1.5, 0.25, 0.0));
        let c_pz = eval_chemo_score(hpos + vec3<f32>(0.0, 0.25, 1.5));
        let c_nz = eval_chemo_score(hpos + vec3<f32>(0.0, 0.25, -1.5));
        let grad_chemo = vec2<f32>(c_px.x - c_nx.x, c_pz.x - c_nz.x) * 0.5;
        let max_stank = max(max(c_px.y, c_nx.y), max(c_pz.y, c_nz.y));
        if ((h_los < 0.5 || max_stank > 0.25) && length(grad_chemo) > 0.015) {
            let theta = atan2(grad_chemo.y, grad_chemo.x);
            h_los = -(theta + 4.0);
        }

        hit_buffer[out_h] = vec4<f32>(h_liq, h_gas, h_los, h_ign);
    }

    // -------------------------------------------------------------------------
    // 8. 4-Slot Ecomancer Probes + 16.5m Element Supply Scanner -> hit_buffer[53 .. 60]
    //    hit_buffer[53 + mk*2] = vec4(touch_liq, touch_gas, has_los, touch_ign)
    //    hit_buffer[54 + mk*2] = vec4(supply_x, supply_y, supply_z, supply_amt)
    // -------------------------------------------------------------------------
    for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
        let minfo = u.mancer_pos[mk];
        let mspec = u.mancer_mat[mk];
        let out_m0 = 53u + mk * 2u;
        let out_m1 = 54u + mk * 2u;
        if (minfo.w < 0.05) {
            hit_buffer[out_m0] = vec4<f32>(0.0);
            hit_buffer[out_m1] = vec4<f32>(0.0);
            continue;
        }
        let mpos = minfo.xyz;
        let mrad = minfo.w;
        let tmat = round(mspec.x);
        let mseed = mspec.y;

        var m_liq: f32 = 0.0;
        var m_gas: f32 = 0.0;
        var m_ign: f32 = 0.0;
        for (var mi: u32 = 0u; mi < 5u; mi = mi + 1u) {
            let mp = mpos + hop_offs[mi] * (mrad + 0.36);
            if (mp.x <= box_min.x + 1.5 || mp.x >= box_max.x - 1.5 ||
                mp.y <= box_min.y + 1.5 || mp.y >= box_max.y - 1.5 ||
                mp.z <= box_min.z + 1.5 || mp.z >= box_max.z - 1.5) {
                continue;
            }
            let ml = get_liquid_world(mp);
            let ml_id = u32(clamp(round(abs(ml.x)), 0.0, 255.0));
            if (ml_id > 0u && ml.y > 0.08) {
                let lmat = 256.0 + f32(ml_id);
                let ltags = materials[256u + ml_id].tags;
                let l_haz = (ltags & (2u | 128u | 32768u)) != 0u;
                if (m_liq < 0.5 || l_haz) { m_liq = lmat; }
                if ((ltags & 2u) != 0u) { m_ign = max(m_ign, 1.0); }
                if (ml.z > 0.18) { m_ign = max(m_ign, 2.0); }
            }
            let mg = get_gas_world(mp);
            let mg_id = u32(clamp(round(abs(mg.x)), 0.0, 255.0));
            if (mg_id > 0u && mg.y > 0.08) {
                let gmat = 512.0 + f32(mg_id);
                let gtags = materials[512u + mg_id].tags;
                let g_haz = (gtags & (2u | 128u | 32768u)) != 0u;
                if (m_gas < 0.5 || g_haz) { m_gas = gmat; }
                if ((gtags & 2u) != 0u) { m_ign = max(m_ign, 1.0); }
            }
            let mf = get_field_world(mp);
            if (unpack_pair(mf.y).x > 0.42) {
                m_ign = max(m_ign, 2.0);
            }
        }

        var m_los: f32 = 0.0;
        let meye = mpos + vec3<f32>(0.0, 0.52, 0.0);
        let m_to_p = ro - meye;
        let mp_dist = length(m_to_p);
        if (mp_dist < 38.0) {
            m_los = 1.0;
            if (mp_dist > 1.35) {
                let ml_dir = m_to_p / mp_dist;
                var mlt: f32 = mrad + 0.45;
                let ml_end = mp_dist - 0.55;
                for (var mls: i32 = 0; mls < 44; mls = mls + 1) {
                    if (mlt >= ml_end) { break; }
                    let mlp = meye + ml_dir * mlt;
                    if (mlp.x <= box_min.x + 1.0 || mlp.x >= box_max.x - 1.0 ||
                        mlp.y <= box_min.y + 1.0 || mlp.y >= box_max.y - 1.0 ||
                        mlp.z <= box_min.z + 1.0 || mlp.z >= box_max.z - 1.0) {
                        m_los = 0.0;
                        break;
                    }
                    let msd = get_solid_world(mlp).y * 0.5;
                    if (msd < 0.06) {
                        m_los = 0.0;
                        break;
                    }
                    mlt = mlt + clamp(msd, 0.34, 1.95);
                }
            }
        }
        hit_buffer[out_m0] = vec4<f32>(m_liq, m_gas, m_los, m_ign);
        if (tmat >= 768.5) {
            hit_buffer[out_m1] = vec4<f32>(0.0);
            continue;
        }

        // Scan 20 rotating golden-spiral rays (2.0m .. 16.5m) for ANY voxel in the Ecomancer's 256-wide phase segment!
        // Phase 0 (Solid): floor(id / 256) == 0 (1..254)
        // Phase 1 (Liquid): floor(id / 256) == 1 (257..511)
        // Phase 2 (Gas): floor(id / 256) == 2 (513..767)
        // `best_amt` stores the exact `+found_mat_id` (>= 1.0) at `best_sup`!
        let tphase = floor(tmat / 256.0);
        var best_sup = vec3<f32>(0.0);
        var best_amt: f32 = 0.0;
        var best_score: f32 = -1.0;
        if (tmat > 0.5) {
            for (var ri: u32 = 0u; ri < 20u; ri = ri + 1u) {
                let rf = f32(ri);
                let phi = mseed * 1.17 + rf * 2.399963;
                let zraw = fract(mseed * 0.137 + rf * 0.381966) * 1.84 - 0.92;
                let rxy = sqrt(max(0.0, 1.0 - zraw * zraw));
                let sdir = vec3<f32>(cos(phi) * rxy, zraw, sin(phi) * rxy);

                if (tphase < 0.5) {
                    var st: f32 = 2.0;
                    for (var ss: i32 = 0; ss < 9; ss = ss + 1) {
                        if (st > 16.5) { break; }
                        let sp = meye + sdir * st;
                        if (sp.x <= box_min.x + 2.5 || sp.x >= box_max.x - 2.5 ||
                            sp.y <= box_min.y + 2.5 || sp.y >= box_max.y - 2.5 ||
                            sp.z <= box_min.z + 2.5 || sp.z >= box_max.z - 2.5) {
                            break;
                        }
                        let sv = get_solid_world(sp);
                        let sd = sv.y * 0.5;
                        if (sd < 0.32) {
                            let iv = get_solid_world(sp + sdir * 0.65);
                            var smat = round(abs(iv.x));
                            if (smat < 1.0 || smat >= 254.5) {
                                smat = round(abs(sv.x));
                            }
                            if (smat >= 1.0 && smat <= 25.0 && smat != 18.0) {
                                let exotic = smat >= 3.0 && smat != 6.0 && smat != 16.0;
                                let sc = 20.0 - abs(st - 6.5) + select(0.0, 6.5, exotic);
                                if (sc > best_score) {
                                    best_score = sc;
                                    best_sup = sp;
                                    best_amt = smat;
                                }
                            }
                            break;
                        }
                        st = st + clamp(sd, 0.75, 2.25);
                    }
                } else if (tphase < 1.5) {
                    var st: f32 = 1.8;
                    for (var ss: i32 = 0; ss < 12; ss = ss + 1) {
                        let sp = meye + sdir * st;
                        if (sp.x <= box_min.x + 2.5 || sp.x >= box_max.x - 2.5 ||
                            sp.y <= box_min.y + 2.5 || sp.y >= box_max.y - 2.5 ||
                            sp.z <= box_min.z + 2.5 || sp.z >= box_max.z - 2.5) {
                            break;
                        }
                        if (get_solid_world(sp).y * 0.5 < -0.25) { break; }
                        let lv = get_liquid_world(sp);
                        let l_id = round(abs(lv.x));
                        if (l_id >= 1.0 && l_id <= 15.0 && lv.y > 0.10) {
                            let sc = lv.y * 12.0 + select(0.0, 5.5, l_id >= 2.0) + (17.0 - st) * 0.25;
                            if (sc > best_score) {
                                best_score = sc;
                                best_sup = floor(sp) + vec3<f32>(0.5);
                                best_amt = 256.0 + l_id;
                            }
                            break;
                        }
                        st = st + 1.2;
                    }
                } else {
                    var st: f32 = 1.8;
                    for (var ss: i32 = 0; ss < 11; ss = ss + 1) {
                        let sp = meye + sdir * st;
                        if (sp.x <= box_min.x + 2.5 || sp.x >= box_max.x - 2.5 ||
                            sp.y <= box_min.y + 2.5 || sp.y >= box_max.y - 2.5 ||
                            sp.z <= box_min.z + 2.5 || sp.z >= box_max.z - 2.5) {
                            break;
                        }
                        if (get_solid_world(sp).y * 0.5 < -0.25) { break; }
                        let gv = get_gas_world(sp);
                        let g_id = round(abs(gv.x));
                        if (g_id >= 1.0 && g_id <= 13.0 && gv.y > 0.10) {
                            let sc = gv.y * 12.0 + select(0.0, 5.5, g_id >= 2.0) + (17.0 - st) * 0.25;
                            if (sc > best_score) {
                                best_score = sc;
                                best_sup = floor(sp) + vec3<f32>(0.5);
                                best_amt = 512.0 + g_id;
                            }
                            break;
                        }
                        st = st + 1.3;
                    }
                }
            }
        }

        // If the Ecomancer's entire 256-segment phase is depleted within 16.5m, scan for the richest phase to Re-Attune to!
        if (best_amt < 0.5) {
            var alt_sup = mpos + vec3<f32>(0.0, -1.2, 0.0);
            var alt_mat: f32 = 1.0;
            var alt_score: f32 = -1.0;
            for (var ari: u32 = 0u; ari < 12u; ari = ari + 1u) {
                let arf = f32(ari);
                let aphi = mseed * 0.91 + arf * 2.399963;
                let azraw = fract(mseed * 0.173 + arf * 0.381966) * 1.76 - 0.88;
                let arxy = sqrt(max(0.0, 1.0 - azraw * azraw));
                let asdir = vec3<f32>(cos(aphi) * arxy, azraw, sin(aphi) * arxy);
                var ast: f32 = 2.0;
                for (var ass: i32 = 0; ass < 8; ass = ass + 1) {
                    if (ast > 15.0) { break; }
                    let asp = meye + asdir * ast;
                    if (asp.x <= box_min.x + 2.5 || asp.x >= box_max.x - 2.5 ||
                        asp.y <= box_min.y + 2.5 || asp.y >= box_max.y - 2.5 ||
                        asp.z <= box_min.z + 2.5 || asp.z >= box_max.z - 2.5) {
                        break;
                    }
                    let alv = get_liquid_world(asp);
                    let al_id = round(abs(alv.x));
                    if (al_id >= 1.0 && al_id <= 15.0 && alv.y > 0.12 && abs(1.0 - tphase) > 0.5) {
                        let cmat = 256.0 + al_id;
                        let sc = 36.0 + alv.y * 10.0 + select(0.0, 8.0, al_id >= 2.0) - ast * 0.4;
                        if (sc > alt_score) {
                            alt_score = sc;
                            alt_sup = floor(asp) + vec3<f32>(0.5);
                            alt_mat = cmat;
                        }
                        break;
                    }
                    let agv = get_gas_world(asp);
                    let ag_id = round(abs(agv.x));
                    if (ag_id >= 1.0 && ag_id <= 13.0 && agv.y > 0.16 && abs(2.0 - tphase) > 0.5) {
                        let cmat = 512.0 + ag_id;
                        let sc = 26.0 + agv.y * 8.0 - ast * 0.4;
                        if (sc > alt_score) {
                            alt_score = sc;
                            alt_sup = floor(asp) + vec3<f32>(0.5);
                            alt_mat = cmat;
                        }
                    }
                    let asv = get_solid_world(asp);
                    let asd = asv.y * 0.5;
                    if (asd < 0.32) {
                        let aiv = get_solid_world(asp + asdir * 0.65);
                        var smat = round(abs(aiv.x));
                        if (smat < 1.0 || smat > 25.0 || smat == 18.0) {
                            smat = round(abs(asv.x));
                        }
                        if (smat >= 1.0 && smat <= 25.0 && smat != 18.0 && abs(0.0 - tphase) > 0.5) {
                            let exotic = smat >= 3.0 && smat != 6.0 && smat != 16.0;
                            let sc = select(18.0, 31.0, exotic) - ast * 0.4;
                            if (sc > alt_score) {
                                alt_score = sc;
                                alt_sup = asp;
                                alt_mat = smat;
                            }
                        }
                        break;
                    }
                    ast = ast + clamp(asd, 0.9, 2.2);
                }
            }
            hit_buffer[out_m1] = vec4<f32>(alt_sup, -alt_mat);
        } else {
            hit_buffer[out_m1] = vec4<f32>(best_sup, best_amt);
        }
    }

    // -------------------------------------------------------------------------
    // 10. Two-Way Velocity, Ambient Field & GPU Detonation Readback -> hit_buffer[61..103]
    //     [61]      = Player local vel_texture vec4(vx, vy, vz, vp)
    //     [62]      = Player local ambient field vec4(T, P, tau, G)
    //     [63]      = GPU Chemical / Thermobaric Detonation Event vec4(x, y, z, yield)
    //     [64..79]  = 16-slot critter_lights[0..15] local vel_texture
    //     [80..95]  = 16-slot hopper_pos[0..15] local vel_texture
    //     [96..103] = 8-slot matches[0..7] local vel_texture
    // -------------------------------------------------------------------------
    let p_torso = ro - vec3<f32>(0.0, 0.55, 0.0);
    hit_buffer[61] = sample_entity_vel(p_torso, box_min, box_max);

    var pf = get_field_world(p_torso);
    if (pf.w > -0.5) {
        pf = get_field_world(ro);
    }
    if (pf.w <= -0.5) {
        let p_tp = unpack_pair(pf.x);
        let p_tg = unpack_pair(pf.z);
        hit_buffer[62] = vec4<f32>(p_tp.x, p_tp.y, p_tg.x, p_tg.y);
    } else {
        hit_buffer[62] = vec4<f32>(0.20, 0.0, 0.50, 0.50);
    }

    // Scan hotspots (Matches, Brush, Jet Impact, Critter/Bolt lights, Mancers) + 128 rotating cave probes for GPU Detonation Pulses (vel.w >= 4.3)!
    var best_expl = vec4<f32>(0.0);
    for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
        let m = u.matches[mi];
        if (m.w > 0.01) {
            let ev = probe_detonation_3x3(m.xyz, box_min, box_max);
            if (ev.w > best_expl.w) { best_expl = ev; }
        }
    }
    if (u.hit_pos.w > 0.5) {
        let ev = probe_detonation_3x3(u.hit_pos.xyz, box_min, box_max);
        if (ev.w > best_expl.w) { best_expl = ev; }
    }
    if (jet_code > 0.5) {
        let ev = probe_detonation_3x3(jet_impact, box_min, box_max);
        if (ev.w > best_expl.w) { best_expl = ev; }
    }
    for (var ck: u32 = 0u; ck < 16u; ck = ck + 1u) {
        let cl = u.critter_lights[ck];
        if (abs(cl.w) > 0.1) {
            let ev = probe_detonation_2x2(cl.xyz, box_min, box_max);
            if (ev.w > best_expl.w) { best_expl = ev; }
        }
    }
    for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
        let mp = u.mancer_pos[mk];
        if (mp.w > 0.05) {
            let ev = probe_detonation_2x2(mp.xyz, box_min, box_max);
            if (ev.w > best_expl.w) { best_expl = ev; }
        }
    }
    let det_seed = select(floor(u.time * 60.0), u.pad2, u.pad2 > 0.5);
    for (var pi: u32 = 0u; pi < 128u; pi = pi + 1u) {
        let pf_i = f32(pi) + det_seed * 19.0;
        let phi = pf_i * 2.399963;
        let z_u = fract(pf_i * 0.381966) * 1.90 - 0.95;
        let r_xy = sqrt(max(0.0, 1.0 - z_u * z_u));
        let rad = 1.5 + 31.0 * fract(pf_i * 0.618034);
        let sp = floor(ro + vec3<f32>(cos(phi) * r_xy, z_u, sin(phi) * r_xy) * rad) + vec3<f32>(0.5);
        if (sp.x > box_min.x + 3.0 && sp.x < box_max.x - 3.0 &&
            sp.y > box_min.y + 3.0 && sp.y < box_max.y - 3.0 &&
            sp.z > box_min.z + 3.0 && sp.z < box_max.z - 3.0) {
            let pv = get_vel_world(sp);
            if (pv.w >= 4.3) {
                let yld = clamp((pv.w - 4.4) / 1.5, 0.45, 1.10);
                if (yld > best_expl.w) {
                    best_expl = vec4<f32>(sp, yld);
                }
            }
        }
    }
    hit_buffer[63] = best_expl;

    for (var ck: u32 = 0u; ck < 16u; ck = ck + 1u) {
        let cl = u.critter_lights[ck];
        if (abs(cl.w) > 0.05) {
            hit_buffer[64u + ck] = sample_entity_vel(cl.xyz, box_min, box_max);
        } else {
            hit_buffer[64u + ck] = vec4<f32>(0.0);
        }
    }

    for (var hk: u32 = 0u; hk < 16u; hk = hk + 1u) {
        let hp = u.hopper_pos[hk];
        if (hp.w > 0.05) {
            hit_buffer[80u + hk] = sample_entity_vel(hp.xyz, box_min, box_max);
        } else {
            hit_buffer[80u + hk] = vec4<f32>(0.0);
        }
    }

    for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
        let m = u.matches[mi];
        if (m.w > 0.01) {
            hit_buffer[96u + mi] = sample_entity_vel(m.xyz, box_min, box_max);
        } else {
            hit_buffer[96u + mi] = vec4<f32>(0.0);
        }
    }
}
")
)

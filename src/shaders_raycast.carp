(defmodule ShadersRaycast
(def raycast-wgsl
  "
struct Entity {
    pos_type: vec4<f32>,
    extents_rad: vec4<f32>,
    color: vec4<f32>,
}
struct Material {
    id: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32,
    density: f32,
    toughness: f32,
    tags: u32,
}
struct Uniforms {
    time: f32,
    width: f32,
    height: f32,
    brush_radius: f32,
    cam_pos: vec4<f32>,
    cam_dir: vec4<f32>,
    cam_right: vec4<f32>,
    cam_up: vec4<f32>,
    sun_dir: vec4<f32>,
    hit_pos: vec4<f32>,
    edit_params: vec4<f32>,
    solid_params: vec4<f32>,
    entity_count: f32,
    pad1: f32,
    pad2: f32,
    pad3: f32,
    view_proj: mat4x4<f32>,
    flask_pos: vec4<f32>,
    flask_action: vec4<f32>,
    matches: array<vec4<f32>, 8>,
    match_info: vec4<f32>,
    critter_pos: vec4<f32>,
    critter_action: vec4<f32>,
    critter_lights: array<vec4<f32>, 16>,
    critter_colors: array<vec4<f32>, 16>,
}

@group(0) @binding(0) var<storage, read>       dummy0: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read>       dummy1: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> hit_buffer: array<vec4<f32>>;
@group(0) @binding(4) var<storage, read>       materials: array<Material>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;
@group(0) @binding(8) var<storage, read> s_entities: array<Entity>;
@group(0) @binding(9) var light_texture:       texture_3d<f32>;

fn wrap_world(p: vec3<f32>) -> vec3<i32> {
    let w = p - floor(p / 160.0) * 160.0;
    return vec3<i32>(clamp(w, vec3<f32>(0.0), vec3<f32>(159.0)));
}

fn get_solid_world(p: vec3<f32>) -> vec4<f32> {
    return textureLoad(solid_texture, wrap_world(p), 0);
}

fn get_liquid_world(p: vec3<f32>) -> vec4<f32> {
    return textureLoad(liquid_texture, wrap_world(p), 0);
}

fn get_gas_world(p: vec3<f32>) -> vec4<f32> {
    return textureLoad(gas_texture, wrap_world(p), 0);
}

fn get_light_world(p: vec3<f32>) -> vec4<f32> {
    return textureLoad(light_texture, wrap_world(p), 0);
}

@compute @workgroup_size(1)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    if (global_id.x > 0u) { return; }
    let hack0 = dummy0[0];
    let hack1 = dummy1[0];
    let hack4 = vec4<f32>(materials[0].id);
    let hack6 = textureLoad(liquid_texture, vec3<i32>(0), 0);
    let hack7 = textureLoad(gas_texture, vec3<i32>(0), 0);
    let hack8 = s_entities[0].pos_type;
    let hack9 = textureLoad(light_texture, vec3<i32>(0), 0);
    if (hack0.x == 9999.9) { hit_buffer[0] = hack1 + hack4 + hack6 + hack7 + hack8 + hack9; }

    let ro = u.cam_pos.xyz;
    let rd = normalize(u.cam_dir.xyz);

    let cx = floor(u.cam_pos.x / 32.0);
    let cy = floor(u.cam_pos.y / 32.0);
    let cz = floor(u.cam_pos.z / 32.0);
    let box_min = vec3<f32>(cx - 2.0, cy - 2.0, cz - 2.0) * 32.0;
    let box_max = box_min + 160.0;

    let inv_rd = 1.0 / rd;
    let t0 = (box_min - ro) * inv_rd;
    let t1 = (box_max - ro) * inv_rd;
    let tmin = min(t0, t1);
    let tmax = max(t0, t1);

    let t_near = max(max(max(tmin.x, tmin.y), tmin.z), 0.0);
    let t_far  = min(min(tmax.x, tmax.y), tmax.z);

    // -------------------------------------------------------------------------
    // 1. Solid Crosshair Raymarch -> hit_buffer[0]
    // -------------------------------------------------------------------------
    var hit = false;
    var t = t_near;
    var p = ro;

    if (t_near < t_far) {
        for (var i = 0; i < 200; i = i + 1) {
            p = ro + rd * t;
            let sdf_val = get_solid_world(p);
            let d = sdf_val.y * 0.5;
            if (d < 0.05 || d <= 0.0) {
                hit = true;
                break;
            }
            if (t > t_far || t > 80.0) {
                break;
            }
            var step_size = max(d, 0.05);
            if (sdf_val.x < 0.0 || sdf_val.x == 5.0) {
                step_size = clamp(step_size, 0.005, 0.85);
            }
            t = t + step_size;
        }
    }

    if (hit) {
        hit_buffer[0] = vec4<f32>(p.x, p.y, p.z, 1.0);
    } else {
        hit_buffer[0] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
    }

    // -------------------------------------------------------------------------
    // 2. Triple-Stack Rig RMB Probe -> hit_buffer[1]
    //    u.flask_action.z = active vessel's locked material ID (0 = empty)
    //    u.flask_action.w = active rig slot (0 = Solid Sack, 1 = Liquid Flask, 2 = Gas Bellows)
    // -------------------------------------------------------------------------
    let locked_mat = round(u.flask_action.z);
    let rig_slot = i32(round(u.flask_action.w));

    let offsets = array<vec3<f32>, 7>(
        vec3<f32>( 0.0,  0.0,  0.0),
        vec3<f32>( 0.0,  0.8,  0.0),
        vec3<f32>( 0.0, -0.8,  0.0),
        vec3<f32>( 0.8,  0.0,  0.0),
        vec3<f32>(-0.8,  0.0,  0.0),
        vec3<f32>( 0.0,  0.0,  0.8),
        vec3<f32>( 0.0,  0.0, -0.8)
    );

    if (rig_slot == 0) {
        // [1] SOLID SACK: Probe non-Bedrock solid walls & rubble within 14m
        var found_sol_id: f32 = 0.0;
        var found_sol_pos = vec3<f32>(0.0);
        if (hit && t <= 14.0) {
            let dig_center = p + rd * 0.42;
            for (var k = 0u; k < 7u; k = k + 1u) {
                let sp = dig_center + offsets[k] * 0.55;
                if (sp.x <= box_min.x + 2.0 || sp.x >= box_max.x - 2.0 ||
                    sp.y <= box_min.y + 2.0 || sp.y >= box_max.y - 2.0 ||
                    sp.z <= box_min.z + 2.0 || sp.z >= box_max.z - 2.0 || sp.y <= -191.0) {
                    continue;
                }
                let sol = get_solid_world(sp);
                let s_raw = round(abs(sol.x));
                if (sol.y <= 0.25 && s_raw >= 0.5 && s_raw < 254.5) {
                    if (locked_mat < 0.5 || abs(s_raw - locked_mat) < 0.5) {
                        found_sol_id = s_raw;
                        found_sol_pos = p;
                        break;
                    }
                }
            }
        }
        if (found_sol_id > 0.5) {
            hit_buffer[1] = vec4<f32>(found_sol_pos, found_sol_id);
        } else {
            hit_buffer[1] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
        }
    } else if (rig_slot == 1) {
        // [2] LIQUID FLASK: Probe Liquids ONLY (257..264) through steam/smoke up to 16m
        let max_succ_t = min(select(16.0, t + 0.75, hit), 16.0);
        var found_liq_id: f32 = 0.0;
        var found_liq_pos = vec3<f32>(0.0);
        var st: f32 = 0.0;
        for (var s = 0; s < 40; s = s + 1) {
            if (st > max_succ_t || found_liq_id > 0.5) { break; }
            let base_p = ro + rd * st;
            for (var k = 0u; k < 7u; k = k + 1u) {
                let sp = base_p + offsets[k];
                if (sp.x <= box_min.x + 1.0 || sp.x >= box_max.x - 1.0 ||
                    sp.y <= box_min.y + 1.0 || sp.y >= box_max.y - 1.0 ||
                    sp.z <= box_min.z + 1.0 || sp.z >= box_max.z - 1.0) {
                    continue;
                }
                let liq = get_liquid_world(sp);
                let l_raw = round(abs(liq.x));
                if (l_raw > 0.5 && liq.y > 0.06) {
                    let g_mat = 256.0 + l_raw;
                    if (locked_mat < 0.5 || abs(g_mat - locked_mat) < 0.5) {
                        found_liq_id = g_mat;
                        found_liq_pos = floor(sp) + vec3<f32>(0.5);
                        break;
                    }
                }
            }
            st = st + 0.42;
        }
        if (found_liq_id > 0.5) {
            hit_buffer[1] = vec4<f32>(found_liq_pos, found_liq_id);
        } else {
            hit_buffer[1] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
        }
    } else if (rig_slot == 2) {
        // [3] GAS BELLOWS: Wide-cone Gas ONLY intake (513..520) up to 18m (catches match Fire & ceiling Methane!)
        let max_gas_t = min(select(18.0, t + 0.85, hit), 18.0);
        var found_gas_id: f32 = 0.0;
        var found_gas_pos = vec3<f32>(0.0);
        var st: f32 = 0.0;
        for (var s = 0; s < 44; s = s + 1) {
            if (st > max_gas_t || found_gas_id > 0.5) { break; }
            let base_p = ro + rd * st;
            for (var k = 0u; k < 7u; k = k + 1u) {
                let sp = base_p + offsets[k] * 1.65;
                if (sp.x <= box_min.x + 1.0 || sp.x >= box_max.x - 1.0 ||
                    sp.y <= box_min.y + 1.0 || sp.y >= box_max.y - 1.0 ||
                    sp.z <= box_min.z + 1.0 || sp.z >= box_max.z - 1.0) {
                    continue;
                }
                let gas = get_gas_world(sp);
                let g_raw = round(abs(gas.x));
                if (g_raw > 0.5 && gas.y > 0.06) {
                    let g_mat = 512.0 + g_raw;
                    if (locked_mat < 0.5 || abs(g_mat - locked_mat) < 0.5) {
                        found_gas_id = g_mat;
                        found_gas_pos = floor(sp) + vec3<f32>(0.5);
                        break;
                    }
                }
            }
            st = st + 0.42;
        }
        if (found_gas_id > 0.5) {
            hit_buffer[1] = vec4<f32>(found_gas_pos, found_gas_id);
        } else {
            hit_buffer[1] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
        }
    } else {
        // [4] GAUNTLET & BOOT: CPU handles entity targeting; hit_buffer[3].yzw supplies terrain mat, stress & puddle splash
        hit_buffer[1] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
    }

    // -------------------------------------------------------------------------
    // 3. Phase-Tailored LMB Ballistic / Cone Arc -> hit_buffer[2]
    //    Slot 0 (Solid Sack):   Heavy lob (speed 21, loft +2.2, grav -22), ignores water so you can pack bridges!
    //    Slot 1 (Liquid Flask): High-pressure parabolic stream (speed 26, loft +1.8, grav -18)
    //    Slot 2 (Gas Bellows):  Buoyant flamethrower/gust cone (speed 19, grav +1.6) that sweeps 2..9m in open air!
    // -------------------------------------------------------------------------
    let right_n = normalize(u.cam_right.xyz);
    let up_n    = normalize(u.cam_up.xyz);
    var jpos = ro + right_n * 0.36 - up_n * 0.22 + rd * 0.65;
    var jvel = rd * 26.0 + vec3<f32>(0.0, 1.8, 0.0);
    var jgrav: f32 = -18.0;
    var max_jsteps: i32 = 88;
    if (rig_slot == 0) {
        jvel = rd * 21.0 + vec3<f32>(0.0, 2.2, 0.0);
        jgrav = -22.0;
    } else if (rig_slot == 2) {
        jvel = rd * 19.0 + vec3<f32>(0.0, 0.6, 0.0);
        jgrav = 1.6;
        // Sweep open-air gas/fire bloom continuously along the 2m..9m cone at 60 Hz!
        max_jsteps = 5 + i32(15.0 * fract(u.time * 11.37));
    }
    let jdt: f32 = 0.024;
    let ent_count = u32(max(0.0, u.entity_count));

    var jet_code: f32 = 0.0;
    var jet_impact = jpos;

    for (var step = 0; step < 88; step = step + 1) {
        if (step >= max_jsteps) {
            // Gas Bellows open-air plume bloom!
            jet_impact = jpos;
            jet_code = 1.0;
            break;
        }
        let prev_pos = jpos;
        jvel.y = jvel.y + jgrav * jdt;
        jpos = jpos + jvel * jdt;

        if (jpos.x <= box_min.x + 1.5 || jpos.x >= box_max.x - 1.5 ||
            jpos.y <= box_min.y + 1.5 || jpos.y >= box_max.y - 1.5 ||
            jpos.z <= box_min.z + 1.5 || jpos.z >= box_max.z - 1.5) {
            jet_impact = prev_pos;
            jet_code = 1.0;
            break;
        }
        if (jpos.y <= -191.2) {
            jet_impact = vec3<f32>(jpos.x, -190.8, jpos.z);
            jet_code = 1.0;
            break;
        }

        if (step > 1 && ent_count > 0u) {
            let hit_pad = select(0.45, 0.95, rig_slot == 2);
            for (var ei: u32 = 0u; ei < ent_count && ei < 256u; ei = ei + 1u) {
                let e = s_entities[ei];
                let pl = jpos - e.pos_type.xyz;
                var ed: f32 = 1000.0;
                if (e.pos_type.w < 0.5 || e.pos_type.w >= 1.5) {
                    ed = length(pl) - e.extents_rad.w;
                } else {
                    let q = abs(pl) - e.extents_rad.xyz;
                    ed = length(max(q, vec3<f32>(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
                }
                if (ed <= hit_pad) {
                    jet_impact = jpos;
                    jet_code = 2.0 + f32(ei);
                    break;
                }
            }
            if (jet_code > 0.5) { break; }
        }

        let sv = get_solid_world(jpos);
        let liq_here = get_liquid_world(jpos);
        if (sv.y * 0.5 <= 0.06 || (rig_slot == 1 && step > 3 && liq_here.y > 0.65)) {
            jet_impact = prev_pos;
            jet_code = 1.0;
            break;
        }
    }

    hit_buffer[2] = vec4<f32>(jet_impact, jet_code);

    // -------------------------------------------------------------------------
    // 4. Match Snuff Mask + [4] Gauntlet & Boot Terrain/Stress/Splash Probe -> hit_buffer[3]
    //    .x = snuff_mask, .y = hit_sol_mat (1..255), .z = hit_stress (0..1), .w = splash_mat (257..264)
    // -------------------------------------------------------------------------
    var snuff_mask: u32 = 0u;
    if (u.match_info.x > 0.5) {
        for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
            let m = u.matches[mi];
            if (m.w > 0.01) {
                let l0 = get_liquid_world(m.xyz);
                let l1 = get_liquid_world(m.xyz - vec3<f32>(0.0, 0.35, 0.0));
                let r0 = u32(clamp(round(abs(l0.x)), 0.0, 255.0));
                let r1 = u32(clamp(round(abs(l1.x)), 0.0, 255.0));
                var wet = false;
                if (r0 > 0u && l0.y > 0.08 && (materials[256u + r0].tags & 8388608u) != 0u) {
                    wet = true;
                }
                if (r1 > 0u && l1.y > 0.08 && (materials[256u + r1].tags & 8388608u) != 0u) {
                    wet = true;
                }
                if (wet) {
                    snuff_mask = snuff_mask | (1u << mi);
                }
            }
        }
    }

    var hit_sol_mat: f32 = 0.0;
    var hit_stress: f32 = 0.0;
    if (hit && t <= 16.0) {
        let probe_c = p + rd * 0.45;
        for (var k = 0u; k < 7u; k = k + 1u) {
            let sp = probe_c + offsets[k] * 0.65;
            if (sp.x <= box_min.x + 2.0 || sp.x >= box_max.x - 2.0 ||
                sp.y <= box_min.y + 2.0 || sp.y >= box_max.y - 2.0 ||
                sp.z <= box_min.z + 2.0 || sp.z >= box_max.z - 2.0 || sp.y <= -191.0) {
                continue;
            }
            let sol = get_solid_world(sp);
            let s_raw = round(abs(sol.x));
            if (hit_sol_mat < 0.5 && sol.y <= 0.25 && s_raw >= 0.5) {
                hit_sol_mat = s_raw;
            }
            let st_val = get_light_world(sp).a;
            if (st_val > hit_stress) {
                hit_stress = st_val;
            }
        }
    }

    var splash_mat: f32 = 0.0;
    let max_boot_t = min(select(4.6, t + 0.35, hit), 4.6);
    var bst: f32 = 0.65;
    for (var bs = 0; bs < 10; bs = bs + 1) {
        if (bst > max_boot_t) { break; }
        let bp = ro + rd * bst;
        let bl = get_liquid_world(bp);
        let bl_raw = round(abs(bl.x));
        if (bl_raw > 0.5 && bl.y > 0.10) {
            splash_mat = 256.0 + bl_raw;
            break;
        }
        bst = bst + 0.44;
    }

    hit_buffer[3] = vec4<f32>(f32(snuff_mask), hit_sol_mat, hit_stress, splash_mat);

    // -------------------------------------------------------------------------
    // 5. Ditto-Amoeba Chemoreception & Contact Hazard Probe -> hit_buffer[4 .. 35]
    //    Slot k (0..15):
    //      hit_buffer[4 + 2*k] = vec4(best_snack_x, best_snack_y, best_snack_z, best_snack_mat)
    //      hit_buffer[5 + 2*k] = vec4(touch_liq_mat, touch_gas_mat, touch_igniter, touch_extinguisher)
    // -------------------------------------------------------------------------
    for (var ak: u32 = 0u; ak < 16u; ak = ak + 1u) {
        let c_info = u.critter_lights[ak];
        let out_smell = 4u + ak * 2u;
        let out_touch = 5u + ak * 2u;
        if (c_info.w < 0.5) {
            hit_buffer[out_smell] = vec4<f32>(0.0);
            hit_buffer[out_touch] = vec4<f32>(0.0);
            continue;
        }

        let apos = c_info.xyz;
        let my_mat = round(c_info.w - 1.0);
        let arad = clamp(u.critter_colors[ak].w, 0.35, 0.85);

        // 5a. Direct body contact probe (liquids, gases, igniters, extinguishers, lit matches)
        var touch_liq: f32 = 0.0;
        var touch_gas: f32 = 0.0;
        var touch_ign: f32 = 0.0;
        var touch_ext: f32 = 0.0;

        if (u.match_info.x > 0.5) {
            for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
                let m = u.matches[mi];
                if (m.w > 0.01 && distance(apos, m.xyz) <= arad + 1.35) {
                    touch_ign = 1.0;
                }
            }
        }

        for (var pk = 0u; pk < 7u; pk = pk + 1u) {
            let cp = apos + offsets[pk] * (arad + 0.35);
            if (cp.x <= box_min.x + 2.0 || cp.x >= box_max.x - 2.0 ||
                cp.y <= box_min.y + 2.0 || cp.y >= box_max.y - 2.0 ||
                cp.z <= box_min.z + 2.0 || cp.z >= box_max.z - 2.0) {
                continue;
            }
            let cl = get_liquid_world(cp);
            let cl_id = u32(clamp(round(abs(cl.x)), 0.0, 255.0));
            if (cl_id > 0u && cl.y > 0.08) {
                let lmat = 256.0 + f32(cl_id);
                if (touch_liq < 0.5 || cl_id != 1u) { touch_liq = lmat; }
                let ltags = materials[256u + cl_id].tags;
                if ((ltags & 2u) != 0u) { touch_ign = 1.0; }
                if ((ltags & 8388608u) != 0u) { touch_ext = 1.0; }
            }
            let cg = get_gas_world(cp);
            let cg_id = u32(clamp(round(abs(cg.x)), 0.0, 255.0));
            if (cg_id > 0u && cg.y > 0.08) {
                let gmat = 512.0 + f32(cg_id);
                if (touch_gas < 0.5 || cg_id == 3u || cg_id == 6u || cg_id == 8u) { touch_gas = gmat; }
                let gtags = materials[512u + cg_id].tags;
                if ((gtags & 2u) != 0u) { touch_ign = 1.0; }
            }
        }
        hit_buffer[out_touch] = vec4<f32>(touch_liq, touch_gas, touch_ign, touch_ext);

        // 5b. 3D Chemoreceptor Smell Scan (24 golden-sphere rays across 1.1m .. 7.8m)
        var best_score: f32 = 0.0;
        var best_pos = vec3<f32>(0.0);
        var best_mat: f32 = 0.0;
        let phase = u.time * 2.9 + f32(ak) * 1.73;

        for (var si: u32 = 0u; si < 24u; si = si + 1u) {
            let fi = f32(si);
            let y_dir = 1.0 - (fi + 0.5) * (2.0 / 24.0);
            let r_xy = sqrt(max(0.0, 1.0 - y_dir * y_dir));
            let theta = fi * 2.399963 + phase;
            let sdir = vec3<f32>(cos(theta) * r_xy, y_dir, sin(theta) * r_xy);

            for (var tier: u32 = 0u; tier < 3u; tier = tier + 1u) {
                let dist = select(select(1.25, 3.1, tier == 1u), 6.4, tier == 2u);
                let sp = apos + sdir * dist;
                if (sp.x <= box_min.x + 2.5 || sp.x >= box_max.x - 2.5 ||
                    sp.y <= box_min.y + 2.5 || sp.y >= box_max.y - 2.5 ||
                    sp.z <= box_min.z + 2.5 || sp.z >= box_max.z - 2.5 || sp.y <= -190.5) {
                    continue;
                }

                var cand_mat: f32 = 0.0;
                var appetite: f32 = 0.0;

                // Liquids are juicy, easy to slurp, and great player bait!
                let sl = get_liquid_world(sp);
                let sl_raw = round(abs(sl.x));
                if (sl_raw >= 0.5 && sl.y > 0.08) {
                    cand_mat = 256.0 + sl_raw;
                    // Ambrosia (262), Volatile Gel (263), Oil (260), Acid (259), Toxic Sludge (264), Lava (258), Blood (261), Water (257)
                    appetite = select(14.0, 24.0, sl_raw >= 2.0);
                    if (sl_raw == 6.0 || sl_raw == 7.0) { appetite = 30.0; }
                } else {
                    // Tasty reactive cave solids (skip dull Stone 1, Obsidian 16, Bedrock 255)
                    let ss = get_solid_world(sp);
                    let ss_raw = round(abs(ss.x));
                    if (ss.y <= 0.18 && ss_raw >= 1.5 && ss_raw < 254.5 && ss_raw != 16.0) {
                        cand_mat = ss_raw;
                        appetite = select(15.0, 6.5, ss_raw == 2.0 || ss_raw == 6.0);
                        // Slime (10), Spore Pod (13), Crystal (14), Amethyst (15), Rad-Ore (17), Gold (5), Coal (4), Gunpowder (7), C4 (12)
                        if (ss_raw == 10.0 || ss_raw == 13.0 || ss_raw == 14.0 || ss_raw == 15.0 || ss_raw == 17.0) {
                            appetite = 27.0;
                        } else if (ss_raw == 4.0 || ss_raw == 5.0 || ss_raw == 7.0 || ss_raw == 12.0) {
                            appetite = 21.0;
                        }
                    } else {
                        // Dense energetic gases (Spore Cloud 520, Methane 518)
                        let sg = get_gas_world(sp);
                        let sg_raw = round(abs(sg.x));
                        if (sg.y > 0.16 && (sg_raw == 6.0 || sg_raw == 8.0)) {
                            cand_mat = 512.0 + sg_raw;
                            appetite = 18.0;
                        }
                    }
                }

                if (cand_mat > 0.5) {
                    if (my_mat > 0.5 && abs(cand_mat - my_mat) < 0.5 && cand_mat != 2.0 && cand_mat != 6.0) {
                        appetite = appetite + 14.0;
                    }
                    let score = appetite / (1.0 + 0.24 * dist);
                    if (score > best_score) {
                        best_score = score;
                        best_pos = sp;
                        best_mat = cand_mat;
                    }
                }
            }
        }
        hit_buffer[out_smell] = vec4<f32>(best_pos, best_mat);
    }
}
")
)

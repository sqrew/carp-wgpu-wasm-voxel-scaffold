(def voxel-wgsl
  "struct Entity {
    pos_type: vec4<f32>,
    extents_rad: vec4<f32>,
    color: vec4<f32>,
}

struct Uniforms {
    time: f32,
    width: f32,
    height: f32,
    brush_radius: f32,
    cam_pos: vec4<f32>,
    cam_dir: vec4<f32>,
    cam_right: vec4<f32>,
    cam_up: vec4<f32>,
    sun_dir: vec4<f32>,
    hit_pos: vec4<f32>,
    edit_params: vec4<f32>,
    entity_count: f32,
    pad1: f32,
    pad2: f32,
    pad3: f32,
    entities: array<Entity, 31>,
}

@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(1) var solid_texture: texture_3d<f32>;
@group(0) @binding(2) var voxel_sampler: sampler;
@group(0) @binding(3) var liquid_texture: texture_3d<f32>;
@group(0) @binding(4) var gas_texture: texture_3d<f32>;
@group(0) @binding(5) var light_texture: texture_3d<f32>;

struct VertexOutput {
    @builtin(position) position: vec4<f32>,
    @location(0) uv: vec2<f32>,
}

@vertex
fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
    var pos: array<vec2<f32>, 3> = array<vec2<f32>, 3>(
        vec2<f32>(-1.0, -1.0),
        vec2<f32>( 3.0, -1.0),
        vec2<f32>(-1.0,  3.0),
    );
    var out: VertexOutput;
    let p = pos[vi];
    out.position = vec4<f32>(p, 0.0, 1.0);
    out.uv = (p + 1.0) * 0.5;
    return out;
}

fn intersect_box(ro: vec3<f32>, rd: vec3<f32>, box_min: vec3<f32>, box_max: vec3<f32>, t0: ptr<function, f32>, t1: ptr<function, f32>) -> bool {
    let inv_d = 1.0 / rd;
    let t_bot = inv_d * (box_min - ro);
    let t_top = inv_d * (box_max - ro);
    let t_min = min(t_bot, t_top);
    let t_max = max(t_bot, t_top);
    let t_near = max(t_min.x, max(t_min.y, t_min.z));
    let t_far = min(t_max.x, min(t_max.y, t_max.z));
    *t0 = t_near;
    *t1 = t_far;
    return t_near < t_far && t_far > 0.0;
}

fn getShadow(ro: vec3<f32>, rd: vec3<f32>, mint: f32, maxt: f32, k: f32) -> f32 {
    var res: f32 = 1.0;
    var t = mint;
    for (var i = 0; i < 40; i = i + 1) {
        let p = ro + rd * t;
        let wrapped_p = p - floor(p / 160.0) * 160.0;
        let uvw = clamp(wrapped_p / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
        let h = textureSampleLevel(solid_texture, voxel_sampler, uvw, 0.0).g * 0.5;
        if (h < 0.008) {
            return 0.0;
        }
        res = min(res, k * h / t);
        t += max(0.05, h);
        if (t > maxt) {
            break;
        }
    }
    return clamp(res, 0.2, 1.0);
}

fn getAO(p: vec3<f32>, n: vec3<f32>) -> f32 {
    var occ = 0.0;
    var sca = 1.0;
    for (var i = 0; i < 5; i = i + 1) {
        let hr = 0.05 + 0.15 * f32(i) / 4.0;
        let aopos = p + n * hr;
        let wrapped_p = aopos - floor(aopos / 160.0) * 160.0;
        let uvw = clamp(wrapped_p / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
        let d = textureSampleLevel(solid_texture, voxel_sampler, uvw, 0.0).g * 0.5;
        occ += -(d - hr) * sca;
        sca *= 0.95;
    }
    return clamp(1.0 - occ * 4.0, 0.0, 1.0);
}

fn map_entities(p: vec3<f32>, out_color: ptr<function, vec3<f32>>) -> f32 {
    var min_d = 10000.0;
    let count = u32(u.entity_count);
    for (var i: u32 = 0u; i < count; i = i + 1u) {
        let e = u.entities[i];
        let p_local = p - e.pos_type.xyz;
        var d = 10000.0;
        if (e.pos_type.w < 0.5) {
            // Sphere
            d = length(p_local) - e.extents_rad.w;
        } else {
            // Box
            let q = abs(p_local) - e.extents_rad.xyz;
            d = length(max(q, vec3<f32>(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
        }
        if (d < min_d) {
            min_d = d;
            *out_color = e.color.rgb;
        }
    }
    return min_d;
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    let aspect = u.width / u.height;
    let uv = (in.uv * 2.0 - 1.0) * vec2<f32>(aspect, 1.0);
    
    let ro = u.cam_pos.xyz;
    let rd = normalize(u.cam_dir.xyz * 2.0 + uv.x * u.cam_right.xyz + uv.y * u.cam_up.xyz);
    
    let cx = floor(u.cam_pos.x / 32.0);
    let cy = floor(u.cam_pos.y / 32.0);
    let cz = floor(u.cam_pos.z / 32.0);
    let box_min = vec3<f32>(cx - 2.0, cy - 2.0, cz - 2.0) * 32.0;
    let box_max = box_min + 160.0;
    
    var t_near: f32 = 0.0;
    var t_far: f32 = 0.0;
    
    // Create sky gradient based on ray direction Y component and orbiting sun Y height
    let sun_h = u.sun_dir.y;
    
    // Day / Night interpolation factors
    let day_factor = clamp(sun_h * 5.0 + 0.5, 0.0, 1.0);
    let sunset_factor = clamp(1.0 - abs(sun_h) * 5.0, 0.0, 1.0);
    
    // Base sky colors
    let day_space = vec3<f32>(0.05, 0.12, 0.25);
    let day_horizon = vec3<f32>(0.2, 0.38, 0.58);
    
    let sunset_space = vec3<f32>(0.06, 0.04, 0.12);
    let sunset_horizon = vec3<f32>(0.65, 0.28, 0.12);
    
    let night_space = vec3<f32>(0.002, 0.004, 0.008);
    let night_horizon = vec3<f32>(0.01, 0.015, 0.035);
    
    let space_color = mix(mix(night_space, sunset_space, sunset_factor), day_space, day_factor);
    let horizon_color = mix(mix(night_horizon, sunset_horizon, sunset_factor), day_horizon, day_factor);
    
    let sky_dir_y = max(0.0, rd.y);
    var color = mix(space_color, horizon_color, sky_dir_y);
    
    // Add orbiting sun
    let light_dir = normalize(u.sun_dir.xyz);
    let sun_cos = dot(rd, light_dir);
    if (sun_h > -0.2 && sun_cos > 0.0) {
        let sun_fade = clamp(sun_h * 5.0 + 1.0, 0.0, 1.0);
        let sun_glow = pow(sun_cos, 120.0) * 1.5 * sun_fade;
        let sun_disk = pow(sun_cos, 1200.0) * 4.0 * sun_fade;
        color += vec3<f32>(1.0, 0.9, 0.7) * (sun_glow + sun_disk);
    }

    // Add orbiting moon in opposite direction
    let moon_dir = -light_dir;
    let moon_cos = dot(rd, moon_dir);
    if (sun_h < 0.2 && moon_cos > 0.0) {
        let moon_fade = clamp(-sun_h * 5.0 + 1.0, 0.0, 1.0);
        let moon_glow = pow(moon_cos, 160.0) * 0.4 * moon_fade;
        let moon_disk = pow(moon_cos, 2000.0) * 1.2 * moon_fade;
        color += vec3<f32>(0.7, 0.8, 1.0) * (moon_glow + moon_disk);
    }
    
    if (intersect_box(ro, rd, box_min, box_max, &t_near, &t_far)) {
        let t_start = max(t_near, 0.0);
        var t = t_start;
        var hit = false;
        var hit_color = vec3<f32>(0.0);
        var accum_color = vec3<f32>(0.0);
        var accum_alpha: f32 = 0.0;
        
        for (var step = 0; step < 128; step = step + 1) {
            if (t > t_far) {
                break;
            }
            let p = ro + rd * t;
            
            // Clamp normalized coordinates slightly inside [0, 1] to avoid border interpolation artifacts
            let wrapped_p = p - floor(p / 160.0) * 160.0;
            let uvw = clamp(wrapped_p / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
            
            // Sample SDF value from green channel (G) and scale by 0.5 (Lipschitz constant bound for Simplex noise)
            let val = textureSampleLevel(solid_texture, voxel_sampler, uvw, 0.0);
            let dist_vox = val.g * 0.5;
            var ent_color = vec3<f32>(0.0);
            let dist_ent = map_entities(p, &ent_color);
            let dist = min(dist_vox, dist_ent);
            
            if (dist_ent < 0.008 && dist_ent < dist_vox) {
                let eps = 0.01;
                var dummy = vec3<f32>(0.0);
                let n = vec3<f32>(
                    map_entities(p + vec3<f32>(eps, 0.0, 0.0), &dummy) - map_entities(p - vec3<f32>(eps, 0.0, 0.0), &dummy),
                    map_entities(p + vec3<f32>(0.0, eps, 0.0), &dummy) - map_entities(p - vec3<f32>(0.0, eps, 0.0), &dummy),
                    map_entities(p + vec3<f32>(0.0, 0.0, eps), &dummy) - map_entities(p - vec3<f32>(0.0, 0.0, eps), &dummy)
                );
                let normal = normalize(n);
                let light_dir = normalize(u.sun_dir.xyz);
                let sun_intensity = clamp(u.sun_dir.y * 4.0, 0.0, 1.0);
                let diffuse = max(dot(normal, light_dir), 0.0);
                let sha = getShadow(p + normal * 0.05, light_dir, 0.05, 40.0, 16.0);
                let ao = getAO(p, normal);
                let ambient = vec3<f32>(0.2, 0.25, 0.35) * ao;
                let direct = vec3<f32>(1.0, 0.95, 0.85) * diffuse * sha * sun_intensity;
                let solid_col = ent_color * (direct + ambient);
                hit_color = mix(solid_col, accum_color, accum_alpha);
                hit = true;
                break;
            }
            
            // Accumulate Fluids and Gases
            let ip_cell = vec3<i32>(clamp(wrapped_p, vec3<f32>(0.0), vec3<f32>(159.0)));

            let liq_val = textureSampleLevel(liquid_texture, voxel_sampler, uvw, 0.0);
            if (liq_val.g > 0.05) {
                var liq_color = vec3<f32>(0.1, 0.4, 0.8); // Default Water
                var absorb = 2.0;
                let raw_liq = textureLoad(liquid_texture, ip_cell, 0);
                let id = round(raw_liq.r);
                if (id == 2.0) {
                    liq_color = vec3<f32>(1.0, 0.3, 0.0); // Lava
                    absorb = 5.0;
                } else if (id == 3.0) {
                    liq_color = vec3<f32>(0.15, 0.85, 0.25); // Acid (green)
                    absorb = 3.0;
                } else if (id == 4.0) {
                    liq_color = vec3<f32>(0.35, 0.25, 0.1); // Oil (dark yellow/brown)
                    absorb = 4.5;
                }
                let step_size = max(0.008, dist);
                let alpha = 1.0 - exp(-liq_val.g * step_size * absorb);
                accum_color = mix(accum_color, liq_color, alpha * (1.0 - accum_alpha));
                accum_alpha = accum_alpha + alpha * (1.0 - accum_alpha);
            }

            let gas_val = textureSampleLevel(gas_texture, voxel_sampler, uvw, 0.0);
            if (gas_val.g > 0.05) {
                var gas_color = vec3<f32>(0.7, 0.7, 0.75); // Steam
                var absorb = 0.8;
                let raw_gas = textureLoad(gas_texture, ip_cell, 0);
                let id = round(raw_gas.r);
                if (id == 2.0) {
                    gas_color = vec3<f32>(0.4, 0.9, 0.1); // Toxic Gas
                    absorb = 1.2;
                } else if (id == 3.0) {
                    let flicker = sin(u.time * 15.0 + dot(uvw, vec3<f32>(100.0))) * 0.15 + 0.85;
                    gas_color = vec3<f32>(1.0, 0.35 * flicker, 0.0); // Fire
                    absorb = 2.0 * flicker;
                } else if (id == 4.0) {
                    gas_color = vec3<f32>(0.15, 0.15, 0.15); // Smoke
                    absorb = 1.8;
                }
                let step_size = max(0.008, dist);
                let alpha = (1.0 - exp(-gas_val.g * step_size * absorb)) * 0.4;
                accum_color = mix(accum_color, gas_color, alpha * (1.0 - accum_alpha));
                accum_alpha = accum_alpha + alpha * (1.0 - accum_alpha);
            }
            
            if (dist < 0.008) {
                // Hit! Calculate normals using finite differences
                let eps = 0.5;
                let n = vec3<f32>(
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p + vec3<f32>(eps, 0.0, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g - 
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p - vec3<f32>(eps, 0.0, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g,
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p + vec3<f32>(0.0, eps, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g - 
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p - vec3<f32>(0.0, eps, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g,
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p + vec3<f32>(0.0, 0.0, eps), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g - 
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p - vec3<f32>(0.0, 0.0, eps), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g
                );
                let normal = normalize(n);
                
                // Fetch discrete material ID using textureLoad at the nearest integer coordinate (avoids trilinear bleeding!)
                let ip = vec3<i32>(clamp(wrapped_p, vec3<f32>(0.0), vec3<f32>(159.0)));
                let raw_voxel = textureLoad(solid_texture, ip, 0);
                let mat_id = raw_voxel.r;
                
                // Color based on material ID
                var base_color = vec3<f32>(0.3, 0.3, 0.3);
                let id = round(mat_id);
                if (id == 1.0) {
                    base_color = vec3<f32>(0.45, 0.45, 0.45); // Stone
                } else if (id == 2.0) {
                    base_color = vec3<f32>(0.2, 0.6, 0.25);   // Grass / Soil
                } else if (id == 3.0) {
                    base_color = vec3<f32>(0.5, 0.3, 0.15);   // Wood
                } else if (id == 4.0) {
                    base_color = vec3<f32>(0.1, 0.1, 0.1);    // Coal
                } else if (id == 5.0) {
                    base_color = vec3<f32>(0.95, 0.75, 0.15);  // Gold
                }
                
                let light_dir = normalize(u.sun_dir.xyz);
                let sun_intensity = clamp(u.sun_dir.y * 4.0, 0.0, 1.0);
                let diffuse = max(dot(normal, light_dir), 0.0);
                
                // Raymarched Shadows (only computed when sun is above horizon!)
                var sha: f32 = 1.0;
                if (sun_intensity > 0.0) {
                    let shadow_pos = p + normal * 0.05;
                    sha = getShadow(shadow_pos, light_dir, 0.05, 40.0, 16.0);
                }
                
                // Moon light (faint blue direct light at night)
                let moon_dir = -light_dir;
                let moon_intensity = clamp(-u.sun_dir.y * 4.0, 0.0, 1.0) * 0.15;
                let moon_diffuse = max(dot(normal, moon_dir), 0.0);
                let moon_light = vec3<f32>(0.7, 0.8, 1.0) * moon_diffuse * moon_intensity;
                
                // Ambient Occlusion
                let ao = getAO(p, normal);
                
                // Blend ambient sunlight and night sky ambient
                let ambient_intensity = clamp(u.sun_dir.y * 3.0 + 0.3, 0.05, 1.0);
                
                // Combine Shading with Light Texture
                let light_val = textureSampleLevel(light_texture, voxel_sampler, uvw, 0.0) + vec4<f32>(0.0, 0.0, 0.0, 1.0);
                let ambient = vec3<f32>(0.1, 0.12, 0.2) * ao * light_val.a * ambient_intensity;
                let direct = vec3<f32>(1.0, 0.95, 0.85) * diffuse * sha * light_val.a * sun_intensity;
                let block_light = light_val.rgb;
                
                // Player Ambient Glow (spherical light source centered on player)
                var player_glow = vec3<f32>(0.0);
                if (u.cam_pos.w > 0.5) {
                    let attenuation = 1.0 / (1.0 + 0.05 * t + 0.012 * t * t);
                    player_glow = vec3<f32>(1.0, 0.96, 0.88) * attenuation * 2.5;
                }
                
                let solid_col = base_color * (direct + ambient + moon_light + block_light + player_glow);
                hit_color = mix(solid_col, accum_color, accum_alpha);
                hit = true;
                break;
            }
            
            // Step forward by the SDF value, capped to prevent jumping over volumes
            t = t + clamp(dist, 0.008, 1.2);
        }
        
        if (hit) {
            // Apply linear atmospheric distance fog ending at the world box boundary (80 units)
            let fog_factor = clamp((t - 40.0) / 40.0, 0.0, 1.0);
            
            // The fog color is the horizon color mixed with the space color
            let fog_color = mix(space_color, horizon_color, max(0.0, rd.y));
            color = mix(hit_color, fog_color, fog_factor);
        } else {
            color = mix(color, accum_color, accum_alpha);
        }
    }
    
    let dummy = textureSampleLevel(liquid_texture, voxel_sampler, vec3<f32>(0.0), 0.0).r +
                textureSampleLevel(gas_texture, voxel_sampler, vec3<f32>(0.0), 0.0).r;
    return vec4<f32>(color + dummy * 0.000001, 1.0);
}
")

(def voxel-wgsl
  "
struct Material {
    id: f32,
    r: f32,
    g: f32,
    b: f32,
    a: f32,
    density: f32,
    toughness: f32,
    tags: u32,
}
struct Entity {
    pos_type: vec4<f32>,
    extents_rad: vec4<f32>,
    color: vec4<f32>,
}

struct Uniforms {
    time: f32,
    width: f32,
    height: f32,
    brush_radius: f32,
    cam_pos: vec4<f32>,
    cam_dir: vec4<f32>,
    cam_right: vec4<f32>,
    cam_up: vec4<f32>,
    sun_dir: vec4<f32>,
    hit_pos: vec4<f32>,
    edit_params: vec4<f32>,
    solid_params: vec4<f32>,
    entity_count: f32,
    pad1: f32,
    pad2: f32,
    pad3: f32,
    view_proj: mat4x4<f32>,
    flask_pos: vec4<f32>,
    flask_action: vec4<f32>,
    matches: array<vec4<f32>, 8>,
    match_info: vec4<f32>,
    critter_pos: vec4<f32>,
    critter_action: vec4<f32>,
    critter_lights: array<vec4<f32>, 16>,
    critter_colors: array<vec4<f32>, 16>,
    vox_pos: array<vec4<f32>, 12>,
    vox_act: array<vec4<f32>, 12>,
    hopper_pos: array<vec4<f32>, 16>,
    mancer_pos: array<vec4<f32>, 4>,
    mancer_mat: array<vec4<f32>, 4>,
    wake_p0: array<vec4<f32>, 16>,
    wake_p1: array<vec4<f32>, 16>,
    wake_vel: array<vec4<f32>, 16>,
}

struct FragmentOutput {
    @location(0) color: vec4<f32>,
    @builtin(frag_depth) depth: f32,
}

@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(1) var solid_texture: texture_3d<f32>;
@group(0) @binding(2) var voxel_sampler: sampler;
@group(0) @binding(3) var liquid_texture: texture_3d<f32>;
@group(0) @binding(4) var gas_texture: texture_3d<f32>;
@group(0) @binding(5) var light_texture: texture_3d<f32>;
@group(0) @binding(6) var<storage, read> materials: array<Material>;
@group(0) @binding(7) var<storage, read> s_entities: array<Entity>;
@group(0) @binding(8) var vel_texture: texture_3d<f32>;

struct VertexOutput {
    @builtin(position) position: vec4<f32>,
    @location(0) uv: vec2<f32>,
}

@vertex
fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
    var pos: array<vec2<f32>, 3> = array<vec2<f32>, 3>(
        vec2<f32>(-1.0, -1.0),
        vec2<f32>( 3.0, -1.0),
        vec2<f32>(-1.0,  3.0),
    );
    var out: VertexOutput;
    let p = pos[vi];
    out.position = vec4<f32>(p, 0.0, 1.0);
    out.uv = (p + 1.0) * 0.5;
    return out;
}

fn intersect_box(ro: vec3<f32>, rd: vec3<f32>, box_min: vec3<f32>, box_max: vec3<f32>, t0: ptr<function, f32>, t1: ptr<function, f32>) -> bool {
    let inv_d = 1.0 / rd;
    let t_bot = inv_d * (box_min - ro);
    let t_top = inv_d * (box_max - ro);
    let t_min = min(t_bot, t_top);
    let t_max = max(t_bot, t_top);
    let t_near = max(t_min.x, max(t_min.y, t_min.z));
    let t_far = min(t_max.x, min(t_max.y, t_max.z));
    *t0 = t_near;
    *t1 = t_far;
    return t_near < t_far && t_far > 0.0;
}

fn getShadow(ro: vec3<f32>, rd: vec3<f32>, mint: f32, maxt: f32, k: f32) -> f32 {
    var res: f32 = 1.0;
    var t = mint;
    var ph: f32 = 1e20; // previous h
    for (var i = 0; i < 40; i = i + 1) {
        let p = ro + rd * t;
        let wrapped_p = p - floor(p / 160.0) * 160.0;
        let uvw = clamp(wrapped_p / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
        let h = textureSampleLevel(solid_texture, voxel_sampler, uvw, 0.0).g * 0.5;
        
        if (h < 0.008) {
            return 0.05; // Never completely black, some scattered light
        }
        
        // Improved IQ Soft Shadow (prevents artifact banding on sharp edges)
        let y = (h * h) / (2.0 * ph);
        let d = sqrt(max(0.0, h * h - y * y));
        res = min(res, k * d / max(0.0, t - y));
        ph = h;
        
        t += max(0.1, h); // Avoid marching too slowly over edges
        if (t > maxt) {
            break;
        }
    }
    // Boost contrast of the penumbra
    return clamp(res * res * (3.0 - 2.0 * res), 0.05, 1.0);
}

fn getAO(p: vec3<f32>, n: vec3<f32>) -> f32 {
    var occ = 0.0;
    var sca = 1.0;
    // Step out significantly further. 1 voxel = 1.0 unit.
    for (var i = 0; i < 5; i = i + 1) {
        let hr = 0.25 + 1.25 * f32(i); // Steps: 0.25, 1.5, 2.75, 4.0, 5.25 voxels
        let aopos = p + n * hr;
        let wrapped_p = aopos - floor(aopos / 160.0) * 160.0;
        let uvw = clamp(wrapped_p / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
        let d = textureSampleLevel(solid_texture, voxel_sampler, uvw, 0.0).g * 0.5;
        
        // Accumulate occlusion if the distance to surface is less than our step-out distance
        occ += max(0.0, (hr - d)) * sca;
        sca *= 0.7; // Falloff weight for further samples
    }
    // High intensity clamping for a deep, rich occlusion
    return clamp(1.0 - occ * 0.35, 0.0, 1.0);
}

// ---------------------------------------------------------------------------
// 3D Procedural Stress Fracture Functions (driven by light_texture.a [0..1])
// ---------------------------------------------------------------------------
fn hash33(q: vec3<i32>) -> vec3<f32> {
    var v = bitcast<vec3<u32>>(q) * 1664525u + vec3<u32>(1013904223u);
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v = v ^ (v >> vec3<u32>(16u));
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return vec3<f32>(v & vec3<u32>(65535u)) / 65535.0;
}

fn vnoise3(x: vec3<f32>) -> vec3<f32> {
    let i = vec3<i32>(floor(x));
    let f = fract(x);
    let u_f = f * f * (3.0 - 2.0 * f);
    let n000 = hash33(i + vec3<i32>(0, 0, 0));
    let n100 = hash33(i + vec3<i32>(1, 0, 0));
    let n010 = hash33(i + vec3<i32>(0, 1, 0));
    let n110 = hash33(i + vec3<i32>(1, 1, 0));
    let n001 = hash33(i + vec3<i32>(0, 0, 1));
    let n101 = hash33(i + vec3<i32>(1, 0, 1));
    let n011 = hash33(i + vec3<i32>(0, 1, 1));
    let n111 = hash33(i + vec3<i32>(1, 1, 1));
    let nx00 = mix(n000, n100, u_f.x);
    let nx10 = mix(n010, n110, u_f.x);
    let nx01 = mix(n001, n101, u_f.x);
    let nx11 = mix(n011, n111, u_f.x);
    let nxy0 = mix(nx00, nx10, u_f.y);
    let nxy1 = mix(nx01, nx11, u_f.y);
    return mix(nxy0, nxy1, u_f.z) * 2.0 - vec3<f32>(1.0);
}

struct FractureProfile {
    scale: vec3<f32>,
    jitter: f32,
    warp_smooth: f32,
    warp_jagged: f32,
    width_mul: f32,
    splinter_gain: f32,
    sub_scale: f32,
}

fn get_fracture_profile(mat_id_u: u32, tags: u32, toughness: f32) -> FractureProfile {
    let is_brittle = (tags & 16384u) != 0u;
    let is_organic = (tags & 536870912u) != 0u;
    let is_granular = (tags & 2048u) != 0u;
    let is_transparent = (tags & 4194304u) != 0u;

    var prof: FractureProfile;
    prof.scale = vec3<f32>(1.20, 1.20, 1.20);
    prof.jitter = select(0.80, 0.52, is_brittle && is_transparent);
    prof.warp_smooth = select(0.24, 0.50, is_organic || is_granular);
    prof.warp_jagged = select(0.14, 0.28, is_brittle);
    prof.width_mul = select(1.0, 0.78, is_brittle);
    prof.splinter_gain = select(0.85, 1.25, is_brittle);
    prof.sub_scale = 3.4;

    if (is_organic || is_granular) {
        prof.warp_jagged = 0.04;
        prof.width_mul = 1.35;
        prof.splinter_gain = 0.22;
    }

    switch (mat_id_u) {
        case 1u: { // Stone: horizontal sedimentary strata + gritty stepped joints
            prof.scale = vec3<f32>(1.15, 1.68, 1.15);
            prof.jitter = 0.80;
            prof.warp_smooth = 0.22;
            prof.warp_jagged = 0.20;
            prof.width_mul = 0.96;
            prof.splinter_gain = 0.85;
            prof.sub_scale = 3.3;
        }
        case 2u: { // Soil: crumbly rounded earth desiccation & slump tears
            prof.scale = vec3<f32>(1.08, 1.08, 1.08);
            prof.jitter = 0.88;
            prof.warp_smooth = 0.54;
            prof.warp_jagged = 0.03;
            prof.width_mul = 1.45;
            prof.splinter_gain = 0.18;
            prof.sub_scale = 2.6;
        }
        case 3u: { // Wood: long vertical fibrous grain splits & splinters
            prof.scale = vec3<f32>(2.85, 0.48, 2.85);
            prof.jitter = 0.68;
            prof.warp_smooth = 0.12;
            prof.warp_jagged = 0.22;
            prof.width_mul = 1.05;
            prof.splinter_gain = 0.95;
            prof.sub_scale = 4.2;
        }
        case 4u: { // Coal: blocky cleat-jointed seams with sharp angular kinks
            prof.scale = vec3<f32>(1.32, 1.85, 1.32);
            prof.jitter = 0.50;
            prof.warp_smooth = 0.07;
            prof.warp_jagged = 0.26;
            prof.width_mul = 0.98;
            prof.splinter_gain = 1.05;
            prof.sub_scale = 3.5;
        }
        case 5u: { // Gold: tight ductile metallic stress creases
            prof.scale = vec3<f32>(1.65, 1.65, 1.65);
            prof.jitter = 0.60;
            prof.warp_smooth = 0.28;
            prof.warp_jagged = 0.10;
            prof.width_mul = 0.72;
            prof.splinter_gain = 0.45;
            prof.sub_scale = 3.0;
        }
        case 8u: { // Ice: glacial lightning-bolt kinks + crisp frost spiderwebs
            prof.scale = vec3<f32>(1.18, 1.18, 1.18);
            prof.jitter = 0.78;
            prof.warp_smooth = 0.05;
            prof.warp_jagged = 0.36;
            prof.width_mul = 0.76;
            prof.splinter_gain = 1.35;
            prof.sub_scale = 3.9;
        }
        case 9u: { // Glass: knife-thin conchoidal shatter + dense micro-webbing
            prof.scale = vec3<f32>(1.28, 1.28, 1.28);
            prof.jitter = 0.48;
            prof.warp_smooth = 0.02;
            prof.warp_jagged = 0.15;
            prof.width_mul = 0.62;
            prof.splinter_gain = 1.48;
            prof.sub_scale = 4.5;
        }
        case 13u: { // Spore Pod: glowing bioluminescent cellular membrane veins
            prof.scale = vec3<f32>(1.25, 1.25, 1.25);
            prof.jitter = 0.72;
            prof.warp_smooth = 0.58;
            prof.warp_jagged = 0.0;
            prof.width_mul = 1.20;
            prof.splinter_gain = 0.40;
            prof.sub_scale = 2.8;
        }
        case 14u, 15u: { // Crystal & Amethyst: straight geometric polyhedral cleavage facets
            prof.scale = vec3<f32>(1.25, 1.15, 1.25);
            prof.jitter = 0.28;
            prof.warp_smooth = 0.015;
            prof.warp_jagged = 0.06;
            prof.width_mul = 0.68;
            prof.splinter_gain = 1.30;
            prof.sub_scale = 3.2;
        }
        case 16u: { // Obsidian: volcanic glass razor-jagged lightning fractures
            prof.scale = vec3<f32>(1.22, 1.22, 1.22);
            prof.jitter = 0.76;
            prof.warp_smooth = 0.03;
            prof.warp_jagged = 0.40;
            prof.width_mul = 0.74;
            prof.splinter_gain = 1.40;
            prof.sub_scale = 4.1;
        }
        case 17u: { // Rad-Ore: dense jagged radioactive mineral seams
            prof.scale = vec3<f32>(1.60, 1.60, 1.60);
            prof.jitter = 0.70;
            prof.warp_smooth = 0.08;
            prof.warp_jagged = 0.34;
            prof.width_mul = 0.84;
            prof.splinter_gain = 1.20;
            prof.sub_scale = 3.7;
        }
        default: {
            if (toughness >= 8.0) {
                prof.width_mul *= 0.82;
            }
        }
    }
    return prof;
}

// Single-pass 3D Euclidean Voronoi edge distance + analytical seam direction with per-material jitter
fn voronoi_edge_3d(x: vec3<f32>, jitter_amt: f32) -> vec4<f32> {
    let base = vec3<i32>(floor(x));
    let frac_p = fract(x);
    let j_margin = 0.5 * (1.0 - jitter_amt);
    var d1: f32 = 8.0;
    var d2: f32 = 8.0;
    var r1 = vec3<f32>(0.0);
    var r2 = vec3<f32>(0.0);

    for (var kz = -1; kz <= 1; kz = kz + 1) {
        for (var ky = -1; ky <= 1; ky = ky + 1) {
            for (var kx = -1; kx <= 1; kx = kx + 1) {
                let g = vec3<f32>(f32(kx), f32(ky), f32(kz));
                let jitter = hash33(base + vec3<i32>(kx, ky, kz));
                let r = g + (vec3<f32>(j_margin) + jitter_amt * jitter) - frac_p;
                let d = dot(r, r);
                if (d < d1) {
                    d2 = d1;
                    r2 = r1;
                    d1 = d;
                    r1 = r;
                } else if (d < d2) {
                    d2 = d;
                    r2 = r;
                }
            }
        }
    }
    let diff = r2 - r1;
    let seam_dir = diff / max(length(diff), 0.0001);
    let edge_dist = abs(0.5 * dot(r1 + r2, seam_dir));
    return vec4<f32>(seam_dir, edge_dist);
}

// Returns vec4(tangent_bevel_normal.xyz, crack_fissure_core)
fn eval_fracture_3d(p: vec3<f32>, strain: f32, surf_n: vec3<f32>, mat_id_u: u32, tags: u32, toughness: f32) -> vec4<f32> {
    let prof = get_fracture_profile(mat_id_u, tags, toughness);

    // Derive both smooth organic curves and folded C0 jagged lightning kinks from the same 2 world-space noise samples
    let n_lo = vnoise3(p * 2.15);
    let n_hi = vnoise3(p * 5.9);
    let smooth_w = n_lo * 0.75 + n_hi * 0.25;
    let jagged_w = (abs(n_lo) * 2.0 - vec3<f32>(1.0)) * 0.62 + (abs(n_hi) * 2.0 - vec3<f32>(1.0)) * 0.38;
    let warp = smooth_w * prof.warp_smooth + jagged_w * prof.warp_jagged;

    let v1 = voronoi_edge_3d(p * prof.scale + warp, prof.jitter);
    let grad1 = v1.xyz * prof.scale;
    let grad_len1 = max(length(grad1), 0.25);
    let seam_n1 = grad1 / grad_len1;
    let d1_world = v1.w / grad_len1;

    let pinch = clamp(0.62 + 0.58 * vnoise3(p * 0.85 + vec3<f32>(11.3, 4.7, 8.1)).x, 0.22, 1.25);
    let w1 = mix(0.014, 0.100, strain * strain) * prof.width_mul * mix(pinch, 1.0, strain * 0.6);
    let core1 = 1.0 - smoothstep(0.0, w1, d1_world);
    let lip1  = 1.0 - smoothstep(w1 * 0.35, w1 * 2.2, d1_world);

    var core2: f32 = 0.0;
    var lip2:  f32 = 0.0;
    var seam_n2 = vec3<f32>(0.0);
    if (strain > 0.26 && prof.splinter_gain > 0.05) {
        let sub_s = smoothstep(0.26, 0.96, strain);
        let sub_scale_vec = prof.scale * (prof.sub_scale / 1.20);
        let sub_jitter = clamp(prof.jitter + 0.10, 0.28, 0.90);
        let v2 = voronoi_edge_3d(p * sub_scale_vec + warp * 1.85 + vec3<f32>(7.7, 3.1, 13.9), sub_jitter);
        let grad2 = v2.xyz * sub_scale_vec;
        let grad_len2 = max(length(grad2), 0.50);
        seam_n2 = grad2 / grad_len2;
        let d2_world = v2.w / grad_len2;

        let branch_mask = clamp(sub_s * prof.splinter_gain * (0.42 + 0.88 * smoothstep(0.36, 0.03, d1_world)), 0.0, 1.0);
        let w2 = mix(0.003, 0.022, branch_mask) * prof.width_mul;
        core2 = (1.0 - smoothstep(0.0, w2, d2_world)) * branch_mask * 0.88;
        lip2  = (1.0 - smoothstep(w2 * 0.3, w2 * 2.1, d2_world)) * branch_mask * 0.55;
    }

    let tang1 = seam_n1 - surf_n * dot(seam_n1, surf_n);
    let tang2 = seam_n2 - surf_n * dot(seam_n2, surf_n);
    let bevel = (tang1 * lip1 * (1.0 - core1 * 0.55) * 0.9 + tang2 * lip2 * 0.45) * (0.45 + 0.65 * strain);
    let crack_core = clamp(max(core1, core2), 0.0, 1.0);
    return vec4<f32>(bevel, crack_core);
}

fn smin_poly(a: f32, b: f32, k: f32) -> f32 {
    let h = clamp(0.5 + 0.5 * (b - a) / max(k, 0.001), 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

// 6 Lawmancer Color Sets:
// 0 = Thermo (Molten Amber sphere | - Cryo Cyan / + Solar Orange torus)
// 1 = Baro   (Abyssal Teal sphere | - Vacuum Indigo / + Shockwave Mint torus)
// 2 = Gravi  (Event-Horizon Plum sphere | - Zero-G Magenta / + 4G Crush Crimson torus)
// 3 = Chrono (Clockwork Brass sphere | - Stasis Amber / + Surge Emerald torus)
// 4 = Photo  (Prismatic Chrome sphere | - Umbral Void / + Solar White-Gold torus)
// 5 = Electro(Cobalt-Copper sphere | - Cathode Electric Blue / + Anode Volt-Yellow torus)
fn get_law_sphere_col(law_id: u32) -> vec3<f32> {
    switch (law_id) {
        case 0u: { return vec3<f32>(1.15, 0.36, 0.08); }
        case 1u: { return vec3<f32>(0.08, 0.52, 0.64); }
        case 2u: { return vec3<f32>(0.36, 0.08, 0.62); }
        case 3u: { return vec3<f32>(1.05, 0.78, 0.22); }
        case 4u: { return vec3<f32>(1.32, 1.35, 1.42); }
        default: { return vec3<f32>(0.14, 0.56, 1.22); }
    }
}

fn get_law_torus_col(law_id: u32, pol: f32) -> vec3<f32> {
    let pos = pol >= 0.0;
    switch (law_id) {
        case 0u: { return select(vec3<f32>(0.16, 0.95, 1.85), vec3<f32>(2.30, 0.68, 0.14), pos); }
        case 1u: { return select(vec3<f32>(0.24, 0.30, 1.70), vec3<f32>(0.32, 1.95, 1.38), pos); }
        case 2u: { return select(vec3<f32>(1.85, 0.32, 1.95), vec3<f32>(2.20, 0.14, 0.34), pos); }
        case 3u: { return select(vec3<f32>(1.65, 0.58, 0.10), vec3<f32>(0.26, 2.05, 0.86), pos); }
        case 4u: { return select(vec3<f32>(0.02, 0.01, 0.05), vec3<f32>(2.55, 2.38, 1.75), pos); }
        default: { return select(vec3<f32>(0.18, 1.25, 2.25), vec3<f32>(1.95, 2.35, 0.18), pos); }
    }
}

// Levitating Hooded Phase-Bender Warlock & Geometric Lawmancer SDF:
// mkind == 5.0: Solidmancer (Lithomancer) — Chiseled monolith cloak + floating tectonic shoulder pauldrons + 4-spire diamond crown
// mkind == 6.0: Liquidmancer (Hydromancer) — Undulating amphora/jellyfish bell skirt + high-crested wave collar + twin-ring droplet chalice crown
// mkind == 7.0: Gasmancer (Aeromancer) — Inverted cyclone/djinn-vortex body tapering to a corkscrewing tornado tail + spinning twin-gyroscope crown
// mkind >= 8.0: Lawmancer (Thermo/Baro/Gravi/Chrono/Photo/Electro) — Floating Inner Sphere + Precessing Torus + literal + or - Crown Sign!
fn eval_mancer_sdf(p_local: vec3<f32>, fwd_raw: vec3<f32>, rad: f32, mkind: f32, time: f32) -> f32 {
    let s = max(rad, 0.48);
    let flen = length(vec2<f32>(fwd_raw.x, fwd_raw.z));
    let fwd = select(vec3<f32>(0.0, 0.0, 1.0), vec3<f32>(fwd_raw.x / flen, 0.0, fwd_raw.z / flen), flen > 0.05);
    let side = vec3<f32>(-fwd.z, 0.0, fwd.x);

    if (mkind >= 7.5) {
        let bob = 0.06 * s * sin(time * 2.8);
        let p_core = p_local - vec3<f32>(0.0, 0.16 * s + bob, 0.0);
        let d_sphere = length(p_core) - 0.45 * s;

        let t_ang = time * 2.4;
        let n_ring = normalize(vec3<f32>(0.38 * cos(t_ang), 1.0, 0.38 * sin(t_ang)));
        let r_y = dot(p_core, n_ring);
        let r_plane = length(p_core - n_ring * r_y);
        let d_torus = length(vec2<f32>(r_plane - 0.78 * s, r_y)) - 0.088 * s;

        let pol = fwd_raw.y;
        let p_sign = p_local - vec3<f32>(0.0, 1.18 * s + bob, 0.0);
        let sx = dot(p_sign, side);
        let sy = p_sign.y;
        let sz = dot(p_sign, fwd);
        let q_h = abs(vec3<f32>(sx, sy, sz)) - vec3<f32>(0.29 * s, 0.068 * s, 0.068 * s);
        let d_hbar = length(max(q_h, vec3<f32>(0.0))) + min(max(q_h.x, max(q_h.y, q_h.z)), 0.0) - 0.014 * s;
        var d_sign = d_hbar;
        if (pol >= 0.0) {
            let q_v = abs(vec3<f32>(sx, sy, sz)) - vec3<f32>(0.068 * s, 0.29 * s, 0.068 * s);
            let d_vbar = length(max(q_v, vec3<f32>(0.0))) + min(max(q_v.x, max(q_v.y, q_v.z)), 0.0) - 0.014 * s;
            d_sign = min(d_hbar, d_vbar);
        }
        return min(min(d_sphere, d_torus), d_sign) * 0.85;
    }

    let h_cloak = clamp((p_local.y - (-1.18 * s)) / (1.62 * s), 0.0, 1.0);
    let q_spine = vec3<f32>(0.0, clamp(p_local.y, -1.18 * s, 0.44 * s), 0.0);
    var d_cloak = 1000.0;
    var d_crown = 1000.0;
    let pc = p_local - vec3<f32>(0.0, 1.24 * s + 0.05 * s * sin(time * 3.2), 0.0);

    if (mkind < 5.5) {
        // SOLIDMANCER (Lithomancer): Broad faceted monolith cloak + twin floating tectonic shoulder pauldrons + jagged 4-point obelisk crown!
        let flute = (abs(sin(p_local.x * 9.5)) + abs(sin(p_local.z * 9.5)) - 1.0) * 0.032 * s;
        let r_prof = s * mix(0.68, 0.45, h_cloak) + flute;
        d_cloak = (length(p_local - q_spine) - r_prof) * 0.84;

        let p_sh = vec3<f32>(abs(dot(p_local, side)) - 0.56 * s,
                             p_local.y - (0.44 * s + 0.03 * s * sin(time * 2.4)),
                             dot(p_local, fwd) - 0.03 * s);
        let q_sh = abs(p_sh) - vec3<f32>(0.15 * s, 0.23 * s, 0.19 * s);
        let d_pauldron = (length(max(q_sh, vec3<f32>(0.0))) + min(max(q_sh.x, max(q_sh.y, q_sh.z)), 0.0) - 0.025 * s) * 0.86;
        d_cloak = smin_poly(d_cloak, d_pauldron, 0.09 * s);

        let q_oct = vec2<f32>((abs(pc.x) + abs(pc.z)) * 0.78 - 0.36 * s,
                              pc.y - 0.055 * s * abs(sin(pc.x * 7.0) - sin(pc.z * 7.0)));
        d_crown = (length(q_oct) - 0.082 * s) * 0.82;
    } else if (mkind < 6.5) {
        // LIQUIDMANCER (Hydromancer): Flowing pelagic amphora bell-skirt + high-crested wave collar + bobbing droplet-chalice crown!
        let wave_r = s * (mix(0.73, 0.37, h_cloak) - 0.11 * sin(h_cloak * 3.14159) + 0.055 * sin(h_cloak * 9.42 - time * 4.6));
        let ripple = (1.0 - h_cloak) * 0.05 * s * sin(p_local.x * 10.0 + p_local.z * 10.0 - time * 5.2);
        d_cloak = (length(p_local - q_spine) - (wave_r + ripple)) * 0.82;

        let p_col = p_local - (-fwd * (0.14 * s) + vec3<f32>(0.0, 0.64 * s, 0.0));
        let d_collar = max(abs(length(p_col.xz) - 0.47 * s) - 0.065 * s,
                           max(abs(p_col.y) - 0.22 * s, dot(p_local, fwd) - 0.06 * s)) * 0.84;
        d_cloak = smin_poly(d_cloak, d_collar, 0.12 * s);

        let q_ring = vec2<f32>(length(pc.xz) - 0.40 * s, pc.y - 0.04 * s * sin(pc.x * 7.5 + time * 3.8));
        let d_drop = length(pc - vec3<f32>(0.0, 0.11 * s + 0.04 * s * cos(time * 4.2), 0.0)) - 0.115 * s;
        d_crown = smin_poly((length(q_ring) - 0.068 * s) * 0.85, d_drop, 0.08 * s);
    } else {
        // GASMANCER (Aeromancer): Inverted cyclone / djinn-vortex mantle tapering to a corkscrewing tornado tail + spinning twin-gyroscope crown!
        let swirl = h_cloak * 5.2 - time * 4.8;
        let tail_sway = (1.0 - h_cloak) * 0.16 * s;
        let q_vortex = vec3<f32>(cos(swirl) * tail_sway, clamp(p_local.y, -1.20 * s, 0.44 * s), sin(swirl) * tail_sway);
        let r_vort = s * (mix(0.13, 0.60, pow(h_cloak, 0.62)) + 0.055 * sin(h_cloak * 12.0 - time * 6.5));
        d_cloak = (length(p_local - q_vortex) - r_vort) * 0.80;

        let c_ang = time * 4.5;
        let c_tilt1 = pc.y + (pc.x * cos(c_ang) + pc.z * sin(c_ang)) * 0.28;
        let c_tilt2 = pc.y - (pc.x * sin(c_ang) - pc.z * cos(c_ang)) * 0.28;
        let d_r1 = length(vec2<f32>(length(pc.xz) - 0.42 * s, c_tilt1)) - 0.062 * s;
        let d_r2 = length(vec2<f32>(length(pc.xz) - 0.30 * s, c_tilt2)) - 0.052 * s;
        d_crown = min(d_r1, d_r2) * 0.82;
    }

    let c_hood = fwd * (0.08 * s) + vec3<f32>(0.0, 0.74 * s, 0.0);
    let d_hood = length(p_local - c_hood) - 0.44 * s;
    var d_body = smin_poly(d_cloak, d_hood, 0.24 * s);

    let c_cav = fwd * (0.37 * s) + vec3<f32>(0.0, 0.70 * s, 0.0);
    let d_cav = length(p_local - c_cav) - 0.30 * s;
    d_body = max(d_body, -d_cav);

    let arm_bob = 0.045 * s * sin(time * 3.4);
    let p_arm_sym = vec3<f32>(abs(dot(p_local, side)), p_local.y, dot(p_local, fwd));
    let a_seg = clamp((p_arm_sym.z - 0.02 * s) / (0.58 * s), 0.0, 1.0);
    let a_pt = vec3<f32>(mix(0.45 * s, 0.56 * s, a_seg), mix(0.36 * s, 0.22 * s + arm_bob, a_seg), a_seg * 0.58 * s);
    let d_arms = length(p_arm_sym - a_pt) - mix(0.20 * s, 0.13 * s, a_seg);
    d_body = smin_poly(d_body, d_arms, 0.14 * s);

    return min(d_body, d_crown);
}

// Armored Subterranean Maw-Tick / Cave Hopper SDF: hunched carapace, 3 dorsal mineral spikes, muscular hind-haunches, & recessed maw!
fn eval_hopper_sdf(p_local: vec3<f32>, fwd_raw: vec3<f32>, rad: f32, fill_val: f32, time: f32) -> f32 {
    let r = max(rad, 0.36);
    let d_bound = length(p_local) - r * 1.24;
    if (d_bound > 0.32) {
        return d_bound;
    }
    let f_len = length(fwd_raw.xz);
    let fwd = select(vec3<f32>(0.0, 0.0, 1.0), vec3<f32>(fwd_raw.x / f_len, 0.0, fwd_raw.z / f_len), f_len > 0.01);
    let side = vec3<f32>(-fwd.z, 0.0, fwd.x);
    let px = dot(p_local, side);
    let py = p_local.y;
    let pz = dot(p_local, fwd);

    // Coiled Pounce Windup / Blood-Frenzy squash (fill_val < 0.0 squashes carapace flat against rock like a loaded spring!)
    let coil_t = clamp(-fill_val, 0.0, 1.0);
    let py_c = (py + 0.14 * r * coil_t) * mix(1.16, 1.52, coil_t);

    // Forward-leaning armored carapace shell
    let q_shell = vec3<f32>(px * mix(0.96, 0.84, coil_t), py_c, pz * 0.86 - 0.04 * r);
    var d_body = length(q_shell) - r * 0.92;

    // Muscular spring-loaded bilateral hind-haunches on flanks
    let p_leg = vec3<f32>(abs(px) - r * mix(0.56, 0.66, coil_t), py + r * mix(0.16, 0.04, coil_t), pz + r * 0.24);
    let d_haunch = length(vec3<f32>(p_leg.x * 1.15, p_leg.y * 0.92, p_leg.z * 0.82)) - r * 0.44;
    d_body = smin_poly(d_body, d_haunch, r * 0.24);

    // 3 jagged dorsal mineral ridges/spikes along the spine (flare taller when coiled/frenzied!)
    let sp_h = r * mix(0.24, 0.34, coil_t);
    let sp1 = length(vec3<f32>(px * 1.8, py - r * mix(0.54, 0.42, coil_t), (pz - r * 0.22) * 1.4)) - sp_h;
    let sp2 = length(vec3<f32>(px * 1.7, py - r * mix(0.60, 0.48, coil_t), (pz + r * 0.08) * 1.4)) - sp_h * 1.08;
    let sp3 = length(vec3<f32>(px * 1.8, py - r * mix(0.50, 0.38, coil_t), (pz + r * 0.36) * 1.4)) - sp_h * 0.92;
    let d_spikes = min(sp1, min(sp2, sp3));
    d_body = smin_poly(d_body, d_spikes, r * 0.14);

    // Jagged recessed predator maw under the front eyespots
    let p_maw = vec3<f32>(px * 0.78, (py + r * 0.16) * 1.45, pz - r * 0.84);
    let d_maw = length(p_maw) - r * mix(0.32, 0.38, coil_t);
    d_body = max(d_body, -d_maw);

    return d_body;
}

fn map_entities_dist(p: vec3<f32>, active_mask: u32) -> f32 {
    var rigid_d = 10000.0;
    var amoeba_d = 10000.0;
    let count = u32(u.entity_count);
    var has_jiggle = false;
    var jiggle = 0.0;
    var m: u32 = active_mask & 0x7fffffffu;
    var tail_i: u32 = select(count, 31u, (active_mask & 0x80000000u) != 0u);
    loop {
        var i: u32 = 0u;
        if (m != 0u) {
            i = firstTrailingBit(m);
            m = m & (m - 1u);
        } else if (tail_i < count) {
            i = tail_i;
            tail_i = tail_i + 1u;
        } else {
            break;
        }
        let e = s_entities[i];
        let p_local = p - e.pos_type.xyz;
        if (e.pos_type.w < 0.5) {
            let d = length(p_local) - e.extents_rad.w;
            if (d < rigid_d) { rigid_d = d; }
        } else if (e.pos_type.w < 1.5) {
            let q = abs(p_local) - e.extents_rad.xyz;
            let d = length(max(q, vec3<f32>(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
            if (d < rigid_d) { rigid_d = d; }
        } else if (e.pos_type.w > 4.5) {
            let d = eval_mancer_sdf(p_local, e.extents_rad.xyz, e.extents_rad.w, e.pos_type.w, u.time);
            if (d < rigid_d) { rigid_d = d; }
        } else if (e.pos_type.w > 3.5) {
            let d = eval_hopper_sdf(p_local, e.extents_rad.xyz, e.extents_rad.w, e.color.a, u.time);
            if (d < rigid_d) { rigid_d = d; }
        } else {
            if (!has_jiggle) {
                jiggle = 0.022 * sin(p.x * 7.2 + u.time * 5.2) * cos(p.y * 7.2 - u.time * 4.3) * sin(p.z * 7.2 + u.time * 4.7);
                has_jiggle = true;
            }
            let r = e.extents_rad.w;
            let pod = e.extents_rad.xyz;
            var d = 10000.0;
            if (e.pos_type.w < 2.5) {
                let d0 = length(p_local) - r;
                let d1 = length(p_local - pod * 0.52) - r * 0.66;
                let d2 = length(p_local - pod) - r * 0.54;
                d = smin_poly(d0, smin_poly(d1, d2, r * 0.58), r * 0.68) + jiggle;
            } else {
                let split_t = clamp(e.color.a, 0.0, 1.0);
                let lobe_r = r * mix(0.84, 0.68, split_t);
                let k_pinch = r * mix(0.85, 0.14, split_t);
                let dl = length(p_local + pod) - lobe_r;
                let dr = length(p_local - pod) - lobe_r;
                d = smin_poly(dl, dr, k_pinch) + jiggle * 1.35;
            }
            amoeba_d = smin_poly(amoeba_d, d, 0.34);
        }
    }
    if (amoeba_d < 0.36) {
        let m_wrap = p - floor(p / 160.0) * 160.0;
        let m_uvw = clamp(m_wrap / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
        let d_rock = textureSampleLevel(solid_texture, voxel_sampler, m_uvw, 0.0).g * 0.5;
        let h_men = clamp(0.5 + 0.5 * (d_rock - amoeba_d) / 0.34, 0.0, 1.0);
        let fillet = 0.34 * h_men * (1.0 - h_men) * smoothstep(0.35, 0.05, amoeba_d);
        amoeba_d = amoeba_d - fillet * 1.15;
    }
    return min(rigid_d, amoeba_d);
}

fn map_entities_full(
    p: vec3<f32>,
    active_mask: u32,
    out_color: ptr<function, vec3<f32>>,
    out_kind: ptr<function, f32>,
    out_fill: ptr<function, f32>,
    out_center: ptr<function, vec3<f32>>,
    out_pod: ptr<function, vec3<f32>>,
    out_rad: ptr<function, f32>
) -> f32 {
    var rigid_d = 10000.0;
    var rigid_col = vec3<f32>(0.0);
    var rigid_kind = 0.0;
    var rigid_fill = 0.0;
    var rigid_center = vec3<f32>(0.0);
    var rigid_pod = vec3<f32>(0.0);
    var rigid_rad = 0.5;

    var amoeba_d = 10000.0;
    var amoeba_col = vec3<f32>(0.48, 0.88, 0.98);
    var best_amoeba_d = 10000.0;
    var best_kind = 2.0;
    var best_fill = 0.0;
    var best_center = vec3<f32>(0.0);
    var best_pod = vec3<f32>(0.0);
    var best_rad = 0.5;

    let count = u32(u.entity_count);
    var has_jiggle = false;
    var jiggle = 0.0;
    var m: u32 = active_mask & 0x7fffffffu;
    var tail_i: u32 = select(count, 31u, (active_mask & 0x80000000u) != 0u);
    loop {
        var i: u32 = 0u;
        if (m != 0u) {
            i = firstTrailingBit(m);
            m = m & (m - 1u);
        } else if (tail_i < count) {
            i = tail_i;
            tail_i = tail_i + 1u;
        } else {
            break;
        }
        let e = s_entities[i];
        let p_local = p - e.pos_type.xyz;
        if (e.pos_type.w < 0.5) {
            let d = length(p_local) - e.extents_rad.w;
            if (d < rigid_d) {
                rigid_d = d;
                rigid_col = e.color.rgb;
                rigid_kind = 0.0;
                rigid_fill = 0.0;
            }
        } else if (e.pos_type.w < 1.5) {
            let q = abs(p_local) - e.extents_rad.xyz;
            let d = length(max(q, vec3<f32>(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
            if (d < rigid_d) {
                rigid_d = d;
                rigid_col = e.color.rgb;
                rigid_kind = 1.0;
                rigid_fill = 0.0;
            }
        } else if (e.pos_type.w > 4.5) {
            let d = eval_mancer_sdf(p_local, e.extents_rad.xyz, e.extents_rad.w, e.pos_type.w, u.time);
            if (d < rigid_d) {
                rigid_d = d;
                rigid_col = e.color.rgb;
                rigid_kind = e.pos_type.w;
                rigid_fill = e.color.a;
                rigid_center = e.pos_type.xyz;
                rigid_pod = e.extents_rad.xyz;
                rigid_rad = e.extents_rad.w;
            }
        } else if (e.pos_type.w > 3.5) {
            let d = eval_hopper_sdf(p_local, e.extents_rad.xyz, e.extents_rad.w, e.color.a, u.time);
            if (d < rigid_d) {
                rigid_d = d;
                rigid_col = e.color.rgb;
                rigid_kind = 4.0;
                rigid_fill = e.color.a;
                rigid_center = e.pos_type.xyz;
                rigid_pod = e.extents_rad.xyz;
                rigid_rad = e.extents_rad.w;
            }
        } else {
            if (!has_jiggle) {
                jiggle = 0.022 * sin(p.x * 7.2 + u.time * 5.2) * cos(p.y * 7.2 - u.time * 4.3) * sin(p.z * 7.2 + u.time * 4.7);
                has_jiggle = true;
            }
            let r = e.extents_rad.w;
            let pod = e.extents_rad.xyz;
            var d = 10000.0;
            if (e.pos_type.w < 2.5) {
                let d0 = length(p_local) - r;
                let d1 = length(p_local - pod * 0.52) - r * 0.66;
                let d2 = length(p_local - pod) - r * 0.54;
                d = smin_poly(d0, smin_poly(d1, d2, r * 0.58), r * 0.68) + jiggle;
            } else {
                let split_t = clamp(e.color.a, 0.0, 1.0);
                let lobe_r = r * mix(0.84, 0.68, split_t);
                let k_pinch = r * mix(0.85, 0.14, split_t);
                let dl = length(p_local + pod) - lobe_r;
                let dr = length(p_local - pod) - lobe_r;
                d = smin_poly(dl, dr, k_pinch) + jiggle * 1.35;
            }
            if (amoeba_d > 9000.0) {
                amoeba_d = d;
                amoeba_col = e.color.rgb;
            } else {
                let h = clamp(0.5 + 0.5 * (d - amoeba_d) / 0.34, 0.0, 1.0);
                amoeba_col = mix(e.color.rgb, amoeba_col, h);
                amoeba_d = mix(d, amoeba_d, h) - 0.34 * h * (1.0 - h);
            }
            if (d < best_amoeba_d) {
                best_amoeba_d = d;
                best_kind = e.pos_type.w;
                best_fill = e.color.a;
                best_center = e.pos_type.xyz;
                best_pod = pod;
                best_rad = r;
            }
        }
    }

    if (amoeba_d < 0.36) {
        let m_wrap = p - floor(p / 160.0) * 160.0;
        let m_uvw = clamp(m_wrap / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
        let d_rock = textureSampleLevel(solid_texture, voxel_sampler, m_uvw, 0.0).g * 0.5;
        let h_men = clamp(0.5 + 0.5 * (d_rock - amoeba_d) / 0.34, 0.0, 1.0);
        let fillet = 0.34 * h_men * (1.0 - h_men) * smoothstep(0.35, 0.05, amoeba_d);
        amoeba_d = amoeba_d - fillet * 1.15;
    }

    if (amoeba_d < rigid_d) {
        *out_color = amoeba_col;
        *out_kind = best_kind;
        *out_fill = best_fill;
        *out_center = best_center;
        *out_pod = best_pod;
        *out_rad = best_rad;
        return amoeba_d;
    } else {
        *out_color = rigid_col;
        *out_kind = rigid_kind;
        *out_fill = rigid_fill;
        *out_center = rigid_center;
        *out_pod = rigid_pod;
        *out_rad = rigid_rad;
        return rigid_d;
    }
}

@fragment
fn fs_main(in: VertexOutput) -> FragmentOutput {
    let aspect = u.width / u.height;
    let uv = (in.uv * 2.0 - 1.0) * vec2<f32>(aspect, 1.0);
    
    let ro = u.cam_pos.xyz;
    let rd = normalize(u.cam_dir.xyz * 2.0 + uv.x * u.cam_right.xyz + uv.y * u.cam_up.xyz);
    
    let cx = floor(u.cam_pos.x / 32.0);
    let cy = floor(u.cam_pos.y / 32.0);
    let cz = floor(u.cam_pos.z / 32.0);
    let box_min = vec3<f32>(cx - 2.0, cy - 2.0, cz - 2.0) * 32.0;
    let box_max = box_min + 160.0;
    
    var t_near: f32 = 0.0;
    var t_far: f32 = 0.0;
    
    // Create sky gradient based on ray direction Y component and orbiting sun Y height
    let sun_h = u.sun_dir.y;
    
    // Day / Night interpolation factors
    let day_factor = clamp(sun_h * 5.0 + 0.5, 0.0, 1.0);
    let sunset_factor = clamp(1.0 - abs(sun_h) * 5.0, 0.0, 1.0);
    
    // Base sky colors
    let day_space = vec3<f32>(0.05, 0.12, 0.25);
    let day_horizon = vec3<f32>(0.2, 0.38, 0.58);
    
    let sunset_space = vec3<f32>(0.06, 0.04, 0.12);
    let sunset_horizon = vec3<f32>(0.65, 0.28, 0.12);
    
    let night_space = vec3<f32>(0.002, 0.004, 0.008);
    let night_horizon = vec3<f32>(0.01, 0.015, 0.035);
    
    let space_color = mix(mix(night_space, sunset_space, sunset_factor), day_space, day_factor);
    let horizon_color = mix(mix(night_horizon, sunset_horizon, sunset_factor), day_horizon, day_factor);
    
    let sky_dir_y = max(0.0, rd.y);
    var color = mix(space_color, horizon_color, sky_dir_y);
    
    // Add orbiting sun
    let light_dir = normalize(u.sun_dir.xyz);
    let sun_cos = dot(rd, light_dir);
    if (sun_h > -0.2 && sun_cos > 0.0) {
        let sun_fade = clamp(sun_h * 5.0 + 1.0, 0.0, 1.0);
        let sun_glow = pow(sun_cos, 120.0) * 1.5 * sun_fade;
        let sun_disk = pow(sun_cos, 1200.0) * 4.0 * sun_fade;
        color += vec3<f32>(1.0, 0.9, 0.7) * (sun_glow + sun_disk);
    }

    // Add orbiting moon in opposite direction
    let moon_dir = -light_dir;
    let moon_cos = dot(rd, moon_dir);
    if (sun_h < 0.2 && moon_cos > 0.0) {
        let moon_fade = clamp(-sun_h * 5.0 + 1.0, 0.0, 1.0);
        let moon_glow = pow(moon_cos, 160.0) * 0.4 * moon_fade;
        let moon_disk = pow(moon_cos, 2000.0) * 1.2 * moon_fade;
        color += vec3<f32>(0.7, 0.8, 1.0) * (moon_glow + moon_disk);
    }
    
    var hit: bool = false;
    var t: f32 = 0.0;

    if (intersect_box(ro, rd, box_min, box_max, &t_near, &t_far)) {
        let t_start = max(t_near, 0.0);
        t = t_start;
        var ray_p = ro + rd * t_start;
        var cur_rd = rd;
        var hit_color = vec3<f32>(0.0);
        var accum_color = vec3<f32>(0.0);
        var accum_alpha: f32 = 0.0;
        
        for (var step = 0; step < 144; step = step + 1) {
            if (t > min(t_far, 88.0)) {
                break;
            }
            let p = ray_p;
            
            // Clamp normalized coordinates slightly inside [0, 1] to avoid border interpolation artifacts
            let wrapped_p = p - floor(p / 160.0) * 160.0;
            let uvw = clamp(wrapped_p / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
            
            // Sample SDF value from green channel (G) and Refractive Index Offset Delta_n from blue channel (B)
            let val = textureSampleLevel(solid_texture, voxel_sampler, uvw, 0.0);
            let dist = val.g * 0.5;
            let step_len = clamp(dist, 0.008, 0.85);

            // 3D Eikonal Schlieren Ray-Bending in open air (strictly outside 1-voxel trilinear footprint of stained/piezo solids!)
            if (t > 1.5 && dist > 0.95 && abs(val.r) < 0.001 && abs(val.b) > 0.0025 && abs(val.b) < 0.065) {
                let dn0 = val.b;
                let eps_u = 1.0 / 160.0;
                let sx = textureSampleLevel(solid_texture, voxel_sampler, clamp(uvw + vec3<f32>(eps_u, 0.0, 0.0), vec3<f32>(0.002), vec3<f32>(0.998)), 0.0);
                let sy = textureSampleLevel(solid_texture, voxel_sampler, clamp(uvw + vec3<f32>(0.0, eps_u, 0.0), vec3<f32>(0.002), vec3<f32>(0.998)), 0.0);
                let sz = textureSampleLevel(solid_texture, voxel_sampler, clamp(uvw + vec3<f32>(0.0, 0.0, eps_u), vec3<f32>(0.002), vec3<f32>(0.998)), 0.0);
                let dnx = select(sx.b - dn0, 0.0, abs(sx.r) > 0.001 || abs(sx.b) >= 0.065 || abs(sx.b - dn0) > 0.022);
                let dny = select(sy.b - dn0, 0.0, abs(sy.r) > 0.001 || abs(sy.b) >= 0.065 || abs(sy.b - dn0) > 0.022);
                let dnz = select(sz.b - dn0, 0.0, abs(sz.r) > 0.001 || abs(sz.b) >= 0.065 || abs(sz.b - dn0) > 0.022);
                let bend = vec3<f32>(dnx, dny, dnz) * (step_len * 0.18);
                let tot_bend = clamp((cur_rd - rd) + bend, vec3<f32>(-0.008), vec3<f32>(0.008));
                cur_rd = normalize(rd + tot_bend);
            }
            
            // Accumulate Fluids and Gases
            let ip_cell = vec3<i32>(clamp(wrapped_p, vec3<f32>(0.0), vec3<f32>(159.0)));

            let liq_val = textureSampleLevel(liquid_texture, voxel_sampler, uvw, 0.0);
            if (liq_val.g > 0.05) {
                let raw_liq = textureLoad(liquid_texture, ip_cell, 0);
                let mat = materials[u32(round(raw_liq.r)) + 256u];
                let base_liq = vec3<f32>(mat.r, mat.g, mat.b);
                let v_liq = textureSampleLevel(vel_texture, voxel_sampler, uvw, 0.0);
                let l_spd = length(v_liq.xyz);
                var liq_color = base_liq;
                var light_env = vec3<f32>(1.0);
                if ((mat.tags & 2097152u) != 0u) {
                    liq_color = base_liq * max(1.0, mat.a * 0.65);
                } else {
                    let l_gi = textureSampleLevel(light_texture, voxel_sampler, uvw, 0.0).rgb;
                    let sky_open = clamp((p.y - 8.0) / 20.0, 0.08, 1.0);
                    let l_amb = clamp(u.sun_dir.y * 3.0 + 0.35, 0.12, 1.0) * sky_open;
                    var l_flash = vec3<f32>(0.0);
                    if (u.cam_pos.w > 0.5) {
                        let f_att = 1.0 / (1.0 + 0.05 * t + 0.012 * t * t);
                        l_flash = vec3<f32>(1.0, 0.96, 0.88) * f_att * 2.2;
                    }
                    light_env = max(vec3<f32>(0.0), vec3<f32>(l_amb) + l_gi + l_flash);
                    liq_color = base_liq * light_env;
                }
                if (l_spd > 0.32) {
                    let fp = p * 5.8 - v_liq.xyz * 2.4;
                    let froth_n = 0.5 + 0.5 * sin(fp.x + sin(fp.y * 1.3 + fp.z)) * cos(fp.z - sin(fp.y * 1.1 - fp.x));
                    let foam = smoothstep(0.32, 2.4, l_spd) * smoothstep(0.28, 0.82, froth_n);
                    let froth_tint = mix(base_liq, vec3<f32>(0.92, 0.96, 1.0), 0.72) * max(light_env, vec3<f32>(0.28));
                    liq_color = mix(liq_color, froth_tint, foam * 0.78);
                }
                if (liq_val.b > 0.04) {
                    let arc_w = 0.65 + 0.35 * sin(u.time * 32.0 + dot(p, vec3<f32>(6.3, 9.1, 7.4)));
                    liq_color += vec3<f32>(0.38, 0.88, 2.75) * (liq_val.b * arc_w);
                }
                let absorb = mat.density * (1.0 + smoothstep(0.4, 2.5, l_spd) * 0.35);
                let step_size = max(0.008, dist);
                let alpha = 1.0 - exp(-liq_val.g * step_size * absorb);
                accum_color = mix(accum_color, liq_color, alpha * (1.0 - accum_alpha));
                accum_alpha = accum_alpha + alpha * (1.0 - accum_alpha);
            }

            let gas_val = textureSampleLevel(gas_texture, voxel_sampler, uvw, 0.0);
            if (gas_val.g > 0.05) {
                let raw_gas = textureLoad(gas_texture, ip_cell, 0);
                let mat = materials[u32(round(raw_gas.r)) + 512u];
                var gas_color = vec3<f32>(mat.r, mat.g, mat.b);
                var absorb = mat.density;
                let v_gas = textureSampleLevel(vel_texture, voxel_sampler, uvw, 0.0);
                let g_spd = length(v_gas.xyz);
                let p_adv = p - v_gas.xyz * 1.65;
                
                let g_id = round(raw_gas.r);
                if (g_id == 3.0) {
                    let flicker = sin(u.time * 15.0 + dot(p_adv, vec3<f32>(3.4, 2.6, 3.4))) * 0.15 + 0.85;
                    let blowtorch = 1.0 + clamp(g_spd * 0.28, 0.0, 0.75);
                    gas_color = vec3<f32>(mat.r, mat.g * flicker, mat.b + clamp(g_spd * 0.08, 0.0, 0.32)) * blowtorch;
                    absorb = mat.density * flicker * (1.0 + clamp(g_spd * 0.18, 0.0, 0.45));
                } else if (g_id == 4.0 || g_id == 1.0) {
                    let billow_p = p_adv * 2.1 - vec3<f32>(0.0, u.time * 3.2, 0.0);
                    let billow = 0.55 + 0.45 * (sin(billow_p.x + sin(billow_p.y * 0.8 + billow_p.z)) * cos(billow_p.z - sin(billow_p.y * 0.7 - billow_p.x)));
                    let g_gi = max(vec3<f32>(0.0), textureSampleLevel(light_texture, voxel_sampler, uvw, 0.0).rgb);
                    var g_flash = vec3<f32>(0.0);
                    if (u.cam_pos.w > 0.5) {
                        let f_att = 1.0 / (1.0 + 0.05 * t + 0.012 * t * t);
                        g_flash = vec3<f32>(0.9, 0.88, 0.82) * f_att * 1.1;
                    }
                    let wilson = smoothstep(1.6, 4.2, g_spd) * 0.22;
                    let puff_shade = 0.75 + 0.35 * billow + wilson;
                    gas_color = (gas_color * puff_shade + vec3<f32>(wilson * 0.55)) * max(vec3<f32>(0.18), g_gi * 1.45 + g_flash);
                    absorb = mat.density * (0.65 + 0.75 * billow) * (1.0 + clamp(abs(v_gas.w) * 0.35, 0.0, 0.55));
                } else if (g_spd > 0.12) {
                    let wisp_p = p_adv * 2.6 - vec3<f32>(0.0, u.time * 1.8, 0.0);
                    let wisp = 0.62 + 0.38 * (sin(wisp_p.x + sin(wisp_p.y + wisp_p.z)) * cos(wisp_p.z - wisp_p.x));
                    let streak = smoothstep(0.12, 2.2, g_spd);
                    gas_color *= mix(1.0, 0.82 + 0.36 * wisp, streak);
                    absorb *= mix(1.0, (0.60 + 0.75 * wisp) * (1.0 + clamp(abs(v_gas.w) * 0.35, 0.0, 0.55)), streak);
                }
                let step_size = max(0.008, dist);
                let alpha = (1.0 - exp(-gas_val.g * step_size * absorb)) * 0.4;
                accum_color = mix(accum_color, gas_color, alpha * (1.0 - accum_alpha));
                accum_alpha = accum_alpha + alpha * (1.0 - accum_alpha);
            }
            
            if (dist < 0.008) {
                // Hit! Calculate normals using finite differences
                let eps = 0.5;
                let n = vec3<f32>(
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p + vec3<f32>(eps, 0.0, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g - 
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p - vec3<f32>(eps, 0.0, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g,
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p + vec3<f32>(0.0, eps, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g - 
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p - vec3<f32>(0.0, eps, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g,
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p + vec3<f32>(0.0, 0.0, eps), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g - 
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p - vec3<f32>(0.0, 0.0, eps), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g
                );
                let raw_normal = normalize(n);
                var normal = raw_normal;
                
                // Fetch discrete material ID using textureLoad at the nearest integer coordinate (avoids trilinear bleeding!)
                let ip = vec3<i32>(clamp(wrapped_p, vec3<f32>(0.0), vec3<f32>(159.0)));
                let raw_voxel = textureLoad(solid_texture, ip, 0);
                let mat_id = raw_voxel.r;
                
                // Color based on material ID
                let mat_id_u = u32(round(abs(mat_id)));
                let mat = materials[mat_id_u];
                let base_color = vec3<f32>(mat.r, mat.g, mat.b);

                // Unpack light_texture: .rgb = GI block light (signed for Darklight!), .a = smoothed structural stress [0..1]
                let light_sample = textureSampleLevel(light_texture, voxel_sampler, uvw, 0.0);
                let inside_p = p - raw_normal * 0.45;
                let inside_w = inside_p - floor(inside_p / 160.0) * 160.0;
                let inside_uvw = clamp(inside_w / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
                let stress_raw = max(light_sample.a, textureSampleLevel(light_texture, voxel_sampler, inside_uvw, 0.0).a);

                let is_brittle = (mat.tags & 16384u) != 0u;
                let is_indestructible = (mat.tags & 16777216u) != 0u;
                let strain_lo = select(0.24, 0.17, is_brittle);
                let strain_hi = select(0.90, 0.78, is_brittle);
                let strain = select(smoothstep(strain_lo, strain_hi, stress_raw), 0.0, is_indestructible);

                var crack_core: f32 = 0.0;
                if (strain > 0.005) {
                    let frac = eval_fracture_3d(p, strain, raw_normal, mat_id_u, mat.tags, mat.toughness);
                    normal = normalize(raw_normal + frac.xyz);
                    crack_core = frac.w;
                }
                
                // Smoothly fade direct sky/moon illumination deep underground so >40m caverns stay dark except for GI & flashlight
                let sky_exposure = clamp((p.y - 6.0) / 18.0, 0.0, 1.0);
                let light_dir = normalize(u.sun_dir.xyz);
                let sun_intensity = clamp(u.sun_dir.y * 4.0, 0.0, 1.0) * sky_exposure;
                let diffuse = max(dot(normal, light_dir), 0.0);
                
                // Raymarched Shadows (only computed when sun reaches this depth!)
                var sha: f32 = 1.0;
                if (sun_intensity > 0.001) {
                    let shadow_pos = p + raw_normal * 0.05;
                    sha = getShadow(shadow_pos, light_dir, 0.05, 40.0, 16.0);
                }
                
                // Moon light (faint blue direct light at night on surface)
                let moon_dir = -light_dir;
                let moon_intensity = clamp(-u.sun_dir.y * 4.0, 0.0, 1.0) * 0.15 * sky_exposure;
                let moon_diffuse = max(dot(normal, moon_dir), 0.0);
                let moon_light = vec3<f32>(0.7, 0.8, 1.0) * moon_diffuse * moon_intensity;
                
                // Ambient Occlusion (deepened inside open structural fissures)
                let ao = getAO(p, raw_normal) * mix(1.0, 0.10, crack_core);
                
                // Blend surface sky ambient with moody deep-subterranean ambient
                let surf_ambient = clamp(u.sun_dir.y * 3.0 + 0.3, 0.2, 1.0);
                let ambient_intensity = mix(0.22, surf_ambient, sky_exposure);
                
                // Combine Shading with GI Block Light (.rgb, clamped after summing so Negative GI Darklight devours ambient & flashlight!)
                let ambient = vec3<f32>(0.15, 0.18, 0.25) * ao * ambient_intensity;
                let direct = vec3<f32>(1.0, 0.95, 0.85) * diffuse * sha * sun_intensity;
                let block_light = light_sample.rgb;
                
                // Player Ambient Glow (modulated slightly by beveled normal so flashlight catches fissure lips!)
                var player_glow = vec3<f32>(0.0);
                if (u.cam_pos.w > 0.5) {
                    let attenuation = 1.0 / (1.0 + 0.04 * t + 0.009 * t * t);
                    let view_bevel = clamp(0.55 + 0.65 * max(dot(normal, -cur_rd), 0.0), 0.35, 1.2);
                    player_glow = vec3<f32>(1.0, 0.96, 0.88) * attenuation * 2.6 * view_bevel;
                }

                var emissive = vec3<f32>(0.0);
                if ((mat.tags & 2097152u) != 0u) {
                    emissive = base_color * min(mat.a * 0.6, 1.5);
                    // Luminescent crystals/ores bleed intense inner light through stress fissures!
                    emissive += base_color * crack_core * (1.25 + 1.5 * strain);
                    if (mat_id_u == 18u) {
                        // Abyssal Seal (18): ancient pulsing 24k golden runic veins etched across dark violet stone!
                        let rg = abs(fract(p.x * 0.28 + sin(p.z * 0.36) * 0.35) - 0.5) + abs(fract(p.z * 0.28 - cos(p.x * 0.36) * 0.35) - 0.5);
                        let rvein = smoothstep(0.16, 0.03, abs(rg - 0.42)) * (0.70 + 0.30 * sin(u.time * 2.4 + p.x * 0.4 + p.z * 0.4));
                        emissive += vec3<f32>(1.75, 1.22, 0.26) * rvein;
                    }
                } else if (strain > 0.72 && crack_core > 0.2) {
                    // Critical-failure friction glint inside deep fissures right before rock snaps
                    emissive += vec3<f32>(0.55, 0.20, 0.05) * pow(crack_core, 2.0) * smoothstep(0.72, 0.98, strain) * 0.55;
                }
                // Piezoelectric & Galvanic voltage glow along stressed Crystals / Gold veins!
                if (raw_voxel.b < -0.08) {
                    let v_glow = clamp(-raw_voxel.b, 0.0, 1.0);
                    emissive += vec3<f32>(0.35, 0.85, 2.45) * (v_glow * (0.35 + 1.45 * crack_core));
                }

                var stained_base = base_color;
                var stain_spec = vec3<f32>(0.0);
                if (raw_voxel.b >= 2.5) {
                    let stain_lid = clamp(u32(round(raw_voxel.b)) - 2u, 1u, 8u);
                    let stain_mat = materials[256u + stain_lid];
                    let stain_col = vec3<f32>(stain_mat.r, stain_mat.g, stain_mat.b);
                    let v_dot = max(dot(normal, -cur_rd), 0.0);
                    if (stain_lid == 1u) {
                        // [WET] Water stain: darkened wet rock/wood/soil with crisp specular sheen
                        stained_base = base_color * 0.68;
                        stain_spec = vec3<f32>(0.20, 0.23, 0.28) * pow(v_dot, 7.0);
                    } else if (stain_lid == 4u) {
                        // [OILED] Slick dark oil coating with iridescent sheen
                        stained_base = mix(base_color * 0.42, stain_col, 0.55);
                        stain_spec = vec3<f32>(0.26, 0.19, 0.32) * pow(v_dot, 5.0);
                    } else if (stain_lid == 5u) {
                        // [BLOOD] Deep crimson blood stain
                        stained_base = mix(base_color, vec3<f32>(0.50, 0.03, 0.05), 0.65);
                        stain_spec = vec3<f32>(0.22, 0.03, 0.04) * pow(v_dot, 6.0);
                    } else {
                        // Ambrosia (6), Acid (3), Volatile Gel (7), Toxic Sludge (8)
                        stained_base = mix(base_color, stain_col, 0.55);
                        emissive += stain_col * select(0.16, 0.30, stain_lid == 6u);
                        stain_spec = stain_col * 0.24 * pow(v_dot, 6.0);
                    }
                }

                let rock_albedo = mix(stained_base, stained_base * 0.07, crack_core * 0.94);
                let total_light = max(vec3<f32>(0.0), direct + ambient + moon_light + block_light + player_glow);
                var gold_spec = stain_spec * min(length(total_light), 2.0);
                if (mat_id_u == 5u) {
                    let v_dir = -cur_rd;
                    let n_dot_v = max(dot(normal, v_dir), 0.0);
                    let facet = fract(sin(dot(floor(p * 4.5), vec3<f32>(12.9898, 78.233, 37.719))) * 43758.5453);
                    let glint = pow(n_dot_v, 6.0) * (0.55 + select(0.0, 0.95, facet > 0.76));
                    gold_spec += vec3<f32>(1.45, 1.12, 0.28) * (glint * min(length(total_light), 2.4) + 0.09);
                }
                let solid_col = rock_albedo * total_light + emissive + gold_spec;
                hit_color = mix(solid_col, accum_color, accum_alpha);
                hit = true;
                break;
            }
            
            // Step forward along the Eikonal-bent ray!
            ray_p = ray_p + cur_rd * step_len;
            t = t + step_len;
        }
        

        var voxel_hit_t = t;
        if (!hit) {
            voxel_hit_t = t_far;
        }

        if (u.entity_count > 0.5) {
            var active_mask: u32 = 0u;
            var min_ent_t: f32 = voxel_hit_t;
            var max_ent_t: f32 = t_start;
            let ent_count = u32(u.entity_count);
            for (var ei: u32 = 0u; ei < ent_count; ei = ei + 1u) {
                let e = s_entities[ei];
                let oc = e.pos_type.xyz - ro;
                let proj = dot(oc, rd);
                var r_bound: f32 = e.extents_rad.w + 0.12;
                if (e.pos_type.w > 4.5) {
                    r_bound = e.extents_rad.w * 2.15 + 0.45;
                } else if (e.pos_type.w >= 1.5 && e.pos_type.w < 3.5) {
                    r_bound = e.extents_rad.w + length(e.extents_rad.xyz) + 0.56;
                } else if (e.pos_type.w >= 0.5 && e.pos_type.w < 1.5) {
                    r_bound = length(e.extents_rad.xyz) + 0.10;
                }
                if (proj + r_bound > t_start && proj - r_bound < voxel_hit_t) {
                    let perp2 = dot(oc, oc) - proj * proj;
                    let r2 = r_bound * r_bound;
                    if (perp2 < r2) {
                        let thc = sqrt(r2 - perp2);
                        let t0 = max(t_start, proj - thc);
                        let t1 = min(voxel_hit_t, proj + thc);
                        if (t0 <= t1) {
                            if (ei < 31u) {
                                active_mask = active_mask | (1u << ei);
                            } else {
                                active_mask = active_mask | 0x80000000u;
                            }
                            min_ent_t = min(min_ent_t, t0);
                            max_ent_t = max(max_ent_t, t1);
                        }
                    }
                }
            }

            if (active_mask != 0u) {
                var ent_t = min_ent_t;
                var ent_hit = false;
                var final_ent_color = vec3<f32>(0.0);

                for (var step = 0; step < 38; step = step + 1) {
                    if (ent_t > max_ent_t) { break; }
                    let p = ro + rd * ent_t;

                    var ent_c = vec3<f32>(0.0);
                    var ent_kind: f32 = 0.0;
                    var ent_fill: f32 = 0.0;
                    var ent_center = vec3<f32>(0.0);
                    var ent_pod = vec3<f32>(0.0);
                    var ent_rad: f32 = 0.5;
                    let dist = map_entities_full(p, active_mask, &ent_c, &ent_kind, &ent_fill, &ent_center, &ent_pod, &ent_rad);
                    if (dist < 0.008) {
                        let eps = 0.012;
                        let n = vec3<f32>(
                            map_entities_dist(p + vec3<f32>(eps, 0.0, 0.0), active_mask) - map_entities_dist(p - vec3<f32>(eps, 0.0, 0.0), active_mask),
                            map_entities_dist(p + vec3<f32>(0.0, eps, 0.0), active_mask) - map_entities_dist(p - vec3<f32>(0.0, eps, 0.0), active_mask),
                            map_entities_dist(p + vec3<f32>(0.0, 0.0, eps), active_mask) - map_entities_dist(p - vec3<f32>(0.0, 0.0, eps), active_mask)
                        );
                        let normal = normalize(n);
                        let e_wrap = p - floor(p / 160.0) * 160.0;
                        let e_uvw = clamp(e_wrap / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
                        let e_gi = textureSampleLevel(light_texture, voxel_sampler, e_uvw, 0.0).rgb;
                        let e_sky = clamp((p.y - 6.0) / 18.0, 0.0, 1.0);
                        let light_dir = normalize(u.sun_dir.xyz);
                        let sun_intensity = clamp(u.sun_dir.y * 4.0, 0.0, 1.0) * e_sky;
                        let diffuse = max(dot(normal, light_dir), 0.0);
                        let ambient = vec3<f32>(0.18, 0.22, 0.30) * mix(0.25, 1.0, e_sky);
                        let direct = vec3<f32>(1.0, 0.95, 0.85) * diffuse * sun_intensity;
                        var e_flash = vec3<f32>(0.0);
                        if (u.cam_pos.w > 0.5) {
                            let f_att = 1.0 / (1.0 + 0.04 * ent_t + 0.009 * ent_t * ent_t);
                            e_flash = vec3<f32>(1.0, 0.96, 0.88) * f_att * 2.4 * max(dot(normal, -rd), 0.15);
                        }
                        let lit_env = direct + ambient + e_gi + e_flash;

                        if (ent_kind >= 7.5) {
                            // Geometric Lawmancer Shading (8.0..13.5): Inner Sphere (Law color) + Orbiting Torus & Crown +/- (Polarity color), split 50/50 for Dual Lawmancers!
                            let p_rel = p - ent_center;
                            let s = max(ent_rad, 0.48);
                            let flen = length(vec2<f32>(ent_pod.x, ent_pod.z));
                            let m_fwd = select(normalize(vec3<f32>(ro.x - ent_center.x, 0.0, ro.z - ent_center.z) + vec3<f32>(0.001, 0.0, 0.001)),
                                               vec3<f32>(ent_pod.x / flen, 0.0, ent_pod.z / flen), flen > 0.05);
                            let m_side = vec3<f32>(-m_fwd.z, 0.0, m_fwd.x);
                            let pol = ent_pod.y;
                            let cast_surge = clamp(-ent_fill, 0.0, 1.0);
                            let hit_f = clamp(ent_fill, 0.0, 1.0);

                            let law_enc = max(0.0, ent_kind - 8.0);
                            let law_a = u32(clamp(floor(law_enc + 0.01), 0.0, 5.0));
                            let law_b = u32(clamp(round(fract(law_enc + 0.005) * 10.0), 0.0, 5.0));
                            let side_coord = dot(p_rel, m_side);
                            let active_law = select(law_a, law_b, side_coord >= 0.0);

                            let sph_col = get_law_sphere_col(active_law);
                            let tor_col = get_law_torus_col(active_law, pol);

                            let ndv_l = max(dot(normal, -rd), 0.0);
                            let fres_l = pow(1.0 - ndv_l, 2.4);
                            let refl_l = reflect(rd, normal);
                            let spec_l = pow(max(dot(refl_l, normalize(-rd + vec3<f32>(0.2, 0.7, 0.2))), 0.0), 28.0);

                            let bob = 0.06 * s * sin(u.time * 2.8);
                            let p_core = p_rel - vec3<f32>(0.0, 0.16 * s + bob, 0.0);
                            var law_rgb = vec3<f32>(0.0);

                            if (p_rel.y > 0.90 * s) {
                                // Literal + or - Crown Sign above the Lawmancer!
                                law_rgb = tor_col * (1.55 + 1.10 * fres_l + 1.35 * cast_surge) + vec3<f32>(0.35) * spec_l;
                                if (active_law == 4u && pol < 0.0) {
                                    // Photomancer -Umbral Void sign gets a sharp ultraviolet eclipse rim!
                                    law_rgb = vec3<f32>(0.02, 0.01, 0.05) + vec3<f32>(1.35, 0.35, 2.25) * pow(1.0 - ndv_l, 1.6);
                                }
                            } else if (length(p_core) < 0.56 * s) {
                                // Inner Sphere: Law Color Core with geometric latitude/longitude harmonic bands + Torus Fresnel rim!
                                let lat_band = 0.85 + 0.22 * sin(p_core.y * 22.0 - u.time * 4.0 * pol);
                                law_rgb = sph_col * lat_band * (lit_env * 0.75 + vec3<f32>(0.52))
                                        + tor_col * fres_l * (0.65 + 0.85 * cast_surge)
                                        + vec3<f32>(0.9, 0.95, 1.0) * spec_l * 0.65;
                            } else {
                                // Orbiting Torus Ring: Polarity Color (+ or -) with scrolling phase-wave around the ring!
                                let ring_ang = atan2(p_core.z, p_core.x);
                                let ring_wave = 0.78 + 0.32 * sin(ring_ang * 6.0 - u.time * 7.5 * sign(pol + 0.001));
                                law_rgb = tor_col * ring_wave * (1.15 + 0.95 * cast_surge)
                                        + sph_col * fres_l * 0.55
                                        + vec3<f32>(0.8) * spec_l * 0.45;
                                if (active_law == 4u && pol < 0.0) {
                                    law_rgb = vec3<f32>(0.015, 0.008, 0.035) + vec3<f32>(1.15, 0.28, 1.95) * fres_l * 1.4;
                                }
                            }

                            // Crisp 50/50 bisecting seam down the middle for Dual Lawmancers!
                            if (law_a != law_b) {
                                let seam = smoothstep(0.032 * s, 0.006 * s, abs(side_coord));
                                law_rgb = mix(law_rgb, vec3<f32>(2.4, 2.4, 2.6), seam * 0.75);
                            }

                            law_rgb = mix(law_rgb, vec3<f32>(2.85, 0.42, 0.35), hit_f * 0.82);
                            final_ent_color = law_rgb;
                        } else if (ent_kind > 4.5) {
                            // Phase-Bender Warlock Shading (5.0 = Solidmancer, 6.0 = Liquidmancer, 7.0 = Gasmancer)
                            let p_rel = p - ent_center;
                            let s = max(ent_rad, 0.48);
                            let flen = length(vec2<f32>(ent_pod.x, ent_pod.z));
                            let m_fwd = select(normalize(vec3<f32>(ro.x - ent_center.x, 0.0, ro.z - ent_center.z) + vec3<f32>(0.001, 0.0, 0.001)),
                                               vec3<f32>(ent_pod.x / flen, 0.0, ent_pod.z / flen), flen > 0.05);
                            let m_side = vec3<f32>(-m_fwd.z, 0.0, m_fwd.x);
                            let peak_m = max(ent_c.r, max(ent_c.g, ent_c.b));
                            let norm_c = ent_c / max(peak_m, 0.04);
                            let elem_tint = mix(vec3<f32>(0.58, 0.68, 0.96), norm_c, clamp(peak_m * 3.2, 0.30, 1.0));
                            let elem_hdr = max(ent_c, elem_tint * 1.45);
                            let cast_surge = clamp(-ent_fill, 0.0, 1.0);
                            let hit_f = clamp(ent_fill, 0.0, 1.0);

                            let ndv_m = max(dot(normal, -rd), 0.0);
                            let fres_m = pow(1.0 - ndv_m, 2.5);
                            let hem_glow = smoothstep(-0.72 * s, -1.16 * s, p_rel.y);
                            let sleeve_glow = smoothstep(0.32 * s, 0.56 * s, dot(p_rel, m_fwd)) * smoothstep(0.55 * s, 0.08 * s, abs(p_rel.y - 0.24 * s));
                            var warlock_rgb = vec3<f32>(0.0);

                            if (ent_kind < 5.5) {
                                // SOLIDMANCER (Lithomancer): Chiseled dark basalt/obsidian armor plates + glowing mineral fault-line seams on shoulder pauldrons!
                                let rock_facet = 0.80 + 0.30 * abs(sin(p_rel.x * 13.0) * cos(p_rel.z * 13.0)) * cos(p_rel.y * 8.0);
                                let pauldron_glow = smoothstep(0.42 * s, 0.64 * s, abs(dot(p_rel, m_side))) * smoothstep(0.15 * s, 0.48 * s, p_rel.y);
                                let vein_seam = smoothstep(0.82, 0.96, abs(sin(p_rel.y * 14.0 + p_rel.x * 9.0)));
                                warlock_rgb = vec3<f32>(0.075, 0.068, 0.064) * rock_facet * (lit_env + vec3<f32>(0.11, 0.10, 0.09))
                                            + elem_hdr * fres_m * (0.45 + 0.75 * cast_surge)
                                            + elem_hdr * (hem_glow * 0.45 + sleeve_glow * (0.50 + 0.95 * cast_surge) + pauldron_glow * (0.55 + 0.45 * vein_seam));
                            } else if (ent_kind < 6.5) {
                                // LIQUIDMANCER (Hydromancer): Glossy wet abyssal sea-silk + scrolling bioluminescent caustic wave-bands + wet specular sheen!
                                let caustic_wave = 0.5 + 0.5 * sin(p_rel.y * 16.0 - u.time * 5.2 + sin(p_rel.x * 10.0 + p_rel.z * 10.0));
                                let wet_spec = pow(max(dot(normal, normalize(-rd + vec3<f32>(0.0, 0.65, 0.0))), 0.0), 18.0);
                                let collar_glow = smoothstep(0.42 * s, 0.78 * s, p_rel.y) * smoothstep(0.10 * s, -0.25 * s, dot(p_rel, m_fwd));
                                warlock_rgb = vec3<f32>(0.038, 0.072, 0.115) * (0.82 + 0.28 * caustic_wave) * (lit_env + vec3<f32>(0.08, 0.12, 0.18))
                                            + elem_hdr * fres_m * (0.55 + 0.80 * cast_surge)
                                            + elem_hdr * (hem_glow * 0.62 + sleeve_glow * (0.52 + 0.95 * cast_surge) + collar_glow * 0.48 + caustic_wave * 0.18)
                                            + (elem_tint * 0.55 + vec3<f32>(0.50, 0.62, 0.72)) * wet_spec * 0.75;
                            } else {
                                // GASMANCER (Aeromancer): Swirling tempest-shroud + fast-scrolling helical wind-streaks + blazing cyclone vortex tail!
                                let wind_streak = 0.5 + 0.5 * sin(p_rel.y * 19.0 + (p_rel.x - p_rel.z) * 11.0 - u.time * 7.5);
                                let vortex_tail = smoothstep(-0.28 * s, -1.16 * s, p_rel.y);
                                warlock_rgb = vec3<f32>(0.062, 0.055, 0.110) * (0.78 + 0.34 * wind_streak) * (lit_env + vec3<f32>(0.12, 0.11, 0.18))
                                            + elem_hdr * fres_m * (0.68 + 0.95 * cast_surge)
                                            + elem_hdr * (vortex_tail * (0.78 + 0.45 * wind_streak) + sleeve_glow * (0.55 + 0.95 * cast_surge));
                            }

                            // Floating Phase-Specific Crown above the hood
                            if (p_rel.y > 1.02 * s) {
                                warlock_rgb = elem_hdr * (1.30 + 0.90 * fres_m + 1.15 * cast_surge) + elem_tint * lit_env * 0.45;
                            } else {
                                // Deep recessed hood void + twin blazing elemental warlock eyes!
                                let cav_c = ent_center + m_fwd * (0.30 * s) + vec3<f32>(0.0, 0.70 * s, 0.0);
                                let in_hood = smoothstep(0.34 * s, 0.16 * s, length(p - cav_c));
                                warlock_rgb = mix(warlock_rgb, vec3<f32>(0.008, 0.006, 0.014), in_hood * 0.96);

                                let eye_c = ent_center + m_fwd * (0.16 * s) + vec3<f32>(0.0, 0.72 * s, 0.0);
                                let me1 = eye_c + m_side * (0.115 * s);
                                let me2 = eye_c - m_side * (0.115 * s);
                                let t_me1 = max(dot(me1 - p, rd), 0.0);
                                let t_me2 = max(dot(me2 - p, rd), 0.0);
                                let d_meye = min(length((me1 - p) - rd * t_me1), length((me2 - p) - rd * t_me2));
                                let eye_glow = smoothstep(0.068 * s, 0.022 * s, d_meye) * smoothstep(-0.15, 0.25, dot(m_fwd, -rd));
                                warlock_rgb = warlock_rgb + (elem_hdr * (2.6 + 1.8 * cast_surge) + vec3<f32>(0.45, 0.42, 0.38)) * eye_glow;
                            }

                            warlock_rgb = mix(warlock_rgb, vec3<f32>(2.85, 0.42, 0.35), hit_f * 0.82);
                            final_ent_color = warlock_rgb;
                        } else if (ent_kind > 3.5) {
                            // Armored Subterranean Maw-Tick / Cave Hopper: mineral carapace + dorsal spikes + glowing maw + predator eyespots!
                            let p_rel = p - ent_center;
                            let coil_f = clamp(-ent_fill, 0.0, 1.0);
                            let hit_f = clamp(ent_fill, 0.0, 1.0);
                            let grain = 0.82 + 0.32 * fract(sin(dot(floor(p_rel * 9.5), vec3<f32>(12.9898, 78.233, 37.719))) * 43758.5453);
                            let ndv_h = max(dot(normal, -rd), 0.0);
                            let fres_h = pow(1.0 - ndv_h, 2.5);
                            let peak_h = max(ent_c.r, max(ent_c.g, ent_c.b));
                            let base_tint = ent_c / max(peak_h, 1.0);
                            let spine_crest = smoothstep(ent_rad * 0.34, ent_rad * 0.68, p_rel.y);
                            var hop_rgb = base_tint * grain * lit_env + base_tint * fres_h * (0.20 + 0.35 * spine_crest);
                            if (peak_h > 1.05) {
                                hop_rgb = hop_rgb + ent_c * (0.36 + 0.32 * fres_h + 0.45 * spine_crest) * grain;
                            }
                            // Dorsal spine tips flare when coiled for a pounce or in Blood-Frenzy!
                            hop_rgb = hop_rgb + mix(base_tint, vec3<f32>(2.45, 0.28, 0.12), 0.65) * spine_crest * coil_f * 0.85;

                            let has_fwd = length(ent_pod) > 0.08;
                            let h_fwd = select(normalize(ro - ent_center + vec3<f32>(0.001)), normalize(ent_pod), has_fwd);
                            let h_side = normalize(cross(vec3<f32>(0.0, 1.0, 0.0), h_fwd) + vec3<f32>(0.001, 0.0, 0.001));
                            let h_up = normalize(cross(h_fwd, h_side));

                            // Recessed predator maw cavity + glowing elemental/crimson gullet
                            let maw_c = ent_center + h_fwd * (ent_rad * 0.72) - h_up * (ent_rad * 0.16);
                            let in_maw = smoothstep(ent_rad * 0.38, ent_rad * 0.16, length(p - maw_c));
                            let maw_glow = mix(ent_c * 0.65, vec3<f32>(2.20, 0.22, 0.08), 0.45 + 0.55 * coil_f);
                            hop_rgb = mix(hop_rgb, vec3<f32>(0.02, 0.01, 0.015) + maw_glow * (0.35 + 0.85 * coil_f), in_maw * 0.92);

                            // Fierce twin predator eyespots above the maw
                            let e_surf = ent_center + h_fwd * (ent_rad * 0.82) + h_up * (ent_rad * mix(0.22, 0.12, coil_f));
                            let he1 = e_surf + h_side * (ent_rad * 0.32);
                            let he2 = e_surf - h_side * (ent_rad * 0.32);
                            let de = min(length(p - he1), length(p - he2));
                            let front_vis = smoothstep(-0.05, 0.40, dot(normal, h_fwd));
                            let socket_m = smoothstep(ent_rad * 0.20, ent_rad * 0.12, de) * front_vis;
                            let iris_m = smoothstep(ent_rad * 0.135, ent_rad * 0.05, de) * front_vis;
                            hop_rgb = mix(hop_rgb, vec3<f32>(0.03, 0.015, 0.02), socket_m * 0.90);
                            hop_rgb = mix(hop_rgb, vec3<f32>(2.65, 0.26, 0.10) * (1.0 + 0.85 * coil_f), iris_m);

                            hop_rgb = mix(hop_rgb, vec3<f32>(2.75, 0.38, 0.32), hit_f * 0.82);
                            final_ent_color = hop_rgb;
                        } else if (ent_kind >= 1.5) {
                            // Translucent Ditto-Amoeba: refracted cave background + wet Fresnel rim + glowing stomach vacuole + eyespots!
                            let far_y_bg = ro.y + rd.y * min(t_far, 88.0);
                            let bg_sky_vis = clamp((max(ro.y, far_y_bg) - 6.0) / 18.0, 0.0, 1.0);
                            let fallback_bg = mix(color * bg_sky_vis, accum_color, accum_alpha);
                            let bg_behind = select(fallback_bg, hit_color, hit);

                            let ndv = max(dot(normal, -rd), 0.0);
                            let fresnel = pow(1.0 - ndv, 2.35);
                            let refl = reflect(rd, normal);
                            let view_l = normalize(-rd + vec3<f32>(0.25, 0.68, 0.20));
                            let spec = pow(max(dot(refl, view_l), 0.0), 34.0);

                            let peak_c = max(ent_c.r, max(ent_c.g, ent_c.b));
                            let is_lum = peak_c > 1.05;
                            let tint = ent_c / max(peak_c, 1.0);
                            let fill_amt = select(clamp(ent_fill, 0.0, 1.0), 0.85, ent_kind >= 2.5);

                            let vac_center = ent_center + ent_pod * select(0.16, 0.0, ent_kind >= 2.5);
                            let to_vac = vac_center - p;
                            let proj_t = max(dot(to_vac, rd), 0.0);
                            let vac_d = length(to_vac - rd * proj_t);
                            let vac_r = ent_rad * mix(0.22, 0.66, fill_amt);
                            let vac_core = smoothstep(vac_r, vac_r * 0.18, vac_d) * mix(0.20, 0.94, fill_amt);

                            let has_pod = length(ent_pod) > 0.14;
                            let raw_fwd = select(normalize(ro - ent_center + vec3<f32>(0.001)), normalize(ent_pod), has_pod);
                            let side_ax = normalize(cross(vec3<f32>(0.0, 1.0, 0.0), raw_fwd) + vec3<f32>(0.001, 0.0, 0.001));
                            let up_ax = normalize(cross(raw_fwd, side_ax));
                            let eye_base = ent_center + raw_fwd * (ent_rad * 0.58) + up_ax * (ent_rad * 0.20);
                            let eye1 = eye_base + side_ax * (ent_rad * 0.23);
                            let eye2 = eye_base - side_ax * (ent_rad * 0.23);
                            let t_e1 = max(dot(eye1 - p, rd), 0.0);
                            let t_e2 = max(dot(eye2 - p, rd), 0.0);
                            let d_eye = min(length((eye1 - p) - rd * t_e1), length((eye2 - p) - rd * t_e2));
                            let eye_mask = smoothstep(ent_rad * 0.115, ent_rad * 0.045, d_eye) * select(1.0, 0.0, ent_kind >= 2.5);

                            let refracted_bg = bg_behind * mix(vec3<f32>(0.92, 0.96, 1.0), tint * 1.15 + vec3<f32>(0.12), 0.56);
                            let lum_rim = select(0.0, (peak_c - 0.85) * 0.55, is_lum);
                            let jelly_skin = tint * (lit_env * 0.88 + vec3<f32>(0.08, 0.11, 0.15))
                                           + tint * fresnel * (0.58 + lum_rim)
                                           + vec3<f32>(0.92, 0.97, 1.0) * spec * 0.58;
                            let vac_col = select(tint * (lit_env * 1.18 + vec3<f32>(0.08)), ent_c * 1.22, is_lum);

                            var amoeba_rgb = mix(refracted_bg, jelly_skin, clamp(0.38 + 0.46 * fresnel, 0.0, 0.86));
                            amoeba_rgb = mix(amoeba_rgb, vac_col, vac_core);
                            amoeba_rgb = mix(amoeba_rgb, vec3<f32>(0.03, 0.02, 0.06), eye_mask * 0.90);
                            final_ent_color = amoeba_rgb;
                        } else if (max(ent_c.r, max(ent_c.g, ent_c.b)) > 1.05) {
                            // Self-emissive incandescent ember (lit match head / glowing crystal boulder!)
                            let rim = 0.72 + 0.55 * max(dot(normal, -rd), 0.0);
                            final_ent_color = ent_c * rim;
                        } else {
                            final_ent_color = ent_c * lit_env;
                        }
                        ent_hit = true;
                        break;
                    }
                    ent_t = ent_t + clamp(dist, 0.008, 1.05);
                }
                if (ent_hit) {
                    hit = true;
                    t = ent_t;
                    hit_color = final_ent_color;
                }
            }
        }
        
        if (hit) {
            // Apply linear atmospheric distance fog ending at the world box boundary (88 units)
            let fog_factor = clamp((t - 44.0) / 44.0, 0.0, 1.0);
            
            // Fade fog color to pitch black underground so huge caverns contrast against the abyss
            let depth_fade = clamp(((ro.y + rd.y * t) - 4.0) / 20.0, 0.0, 1.0);
            let fog_color = mix(space_color, horizon_color, max(0.0, rd.y)) * depth_fade;
            
            color = mix(hit_color, fog_color, fog_factor);
        } else {
            let far_y = ro.y + rd.y * min(t_far, 88.0);
            let bg_sky_vis = clamp((max(ro.y, far_y) - 6.0) / 18.0, 0.0, 1.0);
            color = mix(color * bg_sky_vis, accum_color, accum_alpha);
        }

        // Lawmancer 3D Personal Forcefield Bubble (r = 2.75m) & Radiating Spherical Wavefront Shell + Wall-Slice Ring!
        let max_shell_t = select(min(t_far, 88.0), t, hit);
        let p_surface = ro + rd * max_shell_t;
        for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
            let raw_m = u.mancer_mat[mk].x;
            if (raw_m >= 768.5 && u.mancer_pos[mk].w > 0.1) {
                let m_c = u.mancer_pos[mk].xyz;
                let pol_m = u.mancer_mat[mk].w;
                var la: u32 = 0u;
                var lb: u32 = 0u;
                if (raw_m >= 779.5) {
                    let pair_u = u32(clamp(round(raw_m - 780.0), 0.0, 35.0));
                    la = min(pair_u / 6u, 5u);
                    lb = min(pair_u % 6u, 5u);
                } else {
                    la = u32(clamp(round(raw_m - 769.0), 0.0, 5.0));
                    lb = la;
                }
                let to_cam_xz = normalize(vec3<f32>(ro.x - m_c.x, 0.0, ro.z - m_c.z) + vec3<f32>(0.001, 0.0, 0.001));
                let l_side = vec3<f32>(-to_cam_xz.z, 0.0, to_cam_xz.x);

                // 1. Personal +/- Forcefield Shell (r = 2.75m)
                let r_ff: f32 = 2.75;
                let oc_f = ro - m_c;
                let b_f = dot(oc_f, rd);
                let c_f = dot(oc_f, oc_f) - r_ff * r_ff;
                let disc_f = b_f * b_f - c_f;
                if (disc_f > 0.0) {
                    let sq_f = sqrt(disc_f);
                    let tf = select(-b_f - sq_f, -b_f + sq_f, -b_f - sq_f < 0.05);
                    if (tf > 0.05 && tf < max_shell_t) {
                        let pf = ro + rd * tf;
                        let nf = (pf - m_c) / r_ff;
                        let side_f = select(la, lb, dot(pf - m_c, l_side) >= 0.0);
                        let f_col = get_law_torus_col(side_f, pol_m);
                        let rim_f = pow(1.0 - abs(dot(nf, rd)), 3.0);
                        let hex_rip = 0.72 + 0.28 * sin(pf.y * 9.0 - u.time * 6.0 * pol_m);
                        if (side_f == 4u && pol_m < 0.0) {
                            color = mix(color, vec3<f32>(0.01, 0.005, 0.025), clamp(0.18 + rim_f * 0.65, 0.0, 0.78));
                            color += vec3<f32>(0.85, 0.20, 1.55) * rim_f * 0.45;
                        } else {
                            color += f_col * rim_f * hex_rip * 0.42;
                        }
                    }
                }

                // 2. Expanding Spherical Law Wavefront (u.mancer_mat[mk].z = signed radius)
                let wave_signed = u.mancer_mat[mk].z;
                let wave_r = abs(wave_signed);
                if (wave_r > 0.25) {
                    let w_pol = sign(wave_signed);
                    let fade_w = clamp(1.0 - wave_r / 17.0, 0.0, 1.0);
                    let c_w = dot(oc_f, oc_f) - wave_r * wave_r;
                    let disc_w = b_f * b_f - c_w;
                    if (disc_w > 0.0) {
                        let sq_w = sqrt(disc_w);
                        let tw0 = -b_f - sq_w;
                        let tw1 = -b_f + sq_w;
                        if (tw0 > 0.05 && tw0 < max_shell_t) {
                            let pw = ro + rd * tw0;
                            let nw = (pw - m_c) / max(wave_r, 0.1);
                            let side_w = select(la, lb, dot(pw - m_c, l_side) >= 0.0);
                            let w_col = get_law_torus_col(side_w, w_pol);
                            let rim_w = 0.22 + 0.95 * pow(1.0 - abs(dot(nw, rd)), 2.2);
                            if (side_w == 4u && w_pol < 0.0) {
                                color = mix(color, vec3<f32>(0.005, 0.002, 0.015), clamp(rim_w * fade_w * 0.85, 0.0, 0.88));
                            } else {
                                color += w_col * rim_w * fade_w * 0.68;
                            }
                        } else if (tw1 > 0.05 && tw1 < max_shell_t) {
                            // Inside the expanding wavefront sphere looking outward!
                            let pw = ro + rd * tw1;
                            let nw = (pw - m_c) / max(wave_r, 0.1);
                            let side_w = select(la, lb, dot(pw - m_c, l_side) >= 0.0);
                            let w_col = get_law_torus_col(side_w, w_pol);
                            let rim_w = 0.18 + 0.75 * pow(1.0 - abs(dot(nw, rd)), 2.0);
                            color += w_col * rim_w * fade_w * 0.48;
                        }
                    }
                    // Crisp glowing ring where the expanding spherical wavefront slices cave walls/floors!
                    if (hit) {
                        let d_slice = abs(length(p_surface - m_c) - wave_r);
                        if (d_slice < 0.55) {
                            let side_s = select(la, lb, dot(p_surface - m_c, l_side) >= 0.0);
                            let s_col = get_law_torus_col(side_s, w_pol);
                            let ring_i = smoothstep(0.55, 0.04, d_slice) * fade_w;
                            if (side_s == 4u && w_pol < 0.0) {
                                color = mix(color, vec3<f32>(0.01, 0.0, 0.03), ring_i * 0.92);
                                color += vec3<f32>(1.1, 0.25, 1.8) * smoothstep(0.18, 0.02, d_slice) * fade_w;
                            } else {
                                color += s_col * ring_i * 1.35;
                            }
                        }
                    }
                }
            }
        }
    }
    
    var final_depth: f32 = 1.0;
    if (hit) {
        let p_hit = ro + rd * t;
        let clip = u.view_proj * vec4<f32>(p_hit, 1.0);
        if (clip.w > 0.0001) {
            final_depth = clamp(clip.z / clip.w, 0.0, 1.0);
        }
    }
    
    let dummy = textureSampleLevel(liquid_texture, voxel_sampler, vec3<f32>(0.0), 0.0).r +
                textureSampleLevel(gas_texture, voxel_sampler, vec3<f32>(0.0), 0.0).r +
                textureSampleLevel(vel_texture, voxel_sampler, vec3<f32>(0.0), 0.0).r;
    var out: FragmentOutput;
    out.color = vec4<f32>(color + dummy * 0.000001, 1.0);
    out.depth = final_depth;
    return out;
}
")

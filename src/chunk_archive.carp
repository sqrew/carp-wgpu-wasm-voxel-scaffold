;; =============================================================================
;; src/chunk_archive.carp — Pure-Carp + C-Template RLE Toroidal Chunk Archive
;;   Persists carved tunnels, built CSG/masonry contraptions, surface stains,
;;   Gold voltage, falling grains, and exact liquid/gas volumes when chunks
;;   evict from and re-enter the `5x5x5` (`160^3`) GPU toroidal window.
;;
;;   Invariants:
;;   - Sign-split `sdf_u8` (`0..127` strictly `<= -0.04f` solid; `128..255`
;;     strictly `>= +0.04f` air) guarantees 100% bit-exact solid/air boundaries
;;     across unlimited save/load round-trips (thin 1-voxel pipe walls never flip!).
;;   - Open-addressed `2048`-slot hash table with Knuth Algorithm R backward-shift
;;     deletion (zero tombstones) and `1,536`-chunk LRU cap (~16-20 MB max RAM).
;; =============================================================================

(system-include "stdint.h")
(system-include "string.h")
(system-include "math.h")

(deftemplate ca-hash-coord (Fn [Int Int Int] Int)
  "int $NAME(int qx, int qy, int qz)"
  "$DECL {
     uint32_t h = (uint32_t)qx * 0x9E3779B9u;
     h ^= (uint32_t)qy * 0x85EBCA6Bu;
     h = (h << 13) | (h >> 19);
     h = h * 5u + 0xE6546B64u;
     h ^= (uint32_t)qz * 0xC2B2AE35u;
     h ^= h >> 16;
     h *= 0x85EBCA6Bu;
     h ^= h >> 13;
     h *= 0xC2B2AE35u;
     h ^= h >> 16;
     return (int)(h & 0x7FFFFFFFu);
   }")

;; Packs `32,768` voxels (`131,072` floats) into static RLE scratch buffer `[run_len, word, ...]`
;; and copies directly into `dst` when `dst_cap >= out_words` (or when `p_data == NULL` on grow-retry).
(deftemplate ca-copy-from-scratch! (Fn [(Ptr Uint32) Int (Ptr Float)] Int)
  "int $NAME(uint32_t* dst, int dst_cap, float* p_data)"
  "$DECL {
     static uint32_t s_buf[65536];
     if (p_data != NULL) {
       int out_words = 0;
       uint32_t prev_w = 0u;
       uint32_t run_len = 0u;
       for (int i = 0; i < 32768; ++i) {
         int off = i * 4;
         float mat = p_data[off];
         float sdf = p_data[off + 1];
         float z   = p_data[off + 2];
         uint32_t w = 0u;
         if (sdf <= 0.0f) {
           if (mat < -0.5f) {
             int m_abs = (int)floorf(-mat + 0.5f);
             if (m_abs < 1) m_abs = 1;
             if (m_abs > 254) m_abs = 254;
             w = (uint32_t)m_abs | (122u << 8) | (255u << 16);
           } else {
             int m_id = (int)floorf(fabsf(mat) + 0.5f);
             if (m_id < 1) m_id = 1;
             if (m_id > 255) m_id = 255;
             float sc = (sdf + 12.0f) * (127.0f / 11.96f);
             int s_u8 = (int)floorf(sc + 0.5f);
             if (s_u8 < 0) s_u8 = 0;
             if (s_u8 > 127) s_u8 = 127;
             uint32_t z_id = 0u, z_mag = 0u, z_neg = 0u;
             if (z >= 2.5f) {
               z_id = 2u;
               int st = (int)floorf(z + 0.5f);
               if (st < 3) st = 3;
               if (st > 127) st = 127;
               z_mag = (uint32_t)st;
             } else if (z > 0.015f) {
               z_id = 1u;
               int hm = (int)floorf(z * (127.0f / 2.0f) + 0.5f);
               if (hm < 1) hm = 1;
               if (hm > 127) hm = 127;
               z_mag = (uint32_t)hm;
             } else if (z < -0.015f) {
               z_neg = 1u;
               z_id = 1u;
               int vm = (int)floorf((-z) * 127.0f + 0.5f);
               if (vm < 1) vm = 1;
               if (vm > 127) vm = 127;
               z_mag = (uint32_t)vm;
             }
             w = (uint32_t)m_id | ((uint32_t)s_u8 << 8) | (z_id << 16) | (z_mag << 24) | (z_neg << 31);
           }
         } else {
           float ac = (sdf - 0.04f) * (127.0f / 11.96f);
           int a_u7 = (int)floorf(ac + 0.5f);
           if (a_u7 < 0) a_u7 = 0;
           if (a_u7 > 127) a_u7 = 127;
           uint32_t s_u8 = 128u + (uint32_t)a_u7;
           uint32_t z_id = 0u, z_mag = 0u, z_neg = 0u;
           float az = fabsf(z);
           if (az > 0.5f) {
             z_neg = (z < 0.0f) ? 1u : 0u;
             float fid_f = floorf(az + 0.0005f);
             int fid = (int)fid_f;
             if (fid < 1) fid = 1;
             if (fid > 254) fid = 254;
             z_id = (uint32_t)fid;
             float rem = az - fid_f;
             if (rem > 0.01f) {
               int rm = (int)floorf(rem * 125.0f + 0.5f);
               if (rm < 2) rm = 2;
               if (rm > 123) rm = 123;
               z_mag = (uint32_t)rm;
             }
           }
           w = (s_u8 << 8) | (z_id << 16) | (z_mag << 24) | (z_neg << 31);
         }
         if (i == 0) {
           prev_w = w;
           run_len = 1u;
         } else if (w == prev_w) {
           run_len += 1u;
         } else {
           s_buf[out_words++] = run_len;
           s_buf[out_words++] = prev_w;
           prev_w = w;
           run_len = 1u;
         }
       }
       s_buf[out_words++] = run_len;
       s_buf[out_words++] = prev_w;
       if (dst != NULL && dst_cap >= out_words) {
         memcpy(dst, s_buf, (size_t)out_words * sizeof(uint32_t));
       }
       return out_words;
     } else {
       if (dst != NULL && dst_cap > 0) {
         memcpy(dst, s_buf, (size_t)dst_cap * sizeof(uint32_t));
       }
       return dst_cap;
     }
   }")

(deftemplate ca-decode-rle! (Fn [(Ptr Uint32) Int (Ptr Float)] ())
  "void $NAME(uint32_t* rle, int rle_words, float* p_data)"
  "$DECL {
     int vox = 0;
     int idx = 0;
     while (idx + 1 < rle_words && vox < 32768) {
       uint32_t cnt = rle[idx];
       uint32_t w   = rle[idx + 1];
       idx += 2;

       uint32_t m_u8  = w & 0xFFu;
       uint32_t s_u8  = (w >> 8) & 0xFFu;
       uint32_t z_id  = (w >> 16) & 0xFFu;
       uint32_t z_mag = (w >> 24) & 0x7Fu;
       uint32_t z_neg = (w >> 31) & 1u;

       float f0 = 0.0f, f1 = 12.0f, f2 = 0.0f, f3 = 0.0f;
       if (s_u8 < 128u) {
         if (z_id == 255u) {
           f0 = -(float)m_u8;
           f1 = -0.50f;
           f2 = 0.0f;
           f3 = 0.0f;
         } else {
           float sdf = -12.0f + (float)s_u8 * (11.96f / 127.0f);
           if (sdf > -0.53f && sdf < -0.47f) sdf = -0.55f;
           float z = 0.0f;
           if (z_id == 2u) {
             z = (float)z_mag;
           } else if (z_id == 1u) {
             z = z_neg ? (-(float)z_mag * (1.0f / 127.0f)) : ((float)z_mag * (2.0f / 127.0f));
           }
           f0 = (float)(m_u8 > 0u ? m_u8 : 1u);
           f1 = sdf;
           f2 = z;
           f3 = 10.0f;
         }
       } else {
         float sdf = 0.04f + (float)(s_u8 - 128u) * (11.96f / 127.0f);
         float z = 0.0f;
         if (z_id > 0u) {
           float mag = (float)z_id + ((z_mag > 0u) ? ((float)z_mag * (1.0f / 125.0f)) : 0.0f);
           z = z_neg ? (-mag) : mag;
         }
         f0 = 0.0f;
         f1 = sdf;
         f2 = z;
         f3 = 0.0f;
       }

       int end_vox = vox + (int)cnt;
       if (end_vox > 32768) end_vox = 32768;
       for (; vox < end_vox; ++vox) {
         int off = vox * 4;
         p_data[off]     = f0;
         p_data[off + 1] = f1;
         p_data[off + 2] = f2;
         p_data[off + 3] = f3;
       }
     }
   }")

(deftype ArchiveEntry [
  used Bool
  qx Int
  qy Int
  qz Int
  stamp Int
  rle-len Int
  rle (Array Uint32)
])

(deftype ChunkArchive [
  count Int
  slots (Array ArchiveEntry)
])

(defmodule ChunkArchive
  (defn make []
    (let [slots (Array.allocate 2048)]
      (do
        (for [i 0 2048]
          (Array.aset-uninitialized! &slots i (ArchiveEntry.init false 0 0 0 0 0 [])))
        (ChunkArchive.init 0 slots))))

  ;; Knuth Algorithm R backward-shift deletion on 2048-slot power-of-2 linear-probing table (zero tombstones!)
  (defn delete-slot! [slots del-idx]
    (let [e0 (Array.unsafe-nth slots del-idx)]
      (do
        (ArchiveEntry.set-used! e0 false)
        (ArchiveEntry.set-rle-len! e0 0)
        ;; Release oversized outlier buffers while keeping normal ~12 KB buffers warm for zero-malloc reuse!
        (when (> (Array.length (ArchiveEntry.rle e0)) 8192)
          (ArchiveEntry.set-rle! e0 []))
        (let [i del-idx
              j (Int.bit-and (+ del-idx 1) 2047)
              scanning? true]
          (while scanning?
            (let [ej (Array.unsafe-nth slots j)]
              (if (not @(ArchiveEntry.used ej))
                (set! scanning? false)
                (let [k (Int.bit-and (ca-hash-coord @(ArchiveEntry.qx ej) @(ArchiveEntry.qy ej) @(ArchiveEntry.qz ej)) 2047)
                      outside? (if (<= i j)
                                 (or (<= k i) (> k j))
                                 (and (<= k i) (> k j)))]
                  (do
                    (when outside?
                      (do
                        (Array.swap! slots i j)
                        (set! i j)))
                    (set! j (Int.bit-and (+ j 1) 2047)))))))))))

  ;; Evict the oldest-stamped (`LRU`) entry when archive reaches `1,536` chunks (~16-20 MB cap)
  (defn evict-oldest! [archive]
    (let [slots (ChunkArchive.slots archive)
          best-idx -1
          best-stamp 2147483647]
      (do
        (for [i 0 2048]
          (let [e (Array.unsafe-nth slots i)]
            (when (and @(ArchiveEntry.used e) (< @(ArchiveEntry.stamp e) best-stamp))
              (do
                (set! best-stamp @(ArchiveEntry.stamp e))
                (set! best-idx i)))))
        (when (>= best-idx 0)
          (do
            (ChunkArchive.delete-slot! slots best-idx)
            (ChunkArchive.set-count! archive (- @(ChunkArchive.count archive) 1)))))))

  ;; Find slot for `(qx, qy, qz)`: returns `>= 0` if live hit, or `-(empty_slot + 1) < 0` on miss
  (defn probe-slot [slots qx qy qz]
    (let [idx (Int.bit-and (ca-hash-coord qx qy qz) 2047)
          steps 0
          result -1
          done? false]
      (do
        (while (and (< steps 2048) (not done?))
          (let [e (Array.unsafe-nth slots idx)]
            (if (not @(ArchiveEntry.used e))
              (do
                (set! result (- -1 idx))
                (set! done? true))
              (if (and (= @(ArchiveEntry.qx e) qx)
                       (and (= @(ArchiveEntry.qy e) qy)
                            (= @(ArchiveEntry.qz e) qz)))
                (do
                  (set! result idx)
                  (set! done? true))
                (do
                  (set! idx (Int.bit-and (+ idx 1) 2047))
                  (set! steps (+ steps 1)))))))
        result)))

  (defn write-entry-rle! [entry qx qy qz stamp p-data]
    (let [cur-cap (Array.length (ArchiveEntry.rle entry))
          cur-ptr (if (> cur-cap 0) (Array.unsafe-raw (ArchiveEntry.rle entry)) NULL)
          words (ca-copy-from-scratch! cur-ptr cur-cap p-data)]
      (do
        (when (> words cur-cap)
          (let [alloc-cap (+ words 256)
                new-buf (Array.allocate alloc-cap)
                _ (ca-copy-from-scratch! (Array.unsafe-raw &new-buf) words NULL)]
            (ArchiveEntry.set-rle! entry new-buf)))
        (ArchiveEntry.set-used! entry true)
        (ArchiveEntry.set-qx! entry qx)
        (ArchiveEntry.set-qy! entry qy)
        (ArchiveEntry.set-qz! entry qz)
        (ArchiveEntry.set-stamp! entry stamp)
        (ArchiveEntry.set-rle-len! entry words))))

  ;; Compress & store `(qx, qy, qz)` from `p-data` (`131,072` floats) into `archive`
  (defn store! [archive qx qy qz p-data stamp]
    (let [p0 (ChunkArchive.probe-slot (ChunkArchive.slots archive) qx qy qz)]
      (if (>= p0 0)
        (let [entry (Array.unsafe-nth (ChunkArchive.slots archive) p0)]
          (ChunkArchive.write-entry-rle! entry qx qy qz stamp p-data))
        (do
          (when (>= @(ChunkArchive.count archive) 1536)
            (ChunkArchive.evict-oldest! archive))
          (let [slots (ChunkArchive.slots archive)
                p1 (ChunkArchive.probe-slot slots qx qy qz)
                ins-idx (if (>= p1 0) p1 (- -1 p1))]
            (when (and (>= ins-idx 0) (< ins-idx 2048))
              (let [entry (Array.unsafe-nth slots ins-idx)]
                (do
                  (when (not @(ArchiveEntry.used entry))
                    (ChunkArchive.set-count! archive (+ @(ChunkArchive.count archive) 1)))
                  (ChunkArchive.write-entry-rle! entry qx qy qz stamp p-data)))))))))

  ;; Decompress `(qx, qy, qz)` into `p-data` if cached; returns `true` on hit (~0.02 ms), `false` on miss!
  (defn load! [archive qx qy qz p-data stamp]
    (let [slots (ChunkArchive.slots archive)
          idx (ChunkArchive.probe-slot slots qx qy qz)]
      (if (< idx 0)
        false
        (let [entry (Array.unsafe-nth slots idx)
              wlen @(ArchiveEntry.rle-len entry)]
          (if (<= wlen 0)
            false
            (do
              (ArchiveEntry.set-stamp! entry stamp)
              (ca-decode-rle! (Array.unsafe-raw (ArchiveEntry.rle entry)) wlen p-data)
              true))))))
)

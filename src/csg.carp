;; =============================================================================
;; src/csg.carp — Shared Pure-Carp 3D SDF & Material-CSG Combinator Kit
;;   Zero-allocation geometric & organic 3D signed-distance primitives, domain
;;   folds, twists, sways, and material-carrying boolean combinators (`MatSDF`)
;;   shared across subterranean dungeon structures, CSG flora, and formations.
;; =============================================================================

(deftemplate csg-hash4 (Fn [Int Int Int Int] Int)
  "int $NAME(int seed, int rx, int ry, int rz)"
  "$DECL {
     uint32_t h = (uint32_t)seed * 0x9E3779B9u;
     h ^= (uint32_t)rx * 0x85EBCA6Bu;
     h = (h << 13) | (h >> 19);
     h = h * 5u + 0xE6546B64u;
     h ^= (uint32_t)ry * 0xC2B2AE35u;
     h = (h << 15) | (h >> 17);
     h = h * 5u + 0x52DCE729u;
     h ^= (uint32_t)rz * 0x27D4EB2Fu;
     h ^= h >> 16;
     h *= 0x85EBCA6Bu;
     h ^= h >> 13;
     h *= 0xC2B2AE35u;
     h ^= h >> 16;
     return (int)(h & 0x7FFFFFFFu);
   }")

;; Stack-allocated `(distance, material)` pair for multi-material CSG assemblies
(deftype MatSDF [
  d Double
  mat Float
])

(defmodule CSG
  (defn dmin [a b] (if (< a b) a b))
  (defn dmax [a b] (if (> a b) a b))
  (defn dclamp [lo hi x] (if (< x lo) lo (if (> x hi) hi x)))

  (defn len2 [x y]
    (Double.sqrt (+ (* x x) (* y y))))

  (defn len3 [x y z]
    (Double.sqrt (+ (+ (* x x) (* y y)) (* z z))))

  ;; --- Exact & Lipschitz-Safe Geometric + Organic Primitives ---

  (defn sd-sphere [px py pz r]
    (- (CSG.len3 px py pz) r))

  ;; Quilez Exact-Surface-Gradient Ellipsoid (`|grad d| == 1` on surface, `<= 1` everywhere)
  (defn sd-ellipsoid [px py pz rx ry rz]
    (let [k0 (CSG.len3 (/ px rx) (/ py ry) (/ pz rz))]
      (if (< k0 0.0001)
        (- 0.0 (CSG.dmin rx (CSG.dmin ry rz)))
        (let [k1 (CSG.len3 (/ px (* rx rx)) (/ py (* ry ry)) (/ pz (* rz rz)))]
          (/ (* k0 (- k0 1.0)) k1)))))

  ;; Exact Quilez 3D Axis-Aligned Box
  (defn sd-box [px py pz bx by bz]
    (let [qx (- (Double.abs px) bx)
          qy (- (Double.abs py) by)
          qz (- (Double.abs pz) bz)
          ox (CSG.dmax qx 0.0)
          oy (CSG.dmax qy 0.0)
          oz (CSG.dmax qz 0.0)
          outside (CSG.len3 ox oy oz)
          inside (CSG.dmin (CSG.dmax qx (CSG.dmax qy qz)) 0.0)]
      (+ outside inside)))

  ;; Brutalist 45-degree Chamfered Box (`ch` = corner/edge bevel inset)
  (defn sd-chamfer-box [px py pz bx by bz ch]
    (let [dbox (CSG.sd-box px py pz bx by bz)
          ax (Double.abs px)
          ay (Double.abs py)
          az (Double.abs pz)
          dxy (* (- (+ ax ay) (- (+ bx by) ch)) 0.70710678)
          dyz (* (- (+ ay az) (- (+ by bz) ch)) 0.70710678)
          dzx (* (- (+ az ax) (- (+ bz bx) ch)) 0.70710678)
          doct (* (- (+ (+ ax ay) az) (- (+ (+ bx by) bz) (* ch 1.65))) 0.57735027)]
      (CSG.dmax dbox (CSG.dmax (CSG.dmax dxy dyz) (CSG.dmax dzx doct)))))

  ;; Battered / Sloped Rectangular Frustum along Y (`[-hh .. +hh]`, Lipschitz-corrected)
  (defn sd-frustum-box-y [px py pz bx-bot bz-bot bx-top bz-top hh]
    (let [u (CSG.dclamp 0.0 1.0 (/ (+ py hh) (* 2.0 hh)))
          bx (+ bx-bot (* u (- bx-top bx-bot)))
          bz (+ bz-bot (* u (- bz-top bz-bot)))
          dx (- (Double.abs px) bx)
          dz (- (Double.abs pz) bz)
          dy (- (Double.abs py) hh)
          slope-x (/ (Double.abs (- bx-bot bx-top)) (* 2.0 hh))
          slope-z (/ (Double.abs (- bz-bot bz-top)) (* 2.0 hh))
          ms (CSG.dmax slope-x slope-z)
          lip (/ 1.0 (Double.sqrt (+ 1.0 (* ms ms))))
          h-dist (* (CSG.dmax dx dz) lip)
          ox (CSG.dmax (* dx lip) 0.0)
          oy (CSG.dmax dy 0.0)
          oz (CSG.dmax (* dz lip) 0.0)]
      (+ (CSG.len3 ox oy oz) (CSG.dmin (CSG.dmax h-dist dy) 0.0))))

  ;; Exact Capped Cylinders along Y, X, Z
  (defn sd-cyl-y [px py pz r hh]
    (let [dr (- (CSG.len2 px pz) r)
          dy (- (Double.abs py) hh)]
      (+ (CSG.len2 (CSG.dmax dr 0.0) (CSG.dmax dy 0.0))
         (CSG.dmin (CSG.dmax dr dy) 0.0))))

  (defn sd-cyl-x [px py pz r hh]
    (CSG.sd-cyl-y py px pz r hh))

  (defn sd-cyl-z [px py pz r hh]
    (CSG.sd-cyl-y px pz py r hh))

  ;; Tapered Capped Cone / Frustum along Y (`[-hh .. +hh]`, `r1` at `-hh`, `r2` at `+hh`)
  (defn sd-capped-cone-y [px py pz r1 r2 hh]
    (let [q-x (CSG.len2 px pz)
          q-y py
          k2-x (- r2 r1)
          k2-y (* 2.0 hh)
          ca-x (- q-x (if (< q-y 0.0) r1 r2))
          ca-y (- (Double.abs q-y) hh)
          denom (+ (* k2-x k2-x) (* k2-y k2-y))
          t (CSG.dclamp 0.0 1.0 (/ (+ (* (- r1 q-x) k2-x) (* (- hh q-y) k2-y)) denom))
          cb-x (+ (- q-x r1) (* t k2-x))
          cb-y (- (+ q-y hh) (* t k2-y))
          s (if (and (< cb-x 0.0) (< ca-y 0.0)) -1.0 1.0)
          d2 (CSG.dmin (+ (* ca-x ca-x) (* ca-y ca-y))
                       (+ (* cb-x cb-x) (* cb-y cb-y)))]
      (* s (Double.sqrt d2))))

  ;; Exact Torus Rings around Y, Z, X axes (`major-r` ring radius, `minor-r` tube radius)
  (defn sd-torus-y [px py pz major-r minor-r]
    (let [qx (- (CSG.len2 px pz) major-r)]
      (- (CSG.len2 qx py) minor-r)))

  (defn sd-torus-z [px py pz major-r minor-r]
    (let [qx (- (CSG.len2 px py) major-r)]
      (- (CSG.len2 qx pz) minor-r)))

  (defn sd-torus-x [px py pz major-r minor-r]
    (let [qx (- (CSG.len2 py pz) major-r)]
      (- (CSG.len2 qx px) minor-r)))

  ;; Arbitrary 3D Capsule / Strut / Sloped Pipe Bore (`A -> B` with uniform radius `r`)
  (defn sd-capsule [px py pz ax ay az bx by bz r]
    (let [pax (- px ax) pay (- py ay) paz (- pz az)
          bax (- bx ax) bay (- by ay) baz (- bz az)
          b2 (+ (+ (* bax bax) (* bay bay)) (* baz baz))
          h (if (< b2 0.00001)
              0.0
              (CSG.dclamp 0.0 1.0 (/ (+ (+ (* pax bax) (* pay bay)) (* paz baz)) b2)))]
      (- (CSG.len3 (- pax (* bax h)) (- pay (* bay h)) (- paz (* baz h))) r)))

  ;; Tapered 3D Organic Limb / Trunk / Root / Stalactite (`A` radius `ra` -> `B` radius `rb`, Lipschitz-corrected)
  (defn sd-tapered-capsule [px py pz ax ay az bx by bz ra rb]
    (let [pax (- px ax) pay (- py ay) paz (- pz az)
          bax (- bx ax) bay (- by ay) baz (- bz az)
          b2 (+ (+ (* bax bax) (* bay bay)) (* baz baz))]
      (if (< b2 0.00001)
        (- (CSG.len3 pax pay paz) (CSG.dmax ra rb))
        (let [h (CSG.dclamp 0.0 1.0 (/ (+ (+ (* pax bax) (* pay bay)) (* paz baz)) b2))
              rh (+ ra (* h (- rb ra)))
              dr (Double.abs (- rb ra))
              lip (/ 1.0 (Double.sqrt (+ 1.0 (/ (* dr dr) b2))))]
          (* (- (CSG.len3 (- pax (* bax h)) (- pay (* bay h)) (- paz (* baz h))) rh) lip)))))

  ;; Lipschitz-Exact Octahedron (`1 / sqrt(3) = 0.57735027`)
  (defn sd-octahedron [px py pz s]
    (* (- (+ (+ (Double.abs px) (Double.abs py)) (Double.abs pz)) s) 0.57735027))

  ;; --- Domain Folding, Rotations, Twists & Organic Sways ---

  (defn rot90-x [px pz rot]
    (let [r (Int.mod rot 4)]
      (if (= r 0) px
      (if (= r 1) (- 0.0 pz)
      (if (= r 2) (- 0.0 px)
                  pz)))))

  (defn rot90-z [px pz rot]
    (let [r (Int.mod rot 4)]
      (if (= r 0) pz
      (if (= r 1) px
      (if (= r 2) (- 0.0 pz)
                  (- 0.0 px))))))

  ;; 45-degree XZ Rotation (`cos 45 = sin 45 = 0.70710678`)
  (defn rot45-x [px pz]
    (* (- px pz) 0.70710678))

  (defn rot45-z [px pz]
    (* (+ px pz) 0.70710678))

  ;; Arbitrary Angle XZ Rotation (`cos a`, `sin a`)
  (defn rot-xz-x [px pz ca sa]
    (- (* px ca) (* pz sa)))

  (defn rot-xz-z [px pz ca sa]
    (+ (* px sa) (* pz ca)))

  ;; D4 Octant Fold (`0 <= z <= x` in XZ plane: 1 corner feature stamps all 4 corners / 8 walls!)
  (defn dom-octant-x [px pz]
    (let [ax (Double.abs px)
          az (Double.abs pz)]
      (CSG.dmax ax az)))

  (defn dom-octant-z [px pz]
    (let [ax (Double.abs px)
          az (Double.abs pz)]
      (CSG.dmin ax az)))

  ;; N-Fold Polar Wedge Fold in XZ (`polar-r` = outward along wedge center, `polar-t` = signed tangential offset)
  (defn polar-r [px pz n]
    (let [r (CSG.len2 px pz)]
      (if (< r 0.0001)
        0.0
        (let [ang (Double.atan2 pz px)
              sec (/ 6.283185307179586 (Double.from-int n))
              half-s (* 0.5 sec)
              idx (Double.floor (+ (/ ang sec) 0.5))
              wa (- ang (* idx sec))
              ca (if (> wa half-s) (- wa sec) (if (< wa (- 0.0 half-s)) (+ wa sec) wa))]
          (* r (Double.cos ca))))))

  (defn polar-t [px pz n]
    (let [r (CSG.len2 px pz)]
      (if (< r 0.0001)
        0.0
        (let [ang (Double.atan2 pz px)
              sec (/ 6.283185307179586 (Double.from-int n))
              half-s (* 0.5 sec)
              idx (Double.floor (+ (/ ang sec) 0.5))
              wa (- ang (* idx sec))
              ca (if (> wa half-s) (- wa sec) (if (< wa (- 0.0 half-s)) (+ wa sec) wa))]
          (* r (Double.sin ca))))))

  ;; Exact N-Sided Regular Prism (`n >= 3`, apothem `r`, half-height `hh`)
  (defn sd-ngon-prism-y [px py pz r hh n]
    (let [ur (- (CSG.polar-r px pz n) r)
          dy (- (Double.abs py) hh)]
      (+ (CSG.len2 (CSG.dmax ur 0.0) (CSG.dmax dy 0.0))
         (CSG.dmin (CSG.dmax ur dy) 0.0))))

  ;; Roman (`pinch = 0.0`) or Pointed Gothic (`pinch > 0.0`) Vaulted Arch Corridor along Z (`py = 0` is the exact flat floor!)
  (defn sd-arch-z [px py pz half-w wall-h len-z pinch]
    (let [ay (- py wall-h)
          off (* half-w (CSG.dclamp 0.0 0.90 pinch))
          arc-r (+ half-w off)
          dr-top (- (CSG.len2 (+ (Double.abs px) off) (CSG.dmax ay 0.0)) arc-r)
          d-side-top (if (< ay 0.0) (- (Double.abs px) half-w) dr-top)
          arch-2d (if (< py 0.0)
                    (CSG.len2 (CSG.dmax (- (Double.abs px) half-w) 0.0) (- 0.0 py))
                    (CSG.dmax d-side-top (- 0.0 py)))
          dz (- (Double.abs pz) len-z)]
      (+ (CSG.len2 (CSG.dmax arch-2d 0.0) (CSG.dmax dz 0.0))
         (CSG.dmin (CSG.dmax arch-2d dz) 0.0))))

  (defn sd-arch-x [px py pz half-w wall-h len-x pinch]
    (CSG.sd-arch-z pz py px half-w wall-h len-x pinch))

  ;; Bounded Quilez Repetition (`x - s * clamp(round(x / s), -cneg, cpos)`)
  (defn dom-rep-clamped [x spacing c-neg c-pos]
    (let [idx (CSG.dclamp (- 0.0 c-neg) c-pos (Double.floor (+ (/ x spacing) 0.5)))]
      (- x (* spacing idx))))

  ;; Gentle Helical Y-Twist (`|k| <= 0.10`)
  (defn dom-twist-x [px py pz k]
    (let [a (* py k)
          c (Double.cos a)
          s (Double.sin a)]
      (- (* px c) (* pz s))))

  (defn dom-twist-z [px py pz k]
    (let [a (* py k)
          c (Double.cos a)
          s (Double.sin a)]
      (+ (* px s) (* pz c))))

  ;; Gentle Sinusoidal Organic Sway (`|amp * freq| <= 0.30` keeps Lipschitz safe)
  (defn dom-sway [coord along freq amp phase]
    (+ coord (* amp (Double.sin (+ (* along freq) phase)))))

  ;; Helical Spiral Ramp SDF (`r-in .. r-out` annulus, `pitch` vertical drop per 2*pi turn,
  ;; `half-t >= 1.2m` vertical half-thickness, phase-locked so `ang == ang0` starts at `y-top` with zero feather-edge!)
  (defn sd-helix-ramp-y [px py pz r-in r-out y-bot y-top pitch half-t ang0]
    (let [r (CSG.len2 px pz)
          dr (CSG.dmax (- r-in r) (- r r-out))
          dy-cap (CSG.dmax (- y-bot py) (- py y-top))]
      (if (> (CSG.dmax dr dy-cap) 4.5)
        (CSG.dmax dr dy-cap)
        (let [ang (Double.atan2 pz px)
              u-ang (/ (- ang ang0) 6.283185307179586)
              y0 (- y-top half-t)
              target-tau (/ (- y0 py) pitch)
              m (Double.floor (+ (- target-tau u-ang) 0.5))
              tau (CSG.dmax 0.0 (+ u-ang m))
              y-near (- y0 (* tau pitch))
              dy-hel (- (Double.abs (- py y-near)) half-t)
              r-eff (CSG.dmax r r-in)
              slope (/ pitch (* 6.283185307179586 r-eff))
              lip (/ 1.0 (Double.sqrt (+ 1.0 (* slope slope))))
              dh (* dy-hel lip)]
          (CSG.dmax dh (CSG.dmax dr dy-cap))))))

  ;; --- Boolean, Chamfer, Smooth & Relief Combinators ---

  (defn op-union [a b] (CSG.dmin a b))
  (defn op-sub [d-base d-cut] (CSG.dmax d-base (- 0.0 d-cut)))
  (defn op-isect [a b] (CSG.dmax a b))

  (defn op-shell [d thickness]
    (- (Double.abs d) thickness))

  (defn op-chamfer-union [a b ch]
    (CSG.dmin (CSG.dmin a b) (* (+ (- a ch) b) 0.70710678)))

  (defn op-chamfer-sub [d-base d-cut ch]
    (CSG.op-isect (CSG.dmax d-base (- 0.0 d-cut))
                  (* (- (+ d-base ch) d-cut) 0.70710678)))

  (defn op-smooth-union [a b k]
    (let [h (/ (CSG.dmax (- k (Double.abs (- a b))) 0.0) k)]
      (- (CSG.dmin a b) (* (* (* h h) k) 0.25))))

  (defn op-smooth-sub [d-base d-cut k]
    (let [nb (- 0.0 d-cut)
          h (/ (CSG.dmax (- k (Double.abs (- d-base nb))) 0.0) k)]
      (+ (CSG.dmax d-base nb) (* (* (* h h) k) 0.25))))

  ;; Organic Cupped Toadstool / Umbrella Cap centered at `(0,0,0)` (`cap-r`, `cap-h`)
  (defn sd-cupped-cap-y [px py pz cap-r cap-h]
    (let [dome (CSG.sd-ellipsoid px py pz cap-r cap-h cap-r)
          flat-bot (CSG.dmax dome (- (* -0.32 cap-h) py))
          cup (CSG.sd-ellipsoid px (+ py (* cap-h 0.56)) pz (* cap-r 0.74) (* cap-h 0.76) (* cap-r 0.74))]
      (CSG.op-smooth-sub flat-bot cup 0.35)))

  ;; Periodic Horizontal Masonry Courses / Stepped Corbel Relief
  (defn op-corbel-y [d py period depth]
    (let [u (/ py period)
          f (- u (Double.floor u))
          tri (- 1.0 (Double.abs (- (* 2.0 f) 1.0)))]
      (+ d (* depth (- tri 0.5)))))

  ;; --- Material-Carrying (`MatSDF`) Combinators ---

  (defn m-none []
    (MatSDF.init 99.0 0.0f))

  (defn m-make [d mat]
    (MatSDF.init d mat))

  (defn m-union [a b]
    (if (<= @(MatSDF.d &a) @(MatSDF.d &b)) a b))

  (defn m-smooth-union [a b k]
    (let [da @(MatSDF.d &a)
          db @(MatSDF.d &b)
          d-sm (CSG.op-smooth-union da db k)
          m-out (if (<= da db) @(MatSDF.mat &a) @(MatSDF.mat &b))]
      (MatSDF.init d-sm m-out)))

  (defn m-sub [a d-cut]
    (MatSDF.init (CSG.op-sub @(MatSDF.d &a) d-cut) @(MatSDF.mat &a)))

  (defn m-smooth-sub [a d-cut k]
    (MatSDF.init (CSG.op-smooth-sub @(MatSDF.d &a) d-cut k) @(MatSDF.mat &a)))

  ;; --- Pressurized Pipe & U-Trap Helpers (`r-in >= 1.65m` = 3..4 voxel bore!) ---

  (defn sd-pipe-seg-wall [px py pz ax ay az bx by bz r-in wall-t]
    (let [d-out (CSG.sd-capsule px py pz ax ay az bx by bz (+ r-in wall-t))
          d-in (CSG.sd-capsule px py pz ax ay az bx by bz r-in)]
      (CSG.op-sub d-out d-in)))

  ;; Flanged Z-Axis Pipeline Wall (`r-in` bore, `wall-t` shell, periodic collars)
  (defn sd-pipe-flanged-z [px py pz len-z r-in wall-t fl-space fl-cnt]
    (let [shell (CSG.op-sub (CSG.sd-cyl-z px py pz (+ r-in wall-t) len-z)
                            (CSG.sd-cyl-z px py pz r-in (+ len-z 0.8)))
          rz (CSG.dom-rep-clamped pz fl-space fl-cnt fl-cnt)
          collar (CSG.op-sub (CSG.sd-cyl-z px py rz (+ (+ r-in wall-t) 0.52) 0.42)
                             (CSG.sd-cyl-z px py pz r-in (+ len-z 0.8)))]
      (CSG.dmin shell collar)))

  ;; Lower Semicircular U-Bend (`py <= 0` in XY plane, centered at `(0,0,0)`)
  (defn sd-utrap-wall-xy [px py pz bend-r r-in wall-t]
    (let [tor-out (CSG.sd-torus-z px py pz bend-r (+ r-in wall-t))
          tor-in (CSG.sd-torus-z px py pz bend-r r-in)
          lower-only (CSG.dmax tor-out py)]
      (CSG.op-sub lower-only tor-in)))

  (defn sd-utrap-bore-xy [px py pz bend-r r-in]
    (CSG.dmax (CSG.sd-torus-z px py pz bend-r r-in) py))
)

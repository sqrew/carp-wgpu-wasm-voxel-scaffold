(load "camera.carp")
(load "scaffold.carp")

(defmodule GLFW
  (defmodule Keycode
    (register LEFT_BRACKET Int "GLFW_KEY_LEFT_BRACKET")
    (register RIGHT_BRACKET Int "GLFW_KEY_RIGHT_BRACKET")
  )
)

(deftype Player [
  vel-y Double
  camera Camera
  on-ground Bool
  flying Bool
  current-mat Float
  current-liq Float
  current-gas Float
  edit-radius Double
  v-last Bool
  b-last Bool
  n-last Bool
  c-last Bool
  lbracket-last Bool
  rbracket-last Bool
  flashlight-on Bool
  l-last Bool
])

(defmodule Player
  (defn create [start-pos]
    (let [cam (Camera.new start-pos -90.0 0.0 1.7777777777777777)]
      (do
        (js-globals-setup)
        (Player.init 0.0 cam false true 2.0f 1.0f 1.0f 3.0 false false false false false false true false))))

  (defn handle-input! [player input dt]
    (let [prev-rad @(Player.edit-radius player)
          prev-mat @(Player.current-mat player)
          prev-liq @(Player.current-liq player)
          prev-gas @(Player.current-gas player)
          prev-fly @(Player.flying player)
          prev-light @(Player.flashlight-on player)

          c-pressed (InputManager.action-digital? input "toggle-flying")
          lbr-pressed (InputManager.action-digital? input "brush-dec")
          rbr-pressed (InputManager.action-digital? input "brush-inc")
          v-pressed (InputManager.action-digital? input "cycle-solid")
          b-pressed (InputManager.action-digital? input "cycle-gas")
          n-pressed (InputManager.action-digital? input "cycle-liquid")
          l-pressed (InputManager.action-digital? input "toggle-flashlight")
          cam (Player.camera player)]
      (do
        ;; 1. Read latest UI changes from HTML/JS via C globals
        (Pointer.set (ref-to-ptr (Player.edit-radius player)) (Double.from-float (get-js-brush-radius)))
        (Pointer.set (ref-to-ptr (Player.current-mat player)) (get-js-solid-mat))
        (Pointer.set (ref-to-ptr (Player.current-liq player)) (get-js-liq-mat))
        (Pointer.set (ref-to-ptr (Player.current-gas player)) (get-js-gas-mat))
        (Pointer.set (ref-to-ptr (Player.flying player)) (if (> (get-js-flying) 0.5f) true false))
        (Pointer.set (ref-to-ptr (Player.flashlight-on player)) (if (> (get-js-flashlight) 0.5f) true false))

        ;; 2. Toggle flying mode (C key)
        (when (and c-pressed (not @(Player.c-last player)))
          (let [p-flying (ref-to-ptr (Player.flying player))
                next-flying (not @(Player.flying player))]
            (Pointer.set p-flying next-flying)))
        (Pointer.set (ref-to-ptr (Player.c-last player)) c-pressed)

        ;; Toggle flashlight (L key)
        (when (and l-pressed (not @(Player.l-last player)))
          (let [p-light (ref-to-ptr (Player.flashlight-on player))
                next-light (not @(Player.flashlight-on player))]
            (Pointer.set p-light next-light)))
        (Pointer.set (ref-to-ptr (Player.l-last player)) l-pressed)

        ;; 3. Decrease brush radius ([ key)
        (when (and lbr-pressed (not @(Player.lbracket-last player)))
          (let [p-rad (ref-to-ptr (Player.edit-radius player))
                curr-rad @(Player.edit-radius player)
                next-rad (if (< (- curr-rad 0.5) 0.5) 0.5 (- curr-rad 0.5))]
            (Pointer.set p-rad next-rad)))
        (Pointer.set (ref-to-ptr (Player.lbracket-last player)) lbr-pressed)

        ;; 4. Increase brush radius (] key)
        (when (and rbr-pressed (not @(Player.rbracket-last player)))
          (let [p-rad (ref-to-ptr (Player.edit-radius player))
                curr-rad @(Player.edit-radius player)
                next-rad (if (> (+ curr-rad 0.5) 15.0) 15.0 (+ curr-rad 0.5))]
            (Pointer.set p-rad next-rad)))
        (Pointer.set (ref-to-ptr (Player.rbracket-last player)) rbr-pressed)

        ;; Quick presets for radius
        (when (InputManager.action-digital? input "mat-solid")
          (Pointer.set (ref-to-ptr (Player.edit-radius player)) 1.5))
        (when (InputManager.action-digital? input "mat-liquid")
          (Pointer.set (ref-to-ptr (Player.edit-radius player)) 3.0))
        (when (InputManager.action-digital? input "mat-gas")
          (Pointer.set (ref-to-ptr (Player.edit-radius player)) 6.0))

        ;; 5. Cycle solid type (V key)
        (when (and v-pressed (not @(Player.v-last player)))
          (let [curr-solid @(Player.current-mat player)
                next-solid (if (= curr-solid 1.0f) 2.0f
                             (if (= curr-solid 2.0f) 3.0f
                               (if (= curr-solid 3.0f) 4.0f
                                 (if (= curr-solid 4.0f) 5.0f 1.0f))))]
            (Pointer.set (ref-to-ptr (Player.current-mat player)) next-solid)))
        (Pointer.set (ref-to-ptr (Player.v-last player)) v-pressed)

        ;; 6. Cycle liquid type (N key)
        (when (and n-pressed (not @(Player.n-last player)))
          (let [curr-liq @(Player.current-liq player)
                next-liq (if (= curr-liq 1.0f) 2.0f
                           (if (= curr-liq 2.0f) 3.0f
                             (if (= curr-liq 3.0f) 4.0f 1.0f)))]
            (Pointer.set (ref-to-ptr (Player.current-liq player)) next-liq)))
        (Pointer.set (ref-to-ptr (Player.n-last player)) n-pressed)

        ;; 7. Cycle gas type (B key)
        (when (and b-pressed (not @(Player.b-last player)))
          (let [curr-gas @(Player.current-gas player)
                next-gas (if (= curr-gas 1.0f) 2.0f
                           (if (= curr-gas 2.0f) 3.0f
                             (if (= curr-gas 3.0f) 4.0f 1.0f)))]
            (Pointer.set (ref-to-ptr (Player.current-gas player)) next-gas)))
        (Pointer.set (ref-to-ptr (Player.b-last player)) b-pressed)

        ;; 8. If anything changed via keyboard, update C globals & sync to HTML UI
        (let [curr-rad @(Player.edit-radius player)
              curr-mat @(Player.current-mat player)
              curr-liq @(Player.current-liq player)
              curr-gas @(Player.current-gas player)
              curr-fly @(Player.flying player)
              curr-light @(Player.flashlight-on player)]
          (when (or (or (or (or (or (/= prev-rad curr-rad)
                                 (/= prev-mat curr-mat))
                             (/= prev-liq curr-liq))
                          (/= prev-gas curr-gas))
                       (/= prev-fly curr-fly))
                    (/= prev-light curr-light))
            (do
              (set-js-brush-radius (Double.to-float curr-rad))
              (set-js-solid-mat curr-mat)
              (set-js-liq-mat curr-liq)
              (set-js-gas-mat curr-gas)
              (set-js-flying (if curr-fly 1.0f 0.0f))
              (set-js-flashlight (if curr-light 1.0f 0.0f))
              (js-sync-all
                (Double.to-float curr-rad)
                curr-mat
                curr-liq
                curr-gas
                (if curr-fly 1.0f 0.0f)
                (if curr-light 1.0f 0.0f)))))

        ;; 9. Handle camera movement & look inputs
        (Camera.update-input input cam dt @(Player.flying player))
        (Camera.update-look input cam))))

  )

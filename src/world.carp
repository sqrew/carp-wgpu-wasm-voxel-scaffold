(load "Vector.carp")
(use Vector3)
(use Double)

(deftype Chunk [
  coord-x Int
  coord-y Int
  coord-z Int
  voxel-data (Array Float)
])

(deftype World [
  chunks (Array Chunk)
  voxel-resolution Int
])

(defmodule Chunk
  (defn create [qx qy qz]
    (let [res 32
          size (* res (* res (* res 4)))
          voxel-data (Array.allocate size)
          p-data (Array.unsafe-raw &voxel-data)]
      (do
        (for [z 0 res]
          (for [y 0 res]
            (for [x 0 res]
              (let [idx (+ (* z 1024) (+ (* y 32) x))
                    gx (+ (* qx 32) x)
                    gy (+ (* qy 32) y)
                    gz (+ (* qz 32) z)
                    dx (- (Float.from-int gx) 64.0f)
                    dy (- (Float.from-int gy) 32.0f)
                    dz (- (Float.from-int gz) 64.0f)
                    dist (Float.sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz)))
                    
                    ;; Large hollow sphere shell centered in the middle of the world
                    sdf (- (Float.abs (- dist 25.0f)) 2.0f)
                    mat-id 2.0f
                    offset (* idx 4)]
                (do
                  (Pointer.set (Pointer.add p-data (Long.from-int offset)) mat-id)
                  (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) sdf)
                  (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 2))) 0.0f)
                  (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 3))) 1.0f))))))
        (Chunk.init qx qy qz voxel-data))))
)

(defmodule World
  (defn create []
    (let [world-chunks []]
      (do
        (for [z 0 4]
          (for [y 0 2]
            (for [x 0 4]
              (Array.push-back! &world-chunks (Chunk.create x y z)))))
        (World.init world-chunks 32))))
)

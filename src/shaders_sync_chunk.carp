(defmodule ShadersSyncChunk
  (def sync-chunk-wgsl
"
struct Uniforms {
    chunk_offset_x: f32,
    chunk_offset_y: f32,
    chunk_offset_z: f32,
    pad: f32,
};

@group(0) @binding(0) var<storage, read> source_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> dest_chunk_buffer: array<vec4<f32>>;
@group(0) @binding(2) var<uniform> u: Uniforms;

@compute @workgroup_size(8, 8, 8)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    if (global_id.x >= 32u || global_id.y >= 32u || global_id.z >= 32u) {
        return;
    }
    
    // The dest buffer is just a flat 32x32x32 array
    let dest_idx = global_id.x + global_id.y * 32u + global_id.z * 32u * 32u;
    
    // The source buffer is a toroidal 160x160x160 array
    let gx = (u32(u.chunk_offset_x) + global_id.x) % 160u;
    let gy = (u32(u.chunk_offset_y) + global_id.y) % 160u;
    let gz = (u32(u.chunk_offset_z) + global_id.z) % 160u;
    
    let src_idx = gx + gy * 160u + gz * 160u * 160u;
    
    dest_chunk_buffer[dest_idx] = source_buffer[src_idx];
}
")
)

(def voxel-wgsl
  "struct Uniforms {
    time: f32,
    width: f32,
    height: f32,
    brush_radius: f32,
    cam_pos: vec4<f32>,
    cam_dir: vec4<f32>,
    cam_right: vec4<f32>,
    cam_up: vec4<f32>,
    sun_dir: vec4<f32>,
    hit_pos: vec4<f32>,
    edit_params: vec4<f32>,
}

@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(1) var solid_texture: texture_3d<f32>;
@group(0) @binding(2) var voxel_sampler: sampler;
@group(0) @binding(3) var liquid_texture: texture_3d<f32>;
@group(0) @binding(4) var gas_texture: texture_3d<f32>;
@group(0) @binding(5) var light_texture: texture_3d<f32>;

struct VertexOutput {
    @builtin(position) position: vec4<f32>,
    @location(0) uv: vec2<f32>,
}

@vertex
fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
    var pos: array<vec2<f32>, 3> = array<vec2<f32>, 3>(
        vec2<f32>(-1.0, -1.0),
        vec2<f32>( 3.0, -1.0),
        vec2<f32>(-1.0,  3.0),
    );
    var out: VertexOutput;
    let p = pos[vi];
    out.position = vec4<f32>(p, 0.0, 1.0);
    out.uv = (p + 1.0) * 0.5;
    return out;
}

fn intersect_box(ro: vec3<f32>, rd: vec3<f32>, box_min: vec3<f32>, box_max: vec3<f32>, t0: ptr<function, f32>, t1: ptr<function, f32>) -> bool {
    let inv_d = 1.0 / rd;
    let t_bot = inv_d * (box_min - ro);
    let t_top = inv_d * (box_max - ro);
    let t_min = min(t_bot, t_top);
    let t_max = max(t_bot, t_top);
    let t_near = max(t_min.x, max(t_min.y, t_min.z));
    let t_far = min(t_max.x, min(t_max.y, t_max.z));
    *t0 = t_near;
    *t1 = t_far;
    return t_near < t_far && t_far > 0.0;
}

fn getShadow(ro: vec3<f32>, rd: vec3<f32>, mint: f32, maxt: f32, k: f32) -> f32 {
    var res: f32 = 1.0;
    var t = mint;
    for (var i = 0; i < 40; i = i + 1) {
        let p = ro + rd * t;
        let wrapped_p = p - floor(p / 160.0) * 160.0;
        let uvw = clamp(wrapped_p / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
        let h = textureSampleLevel(solid_texture, voxel_sampler, uvw, 0.0).g * 0.5;
        if (h < 0.008) {
            return 0.0;
        }
        res = min(res, k * h / t);
        t += max(0.05, h);
        if (t > maxt) {
            break;
        }
    }
    return clamp(res, 0.2, 1.0);
}

fn getAO(p: vec3<f32>, n: vec3<f32>) -> f32 {
    var occ = 0.0;
    var sca = 1.0;
    for (var i = 0; i < 5; i = i + 1) {
        let hr = 0.05 + 0.15 * f32(i) / 4.0;
        let aopos = p + n * hr;
        let wrapped_p = aopos - floor(aopos / 160.0) * 160.0;
        let uvw = clamp(wrapped_p / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
        let d = textureSampleLevel(solid_texture, voxel_sampler, uvw, 0.0).g * 0.5;
        occ += -(d - hr) * sca;
        sca *= 0.95;
    }
    return clamp(1.0 - occ * 4.0, 0.0, 1.0);
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    let aspect = u.width / u.height;
    let uv = (in.uv * 2.0 - 1.0) * vec2<f32>(aspect, 1.0);
    
    let ro = u.cam_pos.xyz;
    let rd = normalize(u.cam_dir.xyz * 2.0 + uv.x * u.cam_right.xyz + uv.y * u.cam_up.xyz);
    
    let cx = floor(u.cam_pos.x / 32.0);
    let cy = floor(u.cam_pos.y / 32.0);
    let cz = floor(u.cam_pos.z / 32.0);
    let box_min = vec3<f32>(cx - 2.0, cy - 2.0, cz - 2.0) * 32.0;
    let box_max = box_min + 160.0;
    
    var t_near: f32 = 0.0;
    var t_far: f32 = 0.0;
    
    // Create sky gradient based on ray direction Y component and orbiting sun Y height
    let sun_h = u.sun_dir.y;
    
    // Day / Night interpolation factors
    let day_factor = clamp(sun_h * 5.0 + 0.5, 0.0, 1.0);
    let sunset_factor = clamp(1.0 - abs(sun_h) * 5.0, 0.0, 1.0);
    
    // Base sky colors
    let day_space = vec3<f32>(0.05, 0.12, 0.25);
    let day_horizon = vec3<f32>(0.2, 0.38, 0.58);
    
    let sunset_space = vec3<f32>(0.06, 0.04, 0.12);
    let sunset_horizon = vec3<f32>(0.65, 0.28, 0.12);
    
    let night_space = vec3<f32>(0.002, 0.004, 0.008);
    let night_horizon = vec3<f32>(0.01, 0.015, 0.035);
    
    let space_color = mix(mix(night_space, sunset_space, sunset_factor), day_space, day_factor);
    let horizon_color = mix(mix(night_horizon, sunset_horizon, sunset_factor), day_horizon, day_factor);
    
    let sky_dir_y = max(0.0, rd.y);
    var color = mix(space_color, horizon_color, sky_dir_y);
    
    // Add orbiting sun
    let light_dir = normalize(u.sun_dir.xyz);
    let sun_cos = dot(rd, light_dir);
    if (sun_h > -0.2 && sun_cos > 0.0) {
        let sun_fade = clamp(sun_h * 5.0 + 1.0, 0.0, 1.0);
        let sun_glow = pow(sun_cos, 120.0) * 1.5 * sun_fade;
        let sun_disk = pow(sun_cos, 1200.0) * 4.0 * sun_fade;
        color += vec3<f32>(1.0, 0.9, 0.7) * (sun_glow + sun_disk);
    }

    // Add orbiting moon in opposite direction
    let moon_dir = -light_dir;
    let moon_cos = dot(rd, moon_dir);
    if (sun_h < 0.2 && moon_cos > 0.0) {
        let moon_fade = clamp(-sun_h * 5.0 + 1.0, 0.0, 1.0);
        let moon_glow = pow(moon_cos, 160.0) * 0.4 * moon_fade;
        let moon_disk = pow(moon_cos, 2000.0) * 1.2 * moon_fade;
        color += vec3<f32>(0.7, 0.8, 1.0) * (moon_glow + moon_disk);
    }
    
    if (intersect_box(ro, rd, box_min, box_max, &t_near, &t_far)) {
        let t_start = max(t_near, 0.0);
        var t = t_start;
        var hit = false;
        var hit_color = vec3<f32>(0.0);
        var accum_color = vec3<f32>(0.0);
        var accum_alpha: f32 = 0.0;
        
        for (var step = 0; step < 128; step = step + 1) {
            if (t > t_far) {
                break;
            }
            let p = ro + rd * t;
            
            // Clamp normalized coordinates slightly inside [0, 1] to avoid border interpolation artifacts
            let wrapped_p = p - floor(p / 160.0) * 160.0;
            let uvw = clamp(wrapped_p / 160.0, vec3<f32>(0.002), vec3<f32>(0.998));
            
            // Sample SDF value from green channel (G) and scale by 0.5 (Lipschitz constant bound for Simplex noise)
            let val = textureSampleLevel(solid_texture, voxel_sampler, uvw, 0.0);
            let dist = val.g * 0.5;
            
            // Accumulate Fluids and Gases
            let liq_val = textureSampleLevel(liquid_texture, voxel_sampler, uvw, 0.0);
            if (liq_val.g > 0.05) {
                var liq_color = vec3<f32>(0.1, 0.4, 0.8); // Default Water
                var absorb = 2.0;
                let id = round(liq_val.r);
                if (id == 2.0) {
                    liq_color = vec3<f32>(1.0, 0.3, 0.0); // Lava
                    absorb = 5.0;
                } else if (id == 3.0) {
                    liq_color = vec3<f32>(0.15, 0.85, 0.25); // Acid (green)
                    absorb = 3.0;
                } else if (id == 4.0) {
                    liq_color = vec3<f32>(0.35, 0.25, 0.1); // Oil (dark yellow/brown)
                    absorb = 4.5;
                }
                let step_size = max(0.008, dist);
                let alpha = 1.0 - exp(-liq_val.g * step_size * absorb);
                accum_color = mix(accum_color, liq_color, alpha * (1.0 - accum_alpha));
                accum_alpha = accum_alpha + alpha * (1.0 - accum_alpha);
            }

            let gas_val = textureSampleLevel(gas_texture, voxel_sampler, uvw, 0.0);
            if (gas_val.g > 0.05) {
                var gas_color = vec3<f32>(0.7, 0.7, 0.75); // Steam
                var absorb = 0.8;
                let id = round(gas_val.r);
                if (id == 2.0) {
                    gas_color = vec3<f32>(0.4, 0.9, 0.1); // Toxic Gas
                    absorb = 1.2;
                } else if (id == 3.0) {
                    let flicker = sin(u.time * 15.0 + dot(uvw, vec3<f32>(100.0))) * 0.15 + 0.85;
                    gas_color = vec3<f32>(1.0, 0.35 * flicker, 0.0); // Fire
                    absorb = 2.0 * flicker;
                } else if (id == 4.0) {
                    gas_color = vec3<f32>(0.15, 0.15, 0.15); // Smoke
                    absorb = 1.8;
                }
                let step_size = max(0.008, dist);
                let alpha = (1.0 - exp(-gas_val.g * step_size * absorb)) * 0.4;
                accum_color = mix(accum_color, gas_color, alpha * (1.0 - accum_alpha));
                accum_alpha = accum_alpha + alpha * (1.0 - accum_alpha);
            }
            
            if (dist < 0.008) {
                // Hit! Calculate normals using finite differences
                let eps = 0.5;
                let n = vec3<f32>(
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p + vec3<f32>(eps, 0.0, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g - 
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p - vec3<f32>(eps, 0.0, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g,
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p + vec3<f32>(0.0, eps, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g - 
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p - vec3<f32>(0.0, eps, 0.0), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g,
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p + vec3<f32>(0.0, 0.0, eps), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g - 
                    textureSampleLevel(solid_texture, voxel_sampler, clamp(wrapped_p - vec3<f32>(0.0, 0.0, eps), vec3<f32>(0.0), vec3<f32>(160.0))/160.0, 0.0).g
                );
                let normal = normalize(n);
                
                // Fetch discrete material ID using textureLoad at the nearest integer coordinate (avoids trilinear bleeding!)
                let ip = vec3<i32>(clamp(wrapped_p, vec3<f32>(0.0), vec3<f32>(159.0)));
                let raw_voxel = textureLoad(solid_texture, ip, 0);
                let mat_id = raw_voxel.r;
                
                // Color based on material ID
                var base_color = vec3<f32>(0.3, 0.3, 0.3);
                let id = round(mat_id);
                if (id == 1.0) {
                    base_color = vec3<f32>(0.45, 0.45, 0.45); // Stone
                } else if (id == 2.0) {
                    base_color = vec3<f32>(0.2, 0.6, 0.25);   // Grass / Soil
                } else if (id == 3.0) {
                    base_color = vec3<f32>(0.5, 0.3, 0.15);   // Wood
                } else if (id == 4.0) {
                    base_color = vec3<f32>(0.1, 0.1, 0.1);    // Coal
                } else if (id == 5.0) {
                    base_color = vec3<f32>(0.95, 0.75, 0.15);  // Gold
                }
                
                let light_dir = normalize(u.sun_dir.xyz);
                let sun_intensity = clamp(u.sun_dir.y * 4.0, 0.0, 1.0);
                let diffuse = max(dot(normal, light_dir), 0.0);
                
                // Raymarched Shadows (only computed when sun is above horizon!)
                var sha: f32 = 1.0;
                if (sun_intensity > 0.0) {
                    let shadow_pos = p + normal * 0.05;
                    sha = getShadow(shadow_pos, light_dir, 0.05, 40.0, 16.0);
                }
                
                // Moon light (faint blue direct light at night)
                let moon_dir = -light_dir;
                let moon_intensity = clamp(-u.sun_dir.y * 4.0, 0.0, 1.0) * 0.15;
                let moon_diffuse = max(dot(normal, moon_dir), 0.0);
                let moon_light = vec3<f32>(0.7, 0.8, 1.0) * moon_diffuse * moon_intensity;
                
                // Ambient Occlusion
                let ao = getAO(p, normal);
                
                // Blend ambient sunlight and night sky ambient
                let ambient_intensity = clamp(u.sun_dir.y * 3.0 + 0.3, 0.05, 1.0);
                
                // Combine Shading with Light Texture
                let light_val = textureSampleLevel(light_texture, voxel_sampler, uvw, 0.0) + vec4<f32>(0.0, 0.0, 0.0, 1.0);
                let ambient = vec3<f32>(0.1, 0.12, 0.2) * ao * light_val.a * ambient_intensity;
                let direct = vec3<f32>(1.0, 0.95, 0.85) * diffuse * sha * light_val.a * sun_intensity;
                let block_light = light_val.rgb;
                
                // Player Ambient Glow (spherical light source centered on player)
                var player_glow = vec3<f32>(0.0);
                if (u.cam_pos.w > 0.5) {
                    let attenuation = 1.0 / (1.0 + 0.05 * t + 0.012 * t * t);
                    player_glow = vec3<f32>(1.0, 0.96, 0.88) * attenuation * 2.5;
                }
                
                let solid_col = base_color * (direct + ambient + moon_light + block_light + player_glow);
                hit_color = mix(solid_col, accum_color, accum_alpha);
                hit = true;
                break;
            }
            
            // Step forward by the SDF value, capped to prevent jumping over volumes
            t = t + clamp(dist, 0.008, 1.2);
        }
        
        if (hit) {
            // Apply linear atmospheric distance fog ending at the world box boundary (80 units)
            let fog_factor = clamp((t - 40.0) / 40.0, 0.0, 1.0);
            
            // The fog color is the horizon color mixed with the space color
            let fog_color = mix(space_color, horizon_color, max(0.0, rd.y));
            color = mix(hit_color, fog_color, fog_factor);
        } else {
            color = mix(color, accum_color, accum_alpha);
        }
    }
    
    let dummy = textureSampleLevel(liquid_texture, voxel_sampler, vec3<f32>(0.0), 0.0).r +
                textureSampleLevel(gas_texture, voxel_sampler, vec3<f32>(0.0), 0.0).r;
    return vec4<f32>(color + dummy * 0.000001, 1.0);
}
")

(def pack-wgsl
  "@group(0) @binding(0) var<storage, read>       voxel_gpu_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> voxel_half_buffer: array<vec2<u32>>;

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    let val = voxel_gpu_buffer[idx];
    let p1 = pack2x16float(val.xy);
    let p2 = pack2x16float(val.zw);

    voxel_half_buffer[idx] = vec2<u32>(p1, p2);
}
")

(def copy-wgsl
  "struct Params {
    offset_x: f32,
    offset_y: f32,
    offset_z: f32,
    _pad: f32,
}

@group(0) @binding(0) var<storage, read>       staging_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> voxel_gpu_buffer_read: array<vec4<f32>>;
@group(0) @binding(2) var<storage, read_write> voxel_gpu_buffer_write: array<vec4<f32>>;
@group(0) @binding(3) var<uniform>             p: Params;

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 32768u) { return; }

    let lx = idx % 32u;
    let ly = (idx / 32u) % 32u;
    let lz = idx / 1024u;

    let val = staging_buffer[idx];

    let ox = u32(p.offset_x);
    let oy = u32(p.offset_y);
    let oz = u32(p.offset_z);

    let gx = ox + lx;
    let gy = oy + ly;
    let gz = oz + lz;
    let g_idx = gx + gy * 160u + gz * 25600u;

    voxel_gpu_buffer_read[g_idx] = val;
    voxel_gpu_buffer_write[g_idx] = val;
}
")

(def liquid-sim-wgsl
  "struct Uniforms {
    time: f32,
    width: f32,
    height: f32,
    brush_radius: f32,
    cam_pos: vec4<f32>,
    cam_dir: vec4<f32>,
    cam_right: vec4<f32>,
    cam_up: vec4<f32>,
    sun_dir: vec4<f32>,
    hit_pos: vec4<f32>,
    edit_params: vec4<f32>,
}

struct LiquidProps {
    density: f32,
    g_rate: f32,
    l_rate: f32,
}

fn get_liq_props(id: f32) -> LiquidProps {
    let LIQ_LUT = array<LiquidProps, 5>(
        LiquidProps(0.0, 0.0, 0.0),
        LiquidProps(1.0, 0.3, 0.08),
        LiquidProps(2.0, 0.05, 0.02),
        LiquidProps(1.2, 0.15, 0.05),
        LiquidProps(0.8, 0.2, 0.06)
    );
    let idx = clamp(i32(round(id)), 0, 4);
    return LIQ_LUT[idx];
}

@group(0) @binding(0) var<storage, read>       input_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> output_buffer: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> solid_buffer: array<vec4<f32>>;
@group(0) @binding(4) var<storage, read>       chunk_lookup: array<vec4<f32>>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;

fn get_solid(p: vec3<i32>) -> vec2<f32> {
    let wrapped = (p + vec3<i32>(160)) % 160;
    let val = textureLoad(solid_texture, wrapped, 0);
    return vec2<f32>(val.r, val.g);
}

fn is_solid(p: vec3<i32>) -> bool {
    let sol = get_solid(p);
    return sol.y * 0.5 < 0.008;
}

fn get_liquid(p: vec3<i32>) -> vec2<f32> {
    let wrapped = (p + vec3<i32>(160)) % 160;
    let val = textureLoad(liquid_texture, wrapped, 0);
    return vec2<f32>(val.r, val.g);
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    // Dummy reads to prevent compiler from optimizing out unused bindings
    let dummy_val = input_buffer[0] + solid_buffer[0] + chunk_lookup[0];
    if (dummy_val.x > 999999.0) {
        output_buffer[idx] = textureLoad(gas_texture, vec3<i32>(0), 0);
    }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));

    if (is_solid(ip)) {
        output_buffer[idx] = vec4<f32>(0.0);
        return;
    }

    let self_liq = get_liquid(ip);
    let self_vol = self_liq.y;
    var next_id = self_liq.x;
    var next_vol = self_vol;

    let self_props = get_liq_props(self_liq.x);

    let below_p = ip + vec3<i32>(0, -1, 0);
    let above_p = ip + vec3<i32>(0, 1, 0);

    let neighbors = array<vec3<i32>, 4>(
        vec3<i32>(-1, 0, 0),
        vec3<i32>(1, 0, 0),
        vec3<i32>(0, 0, -1),
        vec3<i32>(0, 0, 1)
    );

    // --- 1. Density Buoyancy Swapping (1-to-1 parity matching) ---
    var swapped = false;
    let frame_step = i32(u.time) % 2;
    let is_even_pair = (ip.y % 2) == frame_step;

    if (self_vol > 0.05) {
        if (is_even_pair) {
            // Look down
            if (ip.y > 0 && !is_solid(below_p)) {
                let below = get_liquid(below_p);
                let below_props = get_liq_props(below.x);
                if (below.y > 0.05 && self_props.density > below_props.density) {
                    next_id = below.x;
                    next_vol = below.y;
                    swapped = true;
                }
            }
        } else {
            // Look up
            if (ip.y < 159 && !is_solid(above_p)) {
                let above = get_liquid(above_p);
                let above_props = get_liq_props(above.x);
                if (above.y > 0.05 && above_props.density > self_props.density) {
                    next_id = above.x;
                    next_vol = above.y;
                    swapped = true;
                }
            }
        }
    }

    // --- 2. Gravity & Lateral Flow (only calculated if not swapped) ---
    var net_flow = 0.0;
    var max_inflow = 0.0;

    if (!swapped) {
        let g_rate = self_props.g_rate;
        let l_rate = self_props.l_rate;

        // Downward gravity flow
        if (!is_solid(below_p)) {
            let below = get_liquid(below_p);
            let below_props = get_liq_props(below.x);
            if (below.y <= 0.05 || self_props.density >= below_props.density) {
                let flow_out = min(self_vol, max(0.0, 1.0 - below.y)) * g_rate;
                net_flow -= flow_out;
            }
        }
        if (!is_solid(above_p)) {
            let above = get_liquid(above_p);
            let above_props = get_liq_props(above.x);
            if (self_vol <= 0.05 || above_props.density >= self_props.density) {
                let flow_in = min(above.y, max(0.0, 1.0 - self_vol)) * above_props.g_rate;
                net_flow += flow_in;
                if (flow_in > max_inflow) {
                    max_inflow = flow_in;
                    next_id = above.x;
                }
            }
        }

        // Lateral flow
        for (var i = 0; i < 4; i = i + 1) {
            let np = ip + neighbors[i];
            if (!is_solid(np)) {
                let n_liq = get_liquid(np);
                let n_props = get_liq_props(n_liq.x);
                if (self_vol > n_liq.y && (n_liq.y <= 0.05 || self_props.density >= n_props.density)) {
                    let flow_out = (self_vol - n_liq.y) * l_rate;
                    net_flow -= flow_out;
                }
                if (n_liq.y > self_vol && (self_vol <= 0.05 || n_props.density >= self_props.density)) {
                    let flow_in = (n_liq.y - self_vol) * n_props.l_rate;
                    net_flow += flow_in;
                    if (flow_in > max_inflow) {
                        max_inflow = flow_in;
                        next_id = n_liq.x;
                    }
                }
            }
        }

        next_vol = next_vol + net_flow;
    }

    // --- 3. Spawn liquid if click is active ---
    if (u.hit_pos.w > 0.5) {
        let dist = distance(vec3<f32>(ip), u.hit_pos.xyz);
        if (dist <= u.brush_radius && u.edit_params.x > 0.5) {
            next_id = u.edit_params.x;
            next_vol = min(1.0, next_vol + u.edit_params.y);
        }
    }

    // --- 4. Multi-Phase Reactions ---
    var react_empty = false;
    let below_liq = get_liquid(below_p);
    let above_liq = get_liquid(above_p);
    if (next_vol > 0.05) {
        if (next_id == 1.0) { // Water
            for (var i = 0; i < 4; i = i + 1) {
                let n_liq = get_liquid(ip + neighbors[i]);
                if (n_liq.y > 0.05 && n_liq.x == 2.0) { react_empty = true; break; }
            }
            if (below_liq.y > 0.05 && below_liq.x == 2.0) { react_empty = true; }
            if (above_liq.y > 0.05 && above_liq.x == 2.0) { react_empty = true; }
        } else if (next_id == 2.0) { // Lava
            // React with Water
            for (var i = 0; i < 4; i = i + 1) {
                let n_liq = get_liquid(ip + neighbors[i]);
                if (n_liq.y > 0.05 && n_liq.x == 1.0) { react_empty = true; break; }
            }
            if (below_liq.y > 0.05 && below_liq.x == 1.0) { react_empty = true; }
            if (above_liq.y > 0.05 && above_liq.x == 1.0) { react_empty = true; }

            // React with Oil
            for (var i = 0; i < 4; i = i + 1) {
                let n_liq = get_liquid(ip + neighbors[i]);
                if (n_liq.y > 0.05 && n_liq.x == 4.0) { react_empty = true; break; }
            }
            if (below_liq.y > 0.05 && below_liq.x == 4.0) { react_empty = true; }
            if (above_liq.y > 0.05 && above_liq.x == 4.0) { react_empty = true; }
        } else if (next_id == 3.0) { // Acid
            var touches_water = false;
            for (var i = 0; i < 4; i = i + 1) {
                let n_liq = get_liquid(ip + neighbors[i]);
                if (n_liq.y > 0.05 && n_liq.x == 1.0) { touches_water = true; break; }
            }
            if (below_liq.y > 0.05 && below_liq.x == 1.0) { touches_water = true; }
            if (above_liq.y > 0.05 && above_liq.x == 1.0) { touches_water = true; }

            if (touches_water) {
                next_id = 1.0; // Dilutes to Water
            } else {
                var dissolved_solid = false;
                let dirs = array<vec3<i32>, 6>(
                    vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
                    vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
                    vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
                );
                for (var i = 0; i < 6; i = i + 1) {
                    let sp = ip + dirs[i];
                    if (sp.x >= 0 && sp.x < 160 && sp.y >= 0 && sp.y < 160 && sp.z >= 0 && sp.z < 160) {
                        let sol = get_solid(sp);
                        let is_sol_block = sol.y * 0.5 < 0.008;
                        let sol_id = sol.x;
                        if (is_sol_block) {
                            if (sol_id == 2.0 || sol_id == 3.0) { // Grass/Wood
                                dissolved_solid = true;
                                let s_idx = u32(sp.x) + u32(sp.y) * 160u + u32(sp.z) * 25600u;
                                solid_buffer[s_idx] = vec4<f32>(0.0, 1.0, 0.0, 0.0);
                                break;
                            } else if (sol_id == 1.0) { // Stone
                                let rand_val = fract(sin(dot(vec3<f32>(ip) + vec3<f32>(u.time), vec3<f32>(12.9898, 78.233, 45.164))) * 43758.5453);
                                if (rand_val < 0.02) { // 2% chance
                                    dissolved_solid = true;
                                    let s_idx = u32(sp.x) + u32(sp.y) * 160u + u32(sp.z) * 25600u;
                                    solid_buffer[s_idx] = vec4<f32>(0.0, 1.0, 0.0, 0.0);
                                    break;
                                }
                            }
                        }
                    }
                }
                if (dissolved_solid) {
                    react_empty = true;
                }
            }
        } else if (next_id == 4.0) { // Oil
            // Burned by Lava
            for (var i = 0; i < 4; i = i + 1) {
                let n_liq = get_liquid(ip + neighbors[i]);
                if (n_liq.y > 0.05 && n_liq.x == 2.0) { react_empty = true; break; }
            }
            if (below_liq.y > 0.05 && below_liq.x == 2.0) { react_empty = true; }
            if (above_liq.y > 0.05 && above_liq.x == 2.0) { react_empty = true; }
        }
    }

    if (react_empty) {
        next_vol = 0.0;
        next_id = 0.0;
        // Turn into Solid Stone if it was a Lava/Water collision
        if (self_liq.x == 1.0 || self_liq.x == 2.0) {
            solid_buffer[idx] = vec4<f32>(1.0, -1.0, 0.0, 0.0);
        }
    }

    // --- 5. Evaporate and clamp ---
    if (next_vol < 0.01) {
        next_vol = 0.0;
        next_id = 0.0;
    }
    
    next_vol = clamp(next_vol, 0.0, 1.0);
    if (next_vol == 0.0) {
        next_id = 0.0;
    }

    output_buffer[idx] = vec4<f32>(next_id, next_vol, 0.0, 0.0);
}
")

(def gas-sim-wgsl
  "struct Uniforms {
    time: f32,
    width: f32,
    height: f32,
    brush_radius: f32,
    cam_pos: vec4<f32>,
    cam_dir: vec4<f32>,
    cam_right: vec4<f32>,
    cam_up: vec4<f32>,
    sun_dir: vec4<f32>,
    hit_pos: vec4<f32>,
    edit_params: vec4<f32>,
}

struct GasProps {
    g_rate: f32,
    l_rate: f32,
    decay: f32,
}

fn get_gas_props(id: f32) -> GasProps {
    let GAS_LUT = array<GasProps, 5>(
        GasProps(0.0, 0.0, 0.0),
        GasProps(0.4, 0.1, 0.05),
        GasProps(0.15, 0.05, 0.01),
        GasProps(0.25, 0.08, 0.08),
        GasProps(0.2, 0.04, 0.04)
    );
    let idx = clamp(i32(round(id)), 0, 4);
    return GAS_LUT[idx];
}

@group(0) @binding(0) var<storage, read>       input_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> output_buffer: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read>       chunk_info: array<vec4<f32>>;
@group(0) @binding(4) var<storage, read>       chunk_lookup: array<vec4<f32>>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;

fn get_solid(p: vec3<i32>) -> vec2<f32> {
    let wrapped = (p + vec3<i32>(160)) % 160;
    let val = textureLoad(solid_texture, wrapped, 0);
    return vec2<f32>(val.r, val.g);
}

fn is_solid(p: vec3<i32>) -> bool {
    let sol = get_solid(p);
    return sol.y * 0.5 < 0.008;
}

fn get_gas(p: vec3<i32>) -> vec2<f32> {
    let wrapped = (p + vec3<i32>(160)) % 160;
    let val = textureLoad(gas_texture, wrapped, 0);
    return vec2<f32>(val.r, val.g);
}

fn get_liquid(p: vec3<i32>) -> vec2<f32> {
    let wrapped = (p + vec3<i32>(160)) % 160;
    let val = textureLoad(liquid_texture, wrapped, 0);
    return vec2<f32>(val.r, val.g);
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    // Dummy reads to prevent compiler from optimizing out unused bindings
    let dummy_val = input_buffer[0] + chunk_info[0] + chunk_lookup[0];
    if (dummy_val.x > 999999.0) {
        output_buffer[idx] = textureLoad(liquid_texture, vec3<i32>(0), 0);
    }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));

    if (is_solid(ip)) {
        output_buffer[idx] = vec4<f32>(0.0);
        return;
    }

    let self_gas = get_gas(ip);
    let self_vol = self_gas.y;
    var next_id = self_gas.x;
    var next_vol = self_vol;

    let below_p = ip + vec3<i32>(0, -1, 0);
    let above_p = ip + vec3<i32>(0, 1, 0);

    let neighbors = array<vec3<i32>, 4>(
        vec3<i32>(-1, 0, 0),
        vec3<i32>(1, 0, 0),
        vec3<i32>(0, 0, -1),
        vec3<i32>(0, 0, 1)
    );

    let self_props = get_gas_props(self_gas.x);
    let g_rate = self_props.g_rate;
    let l_rate = self_props.l_rate;

    var net_flow = 0.0;
    var max_inflow = 0.0;

    // --- 1. Upward rising flow ---
    // Flow out to above
    if (!is_solid(above_p)) {
        let above = get_gas(above_p);
        let flow_out = min(self_vol, max(0.0, 1.0 - above.y)) * g_rate;
        net_flow -= flow_out;
    }
    // Flow in from below
    if (!is_solid(below_p)) {
        let below = get_gas(below_p);
        let below_props = get_gas_props(below.x);
        let flow_in = min(below.y, max(0.0, 1.0 - self_vol)) * below_props.g_rate;
        net_flow += flow_in;
        if (flow_in > max_inflow) {
            max_inflow = flow_in;
            next_id = below.x;
        }
    }

    // --- 2. Lateral flow ---
    for (var i = 0; i < 4; i = i + 1) {
        let np = ip + neighbors[i];
        if (!is_solid(np)) {
            let n_gas = get_gas(np);
            let n_props = get_gas_props(n_gas.x);
            // Flow out to neighbor if we have more
            if (self_vol > n_gas.y) {
                let flow_out = (self_vol - n_gas.y) * l_rate;
                net_flow -= flow_out;
            }
            // Flow in from neighbor if it has more
            if (n_gas.y > self_vol) {
                let flow_in = (n_gas.y - self_vol) * n_props.l_rate;
                net_flow += flow_in;
                if (flow_in > max_inflow) {
                    max_inflow = flow_in;
                    next_id = n_gas.x;
                }
            }
        }
    }

    next_vol = next_vol + net_flow;

    // --- 3. Spawn gas if click is active ---
    if (u.hit_pos.w > 0.5) {
        let dist = distance(vec3<f32>(ip), u.hit_pos.xyz);
        if (dist <= u.brush_radius && u.edit_params.z > 0.5) {
            next_id = u.edit_params.z;
            next_vol = min(1.0, next_vol + u.edit_params.w);
        }
    }

    // --- 4. Multi-Phase Gas Reactions ---
    var spawn_gas_id = 0.0;
    var spawn_gas_vol = 0.0;

    let my_liq = get_liquid(ip);
    let below_liq = get_liquid(below_p);
    let above_liq = get_liquid(above_p);
    if (my_liq.y > 0.05) {
        if (my_liq.x == 1.0) { // Water
            for (var i = 0; i < 4; i = i + 1) {
                let n_liq = get_liquid(ip + neighbors[i]);
                if (n_liq.y > 0.05 && n_liq.x == 2.0) { spawn_gas_id = 1.0; spawn_gas_vol = 1.0; break; }
            }
            if (below_liq.y > 0.05 && below_liq.x == 2.0) { spawn_gas_id = 1.0; spawn_gas_vol = 1.0; }
            if (above_liq.y > 0.05 && above_liq.x == 2.0) { spawn_gas_id = 1.0; spawn_gas_vol = 1.0; }
        } else if (my_liq.x == 2.0) { // Lava
            // Steam
            for (var i = 0; i < 4; i = i + 1) {
                let n_liq = get_liquid(ip + neighbors[i]);
                if (n_liq.y > 0.05 && n_liq.x == 1.0) { spawn_gas_id = 1.0; spawn_gas_vol = 1.0; break; }
            }
            if (below_liq.y > 0.05 && below_liq.x == 1.0) { spawn_gas_id = 1.0; spawn_gas_vol = 1.0; }
            if (above_liq.y > 0.05 && above_liq.x == 1.0) { spawn_gas_id = 1.0; spawn_gas_vol = 1.0; }
            
            // Fire/Smoke from Lava + Oil
            for (var i = 0; i < 4; i = i + 1) {
                let n_liq = get_liquid(ip + neighbors[i]);
                if (n_liq.y > 0.05 && n_liq.x == 4.0) { spawn_gas_id = 3.0; spawn_gas_vol = 1.0; break; }
            }
            if (below_liq.y > 0.05 && below_liq.x == 4.0) { spawn_gas_id = 3.0; spawn_gas_vol = 1.0; }
            if (above_liq.y > 0.05 && above_liq.x == 4.0) { spawn_gas_id = 3.0; spawn_gas_vol = 1.0; }
            
            // Fire/Smoke from Lava + Wood (Solid 3)
            for (var i = 0; i < 4; i = i + 1) {
                let sol = get_solid(ip + neighbors[i]);
                let is_sol_block = sol.y * 0.5 < 0.008;
                if (is_sol_block && sol.x == 3.0) { spawn_gas_id = 3.0; spawn_gas_vol = 1.0; break; }
            }
            let below_sol = get_solid(below_p);
            if (below_sol.y * 0.5 < 0.008 && below_sol.x == 3.0) { spawn_gas_id = 3.0; spawn_gas_vol = 1.0; }
            let above_sol = get_solid(above_p);
            if (above_sol.y * 0.5 < 0.008 && above_sol.x == 3.0) { spawn_gas_id = 3.0; spawn_gas_vol = 1.0; }
        } else if (my_liq.x == 3.0) { // Acid
            // Toxic Gas from Acid + Grass/Wood/Stone
            var acid_react = false;
            for (var i = 0; i < 4; i = i + 1) {
                let sol = get_solid(ip + neighbors[i]);
                if (sol.y * 0.5 < 0.008 && (sol.x == 1.0 || sol.x == 2.0 || sol.x == 3.0)) { acid_react = true; break; }
            }
            let below_sol = get_solid(below_p);
            if (below_sol.y * 0.5 < 0.008 && (below_sol.x == 1.0 || below_sol.x == 2.0 || below_sol.x == 3.0)) { acid_react = true; }
            let above_sol = get_solid(above_p);
            if (above_sol.y * 0.5 < 0.008 && (above_sol.x == 1.0 || above_sol.x == 2.0 || above_sol.x == 3.0)) { acid_react = true; }
            
            if (acid_react) {
                spawn_gas_id = 2.0; // Toxic Gas
                spawn_gas_vol = 1.0;
            }
        }
    }

    // Fire + Water ➔ Steam
    if (next_id == 3.0 && next_vol > 0.05) {
        var touches_water = false;
        if (my_liq.y > 0.05 && my_liq.x == 1.0) { touches_water = true; }
        for (var i = 0; i < 4; i = i + 1) {
            let n_liq = get_liquid(ip + neighbors[i]);
            if (n_liq.y > 0.05 && n_liq.x == 1.0) { touches_water = true; break; }
        }
        let below_liq = get_liquid(below_p);
        if (below_liq.y > 0.05 && below_liq.x == 1.0) { touches_water = true; }
        let above_liq = get_liquid(above_p);
        if (above_liq.y > 0.05 && above_liq.x == 1.0) { touches_water = true; }
        
        if (touches_water) {
            next_id = 1.0; // Steam
            next_vol = 0.5;
        }
    }

    if (spawn_gas_vol > 0.0) {
        next_id = spawn_gas_id;
        next_vol = min(1.0, next_vol + spawn_gas_vol);
    }

    // --- 5. Evaporate, decay and clamp ---
    let next_props = get_gas_props(next_id);
    next_vol = max(0.0, next_vol - next_props.decay);

    if (next_vol < 0.01) {
        next_vol = 0.0;
        next_id = 0.0;
    }
    
    next_vol = clamp(next_vol, 0.0, 1.0);
    if (next_vol == 0.0) {
        next_id = 0.0;
    }

    output_buffer[idx] = vec4<f32>(next_id, next_vol, 0.0, 0.0);
}
")

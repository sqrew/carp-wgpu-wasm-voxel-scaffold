(load "Vector.carp")
(load "input.carp")
(load "glfw_backend.carp")
(load "scaffold.carp")
(load "camera.carp")
(load "world.carp")
(load "physics.carp")
(load "ecs_world.carp")
(load "gpu_batcher.carp")
(load "shaders.carp")
(load "renderer.carp")
(load "engine.carp")
(load "../../carp-gametime/gametime.carp")
(use Clock)
(load "../../carp-job-system/rayon.carp")
(use Vector3)
(use Double)

(defn main []
  (let [win-width 640
        win-height 360]
    (match (EngineState.create "Carp WebGPU WASM Voxel Scaffold" win-width win-height)
      (Result.Error e) (do (println* "Engine failed: " &e) -1)
      (Result.Success state)
        (let [_ (EngineState.register-handlers! &state)
              _2 (EngineState.register-inputs! &state)
              win @(M-GLFWWindow.p (Engine.win (EngineState.eng &state)))
              last-time (GLFW.get-time)
               ]
          (do
            ; Enable camera capture (mouse lock)
            (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED)
            
            (let [clock (Clock.new)
                  fixed-dt (/ 1.0 60.0)
                  accumulator 0.0]
              (while (= (GLFW.window-should-close win) GLFW.FALSE)
                (do
                  (Clock.tick! &clock)
                  (set! accumulator (+ accumulator (Clock.clamped-dt &clock)))
                  (while (>= accumulator fixed-dt)
                    (do
                      (EngineState.tick-update! &state win fixed-dt)
                      (set! accumulator (- accumulator fixed-dt))))
                  (EngineState.tick-render! &state win)
                  (emscripten-sleep 16))))
            
            0)))))

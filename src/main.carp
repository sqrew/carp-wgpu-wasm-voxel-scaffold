(load "Vector.carp")
(load "input.carp")
(load "glfw_backend.carp")
(load "scaffold.carp")
(load "camera.carp")
(load "materials.carp")
(load "world.carp")
(load "physics.carp")
(load "ecs_world.carp")
(load "gpu_batcher.carp")
(load "shaders.carp")
(load "renderer.carp")
(load "../../carp-gametime/gametime.carp")
(use Clock)
(load "engine.carp")
(load "../../carp-job-system/rayon.carp")
(use Vector3)
(use Double)


(defn main-loop-tick [state-ptr]
  (let [win @(M-GLFWWindow.p (Engine.win (EngineState.eng state-ptr)))
        dt (Double.clamp (/ 1.0 120.0) (/ 1.0 30.0) (do (Clock.tick! (EngineState.clock state-ptr)) (Clock.clamped-dt (EngineState.clock state-ptr))))]
    (do
      (EngineState.tick-update! state-ptr win dt)
      (EngineState.tick-render! state-ptr win))))


(defn main []
  (let [win-width 640
        win-height 360]
    (match (EngineState.create "Carp WebGPU WASM Voxel Scaffold" win-width win-height)
      (Result.Error e) (do (println* "Engine failed: " &e) -1)
      (Result.Success state)
        (let [_ (EngineState.register-handlers! &state)
              _2 (EngineState.register-inputs! &state)
              win @(M-GLFWWindow.p (Engine.win (EngineState.eng &state)))
              last-time (GLFW.get-time)
               ]
          (do
            ; Enable camera capture (mouse lock)
            (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED)
            
            (let [state-ptr (alloc-state state)]
              (do
                (start-main-loop state-ptr)
                0)))))))

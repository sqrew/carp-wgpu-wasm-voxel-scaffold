(load "Vector.carp")
(load "scaffold.carp")
(load "camera.carp")
(load "world.carp")
(load "renderer.carp")
(load "gpu_batcher.carp")
(load "engine.carp")
(load "../../carp-job-system/rayon.carp")
(use Vector3)
(use Double)

(defn main []
  (let [win-width 1280
        win-height 720]
    (match (EngineState.create "Carp WebGPU WASM Voxel Scaffold" win-width win-height)
      (Result.Error e) (do (println* "Engine failed: " &e) -1)
      (Result.Success state)
        (let [win @(Engine.win (EngineState.eng &state))
              last-time (GLFW.get-time)
              first-mouse true
              last-x 640.0
              last-y 360.0]
          (do
            ; Enable camera capture (mouse lock)
            (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED)
            
            (while (= (GLFW.window-should-close win) GLFW.FALSE)
              (let [curr-time (GLFW.get-time)
                    dt (- curr-time last-time)]
                (do
                  (set! last-time curr-time)
                  (EngineState.tick &state win dt (ref-to-ptr &first-mouse) (ref-to-ptr &last-x) (ref-to-ptr &last-y))
                  (emscripten-sleep 16))))
            
            (EngineState.cleanup &state)
            0)))))

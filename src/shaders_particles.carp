;; =============================================================================
;; Particle System Shaders
;; GPU compute (spawn + update with voxel collision) and billboard render shaders
;; =============================================================================

;; ---------------------------------------------------------------------------
;; Compute shader: unified spawn and physics integration with voxel collision
;; Particle struct is 32 bytes: pos(vec3) + life(f32) + vel(vec3) + max_life_type(f32)
;; max_life_type packs (f16 max_life, f16 ptype) into a single 32-bit float
;; ---------------------------------------------------------------------------
(def particle-compute-wgsl
  "const MAX_PARTICLES: u32 = 262144u;
const MAX_SPAWN_REQUESTS: u32 = 4096u;

struct Particle {
    pos: vec3<f32>,
    life: f32,
    vel: vec3<f32>,
    max_life_type: f32,
}

struct SpawnRequest {
    pos: vec3<f32>,
    count: f32,
    vel: vec3<f32>,
    lifetime: f32,
    ptype: f32,
    spread: f32,
    restitution: f32,
    pad: f32,
}

@group(0) @binding(0) var<storage, read_write> particles: array<Particle>;
@group(0) @binding(1) var<storage, read_write> write_head: atomic<u32>;
@group(0) @binding(2) var<storage, read> spawn_queue: array<SpawnRequest>;
@group(0) @binding(3) var<storage, read> spawn_params: array<f32>;
@group(0) @binding(4) var<storage, read> time_params: array<f32>;
@group(0) @binding(5) var solid_texture: texture_3d<f32>;
@group(0) @binding(6) var vel_texture: texture_3d<f32>;

fn hash(seed: u32) -> f32 {
    var s = seed;
    s = ((s >> 16u) ^ s) * 0x45d9f3bu;
    s = ((s >> 16u) ^ s) * 0x45d9f3bu;
    s = (s >> 16u) ^ s;
    return f32(s & 0xFFFFu) / 65535.0;
}

fn random_in_sphere(seed: u32) -> vec3<f32> {
    let u = hash(seed) * 2.0 - 1.0;
    let v = hash(seed + 1u) * 2.0 - 1.0;
    let w = hash(seed + 2u) * 2.0 - 1.0;
    let vec = vec3<f32>(u, v, w);
    let len = length(vec);
    if (len < 0.001) {
        return vec3<f32>(0.0, 1.0, 0.0);
    }
    return vec / len;
}

fn wrap_coord_160(p: vec3<f32>) -> vec3<i32> {
    let w = p - floor(p / 160.0) * 160.0;
    return vec3<i32>(clamp(w, vec3<f32>(0.0), vec3<f32>(159.0)));
}

// Sample voxel texture at world position
fn get_voxel(pos: vec3<f32>) -> vec4<f32> {
    return textureLoad(solid_texture, wrap_coord_160(pos), 0);
}

// Trilinear sample of 160^3 3D velocity + pressure field within active camera window
fn sample_wind_vel(pos: vec3<f32>, cam_pos: vec3<f32>) -> vec4<f32> {
    if (any(abs(pos - cam_pos) > vec3<f32>(77.0))) {
        return vec4<f32>(0.0);
    }
    let b = pos - vec3<f32>(0.5);
    let b0 = floor(b);
    let f = b - b0;
    let c000 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(0.0, 0.0, 0.0)), 0);
    let c100 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(1.0, 0.0, 0.0)), 0);
    let c010 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(0.0, 1.0, 0.0)), 0);
    let c110 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(1.0, 1.0, 0.0)), 0);
    let c001 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(0.0, 0.0, 1.0)), 0);
    let c101 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(1.0, 0.0, 1.0)), 0);
    let c011 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(0.0, 1.0, 1.0)), 0);
    let c111 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(1.0, 1.0, 1.0)), 0);
    let cx00 = mix(c000, c100, f.x);
    let cx10 = mix(c010, c110, f.x);
    let cx01 = mix(c001, c101, f.x);
    let cx11 = mix(c011, c111, f.x);
    let cxy0 = mix(cx00, cx10, f.y);
    let cxy1 = mix(cx01, cx11, f.y);
    return mix(cxy0, cxy1, f.z);
}

// True if position is inside solid voxel or below true bedrock floor
fn check_collision(pos: vec3<f32>) -> bool {
    if (pos.y <= -192.0) { return true; }
    let vox = get_voxel(pos);
    return abs(vox.r) > 0.5 && vox.g <= 0.0;
}

// Estimate collision normal using neighboring voxel samples
fn get_normal(pos: vec3<f32>) -> vec3<f32> {
    if (pos.y <= -191.8) { return vec3<f32>(0.0, 1.0, 0.0); }
    let eps = 0.5;
    let s_xp = check_collision(pos + vec3<f32>(eps, 0.0, 0.0));
    let s_xm = check_collision(pos - vec3<f32>(eps, 0.0, 0.0));
    let s_yp = check_collision(pos + vec3<f32>(0.0, eps, 0.0));
    let s_ym = check_collision(pos - vec3<f32>(0.0, eps, 0.0));
    let s_zp = check_collision(pos + vec3<f32>(0.0, 0.0, eps));
    let s_zm = check_collision(pos - vec3<f32>(0.0, 0.0, eps));

    var n = vec3<f32>(
        f32(i32(s_xm) - i32(s_xp)),
        f32(i32(s_ym) - i32(s_yp)),
        f32(i32(s_zm) - i32(s_zp))
    );
    let len = length(n);
    if (len < 0.1) {
        return vec3<f32>(0.0, 1.0, 0.0);
    }
    return n / len;
}

@compute @workgroup_size(64)
fn compute_main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let i = global_id.x;

    // Keep @binding(6) vel_texture live in pipeline layout even when particles are dead
    if (i == 0u && textureLoad(vel_texture, vec3<i32>(0), 0).x < -999999.0) {
        atomicAdd(&write_head, 0u);
    }

    // Thread 0 processes any pending spawn requests
    if (i == 0u) {
        let sc = u32(spawn_params[0] + 0.5);
        if (sc > 0u) {
            for (var r = 0u; r < sc && r < MAX_SPAWN_REQUESTS; r++) {
                let req = spawn_queue[r];
                let req_count = u32(req.count + 0.5);
                if (req_count > 0u) {
                    let base = atomicAdd(&write_head, req_count);
                    let vel_len = length(req.vel);
                    let spread_factor = max(req.spread, 0.015);
                    for (var j = 0u; j < req_count; j++) {
                        let slot = (base + j) % MAX_PARTICLES;
                        let seed = (base + j) * 17u + r * 31u + 1u;
                        var np: Particle;
                        let jitter = random_in_sphere(seed);
                        let pos_jit = select(0.2, 0.09, req.ptype >= 100.0 && req.ptype < 300.0);
                        np.pos = req.pos + jitter * pos_jit;
                        
                        // Push slightly out of surface if starting inside solid
                        if (req.ptype < 300.0 && check_collision(np.pos)) {
                            let norm = get_normal(np.pos);
                            np.pos += norm * 0.35;
                        }
                        
                        np.vel = req.vel + jitter * max(vel_len, 2.0) * spread_factor;
                        np.life = req.lifetime * (0.78 + hash(seed + 100u) * 0.44);
                        
                        // Pack lifetime and ptype into max_life_type
                        np.max_life_type = bitcast<f32>(pack2x16float(vec2<f32>(np.life, req.ptype)));
                        
                        particles[slot] = np;
                    }
                }
            }
        }
    }

    if (i >= MAX_PARTICLES) { return; }

    var p = particles[i];
    if (p.life <= 0.0) { return; }

    let dt = time_params[0];
    let cam_pos = vec3<f32>(time_params[1], time_params[2], time_params[3]);

    // Unpack max_life and ptype
    let unpacked = unpack2x16float(bitcast<u32>(p.max_life_type));
    let ptype = u32(unpacked.y + 0.5);

    // Physical properties + aerodynamic vel_texture coupling tailored per particle type
    var grav = -9.8;
    var drag = 0.98;
    var bounciness = 0.55;
    var wind_couple = 4.0;

    if (ptype == 0u) {
        // 0: Sparks - energetic, bouncy, ballistic + turbulent eddy swirl!
        grav = -11.0;
        drag = 0.975;
        bounciness = 0.55;
        wind_couple = 5.4;
    } else if (ptype == 1u) {
        // 1: Dust - light, floats, high air drag, swept & re-suspended by gusts!
        grav = -1.8;
        drag = 0.88;
        bounciness = 0.0;
        wind_couple = 9.8;
    } else if (ptype == 2u) {
        // 2: Debris - heavy rock chunks, resists gentle breeze, launched by shockwaves!
        grav = -15.0;
        drag = 0.985;
        bounciness = 0.30;
        wind_couple = 1.75;
    } else if (ptype == 3u) {
        // 3: Smoke - buoyant plumes sculpted into mushroom clouds & slipstream rings!
        grav = 2.0;
        drag = 0.86;
        bounciness = 0.0;
        wind_couple = 9.5;
    } else if (ptype >= 101u && ptype <= 132u) {
        // 101..132: Pressurized Flask Liquid Stream - matches parabolic raycast arc!
        grav = -18.0;
        drag = 0.996;
        bounciness = 0.25;
        wind_couple = 1.25;
    } else if (ptype >= 201u && ptype <= 232u) {
        // 201..232: Pressurized Gas Bellows Gust / Flamethrower - fast blast that billows upward
        grav = 1.6;
        drag = 0.945;
        bounciness = 0.12;
        wind_couple = 4.2;
    } else if ((ptype >= 301u && ptype <= 390u) || (ptype >= 501u && ptype <= 532u)) {
        // 301..390 & 501..532: Big Succ / Bellows / Solid Sack Vacuum Streaks into nozzle
        grav = 0.0;
        drag = 0.995;
        bounciness = 0.0;
        wind_couple = 0.0;
    } else if (ptype >= 401u && ptype <= 432u) {
        // 401..432: Solid Sack Heavy Chunk Lob / Granular Pour - matches grav -22 raycast arc!
        grav = -22.0;
        drag = 0.994;
        bounciness = 0.28;
        wind_couple = 1.15;
    } else {
        // 4: Magic / Arcane - floaty, low gravity, high ricochet + wake swirl
        grav = -0.5;
        drag = 0.97;
        bounciness = 0.75;
        wind_couple = 5.8;
    }

    // Sample 3D GPU Velocity + Dynamic Pressure Field (vel_texture)
    let wind = sample_wind_vel(p.pos, cam_pos);
    let wind_spd2 = dot(wind.xyz, wind.xyz);
    let air_vel = wind.xyz * 15.5;

    if (wind_couple > 0.01 && (wind_spd2 > 0.0004 || abs(wind.w) > 0.08)) {
        let w_blend = clamp(wind_couple * dt, 0.0, 0.65);
        p.vel = mix(p.vel, air_vel, w_blend);

        if (ptype == 0u || ptype == 4u) {
            // Turbulent eddy swirl on sparks & arcane glints!
            let phase = f32(i % 1024u) * 0.173 + p.life * 11.0;
            let swirl_axis = vec3<f32>(sin(phase), cos(phase * 1.3), cos(phase * 0.7));
            p.vel += cross(wind.xyz, swirl_axis) * (10.5 * dt);
        }
        if (abs(wind.w) > 0.45) {
            let p_eff = clamp(wind.w, -3.8, 4.5);
            let jit_b = random_in_sphere(i * 13u + u32(max(0.0, p.life * 60.0)));
            let kick_scale = clamp(wind_couple * 0.35, 0.30, 2.25);
            p.vel += (wind.xyz * 6.5 + jit_b * (abs(p_eff) * 3.8) + vec3<f32>(0.0, max(0.0, p_eff) * 4.5, 0.0)) * (dt * kick_scale);
        }
    }

    // Apply gravity & air resistance
    p.vel.y += grav * dt;
    p.vel *= pow(drag, dt * 60.0);

    // Predict next position
    let next_pos = p.pos + p.vel * dt;

    // Voxel world collision detection and response (skip for vacuumed siphon streaks)
    let is_vacuum = (ptype >= 300u && ptype < 400u) || (ptype >= 500u && ptype < 600u);
    if (!is_vacuum && check_collision(next_pos)) {
        let n = get_normal(next_pos);
        if (bounciness > 0.05) {
            let vn = dot(p.vel, n);
            if (vn < 0.0) {
                let v_normal = vn * n;
                let v_tangent = p.vel - v_normal;
                p.vel = (-v_normal * bounciness) + (v_tangent * 0.75);
                p.pos = p.pos + p.vel * dt + n * 0.05;
                p.life -= dt * 1.5;
            } else {
                p.pos = next_pos;
            }
        } else {
            // Dust & Smoke: re-suspend off cave floors into swirling plumes when wind/shockwaves pass over!
            if (wind_spd2 > 0.20 || abs(wind.w) > 0.65) {
                p.vel = air_vel * 0.55 + n * (2.2 + sqrt(wind_spd2) * 2.5);
                p.pos = p.pos + n * 0.14;
            } else {
                p.vel = vec3<f32>(0.0);
                p.life -= dt * 1.2;
            }
        }
    } else {
        p.pos = next_pos;
    }

    // Decrement life
    p.life -= dt;

    // Kill if expired or below true bedrock
    if (p.life <= 0.0 || p.pos.y < -240.0) {
        p.life = 0.0;
    }

    particles[i] = p;
}
")

;; ---------------------------------------------------------------------------
;; Billboard Render Shader: Vertex Pulling with Camera-facing Quad Expansion
;; Premultiplied alpha blending: additive glow for sparks/magic, soft alpha for dust/smoke
;; ---------------------------------------------------------------------------
(def particle-render-wgsl
  "struct Particle {
    pos: vec3<f32>,
    life: f32,
    vel: vec3<f32>,
    max_life_type: f32,
}

struct Uniforms {
    view_proj: mat4x4<f32>,
    cam_right: vec4<f32>,
    cam_up:    vec4<f32>,
}
@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(1) var<storage, read> particles: array<Particle>;

struct VertexOutput {
    @builtin(position) clip_position: vec4<f32>,
    @location(0) uv: vec2<f32>,
    @location(1) @interpolate(flat) ptype: u32,
    @location(2) t: f32,
}

fn liq_visual(lidx: u32) -> vec4<f32> {
    switch (lidx) {
        case 1u:  { return vec4<f32>(0.18, 0.64, 1.00, 0.0); } // Water
        case 2u:  { return vec4<f32>(1.00, 0.42, 0.08, 1.0); } // Lava (luminescent)
        case 3u:  { return vec4<f32>(0.22, 1.00, 0.32, 1.0); } // Acid (luminescent)
        case 4u:  { return vec4<f32>(0.22, 0.18, 0.14, 0.0); } // Oil
        case 5u:  { return vec4<f32>(0.80, 0.06, 0.08, 0.0); } // Blood
        case 6u:  { return vec4<f32>(1.00, 0.85, 0.24, 1.0); } // Ambrosia (luminescent)
        case 7u:  { return vec4<f32>(0.98, 0.18, 0.74, 1.0); } // Volatile Gel (luminescent)
        case 8u:  { return vec4<f32>(0.38, 0.85, 0.14, 0.0); } // Toxic Sludge
        case 9u:  { return vec4<f32>(0.44, 0.25, 0.09, 0.0); } // Diesel
        case 10u: { return vec4<f32>(0.88, 0.62, 0.14, 0.0); } // Kerosene
        case 11u: { return vec4<f32>(0.96, 0.86, 0.42, 0.0); } // Naphtha
        case 12u: { return vec4<f32>(0.82, 0.86, 0.92, 0.0); } // Mercury
        case 13u: { return vec4<f32>(0.76, 0.68, 0.96, 0.0); } // Lye
        case 14u: { return vec4<f32>(0.98, 0.92, 0.60, 1.0); } // Nitroglycerin (luminescent)
        default:  { return vec4<f32>(0.45, 0.92, 1.00, 1.0); } // Liquid Nitrogen (luminescent)
    }
}

fn gas_visual(gidx: u32) -> vec4<f32> {
    switch (gidx) {
        case 1u:  { return vec4<f32>(0.78, 0.82, 0.88, 0.0); } // Steam
        case 2u:  { return vec4<f32>(0.45, 0.92, 0.15, 0.0); } // Toxic Gas
        case 3u:  { return vec4<f32>(1.00, 0.68, 0.18, 1.0); } // Fire (luminescent)
        case 4u:  { return vec4<f32>(0.24, 0.24, 0.27, 0.0); } // Smoke
        case 5u:  { return vec4<f32>(0.25, 0.88, 0.18, 0.0); } // Acid Vapor
        case 6u:  { return vec4<f32>(0.82, 0.72, 0.58, 0.0); } // Methane
        case 7u:  { return vec4<f32>(1.00, 0.35, 0.05, 1.0); } // Napalm Vapor
        case 8u:  { return vec4<f32>(0.52, 0.86, 0.32, 0.0); } // Spore Cloud
        case 9u:  { return vec4<f32>(0.74, 0.90, 1.00, 0.0); } // Hydrogen
        case 10u: { return vec4<f32>(0.92, 0.72, 0.38, 0.0); } // Butane
        case 11u: { return vec4<f32>(0.68, 0.95, 0.22, 0.0); } // Chlorine
        case 12u: { return vec4<f32>(0.42, 1.00, 0.55, 1.0); } // Radon (luminescent)
        default:  { return vec4<f32>(0.98, 0.94, 0.78, 1.0); } // Acetylene (luminescent)
    }
}

fn solid_visual(sidx: u32) -> vec4<f32> {
    switch (sidx) {
        case 1u:  { return vec4<f32>(0.55, 0.55, 0.56, 0.0); } // Stone
        case 2u:  { return vec4<f32>(0.24, 0.62, 0.28, 0.0); } // Soil
        case 3u:  { return vec4<f32>(0.56, 0.34, 0.17, 0.0); } // Wood
        case 4u:  { return vec4<f32>(0.16, 0.16, 0.18, 0.0); } // Coal
        case 5u:  { return vec4<f32>(0.98, 0.78, 0.18, 0.0); } // Gold
        case 6u:  { return vec4<f32>(0.88, 0.82, 0.60, 0.0); } // Sand
        case 7u:  { return vec4<f32>(0.30, 0.30, 0.36, 0.0); } // Gunpowder
        case 8u:  { return vec4<f32>(0.62, 0.84, 0.98, 0.0); } // Ice
        case 9u:  { return vec4<f32>(0.90, 0.92, 0.98, 0.0); } // Glass
        case 10u: { return vec4<f32>(0.32, 0.92, 0.42, 0.0); } // Slime
        case 11u: { return vec4<f32>(0.92, 0.90, 0.24, 0.0); } // Sponge
        case 12u: { return vec4<f32>(0.92, 0.88, 0.84, 0.0); } // C4
        case 13u: { return vec4<f32>(0.38, 0.96, 0.34, 1.0); } // Spore Pod (luminescent)
        case 14u: { return vec4<f32>(0.15, 0.90, 1.00, 1.0); } // Crystal (luminescent)
        case 15u: { return vec4<f32>(0.76, 0.28, 1.00, 1.0); } // Amethyst (luminescent)
        case 16u: { return vec4<f32>(0.22, 0.16, 0.34, 0.0); } // Obsidian
        case 17u: { return vec4<f32>(0.60, 1.00, 0.20, 1.0); } // Rad-Ore (luminescent)
        case 18u: { return vec4<f32>(0.14, 0.22, 0.28, 1.0); } // Abyssal Seal
        case 19u: { return vec4<f32>(0.10, 0.09, 0.12, 0.0); } // Bitumen
        case 20u: { return vec4<f32>(0.86, 0.89, 0.95, 0.0); } // Sodium
        case 21u: { return vec4<f32>(0.95, 0.94, 0.98, 0.0); } // Salt
        case 22u: { return vec4<f32>(0.96, 0.78, 0.86, 0.0); } // Soap
        case 23u: { return vec4<f32>(0.95, 0.88, 0.12, 0.0); } // Sulfur
        case 24u: { return vec4<f32>(0.38, 0.42, 0.48, 0.0); } // Carbide
        default:  { return vec4<f32>(0.96, 0.98, 0.70, 1.0); } // Phosphorus (luminescent)
    }
}

@vertex fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
    var out: VertexOutput;
    let particle_idx = vi / 6u;
    let corner_idx = vi % 6u;

    if (particle_idx >= 262144u) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let p = particles[particle_idx];

    // Dead particle: discard offscreen
    if (p.life <= 0.0) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let unpacked = unpack2x16float(bitcast<u32>(p.max_life_type));
    let max_life = unpacked.x;
    let ptype = u32(unpacked.y + 0.5);

    if (max_life <= 0.0) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let t = clamp(p.life / max_life, 0.0, 1.0);

    // Quad corners and UVs: 2 triangles (0, 1, 2) and (3, 4, 5)
    var offset = vec2<f32>(-1.0, -1.0);
    var uv = vec2<f32>(0.0, 0.0);
    if (corner_idx == 1u) { offset = vec2<f32>( 1.0, -1.0); uv = vec2<f32>(1.0, 0.0); }
    else if (corner_idx == 2u) { offset = vec2<f32>(-1.0,  1.0); uv = vec2<f32>(0.0, 1.0); }
    else if (corner_idx == 3u) { offset = vec2<f32>(-1.0,  1.0); uv = vec2<f32>(0.0, 1.0); }
    else if (corner_idx == 4u) { offset = vec2<f32>( 1.0, -1.0); uv = vec2<f32>(1.0, 0.0); }
    else if (corner_idx == 5u) { offset = vec2<f32>( 1.0,  1.0); uv = vec2<f32>(1.0, 1.0); }

    // World size per particle type
    var size: f32 = 0.06;
    if (ptype == 0u) {
        // Sparks: snappy sparks that start small and taper
        size = mix(0.02, 0.06, t);
    } else if (ptype == 1u) {
        // Dust: puffs expand from 0.07 to 0.18 as they billow
        size = mix(0.18, 0.07, t);
    } else if (ptype == 2u) {
        // Debris: chunky pebbles
        size = 0.07;
    } else if (ptype == 3u) {
        // Smoke: expands into large clouds
        size = mix(0.30, 0.09, t);
    } else if (ptype >= 101u && ptype <= 132u) {
        // Liquid Squirt droplets: plump pressurized globules that taper slightly
        size = mix(0.065, 0.115, t);
    } else if (ptype >= 201u && ptype <= 232u) {
        // Gas Bellows puffs: start tight at nozzle and billow into fat clouds
        size = mix(0.38, 0.10, t);
    } else if (ptype >= 301u && ptype <= 390u) {
        // Big Succ / Bellows droplets: shrink cleanly as they funnel into the nozzle
        size = mix(0.035, 0.115, t);
    } else if (ptype >= 401u && ptype <= 432u) {
        // Solid Sack clods / grains: chunky solid fragments
        size = mix(0.085, 0.135, t);
    } else if (ptype >= 501u && ptype <= 532u) {
        // Solid Sack dredged chunks: funnel cleanly from mined rock into the Sack!
        size = mix(0.04, 0.13, t);
    } else {
        // Magic: medium glowing motes
        size = mix(0.04, 0.08, t);
    }

    // Billboarding: expand perpendicular to view vector along camera right & up
    let world_pos = p.pos + (u.cam_right.xyz * offset.x + u.cam_up.xyz * offset.y) * size;

    out.clip_position = u.view_proj * vec4<f32>(world_pos, 1.0);
    out.uv = uv;
    out.ptype = ptype;
    out.t = t;
    return out;
}

@fragment fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    let d = length(in.uv - vec2<f32>(0.5));
    if (d > 0.5) { discard; }

    let radial = clamp(1.0 - d * 2.0, 0.0, 1.0);
    let core = pow(radial, 2.0);

    if (in.ptype == 0u) {
        // 0: Sparks - burning ember with additive glow (alpha = 0 for pure additive)
        let r = mix(0.4, 1.0, in.t);
        let g = mix(0.05, 0.95, in.t * in.t);
        let b = mix(0.0, 0.45, in.t * in.t * in.t);
        let rgb = vec3<f32>(r, g, b) * (core * 2.0);
        return vec4<f32>(rgb, 0.0);
    } else if (in.ptype == 1u) {
        // 1: Dust - soft earthy sandstone puff (premultiplied alpha)
        let alpha = in.t * radial * 0.55;
        let rgb = mix(vec3<f32>(0.42, 0.38, 0.33), vec3<f32>(0.74, 0.67, 0.56), in.t);
        return vec4<f32>(rgb * alpha, alpha);
    } else if (in.ptype == 2u) {
        // 2: Debris - slate rock chip
        let alpha = smoothstep(0.4, 0.5, 1.0 - d * 2.0);
        let rgb = mix(vec3<f32>(0.24, 0.23, 0.22), vec3<f32>(0.52, 0.50, 0.47), in.t);
        return vec4<f32>(rgb * alpha, alpha);
    } else if (in.ptype == 3u) {
        // 3: Smoke - soft rising translucent vapor
        let alpha = in.t * radial * 0.40;
        let rgb = mix(vec3<f32>(0.22, 0.22, 0.24), vec3<f32>(0.58, 0.58, 0.60), in.t);
        return vec4<f32>(rgb * alpha, alpha);
    } else if (in.ptype >= 101u && in.ptype <= 132u) {
        // Liquid Squirt Droplet
        let vis = liq_visual(in.ptype - 100u);
        let spec = pow(clamp(1.0 - length(in.uv - vec2<f32>(0.36, 0.64)) * 3.0, 0.0, 1.0), 3.0) * 0.35;
        if (vis.w > 0.5) {
            let rgb = (vis.rgb + vec3<f32>(spec)) * (core * 2.1);
            return vec4<f32>(rgb, 0.0);
        }
        let alpha = clamp(smoothstep(0.05, 0.42, radial) * (0.35 + 0.6 * in.t), 0.0, 0.92);
        let rgb = vis.rgb * (0.75 + 0.35 * radial) + vec3<f32>(spec);
        return vec4<f32>(rgb * alpha, alpha);
    } else if (in.ptype >= 201u && in.ptype <= 232u) {
        // Gas Bellows Puff / Flamethrower Tongue
        let vis = gas_visual(in.ptype - 200u);
        if (vis.w > 0.5) {
            let rgb = vis.rgb * (core * 2.1 * in.t);
            return vec4<f32>(rgb, 0.0);
        }
        let alpha = in.t * radial * 0.48;
        return vec4<f32>(vis.rgb * alpha, alpha);
    } else if (in.ptype >= 301u && in.ptype <= 390u) {
        // Big Succ / Bellows Siphon Streak (301..349 Liquids, 351..390 Gases)
        let vis = select(gas_visual(in.ptype - 350u), liq_visual(in.ptype - 300u), in.ptype < 350u);
        let spec = pow(radial, 3.0) * 0.3;
        if (vis.w > 0.5) {
            let rgb = (vis.rgb + vec3<f32>(spec)) * (core * 2.2);
            return vec4<f32>(rgb, 0.0);
        }
        let alpha = clamp(radial * 0.85, 0.0, 0.9);
        let rgb = vis.rgb + vec3<f32>(spec);
        return vec4<f32>(rgb * alpha, alpha);
    } else if ((in.ptype >= 401u && in.ptype <= 432u) || (in.ptype >= 501u && in.ptype <= 532u)) {
        // Solid Sack Chunk (401..432 Pack/Pour, 501..532 Dredge Scoop)
        let sidx = select(in.ptype - 500u, in.ptype - 400u, in.ptype < 500u);
        let vis = solid_visual(sidx);
        let shade = 0.68 + 0.38 * clamp(1.0 - length(in.uv - vec2<f32>(0.35, 0.65)) * 1.6, 0.0, 1.0);
        if (vis.w > 0.5) {
            let rgb = vis.rgb * (core * 2.0 + 0.35);
            return vec4<f32>(rgb, 0.0);
        }
        let alpha = smoothstep(0.22, 0.44, radial);
        let rgb = vis.rgb * shade;
        return vec4<f32>(rgb * alpha, alpha);
    } else {
        // 4: Magic - electric cyan/magenta plasma with intense additive glow
        let c = mix(vec3<f32>(0.85, 0.15, 0.95), vec3<f32>(0.12, 0.92, 1.0), in.t);
        let rgb = c * (core * 2.5);
        return vec4<f32>(rgb, 0.0);
    }
}
")

;; ---------------------------------------------------------------------------
;; 8,192-Bolt Analytical 3D Sphere / Rail-Lance / Gyre Impostor Pass
;; Zero ECS or per-pixel raymarch overhead; 1 hardware depth-tested draw call!
;; ---------------------------------------------------------------------------
(def bolt-render-wgsl
  "struct BoltGPU {
    pos_rad:   vec4<f32>,
    vel_style: vec4<f32>,
    col_glow:  vec4<f32>,
}

struct Uniforms {
    view_proj: mat4x4<f32>,
    cam_right: vec4<f32>,
    cam_up:    vec4<f32>,
}
@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(1) var<storage, read> bolts: array<BoltGPU>;

struct BoltVertexOut {
    @builtin(position) clip_position: vec4<f32>,
    @location(0) local_xy: vec2<f32>,
    @location(1) stretch_time: vec2<f32>,
    @location(2) col_glow: vec4<f32>,
    @location(3) @interpolate(flat) style: u32,
}

@vertex fn vs_main(@builtin(vertex_index) vi: u32) -> BoltVertexOut {
    var out: BoltVertexOut;
    let bolt_idx = vi / 6u;
    let corner_idx = vi % 6u;

    if (bolt_idx >= 8192u) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let b = bolts[bolt_idx];
    let rad = b.pos_rad.w;
    if (rad <= 0.005) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    var offset = vec2<f32>(-1.0, -1.0);
    if (corner_idx == 1u) { offset = vec2<f32>( 1.0, -1.0); }
    else if (corner_idx == 2u) { offset = vec2<f32>(-1.0,  1.0); }
    else if (corner_idx == 3u) { offset = vec2<f32>(-1.0,  1.0); }
    else if (corner_idx == 4u) { offset = vec2<f32>( 1.0, -1.0); }
    else if (corner_idx == 5u) { offset = vec2<f32>( 1.0,  1.0); }

    let style = u32(max(0.0, round(b.vel_style.w)));
    let vx_scr = dot(b.vel_style.xyz, u.cam_right.xyz);
    let vy_scr = dot(b.vel_style.xyz, u.cam_up.xyz);
    let scr_spd = sqrt(vx_scr * vx_scr + vy_scr * vy_scr);

    var ax1 = u.cam_right.xyz;
    var ax2 = u.cam_up.xyz;
    var stretch: f32 = 1.0;

    if (scr_spd > 0.75 && (style == 1u || scr_spd > 68.0)) {
        let dir2 = vec2<f32>(vx_scr, vy_scr) / scr_spd;
        ax1 = u.cam_right.xyz * dir2.x + u.cam_up.xyz * dir2.y;
        ax2 = -u.cam_right.xyz * dir2.y + u.cam_up.xyz * dir2.x;
        if (style == 1u) {
            stretch = clamp(2.35 + scr_spd * 0.032, 2.35, 7.20);
        } else {
            stretch = clamp(1.0 + (scr_spd - 68.0) * 0.022, 1.0, 2.65);
        }
    }

    let halo_scale = select(1.22, 1.55, b.col_glow.w >= 0.5 || style == 3u);
    let local_xy = vec2<f32>(offset.x * stretch, offset.y) * halo_scale;
    let world_pos = b.pos_rad.xyz + ax1 * (local_xy.x * rad) + ax2 * (local_xy.y * rad);

    out.clip_position = u.view_proj * vec4<f32>(world_pos, 1.0);
    out.local_xy = local_xy;
    out.stretch_time = vec2<f32>(stretch, u.cam_right.w);
    out.col_glow = b.col_glow;
    out.style = style;
    return out;
}

@fragment fn fs_main(in: BoltVertexOut) -> @location(0) vec4<f32> {
    let half_seg = max(0.0, in.stretch_time.x - 1.0);
    let cx = clamp(in.local_xy.x, -half_seg, half_seg);
    let q = vec2<f32>(in.local_xy.x - cx, in.local_xy.y);
    let r = length(q);
    if (r > 1.55) { discard; }

    let base_col = max(in.col_glow.rgb, vec3<f32>(0.02));
    let glow_amt = in.col_glow.w;
    let t = in.stretch_time.y;

    // Style 3: Gyre Vortex — swirling cyclone torus + blazing eye-wall!
    if (in.style == 3u) {
        let ang = atan2(q.y, q.x);
        let spiral = 0.5 + 0.5 * sin(ang * 3.0 - t * 18.0 + r * 5.8);
        let ring = exp(-pow((r - 0.72) * 3.8, 2.0));
        let core_eye = clamp(1.0 - r * 1.35, 0.0, 1.0);
        let alpha = clamp(ring * 0.78 + core_eye * 0.65, 0.0, 0.90);
        let hot = mix(base_col, vec3<f32>(1.0, 0.98, 0.95), core_eye * 0.55 + ring * 0.35);
        let corona = base_col * (exp(-r * 1.85) * (0.95 + 0.55 * spiral) + ring * 1.15);
        return vec4<f32>(hot * alpha + corona, alpha);
    }

    // Matte / Solid Mineral Slug (glow < 0.5): crisp analytical 3D sphere + subtle kinetic rim
    if (glow_amt < 0.5) {
        if (r > 1.16) { discard; }
        if (r > 1.0) {
            let rim_h = clamp(1.0 - (r - 1.0) / 0.16, 0.0, 1.0);
            return vec4<f32>(base_col * (rim_h * rim_h * 0.22), 0.0);
        }
        let nz = sqrt(max(0.0, 1.0 - r * r));
        let n3 = normalize(vec3<f32>(q.x, q.y, nz));
        let ldir = normalize(vec3<f32>(-0.38, 0.62, 0.68));
        let diff = clamp(dot(n3, ldir), 0.0, 1.0);
        let spec = pow(clamp(dot(n3, normalize(ldir + vec3<f32>(0.0, 0.0, 1.0))), 0.0, 1.0), 18.0) * 0.32;
        let shade = 0.34 + 0.72 * diff;
        let alpha = smoothstep(1.0, 0.90, r);
        let rgb = base_col * shade + vec3<f32>(spec);
        return vec4<f32>(rgb * alpha, alpha);
    }

    // Incandescent Orb / Rail-Lance / Cluster Mortar: analytical white-hot plasma core + HDR corona!
    let nz = sqrt(max(0.0, 1.0 - min(r * r, 1.0)));
    let body_a = smoothstep(1.04, 0.78, r) * clamp(0.68 + 0.16 * glow_amt, 0.68, 0.92);
    let warhead_pulse = select(1.0, 0.85 + 0.30 * sin(t * 22.0 + r * 8.0), in.style == 2u);
    let hot_core = mix(base_col, vec3<f32>(1.0, 0.99, 0.96), pow(nz, 2.1) * 0.72);
    let halo = exp(-max(0.0, r - 0.35) * 2.55) * (0.75 + 0.45 * glow_amt) * warhead_pulse;
    return vec4<f32>(hot_core * body_a + base_col * halo, body_a);
}
")


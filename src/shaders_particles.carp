;; =============================================================================
;; Particle System Shaders
;; GPU compute (spawn + update with voxel collision) and billboard render shaders
;; =============================================================================

;; ---------------------------------------------------------------------------
;; Compute shader: unified spawn and physics integration with voxel collision
;; Particle struct is 32 bytes: pos(vec3) + life(f32) + vel(vec3) + max_life_type(f32)
;; max_life_type packs (f16 max_life, f16 ptype) into a single 32-bit float
;; ---------------------------------------------------------------------------
(def particle-compute-wgsl
  "const MAX_PARTICLES: u32 = 131072u;
const MAX_SPAWN_REQUESTS: u32 = 1024u;

struct Particle {
    pos: vec3<f32>,
    life: f32,
    vel: vec3<f32>,
    max_life_type: f32,
}

struct SpawnRequest {
    pos: vec3<f32>,
    count: f32,
    vel: vec3<f32>,
    lifetime: f32,
    ptype: f32,
    spread: f32,
    restitution: f32,
    pad: f32,
}

@group(0) @binding(0) var<storage, read_write> particles: array<Particle>;
@group(0) @binding(1) var<storage, read_write> write_head: atomic<u32>;
@group(0) @binding(2) var<storage, read> spawn_queue: array<SpawnRequest>;
@group(0) @binding(3) var<storage, read> spawn_params: array<f32>;
@group(0) @binding(4) var<storage, read> time_params: array<f32>;
@group(0) @binding(5) var solid_texture: texture_3d<f32>;

fn hash(seed: u32) -> f32 {
    var s = seed;
    s = ((s >> 16u) ^ s) * 0x45d9f3bu;
    s = ((s >> 16u) ^ s) * 0x45d9f3bu;
    s = (s >> 16u) ^ s;
    return f32(s & 0xFFFFu) / 65535.0;
}

fn random_in_sphere(seed: u32) -> vec3<f32> {
    let u = hash(seed) * 2.0 - 1.0;
    let v = hash(seed + 1u) * 2.0 - 1.0;
    let w = hash(seed + 2u) * 2.0 - 1.0;
    let vec = vec3<f32>(u, v, w);
    let len = length(vec);
    if (len < 0.001) {
        return vec3<f32>(0.0, 1.0, 0.0);
    }
    return vec / len;
}

// Sample voxel texture at world position
fn get_voxel(pos: vec3<f32>) -> vec4<f32> {
    let wrapped = pos - floor(pos / 160.0) * 160.0;
    let ip = vec3<i32>(clamp(wrapped, vec3<f32>(0.0), vec3<f32>(159.0)));
    return textureLoad(solid_texture, ip, 0);
}

// True if position is inside solid voxel or below bedrock floor
fn check_collision(pos: vec3<f32>) -> bool {
    if (pos.y <= 0.0) { return true; }
    let vox = get_voxel(pos);
    return vox.r > 0.5;
}

// Estimate collision normal using neighboring voxel samples
fn get_normal(pos: vec3<f32>) -> vec3<f32> {
    if (pos.y <= 0.2) { return vec3<f32>(0.0, 1.0, 0.0); }
    let eps = 0.5;
    let s_xp = check_collision(pos + vec3<f32>(eps, 0.0, 0.0));
    let s_xm = check_collision(pos - vec3<f32>(eps, 0.0, 0.0));
    let s_yp = check_collision(pos + vec3<f32>(0.0, eps, 0.0));
    let s_ym = check_collision(pos - vec3<f32>(0.0, eps, 0.0));
    let s_zp = check_collision(pos + vec3<f32>(0.0, 0.0, eps));
    let s_zm = check_collision(pos - vec3<f32>(0.0, 0.0, eps));

    var n = vec3<f32>(
        f32(i32(s_xm) - i32(s_xp)),
        f32(i32(s_ym) - i32(s_yp)),
        f32(i32(s_zm) - i32(s_zp))
    );
    let len = length(n);
    if (len < 0.1) {
        return vec3<f32>(0.0, 1.0, 0.0);
    }
    return n / len;
}

@compute @workgroup_size(64)
fn compute_main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let i = global_id.x;

    // Thread 0 processes any pending spawn requests
    if (i == 0u) {
        let sc = u32(spawn_params[0] + 0.5);
        if (sc > 0u) {
            for (var r = 0u; r < sc && r < MAX_SPAWN_REQUESTS; r++) {
                let req = spawn_queue[r];
                let req_count = u32(req.count + 0.5);
                if (req_count > 0u) {
                    let base = atomicAdd(&write_head, req_count);
                    let vel_len = length(req.vel);
                    let spread_factor = max(req.spread, 0.1);
                    for (var j = 0u; j < req_count; j++) {
                        let slot = (base + j) % MAX_PARTICLES;
                        let seed = (base + j) * 17u + r * 31u + 1u;
                        var np: Particle;
                        let jitter = random_in_sphere(seed);
                        np.pos = req.pos + jitter * 0.2;
                        
                        // Push slightly out of surface if starting inside solid
                        if (check_collision(np.pos)) {
                            let norm = get_normal(np.pos);
                            np.pos += norm * 0.35;
                        }
                        
                        np.vel = req.vel + jitter * max(vel_len, 2.0) * spread_factor;
                        np.life = req.lifetime * (0.7 + hash(seed + 100u) * 0.6);
                        
                        // Pack lifetime and ptype into max_life_type
                        np.max_life_type = bitcast<f32>(pack2x16float(vec2<f32>(np.life, req.ptype)));
                        
                        particles[slot] = np;
                    }
                }
            }
        }
    }

    if (i >= MAX_PARTICLES) { return; }

    var p = particles[i];
    if (p.life <= 0.0) { return; }

    let dt = time_params[0];

    // Unpack max_life and ptype
    let unpacked = unpack2x16float(bitcast<u32>(p.max_life_type));
    let ptype = u32(unpacked.y + 0.5);

    // Physical properties tailored per particle type
    var grav = -9.8;
    var drag = 0.98;
    var bounciness = 0.55;

    if (ptype == 0u) {
        // 0: Sparks - energetic, bouncy, ballistic
        grav = -11.0;
        drag = 0.975;
        bounciness = 0.55;
    } else if (ptype == 1u) {
        // 1: Dust - light, floats, high air drag, settles gently
        grav = -1.8;
        drag = 0.88;
        bounciness = 0.0;
    } else if (ptype == 2u) {
        // 2: Debris - heavy chunks, low bounciness
        grav = -15.0;
        drag = 0.985;
        bounciness = 0.30;
    } else if (ptype == 3u) {
        // 3: Smoke - rises into the air!
        grav = 2.0;
        drag = 0.86;
        bounciness = 0.0;
    } else {
        // 4: Magic / Arcane - floaty, low gravity, high ricochet
        grav = -0.5;
        drag = 0.97;
        bounciness = 0.75;
    }

    // Apply gravity
    p.vel.y += grav * dt;

    // Apply air resistance
    p.vel *= pow(drag, dt * 60.0);

    // Predict next position
    let next_pos = p.pos + p.vel * dt;

    // Voxel world collision detection and response
    if (check_collision(next_pos)) {
        let n = get_normal(next_pos);
        if (bounciness > 0.05) {
            let vn = dot(p.vel, n);
            if (vn < 0.0) {
                // Bounce: reflect along normal with restitution
                let v_normal = vn * n;
                let v_tangent = p.vel - v_normal;
                p.vel = (-v_normal * bounciness) + (v_tangent * 0.75); // surface friction
                p.pos = p.pos + p.vel * dt + n * 0.05;
                p.life -= dt * 1.5; // lose energy on collision
            } else {
                p.pos = next_pos;
            }
        } else {
            // Settle on surface (Dust, Smoke)
            p.vel = vec3<f32>(0.0);
            p.life -= dt * 1.2;
        }
    } else {
        p.pos = next_pos;
    }

    // Decrement life
    p.life -= dt;

    // Kill if expired or out of world
    if (p.life <= 0.0 || p.pos.y < -50.0 || length(p.pos) > 600.0) {
        p.life = 0.0;
    }

    particles[i] = p;
}
")

;; ---------------------------------------------------------------------------
;; Billboard Render Shader: Vertex Pulling with Camera-facing Quad Expansion
;; Premultiplied alpha blending: additive glow for sparks/magic, soft alpha for dust/smoke
;; ---------------------------------------------------------------------------
(def particle-render-wgsl
  "struct Particle {
    pos: vec3<f32>,
    life: f32,
    vel: vec3<f32>,
    max_life_type: f32,
}

struct Uniforms {
    view_proj: mat4x4<f32>,
    cam_right: vec4<f32>,
    cam_up:    vec4<f32>,
}
@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(1) var<storage, read> particles: array<Particle>;

struct VertexOutput {
    @builtin(position) clip_position: vec4<f32>,
    @location(0) uv: vec2<f32>,
    @location(1) @interpolate(flat) ptype: u32,
    @location(2) t: f32,
}

@vertex fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
    var out: VertexOutput;
    let particle_idx = vi / 6u;
    let corner_idx = vi % 6u;

    if (particle_idx >= 131072u) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let p = particles[particle_idx];

    // Dead particle: discard offscreen
    if (p.life <= 0.0) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let unpacked = unpack2x16float(bitcast<u32>(p.max_life_type));
    let max_life = unpacked.x;
    let ptype = u32(unpacked.y + 0.5);

    if (max_life <= 0.0) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let t = clamp(p.life / max_life, 0.0, 1.0);

    // Quad corners and UVs: 2 triangles (0, 1, 2) and (3, 4, 5)
    var offset = vec2<f32>(-1.0, -1.0);
    var uv = vec2<f32>(0.0, 0.0);
    if (corner_idx == 1u) { offset = vec2<f32>( 1.0, -1.0); uv = vec2<f32>(1.0, 0.0); }
    else if (corner_idx == 2u) { offset = vec2<f32>(-1.0,  1.0); uv = vec2<f32>(0.0, 1.0); }
    else if (corner_idx == 3u) { offset = vec2<f32>(-1.0,  1.0); uv = vec2<f32>(0.0, 1.0); }
    else if (corner_idx == 4u) { offset = vec2<f32>( 1.0, -1.0); uv = vec2<f32>(1.0, 0.0); }
    else if (corner_idx == 5u) { offset = vec2<f32>( 1.0,  1.0); uv = vec2<f32>(1.0, 1.0); }

    // World size per particle type
    var size: f32 = 0.06;
    if (ptype == 0u) {
        // Sparks: snappy sparks that start small and taper
        size = mix(0.02, 0.06, t);
    } else if (ptype == 1u) {
        // Dust: puffs expand from 0.07 to 0.18 as they billow
        size = mix(0.18, 0.07, t);
    } else if (ptype == 2u) {
        // Debris: chunky pebbles
        size = 0.07;
    } else if (ptype == 3u) {
        // Smoke: expands into large clouds
        size = mix(0.30, 0.09, t);
    } else {
        // Magic: medium glowing motes
        size = mix(0.04, 0.08, t);
    }

    // Billboarding: expand perpendicular to view vector along camera right & up
    let world_pos = p.pos + (u.cam_right.xyz * offset.x + u.cam_up.xyz * offset.y) * size;

    out.clip_position = u.view_proj * vec4<f32>(world_pos, 1.0);
    out.uv = uv;
    out.ptype = ptype;
    out.t = t;
    return out;
}

@fragment fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    let d = length(in.uv - vec2<f32>(0.5));
    if (d > 0.5) { discard; }

    let radial = clamp(1.0 - d * 2.0, 0.0, 1.0);
    let core = pow(radial, 2.0);

    if (in.ptype == 0u) {
        // 0: Sparks - burning ember with additive glow (alpha = 0 for pure additive)
        let r = mix(0.4, 1.0, in.t);
        let g = mix(0.05, 0.95, in.t * in.t);
        let b = mix(0.0, 0.45, in.t * in.t * in.t);
        let rgb = vec3<f32>(r, g, b) * (core * 2.0);
        return vec4<f32>(rgb, 0.0);
    } else if (in.ptype == 1u) {
        // 1: Dust - soft earthy sandstone puff (premultiplied alpha)
        let alpha = in.t * radial * 0.55;
        let rgb = mix(vec3<f32>(0.42, 0.38, 0.33), vec3<f32>(0.74, 0.67, 0.56), in.t);
        return vec4<f32>(rgb * alpha, alpha);
    } else if (in.ptype == 2u) {
        // 2: Debris - slate rock chip
        let alpha = smoothstep(0.4, 0.5, 1.0 - d * 2.0);
        let rgb = mix(vec3<f32>(0.24, 0.23, 0.22), vec3<f32>(0.52, 0.50, 0.47), in.t);
        return vec4<f32>(rgb * alpha, alpha);
    } else if (in.ptype == 3u) {
        // 3: Smoke - soft rising translucent vapor
        let alpha = in.t * radial * 0.40;
        let rgb = mix(vec3<f32>(0.22, 0.22, 0.24), vec3<f32>(0.58, 0.58, 0.60), in.t);
        return vec4<f32>(rgb * alpha, alpha);
    } else {
        // 4: Magic - electric cyan/magenta plasma with intense additive glow
        let c = mix(vec3<f32>(0.85, 0.15, 0.95), vec3<f32>(0.12, 0.92, 1.0), in.t);
        let rgb = c * (core * 2.5);
        return vec4<f32>(rgb, 0.0);
    }
}
")

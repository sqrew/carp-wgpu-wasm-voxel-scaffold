;; =============================================================================
;; Particle System Shaders
;; GPU compute (spawn + update with voxel collision) and billboard render shaders
;; =============================================================================

;; ---------------------------------------------------------------------------
;; Compute shader: unified spawn and physics integration with voxel collision
;; Particle struct is 32 bytes: pos(vec3) + life(f32) + vel(vec3) + max_life_type(f32)
;; max_life_type packs (f16 max_life, f16 ptype) into a single 32-bit float
;; ---------------------------------------------------------------------------
(def particle-compute-wgsl
  "const MAX_PARTICLES: u32 = 262144u;
const MAX_SPAWN_REQUESTS: u32 = 4096u;

struct Particle {
    pos: vec3<f32>,
    life: f32,
    vel: vec3<f32>,
    max_life_type: f32,
}

struct SpawnRequest {
    pos: vec3<f32>,
    count: f32,
    vel: vec3<f32>,
    lifetime: f32,
    ptype: f32,
    spread: f32,
    restitution: f32,
    pad: f32,
}

@group(0) @binding(0) var<storage, read_write> particles: array<Particle>;
@group(0) @binding(1) var<storage, read_write> write_head: atomic<u32>;
@group(0) @binding(2) var<storage, read> spawn_queue: array<SpawnRequest>;
@group(0) @binding(3) var<storage, read> spawn_params: array<f32>;
@group(0) @binding(4) var<storage, read> time_params: array<f32>;
@group(0) @binding(5) var solid_texture: texture_3d<f32>;
@group(0) @binding(6) var vel_texture: texture_3d<f32>;
@group(0) @binding(7) var curl_texture: texture_3d<f32>;

fn sample_curl_p64(q: vec3<f32>) -> vec3<f32> {
    let w = q - floor(q / 64.0) * 64.0;
    let i0 = vec3<i32>(floor(w)) & vec3<i32>(63);
    let i1 = (i0 + vec3<i32>(1)) & vec3<i32>(63);
    let f = fract(w);
    let c000 = textureLoad(curl_texture, vec3<i32>(i0.x, i0.y, i0.z), 0).rgb;
    let c100 = textureLoad(curl_texture, vec3<i32>(i1.x, i0.y, i0.z), 0).rgb;
    let c010 = textureLoad(curl_texture, vec3<i32>(i0.x, i1.y, i0.z), 0).rgb;
    let c110 = textureLoad(curl_texture, vec3<i32>(i1.x, i1.y, i0.z), 0).rgb;
    let c001 = textureLoad(curl_texture, vec3<i32>(i0.x, i0.y, i1.z), 0).rgb;
    let c101 = textureLoad(curl_texture, vec3<i32>(i1.x, i0.y, i1.z), 0).rgb;
    let c011 = textureLoad(curl_texture, vec3<i32>(i0.x, i1.y, i1.z), 0).rgb;
    let c111 = textureLoad(curl_texture, vec3<i32>(i1.x, i1.y, i1.z), 0).rgb;
    let cx00 = mix(c000, c100, f.x);
    let cx10 = mix(c010, c110, f.x);
    let cx01 = mix(c001, c101, f.x);
    let cx11 = mix(c011, c111, f.x);
    return mix(mix(cx00, cx10, f.y), mix(cx01, cx11, f.y), f.z);
}

fn hash(seed: u32) -> f32 {
    var s = seed;
    s = ((s >> 16u) ^ s) * 0x45d9f3bu;
    s = ((s >> 16u) ^ s) * 0x45d9f3bu;
    s = (s >> 16u) ^ s;
    return f32(s & 0xFFFFu) / 65535.0;
}

fn random_in_sphere(seed: u32) -> vec3<f32> {
    let u = hash(seed) * 2.0 - 1.0;
    let v = hash(seed + 1u) * 2.0 - 1.0;
    let w = hash(seed + 2u) * 2.0 - 1.0;
    let vec = vec3<f32>(u, v, w);
    let len = length(vec);
    if (len < 0.001) {
        return vec3<f32>(0.0, 1.0, 0.0);
    }
    return vec / len;
}

fn wrap_coord_160(p: vec3<f32>) -> vec3<i32> {
    let w = p - floor(p / 160.0) * 160.0;
    return vec3<i32>(clamp(w, vec3<f32>(0.0), vec3<f32>(159.0)));
}

// Sample voxel texture at world position
fn get_voxel(pos: vec3<f32>) -> vec4<f32> {
    return textureLoad(solid_texture, wrap_coord_160(pos), 0);
}

// Trilinear sample of 160^3 3D velocity + pressure field within active camera window
fn sample_wind_vel(pos: vec3<f32>, cam_pos: vec3<f32>) -> vec4<f32> {
    if (any(abs(pos - cam_pos) > vec3<f32>(77.0))) {
        return vec4<f32>(0.0);
    }
    let b = pos - vec3<f32>(0.5);
    let b0 = floor(b);
    let f = b - b0;
    let c000 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(0.0, 0.0, 0.0)), 0);
    let c100 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(1.0, 0.0, 0.0)), 0);
    let c010 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(0.0, 1.0, 0.0)), 0);
    let c110 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(1.0, 1.0, 0.0)), 0);
    let c001 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(0.0, 0.0, 1.0)), 0);
    let c101 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(1.0, 0.0, 1.0)), 0);
    let c011 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(0.0, 1.0, 1.0)), 0);
    let c111 = textureLoad(vel_texture, wrap_coord_160(b0 + vec3<f32>(1.0, 1.0, 1.0)), 0);
    let cx00 = mix(c000, c100, f.x);
    let cx10 = mix(c010, c110, f.x);
    let cx01 = mix(c001, c101, f.x);
    let cx11 = mix(c011, c111, f.x);
    let cxy0 = mix(cx00, cx10, f.y);
    let cxy1 = mix(cx01, cx11, f.y);
    return mix(cxy0, cxy1, f.z);
}

// True if position is inside solid voxel or below true bedrock floor
fn check_collision(pos: vec3<f32>) -> bool {
    if (pos.y <= -192.0) { return true; }
    let vox = get_voxel(pos);
    return abs(vox.r) > 0.5 && vox.g <= 0.0;
}

// Estimate collision normal using neighboring voxel samples
fn get_normal(pos: vec3<f32>) -> vec3<f32> {
    if (pos.y <= -191.8) { return vec3<f32>(0.0, 1.0, 0.0); }
    let eps = 0.5;
    let s_xp = check_collision(pos + vec3<f32>(eps, 0.0, 0.0));
    let s_xm = check_collision(pos - vec3<f32>(eps, 0.0, 0.0));
    let s_yp = check_collision(pos + vec3<f32>(0.0, eps, 0.0));
    let s_ym = check_collision(pos - vec3<f32>(0.0, eps, 0.0));
    let s_zp = check_collision(pos + vec3<f32>(0.0, 0.0, eps));
    let s_zm = check_collision(pos - vec3<f32>(0.0, 0.0, eps));

    var n = vec3<f32>(
        f32(i32(s_xm) - i32(s_xp)),
        f32(i32(s_ym) - i32(s_yp)),
        f32(i32(s_zm) - i32(s_zp))
    );
    let len = length(n);
    if (len < 0.1) {
        return vec3<f32>(0.0, 1.0, 0.0);
    }
    return n / len;
}

@compute @workgroup_size(64)
fn compute_main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let i = global_id.x;

    // Keep @binding(6) vel_texture & @binding(7) curl_texture live in pipeline layout even when particles are dead
    if (i == 0u && (textureLoad(vel_texture, vec3<i32>(0), 0).x < -999999.0
                 || textureLoad(curl_texture, vec3<i32>(0), 0).x < -999999.0)) {
        atomicAdd(&write_head, 0u);
    }

    // Thread 0 processes any pending spawn requests
    if (i == 0u) {
        let sc = u32(spawn_params[0] + 0.5);
        if (sc > 0u) {
            for (var r = 0u; r < sc && r < MAX_SPAWN_REQUESTS; r++) {
                let req = spawn_queue[r];
                let req_count = u32(req.count + 0.5);
                if (req_count > 0u) {
                    let base = atomicAdd(&write_head, req_count);
                    let vel_len = length(req.vel);
                    let spread_factor = max(req.spread, 0.015);
                    for (var j = 0u; j < req_count; j++) {
                        let slot = (base + j) % MAX_PARTICLES;
                        let seed = (base + j) * 17u + r * 31u + 1u;
                        var np: Particle;
                        let jitter = random_in_sphere(seed);
                        let pos_jit = select(0.2, 0.09, req.ptype >= 100.0 && req.ptype < 300.0);
                        np.pos = req.pos + jitter * pos_jit;
                        
                        // Push slightly out of surface if starting inside solid
                        if (req.ptype < 300.0 && check_collision(np.pos)) {
                            let norm = get_normal(np.pos);
                            np.pos += norm * 0.35;
                        }
                        
                        np.vel = req.vel + jitter * max(vel_len, 2.0) * spread_factor;
                        np.life = req.lifetime * (0.78 + hash(seed + 100u) * 0.44);
                        
                        // Pack lifetime and ptype into max_life_type
                        np.max_life_type = bitcast<f32>(pack2x16float(vec2<f32>(np.life, req.ptype)));
                        
                        particles[slot] = np;
                    }
                }
            }
        }
    }

    if (i >= MAX_PARTICLES) { return; }

    var p = particles[i];
    if (p.life <= 0.0) { return; }

    let dt = time_params[0];
    let cam_pos = vec3<f32>(time_params[1], time_params[2], time_params[3]);

    // Unpack max_life and ptype
    let unpacked = unpack2x16float(bitcast<u32>(p.max_life_type));
    let ptype = u32(unpacked.y + 0.5);

    // Physical properties + aerodynamic vel_texture coupling tailored per particle type
    var grav = -9.8;
    var drag = 0.98;
    var bounciness = 0.55;
    var wind_couple = 4.0;

    if (ptype == 0u) {
        // 0: Sparks - energetic, bouncy, ballistic + turbulent eddy swirl!
        grav = -11.0;
        drag = 0.975;
        bounciness = 0.55;
        wind_couple = 5.4;
    } else if (ptype == 1u) {
        // 1: Dust - light, floats, high air drag, swept & re-suspended by gusts!
        grav = -1.8;
        drag = 0.88;
        bounciness = 0.0;
        wind_couple = 9.8;
    } else if (ptype == 2u) {
        // 2: Debris - heavy rock chunks, resists gentle breeze, launched by shockwaves!
        grav = -15.0;
        drag = 0.985;
        bounciness = 0.30;
        wind_couple = 1.75;
    } else if (ptype == 3u) {
        // 3: Smoke - buoyant plumes sculpted into mushroom clouds & slipstream rings!
        grav = 2.0;
        drag = 0.86;
        bounciness = 0.0;
        wind_couple = 9.5;
    } else if (ptype >= 101u && ptype <= 132u) {
        // 101..132: Pressurized Flask Liquid Stream - matches parabolic raycast arc!
        grav = -18.0;
        drag = 0.996;
        bounciness = 0.25;
        wind_couple = 1.25;
    } else if (ptype >= 201u && ptype <= 232u) {
        // 201..232: Pressurized Gas Bellows Gust / Flamethrower - fast blast that billows upward
        grav = 1.6;
        drag = 0.945;
        bounciness = 0.12;
        wind_couple = 4.2;
    } else if ((ptype >= 301u && ptype <= 390u) || (ptype >= 501u && ptype <= 532u)) {
        // 301..390 & 501..532: Big Succ / Bellows / Solid Sack Vacuum Streaks into nozzle
        grav = 0.0;
        drag = 0.995;
        bounciness = 0.0;
        wind_couple = 0.0;
    } else if (ptype >= 401u && ptype <= 432u) {
        // 401..432: Solid Sack Heavy Chunk Lob / Granular Pour - matches grav -22 raycast arc!
        grav = -22.0;
        drag = 0.994;
        bounciness = 0.28;
        wind_couple = 1.15;
    } else {
        // 4: Magic / Arcane - floaty, low gravity, high ricochet + wake swirl
        grav = -0.5;
        drag = 0.97;
        bounciness = 0.75;
        wind_couple = 5.8;
    }

    // Sample 3D GPU Velocity + Dynamic Pressure Field (vel_texture)
    let wind = sample_wind_vel(p.pos, cam_pos);
    let wind_spd2 = dot(wind.xyz, wind.xyz);
    let air_vel = wind.xyz * 15.5;

    if (wind_couple > 0.01 && (wind_spd2 > 0.0004 || abs(wind.w) > 0.08)) {
        let w_blend = clamp(wind_couple * dt, 0.0, 0.65);
        p.vel = mix(p.vel, air_vel, w_blend);

        if (ptype == 0u || ptype == 4u) {
            // Turbulent eddy swirl on sparks & arcane glints!
            let phase = f32(i % 1024u) * 0.173 + p.life * 11.0;
            let swirl_axis = vec3<f32>(sin(phase), cos(phase * 1.3), cos(phase * 0.7));
            p.vel += cross(wind.xyz, swirl_axis) * (10.5 * dt);
        }
        if (abs(wind.w) > 0.45) {
            let p_eff = clamp(wind.w, -3.8, 4.5);
            let jit_b = random_in_sphere(i * 13u + u32(max(0.0, p.life * 60.0)));
            let kick_scale = clamp(wind_couple * 0.35, 0.30, 2.25);
            p.vel += (wind.xyz * 6.5 + jit_b * (abs(p_eff) * 3.8) + vec3<f32>(0.0, max(0.0, p_eff) * 4.5, 0.0)) * (dt * kick_scale);
        }
    }

    // Exact k-space divergence-free Kolmogorov 3D curl thermals (never clumps into sinks; preserves ballistic liquid/chunk arcs!)
    var eddy_gain: f32 = 0.0;
    if (ptype == 0u) {
        eddy_gain = 5.2 + min(sqrt(wind_spd2) * 4.0, 6.0);
    } else if (ptype == 1u) {
        eddy_gain = 2.8 + min(sqrt(wind_spd2) * 3.2, 4.5);
    } else if (ptype == 3u) {
        eddy_gain = 4.6 + min(sqrt(wind_spd2) * 3.5, 5.0);
    } else if (ptype >= 201u && ptype <= 232u) {
        eddy_gain = 3.8;
    } else if (ptype == 4u) {
        eddy_gain = 4.2;
    }
    if (eddy_gain > 0.01) {
        let time_sec = time_params[4];
        let c0 = sample_curl_p64(p.pos * 1.35 - vec3<f32>(time_sec * 0.90, time_sec * 1.40, 0.0));
        let c1 = sample_curl_p64(p.pos * 3.70 + vec3<f32>(0.0, -time_sec * 2.10, time_sec * 1.20));
        p.vel += (c0 * 0.72 + c1 * 0.36) * (eddy_gain * dt);
    }

    // Apply gravity & air resistance
    p.vel.y += grav * dt;
    p.vel *= pow(drag, dt * 60.0);

    // Predict next position
    let next_pos = p.pos + p.vel * dt;

    // Voxel world collision detection and response (skip for vacuumed siphon streaks)
    let is_vacuum = (ptype >= 300u && ptype < 400u) || (ptype >= 500u && ptype < 600u);
    if (!is_vacuum && check_collision(next_pos)) {
        let n = get_normal(next_pos);
        if (bounciness > 0.05) {
            let vn = dot(p.vel, n);
            if (vn < 0.0) {
                let v_normal = vn * n;
                let v_tangent = p.vel - v_normal;
                p.vel = (-v_normal * bounciness) + (v_tangent * 0.75);
                p.pos = p.pos + p.vel * dt + n * 0.05;
                p.life -= dt * 1.5;
            } else {
                p.pos = next_pos;
            }
        } else {
            // Dust & Smoke: re-suspend off cave floors into swirling plumes when wind/shockwaves pass over!
            if (wind_spd2 > 0.20 || abs(wind.w) > 0.65) {
                p.vel = air_vel * 0.55 + n * (2.2 + sqrt(wind_spd2) * 2.5);
                p.pos = p.pos + n * 0.14;
            } else {
                p.vel = vec3<f32>(0.0);
                p.life -= dt * 1.2;
            }
        }
    } else {
        p.pos = next_pos;
    }

    // Decrement life
    p.life -= dt;

    // Kill if expired or below true bedrock
    if (p.life <= 0.0 || p.pos.y < -240.0) {
        p.life = 0.0;
    }

    particles[i] = p;
}
")

;; ---------------------------------------------------------------------------
;; Billboard Render Shader: Vertex Pulling with Camera-facing Quad Expansion
;; Premultiplied alpha blending: additive glow for sparks/magic, soft alpha for dust/smoke
;; ---------------------------------------------------------------------------
(def particle-render-wgsl
  "struct Particle {
    pos: vec3<f32>,
    life: f32,
    vel: vec3<f32>,
    max_life_type: f32,
}

struct Uniforms {
    view_proj: mat4x4<f32>,
    cam_right: vec4<f32>,
    cam_up:    vec4<f32>,
    cam_pos:   vec4<f32>,
}
@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(1) var<storage, read> particles: array<Particle>;

struct VertexOutput {
    @builtin(position) clip_position: vec4<f32>,
    @location(0) uv: vec2<f32>,
    @location(1) @interpolate(flat) ptype: u32,
    @location(2) t: f32,
}

fn liq_visual(lidx: u32) -> vec4<f32> {
    switch (lidx) {
        case 1u:  { return vec4<f32>(0.18, 0.64, 1.00, 0.0); } // Water
        case 2u:  { return vec4<f32>(1.00, 0.42, 0.08, 1.0); } // Lava (luminescent)
        case 3u:  { return vec4<f32>(0.22, 1.00, 0.32, 1.0); } // Acid (luminescent)
        case 4u:  { return vec4<f32>(0.22, 0.18, 0.14, 0.0); } // Oil
        case 5u:  { return vec4<f32>(0.80, 0.06, 0.08, 0.0); } // Blood
        case 6u:  { return vec4<f32>(1.00, 0.85, 0.24, 1.0); } // Ambrosia (luminescent)
        case 7u:  { return vec4<f32>(0.98, 0.18, 0.74, 1.0); } // Volatile Gel (luminescent)
        case 8u:  { return vec4<f32>(0.38, 0.85, 0.14, 0.0); } // Toxic Sludge
        case 9u:  { return vec4<f32>(0.44, 0.25, 0.09, 0.0); } // Diesel
        case 10u: { return vec4<f32>(0.88, 0.62, 0.14, 0.0); } // Kerosene
        case 11u: { return vec4<f32>(0.96, 0.86, 0.42, 0.0); } // Naphtha
        case 12u: { return vec4<f32>(0.82, 0.86, 0.92, 0.0); } // Mercury
        case 13u: { return vec4<f32>(0.76, 0.68, 0.96, 0.0); } // Lye
        case 14u: { return vec4<f32>(0.98, 0.92, 0.60, 1.0); } // Nitroglycerin (luminescent)
        default:  { return vec4<f32>(0.45, 0.92, 1.00, 1.0); } // Liquid Nitrogen (luminescent)
    }
}

fn gas_visual(gidx: u32) -> vec4<f32> {
    switch (gidx) {
        case 1u:  { return vec4<f32>(0.78, 0.82, 0.88, 0.0); } // Steam
        case 2u:  { return vec4<f32>(0.45, 0.92, 0.15, 0.0); } // Toxic Gas
        case 3u:  { return vec4<f32>(1.00, 0.68, 0.18, 1.0); } // Fire (luminescent)
        case 4u:  { return vec4<f32>(0.24, 0.24, 0.27, 0.0); } // Smoke
        case 5u:  { return vec4<f32>(0.25, 0.88, 0.18, 0.0); } // Acid Vapor
        case 6u:  { return vec4<f32>(0.82, 0.72, 0.58, 0.0); } // Methane
        case 7u:  { return vec4<f32>(1.00, 0.35, 0.05, 1.0); } // Napalm Vapor
        case 8u:  { return vec4<f32>(0.52, 0.86, 0.32, 0.0); } // Spore Cloud
        case 9u:  { return vec4<f32>(0.74, 0.90, 1.00, 0.0); } // Hydrogen
        case 10u: { return vec4<f32>(0.92, 0.72, 0.38, 0.0); } // Butane
        case 11u: { return vec4<f32>(0.68, 0.95, 0.22, 0.0); } // Chlorine
        case 12u: { return vec4<f32>(0.42, 1.00, 0.55, 1.0); } // Radon (luminescent)
        default:  { return vec4<f32>(0.98, 0.94, 0.78, 1.0); } // Acetylene (luminescent)
    }
}

fn solid_visual(sidx: u32) -> vec4<f32> {
    switch (sidx) {
        case 1u:  { return vec4<f32>(0.55, 0.55, 0.56, 0.0); } // Stone
        case 2u:  { return vec4<f32>(0.24, 0.62, 0.28, 0.0); } // Soil
        case 3u:  { return vec4<f32>(0.56, 0.34, 0.17, 0.0); } // Wood
        case 4u:  { return vec4<f32>(0.16, 0.16, 0.18, 0.0); } // Coal
        case 5u:  { return vec4<f32>(0.98, 0.78, 0.18, 0.0); } // Gold
        case 6u:  { return vec4<f32>(0.88, 0.82, 0.60, 0.0); } // Sand
        case 7u:  { return vec4<f32>(0.30, 0.30, 0.36, 0.0); } // Gunpowder
        case 8u:  { return vec4<f32>(0.62, 0.84, 0.98, 0.0); } // Ice
        case 9u:  { return vec4<f32>(0.90, 0.92, 0.98, 0.0); } // Glass
        case 10u: { return vec4<f32>(0.32, 0.92, 0.42, 0.0); } // Slime
        case 11u: { return vec4<f32>(0.92, 0.90, 0.24, 0.0); } // Sponge
        case 12u: { return vec4<f32>(0.92, 0.88, 0.84, 0.0); } // C4
        case 13u: { return vec4<f32>(0.38, 0.96, 0.34, 1.0); } // Spore Pod (luminescent)
        case 14u: { return vec4<f32>(0.15, 0.90, 1.00, 1.0); } // Crystal (luminescent)
        case 15u: { return vec4<f32>(0.76, 0.28, 1.00, 1.0); } // Amethyst (luminescent)
        case 16u: { return vec4<f32>(0.22, 0.16, 0.34, 0.0); } // Obsidian
        case 17u: { return vec4<f32>(0.60, 1.00, 0.20, 1.0); } // Rad-Ore (luminescent)
        case 18u: { return vec4<f32>(0.14, 0.22, 0.28, 1.0); } // Abyssal Seal
        case 19u: { return vec4<f32>(0.10, 0.09, 0.12, 0.0); } // Bitumen
        case 20u: { return vec4<f32>(0.86, 0.89, 0.95, 0.0); } // Sodium
        case 21u: { return vec4<f32>(0.95, 0.94, 0.98, 0.0); } // Salt
        case 22u: { return vec4<f32>(0.96, 0.78, 0.86, 0.0); } // Soap
        case 23u: { return vec4<f32>(0.95, 0.88, 0.12, 0.0); } // Sulfur
        case 24u: { return vec4<f32>(0.38, 0.42, 0.48, 0.0); } // Carbide
        case 25u: { return vec4<f32>(0.96, 0.98, 0.70, 1.0); } // Phosphorus (luminescent)
        case 26u: { return vec4<f32>(0.18, 0.70, 0.28, 0.0); } // Moss
        case 27u: { return vec4<f32>(0.24, 0.56, 0.20, 0.0); } // Vine
        case 28u: { return vec4<f32>(0.66, 0.24, 0.58, 0.0); } // Fungus
        case 29u: { return vec4<f32>(1.00, 0.58, 0.24, 1.0); } // Glow-Bulb (luminescent)
        case 30u: { return vec4<f32>(0.30, 0.78, 0.24, 0.0); } // Foliage
        default:  { return vec4<f32>(0.54, 0.16, 0.18, 0.0); } // Thorn-Briar
    }
}

@vertex fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
    var out: VertexOutput;
    let particle_idx = vi / 6u;
    let corner_idx = vi % 6u;

    if (particle_idx >= 262144u) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let p = particles[particle_idx];

    // Dead particle: discard offscreen
    if (p.life <= 0.0) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let unpacked = unpack2x16float(bitcast<u32>(p.max_life_type));
    let max_life = unpacked.x;
    let ptype = u32(unpacked.y + 0.5);

    if (max_life <= 0.0) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let t = clamp(p.life / max_life, 0.0, 1.0);

    // Quad corners and UVs: 2 triangles (0, 1, 2) and (3, 4, 5)
    var offset = vec2<f32>(-1.0, -1.0);
    var uv = vec2<f32>(0.0, 0.0);
    if (corner_idx == 1u) { offset = vec2<f32>( 1.0, -1.0); uv = vec2<f32>(1.0, 0.0); }
    else if (corner_idx == 2u) { offset = vec2<f32>(-1.0,  1.0); uv = vec2<f32>(0.0, 1.0); }
    else if (corner_idx == 3u) { offset = vec2<f32>(-1.0,  1.0); uv = vec2<f32>(0.0, 1.0); }
    else if (corner_idx == 4u) { offset = vec2<f32>( 1.0, -1.0); uv = vec2<f32>(1.0, 0.0); }
    else if (corner_idx == 5u) { offset = vec2<f32>( 1.0,  1.0); uv = vec2<f32>(1.0, 1.0); }

    // World size per particle type
    var size: f32 = 0.06;
    if (ptype == 0u) {
        // Sparks: snappy sparks that start small and taper
        size = mix(0.02, 0.06, t);
    } else if (ptype == 1u) {
        // Dust: puffs expand from 0.07 to 0.18 as they billow
        size = mix(0.18, 0.07, t);
    } else if (ptype == 2u) {
        // Debris: chunky pebbles
        size = 0.07;
    } else if (ptype == 3u) {
        // Smoke: expands into large clouds
        size = mix(0.30, 0.09, t);
    } else if (ptype >= 101u && ptype <= 132u) {
        // Liquid Squirt droplets: plump pressurized globules that taper slightly
        size = mix(0.065, 0.115, t);
    } else if (ptype >= 201u && ptype <= 232u) {
        // Gas Bellows puffs: start tight at nozzle and billow into fat clouds
        size = mix(0.38, 0.10, t);
    } else if (ptype >= 301u && ptype <= 390u) {
        // Big Succ / Bellows droplets: shrink cleanly as they funnel into the nozzle
        size = mix(0.035, 0.115, t);
    } else if (ptype >= 401u && ptype <= 432u) {
        // Solid Sack clods / grains: chunky solid fragments
        size = mix(0.085, 0.135, t);
    } else if (ptype >= 501u && ptype <= 532u) {
        // Solid Sack dredged chunks: funnel cleanly from mined rock into the Sack!
        size = mix(0.04, 0.13, t);
    } else {
        // Magic: medium glowing motes
        size = mix(0.04, 0.08, t);
    }

    // Billboarding: expand perpendicular to view vector along camera right & up
    let world_pos = p.pos + (u.cam_right.xyz * offset.x + u.cam_up.xyz * offset.y) * size;

    out.clip_position = u.view_proj * vec4<f32>(world_pos, 1.0);
    out.uv = uv;
    out.ptype = ptype;
    out.t = t;
    return out;
}

fn tonemap_glow(color_in: vec3<f32>) -> vec3<f32> {
    let start_comp: f32 = 0.72;
    let desat: f32 = 0.18;
    var c = max(color_in, vec3<f32>(0.0));
    let peak = max(c.r, max(c.g, c.b));
    if (peak < start_comp) { return c; }
    let d = 1.0 - start_comp;
    let new_peak = 1.0 - (d * d) / (peak + d - start_comp);
    c = c * (new_peak / max(peak, 0.0001));
    let g = 1.0 - 1.0 / (desat * (peak - new_peak) + 1.0);
    return mix(c, vec3<f32>(new_peak), g);
}

fn pack_luminous_premul(raw_rgb: vec3<f32>, body_a: f32) -> vec4<f32> {
    let tm = tonemap_glow(raw_rgb * 0.85) * 1.05;
    let peak = max(tm.r, max(tm.g, tm.b));
    let halo_a = peak * mix(0.28, 0.84, clamp(peak, 0.0, 1.0));
    let out_a = clamp(max(body_a, halo_a), 0.0, 0.95);
    return vec4<f32>(tm, out_a);
}

@fragment fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    let d = length(in.uv - vec2<f32>(0.5));
    if (d > 0.5) { discard; }

    let radial = clamp(1.0 - d * 2.0, 0.0, 1.0);
    let core = pow(radial, 2.0);

    if (in.ptype == 0u) {
        // 0: Sparks - burning ember with self-attenuating luminous glow
        let r = mix(0.4, 1.0, in.t);
        let g = mix(0.05, 0.95, in.t * in.t);
        let b = mix(0.0, 0.45, in.t * in.t * in.t);
        let rgb = vec3<f32>(r, g, b) * (core * 2.0);
        return pack_luminous_premul(rgb, 0.0);
    } else if (in.ptype == 1u) {
        // 1: Dust - soft earthy sandstone puff (premultiplied alpha)
        let alpha = in.t * radial * 0.55;
        let rgb = mix(vec3<f32>(0.42, 0.38, 0.33), vec3<f32>(0.74, 0.67, 0.56), in.t);
        return vec4<f32>(rgb * alpha, alpha);
    } else if (in.ptype == 2u) {
        // 2: Debris - slate rock chip
        let alpha = smoothstep(0.4, 0.5, 1.0 - d * 2.0);
        let rgb = mix(vec3<f32>(0.24, 0.23, 0.22), vec3<f32>(0.52, 0.50, 0.47), in.t);
        return vec4<f32>(rgb * alpha, alpha);
    } else if (in.ptype == 3u) {
        // 3: Smoke - soft rising translucent vapor
        let alpha = in.t * radial * 0.40;
        let rgb = mix(vec3<f32>(0.22, 0.22, 0.24), vec3<f32>(0.58, 0.58, 0.60), in.t);
        return vec4<f32>(rgb * alpha, alpha);
    } else if (in.ptype >= 101u && in.ptype <= 132u) {
        // Liquid Squirt Droplet
        let vis = liq_visual(in.ptype - 100u);
        let spec = pow(clamp(1.0 - length(in.uv - vec2<f32>(0.36, 0.64)) * 3.0, 0.0, 1.0), 3.0) * 0.35;
        if (vis.w > 0.5) {
            let rgb = (vis.rgb + vec3<f32>(spec)) * (core * 2.1);
            return pack_luminous_premul(rgb, clamp(core * 0.45, 0.0, 0.85));
        }
        let alpha = clamp(smoothstep(0.05, 0.42, radial) * (0.35 + 0.6 * in.t), 0.0, 0.92);
        let rgb = vis.rgb * (0.75 + 0.35 * radial) + vec3<f32>(spec);
        return vec4<f32>(rgb * alpha, alpha);
    } else if (in.ptype >= 201u && in.ptype <= 232u) {
        // Gas Bellows Puff / Flamethrower Tongue
        let vis = gas_visual(in.ptype - 200u);
        if (vis.w > 0.5) {
            let rgb = vis.rgb * (core * 2.1 * in.t);
            return pack_luminous_premul(rgb, 0.0);
        }
        let alpha = in.t * radial * 0.48;
        return vec4<f32>(vis.rgb * alpha, alpha);
    } else if (in.ptype >= 301u && in.ptype <= 390u) {
        // Big Succ / Bellows Siphon Streak (301..349 Liquids, 351..390 Gases)
        let vis = select(gas_visual(in.ptype - 350u), liq_visual(in.ptype - 300u), in.ptype < 350u);
        let spec = pow(radial, 3.0) * 0.3;
        if (vis.w > 0.5) {
            let rgb = (vis.rgb + vec3<f32>(spec)) * (core * 2.2);
            return pack_luminous_premul(rgb, clamp(core * 0.35, 0.0, 0.80));
        }
        let alpha = clamp(radial * 0.85, 0.0, 0.9);
        let rgb = vis.rgb + vec3<f32>(spec);
        return vec4<f32>(rgb * alpha, alpha);
    } else if ((in.ptype >= 401u && in.ptype <= 432u) || (in.ptype >= 501u && in.ptype <= 532u)) {
        // Solid Sack Chunk (401..432 Pack/Pour, 501..532 Dredge Scoop)
        let sidx = select(in.ptype - 500u, in.ptype - 400u, in.ptype < 500u);
        let vis = solid_visual(sidx);
        let shade = 0.68 + 0.38 * clamp(1.0 - length(in.uv - vec2<f32>(0.35, 0.65)) * 1.6, 0.0, 1.0);
        if (vis.w > 0.5) {
            let rgb = vis.rgb * (core * 2.0 + 0.35);
            return pack_luminous_premul(rgb, smoothstep(0.22, 0.44, radial) * 0.65);
        }
        let alpha = smoothstep(0.22, 0.44, radial);
        let rgb = vis.rgb * shade;
        return vec4<f32>(rgb * alpha, alpha);
    } else {
        // 4: Magic - electric cyan/magenta plasma with self-attenuating luminous glow
        let c = mix(vec3<f32>(0.85, 0.15, 0.95), vec3<f32>(0.12, 0.92, 1.0), in.t);
        let rgb = c * (core * 2.5);
        return pack_luminous_premul(rgb, 0.0);
    }
}
")

;; ---------------------------------------------------------------------------
;; 8,192-Bolt Analytical 3D Sphere / Rail-Lance / Gyre Impostor Pass
;; Zero ECS or per-pixel raymarch overhead; 1 hardware depth-tested draw call!
;; ---------------------------------------------------------------------------
(def bolt-render-wgsl
  "struct BoltGPU {
    pos_rad:   vec4<f32>,
    vel_style: vec4<f32>,
    col_glow:  vec4<f32>,
}

struct Uniforms {
    view_proj: mat4x4<f32>,
    cam_right: vec4<f32>,
    cam_up:    vec4<f32>,
    cam_pos:   vec4<f32>,
}
@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(1) var<storage, read> bolts: array<BoltGPU>;

struct BoltVertexOut {
    @builtin(position) clip_position: vec4<f32>,
    @location(0) local_xy: vec2<f32>,
    @location(1) stretch_time: vec3<f32>,
    @location(2) col_glow: vec4<f32>,
    @location(3) @interpolate(flat) style: u32,
}

@vertex fn vs_main(@builtin(vertex_index) vi: u32) -> BoltVertexOut {
    var out: BoltVertexOut;
    let bolt_idx = vi / 6u;
    let corner_idx = vi % 6u;

    if (bolt_idx >= 8192u) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    let b = bolts[bolt_idx];
    let rad = b.pos_rad.w;
    if (rad <= 0.005) {
        out.clip_position = vec4<f32>(100.0, 100.0, 100.0, 1.0);
        return out;
    }

    var offset = vec2<f32>(-1.0, -1.0);
    if (corner_idx == 1u) { offset = vec2<f32>( 1.0, -1.0); }
    else if (corner_idx == 2u) { offset = vec2<f32>(-1.0,  1.0); }
    else if (corner_idx == 3u) { offset = vec2<f32>(-1.0,  1.0); }
    else if (corner_idx == 4u) { offset = vec2<f32>( 1.0, -1.0); }
    else if (corner_idx == 5u) { offset = vec2<f32>( 1.0,  1.0); }

    let style = u32(max(0.0, round(b.vel_style.w)));
    let vx_scr = dot(b.vel_style.xyz, u.cam_right.xyz);
    let vy_scr = dot(b.vel_style.xyz, u.cam_up.xyz);
    let scr_spd = sqrt(vx_scr * vx_scr + vy_scr * vy_scr);

    var ax1 = u.cam_right.xyz;
    var ax2 = u.cam_up.xyz;
    var stretch: f32 = 1.0;

    if (style == 4u) {
        let half_vec = b.vel_style.xyz * 0.5;
        let dir2 = select(vec2<f32>(1.0, 0.0), vec2<f32>(vx_scr, vy_scr) / scr_spd, scr_spd > 0.001);
        ax2 = -u.cam_right.xyz * dir2.y + u.cam_up.xyz * dir2.x;
        let span_len = max(0.25, length(half_vec) / max(rad, 0.02));
        stretch = span_len;
        let lxy = vec2<f32>(offset.x * stretch, offset.y * 1.50);
        let wpos = b.pos_rad.xyz + half_vec * offset.x + ax2 * (lxy.y * rad);
        let clip4 = u.view_proj * vec4<f32>(wpos, 1.0);
        out.clip_position = clip4;
        out.local_xy = lxy;
        out.stretch_time = vec3<f32>(stretch, u.cam_right.w, clip4.w);
        out.col_glow = b.col_glow;
        out.style = style;
        return out;
    }

    // Style 6: Maelstrom Storm-Eye Seed — compact thrown storm pearl during launch, vanishing into a faint eye once anchored!
    if (style == 6u) {
        let spd3 = length(b.vel_style.xyz);
        let throw_t = clamp(spd3 / 11.0, 0.0, 1.0);
        let seed_rad = mix(0.26, 0.60, throw_t) * clamp(rad * 1.15, 0.80, 1.65);
        if (scr_spd > 0.60 && throw_t > 0.12) {
            let dir2 = vec2<f32>(vx_scr, vy_scr) / scr_spd;
            ax1 = u.cam_right.xyz * dir2.x + u.cam_up.xyz * dir2.y;
            ax2 = -u.cam_right.xyz * dir2.y + u.cam_up.xyz * dir2.x;
            stretch = clamp(1.0 + scr_spd * 0.018, 1.0, 2.25);
        }
        let lxy6 = vec2<f32>(offset.x * stretch, offset.y) * 1.48;
        let wpos6 = b.pos_rad.xyz + ax1 * (lxy6.x * seed_rad) + ax2 * (lxy6.y * seed_rad);
        let clip6 = u.view_proj * vec4<f32>(wpos6, 1.0);
        out.clip_position = clip6;
        out.local_xy = lxy6;
        out.stretch_time = vec3<f32>(stretch, u.cam_right.w, spd3);
        out.col_glow = b.col_glow;
        out.style = style;
        return out;
    }

    // Style 7: Starburst Seed — streaking octagram comet during throw, swelling into a collapsing singularity star during THE BIG SUCC!
    if (style == 7u) {
        let spd7 = length(b.vel_style.xyz);
        let succ_t = clamp(1.0 - spd7 / 6.0, 0.0, 1.0);
        let seed_rad7 = rad * mix(1.05, 2.25, succ_t);
        if (scr_spd > 0.55 && succ_t < 0.75) {
            let dir2 = vec2<f32>(vx_scr, vy_scr) / scr_spd;
            ax1 = u.cam_right.xyz * dir2.x + u.cam_up.xyz * dir2.y;
            ax2 = -u.cam_right.xyz * dir2.y + u.cam_up.xyz * dir2.x;
            stretch = clamp(1.0 + scr_spd * 0.024, 1.0, 2.65);
        }
        let lxy7 = vec2<f32>(offset.x * stretch, offset.y) * 1.85;
        let wpos7 = b.pos_rad.xyz + ax1 * (lxy7.x * seed_rad7) + ax2 * (lxy7.y * seed_rad7);
        let clip7 = u.view_proj * vec4<f32>(wpos7, 1.0);
        out.clip_position = clip7;
        out.local_xy = lxy7;
        out.stretch_time = vec3<f32>(stretch, u.cam_right.w, spd7);
        out.col_glow = b.col_glow;
        out.style = style;
        return out;
    }

    // Style 8: Phase-Wave Crest — wide sweeping crescent wave-blade oriented along travel direction!
    if (style == 8u) {
        let spd8 = length(b.vel_style.xyz);
        if (scr_spd > 0.25) {
            let dir2 = vec2<f32>(vx_scr, vy_scr) / scr_spd;
            ax1 = u.cam_right.xyz * dir2.x + u.cam_up.xyz * dir2.y;
            ax2 = -u.cam_right.xyz * dir2.y + u.cam_up.xyz * dir2.x;
        }
        let lxy8 = vec2<f32>(offset.x * 1.48, offset.y * 2.15);
        let wpos8 = b.pos_rad.xyz + ax1 * (lxy8.x * rad) + ax2 * (lxy8.y * rad);
        let clip8 = u.view_proj * vec4<f32>(wpos8, 1.0);
        out.clip_position = clip8;
        out.local_xy = lxy8;
        out.stretch_time = vec3<f32>(1.0, u.cam_right.w, spd8);
        out.col_glow = b.col_glow;
        out.style = style;
        return out;
    }

    // Style 10 & 11: Supernova Solar Star (10) & Gargantua Black Hole Singularity (11)!
    if (style == 10u || style == 11u) {
        let lxy10 = offset * 2.52;
        let wpos10 = b.pos_rad.xyz + ax1 * (lxy10.x * rad) + ax2 * (lxy10.y * rad);
        let clip10 = u.view_proj * vec4<f32>(wpos10, 1.0);
        out.clip_position = clip10;
        out.local_xy = lxy10;
        out.stretch_time = vec3<f32>(1.0, u.cam_right.w, rad);
        out.col_glow = b.col_glow;
        out.style = style;
        return out;
    }

    // Style 9: Ophanim Gyro-Mill — two massive interlocking +/-45 deg counter-rotating saw-wheels around an all-seeing shear eye!
    if (style == 9u) {
        let spd9 = length(b.vel_style.xyz);
        let throw9 = clamp((spd9 - 4.0) / 20.0, 0.0, 1.0);
        let open_scale = mix(3.95, 1.95, throw9);
        let lxy9 = offset * 2.48;
        let wpos9 = b.pos_rad.xyz + ax1 * (lxy9.x * rad * open_scale * 0.48) + ax2 * (lxy9.y * rad * open_scale * 0.48);
        let clip9 = u.view_proj * vec4<f32>(wpos9, 1.0);
        out.clip_position = clip9;
        out.local_xy = lxy9;
        out.stretch_time = vec3<f32>(1.0, u.cam_right.w, spd9);
        out.col_glow = b.col_glow;
        out.style = style;
        return out;
    }

    // Style 12: Chakram Razor-Ring & Style 13: Caltrop Proximity Mine!
    if (style == 12u || style == 13u) {
        let spd12 = length(b.vel_style.xyz);
        let qscale = select(1.78, 1.92, style == 12u);
        let lxy12 = offset * qscale;
        let wpos12 = b.pos_rad.xyz + ax1 * (lxy12.x * rad) + ax2 * (lxy12.y * rad);
        let clip12 = u.view_proj * vec4<f32>(wpos12, 1.0);
        out.clip_position = clip12;
        out.local_xy = lxy12;
        out.stretch_time = vec3<f32>(1.0, u.cam_right.w, spd12);
        out.col_glow = b.col_glow;
        out.style = style;
        return out;
    }

    if (scr_spd > 0.45 && (style == 1u || style == 5u || scr_spd > 68.0)) {
        let dir2 = vec2<f32>(vx_scr, vy_scr) / scr_spd;
        ax1 = u.cam_right.xyz * dir2.x + u.cam_up.xyz * dir2.y;
        ax2 = -u.cam_right.xyz * dir2.y + u.cam_up.xyz * dir2.x;
        if (style == 1u) {
            stretch = clamp(2.85 + scr_spd * 0.038, 2.85, 8.60);
        } else if (style == 5u) {
            stretch = clamp(1.0 + max(0.0, scr_spd - 4.5) * 0.032, 1.0, 2.05);
        } else {
            stretch = clamp(1.0 + (scr_spd - 68.0) * 0.022, 1.0, 2.65);
        }
    }

    let halo_scale = select(select(1.22, 1.58, b.col_glow.w >= 0.5 || style == 3u || style == 5u), 2.10, style == 1u);
    let local_xy = vec2<f32>(offset.x * stretch, offset.y) * halo_scale;
    let world_pos = b.pos_rad.xyz + ax1 * (local_xy.x * rad) + ax2 * (local_xy.y * rad);
    let clip0 = u.view_proj * vec4<f32>(world_pos, 1.0);

    out.clip_position = clip0;
    out.local_xy = local_xy;
    out.stretch_time = vec3<f32>(stretch, u.cam_right.w, clip0.w);
    out.col_glow = b.col_glow;
    out.style = style;
    return out;
}

fn tonemap_glow(color_in: vec3<f32>) -> vec3<f32> {
    let start_comp: f32 = 0.72;
    let desat: f32 = 0.18;
    var c = max(color_in, vec3<f32>(0.0));
    let peak = max(c.r, max(c.g, c.b));
    if (peak < start_comp) { return c; }
    let d = 1.0 - start_comp;
    let new_peak = 1.0 - (d * d) / (peak + d - start_comp);
    c = c * (new_peak / max(peak, 0.0001));
    let g = 1.0 - 1.0 / (desat * (peak - new_peak) + 1.0);
    return mix(c, vec3<f32>(new_peak), g);
}

fn pack_luminous_premul(raw_rgb: vec3<f32>, body_a: f32) -> vec4<f32> {
    let tm = tonemap_glow(raw_rgb * 0.85) * 1.05;
    let peak = max(tm.r, max(tm.g, tm.b));
    let halo_a = peak * mix(0.28, 0.84, clamp(peak, 0.0, 1.0));
    let out_a = clamp(max(body_a, halo_a), 0.0, 0.95);
    return vec4<f32>(tm, out_a);
}

@fragment fn fs_main(in: BoltVertexOut) -> @location(0) vec4<f32> {
    let half_seg = max(0.0, in.stretch_time.x - 1.0);
    let cx = clamp(in.local_xy.x, -half_seg, half_seg);
    let q = vec2<f32>(in.local_xy.x - cx, in.local_xy.y);
    let r = length(q);
    let max_r = select(1.58, 2.55, in.style == 1u || in.style >= 7u);
    if (r > max_r) { discard; }

    let base_col = max(in.col_glow.rgb, vec3<f32>(0.02));
    let glow_amt = in.col_glow.w;
    let t = in.stretch_time.y;

    // Style 12: Chakram — waist-tilted high-RPM 12-tooth annular razor-ring with hollow center & specular steel sheen!
    if (in.style == 12u) {
        let tilt = 1.52 + 0.16 * sin(t * 8.5);
        let cq = vec2<f32>(q.x, q.y * tilt);
        let rc = length(cq);
        let cang = atan2(cq.y, cq.x);
        let teeth = 0.50 + 0.50 * sin(cang * 12.0 - t * 68.0 - rc * 3.4);
        let inner_bevel = exp(-pow((rc - 0.72) * 6.8, 2.0));
        let blade_band = smoothstep(0.56, 0.70, rc) * smoothstep(1.30, 0.98, rc);
        let saw_rim = exp(-pow((rc - 1.12) * 5.6, 2.0)) * (0.68 + 0.78 * teeth);
        let glint = pow(max(0.0, cos(cang * 2.0 + t * 24.0)), 4.0) * blade_band;
        let ring_sum = blade_band * 0.78 + inner_bevel * 0.95 + saw_rim;
        let alpha = clamp(ring_sum * 0.94, 0.0, 0.97);
        if (alpha < 0.015) { discard; }
        let steel_tint = mix(base_col, vec3<f32>(0.68, 0.96, 1.0), 0.35);
        let hot_edge = mix(steel_tint, vec3<f32>(1.0, 0.995, 0.98), clamp(inner_bevel * 0.85 + saw_rim * 0.72 + glint * 0.65, 0.0, 1.0));
        let corona = steel_tint * (saw_rim * 1.55 + inner_bevel * 1.15 + exp(-abs(rc - 0.95) * 2.8) * 0.48);
        return pack_luminous_premul(hot_edge * alpha + corona, alpha);
    }

    // Style 13: Caltrop Proximity Mine — tumbling 4-prong tetrahedral steel spikes + pulsing armed sensor beacon!
    if (in.style == 13u) {
        let spd13 = in.stretch_time.z;
        let armed = clamp(1.0 - spd13 * 0.32, 0.0, 1.0);
        let spin_a = mix(t * 22.0, 0.38, armed);
        let cs = cos(spin_a);
        let sn = sin(spin_a);
        let rq = vec2<f32>(q.x * cs - q.y * sn, q.x * sn + q.y * cs);
        let ang13 = atan2(rq.y, rq.x);
        let prongs4 = pow(max(0.0, cos(ang13 * 4.0)), 6.0) * smoothstep(1.48, 0.14, r);
        let diag_x = (exp(-pow((rq.x - rq.y * 0.45) * 7.5, 2.0)) + exp(-pow((rq.y + rq.x * 0.45) * 7.5, 2.0))) * smoothstep(1.22, 0.18, r);
        let hub = exp(-r * r * 7.2);
        let strobe = 0.45 + 0.55 * sin(t * 15.0);
        let prox_ring = armed * exp(-pow((r - 1.24) * 7.5, 2.0)) * (0.28 + 0.52 * strobe);
        let metal_body = clamp(prongs4 * 1.15 + diag_x * 0.58 + hub * 0.95, 0.0, 1.0);
        let alpha = clamp(metal_body * 0.96 + prox_ring * 0.65, 0.0, 0.98);
        if (alpha < 0.015) { discard; }
        let iron_col = mix(vec3<f32>(0.52, 0.56, 0.64), base_col, 0.52);
        let beacon_col = mix(base_col, vec3<f32>(1.0, 0.28, 0.12), armed * 0.62);
        let surf_rgb = mix(iron_col * (0.55 + 0.65 * prongs4), vec3<f32>(1.0, 0.97, 0.92), clamp(hub * (0.55 + 0.45 * strobe) + prongs4 * 0.35, 0.0, 1.0));
        let glow_rgb = beacon_col * (hub * (0.85 + 1.35 * armed * strobe) + prox_ring * 1.65 + prongs4 * 0.55);
        return pack_luminous_premul(surf_rgb * metal_body + glow_rgb, alpha);
    }

    // Style 10: Supernova Solar Star — roiling convective photosphere + whipping prominence loops + blue-white core-collapse flash!
    if (in.style == 10u) {
        let ang = atan2(q.y, q.x);
        let pinch = clamp((0.88 - in.stretch_time.z) * 2.2, 0.0, 1.0);
        let cell1 = sin(q.x * 7.2 + t * 4.8) * cos(q.y * 7.2 - t * 4.3);
        let cell2 = sin((q.x * 0.8 - q.y * 0.6) * 12.5 - t * 8.2) * cos((q.x * 0.6 + q.y * 0.8) * 11.5 + t * 7.4);
        let gran = 0.55 + 0.30 * cell1 + 0.22 * cell2;
        let sphere_mask = smoothstep(1.06, 0.86, r);
        let limb = exp(-pow((r - 0.95) * 7.2, 2.0));
        let prom_wave = sin(ang * 7.0 + t * 5.6 + sin(r * 4.8 - t * 9.5) * 1.4);
        let prom = pow(max(0.0, prom_wave), 3.0) * exp(-max(0.0, r - 0.88) * 2.15) * smoothstep(0.55, 0.96, r);
        let rays = (0.55 + 0.45 * sin(ang * 13.0 - t * 3.8)) * exp(-max(0.0, r - 0.85) * 1.65);
        let alpha = clamp(sphere_mask * 0.97 + limb * 0.65 + prom * 0.78 + rays * 0.32, 0.0, 0.99);
        if (alpha < 0.012) { discard; }
        let sun_base = mix(base_col, vec3<f32>(1.0, 0.66, 0.16), 0.42);
        let pinch_col = mix(sun_base, vec3<f32>(0.68, 0.90, 1.0), pinch * 0.85);
        let surf_hot = clamp(gran * 0.75 + (1.0 - min(r, 1.0)) * 0.62 + limb * 0.55 + pinch * 0.75, 0.0, 1.0);
        let surf_rgb = mix(pinch_col * 0.82, vec3<f32>(1.0, 0.99, 0.94), surf_hot);
        let corona = pinch_col * (limb * 1.65 + prom * 2.10 + rays * 0.95 + exp(-r * 1.15) * (0.72 + pinch * 1.25));
        return pack_luminous_premul(surf_rgb * sphere_mask + corona, alpha);
    }

    // Style 11: Gargantua Black Hole (`Invert` + `Supernova`) — opaque pitch-black Event Horizon + Einstein ring + Doppler accretion disk!
    if (in.style == 11u) {
        let horizon = smoothstep(0.82, 0.72, r);
        let einstein = exp(-pow((r - 0.80) * 14.5, 2.0));
        let dq = vec2<f32>(q.x * 0.948 - q.y * 0.318, q.x * 0.318 + q.y * 0.948);
        let r_disk = length(vec2<f32>(dq.x, dq.y * 3.65));
        let disk_ang = atan2(dq.y * 3.65, dq.x);
        let swirl = 0.62 + 0.38 * sin(disk_ang * 5.0 - t * 18.0 + r_disk * 7.5);
        let disk_band = exp(-pow((r_disk - 1.38) * 2.55, 2.0)) * swirl * smoothstep(0.68, 0.86, r);
        let r_lens = length(vec2<f32>(dq.x * 0.96, abs(dq.y) * 1.22));
        let lens_arch = exp(-pow((r_lens - 0.94) * 5.2, 2.0)) * smoothstep(0.74, 0.84, r) * 0.82;
        let doppler = 1.0 + 0.52 * clamp(dq.x * 0.85, -1.0, 1.0);
        let glow_ring = (einstein * 1.55 + disk_band * 1.45 + lens_arch * 1.15) * doppler;
        let void_alpha = clamp(horizon * 0.994 + clamp(glow_ring * 0.52, 0.0, 0.85), 0.0, 0.996);
        if (void_alpha < 0.012 && glow_ring < 0.015) { discard; }
        let bh_tint = mix(base_col, vec3<f32>(0.78, 0.42, 1.0), 0.40);
        let hot_disk = mix(bh_tint, vec3<f32>(1.0, 0.97, 0.92), clamp(einstein * 0.88 + disk_band * 0.55 * doppler, 0.0, 1.0));
        let rgb_out = hot_disk * glow_ring * (1.0 - horizon * 0.97);
        let tm_bh = tonemap_glow(rgb_out * 0.86) * 1.05;
        let bh_peak = max(tm_bh.r, max(tm_bh.g, tm_bh.b));
        let bh_alpha = clamp(max(void_alpha, bh_peak * mix(0.28, 0.84, clamp(bh_peak, 0.0, 1.0))), 0.0, 0.996);
        return vec4<f32>(tm_bh, bh_alpha);
    }

    // Style 9: Ophanim Gyro-Mill — two +/-45 deg counter-rotating 20-tooth diamond saw-wheels + inner gimbal + blazing shear eye!
    if (in.style == 9u) {
        let wob1 = 1.92 + 0.48 * sin(t * 5.8);
        let wob2 = 1.92 + 0.48 * cos(t * 5.8);
        let p1 = vec2<f32>((q.x + q.y) * 0.7071068, (-q.x + q.y) * 0.7071068 * wob1);
        let p2 = vec2<f32>((q.x - q.y) * 0.7071068, (q.x + q.y) * 0.7071068 * wob2);
        let r1 = length(p1);
        let r2 = length(p2);
        let teeth1 = 0.50 + 0.50 * sin(atan2(p1.y, p1.x) * 20.0 + t * 54.0);
        let teeth2 = 0.50 + 0.50 * sin(atan2(p2.y, p2.x) * 20.0 - t * 54.0);
        let wheel1 = exp(-pow((r1 - 1.66) * 4.4, 2.0)) * (0.76 + 0.72 * teeth1);
        let wheel2 = exp(-pow((r2 - 1.66) * 4.4, 2.0)) * (0.76 + 0.72 * teeth2);
        let gimbal = exp(-pow((r - 0.94) * 6.5, 2.0)) * (0.62 + 0.48 * sin(atan2(q.y, q.x) * 14.0 - t * 42.0));
        let x_slash = (exp(-pow((q.x - q.y) * 5.4, 2.0)) + exp(-pow((q.x + q.y) * 5.4, 2.0)))
                    * exp(-r * 0.92) * (0.65 + 0.45 * sin(t * 62.0 - r * 9.5));
        let iris = exp(-pow((r - 0.42) * 6.8, 2.0));
        let eye_core = exp(-r * r * 7.8);
        let slit = smoothstep(0.26, 0.05, length(vec2<f32>(q.x * 2.7, q.y * 0.90)));
        let rings = wheel1 + wheel2 + gimbal * 0.72 + x_slash * 0.78;
        let alpha = clamp(rings * 0.92 + iris * 0.95 + eye_core * 0.92, 0.0, 0.98);
        if (alpha < 0.015) { discard; }
        let gold_tint = mix(base_col, vec3<f32>(1.0, 0.92, 0.55), 0.35);
        let hot = mix(gold_tint, vec3<f32>(1.0, 0.995, 0.97), clamp(rings * 0.68 + iris * 0.90 + eye_core * 0.72, 0.0, 1.0));
        let eye_rgb = mix(hot, base_col * 0.06, slit * 0.88);
        let corona = gold_tint * (rings * 1.75 + iris * 1.75 + exp(-r * 1.25) * 0.65) * (1.0 - 0.62 * slit);
        return pack_luminous_premul(eye_rgb * alpha + corona, alpha);
    }

    // Style 8: Phase-Wave Crest — foaming parabolic bow-wave crescent + turbulent trailing surf ribs!
    if (in.style == 8u) {
        let yn = clamp(q.y * 0.465, -1.0, 1.0);
        let bow_x = 0.42 - 0.68 * yn * yn;
        let dx_bow = q.x - bow_x;
        let span_fade = smoothstep(1.02, 0.18, abs(yn));
        let crest_edge = exp(-pow(dx_bow * 4.4, 2.0)) * span_fade;
        let wake_mask = smoothstep(0.12, -0.95, dx_bow) * smoothstep(-1.45, -0.25, dx_bow) * span_fade;
        let ribs = 0.55 + 0.45 * sin(dx_bow * 11.0 + t * 28.0 + yn * 4.5);
        let foam = crest_edge * (0.82 + 0.25 * sin(yn * 9.0 - t * 22.0));
        let wake_body = wake_mask * ribs * 0.62;
        let alpha = clamp(foam * 0.94 + wake_body * 0.72, 0.0, 0.94);
        if (alpha < 0.015) { discard; }
        let hot = mix(base_col, vec3<f32>(1.0, 0.99, 0.97), clamp(foam * 0.88 + wake_body * 0.22, 0.0, 1.0));
        let corona = base_col * (crest_edge * 1.45 + wake_body * 0.95);
        return pack_luminous_premul(hot * alpha + corona, alpha);
    }

    // Style 6: Maelstrom Storm-Eye Seed — visible compressed storm pearl during throw, vanishing into a faint eye shimmer once anchored!
    if (in.style == 6u) {
        let throw_t = clamp(in.stretch_time.z / 11.0, 0.0, 1.0);
        let ang = atan2(q.y, q.x);
        let spin = 0.5 + 0.5 * sin(ang * 2.0 + t * 16.0 - r * 5.0);
        let seed_core = exp(-r * r * 5.5) * throw_t;
        let eye_ring = exp(-pow((r - 0.72) * 4.2, 2.0)) * (0.11 + 0.70 * throw_t) * (0.65 + 0.35 * spin);
        let alpha = clamp(seed_core * 0.85 + eye_ring * 0.72, 0.0, 0.88);
        let hot = mix(base_col, vec3<f32>(1.0, 0.99, 0.96), clamp(seed_core * 0.75 + eye_ring * 0.25, 0.0, 0.90));
        let corona = base_col * (eye_ring * (0.28 + 0.95 * throw_t) + exp(-r * 2.4) * 0.45 * throw_t);
        return pack_luminous_premul(hot * alpha + corona, alpha);
    }

    // Style 7: Starburst Seed — blazing 8-ray comet during throw, collapsing into an inward-sucking singularity star during THE BIG SUCC!
    if (in.style == 7u) {
        let succ_t = clamp(1.0 - in.stretch_time.z / 6.0, 0.0, 1.0);
        let ang = atan2(q.y, q.x);
        let swirl_ang = ang + succ_t * (1.35 / (r + 0.22));
        let rays8 = pow(0.5 + 0.5 * cos(swirl_ang * 8.0 - t * (26.0 + 22.0 * succ_t)), 3.0) * exp(-r * mix(1.15, 0.78, succ_t));
        let in_wave1 = fract(r * 0.72 + t * 3.8);
        let in_wave2 = fract(r * 0.72 + t * 3.8 + 0.5);
        let succ_rings = succ_t * (exp(-pow((r - in_wave1 * 1.75) * 5.5, 2.0)) * (1.0 - in_wave1)
                                 + exp(-pow((r - in_wave2 * 1.75) * 5.5, 2.0)) * (1.0 - in_wave2));
        let horizon_rim = succ_t * exp(-pow((r - 0.42) * 7.5, 2.0));
        let dark_throat = succ_t * smoothstep(0.40, 0.10, r);
        let star_core = exp(-r * r * 4.8) * (1.0 - 0.88 * dark_throat);
        let alpha = clamp(star_core * 0.95 + dark_throat * 0.92 + rays8 * 0.76 + succ_rings * 0.78 + horizon_rim * 0.88, 0.0, 0.97);
        let bright = mix(base_col, vec3<f32>(1.0, 0.99, 0.96), clamp(star_core * 0.90 + horizon_rim * 0.78 + rays8 * 0.42, 0.0, 1.0));
        let core_rgb = mix(bright, base_col * 0.06, dark_throat * 0.92);
        let corona = base_col * (rays8 * 1.55 + succ_rings * 1.65 + horizon_rim * 1.85 + exp(-r * 1.55) * 0.85) * (1.0 - 0.75 * dark_throat);
        return pack_luminous_premul(core_rgb * alpha + corona, alpha);
    }

    // Style 1: Rail-Lance — incandescent white-hot sabot core + pulsing supersonic Mach shock-rings!
    if (in.style == 1u) {
        let core_spear = exp(-r * r * 3.1);
        let mach_ring = exp(-pow((r - 1.05) * 3.4, 2.0)) * (0.78 + 0.35 * sin(t * 42.0 - r * 9.0));
        let outer_flare = exp(-r * 1.45);
        let alpha = clamp(core_spear * 0.96 + mach_ring * 0.62 + outer_flare * 0.32, 0.0, 0.96);
        let hot = mix(base_col, vec3<f32>(1.0, 0.99, 0.97), clamp(core_spear * 0.92 + mach_ring * 0.38, 0.0, 1.0));
        let corona = base_col * (outer_flare * 1.55 + mach_ring * 1.35);
        return pack_luminous_premul(hot * alpha + corona, alpha);
    }

    // Style 4: Luminous Drill — high-frequency humming laser needle + reagent plasma sheath!
    if (in.style == 4u) {
        let hum = 0.88 + 0.24 * sin(t * 62.0 + in.local_xy.x * 3.5);
        let needle = exp(-r * r * 5.2);
        let sheath = exp(-r * 2.25) * hum;
        let alpha = clamp(needle * 0.92 + sheath * 0.48, 0.0, 0.95);
        let hot = mix(base_col, vec3<f32>(1.0, 0.99, 0.97), clamp(needle * 0.85, 0.0, 1.0));
        return pack_luminous_premul(hot * alpha + base_col * sheath * 1.15, alpha);
    }

    // Style 3: Gyre Vortex — swirling cyclone torus + blazing eye-wall!
    if (in.style == 3u) {
        let ang = atan2(q.y, q.x);
        let spiral = 0.5 + 0.5 * sin(ang * 3.0 - t * 18.0 + r * 5.8);
        let ring = exp(-pow((r - 0.72) * 3.8, 2.0));
        let core_eye = clamp(1.0 - r * 1.35, 0.0, 1.0);
        let alpha = clamp(ring * 0.78 + core_eye * 0.65, 0.0, 0.90);
        let hot = mix(base_col, vec3<f32>(1.0, 0.98, 0.95), core_eye * 0.55 + ring * 0.35);
        let corona = base_col * (exp(-r * 1.85) * (0.95 + 0.55 * spiral) + ring * 1.15);
        return pack_luminous_premul(hot * alpha + corona, alpha);
    }

    // Style 5: Nova / Bulwark — incandescent star-core + rotating hexagonal prism shield-ring!
    if (in.style == 5u) {
        let ang = atan2(q.y, q.x);
        let facets = 0.5 + 0.5 * cos(ang * 6.0 + t * 8.5);
        let star_core = exp(-r * r * 4.2);
        let prism_ring = exp(-pow((r - 0.78) * 4.8, 2.0)) * (0.68 + 0.48 * facets);
        let corona_glow = exp(-r * 1.95);
        let alpha = clamp(star_core * 0.94 + prism_ring * 0.72 + corona_glow * 0.28, 0.0, 0.95);
        let hot = mix(base_col, vec3<f32>(1.0, 0.99, 0.96), clamp(star_core * 0.88 + prism_ring * 0.35, 0.0, 1.0));
        let corona = base_col * (corona_glow * 1.20 + prism_ring * 1.15);
        return pack_luminous_premul(hot * alpha + corona, alpha);
    }

    // Matte / Solid Mineral Slug (glow < 0.5): crisp analytical 3D sphere + subtle kinetic rim
    if (glow_amt < 0.5) {
        if (r > 1.16) { discard; }
        if (r > 1.0) {
            let rim_h = clamp(1.0 - (r - 1.0) / 0.16, 0.0, 1.0);
            return vec4<f32>(base_col * (rim_h * rim_h * 0.22), 0.0);
        }
        let nz = sqrt(max(0.0, 1.0 - r * r));
        let n3 = normalize(vec3<f32>(q.x, q.y, nz));
        let ldir = normalize(vec3<f32>(-0.38, 0.62, 0.68));
        let diff = clamp(dot(n3, ldir), 0.0, 1.0);
        let spec = pow(clamp(dot(n3, normalize(ldir + vec3<f32>(0.0, 0.0, 1.0))), 0.0, 1.0), 18.0) * 0.32;
        let shade = 0.34 + 0.72 * diff;
        let alpha = smoothstep(1.0, 0.90, r);
        let rgb = base_col * shade + vec3<f32>(spec);
        return vec4<f32>(rgb * alpha, alpha);
    }

    // Incandescent Orb / Cluster Mortar: analytical white-hot plasma core + self-attenuating HDR corona!
    let nz = sqrt(max(0.0, 1.0 - min(r * r, 1.0)));
    let body_a = smoothstep(1.04, 0.78, r) * clamp(0.68 + 0.16 * glow_amt, 0.68, 0.92);
    let warhead_pulse = select(1.0, 0.85 + 0.30 * sin(t * 22.0 + r * 8.0), in.style == 2u);
    let hot_core = mix(base_col, vec3<f32>(1.0, 0.99, 0.96), pow(nz, 2.1) * 0.72);
    let halo = exp(-max(0.0, r - 0.35) * 2.55) * (0.75 + 0.45 * glow_amt) * warhead_pulse;
    return pack_luminous_premul(hot_core * body_a + base_col * halo, body_a);
}
")

;; ---------------------------------------------------------------------------
;; 65,536-Slot Camera-Centered Toroidal Tethered Flora & Waving Vines Compute
;;   - 32 x 16 x 32 cells of 2x2x2m (64m x 32m x 64m around camera) x 4 column slots
;;   - Discovers Soil/Moss/Fungus/Spore/Briar/Vine/Leaf/Glow-Bulb surfaces on GPU
;;   - Live voxel stain inheritance (Blood, Oil, Ambrosia, Acid, Wet from vox.b)
;;   - 2nd-order Hookean spring-damper + wind/currents + player & ECS creature parting
;;   - Detached falling & burning 3D ribbons (+ particle sparks when awake) on sever!
;; ---------------------------------------------------------------------------
(def flora-compute-wgsl
  "const FLORA_MAX: u32 = 65536u;
const MAX_PARTICLES: u32 = 262144u;

struct FloraStrand {
    root_pos: vec3<f32>,
    len_kind: u32,
    disp_xz: u32,
    vel_xz: u32,
    cell_hash: u32,
    mat_packed: u32,
}

struct Particle {
    pos: vec3<f32>,
    life: f32,
    vel: vec3<f32>,
    max_life_type: f32,
}

struct Entity {
    pos_type: vec4<f32>,
    extents_rad: vec4<f32>,
    color: vec4<f32>,
}

@group(0) @binding(0) var<storage, read_write> flora: array<FloraStrand>;
@group(0) @binding(1) var<storage, read_write> particles: array<Particle>;
@group(0) @binding(2) var<storage, read_write> write_head: atomic<u32>;
@group(0) @binding(3) var<storage, read> time_params: array<f32>;
@group(0) @binding(4) var solid_texture: texture_3d<f32>;
@group(0) @binding(5) var vel_texture: texture_3d<f32>;
@group(0) @binding(6) var liquid_texture: texture_3d<f32>;
@group(0) @binding(7) var gas_texture: texture_3d<f32>;
@group(0) @binding(8) var<storage, read> s_entities: array<Entity>;
@group(0) @binding(9) var curl_texture: texture_3d<f32>;

fn sample_curl_f64(q: vec3<f32>) -> vec3<f32> {
    let w = q - floor(q / 64.0) * 64.0;
    let i0 = vec3<i32>(floor(w)) & vec3<i32>(63);
    let i1 = (i0 + vec3<i32>(1)) & vec3<i32>(63);
    let f = fract(w);
    let c000 = textureLoad(curl_texture, vec3<i32>(i0.x, i0.y, i0.z), 0).rgb;
    let c100 = textureLoad(curl_texture, vec3<i32>(i1.x, i0.y, i0.z), 0).rgb;
    let c010 = textureLoad(curl_texture, vec3<i32>(i0.x, i1.y, i0.z), 0).rgb;
    let c110 = textureLoad(curl_texture, vec3<i32>(i1.x, i1.y, i0.z), 0).rgb;
    let c001 = textureLoad(curl_texture, vec3<i32>(i0.x, i0.y, i1.z), 0).rgb;
    let c101 = textureLoad(curl_texture, vec3<i32>(i1.x, i0.y, i1.z), 0).rgb;
    let c011 = textureLoad(curl_texture, vec3<i32>(i0.x, i1.y, i1.z), 0).rgb;
    let c111 = textureLoad(curl_texture, vec3<i32>(i1.x, i1.y, i1.z), 0).rgb;
    let cx00 = mix(c000, c100, f.x);
    let cx10 = mix(c010, c110, f.x);
    let cx01 = mix(c001, c101, f.x);
    let cx11 = mix(c011, c111, f.x);
    return mix(mix(cx00, cx10, f.y), mix(cx01, cx11, f.y), f.z);
}

fn pcg_u32(v_in: u32) -> u32 {
    let state = v_in * 747796405u + 2891336453u;
    let word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

fn cell_pcg(wc: vec3<i32>, sub_k: u32) -> u32 {
    let hx = bitcast<u32>(wc.x) * 374761393u;
    let hy = bitcast<u32>(wc.y) * 668265263u;
    let hz = bitcast<u32>(wc.z) * 2246822519u;
    return pcg_u32(hx ^ hy ^ hz ^ (sub_k * 3266489917u + 1013904223u)) | 1u;
}

fn hash01(h: u32) -> f32 {
    return f32(h & 0xFFFFu) / 65535.0;
}

fn wrap_i160(v: vec3<i32>) -> vec3<i32> {
    return ((v % vec3<i32>(160)) + vec3<i32>(160)) % vec3<i32>(160);
}

fn wrap_f160(p: vec3<f32>) -> vec3<i32> {
    let w = p - floor(p / 160.0) * 160.0;
    return vec3<i32>(clamp(w, vec3<f32>(0.0), vec3<f32>(159.0)));
}

fn extract_stain(vox_b: f32) -> u32 {
    if (vox_b >= 2.5) {
        return clamp(u32(round(vox_b)) - 2u, 1u, 8u);
    }
    return 0u;
}

fn sample_wind_trilinear(pos: vec3<f32>, cam_pos: vec3<f32>) -> vec4<f32> {
    if (any(abs(pos - cam_pos) > vec3<f32>(77.0))) {
        return vec4<f32>(0.0);
    }
    let b = pos - vec3<f32>(0.5);
    let b0 = floor(b);
    let f = b - b0;
    let c000 = textureLoad(vel_texture, wrap_f160(b0 + vec3<f32>(0.0, 0.0, 0.0)), 0);
    let c100 = textureLoad(vel_texture, wrap_f160(b0 + vec3<f32>(1.0, 0.0, 0.0)), 0);
    let c010 = textureLoad(vel_texture, wrap_f160(b0 + vec3<f32>(0.0, 1.0, 0.0)), 0);
    let c110 = textureLoad(vel_texture, wrap_f160(b0 + vec3<f32>(1.0, 1.0, 0.0)), 0);
    let c001 = textureLoad(vel_texture, wrap_f160(b0 + vec3<f32>(0.0, 0.0, 1.0)), 0);
    let c101 = textureLoad(vel_texture, wrap_f160(b0 + vec3<f32>(1.0, 0.0, 1.0)), 0);
    let c011 = textureLoad(vel_texture, wrap_f160(b0 + vec3<f32>(0.0, 1.0, 1.0)), 0);
    let c111 = textureLoad(vel_texture, wrap_f160(b0 + vec3<f32>(1.0, 1.0, 1.0)), 0);
    let cx00 = mix(c000, c100, f.x);
    let cx10 = mix(c010, c110, f.x);
    let cx01 = mix(c001, c101, f.x);
    let cx11 = mix(c011, c111, f.x);
    let cxy0 = mix(cx00, cx10, f.y);
    let cxy1 = mix(cx01, cx11, f.y);
    return mix(cxy0, cxy1, f.z);
}

// Attempt to spawn an upward (+Y) floor strand at integer voxel `v`
fn try_floor_anchor(v: vec3<i32>, h_base: u32, out_len: ptr<function, f32>, out_kind: ptr<function, u32>, out_mat: ptr<function, u32>, out_w_mm: ptr<function, u32>, out_sub: ptr<function, u32>, out_stain: ptr<function, u32>, out_y: ptr<function, f32>) -> bool {
    if (v.y <= -191) { return false; }
    let vox = textureLoad(solid_texture, wrap_i160(v), 0);
    if (vox.g > 0.0 || abs(vox.r) < 0.5) { return false; }
    let mat_u = u32(round(abs(vox.r)));
    let is_floor_mat = (mat_u == 2u) || (mat_u == 26u) || (mat_u == 28u) || (mat_u == 13u) || (mat_u == 10u) || (mat_u == 31u);
    if (!is_floor_mat) { return false; }

    let v_up = v + vec3<i32>(0, 1, 0);
    let vox_up = textureLoad(solid_texture, wrap_i160(v_up), 0);
    if (vox_up.g <= 0.08) { return false; }

    let liq_up = textureLoad(liquid_texture, wrap_i160(v_up), 0);
    let liq_id = u32(round(max(0.0, liq_up.r)));
    // Lava (2), Acid (3), Caustic Lye (13), or Liquid Nitrogen (15) suppresses floor sprouts
    if (liq_up.g > 0.25 && (liq_id == 2u || liq_id == 3u || liq_id == 13u || liq_id == 15u)) { return false; }
    let is_sub = select(0u, 1u, liq_up.g > 0.35);
    if (is_sub == 1u && mat_u != 26u && mat_u != 2u) { return false; }

    let h_prob = hash01(pcg_u32(h_base + 17u));
    let h_len = hash01(pcg_u32(h_base + 53u));
    let h_wid = hash01(pcg_u32(h_base + 97u));

    var kind: u32 = 0u;
    var slen: f32 = 0.0;
    var w_mm: u32 = 55u;

    if (mat_u == 2u) {
        if (h_prob > select(0.88, 0.55, is_sub == 1u)) { return false; }
        kind = 1u;
        slen = mix(0.38, 0.92, h_len * h_len * 0.45 + h_len * 0.55);
        w_mm = u32(mix(44.0, 72.0, h_wid));
    } else if (mat_u == 26u) {
        if (h_prob > 0.85) { return false; }
        kind = 2u;
        if (is_sub == 1u) {
            // Submerged Moss -> swaying underwater Kelp frond (probe upward clearance!)
            var max_kelp: f32 = 2.30;
            for (var ky: i32 = 2; ky <= 3; ky = ky + 1) {
                let kv = textureLoad(solid_texture, wrap_i160(v + vec3<i32>(0, ky, 0)), 0);
                if (kv.g <= 0.05) {
                    max_kelp = min(max_kelp, f32(ky) - 0.35);
                }
            }
            slen = min(max_kelp, mix(0.95, 2.30, h_len));
            w_mm = u32(mix(78.0, 118.0, h_wid));
        } else {
            slen = mix(0.28, 0.60, h_len);
            w_mm = u32(mix(58.0, 88.0, h_wid));
        }
    } else if (mat_u == 31u) {
        if (h_prob > 0.78) { return false; }
        kind = 4u;
        slen = mix(0.45, 0.95, h_len);
        w_mm = u32(mix(56.0, 86.0, h_wid));
    } else {
        // Fungus (28), Spore Pod (13), Slime (10) -> Bioluminescent Spore-Stalk!
        if (h_prob > 0.68) { return false; }
        kind = 3u;
        slen = mix(0.30, 0.72, h_len);
        w_mm = u32(mix(46.0, 74.0, h_wid));
    }

    let t_zero = clamp(-vox.g / max(vox_up.g - vox.g, 0.01), 0.0, 0.92);
    *out_len = slen;
    *out_kind = kind;
    *out_mat = mat_u;
    *out_w_mm = w_mm;
    *out_sub = is_sub;
    *out_stain = extract_stain(vox.b);
    *out_y = f32(v.y) + 0.5 + t_zero - 0.06;
    return true;
}

// Attempt to spawn a hanging (-Y) ceiling/canopy strand at integer voxel `v`
fn try_ceil_anchor(v: vec3<i32>, h_base: u32, out_len: ptr<function, f32>, out_kind: ptr<function, u32>, out_mat: ptr<function, u32>, out_w_mm: ptr<function, u32>, out_sub: ptr<function, u32>, out_stain: ptr<function, u32>, out_y: ptr<function, f32>) -> bool {
    if (v.y <= -189) { return false; }
    let vox = textureLoad(solid_texture, wrap_i160(v), 0);
    if (vox.g > 0.0 || abs(vox.r) < 0.5) { return false; }
    let mat_u = u32(round(abs(vox.r)));
    let is_vine_mat = (mat_u == 27u) || (mat_u == 30u) || (mat_u == 26u);
    let is_glow_mat = (mat_u == 29u) || (mat_u == 13u);
    if (!is_vine_mat && !is_glow_mat) { return false; }

    let v_dn = v + vec3<i32>(0, -1, 0);
    let vox_dn = textureLoad(solid_texture, wrap_i160(v_dn), 0);
    if (vox_dn.g <= 0.12) { return false; }

    let h_prob = hash01(pcg_u32(h_base + 31u));
    var chance: f32 = 0.36;
    if (mat_u == 27u) { chance = 0.72; }
    else if (mat_u == 29u) { chance = 0.78; }
    else if (mat_u == 26u) { chance = 0.42; }
    else if (mat_u == 30u) { chance = 0.34; }
    if (h_prob > chance) { return false; }

    // Probe 1..5 voxels downward so hanging vines/tendrils never poke into cave floors!
    var max_clear: f32 = 5.0;
    for (var step_d: i32 = 2; step_d <= 5; step_d = step_d + 1) {
        let pv = textureLoad(solid_texture, wrap_i160(v + vec3<i32>(0, -step_d, 0)), 0);
        if (pv.g <= 0.05) {
            max_clear = f32(step_d) - 0.25;
            break;
        }
    }
    if (max_clear < 1.05) { return false; }

    let h_len = hash01(pcg_u32(h_base + 71u));
    let h_wid = hash01(pcg_u32(h_base + 113u));
    let liq_dn = textureLoad(liquid_texture, wrap_i160(v_dn), 0);
    let is_sub = select(0u, 1u, liq_dn.g > 0.35);

    var kind: u32 = 5u;
    var raw_l: f32 = 1.2;
    var w_mm: u32 = 75u;
    if (is_glow_mat) {
        kind = 6u;
        raw_l = mix(0.85, 3.20, h_len);
        w_mm = u32(mix(48.0, 74.0, h_wid));
    } else {
        kind = 5u;
        raw_l = mix(1.10, 4.60, h_len);
        w_mm = u32(mix(72.0, 112.0, h_wid));
    }
    let clamped_l = min(raw_l, max_clear - 0.20);
    if (clamped_l < 0.75) { return false; }

    let t_zero = clamp(-vox.g / max(vox_dn.g - vox.g, 0.01), 0.0, 0.92);
    *out_len = -clamped_l;
    *out_kind = kind;
    *out_mat = mat_u;
    *out_w_mm = w_mm;
    *out_sub = is_sub;
    *out_stain = extract_stain(vox.b);
    *out_y = f32(v.y) + 0.5 - t_zero + 0.06;
    return true;
}

@compute @workgroup_size(64)
fn compute_main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let i = global_id.x;
    if (i >= FLORA_MAX) { return; }

    let dt = clamp(time_params[0], 0.001, 0.05);
    let cam_pos = vec3<f32>(time_params[1], time_params[2], time_params[3]);
    let time_sec = time_params[4];
    let player_vxz = vec2<f32>(time_params[5], time_params[6]);
    let frame_u = u32(max(0.0, time_params[7]));
    let ent_cnt = min(u32(max(0.0, time_params[8])), 96u);
    let particles_awake = time_params[9] > 0.5;

    // Keep all 10 bindings live in WebGPU auto-layout
    if (i == 0u && (textureLoad(vel_texture, vec3<i32>(0), 0).x < -999999.0
                 || textureLoad(liquid_texture, vec3<i32>(0), 0).x < -999999.0
                 || textureLoad(gas_texture, vec3<i32>(0), 0).x < -999999.0
                 || textureLoad(curl_texture, vec3<i32>(0), 0).x < -999999.0
                 || s_entities[0].pos_type.x < -999999.0)) {
        let dummy_idx = atomicAdd(&write_head, 0u) % MAX_PARTICLES;
        particles[dummy_idx].life = particles[dummy_idx].life;
    }

    let cell_idx = i >> 2u;
    let sub_k = i & 3u;
    let lx = i32(cell_idx & 31u);
    let lz = i32((cell_idx >> 5u) & 31u);
    let ly = i32((cell_idx >> 10u) & 15u);

    let grid_dim = vec3<i32>(32, 16, 32);
    let base_c = vec3<i32>(floor(cam_pos * 0.5)) - vec3<i32>(16, 8, 16);
    let rem_c = ((base_c % grid_dim) + grid_dim) % grid_dim;
    let off_c = ((vec3<i32>(lx, ly, lz) - rem_c) + grid_dim) % grid_dim;
    let wc = base_c + off_c;
    let expected_hash = cell_pcg(wc, sub_k);

    var s = flora[i];
    let same_cell = (s.cell_hash == expected_hash);

    // Case 2: Active or Detached-Falling strand in unchanged world cell!
    if (same_cell && s.len_kind != 0u) {
        let lk = unpack2x16float(s.len_kind);
        let signed_len = lk.x;
        let raw_kind = u32(lk.y + 0.5);
        let mp = s.mat_packed;

        // Case 2a: Detached Falling / Burning Ribbon (`raw_kind >= 9u`) — animates even when particles[] is asleep!
        if (raw_kind >= 9u) {
            var curl_vy = unpack2x16float(s.disp_xz);
            var vxz = unpack2x16float(s.vel_xz);
            let burn_u = (mp >> 16u) & 1u;
            let wind_f = sample_wind_trilinear(s.root_pos, cam_pos);
            let eddy3 = sample_curl_f64(s.root_pos * 1.65 - vec3<f32>(time_sec * 1.10, time_sec * 1.50, 0.0));

            var vy = clamp(curl_vy.y - 9.2 * dt + (wind_f.y * 4.5 + eddy3.y * 3.4) * dt, -14.0, 8.0);
            vxz = mix(vxz, vec2<f32>(wind_f.x, wind_f.z) * 11.5 + vec2<f32>(eddy3.x, eddy3.z) * 2.8, clamp(3.6 * dt, 0.0, 0.48));
            var next_p = s.root_pos + vec3<f32>(vxz.x, vy, vxz.y) * dt;

            let hit_vox = textureLoad(solid_texture, wrap_f160(next_p), 0);
            if (abs(hit_vox.r) > 0.5 && hit_vox.g <= 0.0) {
                vy = max(0.0, -vy * 0.25);
                vxz = vxz * 0.55;
                next_p = vec3<f32>(next_p.x, s.root_pos.y + 0.02, next_p.z);
            }

            let abs_l = abs(signed_len);
            let shrink = select(0.72, 1.18, burn_u == 1u) * (0.45 + 0.55 * abs_l);
            let next_abs = abs_l - shrink * dt;
            if (next_abs < 0.06) {
                s.len_kind = 0u;
                s.disp_xz = 0u;
                s.vel_xz = 0u;
                flora[i] = s;
                return;
            }

            let next_curl = clamp(curl_vy.x + (vxz.x * 0.25 + eddy3.x * 0.95 + sin(time_sec * 6.5 + f32(i & 63u)) * 0.30) * dt, -0.85, 0.85);
            let next_signed = select(-next_abs, next_abs, signed_len > 0.0);
            s.root_pos = next_p;
            s.len_kind = pack2x16float(vec2<f32>(next_signed, f32(raw_kind)));
            s.disp_xz = pack2x16float(vec2<f32>(next_curl, vy));
            s.vel_xz = pack2x16float(vxz);
            flora[i] = s;
            return;
        }

        let kind = raw_kind;
        let mat_id = mp & 255u;
        let oct = (mp >> 17u) & 7u;
        let anchor_v = wc * 2 + vec3<i32>(i32(oct & 1u), i32((oct >> 1u) & 1u), i32((oct >> 2u) & 1u));
        let vox = textureLoad(solid_texture, wrap_i160(anchor_v), 0);
        let dir_y = select(-1, 1, signed_len > 0.0);
        let vox_air = textureLoad(solid_texture, wrap_i160(anchor_v + vec3<i32>(0, dir_y, 0)), 0);

        // Root mined, blasted, burned, or dissolved -> detach into falling/burning 3D ribbon (+ sparks if awake)!
        if (abs(vox.r) < 0.5 || vox.g > 0.05) {
            let disp0 = unpack2x16float(s.disp_xz);
            let vel2 = unpack2x16float(s.vel_xz);
            let wind_cut = sample_wind_trilinear(s.root_pos, cam_pos);
            let g0 = textureLoad(gas_texture, wrap_i160(anchor_v), 0);
            let g1 = textureLoad(gas_texture, wrap_i160(anchor_v + vec3<i32>(0, dir_y, 0)), 0);
            let l0 = textureLoad(liquid_texture, wrap_i160(anchor_v), 0);
            let gid0 = u32(round(max(0.0, g0.r)));
            let gid1 = u32(round(max(0.0, g1.r)));
            let is_burned = (g0.g > 0.05 && (gid0 == 3u || gid0 == 7u))
                         || (g1.g > 0.05 && (gid1 == 3u || gid1 == 7u))
                         || (l0.g > 0.15 && u32(round(max(0.0, l0.r))) == 2u)
                         || (wind_cut.w > 0.68);

            let j1 = hash01(pcg_u32(expected_hash + frame_u * 19u)) - 0.5;
            let j2 = hash01(pcg_u32(expected_hash + frame_u * 37u)) - 0.5;

            if (particles_awake) {
                let slot_p = atomicAdd(&write_head, 1u) % MAX_PARTICLES;
                var np: Particle;
                np.pos = s.root_pos + vec3<f32>(0.0, signed_len * 0.45, 0.0);
                np.vel = vec3<f32>(vel2.x * 0.75 + wind_cut.x * 5.0 + j1 * 3.2, 2.2 + abs(j1) * 2.4 + max(0.0, wind_cut.y * 4.0), vel2.y * 0.75 + wind_cut.z * 5.0 + j2 * 3.2);
                np.life = 1.55 + abs(j2) * 0.75;
                let clip_ptype = select(f32(400u + clamp(mat_id, 1u, 31u)), 0.0, is_burned);
                np.max_life_type = bitcast<f32>(pack2x16float(vec2<f32>(np.life, clip_ptype)));
                particles[slot_p] = np;
            }

            let vy0 = select(-0.35, 1.55 + abs(j1) * 1.5, signed_len > 0.0) + wind_cut.y * 3.5;
            let vxz0 = vec2<f32>(vel2.x * 0.65 + wind_cut.x * 4.2 + j1 * 2.2, vel2.y * 0.65 + wind_cut.z * 4.2 + j2 * 2.2);
            s.len_kind = pack2x16float(vec2<f32>(signed_len, f32(kind + 8u)));
            s.mat_packed = (mp & ~(1u << 16u)) | (select(0u, 1u, is_burned) << 16u);
            s.disp_xz = pack2x16float(vec2<f32>(disp0.x, vy0));
            s.vel_xz = pack2x16float(vxz0);
            flora[i] = s;
            return;
        }

        // Buried under newly poured sand/stone -> quietly tuck away
        if (vox_air.g <= -0.05) {
            s.len_kind = 0u;
            s.disp_xz = 0u;
            s.vel_xz = 0u;
            flora[i] = s;
            return;
        }

        // Live sync submergence bit (16) and voxel stain (bits 20..23: Blood, Oil, Ambrosia, Acid, Wet)!
        let liq_now = textureLoad(liquid_texture, wrap_i160(anchor_v + vec3<i32>(0, dir_y, 0)), 0);
        let sub_now = select(0u, 1u, liq_now.g > 0.35);
        let stain_now = extract_stain(vox.b);
        s.mat_packed = (mp & ~((1u << 16u) | (15u << 20u))) | (sub_now << 16u) | (stain_now << 20u);

        var disp = unpack2x16float(s.disp_xz);
        var vel = unpack2x16float(s.vel_xz);
        let abs_l = abs(signed_len);

        var k_spring: f32 = 22.0;
        var damp: f32 = 3.8;
        var wind_gain: f32 = 5.2;
        if (kind == 2u) {
            k_spring = select(18.0, 6.5, sub_now == 1u);
            damp = select(4.2, 5.5, sub_now == 1u);
            wind_gain = select(4.8, 7.5, sub_now == 1u);
        } else if (kind == 3u) {
            k_spring = 28.0;
            damp = 3.2;
            wind_gain = 3.8;
        } else if (kind == 4u) {
            k_spring = 42.0;
            damp = 5.0;
            wind_gain = 2.8;
        } else if (kind == 5u) {
            k_spring = 9.5;
            damp = 2.4;
            wind_gain = 6.2;
        } else if (kind == 6u) {
            k_spring = 7.5;
            damp = 2.1;
            wind_gain = 5.8;
        }

        let probe_p = s.root_pos + vec3<f32>(disp.x * 0.6, signed_len * 0.65, disp.y * 0.6);
        let wind = sample_wind_trilinear(probe_p, cam_pos);
        let ph = f32((mp >> 24u) & 255u) * 0.02464;
        let gust_amp = select(0.42, 1.05, sub_now == 1u) * (0.65 + 0.35 * abs_l);
        let gust3 = sample_curl_f64(s.root_pos * 0.62 - vec3<f32>(time_sec * 1.35, 0.0, time_sec * 0.78));
        let breeze = (vec2<f32>(
            sin(time_sec * 1.85 + s.root_pos.x * 0.23 + s.root_pos.z * 0.17 + ph),
            cos(time_sec * 1.48 + s.root_pos.z * 0.27 - s.root_pos.x * 0.14 + ph)
        ) * 0.58 + vec2<f32>(gust3.x, gust3.z) * 1.65) * gust_amp;

        // Radial shockwave pressure kick from explosions / wands (vel_texture.w)
        var force_xz = vec2<f32>(wind.x, wind.z) * wind_gain + breeze;
        if (abs(wind.w) > 0.25) {
            let out_v = vec2<f32>(disp.x + cos(ph) * 0.2, disp.y + sin(ph) * 0.2);
            let out_l = max(length(out_v), 0.05);
            force_xz += (out_v / out_l) * clamp(wind.w * 4.5, -14.0, 18.0);
        }

        // 1. Player boot / body parting & sprint slipstream!
        let strand_mid = s.root_pos + vec3<f32>(0.0, clamp(signed_len * 0.35, -1.35, 0.55), 0.0);
        let body_p = cam_pos - vec3<f32>(0.0, 0.85, 0.0);
        let d_vec = strand_mid - body_p;
        let dist_b = length(d_vec);
        if (dist_b < 1.38) {
            let h_dir = vec2<f32>(d_vec.x, d_vec.z);
            let h_len = length(h_dir);
            let push_dir = select(vec2<f32>(cos(ph), sin(ph)), h_dir / max(h_len, 0.001), h_len > 0.02);
            let push_w = 1.0 - dist_b / 1.38;
            force_xz += push_dir * (push_w * push_w * 16.5) + player_vxz * (push_w * 0.85);
        }

        // 2. ECS Creatures & Rigidbodies (Slimes, Hoppers, Ecomancers, Boulders) parting tall grass & vines!
        for (var ei: u32 = 0u; ei < ent_cnt; ei = ei + 1u) {
            let ent = s_entities[ei];
            let erad = select(ent.extents_rad.w, length(ent.extents_rad.xyz), abs(ent.pos_type.w - 1.0) < 0.25);
            if (erad > 0.14) {
                let reach = clamp(erad * 1.48 + 0.44, 0.55, 3.40);
                let ed = strand_mid - ent.pos_type.xyz;
                if (abs(ed.x) < reach && abs(ed.z) < reach && abs(ed.y) < (reach + 0.45)) {
                    let ed_len = length(ed);
                    if (ed_len < reach) {
                        let eh = vec2<f32>(ed.x, ed.z);
                        let eh_l = length(eh);
                        let ep_dir = select(vec2<f32>(cos(ph), sin(ph)), eh / max(eh_l, 0.001), eh_l > 0.02);
                        let ep_w = 1.0 - ed_len / reach;
                        force_xz += ep_dir * (ep_w * ep_w * 16.0);
                    }
                }
            }
        }

        let accel = force_xz - disp * k_spring - vel * damp;
        vel = clamp(vel + accel * dt, vec2<f32>(-14.0), vec2<f32>(14.0));
        disp = disp + vel * dt;
        let max_d = 0.86 * abs_l;
        let d_len = length(disp);
        if (d_len > max_d && d_len > 0.0001) {
            disp = disp * (max_d / d_len);
            vel = vel * 0.65;
        }

        s.disp_xz = pack2x16float(disp);
        s.vel_xz = pack2x16float(vel);
        flora[i] = s;
        return;
    }

    // Empty slot in unchanged cell: stagger re-probe once every 16 frames (handles async chunk stream-in & newly placed Soil/Moss!)
    if (same_cell && ((frame_u + i) & 15u) != 0u) {
        return;
    }

    // Case 1: Newly wrapped cell (or staggered empty-slot check) -> deterministic column probe!
    let dx = i32(sub_k & 1u);
    let dz = i32((sub_k >> 1u) & 1u);
    let dy_first = i32((expected_hash >> 3u) & 1u);
    let prefer_ceil = (sub_k >= 2u);

    var spawned = false;
    var out_len: f32 = 0.0;
    var out_kind: u32 = 0u;
    var out_mat: u32 = 0u;
    var out_w_mm: u32 = 55u;
    var out_sub: u32 = 0u;
    var out_stain: u32 = 0u;
    var out_y: f32 = 0.0;
    var chosen_dy: i32 = 0;

    for (var pass_i: i32 = 0; pass_i < 2; pass_i = pass_i + 1) {
        let dy = select(1 - dy_first, dy_first, pass_i == 0);
        let cand_v = wc * 2 + vec3<i32>(dx, dy, dz);
        let h_cand = pcg_u32(expected_hash + u32(dy) * 7919u);
        if (prefer_ceil) {
            if (try_ceil_anchor(cand_v, h_cand, &out_len, &out_kind, &out_mat, &out_w_mm, &out_sub, &out_stain, &out_y)) {
                spawned = true;
                chosen_dy = dy;
                break;
            }
            if (try_floor_anchor(cand_v, h_cand, &out_len, &out_kind, &out_mat, &out_w_mm, &out_sub, &out_stain, &out_y)) {
                spawned = true;
                chosen_dy = dy;
                break;
            }
        } else {
            if (try_floor_anchor(cand_v, h_cand, &out_len, &out_kind, &out_mat, &out_w_mm, &out_sub, &out_stain, &out_y)) {
                spawned = true;
                chosen_dy = dy;
                break;
            }
            if (try_ceil_anchor(cand_v, h_cand, &out_len, &out_kind, &out_mat, &out_w_mm, &out_sub, &out_stain, &out_y)) {
                spawned = true;
                chosen_dy = dy;
                break;
            }
        }
    }

    var ns: FloraStrand;
    ns.cell_hash = expected_hash;
    ns.disp_xz = 0u;
    ns.vel_xz = 0u;
    if (spawned) {
        let jx = (hash01(pcg_u32(expected_hash + 211u)) - 0.5) * 0.76;
        let jz = (hash01(pcg_u32(expected_hash + 307u)) - 0.5) * 0.76;
        let vx = wc.x * 2 + dx;
        let vz = wc.z * 2 + dz;
        ns.root_pos = vec3<f32>(f32(vx) + 0.5 + jx, out_y, f32(vz) + 0.5 + jz);
        ns.len_kind = pack2x16float(vec2<f32>(out_len, f32(out_kind)));
        let oct_u = u32(dx) | (u32(chosen_dy) << 1u) | (u32(dz) << 2u);
        let phase_u = (pcg_u32(expected_hash + 509u) >> 8u) & 255u;
        ns.mat_packed = (out_mat & 255u)
                      | ((out_w_mm & 255u) << 8u)
                      | ((out_sub & 1u) << 16u)
                      | (oct_u << 17u)
                      | ((out_stain & 15u) << 20u)
                      | (phase_u << 24u);
    } else {
        ns.root_pos = vec3<f32>(0.0);
        ns.len_kind = 0u;
        ns.mat_packed = 0u;
    }
    flora[i] = ns;
}
")

;; ---------------------------------------------------------------------------
;; 3-Blade Tousled Botanical Tuft & Ribbon Render Pass (Opaque, DepthWrite = true)
;;   - 54 vertices/slot (3 blades x 3 curved segments x 6 verts; 1-ribbon early-out for vines/spores)
;;   - Soil-locked terrain macro-normal hillside shadow gating + 5-tap canopy SDF shadows
;;   - 4-tap vs_main volumetric Smoke/Fire/Spore/Waterfall view-ray veil + unified aerial haze & tonemap!
;; ---------------------------------------------------------------------------
(def flora-render-wgsl
  "struct FloraStrand {
    root_pos: vec3<f32>,
    len_kind: u32,
    disp_xz: u32,
    vel_xz: u32,
    cell_hash: u32,
    mat_packed: u32,
}

struct FloraUniforms {
    view_proj: mat4x4<f32>,
    cam_right: vec4<f32>,
    cam_up:    vec4<f32>,
    cam_pos:   vec4<f32>,
}

@group(0) @binding(0) var<uniform> u: FloraUniforms;
@group(0) @binding(1) var<storage, read> flora: array<FloraStrand>;
@group(0) @binding(2) var light_texture: texture_3d<f32>;
@group(0) @binding(3) var liquid_texture: texture_3d<f32>;
@group(0) @binding(4) var solid_texture: texture_3d<f32>;
@group(0) @binding(5) var gas_texture: texture_3d<f32>;

struct FloraVertexOut {
    @builtin(position) clip_position: vec4<f32>,
    @location(0) world_pos: vec3<f32>,
    @location(1) ribbon_n: vec3<f32>,
    @location(2) uv_phase: vec4<f32>,
    @location(3) veil_rgba: vec4<f32>,
    @location(4) @interpolate(flat) kind_mat: vec2<u32>,
    @location(5) terr_light: vec3<f32>,
}

fn wrap_f160(p: vec3<f32>) -> vec3<i32> {
    let w = p - floor(p / 160.0) * 160.0;
    return vec3<i32>(clamp(w, vec3<f32>(0.0), vec3<f32>(159.0)));
}

fn tonemap_pbr_neutral(color_in: vec3<f32>) -> vec3<f32> {
    let start_comp: f32 = 0.76;
    let desat: f32 = 0.15;
    var c = max(color_in, vec3<f32>(0.0));
    let x = min(c.r, min(c.g, c.b));
    let offset = select(0.04, x - 6.25 * x * x, x < 0.08);
    c = c - vec3<f32>(offset);
    let peak = max(c.r, max(c.g, c.b));
    if (peak < start_comp) {
        return c;
    }
    let d = 1.0 - start_comp;
    let new_peak = 1.0 - (d * d) / (peak + d - start_comp);
    c = c * (new_peak / max(peak, 0.0001));
    let g = 1.0 - 1.0 / (desat * (peak - new_peak) + 1.0);
    return mix(c, vec3<f32>(new_peak), g);
}

fn gas_veil_info(gid: u32) -> vec4<f32> {
    switch (gid) {
        case 1u:  { return vec4<f32>(0.78, 0.82, 0.88, 0.0); } // Steam
        case 2u:  { return vec4<f32>(0.45, 0.92, 0.15, 0.0); } // Toxic Gas
        case 3u:  { return vec4<f32>(1.00, 0.58, 0.14, 1.0); } // Fire (luminescent)
        case 4u:  { return vec4<f32>(0.24, 0.24, 0.27, 0.0); } // Smoke
        case 5u:  { return vec4<f32>(0.25, 0.88, 0.18, 0.0); } // Acid Vapor
        case 6u:  { return vec4<f32>(0.82, 0.72, 0.58, 0.0); } // Methane
        case 7u:  { return vec4<f32>(1.00, 0.35, 0.05, 1.0); } // Napalm Vapor
        case 8u:  { return vec4<f32>(0.52, 0.86, 0.32, 0.0); } // Spore Cloud
        case 9u:  { return vec4<f32>(0.74, 0.90, 1.00, 0.0); } // Hydrogen
        case 10u: { return vec4<f32>(0.92, 0.72, 0.38, 0.0); } // Butane
        case 11u: { return vec4<f32>(0.68, 0.95, 0.22, 0.0); } // Chlorine
        case 12u: { return vec4<f32>(0.42, 1.00, 0.55, 1.0); } // Radon
        default:  { return vec4<f32>(0.98, 0.94, 0.78, 1.0); } // Acetylene
    }
}

fn liq_veil_info(lid: u32) -> vec4<f32> {
    switch (lid) {
        case 1u:  { return vec4<f32>(0.36, 0.68, 0.94, 0.0); } // Water / Waterfall mist
        case 2u:  { return vec4<f32>(1.00, 0.42, 0.08, 1.0); } // Lava
        case 3u:  { return vec4<f32>(0.22, 1.00, 0.32, 1.0); } // Acid
        case 4u:  { return vec4<f32>(0.16, 0.14, 0.12, 0.0); } // Oil
        case 5u:  { return vec4<f32>(0.68, 0.05, 0.07, 0.0); } // Blood
        case 6u:  { return vec4<f32>(1.00, 0.85, 0.24, 1.0); } // Ambrosia
        case 7u:  { return vec4<f32>(0.95, 0.16, 0.70, 1.0); } // Volatile Gel
        case 12u: { return vec4<f32>(0.82, 0.86, 0.92, 0.0); } // Mercury
        default:  { return vec4<f32>(0.55, 0.88, 0.96, 0.5); } // Cryo / Other
    }
}

fn sample_gi_trilinear(pos: vec3<f32>) -> vec3<f32> {
    let b = pos - vec3<f32>(0.5);
    let b0 = floor(b);
    let f = b - b0;
    let c000 = textureLoad(light_texture, wrap_f160(b0 + vec3<f32>(0.0, 0.0, 0.0)), 0).rgb;
    let c100 = textureLoad(light_texture, wrap_f160(b0 + vec3<f32>(1.0, 0.0, 0.0)), 0).rgb;
    let c010 = textureLoad(light_texture, wrap_f160(b0 + vec3<f32>(0.0, 1.0, 0.0)), 0).rgb;
    let c110 = textureLoad(light_texture, wrap_f160(b0 + vec3<f32>(1.0, 1.0, 0.0)), 0).rgb;
    let c001 = textureLoad(light_texture, wrap_f160(b0 + vec3<f32>(0.0, 0.0, 1.0)), 0).rgb;
    let c101 = textureLoad(light_texture, wrap_f160(b0 + vec3<f32>(1.0, 0.0, 1.0)), 0).rgb;
    let c011 = textureLoad(light_texture, wrap_f160(b0 + vec3<f32>(0.0, 1.0, 1.0)), 0).rgb;
    let c111 = textureLoad(light_texture, wrap_f160(b0 + vec3<f32>(1.0, 1.0, 1.0)), 0).rgb;
    let cx00 = mix(c000, c100, f.x);
    let cx10 = mix(c010, c110, f.x);
    let cx01 = mix(c001, c101, f.x);
    let cx11 = mix(c011, c111, f.x);
    let cxy0 = mix(cx00, cx10, f.y);
    let cxy1 = mix(cx01, cx11, f.y);
    return mix(cxy0, cxy1, f.z);
}

fn eval_strand_pt(
    s: f32,
    root: vec3<f32>,
    signed_len: f32,
    disp: vec2<f32>,
    t: f32,
    ph: f32,
    dir_az: vec2<f32>,
    kind: u32,
    sub_u: u32,
    is_detached: u32
) -> vec3<f32> {
    let abs_l = abs(signed_len);
    if (signed_len > 0.0) {
        let s2 = s * s;
        var flutter_amp = 0.018 * abs_l * s2;
        if (kind == 2u && sub_u == 1u) {
            flutter_amp = 0.075 * abs_l * s;
        }
        let flutter = vec2<f32>(
            sin(t * 3.4 + ph * 6.28318 + s * 3.2),
            cos(t * 2.8 + ph * 5.12 + s * 2.7)
        ) * flutter_amp;
        let droop_j = fract(ph * 7.13);
        var droop_amt: f32 = mix(0.32, 0.58, droop_j);
        if (is_detached == 1u) {
            droop_amt = 0.35;
        } else if (kind == 2u) {
            droop_amt = select(mix(0.28, 0.50, droop_j), 0.18, sub_u == 1u);
        } else if (kind == 3u) {
            droop_amt = mix(0.10, 0.24, droop_j);
        } else if (kind == 4u) {
            droop_amt = mix(0.38, 0.64, droop_j);
        }
        let lean = dir_az * (droop_amt * abs_l * (0.32 * s + 0.68 * s2));
        let h_xz = disp * s2 + flutter + lean;
        let h2 = dot(h_xz, h_xz);
        let seg_l = s * abs_l;
        let y_s = sqrt(max(0.04 * seg_l * seg_l, seg_l * seg_l - h2 * 0.82));
        return root + vec3<f32>(h_xz.x, y_s, h_xz.y);
    } else {
        let wave_amp = select(0.045, 0.026, kind == 6u) * abs_l * s;
        let wave = vec2<f32>(
            sin(s * 5.0 - t * 3.1 + ph * 6.28318),
            cos(s * 4.2 - t * 2.6 + ph * 4.71238)
        ) * wave_amp;
        let h_xz = disp * pow(max(s, 0.0), 1.32) + wave;
        let h2 = dot(h_xz, h_xz);
        let seg_l = s * abs_l;
        let y_s = -sqrt(max(0.04 * seg_l * seg_l, seg_l * seg_l - h2 * 0.82));
        return root + vec3<f32>(h_xz.x, y_s, h_xz.y);
    }
}

fn strand_width_scale(s: f32, kind: u32, sub_u: u32) -> f32 {
    if (kind == 1u) {
        return max(0.07, 1.0 - s * s * 0.94);
    } else if (kind == 2u) {
        return select(sin(clamp(s * 2.55 + 0.32, 0.32, 3.00)), 0.55 + 0.55 * sin(clamp(s * 2.4 + 0.35, 0.35, 2.98)), sub_u == 1u);
    } else if (kind == 3u) {
        let cap_swell = exp(-pow((s - 0.84) * 5.8, 2.0)) * 1.45;
        return 0.44 * (1.0 - 0.35 * s) + cap_swell;
    } else if (kind == 4u) {
        return max(0.08, 1.08 - 0.86 * s);
    } else if (kind == 5u) {
        return max(0.22, 1.05 - 0.38 * s);
    } else {
        let bead = exp(-pow((s - 0.90) * 7.2, 2.0)) * 1.35;
        return 0.28 + bead;
    }
}

@vertex fn vs_main(@builtin(vertex_index) vi: u32) -> FloraVertexOut {
    var out: FloraVertexOut;
    // Keep @binding(4) solid_texture and @binding(5) gas_texture unconditionally live in WebGPU auto-layout!
    let dummy_keep = (textureLoad(solid_texture, vec3<i32>(0), 0).r + textureLoad(gas_texture, vec3<i32>(0), 0).r) * 0.0;

    let strand_idx = vi / 54u;
    if (strand_idx >= 65536u) {
        out.clip_position = vec4<f32>(2.0 + dummy_keep, 2.0, 2.0, 1.0);
        return out;
    }

    let st = flora[strand_idx];
    if (st.len_kind == 0u) {
        out.clip_position = vec4<f32>(2.0 + dummy_keep, 2.0, 2.0, 1.0);
        return out;
    }

    let lk = unpack2x16float(st.len_kind);
    let raw_kind = u32(lk.y + 0.5);
    let is_detached = select(0u, 1u, raw_kind >= 9u);
    let kind = select(raw_kind, raw_kind - 8u, is_detached == 1u);
    let mp = st.mat_packed;
    let flag16 = (mp >> 16u) & 1u;
    let sub_u = select(flag16, 0u, is_detached == 1u);

    let sub_vi = vi % 54u;
    let blade_k = sub_vi / 18u;
    var max_blades: u32 = 1u;
    if (is_detached == 0u) {
        if (kind == 1u || kind == 4u || (kind == 2u && sub_u == 0u)) {
            max_blades = 3u;
        } else if (kind == 2u && sub_u == 1u) {
            max_blades = 2u;
        }
    }
    if (blade_k >= max_blades) {
        out.clip_position = vec4<f32>(2.0 + dummy_keep, 2.0, 2.0, 1.0);
        return out;
    }

    let rel_cam = abs(st.root_pos - u.cam_pos.xyz);
    let edge_fade = smoothstep(31.5, 24.5, max(rel_cam.x, rel_cam.z)) * smoothstep(15.5, 11.2, rel_cam.y);
    if (edge_fade <= 0.015) {
        out.clip_position = vec4<f32>(2.0 + dummy_keep, 2.0, 2.0, 1.0);
        return out;
    }

    let root_clip = u.view_proj * vec4<f32>(st.root_pos, 1.0);
    if (root_clip.w < -4.8) {
        out.clip_position = vec4<f32>(2.0 + dummy_keep, 2.0, 2.0, 1.0);
        return out;
    }

    let signed_len = lk.x * edge_fade;
    if (abs(signed_len) < 0.04) {
        out.clip_position = vec4<f32>(2.0 + dummy_keep, 2.0, 2.0, 1.0);
        return out;
    }

    let mat_id = mp & 255u;
    let base_w = f32((mp >> 8u) & 255u) * 0.001 * mix(0.45, 1.0, edge_fade);
    let burn_u = select(0u, flag16, is_detached == 1u);
    let stain_u = (mp >> 20u) & 15u;
    let ph = f32((mp >> 24u) & 255u) / 255.0;
    let env_t = u.cam_up.w;

    // Terrain macro-normal (+/-1.0 integer texel differences) & crevice AO around root_pos!
    let gx = textureLoad(solid_texture, wrap_f160(st.root_pos + vec3<f32>(1.0, 0.0, 0.0)), 0).g
           - textureLoad(solid_texture, wrap_f160(st.root_pos - vec3<f32>(1.0, 0.0, 0.0)), 0).g;
    let gy = textureLoad(solid_texture, wrap_f160(st.root_pos + vec3<f32>(0.0, 1.0, 0.0)), 0).g
           - textureLoad(solid_texture, wrap_f160(st.root_pos - vec3<f32>(0.0, 1.0, 0.0)), 0).g;
    let gz = textureLoad(solid_texture, wrap_f160(st.root_pos + vec3<f32>(0.0, 0.0, 1.0)), 0).g
           - textureLoad(solid_texture, wrap_f160(st.root_pos - vec3<f32>(0.0, 0.0, 1.0)), 0).g;
    let raw_tn = vec3<f32>(gx, gy, gz);
    let default_n = vec3<f32>(0.0, select(-1.0, 1.0, signed_len > 0.0), 0.0);
    let terr_n = select(default_n, normalize(raw_tn), dot(raw_tn, raw_tn) > 0.001);
    let ao_probe = textureLoad(solid_texture, wrap_f160(st.root_pos + terr_n * 1.05), 0).g * 0.5;
    let terr_ao = clamp(0.42 + ao_probe * 0.58, 0.36, 1.0);

    // 120-deg botanical rosette fan, slope-hugging basal offset & staggered tuft hierarchy!
    let bk_f = f32(blade_k);
    let az = ph * 6.283185 + bk_f * 2.094395 + sin(ph * 19.3 + bk_f * 4.1) * 0.42;
    let dir_az = vec2<f32>(cos(az), sin(az));
    let blade_ph = fract(ph + bk_f * 0.37);

    var blade_root = st.root_pos;
    var len_mul: f32 = 1.0;
    var wid_mul: f32 = 1.0;
    if (max_blades > 1u) {
        let rad_off = (0.04 + 0.085 * bk_f) * edge_fade;
        let off_xz = dir_az * rad_off;
        let slope_y = clamp(-(terr_n.x * off_xz.x + terr_n.z * off_xz.y) / max(terr_n.y, 0.35), -0.18, 0.18);
        blade_root = st.root_pos + vec3<f32>(off_xz.x, slope_y - 0.02, off_xz.y);
        var l_arr = array<f32, 3>(1.04, 0.85, 0.68);
        var w_arr = array<f32, 3>(1.24, 1.10, 0.96);
        len_mul = l_arr[blade_k];
        wid_mul = w_arr[blade_k];
    }
    let blade_len = signed_len * len_mul;
    let blade_w = base_w * wid_mul;

    let local_v = sub_vi % 18u;
    let seg_idx = local_v / 6u;
    let tri_v = local_v % 6u;

    var joint_u: u32 = seg_idx;
    var side_sgn: f32 = -1.0;
    if (tri_v == 1u) { joint_u = seg_idx; side_sgn = 1.0; }
    else if (tri_v == 2u) { joint_u = seg_idx + 1u; side_sgn = -1.0; }
    else if (tri_v == 3u) { joint_u = seg_idx + 1u; side_sgn = -1.0; }
    else if (tri_v == 4u) { joint_u = seg_idx; side_sgn = 1.0; }
    else if (tri_v == 5u) { joint_u = seg_idx + 1u; side_sgn = 1.0; }

    let s = f32(joint_u) * 0.33333334;
    let disp_raw = unpack2x16float(st.disp_xz);
    let disp = select(disp_raw, vec2<f32>(disp_raw.x, disp_raw.x * 0.65), is_detached == 1u) * edge_fade;

    let pt = eval_strand_pt(s, blade_root, blade_len, disp, env_t, blade_ph, dir_az, kind, sub_u, is_detached);
    let pt_a = eval_strand_pt(max(0.0, s - 0.15), blade_root, blade_len, disp, env_t, blade_ph, dir_az, kind, sub_u, is_detached);
    let pt_b = eval_strand_pt(min(1.0, s + 0.15), blade_root, blade_len, disp, env_t, blade_ph, dir_az, kind, sub_u, is_detached);

    let tang = normalize((pt_b - pt_a) + vec3<f32>(0.0, select(-0.0001, 0.0001, blade_len > 0.0), 0.0));
    let view_v = pt - u.cam_pos.xyz;
    let dist_v = length(view_v);
    let c_tv = cross(tang, view_v);
    let c_len = length(c_tv);
    let side = select(u.cam_right.xyz, c_tv / max(c_len, 0.0001), c_len > 0.001);
    let half_w = blade_w * strand_width_scale(s, kind, sub_u);
    let wpos = pt + side * (side_sgn * half_w);

    let face_n = normalize(cross(side, tang) * select(-1.0, 1.0, dot(cross(side, tang), -view_v) >= 0.0));
    let raw_rib_n = normalize(face_n * 0.80 + side * (side_sgn * 0.60) + vec3<f32>(0.0, 0.35, 0.0));
    let rib_n = select(raw_rib_n, normalize(mix(terr_n, raw_rib_n, 0.35 + 0.45 * s)), blade_len > 0.0 && is_detached == 0u);

    // 1. 5-Tap Per-Vertex Dappled Tree-Canopy & Cliff Overhang SDF Sun Shadow + Hillside Macro-Normal Gating!
    let sun_ang_v = env_t * 0.15;
    let sun_dir_v = normalize(vec3<f32>(cos(sun_ang_v), sin(sun_ang_v), 0.3));
    let sky_exp_v = clamp((wpos.y - 6.0) / 18.0, 0.0, 1.0);
    var sun_sha: f32 = 1.0;
    if (sky_exp_v > 0.01 && sun_dir_v.y > 0.02) {
        let sh_o = pt + vec3<f32>(0.0, 0.42, 0.0);
        var ts = array<f32, 5>(1.1, 2.5, 4.8, 8.5, 13.5);
        for (var si: u32 = 0u; si < 5u; si = si + 1u) {
            let hs = textureLoad(solid_texture, wrap_f160(sh_o + sun_dir_v * ts[si]), 0).g * 0.5;
            sun_sha = min(sun_sha, clamp(0.08 + hs * 0.78, 0.08, 1.0));
        }
    }

    var hill_sun: f32 = sun_sha;
    var hill_moon: f32 = 1.0;
    if (is_detached == 0u) {
        if (blade_len > 0.0) {
            hill_sun = smoothstep(-0.05, 0.28, dot(terr_n, sun_dir_v)) * sun_sha;
            hill_moon = smoothstep(-0.05, 0.28, dot(terr_n, -sun_dir_v));
        } else {
            hill_sun = sun_sha * 0.78;
            hill_moon = 0.65;
        }
    }

    // 2. 4-Tap Per-Vertex Volumetric Smoke / Fire / Spore / Waterfall Veil along cam -> wpos!
    var trans_v: f32 = 1.0;
    var inscat_v = vec3<f32>(0.0);
    if (dist_v > 0.55) {
        let step_ds = dist_v * 0.23;
        var fracs = array<f32, 4>(0.18, 0.41, 0.64, 0.85);
        for (var mi: u32 = 0u; mi < 4u; mi = mi + 1u) {
            let p_tap = u.cam_pos.xyz + (wpos - u.cam_pos.xyz) * fracs[mi];
            let c_tap = wrap_f160(p_tap);
            let gv = textureLoad(gas_texture, c_tap, 0);
            if (gv.g > 0.04) {
                let gid = clamp(u32(round(gv.r)), 1u, 13u);
                let ginfo = gas_veil_info(gid);
                let g_lum = textureLoad(light_texture, c_tap, 0).rgb;
                let g_sky = clamp((p_tap.y - 6.0) / 20.0, 0.08, 1.0) * clamp(sun_dir_v.y * 2.8 + 0.35, 0.16, 0.92);
                var g_col = ginfo.rgb;
                if (ginfo.w > 0.5) {
                    g_col = ginfo.rgb * 1.45;
                } else {
                    g_col = ginfo.rgb * max(vec3<f32>(0.18), vec3<f32>(g_sky) + max(vec3<f32>(0.0), g_lum));
                }
                let ga = clamp((1.0 - exp(-gv.g * step_ds * 0.95)) * 0.52, 0.0, 0.92);
                inscat_v += trans_v * g_col * ga;
                trans_v *= (1.0 - ga);
            }
            if (sub_u == 0u) {
                let lv = textureLoad(liquid_texture, c_tap, 0);
                if (lv.g > 0.16) {
                    let lid = clamp(u32(round(lv.r)), 1u, 15u);
                    let linfo = liq_veil_info(lid);
                    let l_lum = max(vec3<f32>(0.0), textureLoad(light_texture, c_tap, 0).rgb);
                    let l_sky = clamp((p_tap.y - 6.0) / 20.0, 0.10, 1.0) * clamp(sun_dir_v.y * 3.0 + 0.35, 0.14, 1.0);
                    var l_col = linfo.rgb;
                    if (linfo.w > 0.75) {
                        l_col = linfo.rgb * 1.55;
                    } else {
                        l_col = mix(linfo.rgb, vec3<f32>(0.85, 0.93, 1.0), 0.32) * max(vec3<f32>(0.20), vec3<f32>(l_sky) + l_lum);
                    }
                    let la = clamp(lv.g * min(step_ds * 0.42, 0.65), 0.0, 0.78);
                    inscat_v += trans_v * l_col * la;
                    trans_v *= (1.0 - la);
                }
            }
        }
    }

    out.clip_position = u.view_proj * vec4<f32>(wpos, 1.0) + vec4<f32>(dummy_keep, 0.0, 0.0, 0.0);
    out.world_pos = wpos;
    out.ribbon_n = rib_n;
    out.uv_phase = vec4<f32>(side_sgn, s, blade_ph, sun_sha);
    out.veil_rgba = vec4<f32>(inscat_v, trans_v);
    out.kind_mat = vec2<u32>(kind | (sub_u << 8u) | (burn_u << 9u) | (stain_u << 10u), mat_id);
    out.terr_light = vec3<f32>(hill_sun, hill_moon, terr_ao);
    return out;
}

@fragment fn fs_main(in: FloraVertexOut) -> @location(0) vec4<f32> {
    let side_u = in.uv_phase.x;
    let s = clamp(in.uv_phase.y, 0.0, 1.0);
    let ph = in.uv_phase.z;
    let kind = in.kind_mat.x & 255u;
    let sub_u = (in.kind_mat.x >> 8u) & 1u;
    let burn_u = (in.kind_mat.x >> 9u) & 1u;
    let stain_u = (in.kind_mat.x >> 10u) & 15u;
    let mat_id = in.kind_mat.y;
    let hill_sun = in.terr_light.x;
    let hill_moon = in.terr_light.y;
    let terr_ao = in.terr_light.z;
    let env_t = u.cam_up.w;

    // Keep @binding(2) and @binding(3) unconditionally live for WebGPU auto-layout
    let frag_liq = textureLoad(liquid_texture, wrap_f160(in.world_pos), 0);
    let gi_sample = sample_gi_trilinear(in.world_pos + vec3<f32>(0.0, select(-0.25, 0.25, kind <= 4u), 0.0));

    // Species silhouette cutouts (depthWrite = true gives razor-crisp thorns, kelp ruffles & vine leaflets!)
    let au = abs(side_u);
    if (kind == 2u && sub_u == 1u) {
        let ruffle = 0.70 + 0.28 * sin(s * 18.0 + ph * 6.28318);
        if (au > ruffle) { discard; }
    } else if (kind == 4u) {
        let barb = 0.42 + 0.58 * fract(s * 5.5 + ph * 2.0);
        if (au > barb) { discard; }
    } else if (kind == 5u) {
        let leaflet = 0.28 + 0.72 * abs(sin(s * 13.5 + ph * 6.28318));
        if (au > leaflet) { discard; }
    } else if (kind == 6u) {
        let silk_env = select(0.52, 0.98, s > 0.78);
        if (au > silk_env) { discard; }
    }

    let hue_jit = (ph - 0.5) * 0.14;
    let midrib = 1.0 - au;
    var albedo = vec3<f32>(0.22, 0.62, 0.25);
    var emissive = vec3<f32>(0.0);

    if (kind == 1u) {
        let root_c = vec3<f32>(0.18 + hue_jit * 0.15, 0.46 + hue_jit * 0.22, 0.20);
        let tip_c = vec3<f32>(0.32 + hue_jit * 0.35, 0.68 + hue_jit * 0.20, 0.21);
        albedo = mix(root_c, tip_c, pow(s, 0.85)) * (0.90 + 0.16 * midrib);
    } else if (kind == 2u) {
        if (sub_u == 1u) {
            let k_root = vec3<f32>(0.08, 0.36, 0.24);
            let k_tip = vec3<f32>(0.24, 0.70, 0.36 + hue_jit * 0.3);
            albedo = mix(k_root, k_tip, s) * (0.86 + 0.22 * midrib);
        } else {
            let m_root = vec3<f32>(0.14, 0.48, 0.22);
            let m_tip = vec3<f32>(0.26 + hue_jit * 0.28, 0.69, 0.32);
            albedo = mix(m_root, m_tip, s) * (0.88 + 0.18 * midrib);
        }
    } else if (kind == 3u) {
        let is_green = (mat_id == 13u || mat_id == 10u);
        let stem_c = select(vec3<f32>(0.48, 0.34, 0.52), vec3<f32>(0.28, 0.52, 0.30), is_green);
        let cap_c = select(vec3<f32>(0.86, 0.28, 0.78), vec3<f32>(0.38, 0.98, 0.36), is_green);
        let cap_t = smoothstep(0.66, 0.84, s);
        albedo = mix(stem_c, cap_c, cap_t);
        let pulse = 0.82 + 0.18 * sin(env_t * 3.2 + ph * 6.28318);
        emissive = cap_c * (cap_t * (0.55 + 0.65 * midrib) * pulse);
    } else if (kind == 4u) {
        let b_stem = vec3<f32>(0.34, 0.22, 0.16);
        let b_thorn = vec3<f32>(0.68, 0.14, 0.18);
        albedo = mix(b_stem, b_thorn, clamp(s * 0.7 + au * 0.5, 0.0, 1.0));
    } else if (kind == 5u) {
        let v_cord = vec3<f32>(0.26, 0.34, 0.16);
        let v_leaf = vec3<f32>(0.22 + hue_jit * 0.25, 0.62 + hue_jit * 0.2, 0.20);
        albedo = mix(v_cord, v_leaf, smoothstep(0.18, 0.55, au));
    } else {
        let bead_t = smoothstep(0.74, 0.94, s);
        let glow_tint = mix(vec3<f32>(1.0, 0.66, 0.26), vec3<f32>(0.28, 0.95, 0.88), clamp(ph * 1.1, 0.15, 0.88));
        albedo = mix(vec3<f32>(0.42, 0.58, 0.56), glow_tint, bead_t);
        let pulse6 = 0.80 + 0.20 * sin(env_t * 4.1 + ph * 6.28318);
        emissive = glow_tint * (bead_t * 2.10 * pulse6 + 0.18 * midrib);
    }

    let n = normalize(in.ribbon_n);
    let view_vec = u.cam_pos.xyz - in.world_pos;
    let dist_cam = length(view_vec);
    let view_dir = view_vec / max(dist_cam, 0.001);
    let v_dot = max(dot(n, view_dir), 0.0);

    // Inherit voxel surface stains (Wet, Acid, Oil, Blood, Ambrosia, Volatile Gel, Toxic Sludge)!
    var stain_spec = vec3<f32>(0.0);
    if (stain_u > 0u) {
        let st_weight = 1.0 - 0.22 * s;
        if (stain_u == 1u) {
            albedo = albedo * 0.68;
            stain_spec = vec3<f32>(0.18, 0.21, 0.26) * pow(v_dot, 6.0);
        } else if (stain_u == 3u) {
            albedo = mix(albedo, vec3<f32>(0.18, 0.95, 0.28), 0.58 * st_weight);
            emissive += vec3<f32>(0.04, 0.18, 0.05) * st_weight;
        } else if (stain_u == 4u) {
            albedo = mix(albedo * 0.40, vec3<f32>(0.15, 0.15, 0.12), 0.58 * st_weight);
            stain_spec = vec3<f32>(0.24, 0.18, 0.30) * pow(v_dot, 5.0);
        } else if (stain_u == 5u) {
            albedo = mix(albedo, vec3<f32>(0.52, 0.03, 0.05), 0.72 * st_weight);
            stain_spec = vec3<f32>(0.20, 0.03, 0.04) * pow(v_dot, 6.0);
        } else if (stain_u == 6u) {
            albedo = mix(albedo, vec3<f32>(0.95, 0.82, 0.20), 0.58 * st_weight);
            emissive += vec3<f32>(0.28, 0.24, 0.06) * st_weight;
        } else if (stain_u == 7u) {
            albedo = mix(albedo, vec3<f32>(0.92, 0.15, 0.68), 0.56 * st_weight);
            emissive += vec3<f32>(0.16, 0.03, 0.12) * st_weight;
        } else {
            albedo = mix(albedo, vec3<f32>(0.38, 0.85, 0.14), 0.56 * st_weight);
            emissive += vec3<f32>(0.06, 0.14, 0.02) * st_weight;
        }
    }

    // Detached burning ribbons char black & glow with incandescent orange embers as they fall!
    if (burn_u == 1u) {
        albedo = mix(albedo * 0.35, vec3<f32>(0.05, 0.03, 0.02), smoothstep(0.20, 0.80, s));
        let ember = smoothstep(0.32, 0.92, s) * (0.75 + 0.25 * sin(env_t * 18.0 + ph * 12.0));
        emissive += vec3<f32>(2.35, 0.62, 0.08) * ember;
    }

    // Unified Sky, Hemisphere Bounce & Hillside-Gated Direct Lighting (exact match with shaders_render.carp!)
    let sun_ang = env_t * 0.15;
    let sun_dir = normalize(vec3<f32>(cos(sun_ang), sin(sun_ang), 0.3));
    let sun_h = sun_dir.y;
    let day_factor = clamp(sun_h * 5.0 + 0.5, 0.0, 1.0);
    let sunset_factor = clamp(1.0 - abs(sun_h) * 5.0, 0.0, 1.0);
    let space_color = mix(mix(vec3<f32>(0.004, 0.007, 0.016), vec3<f32>(0.06, 0.04, 0.14), sunset_factor), vec3<f32>(0.06, 0.15, 0.34), day_factor);
    let horizon_color = mix(mix(vec3<f32>(0.022, 0.032, 0.065), vec3<f32>(0.68, 0.30, 0.13), sunset_factor), vec3<f32>(0.34, 0.54, 0.76), day_factor);
    let sky_amb_col = mix(horizon_color, space_color, 0.35) * 0.55 + vec3<f32>(0.05, 0.065, 0.105);
    let gnd_amb_col = sky_amb_col * vec3<f32>(0.48, 0.44, 0.40);

    let sky_exposure = clamp((in.world_pos.y - 6.0) / 18.0, 0.0, 1.0);
    let sun_int = clamp(sun_h * 4.0, 0.0, 1.0) * sky_exposure;
    let wrap_diff = clamp(dot(n, sun_dir) * 0.55 + 0.45, 0.0, 1.0);
    let sss = pow(clamp(dot(-view_dir, sun_dir), 0.0, 1.0), 3.0) * (0.32 + 0.42 * s);
    let direct = vec3<f32>(1.0, 0.95, 0.85) * (wrap_diff * 0.80 + sss * 0.50) * sun_int * hill_sun;

    let moon_int = clamp(-sun_h * 4.0, 0.0, 1.0) * 0.15 * sky_exposure;
    let moon_light = vec3<f32>(0.7, 0.8, 1.0) * clamp(dot(n, -sun_dir) * 0.5 + 0.5, 0.0, 1.0) * moon_int * hill_moon;

    let root_ao = terr_ao * mix(0.68, 1.06, s);
    let hemi = clamp(n.y * 0.5 + 0.5, 0.0, 1.0);
    let cave_amb_col = mix(vec3<f32>(0.028, 0.032, 0.048), vec3<f32>(0.052, 0.062, 0.088), hemi);
    let ambient = mix(cave_amb_col, mix(gnd_amb_col, sky_amb_col, hemi), sky_exposure) * root_ao;

    let pos_gi = max(vec3<f32>(0.0), gi_sample);
    let neg_gi = min(vec3<f32>(0.0), gi_sample);
    let block_light = pos_gi * mix(0.75, 1.0, root_ao) + neg_gi;

    var player_glow = vec3<f32>(0.0);
    if (u.cam_pos.w > 0.5) {
        let atten = 1.0 / (1.0 + 0.04 * dist_cam + 0.009 * dist_cam * dist_cam);
        player_glow = vec3<f32>(1.0, 0.96, 0.88) * (atten * 2.35 * (0.55 + 0.45 * v_dot));
    }

    let total_light = max(vec3<f32>(0.0), direct + ambient + moon_light + block_light + player_glow);
    var col = albedo * total_light + emissive + stain_spec * min(length(total_light), 1.8);

    // Beer-Lambert underwater absorption & teal scatter when submerged in water!
    if (frag_liq.g > 0.22) {
        let cam_liq = textureLoad(liquid_texture, wrap_f160(u.cam_pos.xyz), 0);
        let sub_path = select(clamp(dist_cam * 0.28, 0.3, 4.5), clamp(1.15 + (1.0 - s) * 1.35, 0.6, 3.6), cam_liq.g < 0.25);
        let absorb = exp(-vec3<f32>(0.42, 0.11, 0.07) * sub_path);
        let scatter = vec3<f32>(0.03, 0.13, 0.18) * min(length(total_light), 1.6) * (1.0 - exp(-sub_path * 0.35));
        col = col * absorb + scatter;
    }

    // Apply volumetric Smoke / Fire / Spore / Waterfall view-ray veil!
    col = col * in.veil_rgba.w + in.veil_rgba.xyz;

    // Smooth 2-stage exponential aerial-perspective haze + solar Mie scatter matching terrain!
    let rd_frag = -view_dir;
    let haze_d = max(0.0, dist_cam - 10.0);
    let fog_factor = clamp((1.0 - exp(-0.00038 * haze_d * haze_d)) * 0.65 + smoothstep(56.0, 87.5, dist_cam), 0.0, 1.0);
    let depth_fade = clamp((in.world_pos.y - 4.0) / 20.0, 0.0, 1.0);
    let base_haze = mix(horizon_color, space_color, pow(max(0.0, rd_frag.y), 0.60));
    let mie_sun = vec3<f32>(0.55, 0.40, 0.22) * pow(max(dot(rd_frag, sun_dir), 0.0), 8.0) * clamp(sun_h * 4.0 + 0.4, 0.0, 1.0);
    let fog_color = (base_haze + mie_sun) * depth_fade;
    col = mix(col, fog_color, fog_factor);

    return vec4<f32>(tonemap_pbr_neutral(col), 1.0);
}
")




(load "ecs_world.carp")
(load "world.carp")
(load "camera.carp")
(load "../../carp-physics-3d/geometry.carp")
(use Geometry)

(defmodule Physics
  (defn clamp [min-val max-val val]
    (if (< val min-val) min-val (if (> val max-val) max-val val)))

  (defn is-solid-at? [world gx gy gz]
    (let [qx (Double.to-int (Double.floor (/ (Double.from-int gx) 32.0)))
          qy (Double.to-int (Double.floor (/ (Double.from-int gy) 32.0)))
          qz (Double.to-int (Double.floor (/ (Double.from-int gz) 32.0)))
          chunks (World.chunks world)
          tx (World.positive-mod qx 5)
          ty (World.positive-mod qy 5)
          tz (World.positive-mod qz 5)
          slot-idx (+ tx (+ (* ty 5) (* tz 25)))]
      (if (< slot-idx (Array.length chunks))
        (let [chunk (Array.unsafe-nth chunks slot-idx)]
          (if (and (= qx @(Chunk.coord-x chunk))
                   (and (= qy @(Chunk.coord-y chunk))
                        (= qz @(Chunk.coord-z chunk))))
            (let [lx (Physics.clamp 0 31 (- gx (* qx 32)))
                  ly (Physics.clamp 0 31 (- gy (* qy 32)))
                  lz (Physics.clamp 0 31 (- gz (* qz 32)))
                  idx (+ (* lz 1024) (+ (* ly 32) lx))
                  offset (* idx 4)
                  mat-id @(Array.unsafe-nth (Chunk.voxel-data chunk) offset)
                  sdf @(Array.unsafe-nth (Chunk.voxel-data chunk) (+ offset 1))]
              (and (>= mat-id 1.0f) (<= sdf 0.05f)))
            false))
        false)))


  (defn sample-sdf-at [world gx gy gz]
    (let [qx (Double.to-int (Double.floor (/ (Double.from-int gx) 32.0)))
          qy (Double.to-int (Double.floor (/ (Double.from-int gy) 32.0)))
          qz (Double.to-int (Double.floor (/ (Double.from-int gz) 32.0)))]
      (match (World.find-chunk world qx qy qz)
        (Maybe.Nothing) 1000.0f
        (Maybe.Just chunk)
          (let [lx (Physics.clamp 0 31 (- gx (* qx 32)))
                ly (Physics.clamp 0 31 (- gy (* qy 32)))
                lz (Physics.clamp 0 31 (- gz (* qz 32)))
                idx (+ (* lz 1024) (+ (* ly 32) lx))
                offset (* idx 4)]
            @(Array.unsafe-nth (Chunk.voxel-data &chunk) (+ offset 1))))))

  (defn sample-sdf-trilinear [world p]
    (let [px @(Vector3.x p)
          py @(Vector3.y p)
          pz @(Vector3.z p)
          
          tx (- px 0.5)
          ty (- py 0.5)
          tz (- pz 0.5)
          
          c0-x (Double.to-int (Double.floor tx))
          c0-y (Double.to-int (Double.floor ty))
          c0-z (Double.to-int (Double.floor tz))
          
          fx (- tx (Double.from-int c0-x))
          fy (- ty (Double.from-int c0-y))
          fz (- tz (Double.from-int c0-z))
          
          v0 (Double.from-float (Physics.sample-sdf-at world c0-x c0-y c0-z))
          v1 (Double.from-float (Physics.sample-sdf-at world (inc c0-x) c0-y c0-z))
          v2 (Double.from-float (Physics.sample-sdf-at world c0-x (inc c0-y) c0-z))
          v3 (Double.from-float (Physics.sample-sdf-at world (inc c0-x) (inc c0-y) c0-z))
          v4 (Double.from-float (Physics.sample-sdf-at world c0-x c0-y (inc c0-z)))
          v5 (Double.from-float (Physics.sample-sdf-at world (inc c0-x) c0-y (inc c0-z)))
          v6 (Double.from-float (Physics.sample-sdf-at world c0-x (inc c0-y) (inc c0-z)))
          v7 (Double.from-float (Physics.sample-sdf-at world (inc c0-x) (inc c0-y) (inc c0-z)))
          
          v-01 (+ v0 (* fx (- v1 v0)))
          v-23 (+ v2 (* fx (- v3 v2)))
          v-45 (+ v4 (* fx (- v5 v4)))
          v-67 (+ v6 (* fx (- v7 v6)))
          
          v-y0 (+ v-01 (* fy (- v-23 v-01)))
          v-y1 (+ v-45 (* fy (- v-67 v-45)))]
      (Double.to-float (+ v-y0 (* fz (- v-y1 v-y0))))))

  (defn estimate-sdf-normal [world p]
    (let [eps 0.1
          px @(Vector3.x p)
          py @(Vector3.y p)
          pz @(Vector3.z p)
          
          dx-pos (Vector3.init (+ px eps) py pz)
          dx-neg (Vector3.init (- px eps) py pz)
          dy-pos (Vector3.init px (+ py eps) pz)
          dy-neg (Vector3.init px (- py eps) pz)
          dz-pos (Vector3.init px py (+ pz eps))
          dz-neg (Vector3.init px py (- pz eps))
          
          nx (- (Physics.sample-sdf-trilinear world &dx-pos) (Physics.sample-sdf-trilinear world &dx-neg))
          ny (- (Physics.sample-sdf-trilinear world &dy-pos) (Physics.sample-sdf-trilinear world &dy-neg))
          nz (- (Physics.sample-sdf-trilinear world &dz-pos) (Physics.sample-sdf-trilinear world &dz-neg))
          
          n-len (Double.sqrt (+ (+ (* (Double.from-float nx) (Double.from-float nx)) (* (Double.from-float ny) (Double.from-float ny))) (* (Double.from-float nz) (Double.from-float nz))))]
      (if (> n-len 0.001)
          (Vector3.init (/ (Double.from-float nx) n-len) (/ (Double.from-float ny) n-len) (/ (Double.from-float nz) n-len))
          (Vector3.init 0.0 1.0 0.0))))

  (defn dmin [a b] (if (< a b) a b))
  (defn dmax [a b] (if (> a b) a b))

  (defn get-player-aabb-shrunk [pos sx sy sz]
    (let [px @(Vector3.x pos)
          py @(Vector3.y pos)
          pz @(Vector3.z pos)]
      (AABB.init (Vector3.init (- px (- 0.3 sx)) (- py (- 1.6 sy)) (- pz (- 0.3 sz)))
                 (Vector3.init (+ px (- 0.3 sx)) (+ py (- 0.2 sy)) (+ pz (- 0.3 sz))))))

  (defn resolve-camera-collision! [world cam prev-pos vel-y-ptr on-ground-ptr]
    (let [p-pos (ref-to-ptr (Camera.pos cam))
          cand-pos (Pointer.to-value p-pos)
          
          res-x @(Vector3.x prev-pos)
          res-y @(Vector3.y prev-pos)
          res-z @(Vector3.z prev-pos)
          
          cand-x @(Vector3.x &cand-pos)
          cand-y @(Vector3.y &cand-pos)
          cand-z @(Vector3.z &cand-pos)
          
          prev-x @(Vector3.x prev-pos)
          prev-y @(Vector3.y prev-pos)
          prev-z @(Vector3.z prev-pos)]
      (do
        (Pointer.set on-ground-ptr false)
        
        ;; 1. Resolve X Axis
        (set! res-x cand-x)
        (let [p-aabb (Physics.get-player-aabb-shrunk &(Vector3.init res-x res-y res-z) 0.0 0.05 0.02)
              amin (AABB.min &p-aabb)
              amax (AABB.max &p-aabb)
              min-x (Double.to-int (Double.floor @(Vector3.x amin)))
              max-x (Double.to-int (Double.floor @(Vector3.x amax)))
              min-y (Double.to-int (Double.floor @(Vector3.y amin)))
              max-y (Double.to-int (Double.floor @(Vector3.y amax)))
              min-z (Double.to-int (Double.floor @(Vector3.z amin)))
              max-z (Double.to-int (Double.floor @(Vector3.z amax)))]
          (for [z min-z (inc max-z)]
            (for [y min-y (inc max-y)]
              (for [x min-x (inc max-x)]
                (when (Physics.is-solid-at? world x y z)
                  (let [voxel-min-x (Double.from-int x)
                        voxel-max-x (Double.from-int (inc x))
                        voxel-min-y (Double.from-int y)
                        voxel-max-y (Double.from-int (inc y))
                        voxel-min-z (Double.from-int z)
                        voxel-max-z (Double.from-int (inc z))
                        
                        p-min (AABB.min &p-aabb)
                        p-max (AABB.max &p-aabb)
                        p-min-x @(Vector3.x p-min)
                        p-max-x @(Vector3.x p-max)
                        p-min-y @(Vector3.y p-min)
                        p-max-y @(Vector3.y p-max)
                        p-min-z @(Vector3.z p-min)
                        p-max-z @(Vector3.z p-max)
                        
                        ox (- (Physics.dmin p-max-x voxel-max-x) (Physics.dmax p-min-x voxel-min-x))
                        oy (- (Physics.dmin p-max-y voxel-max-y) (Physics.dmax p-min-y voxel-min-y))
                        oz (- (Physics.dmin p-max-z voxel-max-z) (Physics.dmax p-min-z voxel-min-z))]
                    (when (and (and (> ox 0.0) (> oy 0.0)) (> oz 0.0))
                      (do
                        (if (> cand-x prev-x)
                          (set! res-x (- res-x ox))
                          (if (< cand-x prev-x)
                            (set! res-x (+ res-x ox))
                            (let [diff (- res-x (+ voxel-min-x 0.5))]
                              (if (< diff 0.0)
                                (set! res-x (- res-x ox))
                                (set! res-x (+ res-x ox))))))
                        (set! p-aabb (Physics.get-player-aabb-shrunk &(Vector3.init res-x res-y res-z) 0.0 0.05 0.02))))))))))
        
        ;; 2. Resolve Z Axis
        (set! res-z cand-z)
        (let [p-aabb (Physics.get-player-aabb-shrunk &(Vector3.init res-x res-y res-z) 0.02 0.05 0.0)
              amin (AABB.min &p-aabb)
              amax (AABB.max &p-aabb)
              min-x (Double.to-int (Double.floor @(Vector3.x amin)))
              max-x (Double.to-int (Double.floor @(Vector3.x amax)))
              min-y (Double.to-int (Double.floor @(Vector3.y amin)))
              max-y (Double.to-int (Double.floor @(Vector3.y amax)))
              min-z (Double.to-int (Double.floor @(Vector3.z amin)))
              max-z (Double.to-int (Double.floor @(Vector3.z amax)))]
          (for [z min-z (inc max-z)]
            (for [y min-y (inc max-y)]
              (for [x min-x (inc max-x)]
                (when (Physics.is-solid-at? world x y z)
                  (let [voxel-min-x (Double.from-int x)
                        voxel-max-x (Double.from-int (inc x))
                        voxel-min-y (Double.from-int y)
                        voxel-max-y (Double.from-int (inc y))
                        voxel-min-z (Double.from-int z)
                        voxel-max-z (Double.from-int (inc z))
                        
                        p-min (AABB.min &p-aabb)
                        p-max (AABB.max &p-aabb)
                        p-min-x @(Vector3.x p-min)
                        p-max-x @(Vector3.x p-max)
                        p-min-y @(Vector3.y p-min)
                        p-max-y @(Vector3.y p-max)
                        p-min-z @(Vector3.z p-min)
                        p-max-z @(Vector3.z p-max)
                        
                        ox (- (Physics.dmin p-max-x voxel-max-x) (Physics.dmax p-min-x voxel-min-x))
                        oy (- (Physics.dmin p-max-y voxel-max-y) (Physics.dmax p-min-y voxel-min-y))
                        oz (- (Physics.dmin p-max-z voxel-max-z) (Physics.dmax p-min-z voxel-min-z))]
                    (when (and (and (> ox 0.0) (> oy 0.0)) (> oz 0.0))
                      (do
                        (if (> cand-z prev-z)
                          (set! res-z (- res-z oz))
                          (if (< cand-z prev-z)
                            (set! res-z (+ res-z oz))
                            (let [diff (- res-z (+ voxel-min-z 0.5))]
                              (if (< diff 0.0)
                                (set! res-z (- res-z oz))
                                (set! res-z (+ res-z oz))))))
                        (set! p-aabb (Physics.get-player-aabb-shrunk &(Vector3.init res-x res-y res-z) 0.02 0.05 0.0))))))))))
                              
        ;; 3. Resolve Y Axis
        (set! res-y cand-y)
        (let [p-aabb (Physics.get-player-aabb-shrunk &(Vector3.init res-x res-y res-z) 0.02 0.0 0.02)
              amin (AABB.min &p-aabb)
              amax (AABB.max &p-aabb)
              min-x (Double.to-int (Double.floor @(Vector3.x amin)))
              max-x (Double.to-int (Double.floor @(Vector3.x amax)))
              min-y (Double.to-int (Double.floor @(Vector3.y amin)))
              max-y (Double.to-int (Double.floor @(Vector3.y amax)))
              min-z (Double.to-int (Double.floor @(Vector3.z amin)))
              max-z (Double.to-int (Double.floor @(Vector3.z amax)))]
          (for [z min-z (inc max-z)]
            (for [y min-y (inc max-y)]
              (for [x min-x (inc max-x)]
                (when (Physics.is-solid-at? world x y z)
                  (let [voxel-min-x (Double.from-int x)
                        voxel-max-x (Double.from-int (inc x))
                        voxel-min-y (Double.from-int y)
                        voxel-max-y (Double.from-int (inc y))
                        voxel-min-z (Double.from-int z)
                        voxel-max-z (Double.from-int (inc z))
                        
                        p-min (AABB.min &p-aabb)
                        p-max (AABB.max &p-aabb)
                        p-min-x @(Vector3.x p-min)
                        p-max-x @(Vector3.x p-max)
                        p-min-y @(Vector3.y p-min)
                        p-max-y @(Vector3.y p-max)
                        p-min-z @(Vector3.z p-min)
                        p-max-z @(Vector3.z p-max)
                        
                        ox (- (Physics.dmin p-max-x voxel-max-x) (Physics.dmax p-min-x voxel-min-x))
                        oy (- (Physics.dmin p-max-y voxel-max-y) (Physics.dmax p-min-y voxel-min-y))
                        oz (- (Physics.dmin p-max-z voxel-max-z) (Physics.dmax p-min-z voxel-min-z))]
                    (when (and (and (> ox 0.0) (> oy 0.0)) (> oz 0.0))
                      (do
                        (if (> cand-y prev-y)
                          (do
                            (set! res-y (- res-y oy))
                            (when (> (Pointer.to-value vel-y-ptr) 0.0)
                              (Pointer.set vel-y-ptr 0.0)))
                          (if (< cand-y prev-y)
                            (do
                              (set! res-y (+ res-y oy))
                              (Pointer.set on-ground-ptr true)
                              (when (< (Pointer.to-value vel-y-ptr) 0.0)
                                (Pointer.set vel-y-ptr 0.0)))
                            (let [diff (- res-y (+ voxel-min-y 0.5))]
                              (if (< diff 0.0)
                                (do
                                  (set! res-y (- res-y oy))
                                  (when (> (Pointer.to-value vel-y-ptr) 0.0)
                                    (Pointer.set vel-y-ptr 0.0)))
                                (do
                                  (set! res-y (+ res-y oy))
                                  (Pointer.set on-ground-ptr true)
                                  (when (< (Pointer.to-value vel-y-ptr) 0.0)
                                    (Pointer.set vel-y-ptr 0.0)))))))
                        (set! p-aabb (Physics.get-player-aabb-shrunk &(Vector3.init res-x res-y res-z) 0.02 0.0 0.02))))))))))
        
        (Pointer.set p-pos (Vector3.init res-x res-y res-z)))))
)

;; --- CARP-PHYSICS-3D INTEGRATION ---
(load "../../carp-physics-3d/dynamics.carp")
(load "../../carp-physics-3d/rigidbody.carp")
(load "../../carp-physics-3d/collision.carp")
(load "../../carp-physics-3d/grid.carp")
(load "../../carp-physics-3d/solver.carp")

(use Body)
(use RigidBody)
(use Collision)
(use SpatialGrid)
(use Solver)

(defmodule Volume
  (defn copy [v]
    (match-ref v
      (Volume.Box b) (Volume.Box @b)
      (Volume.Ball s) (Volume.Ball @s)
      (Volume.Surface p) (Volume.Surface @p)
      (Volume.Sdf s) (Volume.Sdf @s)))
)
(implements copy Volume.copy)



(defmodule Physics
  (sig step-physics-entities! (Fn [(Ref World) (Ref GameWorld) (Ref (SpatialGrid Int)) Double] ()))
      (defn step-physics-entities! [world game-world grid dt]
    (let [manifolds (the (Array Collision) [])
          fixed-dt dt
          iterations 8
          dummy-static (RigidBody.static (Vector3.init 0.0 0.0 0.0) (Quaternion.identity) 0.5 0.5)]
      (do
        ;; 1. Step active bodies
        (query game-world (e (cb CompBody))
          (let [rb (CompBody.rb cb)]
            (do
              (let [b (RigidBody.body rb)]
                (do
                  (Body.apply-force! b &(Vector3.init 0.0 -25.0 0.0))
                  (RigidBody.set-body! rb @b)))
              (RigidBody.step-custom! rb fixed-dt fixed-dt)
              (ECS.add-component! game-world &e (CompBody.init @rb)))))
        
        ;; 2. Rebuild Spatial Grid
        (SpatialGrid.clear! grid)
        (query game-world (e (cb CompBody) (cv CompVolume))
          (let [rb (CompBody.rb cb)
                pos (RigidBody.position rb)
                vol (CompVolume.vol cv)]
            (do
              (match-ref vol
                (Volume.Ball s) (Sphere.set-center! s @pos)
                (Volume.Box b)
                  (let [half-extents (Vector3.mul &(Vector3.sub (AABB.max b) (AABB.min b)) 0.5)]
                    (do
                      (AABB.set-min! b (Vector3.sub pos &half-extents))
                      (AABB.set-max! b (Vector3.add pos &half-extents))))
                _ ())
              (let [aabb (Collision.get-aabb vol)
                    ent-id (Long.to-int (Uint64.to-long (ECS.Entity.index &e)))]
                (SpatialGrid.insert! grid &aabb ent-id)))))

        ;; 3. Detect Collisions
        (query game-world (e (cb CompBody) (cv CompVolume))
          (let [rb (CompBody.rb cb)
                pos (RigidBody.position rb)
                vol (CompVolume.vol cv)
                aabb (Collision.get-aabb vol)
                candidates (SpatialGrid.query-unique grid &aabb)
                contacts (the (Array Contact) [])
                i (Long.to-int (Uint64.to-long (ECS.Entity.index &e)))]
            (do
              ;; 3a. SDF Collision
              (match-ref vol
                (Volume.Ball s)
                  (let [rad @(Sphere.radius s)
                        d (Double.from-float (Physics.sample-sdf-trilinear world pos))]
                    (when (< d rad)
                      (let [depth (Physics.dmin 0.4 (- rad d))
                            normal (Physics.estimate-sdf-normal world pos)
                            contact-pt (Vector3.sub pos &(Vector3.mul &normal rad))]
                        (do
                          (when (> @(Vector3.y &normal) 0.5)
                            (let [ent (ECS.Entity.init (Handle.init (Uint64.from-long (the Long (Long.from-int i))) (Uint32.from-long 1l)))]
                              (when (has-component? game-world &ent CompGrounded)
                                (ECS.add-component! game-world &ent (CompGrounded.init true)))))
                          (Array.push-back! &contacts (Contact.init depth contact-pt normal))))))
                _ ())
              
              (when (not (Array.empty? &contacts))
                (let [c-set (ContactSet.init (the (Handle ()) (Handle.init (Uint64.from-long (the Long (Long.from-int i))) (Uint32.from-long 1l)))
                                              (the (Handle ()) (Handle.init (Uint64.from-long 0l) (Uint32.from-long 1l)))
                                              @&contacts)
                      m (Collision.init c-set)]
                  (Array.push-back! &manifolds m)))
              
              ;; 3b. Entity Collision
              (let [c 0
                    cand-len (Array.length &candidates)]
                (while (< c cand-len)
                  (do
                    (let [other-idx @(Array.unsafe-nth &candidates c)]
                      (when (and (/= i other-idx) (< i other-idx))
                        (let [other-ent (ECS.Entity.init (Handle.init (Uint64.from-long (the Long (Long.from-int other-idx))) (Uint32.from-long 1l)))
                              other-cv-opt (get-component game-world &other-ent)]
                          (match other-cv-opt
                            (Maybe.Just other-cv)
                              (let [col1 (Collidable.init (the (Handle ()) (Handle.init (Uint64.from-long (the Long (Long.from-int i))) (Uint32.from-long 1l))) @vol (Uint32.from-long 1l) (Uint32.from-long 1l) false)
                                    col2 (Collidable.init (the (Handle ()) (Handle.init (Uint64.from-long (the Long (Long.from-int other-idx))) (Uint32.from-long 1l))) @(CompVolume.vol &other-cv) (Uint32.from-long 1l) (Uint32.from-long 1l) false)
                                    res (CollisionChecker.check-pair &col1 &col2)]
                                (match res
                                  (Maybe.Just (CollisionResult.Physical actual-col))
                                    (Array.push-back! &manifolds actual-col)
                                  _ ()))
                            (Maybe.Nothing) ()))))
                    (set! c (+ c 1))))))))

        ;; 4. Solve Constraints
        (let [iter 0]
          (while (< iter iterations)
            (do
              (let [m-idx 0
                    m-len (Array.length &manifolds)]
                (while (< m-idx m-len)
                  (do
                    (let [col (Array.unsafe-nth &manifolds m-idx)
                          m (Collision.contact-set col)
                          h-a (ContactSet.a m)
                          h-b (ContactSet.b m)
                          idx-a (Long.to-int (Uint64.to-long (Handle.index h-a)))
                          idx-b (Long.to-int (Uint64.to-long (Handle.index h-b)))
                          ent-a (ECS.Entity.init (Handle.init (Uint64.from-long (the Long (Long.from-int idx-a))) (Uint32.from-long 1l)))
                          cb-a-opt (get-component game-world &ent-a)]
                      (match cb-a-opt
                        (Maybe.Just cb-a)
                          (let [rb-a (CompBody.rb &cb-a)]
                            (if (= idx-b 0)
                              (do
                                (Solver.solve! rb-a &dummy-static m fixed-dt)
                                (ECS.add-component! game-world &ent-a @&cb-a))
                              (let [ent-b (ECS.Entity.init (Handle.init (Uint64.from-long (the Long (Long.from-int idx-b))) (Uint32.from-long 1l)))
                                    cb-b-opt (get-component game-world &ent-b)]
                                (match cb-b-opt
                                  (Maybe.Just cb-b)
                                    (let [rb-b (CompBody.rb &cb-b)]
                                      (do
                                        (Solver.solve! rb-a rb-b m fixed-dt)
                                        (ECS.add-component! game-world &ent-a @&cb-a)
                                        (ECS.add-component! game-world &ent-b @&cb-b)))
                                  (Maybe.Nothing) ()))))
                        (Maybe.Nothing) ()))
                    (set! m-idx (+ m-idx 1)))))
              (set! iter (+ iter 1))))))))

)

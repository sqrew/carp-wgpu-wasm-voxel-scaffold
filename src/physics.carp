(load "ecs_world.carp")
(load "world.carp")
(load "camera.carp")
(load "../../carp-physics-3d/geometry.carp")
(use Geometry)

(defmodule Physics
  (defn clamp [min-val max-val val]
    (if (< val min-val) min-val (if (> val max-val) max-val val)))

  (defn sample-sdf-at [world gx gy gz]
    (let [qx (Double.to-int (Double.floor (/ (Double.from-int gx) 32.0)))
          qy (Double.to-int (Double.floor (/ (Double.from-int gy) 32.0)))
          qz (Double.to-int (Double.floor (/ (Double.from-int gz) 32.0)))
          chunks (World.chunks world)
          tx (World.positive-mod qx 5)
          ty (World.positive-mod qy 5)
          tz (World.positive-mod qz 5)
          slot-idx (+ tx (+ (* ty 5) (* tz 25)))]
      (if (< slot-idx (Array.length chunks))
        (let [chunk (Array.unsafe-nth chunks slot-idx)]
          (if (and (= qx @(Chunk.coord-x chunk))
                   (and (= qy @(Chunk.coord-y chunk))
                        (= qz @(Chunk.coord-z chunk))))
            (let [lx (Physics.clamp 0 31 (- gx (* qx 32)))
                  ly (Physics.clamp 0 31 (- gy (* qy 32)))
                  lz (Physics.clamp 0 31 (- gz (* qz 32)))
                  idx (+ (* lz 1024) (+ (* ly 32) lx))
                  offset (* idx 4)]
              @(Array.unsafe-nth (Chunk.voxel-data chunk) (+ offset 1)))
            1000.0f))
        1000.0f)))

  (defn sample-sdf-trilinear [world p]
    (let [px @(Vector3.x p)
          py @(Vector3.y p)
          pz @(Vector3.z p)
          
          tx (- px 0.5)
          ty (- py 0.5)
          tz (- pz 0.5)
          
          c0-x (Double.to-int (Double.floor tx))
          c0-y (Double.to-int (Double.floor ty))
          c0-z (Double.to-int (Double.floor tz))
          
          fx (- tx (Double.from-int c0-x))
          fy (- ty (Double.from-int c0-y))
          fz (- tz (Double.from-int c0-z))
          
          v0 (Double.from-float (Physics.sample-sdf-at world c0-x c0-y c0-z))
          v1 (Double.from-float (Physics.sample-sdf-at world (inc c0-x) c0-y c0-z))
          v2 (Double.from-float (Physics.sample-sdf-at world c0-x (inc c0-y) c0-z))
          v3 (Double.from-float (Physics.sample-sdf-at world (inc c0-x) (inc c0-y) c0-z))
          v4 (Double.from-float (Physics.sample-sdf-at world c0-x c0-y (inc c0-z)))
          v5 (Double.from-float (Physics.sample-sdf-at world (inc c0-x) c0-y (inc c0-z)))
          v6 (Double.from-float (Physics.sample-sdf-at world c0-x (inc c0-y) (inc c0-z)))
          v7 (Double.from-float (Physics.sample-sdf-at world (inc c0-x) (inc c0-y) (inc c0-z)))
          
          v-01 (+ v0 (* fx (- v1 v0)))
          v-23 (+ v2 (* fx (- v3 v2)))
          v-45 (+ v4 (* fx (- v5 v4)))
          v-67 (+ v6 (* fx (- v7 v6)))
          
          v-y0 (+ v-01 (* fy (- v-23 v-01)))
          v-y1 (+ v-45 (* fy (- v-67 v-45)))]
      (Double.to-float (+ v-y0 (* fz (- v-y1 v-y0))))))

  (defn estimate-sdf-normal [world p]
    (let [eps 0.1
          px @(Vector3.x p)
          py @(Vector3.y p)
          pz @(Vector3.z p)
          
          dx-pos (Vector3.init (+ px eps) py pz)
          dx-neg (Vector3.init (- px eps) py pz)
          dy-pos (Vector3.init px (+ py eps) pz)
          dy-neg (Vector3.init px (- py eps) pz)
          dz-pos (Vector3.init px py (+ pz eps))
          dz-neg (Vector3.init px py (- pz eps))
          
          nx (- (Physics.sample-sdf-trilinear world &dx-pos) (Physics.sample-sdf-trilinear world &dx-neg))
          ny (- (Physics.sample-sdf-trilinear world &dy-pos) (Physics.sample-sdf-trilinear world &dy-neg))
          nz (- (Physics.sample-sdf-trilinear world &dz-pos) (Physics.sample-sdf-trilinear world &dz-neg))
          
          n-len (Double.sqrt (+ (+ (* (Double.from-float nx) (Double.from-float nx)) (* (Double.from-float ny) (Double.from-float ny))) (* (Double.from-float nz) (Double.from-float nz))))]
      (if (> n-len 0.001)
          (Vector3.init (/ (Double.from-float nx) n-len) (/ (Double.from-float ny) n-len) (/ (Double.from-float nz) n-len))
          (Vector3.init 0.0 1.0 0.0))))

  (defn dmin [a b] (if (< a b) a b))
  (defn dmax [a b] (if (> a b) a b))
)

;; --- CARP-PHYSICS-3D INTEGRATION ---
(load "../../carp-physics-3d/dynamics.carp")
(load "../../carp-physics-3d/rigidbody.carp")
(load "../../carp-physics-3d/collision.carp")
(load "../../carp-physics-3d/grid.carp")
(load "../../carp-physics-3d/solver.carp")

(use Body)
(use RigidBody)
(use Collision)
(use SpatialGrid)
(use Solver)

(defmodule Volume
  (defn copy [v]
    (match-ref v
      (Volume.Box b) (Volume.Box @b)
      (Volume.Ball s) (Volume.Ball @s)
      (Volume.Surface p) (Volume.Surface @p)
      (Volume.Sdf s) (Volume.Sdf @s)))
)
(implements copy Volume.copy)



(defmodule Physics
  (defn sample-euclidean-sdf [world p]
    (let [eps 0.45
          px @(Vector3.x p)
          py @(Vector3.y p)
          pz @(Vector3.z p)
          raw-d (Double.from-float (Physics.sample-sdf-trilinear world p))
          dx-p (Vector3.init (+ px eps) py pz)
          dx-n (Vector3.init (- px eps) py pz)
          dy-p (Vector3.init px (+ py eps) pz)
          dy-n (Vector3.init px (- py eps) pz)
          dz-p (Vector3.init px py (+ pz eps))
          dz-n (Vector3.init px py (- pz eps))
           inv2e (/ 1.0 (* 2.0 eps))
          gx (* (Double.from-float (- (Physics.sample-sdf-trilinear world &dx-p) (Physics.sample-sdf-trilinear world &dx-n))) inv2e)
          gy (* (Double.from-float (- (Physics.sample-sdf-trilinear world &dy-p) (Physics.sample-sdf-trilinear world &dy-n))) inv2e)
          gz (* (Double.from-float (- (Physics.sample-sdf-trilinear world &dz-p) (Physics.sample-sdf-trilinear world &dz-n))) inv2e)
          g-mag (Double.sqrt (+ (+ (* gx gx) (* gy gy)) (* gz gz)))]
      (/ raw-d (Physics.dmax 0.35 g-mag))))

  (defn smooth-sdf-normal [world p]
    (let [eps 0.55
          px @(Vector3.x p)
          py @(Vector3.y p)
          pz @(Vector3.z p)
          dx-p (Vector3.init (+ px eps) py pz)
          dx-n (Vector3.init (- px eps) py pz)
          dy-p (Vector3.init px (+ py eps) pz)
          dy-n (Vector3.init px (- py eps) pz)
          dz-p (Vector3.init px py (+ pz eps))
          dz-n (Vector3.init px py (- pz eps))
          nx (Double.from-float (- (Physics.sample-sdf-trilinear world &dx-p) (Physics.sample-sdf-trilinear world &dx-n)))
          ny (Double.from-float (- (Physics.sample-sdf-trilinear world &dy-p) (Physics.sample-sdf-trilinear world &dy-n)))
          nz (Double.from-float (- (Physics.sample-sdf-trilinear world &dz-p) (Physics.sample-sdf-trilinear world &dz-n)))
          n-len (Double.sqrt (+ (+ (* nx nx) (* ny ny)) (* nz nz)))]
      (if (> n-len 0.001)
        (Vector3.init (/ nx n-len) (/ ny n-len) (/ nz n-len))
        (Vector3.init 0.0 1.0 0.0))))

  (defn sample-mat-at [world gx gy gz]
    (let [qx (Double.to-int (Double.floor (/ (Double.from-int gx) 32.0)))
          qy (Double.to-int (Double.floor (/ (Double.from-int gy) 32.0)))
          qz (Double.to-int (Double.floor (/ (Double.from-int gz) 32.0)))
          chunks (World.chunks world)
          tx (World.positive-mod qx 5)
          ty (World.positive-mod qy 5)
          tz (World.positive-mod qz 5)
          slot-idx (+ tx (+ (* ty 5) (* tz 25)))]
      (if (< slot-idx (Array.length chunks))
        (let [chunk (Array.unsafe-nth chunks slot-idx)]
          (if (and (= qx @(Chunk.coord-x chunk))
                   (and (= qy @(Chunk.coord-y chunk))
                        (= qz @(Chunk.coord-z chunk))))
            (let [lx (Physics.clamp 0 31 (- gx (* qx 32)))
                  ly (Physics.clamp 0 31 (- gy (* qy 32)))
                  lz (Physics.clamp 0 31 (- gz (* qz 32)))
                  idx (+ (* lz 1024) (+ (* ly 32) lx))
                  offset (* idx 4)]
              @(Array.unsafe-nth (Chunk.voxel-data chunk) offset))
            0.0f))
        0.0f)))

  (defn sample-floor-mat [world pos]
    (let [px @(Vector3.x pos)
          py @(Vector3.y pos)
          pz @(Vector3.z pos)
          gx (Double.to-int (Double.floor px))
          gz (Double.to-int (Double.floor pz))
          gy0 (Double.to-int (Double.floor (- py 0.68)))
          m0 (Physics.sample-mat-at world gx gy0 gz)]
      (if (> m0 0.5f)
        m0
        (let [gy1 (Double.to-int (Double.floor (- py 1.25)))
              m1 (Physics.sample-mat-at world gx gy1 gz)]
          (if (> m1 0.5f)
            m1
            (let [m2 (Physics.sample-mat-at world (+ gx 1) gy0 gz)]
              (if (> m2 0.5f)
                m2
                (Physics.sample-mat-at world (- gx 1) gy0 gz))))))))

  (defn find-safe-spawn-y [world sx sz]
    (let [y 52.0
          found-y 44.0
          done false]
      (do
        (while (and (> y 8.0) (not done))
          (let [p (Vector3.init sx y sz)
                d (World.sample-sdf-nearest world &p)]
            (if (<= d 0.15f)
              (do
                (set! found-y (+ y 1.35))
                (set! done true))
              (set! y (- y 0.5)))))
        found-y)))

  (sig step-physics-entities! (Fn [(Ref World) (Ref GameWorld) (Ref (SpatialGrid Int)) (Ref (Vector3 Double)) Double] ()))
  (defn step-physics-entities! [world game-world grid center-pos dt]
    (let [manifolds (the (Array Collision) [])
          ent-idxs (the (Array Uint64) [])
          ent-gens (the (Array Uint32) [])
          fixed-dt dt
          iterations 8
          dummy-static (RigidBody.static (Vector3.init 0.0 0.0 0.0) (Quaternion.identity) 0.5 0.5)
          gx (* (Double.floor (/ (- @(Vector3.x center-pos) 96.0) 8.0)) 8.0)
          gy (* (Double.floor (/ (- @(Vector3.y center-pos) 144.0) 8.0)) 8.0)
          gz (* (Double.floor (/ (- @(Vector3.z center-pos) 96.0) 8.0)) 8.0)]
      (do
        ;; 1. Reset per-tick grounded flags & step active dynamic bodies
        (query game-world (e (cb CompBody))
          (let [rb (CompBody.rb cb)]
            (do
              (when (has-component? game-world &e CompGrounded)
                (ECS.add-component! game-world &e (CompGrounded.init false)))
              (let [b (RigidBody.body rb)]
                (do
                  (Body.apply-force! b &(Vector3.init 0.0 -25.0 0.0))
                  (RigidBody.set-body! rb @b)))
              (RigidBody.step-custom! rb fixed-dt fixed-dt)
              (ECS.add-component! game-world &e (CompBody.init @rb)))))
        
        ;; 2. Re-center & rebuild Spatial Grid (1-based list IDs so 0 is strictly dummy-static)
        (SpatialGrid.set-origin! grid (Vector3.init gx gy gz))
        (SpatialGrid.clear! grid)
        (query game-world (e (cb CompBody) (cv CompVolume))
          (let [rb (CompBody.rb cb)
                pos (RigidBody.position rb)
                vol (CompVolume.vol cv)
                list-id (+ (Array.length &ent-idxs) 1)]
            (do
              (Array.push-back! &ent-idxs (ECS.Entity.index &e))
              (Array.push-back! &ent-gens (ECS.Entity.generation &e))
              (match-ref vol
                (Volume.Ball s) (Sphere.set-center! s @pos)
                (Volume.Box b)
                  (let [half-extents (Vector3.mul &(Vector3.sub (AABB.max b) (AABB.min b)) 0.5)]
                    (do
                      (AABB.set-min! b (Vector3.sub pos &half-extents))
                      (AABB.set-max! b (Vector3.add pos &half-extents))))
                _ ())
              (let [raw-aabb (Collision.get-aabb vol)
                    aabb (if (has-component? game-world &e CompPlayer)
                           (AABB.init @(AABB.min &raw-aabb)
                                      (Vector3.add (AABB.max &raw-aabb) &(Vector3.init 0.0 1.05 0.0)))
                           raw-aabb)]
                (SpatialGrid.insert! grid &aabb list-id)))))

        ;; 3. Detect Collisions
        (let [cur-lid 0]
          (query game-world (e (cb CompBody) (cv CompVolume))
            (do
              (set! cur-lid (+ cur-lid 1))
              (let [rb (CompBody.rb cb)
                    b-ref (RigidBody.body rb)
                    is-dyn (match-ref (Body.body-type b-ref)
                             (BodyType.Dynamic) (> @(Body.inv-mass b-ref) 0.0)
                             _ false)
                    is-player (has-component? game-world &e CompPlayer)
                    pos (RigidBody.position rb)
                    vol (CompVolume.vol cv)
                    raw-aabb (Collision.get-aabb vol)
                    aabb (if is-player
                           (AABB.init @(AABB.min &raw-aabb)
                                      (Vector3.add (AABB.max &raw-aabb) &(Vector3.init 0.0 1.05 0.0)))
                           raw-aabb)
                    candidates (SpatialGrid.query-unique grid &aabb)
                    contacts (the (Array Contact) [])
                    i cur-lid]
                (do
                  ;; 3a. SDF Collision (Dynamic bodies only; Kinematic noclip/crawlers bypass SDF solver)
                  (when is-dyn
                    (match-ref vol
                      (Volume.Ball s)
                        (let [rad @(Sphere.radius s)
                              d (Physics.sample-euclidean-sdf world pos)]
                          (do
                            (when (< d rad)
                              (let [depth (Physics.dmin 0.40 (- rad d))
                                    normal (Physics.smooth-sdf-normal world pos)
                                    contact-pt (Vector3.sub pos &(Vector3.mul &normal rad))]
                                (do
                                  (when (> @(Vector3.y &normal) 0.52)
                                    (when (has-component? game-world &e CompGrounded)
                                      (ECS.add-component! game-world &e (CompGrounded.init true))))
                                  (Array.push-back! &contacts (Contact.init depth contact-pt normal)))))
                            ;; Upper torso/head sphere for upright 2-sphere Player Capsule!
                            (when is-player
                              (let [head-pos (Vector3.add pos &(Vector3.init 0.0 1.05 0.0))
                                    head-r 0.44
                                    d-head (Physics.sample-euclidean-sdf world &head-pos)]
                                (when (< d-head head-r)
                                  (let [depth-h (Physics.dmin 0.40 (- head-r d-head))
                                        norm-h (Physics.smooth-sdf-normal world &head-pos)
                                        cp-h (Vector3.sub &head-pos &(Vector3.mul &norm-h head-r))]
                                    (Array.push-back! &contacts (Contact.init depth-h cp-h norm-h))))))))
                      (Volume.Box b)
                        (let [he (Vector3.mul &(Vector3.sub (AABB.max b) (AABB.min b)) 0.5)
                              hx @(Vector3.x &he)
                              hy @(Vector3.y &he)
                              hz @(Vector3.z &he)
                              px @(Vector3.x pos)
                              py @(Vector3.y pos)
                              pz @(Vector3.z pos)]
                          (for [cz 0 2]
                            (for [cy 0 2]
                              (for [cx 0 2]
                                (let [sx (if (= cx 0) (- 0.0 hx) hx)
                                      sy (if (= cy 0) (- 0.0 hy) hy)
                                      sz (if (= cz 0) (- 0.0 hz) hz)
                                      corner (Vector3.init (+ px sx) (+ py sy) (+ pz sz))
                                      dc (Physics.sample-euclidean-sdf world &corner)]
                                  (when (< dc 0.0)
                                    (let [depth-c (Physics.dmin 0.35 (- 0.0 dc))
                                          norm-c (Physics.smooth-sdf-normal world &corner)]
                                      (do
                                        (when (> @(Vector3.y &norm-c) 0.52)
                                          (when (has-component? game-world &e CompGrounded)
                                            (ECS.add-component! game-world &e (CompGrounded.init true))))
                                        (Array.push-back! &contacts (Contact.init depth-c corner norm-c))))))))))
                      _ ()))
                  
                  (when (not (Array.empty? &contacts))
                    (let [c-set (ContactSet.init (the (Handle ()) (Handle.init (Uint64.from-long (the Long (Long.from-int i))) (Uint32.from-long 1l)))
                                                  (the (Handle ()) (Handle.init (Uint64.from-long 0l) (Uint32.from-long 1l)))
                                                  @&contacts)
                          m (Collision.init c-set)]
                      (Array.push-back! &manifolds m)))
                  
                  ;; 3b. Entity Collision
                  (let [c 0
                        cand-len (Physics.clamp 0 6 (Array.length &candidates))
                        n-ents (Array.length &ent-idxs)]
                    (while (< c cand-len)
                      (do
                        (let [other-lid @(Array.unsafe-nth &candidates c)]
                          (when (and (> other-lid 0)
                                     (and (<= other-lid n-ents)
                                          (and (/= i other-lid) (< i other-lid))))
                            (let [other-ent (ECS.Entity.init (Handle.init @(Array.unsafe-nth &ent-idxs (- other-lid 1))
                                                                          @(Array.unsafe-nth &ent-gens (- other-lid 1))))]
                              (ignore (maybe-do
                                [other-cv (get-component game-world &other-ent)
                                 col1 (Maybe.Just (Collidable.init (the (Handle ()) (Handle.init (Uint64.from-long (the Long (Long.from-int i))) (Uint32.from-long 1l))) @vol (Uint32.from-long 1l) (Uint32.from-long 1l) false))
                                 col2 (Maybe.Just (Collidable.init (the (Handle ()) (Handle.init (Uint64.from-long (the Long (Long.from-int other-lid))) (Uint32.from-long 1l))) @(CompVolume.vol &other-cv) (Uint32.from-long 1l) (Uint32.from-long 1l) false))
                                 res (CollisionChecker.check-pair &col1 &col2)]
                                (match res
                                  (CollisionResult.Physical actual-col)
                                    (let [cs (Collision.contact-set &actual-col)
                                          cts (ContactSet.contacts cs)]
                                      (do
                                        (when (not (Array.empty? cts))
                                          (let [ny @(Vector3.y (Contact.normal (Array.unsafe-nth cts 0)))]
                                            (do
                                              (when (and (> ny 0.52) (has-component? game-world &e CompGrounded))
                                                (ECS.add-component! game-world &e (CompGrounded.init true)))
                                              (when (and (< ny -0.52) (has-component? game-world &other-ent CompGrounded))
                                                (ECS.add-component! game-world &other-ent (CompGrounded.init true))))))
                                        (Array.push-back! &manifolds actual-col)
                                        (Maybe.Just ())))
                                  _ (Maybe.Just ())))))))
                        (set! c (+ c 1))))))))))

        ;; 4. Solve Constraints
        (let [iter 0
              n-ents (Array.length &ent-idxs)]
          (while (< iter iterations)
            (do
              (let [m-idx 0
                    m-len (Array.length &manifolds)]
                (while (< m-idx m-len)
                  (do
                    (let [col (Array.unsafe-nth &manifolds m-idx)
                          m (Collision.contact-set col)
                          h-a (ContactSet.a m)
                          h-b (ContactSet.b m)
                          lid-a (Long.to-int (Uint64.to-long (Handle.index h-a)))
                          lid-b (Long.to-int (Uint64.to-long (Handle.index h-b)))]
                      (when (and (> lid-a 0) (<= lid-a n-ents))
                        (let [ent-a (ECS.Entity.init (Handle.init @(Array.unsafe-nth &ent-idxs (- lid-a 1))
                                                                  @(Array.unsafe-nth &ent-gens (- lid-a 1))))
                              cb-a-opt (get-component game-world &ent-a)]
                          (match cb-a-opt
                            (Maybe.Just cb-a)
                              (let [rb-a (CompBody.rb &cb-a)]
                                (if (= lid-b 0)
                                  (do
                                    (Solver.solve! rb-a &dummy-static m fixed-dt)
                                    (ECS.add-component! game-world &ent-a @&cb-a))
                                  (when (and (> lid-b 0) (<= lid-b n-ents))
                                    (let [ent-b (ECS.Entity.init (Handle.init @(Array.unsafe-nth &ent-idxs (- lid-b 1))
                                                                              @(Array.unsafe-nth &ent-gens (- lid-b 1))))
                                          cb-b-opt (get-component game-world &ent-b)]
                                      (match cb-b-opt
                                        (Maybe.Just cb-b)
                                          (let [rb-b (CompBody.rb &cb-b)]
                                            (do
                                              (Solver.solve! rb-a rb-b m fixed-dt)
                                              (ECS.add-component! game-world &ent-a @&cb-a)
                                              (ECS.add-component! game-world &ent-b @&cb-b)))
                                        (Maybe.Nothing) ())))))
                            (Maybe.Nothing) ()))))
                    (set! m-idx (+ m-idx 1)))))
              (set! iter (+ iter 1))))))))

)

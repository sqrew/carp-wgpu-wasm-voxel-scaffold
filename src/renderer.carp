(load "scaffold.carp")
(load "camera.carp")
(load "line_pass.carp")
(load "../../carp-diagnostics/diagnostics.carp")

;; WGSL shaders are loaded from shaders.carp

(deftype Renderer [
  pipeline (Ptr WGPURenderPipelineWrapper)
  bind-group WGPUBindGroup
  uniform-buffer (Ptr WGPUUniformBufferWrapper)
  voxel-texture (Ptr WGPURenderTexture)
  liquid-texture (Ptr WGPURenderTexture)
  gas-texture (Ptr WGPURenderTexture)
  light-texture (Ptr WGPURenderTexture)
  voxel-sampler WGPUSampler
  line-pass LinePassRenderer
  lines (Array Line)
  depth-texture (Ptr WGPUDepthTexture)
  width Int
  height Int
  voxel-gpu-buffer-read (Ptr WGPUVertexBufferWrapper)
  voxel-gpu-buffer-write (Ptr WGPUVertexBufferWrapper)
  voxel-half-buffer (Ptr WGPUVertexBufferWrapper)
  pack-pipeline WGPUComputePipeline
  pack-bind-group WGPUBindGroup
  voxel-staging-buffer (Ptr WGPUVertexBufferWrapper)
  copy-pipeline WGPUComputePipeline
  copy-bind-group WGPUBindGroup
  copy-uniform-buffer (Ptr WGPUUniformBufferWrapper)
  liquid-gpu-buffer (Ptr WGPUVertexBufferWrapper)
  liquid-half-buffer (Ptr WGPUVertexBufferWrapper)
  gas-gpu-buffer (Ptr WGPUVertexBufferWrapper)
  gas-half-buffer (Ptr WGPUVertexBufferWrapper)
  liquid-pack-bind-group WGPUBindGroup
  gas-pack-bind-group WGPUBindGroup
  liquid-sim-pipeline WGPUComputePipeline
  liquid-sim-bind-group WGPUBindGroup
  gas-sim-pipeline WGPUComputePipeline
  gas-sim-bind-group WGPUBindGroup
])



(defmodule Renderer
  (defn create [eng]
    (let [ctx @(Engine.ctx eng)]
      (match (WGPURender.create-3d-texture ctx 160 160 160 "rgba16float")
        (Result.Error e) (Result.Error (str* "Voxel texture failed: " e))
        (Result.Success voxel-tex)
          (match (WGPURender.create-3d-texture ctx 160 160 160 "rgba16float")
            (Result.Error e) (do (WGPURender.free-render-texture voxel-tex)
                                 (Result.Error (str* "Liquid texture failed: " e)))
            (Result.Success liquid-tex)
              (match (WGPURender.create-3d-texture ctx 160 160 160 "rgba16float")
                (Result.Error e) (do (WGPURender.free-render-texture voxel-tex)
                                     (WGPURender.free-render-texture liquid-tex)
                                     (Result.Error (str* "Gas texture failed: " e)))
                (Result.Success gas-tex)
                  (match (WGPURender.create-3d-texture ctx 160 160 160 "rgba16float")
                    (Result.Error e) (do (WGPURender.free-render-texture voxel-tex)
                                         (WGPURender.free-render-texture liquid-tex)
                                         (WGPURender.free-render-texture gas-tex)
                                         (Result.Error (str* "Light texture failed: " e)))
                    (Result.Success light-tex)
                      (match (WGPURender.create-sampler ctx)
                    (Result.Error e) (do (WGPURender.free-render-texture voxel-tex)
                                         (WGPURender.free-render-texture liquid-tex)
                                         (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex)
                                         (Result.Error (str* "Sampler failed: " e)))
                    (Result.Success voxel-sampler)
                      (match (WGPURender.create-uniform-buffer ctx 128)
                        (Result.Error e) (do (WGPURender.free-sampler voxel-sampler)
                                             (WGPURender.free-render-texture voxel-tex)
                                             (WGPURender.free-render-texture liquid-tex)
                                             (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex)
                                             (Result.Error (str* "Uniforms failed: " e)))
                        (Result.Success ub)
                          (match (Engine.create-pipeline eng voxel-wgsl "vs_main" "fs_main")
                            (Result.Error e) (do (Engine.free-uniform-buffer ub)
                                                 (WGPURender.free-sampler voxel-sampler)
                                                 (WGPURender.free-render-texture voxel-tex)
                                                 (WGPURender.free-render-texture liquid-tex)
                                                 (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex)
                                                 (Result.Error (str* "Pipeline failed: " e)))
                            (Result.Success pipe)
                              (match (Engine.create-voxel-bind-group eng pipe voxel-tex liquid-tex gas-tex light-tex voxel-sampler ub)
                                (Result.Error e) (do (Engine.free-pipeline pipe)
                                                     (Engine.free-uniform-buffer ub)
                                                     (WGPURender.free-sampler voxel-sampler)
                                                     (WGPURender.free-render-texture voxel-tex)
                                                     (WGPURender.free-render-texture liquid-tex)
                                                     (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex)
                                                     (Result.Error (str* "Bind group failed: " e)))
                                (Result.Success bg)
                                  (match (WGPU.create-pipeline ctx pack-wgsl "main")
                                    (Result.Error e) (do (Engine.free-pipeline pipe)
                                                         (Engine.free-uniform-buffer ub)
                                                         (WGPURender.free-sampler voxel-sampler)
                                                         (WGPURender.free-render-texture voxel-tex)
                                                         (WGPURender.free-render-texture liquid-tex)
                                                         (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex)
                                                         (Engine.free-bind-group bg)
                                                         (Result.Error (str* "Pack compute pipeline failed: " e)))
                                    (Result.Success pack-pipe)
                                       (let [zero 0.0f
                                             initial-data-read (Array.replicate 16384000 &zero)
                                             initial-data-half (Array.replicate 8192000 &zero)]
                                         (match (WGPURender.create-storage-vertex-buffer ctx &initial-data-read)
                                           (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (Result.Error (str* "Read SSBO failed: " e)))
                                           (Result.Success read-buf)
                                             (match (WGPURender.create-storage-vertex-buffer ctx &initial-data-read)
                                               (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (Result.Error (str* "Write SSBO failed: " e)))
                                               (Result.Success write-buf)
                                                 (match (WGPURender.create-storage-vertex-buffer ctx &initial-data-half)
                                                   (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (Result.Error (str* "Half SSBO failed: " e)))
                                                   (Result.Success half-buf)
                                                     (match (WGPURender.create-storage-vertex-buffer ctx &initial-data-read)
                                                       (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (Result.Error (str* "Liquid GPU buffer failed: " e)))
                                                       (Result.Success liquid-gpu-buf)
                                                         (match (WGPURender.create-storage-vertex-buffer ctx &initial-data-half)
                                                           (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (Result.Error (str* "Liquid half buffer failed: " e)))
                                                           (Result.Success liquid-half-buf)
                                                             (match (WGPURender.create-storage-vertex-buffer ctx &initial-data-read)
                                                               (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (Result.Error (str* "Gas GPU buffer failed: " e)))
                                                               (Result.Success gas-gpu-buf)
                                                                 (match (WGPURender.create-storage-vertex-buffer ctx &initial-data-half)
                                                                   (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (Result.Error (str* "Gas half buffer failed: " e)))
                                                                   (Result.Success gas-half-buf)
                                                                     (let [read-raw (WGPUVertexBufferWrapper.get-buffer read-buf)
                                                                           half-raw (WGPUVertexBufferWrapper.get-buffer half-buf)
                                                                           bufs [read-raw half-raw]
                                                                           liquid-raw (WGPUVertexBufferWrapper.get-buffer liquid-gpu-buf)
                                                                           liquid-half-raw (WGPUVertexBufferWrapper.get-buffer liquid-half-buf)
                                                                           liquid-bufs [liquid-raw liquid-half-raw]
                                                                           gas-raw (WGPUVertexBufferWrapper.get-buffer gas-gpu-buf)
                                                                           gas-half-raw (WGPUVertexBufferWrapper.get-buffer gas-half-buf)
                                                                           gas-bufs [gas-raw gas-half-raw]]
                                                                       (match (WGPU.create-bind-group ctx pack-pipe &bufs)
                                                                         (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (Result.Error (str* "Pack bind group failed: " e)))
                                                                         (Result.Success pack-bg)
                                                                           (match (WGPU.create-bind-group ctx pack-pipe &liquid-bufs)
                                                                             (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (Result.Error (str* "Liquid pack bind group failed: " e)))
                                                                             (Result.Success liquid-pack-bg)
                                                                               (match (WGPU.create-bind-group ctx pack-pipe &gas-bufs)
                                                                                 (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (Result.Error (str* "Gas pack bind group failed: " e)))
                                                                                 (Result.Success gas-pack-bg)
                                                                                   (match (WGPU.create-pipeline ctx copy-wgsl "main")
                                                                                     (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (WGPU.free-bind-group gas-pack-bg) (Result.Error (str* "Copy compute pipeline failed: " e)))
                                                                                     (Result.Success copy-pipe)
                                                                                       (let [zero 0.0f
                                                                                             staging-initial (Array.replicate 131072 &zero)]
                                                                                         (match (WGPURender.create-storage-vertex-buffer ctx &staging-initial)
                                                                                           (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (WGPU.free-bind-group gas-pack-bg) (WGPU.free-pipeline copy-pipe) (Result.Error (str* "Staging buffer failed: " e)))
                                                                                           (Result.Success staging-buf)
                                                                                             (match (WGPURender.create-uniform-buffer ctx 16)
                                                                                               (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (WGPU.free-bind-group gas-pack-bg) (WGPU.free-pipeline copy-pipe) (WGPURender.free-vertex-buffer staging-buf) (Result.Error (str* "Copy uniforms failed: " e)))
                                                                                               (Result.Success copy-ub)
                                                                                                 (let [staging-raw (WGPUVertexBufferWrapper.get-buffer staging-buf)
                                                                                                       read-raw (WGPUVertexBufferWrapper.get-buffer read-buf)
                                                                                                       write-raw (WGPUVertexBufferWrapper.get-buffer write-buf)
                                                                                                       ub-raw (WGPURender.uniform-buffer-get-buffer copy-ub)
                                                                                                       copy-bufs [staging-raw read-raw write-raw ub-raw]]
                                                                                                   (match (WGPU.create-bind-group ctx copy-pipe &copy-bufs)
                                                                                                     (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (WGPU.free-bind-group gas-pack-bg) (WGPU.free-pipeline copy-pipe) (WGPURender.free-vertex-buffer staging-buf) (Engine.free-uniform-buffer copy-ub) (Result.Error (str* "Copy bind group failed: " e)))
                                                                                                     (Result.Success copy-bg)
                                                                                                       (match (WGPU.create-pipeline ctx liquid-sim-wgsl "main")
                                                                                                         (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (WGPU.free-bind-group gas-pack-bg) (WGPU.free-pipeline copy-pipe) (WGPURender.free-vertex-buffer staging-buf) (Engine.free-uniform-buffer copy-ub) (WGPU.free-bind-group copy-bg) (Result.Error (str* "Liquid sim pipeline failed: " e)))
                                                                                                         (Result.Success liquid-sim-pipe)
                                                                                                           (match (WGPU.create-pipeline ctx gas-sim-wgsl "main")
                                                                                                             (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (WGPU.free-bind-group gas-pack-bg) (WGPU.free-pipeline copy-pipe) (WGPURender.free-vertex-buffer staging-buf) (Engine.free-uniform-buffer copy-ub) (WGPU.free-bind-group copy-bg) (WGPU.free-pipeline liquid-sim-pipe) (Result.Error (str* "Gas sim pipeline failed: " e)))
                                                                                                             (Result.Success gas-sim-pipe)
                                                                                                               (let [read-raw (WGPUVertexBufferWrapper.get-buffer read-buf)
                                                                                                                     write-raw (WGPUVertexBufferWrapper.get-buffer write-buf)
                                                                                                                     liquid-raw (WGPUVertexBufferWrapper.get-buffer liquid-gpu-buf)
                                                                                                                     gas-raw (WGPUVertexBufferWrapper.get-buffer gas-gpu-buf)]
                                                                                                                 (match (WGPURender.create-jit-bind-group-water ctx liquid-sim-pipe read-raw liquid-raw (WGPURender.uniform-buffer-get-buffer ub) write-raw read-raw voxel-tex liquid-tex gas-tex)
                                                                                                                   (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (WGPU.free-bind-group gas-pack-bg) (WGPU.free-pipeline copy-pipe) (WGPURender.free-vertex-buffer staging-buf) (Engine.free-uniform-buffer copy-ub) (WGPU.free-bind-group copy-bg) (WGPU.free-pipeline liquid-sim-pipe) (WGPU.free-pipeline gas-sim-pipe) (Result.Error (str* "Liquid sim bind group failed: " e)))
                                                                                                                   (Result.Success liquid-sim-bg)
                                                                                                                     (match (WGPURender.create-jit-bind-group-water ctx gas-sim-pipe read-raw gas-raw (WGPURender.uniform-buffer-get-buffer ub) read-raw read-raw voxel-tex liquid-tex gas-tex)
                                                                                                                       (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (WGPU.free-bind-group gas-pack-bg) (WGPU.free-pipeline copy-pipe) (WGPURender.free-vertex-buffer staging-buf) (Engine.free-uniform-buffer copy-ub) (WGPU.free-bind-group copy-bg) (WGPU.free-pipeline liquid-sim-pipe) (WGPU.free-pipeline gas-sim-pipe) (WGPU.free-bind-group liquid-sim-bg) (Result.Error (str* "Gas sim bind group failed: " e)))
                                                                                                                       (Result.Success gas-sim-bg)
                                                                                                                       (let [w @(Engine.width eng)
                                                                                                                             h @(Engine.height eng)]
                                                                                                                         (match (WGPURender.create-depth-texture ctx w h)
                                                                                                                           (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (WGPU.free-bind-group gas-pack-bg) (WGPU.free-pipeline copy-pipe) (WGPURender.free-vertex-buffer staging-buf) (Engine.free-uniform-buffer copy-ub) (WGPU.free-bind-group copy-bg) (WGPU.free-pipeline liquid-sim-pipe) (WGPU.free-pipeline gas-sim-pipe) (WGPU.free-bind-group liquid-sim-bg) (WGPU.free-bind-group gas-sim-bg) (Result.Error (str* "Depth texture failed: " e)))
                                                                                                                           (Result.Success depth-tex)
                                                                                                                             (let [format (WGPURender.surface-format @(Engine.surf eng))]
                                                                                                                               (match (LinePass.create ctx &format 50000)
                                                                                                                                 (Result.Error e) (do (Engine.free-pipeline pipe) (Engine.free-uniform-buffer ub) (WGPURender.free-sampler voxel-sampler) (WGPURender.free-render-texture voxel-tex) (WGPURender.free-render-texture liquid-tex) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture light-tex) (Engine.free-bind-group bg) (WGPU.free-pipeline pack-pipe) (WGPURender.free-vertex-buffer read-buf) (WGPURender.free-vertex-buffer write-buf) (WGPURender.free-vertex-buffer half-buf) (WGPURender.free-vertex-buffer liquid-gpu-buf) (WGPURender.free-vertex-buffer liquid-half-buf) (WGPURender.free-vertex-buffer gas-gpu-buf) (WGPURender.free-vertex-buffer gas-half-buf) (WGPU.free-bind-group pack-bg) (WGPU.free-bind-group liquid-pack-bg) (WGPU.free-bind-group gas-pack-bg) (WGPU.free-pipeline copy-pipe) (WGPURender.free-vertex-buffer staging-buf) (Engine.free-uniform-buffer copy-ub) (WGPU.free-bind-group copy-bg) (WGPU.free-pipeline liquid-sim-pipe) (WGPU.free-pipeline gas-sim-pipe) (WGPU.free-bind-group liquid-sim-bg) (WGPU.free-bind-group gas-sim-bg) (WGPURender.free-depth-texture depth-tex) (Result.Error (str* "LinePass creation failed: " e)))
                                                                                                                                 (Result.Success lp)
                                                                                                                                   (Result.Success (Renderer.init pipe bg ub voxel-tex liquid-tex gas-tex light-tex voxel-sampler lp [] depth-tex w h
                                                                                                                                                                                  read-buf write-buf half-buf pack-pipe pack-bg
                                                                                                                                                                                  staging-buf copy-pipe copy-bg copy-ub
                                                                                                                                                                                  liquid-gpu-buf liquid-half-buf gas-gpu-buf gas-half-buf
                                                                                                                                                                                   liquid-pack-bg gas-pack-bg liquid-sim-pipe liquid-sim-bg gas-sim-pipe gas-sim-bg))))))))))))))))))))))))))))))))))))))))





  (defn positive-mod [n m]
    (let [r (Int.mod n m)]
      (if (< r 0) (+ r m) r)))

  (defn update-chunk-texture [eng ren qx qy qz chunk-data]
    (let [ctx @(Engine.ctx eng)
          tx (positive-mod qx 5)
          ty (positive-mod qy 5)
          tz (positive-mod qz 5)
          offset-x (Float.from-int (* tx 32))
          offset-y (Float.from-int (* ty 32))
          offset-z (Float.from-int (* tz 32))
          staging-buf @(Renderer.voxel-staging-buffer ren)
          copy-ub @(Renderer.copy-uniform-buffer ren)]
      (do
        (WGPURender.update-vertex-buffer ctx staging-buf chunk-data)
        (let [params-arr [offset-x offset-y offset-z 0.0f]]
          (Engine.update-uniform-buffer eng copy-ub &params-arr))
        (let [batch-encoder (GPUBatcher.begin-batch ctx)]
          (do
            (GPUBatcher.batch-dispatch batch-encoder @(Renderer.copy-pipeline ren) @(Renderer.copy-bind-group ren) 512)
            (GPUBatcher.end-batch ctx batch-encoder))))))




  (defn draw-line! [ren start end color]
    (Array.push-back! (Renderer.lines ren) (Line.init @start @end @color)))

  (defn clear-lines! [ren]
    (let [lns (Renderer.lines ren)]
      (while (not (Array.empty? lns))
        (ignore (Array.pop-back! lns)))))

  (defn handle-resize! [eng ren]
    (let [curr-w @(Engine.width eng)
          curr-h @(Engine.height eng)
          old-w @(Renderer.width ren)
          old-h @(Renderer.height ren)]
      (do
        (when (or (/= curr-w old-w) (/= curr-h old-h))
          (let [ctx @(Engine.ctx eng)
                old-dt @(Renderer.depth-texture ren)]
            (do
              (WGPURender.free-depth-texture old-dt)
              (match (WGPURender.create-depth-texture ctx curr-w curr-h)
                (Result.Error e) (IO.println &(str* "Error recreating depth texture: " e))
                (Result.Success new-dt)
                  (do
                    (Renderer.set-depth-texture! ren new-dt)
                    (Renderer.set-width! ren curr-w)
                    (Renderer.set-height! ren curr-h)))))))))

  (defn run-simulation-passes! [eng ren]
    (let [ctx @(Engine.ctx eng)
          batch-encoder (GPUBatcher.begin-batch ctx)]
      (do
        ;; 1. Run simulation passes (reads textures, writes to SSBOs)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.liquid-sim-pipeline ren) @(Renderer.liquid-sim-bind-group ren) 64000)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.gas-sim-pipeline ren) @(Renderer.gas-sim-bind-group ren) 64000)
        
        ;; 2. Copy updated write-buffer (which simulation wrote to) to read-buffer on the GPU
        (GPUBatcher.batch-copy-buffer batch-encoder
                                      (WGPUVertexBufferWrapper.get-buffer @(Renderer.voxel-gpu-buffer-write ren))
                                      (WGPUVertexBufferWrapper.get-buffer @(Renderer.voxel-gpu-buffer-read ren))
                                      65536000l)
        (GPUBatcher.end-batch ctx batch-encoder))))

  (defn pack-buffers-to-textures! [eng ren]
    (let [ctx @(Engine.ctx eng)
          batch-encoder (GPUBatcher.begin-batch ctx)]
      (do
        ;; 1. Run pack passes (packs SSBOs into half buffers)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.pack-pipeline ren) @(Renderer.pack-bind-group ren) 64000)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.pack-pipeline ren) @(Renderer.liquid-pack-bind-group ren) 64000)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.pack-pipeline ren) @(Renderer.gas-pack-bind-group ren) 64000)
        
        ;; 2. Copy half buffers to 3D textures
        (GPUBatcher.batch-copy-texture batch-encoder
                                       (WGPUVertexBufferWrapper.get-buffer @(Renderer.voxel-half-buffer ren))
                                       0l
                                       @(Renderer.voxel-texture ren)
                                       0 0 0
                                       160 160 160)
        (GPUBatcher.batch-copy-texture batch-encoder
                                       (WGPUVertexBufferWrapper.get-buffer @(Renderer.liquid-half-buffer ren))
                                       0l
                                       @(Renderer.liquid-texture ren)
                                       0 0 0
                                       160 160 160)
        (GPUBatcher.batch-copy-texture batch-encoder
                                       (WGPUVertexBufferWrapper.get-buffer @(Renderer.gas-half-buffer ren))
                                       0l
                                       @(Renderer.gas-texture ren)
                                       0 0 0
                                       160 160 160)
        (GPUBatcher.end-batch ctx batch-encoder))))

  (defn draw [eng ren cam diag]
    (do
      (Diagnostics.with-zone diag "Resize Check" (Renderer.handle-resize! eng ren))
      (Diagnostics.with-zone diag "Compute Sim Passes" (Renderer.run-simulation-passes! eng ren))
      (Diagnostics.with-zone diag "Pack Buffers to Textures" (Renderer.pack-buffers-to-textures! eng ren))
      (match (Engine.begin-frame eng)
        (Maybe.Nothing) ()
        (Maybe.Just frame)
          (let [vp (Camera.view-projection cam)
                vp-data (CameraMat4.data &vp)
                ctx @(Engine.ctx eng)
                line-count (LinePass.update! ctx (Renderer.line-pass ren) vp-data (Renderer.lines ren))
                depth @(Renderer.depth-texture ren)]
            (do
              ;; 1. Voxel pass (raymarching render)
              (Diagnostics.with-zone diag "WGPU Voxel Raymarch"
                (WGPURender.run-pass frame @(Renderer.pipeline ren) @(Renderer.bind-group ren) (Maybe.Nothing)))
              
              ;; 2. Line pass (drawn on top)
              (Diagnostics.with-zone diag "WGPU Line Pass"
                (LinePass.render frame ctx (Renderer.line-pass ren) line-count depth (Maybe.Nothing)))
              
              ;; 3. Clear lines
              (Renderer.clear-lines! ren)
              
              ;; 4. Present
              (Diagnostics.with-zone diag "Present Frame"
                (Engine.end-frame eng frame)))))))


  (defn cleanup [eng ren]
    (do
      (Renderer.clear-lines! ren)
      (LinePass.cleanup (Renderer.line-pass ren))
      (WGPURender.free-depth-texture @(Renderer.depth-texture ren))
      (Engine.free-bind-group @(Renderer.bind-group ren))
      (Engine.free-pipeline @(Renderer.pipeline ren))
      (Engine.free-uniform-buffer @(Renderer.uniform-buffer ren))
      (WGPURender.free-sampler @(Renderer.voxel-sampler ren))
      (WGPURender.free-render-texture @(Renderer.voxel-texture ren))
      (WGPURender.free-render-texture @(Renderer.liquid-texture ren))
      (WGPURender.free-render-texture @(Renderer.gas-texture ren))
      (WGPURender.free-render-texture @(Renderer.light-texture ren))
      (WGPURender.free-vertex-buffer @(Renderer.voxel-gpu-buffer-read ren))
      (WGPURender.free-vertex-buffer @(Renderer.voxel-gpu-buffer-write ren))
      (WGPURender.free-vertex-buffer @(Renderer.voxel-half-buffer ren))
      (WGPU.free-bind-group @(Renderer.pack-bind-group ren))
      (WGPU.free-pipeline @(Renderer.pack-pipeline ren))
      (WGPURender.free-vertex-buffer @(Renderer.voxel-staging-buffer ren))
      (WGPU.free-pipeline @(Renderer.copy-pipeline ren))
      (WGPU.free-bind-group @(Renderer.copy-bind-group ren))
      (Engine.free-uniform-buffer @(Renderer.copy-uniform-buffer ren))))
)




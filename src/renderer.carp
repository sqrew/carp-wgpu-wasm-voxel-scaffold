(load "scaffold.carp")
(load "camera.carp")
(load "line_pass.carp")
(load "../../carp-diagnostics/diagnostics.carp")

(relative-include "gpu_readback.h")
(register gpu-readback-create-map-buffer (Fn [(Ptr WGPUContext)] WGPUBuffer) "gpu_readback_create_map_buffer")
(register gpu-readback-is-mapping (Fn [] Bool) "gpu_readback_is_mapping")
(register gpu-readback-tick (Fn [(Ptr WGPUContext)] ()) "gpu_readback_tick")
(register gpu-readback-hit-pos-async (Fn [WGPUBuffer] ()) "gpu_readback_hit_pos_async")
(register gpu-readback-get-hit-x (Fn [] Float) "gpu_readback_get_hit_x")
(register gpu-readback-get-hit-y (Fn [] Float) "gpu_readback_get_hit_y")
(register gpu-readback-get-hit-z (Fn [] Float) "gpu_readback_get_hit_z")
(register gpu-readback-get-hit-w (Fn [] Float) "gpu_readback_get_hit_w")
(register gpu-readback-create-chunk-map-buffer (Fn [(Ptr WGPUContext)] WGPUBuffer) "gpu_readback_create_chunk_map_buffer")
(register gpu-readback-is-chunk-mapping (Fn [] Bool) "gpu_readback_is_chunk_mapping")
(register gpu-readback-is-chunk-ready (Fn [] Bool) "gpu_readback_is_chunk_ready")
(register gpu-readback-chunk-async (Fn [WGPUBuffer] ()) "gpu_readback_chunk_async")
(register gpu-readback-consume-chunk (Fn [(Ptr Float)] ()) "gpu_readback_consume_chunk")

;; WGSL shaders are loaded from shaders.carp


(deftype M-RenderPipeline [p (Ptr WGPURenderPipelineWrapper)])
(defmodule M-RenderPipeline (defn delete [x] (WGPURender.free-pipeline @(M-RenderPipeline.p x))))
(implements delete M-RenderPipeline.delete)

(deftype M-UniformBuffer [p (Ptr WGPUUniformBufferWrapper)])
(defmodule M-UniformBuffer (defn delete [x] (WGPURender.free-uniform-buffer @(M-UniformBuffer.p x))))
(implements delete M-UniformBuffer.delete)

(deftype M-RenderTexture [p (Ptr WGPURenderTexture)])
(defmodule M-RenderTexture (defn delete [x] (WGPURender.free-render-texture @(M-RenderTexture.p x))))
(implements delete M-RenderTexture.delete)

(deftype M-DepthTexture [p (Ptr WGPUDepthTexture)])
(defmodule M-DepthTexture (defn delete [x] (WGPURender.free-depth-texture @(M-DepthTexture.p x))))
(implements delete M-DepthTexture.delete)

(deftype M-VertexBuffer [p (Ptr WGPUVertexBufferWrapper)])
(defmodule M-VertexBuffer (defn delete [x] (WGPURender.free-vertex-buffer @(M-VertexBuffer.p x))))
(implements delete M-VertexBuffer.delete)

(defmodule WGPUComputePipeline (defn delete [x] (WGPU.free-pipeline @x)))
(implements delete WGPUComputePipeline.delete)
(defmodule WGPUBindGroup (defn delete [x] (WGPU.free-bind-group @x)))
(implements delete WGPUBindGroup.delete)
(defmodule WGPUSampler (defn delete [x] (WGPURender.free-sampler @x)))
(implements delete WGPUSampler.delete)

(deftype Renderer [
  pipeline M-RenderPipeline
  bind-group WGPUBindGroup
  uniform-buffer M-UniformBuffer
  voxel-texture M-RenderTexture
  liquid-texture M-RenderTexture
  gas-texture M-RenderTexture
  light-texture M-RenderTexture
  voxel-sampler WGPUSampler
  line-pass LinePassRenderer
  lines (Array Line)
  depth-texture M-DepthTexture
  width Int
  height Int
  voxel-gpu-buffer-read M-VertexBuffer
  voxel-gpu-buffer-write M-VertexBuffer
  voxel-half-buffer M-VertexBuffer
  pack-pipeline WGPUComputePipeline
  pack-bind-group WGPUBindGroup
  voxel-staging-buffer M-VertexBuffer
  copy-pipeline WGPUComputePipeline
  copy-bind-group WGPUBindGroup
  copy-uniform-buffer M-UniformBuffer
  liquid-gpu-buffer M-VertexBuffer
  liquid-half-buffer M-VertexBuffer
  gas-gpu-buffer M-VertexBuffer
  gas-half-buffer M-VertexBuffer
  liquid-pack-bind-group WGPUBindGroup
  gas-pack-bind-group WGPUBindGroup
  liquid-sim-pipeline WGPUComputePipeline
  liquid-sim-bind-group WGPUBindGroup
  gas-sim-pipeline WGPUComputePipeline
  gas-sim-bind-group WGPUBindGroup
  solid-sim-pipeline WGPUComputePipeline
  solid-sim-bind-group WGPUBindGroup
  hit-buffer M-VertexBuffer
  map-buffer WGPUBuffer
  raycast-pipeline WGPUComputePipeline
  raycast-bind-group WGPUBindGroup
  chunk-map-buffer WGPUBuffer
  sync-chunk-pipeline WGPUComputePipeline
  sync-chunk-bind-group WGPUBindGroup
  sync-chunk-uniform-buffer M-UniformBuffer
  materials-buffer M-VertexBuffer
])



(defmodule Renderer
      (defn create [eng]
    (let [ctx @(M-WGPUContext.p (Engine.ctx eng))]
      (result-do
        [voxel-tex-ptr (WGPURender.create-3d-texture ctx 160 160 160 "rgba16float")
         voxel-tex (Result.Success (M-RenderTexture.init voxel-tex-ptr))
         
         liquid-tex-ptr (WGPURender.create-3d-texture ctx 160 160 160 "rgba16float")
         liquid-tex (Result.Success (M-RenderTexture.init liquid-tex-ptr))
         
         gas-tex-ptr (WGPURender.create-3d-texture ctx 160 160 160 "rgba16float")
         gas-tex (Result.Success (M-RenderTexture.init gas-tex-ptr))
         
         light-tex-ptr (WGPURender.create-3d-texture ctx 160 160 160 "rgba16float")
         light-tex (Result.Success (M-RenderTexture.init light-tex-ptr))
         
         voxel-sampler (WGPURender.create-sampler ctx)
         
         w (Result.Success @(Engine.width eng))
         h (Result.Success @(Engine.height eng))
         format (Result.Success (WGPURender.surface-format @(M-WGPUSurface.p (Engine.surf eng))))
         depth-tex-ptr (WGPURender.create-depth-texture ctx w h)
         depth-tex (Result.Success (M-DepthTexture.init depth-tex-ptr))
         
         ub-ptr (WGPURender.create-uniform-buffer ctx 1664)
         ub (Result.Success (M-UniformBuffer.init ub-ptr))
         
         pipe-ptr (Engine.create-pipeline eng voxel-wgsl "vs_main" "fs_main")
         pipe (Result.Success (M-RenderPipeline.init pipe-ptr))
         
         
         initial-data-read (Result.Success (Array.replicate 16384000 &0.0f))
         initial-data-half (Result.Success (Array.replicate 8192000 &0.0f))
         
         read-buf-ptr (WGPURender.create-storage-vertex-buffer ctx &initial-data-read)
         read-buf (Result.Success (M-VertexBuffer.init read-buf-ptr))
         
         write-buf-ptr (WGPURender.create-storage-vertex-buffer ctx &initial-data-read)
         write-buf (Result.Success (M-VertexBuffer.init write-buf-ptr))
         
         half-buf-ptr (WGPURender.create-storage-vertex-buffer ctx &initial-data-half)
         half-buf (Result.Success (M-VertexBuffer.init half-buf-ptr))
         
         liquid-gpu-buf-ptr (WGPURender.create-storage-vertex-buffer ctx &initial-data-read)
         liquid-gpu-buf (Result.Success (M-VertexBuffer.init liquid-gpu-buf-ptr))
         
         liquid-half-buf-ptr (WGPURender.create-storage-vertex-buffer ctx &initial-data-half)
         liquid-half-buf (Result.Success (M-VertexBuffer.init liquid-half-buf-ptr))
         
         gas-gpu-buf-ptr (WGPURender.create-storage-vertex-buffer ctx &initial-data-read)
         gas-gpu-buf (Result.Success (M-VertexBuffer.init gas-gpu-buf-ptr))
         
         gas-half-buf-ptr (WGPURender.create-storage-vertex-buffer ctx &initial-data-half)
         gas-half-buf (Result.Success (M-VertexBuffer.init gas-half-buf-ptr))
         

         staging-buf-ptr (WGPURender.create-storage-vertex-buffer ctx &initial-data-read)
         staging-buf (Result.Success (M-VertexBuffer.init staging-buf-ptr))
         
         _mat_init (Result.Success (Materials.init-registry!))
         mat-data (Result.Success (Materials.pack-registry))
         mat-buf-ptr (WGPURender.create-storage-vertex-buffer ctx &mat-data)
         mat-buf (Result.Success (M-VertexBuffer.init mat-buf-ptr))
         mat-raw (Result.Success (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p &mat-buf)))
         bg (Engine.create-voxel-bind-group eng @(M-RenderPipeline.p &pipe) @(M-RenderTexture.p &voxel-tex) @(M-RenderTexture.p &liquid-tex) @(M-RenderTexture.p &gas-tex) @(M-RenderTexture.p &light-tex) voxel-sampler @(M-UniformBuffer.p &ub) @(M-VertexBuffer.p &mat-buf))
         
         copy-ub-ptr (WGPURender.create-uniform-buffer ctx 16)
         copy-ub (Result.Success (M-UniformBuffer.init copy-ub-ptr))
         
         read-raw (Result.Success (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p &read-buf)))
         half-raw (Result.Success (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p &half-buf)))
         bufs (Result.Success [@&read-raw @&half-raw])
         
         liquid-raw (Result.Success (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p &liquid-gpu-buf)))
         liquid-half-raw (Result.Success (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p &liquid-half-buf)))
         liquid-bufs (Result.Success [@&liquid-raw @&liquid-half-raw])
         
         gas-raw (Result.Success (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p &gas-gpu-buf)))
         gas-half-raw (Result.Success (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p &gas-half-buf)))
         gas-bufs (Result.Success [@&gas-raw @&gas-half-raw])
         
         pack-pipe (WGPU.create-pipeline ctx pack-wgsl "main")
         pack-bg (WGPU.create-bind-group ctx pack-pipe &bufs)
         liquid-pack-bg (WGPU.create-bind-group ctx pack-pipe &liquid-bufs)
         gas-pack-bg (WGPU.create-bind-group ctx pack-pipe &gas-bufs)
         
         copy-pipe (WGPU.create-pipeline ctx copy-wgsl "main")
         
         write-raw (Result.Success (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p &write-buf)))
         ub-raw (Result.Success (WGPURender.uniform-buffer-get-buffer @(M-UniformBuffer.p &copy-ub)))
         staging-raw (Result.Success (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p &staging-buf)))
         copy-bufs (Result.Success [@&staging-raw @&read-raw @&write-raw @&ub-raw])
         
         copy-bg (WGPU.create-bind-group ctx copy-pipe &copy-bufs)
         
         liquid-sim-pipe (WGPU.create-pipeline ctx liquid-sim-wgsl "main")
         gas-sim-pipe (WGPU.create-pipeline ctx gas-sim-wgsl "main")
         solid-sim-pipe (WGPU.create-pipeline ctx solid-sim-wgsl "main")
         raycast-pipe (WGPU.create-pipeline ctx ShadersRaycast.raycast-wgsl "main")
         
         main-ub-raw (Result.Success (WGPURender.uniform-buffer-get-buffer @(M-UniformBuffer.p &ub)))
         
         hit-data (Result.Success (Array.replicate 4 &0.0f))
         hit-buf-ptr (WGPURender.create-storage-vertex-buffer ctx &hit-data)
         hit-buf (Result.Success (M-VertexBuffer.init hit-buf-ptr))
         hit-raw (Result.Success (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p &hit-buf)))
         map-buf (Result.Success (gpu-readback-create-map-buffer ctx))
         
         liquid-sim-bg (WGPURender.create-jit-bind-group-water ctx liquid-sim-pipe @&read-raw @&liquid-raw @&main-ub-raw @&write-raw @&mat-raw @(M-RenderTexture.p &voxel-tex) @(M-RenderTexture.p &liquid-tex) @(M-RenderTexture.p &gas-tex))
         gas-sim-bg (WGPURender.create-jit-bind-group-water ctx gas-sim-pipe @&read-raw @&gas-raw @&main-ub-raw @&read-raw @&mat-raw @(M-RenderTexture.p &voxel-tex) @(M-RenderTexture.p &liquid-tex) @(M-RenderTexture.p &gas-tex))
         solid-sim-bg (WGPURender.create-jit-bind-group-water ctx solid-sim-pipe @&read-raw @&write-raw @&main-ub-raw @&staging-raw @&mat-raw @(M-RenderTexture.p &voxel-tex) @(M-RenderTexture.p &liquid-tex) @(M-RenderTexture.p &gas-tex))
         
         raycast-bg (WGPURender.create-jit-bind-group-water ctx raycast-pipe @&read-raw @&read-raw @&main-ub-raw @&hit-raw @&mat-raw @(M-RenderTexture.p &voxel-tex) @(M-RenderTexture.p &liquid-tex) @(M-RenderTexture.p &gas-tex))
         
         sync-chunk-pipe (WGPU.create-pipeline ctx ShadersSyncChunk.sync-chunk-wgsl "main")
         sync-chunk-ub-ptr (WGPURender.create-uniform-buffer ctx 16)
         sync-chunk-ub (Result.Success (M-UniformBuffer.init sync-chunk-ub-ptr))
         sync-chunk-ub-raw (Result.Success (WGPURender.uniform-buffer-get-buffer @(M-UniformBuffer.p &sync-chunk-ub)))
         sync-chunk-bg (WGPURender.create-jit-bind-group-water ctx sync-chunk-pipe @&read-raw @&staging-raw @&sync-chunk-ub-raw @&read-raw @&mat-raw @(M-RenderTexture.p &voxel-tex) @(M-RenderTexture.p &liquid-tex) @(M-RenderTexture.p &gas-tex))
         chunk-map-buf (Result.Success (gpu-readback-create-chunk-map-buffer ctx))
         
         lp (LinePass.create ctx &format 50000)
         
         ren (Result.Success (Renderer.init pipe bg ub voxel-tex liquid-tex gas-tex light-tex voxel-sampler lp [] depth-tex w h
                                            read-buf write-buf half-buf pack-pipe pack-bg
                                            staging-buf copy-pipe copy-bg copy-ub
                                            liquid-gpu-buf liquid-half-buf gas-gpu-buf gas-half-buf
                                            liquid-pack-bg gas-pack-bg liquid-sim-pipe liquid-sim-bg gas-sim-pipe gas-sim-bg solid-sim-pipe solid-sim-bg
                                            hit-buf map-buf raycast-pipe raycast-bg chunk-map-buf sync-chunk-pipe sync-chunk-bg sync-chunk-ub mat-buf))]
        (Result.Success ren))))

(defn update-chunk-texture [eng ren qx qy qz chunk-data]
    (let [ctx @(M-WGPUContext.p (Engine.ctx eng))
          tx (Int.positive-mod qx 5)
          ty (Int.positive-mod qy 5)
          tz (Int.positive-mod qz 5)
          offset-x (Float.from-int (* tx 32))
          offset-y (Float.from-int (* ty 32))
          offset-z (Float.from-int (* tz 32))
          staging-buf @(M-VertexBuffer.p (Renderer.voxel-staging-buffer ren))
          copy-ub @(M-UniformBuffer.p (Renderer.copy-uniform-buffer ren))]
      (do
        (WGPURender.update-vertex-buffer ctx staging-buf chunk-data)
        (let [params-arr [offset-x offset-y offset-z 0.0f]]
          (Engine.update-uniform-buffer eng copy-ub &params-arr))
        (let [batch-encoder (GPUBatcher.begin-batch ctx)]
          (do
            (GPUBatcher.batch-dispatch batch-encoder @(Renderer.copy-pipeline ren) @(Renderer.copy-bind-group ren) 512)
            (GPUBatcher.end-batch ctx batch-encoder))))))




  (defn draw-line! [ren start end color]
    (Array.push-back! (Renderer.lines ren) (Line.init @start @end @color)))

  (defn clear-lines! [ren]
    (let [lns (Renderer.lines ren)]
      (while (not (Array.empty? lns))
        (ignore (Array.pop-back! lns)))))

    (defn handle-resize! [eng ren]
    (let [curr-w @(Engine.width eng)
          curr-h @(Engine.height eng)
          old-w @(Renderer.width ren)
          old-h @(Renderer.height ren)]
      (do
        (when (or (/= curr-w old-w) (/= curr-h old-h))
          (let [ctx @(M-WGPUContext.p (Engine.ctx eng))]
            (match (WGPURender.create-depth-texture ctx curr-w curr-h)
              (Result.Error e) (IO.println &(str* "Error recreating depth texture: " e))
              (Result.Success new-dt)
                (do
                  (Renderer.set-depth-texture! ren (M-DepthTexture.init new-dt))
                  (Renderer.set-width! ren curr-w)
                  (Renderer.set-height! ren curr-h))))))))

(defn run-simulation-passes! [eng ren]
    (let [ctx @(M-WGPUContext.p (Engine.ctx eng))
          batch-encoder (GPUBatcher.begin-batch ctx)]
      (do
        (gpu-readback-tick ctx)
        ;; 1. Run simulation passes (reads textures, writes to SSBOs)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.liquid-sim-pipeline ren) @(Renderer.liquid-sim-bind-group ren) 64000)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.gas-sim-pipeline ren) @(Renderer.gas-sim-bind-group ren) 64000)
        
        ;; 2. Copy intermediate melted solids (from write-buffer) back into read-buffer
        (GPUBatcher.batch-copy-buffer batch-encoder
                                      (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p (Renderer.voxel-gpu-buffer-write ren)))
                                      (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p (Renderer.voxel-gpu-buffer-read ren)))
                                      65536000l)

        ;; 3. Run solid sim (which now reads from the updated read-buffer!)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.solid-sim-pipeline ren) @(Renderer.solid-sim-bind-group ren) 64000)
        
        ;; 4. Copy final falling-sand solids to read-buffer for the pack pass
        (GPUBatcher.batch-copy-buffer batch-encoder
                                      (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p (Renderer.voxel-gpu-buffer-write ren)))
                                      (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p (Renderer.voxel-gpu-buffer-read ren)))
                                      65536000l)
        (if (gpu-readback-is-mapping)
          ()
          (do
            (GPUBatcher.batch-dispatch batch-encoder @(Renderer.raycast-pipeline ren) @(Renderer.raycast-bind-group ren) 1)
            (GPUBatcher.batch-copy-buffer batch-encoder (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p (Renderer.hit-buffer ren))) @(Renderer.map-buffer ren) 16l)))
        (GPUBatcher.end-batch ctx batch-encoder)
        (if (gpu-readback-is-mapping)
          ()
          (gpu-readback-hit-pos-async @(Renderer.map-buffer ren))))))

  (defn pack-buffers-to-textures! [eng ren]
    (let [ctx @(M-WGPUContext.p (Engine.ctx eng))
          batch-encoder (GPUBatcher.begin-batch ctx)]
      (do
        (gpu-readback-tick ctx)
        ;; 1. Run pack passes (packs SSBOs into half buffers)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.pack-pipeline ren) @(Renderer.pack-bind-group ren) 64000)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.pack-pipeline ren) @(Renderer.liquid-pack-bind-group ren) 64000)
        (GPUBatcher.batch-dispatch batch-encoder @(Renderer.pack-pipeline ren) @(Renderer.gas-pack-bind-group ren) 64000)
        
        ;; 2. Copy half buffers to 3D textures
        (GPUBatcher.batch-copy-texture batch-encoder
                                       (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p (Renderer.voxel-half-buffer ren)))
                                       0l
                                       @(M-RenderTexture.p (Renderer.voxel-texture ren))
                                       0 0 0
                                       160 160 160)
        (GPUBatcher.batch-copy-texture batch-encoder
                                       (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p (Renderer.liquid-half-buffer ren)))
                                       0l
                                       @(M-RenderTexture.p (Renderer.liquid-texture ren))
                                       0 0 0
                                       160 160 160)
        (GPUBatcher.batch-copy-texture batch-encoder
                                       (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p (Renderer.gas-half-buffer ren)))
                                       0l
                                       @(M-RenderTexture.p (Renderer.gas-texture ren))
                                       0 0 0
                                       160 160 160)
        (GPUBatcher.end-batch ctx batch-encoder))))

  (defn draw [eng ren cam diag]
    (do
      (Diagnostics.with-zone diag "Resize Check" (Renderer.handle-resize! eng ren))
      (Diagnostics.with-zone diag "Compute Sim Passes" (Renderer.run-simulation-passes! eng ren))
      (Diagnostics.with-zone diag "Pack Buffers to Textures" (Renderer.pack-buffers-to-textures! eng ren))
      (match (Engine.begin-frame eng)
        (Maybe.Nothing) ()
        (Maybe.Just frame)
          (let [vp (Camera.view-projection cam)
                vp-data (CameraMat4.data &vp)
                ctx @(M-WGPUContext.p (Engine.ctx eng))
                line-count (LinePass.update! ctx (Renderer.line-pass ren) vp-data (Renderer.lines ren))
                depth @(M-DepthTexture.p (Renderer.depth-texture ren))]
            (do
              ;; 1. Voxel pass (raymarching render)
              (Diagnostics.with-zone diag "WGPU Voxel Raymarch"
                (WGPURender.run-pass frame @(M-RenderPipeline.p (Renderer.pipeline ren)) @(Renderer.bind-group ren) (Maybe.Nothing)))
              
              ;; 2. Line pass (drawn on top)
              (Diagnostics.with-zone diag "WGPU Line Pass"
                (LinePass.render frame ctx (Renderer.line-pass ren) line-count depth (Maybe.Nothing)))
              
              ;; 3. Clear lines
              (Renderer.clear-lines! ren)
              
              ;; 4. Present
              (Diagnostics.with-zone diag "Present Frame"
                (Engine.end-frame eng frame)))))))


  )

  (defn sync-chunk-async! [eng ren qx qy qz]
    (let [ctx @(M-WGPUContext.p (Engine.ctx eng))
          is-mapping (gpu-readback-is-chunk-mapping)]
      (if is-mapping
        ()
        (let [tx (Int.positive-mod qx 5)
              ty (Int.positive-mod qy 5)
              tz (Int.positive-mod qz 5)
              offset-x (Float.from-int (* tx 32))
              offset-y (Float.from-int (* ty 32))
              offset-z (Float.from-int (* tz 32))
              sync-ub @(M-UniformBuffer.p (Renderer.sync-chunk-uniform-buffer ren))
              params-arr [offset-x offset-y offset-z 0.0f]]
          (do
            (Engine.update-uniform-buffer eng sync-ub &params-arr)
            (let [batch-encoder (GPUBatcher.begin-batch ctx)]
              (do
                (GPUBatcher.batch-dispatch batch-encoder @(Renderer.sync-chunk-pipeline ren) @(Renderer.sync-chunk-bind-group ren) 512)
                (GPUBatcher.batch-copy-buffer batch-encoder (WGPUVertexBufferWrapper.get-buffer @(M-VertexBuffer.p (Renderer.voxel-staging-buffer ren))) @(Renderer.chunk-map-buffer ren) 524288l)
                (GPUBatcher.end-batch ctx batch-encoder)))
            (gpu-readback-chunk-async @(Renderer.chunk-map-buffer ren)))))))

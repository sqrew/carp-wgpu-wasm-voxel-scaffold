(load "scaffold.carp")
(load "camera.carp")
(load "line_pass.carp")

(def voxel-wgsl
  "struct Uniforms {
    time: f32,
    width: f32,
    height: f32,
    _pad0: f32,
    cam_pos: vec4<f32>,
    cam_dir: vec4<f32>,
    cam_right: vec4<f32>,
    cam_up: vec4<f32>,
}

@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(1) var voxel_texture: texture_3d<f32>;
@group(0) @binding(2) var voxel_sampler: sampler;

struct VertexOutput {
    @builtin(position) position: vec4<f32>,
    @location(0) uv: vec2<f32>,
}

@vertex
fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
    var pos: array<vec2<f32>, 3> = array<vec2<f32>, 3>(
        vec2<f32>(-1.0, -1.0),
        vec2<f32>( 3.0, -1.0),
        vec2<f32>(-1.0,  3.0),
    );
    var out: VertexOutput;
    let p = pos[vi];
    out.position = vec4<f32>(p, 0.0, 1.0);
    out.uv = (p + 1.0) * 0.5;
    return out;
}

fn intersect_box(ro: vec3<f32>, rd: vec3<f32>, box_min: vec3<f32>, box_max: vec3<f32>, t0: ptr<function, f32>, t1: ptr<function, f32>) -> bool {
    let inv_d = 1.0 / rd;
    let t_bot = inv_d * (box_min - ro);
    let t_top = inv_d * (box_max - ro);
    let t_min = min(t_bot, t_top);
    let t_max = max(t_bot, t_top);
    let t_near = max(t_min.x, max(t_min.y, t_min.z));
    let t_far = min(t_max.x, min(t_max.y, t_max.z));
    *t0 = t_near;
    *t1 = t_far;
    return t_near < t_far && t_far > 0.0;
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    let aspect = u.width / u.height;
    let uv = (in.uv * 2.0 - 1.0) * vec2<f32>(aspect, 1.0);
    
    let ro = u.cam_pos.xyz;
    let rd = normalize(u.cam_dir.xyz * 2.0 + uv.x * u.cam_right.xyz + uv.y * u.cam_up.xyz);
    
    let box_min = vec3<f32>(0.0, 0.0, 0.0);
    let box_max = vec3<f32>(32.0, 32.0, 32.0);
    
    var t_near: f32 = 0.0;
    var t_far: f32 = 0.0;
    
    var color = vec3<f32>(0.05, 0.08, 0.15);
    
    if (intersect_box(ro, rd, box_min, box_max, &t_near, &t_far)) {
        let t_start = max(t_near, 0.0);
        var t = t_start;
        var hit = false;
        
        for (var step = 0; step < 120; step = step + 1) {
            if (t > t_far) {
                break;
            }
            let p = ro + rd * t;
            
            // Normalized coords in [0, 1]
            let uvw = p / 32.0;
            
            // Sample SDF value from green channel (G)
            let val = textureSampleLevel(voxel_texture, voxel_sampler, uvw, 0.0);
            let dist = val.g;
            
            if (dist < 0.005) {
                // Hit! Calculate normals using finite differences
                let eps = 0.05;
                let n = vec3<f32>(
                    textureSampleLevel(voxel_texture, voxel_sampler, uvw + vec3<f32>(eps, 0.0, 0.0)/32.0, 0.0).g - 
                    textureSampleLevel(voxel_texture, voxel_sampler, uvw - vec3<f32>(eps, 0.0, 0.0)/32.0, 0.0).g,
                    textureSampleLevel(voxel_texture, voxel_sampler, uvw + vec3<f32>(0.0, eps, 0.0)/32.0, 0.0).g - 
                    textureSampleLevel(voxel_texture, voxel_sampler, uvw - vec3<f32>(0.0, eps, 0.0)/32.0, 0.0).g,
                    textureSampleLevel(voxel_texture, voxel_sampler, uvw + vec3<f32>(0.0, 0.0, eps)/32.0, 0.0).g - 
                    textureSampleLevel(voxel_texture, voxel_sampler, uvw - vec3<f32>(0.0, 0.0, eps)/32.0, 0.0).g
                );
                let normal = normalize(n);
                
                // Color based on material ID (R channel)
                var base_color = vec3<f32>(0.5, 0.5, 0.5);
                if (val.r > 1.5) {
                    base_color = vec3<f32>(0.2, 0.8, 0.3); // Organic green terrain
                } else if (val.r > 0.5) {
                    base_color = vec3<f32>(0.8, 0.7, 0.5); // Stone/sand
                } else {
                    base_color = vec3<f32>(0.3, 0.3, 0.3);
                }
                
                let light_dir = normalize(vec3<f32>(0.5, 1.0, 0.3));
                let diffuse = max(dot(normal, light_dir), 0.1);
                color = base_color * (diffuse + 0.3);
                hit = true;
                break;
            }
            
            // Step forward by the SDF value
            t = t + max(0.02, dist);
        }
    }
    
    return vec4<f32>(color, 1.0);
}
")


(deftype Renderer [
  pipeline (Ptr WGPURenderPipelineWrapper)
  bind-group WGPUBindGroup
  uniform-buffer (Ptr WGPUUniformBufferWrapper)
  voxel-texture (Ptr WGPURenderTexture)
  voxel-sampler WGPUSampler
  line-pass LinePassRenderer
  lines (Array Line)
  depth-texture (Ptr WGPUDepthTexture)
  width Int
  height Int
])

(defmodule Renderer
  (defn create [eng]
    (let [ctx @(Engine.ctx eng)]
      (match (WGPURender.create-3d-texture ctx 32 32 32 "rgba16float")
        (Result.Error e) (Result.Error (str* "Voxel texture failed: " e))
        (Result.Success voxel-tex)
          (match (WGPURender.create-sampler ctx)
            (Result.Error e) (do (WGPURender.free-render-texture voxel-tex)
                                 (Result.Error (str* "Sampler failed: " e)))
            (Result.Success voxel-sampler)
              (match (WGPURender.create-uniform-buffer ctx 80)
                (Result.Error e) (do (WGPURender.free-sampler voxel-sampler)
                                     (WGPURender.free-render-texture voxel-tex)
                                     (Result.Error (str* "Uniforms failed: " e)))
                (Result.Success ub)
                  (match (Engine.create-pipeline eng voxel-wgsl "vs_main" "fs_main")
                    (Result.Error e) (do (Engine.free-uniform-buffer ub)
                                         (WGPURender.free-sampler voxel-sampler)
                                         (WGPURender.free-render-texture voxel-tex)
                                         (Result.Error (str* "Pipeline failed: " e)))
                    (Result.Success pipe)
                      (match (Engine.create-voxel-bind-group eng pipe voxel-tex voxel-sampler ub)
                        (Result.Error e) (do (Engine.free-pipeline pipe)
                                             (Engine.free-uniform-buffer ub)
                                             (WGPURender.free-sampler voxel-sampler)
                                             (WGPURender.free-render-texture voxel-tex)
                                             (Result.Error (str* "Bind group failed: " e)))
                        (Result.Success bg)
                          (let [w @(Engine.width eng)
                                h @(Engine.height eng)]
                            (match (WGPURender.create-depth-texture ctx w h)
                              (Result.Error e) (do (Engine.free-pipeline pipe)
                                                   (Engine.free-uniform-buffer ub)
                                                   (WGPURender.free-sampler voxel-sampler)
                                                   (WGPURender.free-render-texture voxel-tex)
                                                   (Engine.free-bind-group bg)
                                                   (Result.Error (str* "Depth texture failed: " e)))
                              (Result.Success depth-tex)
                                (let [format (WGPURender.surface-format @(Engine.surf eng))]
                                  (match (LinePass.create ctx &format 1000)
                                    (Result.Error e) (do (Engine.free-pipeline pipe)
                                                         (Engine.free-uniform-buffer ub)
                                                         (WGPURender.free-sampler voxel-sampler)
                                                         (WGPURender.free-render-texture voxel-tex)
                                                         (Engine.free-bind-group bg)
                                                         (WGPURender.free-depth-texture depth-tex)
                                                         (Result.Error (str* "LinePass creation failed: " e)))
                              (Result.Success lp)
                                (Result.Success (Renderer.init pipe bg ub voxel-tex voxel-sampler lp [] depth-tex w h)))))))))))))

  (defn update-uniforms [eng ren cam uniforms]
    (let [c-pos (Camera.pos cam)
          c-dir (Camera.front cam)
          c-right (Camera.right cam)
          c-up (Camera.up cam)
          time (Engine.update-time eng)
          w (Float.from-int @(Engine.width eng))
          h (Float.from-int @(Engine.height eng))]
      (do
        (Array.aset! uniforms 0 time)
        (Array.aset! uniforms 1 w)
        (Array.aset! uniforms 2 h)
        (Array.aset! uniforms 3 0.0f)
        
        (Array.aset! uniforms 4 (Double.to-float @(Vector3.x c-pos)))
        (Array.aset! uniforms 5 (Double.to-float @(Vector3.y c-pos)))
        (Array.aset! uniforms 6 (Double.to-float @(Vector3.z c-pos)))
        (Array.aset! uniforms 7 1.0f)
        
        (Array.aset! uniforms 8 (Double.to-float @(Vector3.x c-dir)))
        (Array.aset! uniforms 9 (Double.to-float @(Vector3.y c-dir)))
        (Array.aset! uniforms 10 (Double.to-float @(Vector3.z c-dir)))
        (Array.aset! uniforms 11 0.0f)
        
        (Array.aset! uniforms 12 (Double.to-float @(Vector3.x c-right)))
        (Array.aset! uniforms 13 (Double.to-float @(Vector3.y c-right)))
        (Array.aset! uniforms 14 (Double.to-float @(Vector3.z c-right)))
        (Array.aset! uniforms 15 0.0f)
        
        (Array.aset! uniforms 16 (Double.to-float @(Vector3.x c-up)))
        (Array.aset! uniforms 17 (Double.to-float @(Vector3.y c-up)))
        (Array.aset! uniforms 18 (Double.to-float @(Vector3.z c-up)))
        (Array.aset! uniforms 19 0.0f)
        
        (Engine.update-uniform-buffer eng @(Renderer.uniform-buffer ren) uniforms))))

  (defn update-texture [eng ren chunk-data]
    (let [ctx @(Engine.ctx eng)]
      (WGPURender.update-3d-texture-subregion-floats ctx @(Renderer.voxel-texture ren) 0 0 0 32 32 32 chunk-data)))

  (defn draw-line! [ren start end color]
    (Array.push-back! (Renderer.lines ren) (Line.init @start @end @color)))

  (defn clear-lines! [ren]
    (let [lns (Renderer.lines ren)]
      (while (not (Array.empty? lns))
        (ignore (Array.pop-back! lns)))))

  (defn draw [eng ren cam]
    (let [curr-w @(Engine.width eng)
          curr-h @(Engine.height eng)
          old-w @(Renderer.width ren)
          old-h @(Renderer.height ren)]
      (do
        (when (or (/= curr-w old-w) (/= curr-h old-h))
          (let [ctx @(Engine.ctx eng)
                old-dt @(Renderer.depth-texture ren)]
            (do
              (WGPURender.free-depth-texture old-dt)
              (match (WGPURender.create-depth-texture ctx curr-w curr-h)
                (Result.Error e) (IO.println &(str* "Error recreating depth texture: " e))
                (Result.Success new-dt)
                  (do
                    (Renderer.set-depth-texture! ren new-dt)
                    (Renderer.set-width! ren curr-w)
                    (Renderer.set-height! ren curr-h))))))
                    
        (match (Engine.begin-frame eng)
          (Maybe.Nothing) ()
          (Maybe.Just frame)
            (let [vp (Camera.view-projection cam)
                  vp-data (CameraMat4.data &vp)
                  ctx @(Engine.ctx eng)
                  line-count (LinePass.update! ctx (Renderer.line-pass ren) vp-data (Renderer.lines ren))
                  depth @(Renderer.depth-texture ren)]
              (do
                ;; 1. Voxel pass
                (WGPURender.run-pass frame @(Renderer.pipeline ren) @(Renderer.bind-group ren) (Maybe.Nothing))
                
                ;; 2. Line pass (drawn on top)
                (LinePass.render frame ctx (Renderer.line-pass ren) line-count depth (Maybe.Nothing))
                
                ;; 3. Clear lines
                (Renderer.clear-lines! ren)
                
                ;; 4. Present
                (Engine.end-frame eng frame)))))))

  (defn cleanup [eng ren]
    (do
      (Renderer.clear-lines! ren)
      (LinePass.cleanup (Renderer.line-pass ren))
      (WGPURender.free-depth-texture @(Renderer.depth-texture ren))
      (Engine.free-bind-group @(Renderer.bind-group ren))
      (Engine.free-pipeline @(Renderer.pipeline ren))
      (Engine.free-uniform-buffer @(Renderer.uniform-buffer ren))
      (WGPURender.free-sampler @(Renderer.voxel-sampler ren))
      (WGPURender.free-render-texture @(Renderer.voxel-texture ren))))
)

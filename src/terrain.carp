(load "../../carp-math/noise.carp")
(load "spectral_detail.carp")
(system-include "time.h")

(deftemplate fresh-run-seed (Fn [] Int)
  "int $NAME(void)"
  "$DECL {
   #ifdef __EMSCRIPTEN__
       return (int)(emscripten_random() * 899999.0f) + 100000;
   #else
       return ((int)time(NULL) & 0x7FFFFF) + 100000;
   #endif
   }")

(deftype StrataConfig [
  seed Int
  biomes (Array Int)
  splits (Array Double)
  sdf-spec (Array Float)
  landform-2d (Array Float)
])

(deftype SurfProfile [
  h Double
  dhx Double
  dhz Double
  crag Double
])

(defmodule StrataConfig
  ;; Segment 0 uses biomes[0..4]; Segment 1 uses unseen biomes[5..9];
  ;; Segment 2+ leads with unseen biomes[10..11] and steps by coprime 7 (guaranteed 5 unique biomes/segment!)
  (defn biome-for [strata seg slot]
    (let [biomes (StrataConfig.biomes strata)
          idx (if (<= seg 0)
                slot
                (if (= seg 1)
                  (+ 5 slot)
                  (if (= seg 2)
                    (if (= slot 0) 10 (if (= slot 1) 11 (Int.mod (* slot 3) 10)))
                    (Int.mod (+ (* seg 5) (* slot 7)) 12))))]
      @(Array.unsafe-nth biomes idx)))

  (defn split-for [strata seg slot]
    (let [splits (StrataConfig.splits strata)
          s-bank (Int.mod (if (< seg 0) 0 seg) 3)]
      @(Array.unsafe-nth splits (+ (* s-bank 4) slot))))
)

(defmodule Terrain
  (defn smooth01 [edge0 edge1 x]
    (let [raw (/ (- x edge0) (- edge1 edge0))
          t (if (< raw 0.0) 0.0 (if (> raw 1.0) 1.0 raw))]
      (* (* t t) (- 3.0 (* 2.0 t)))))

  ;; Coprime 3-Layer Non-Aliasing Spectral Landform Evaluator (`384m` + `137m @ 37deg` + `53m @ 73deg`, all modes >= 4m!)
  (defn surface-profile-at [strata fdx fdz]
    (let [atlas (StrataConfig.landform-2d strata)
          ;; Layer 0: L0 = 384.0m, amp0 = 14.5m, scale0 = 256/384 = 0.6666666666666666
          s0 (SpectralDetail.sample-landform-2d atlas (* fdx 0.6666666666666666) (* fdz 0.6666666666666666))
          h0 (* 14.5 @(LandformSample.h &s0))
          dhx0 (* 9.666666666666666 @(LandformSample.dhx &s0))
          dhz0 (* 9.666666666666666 @(LandformSample.dhz &s0))
          cr0 @(LandformSample.crag &s0)
          ;; Layer 1: L1 = 137.0m rotated 37 deg (cos=0.79863551, sin=0.60181502), amp1 = 4.6m, scale1 = 256/137 = 1.86861314
          rx1 (- (* fdx 0.7986355100472928) (* fdz 0.6018150231520483))
          rz1 (+ (* fdx 0.6018150231520483) (* fdz 0.7986355100472928))
          s1 (SpectralDetail.sample-landform-2d atlas (* rx1 1.8686131386861313) (* rz1 1.8686131386861313))
          h1 (* 4.6 @(LandformSample.h &s1))
          du1 @(LandformSample.dhx &s1)
          dv1 @(LandformSample.dhz &s1)
          dhx1 (* 8.595620437956204 (+ (* du1 0.7986355100472928) (* dv1 0.6018150231520483)))
          dhz1 (* 8.595620437956204 (- (* dv1 0.7986355100472928) (* du1 0.6018150231520483)))
          cr1 @(LandformSample.crag &s1)
          ;; Smooth roughness envelope: 0.16 in flat valley meadows -> 1.0 on slopes, spurs & craggy ridges
          dhx01 (+ dhx0 dhx1)
          dhz01 (+ dhz0 dhz1)
          slope01 (Double.sqrt (+ (* dhx01 dhx01) (* dhz01 dhz01)))
          rough-env (+ 0.16 (* 0.84 (Terrain.smooth01 0.20 0.68 (+ slope01 (* 0.32 (Double.max 0.0 cr0))))))
          ;; Layer 2: L2 = 53.0m rotated 73 deg (cos=0.29237170, sin=0.95630476), scale2 = 256/53 = 4.83018868
          rx2 (- (* fdx 0.29237170472273677) (* fdz 0.9563047559630354))
          rz2 (+ (* fdx 0.9563047559630354) (* fdz 0.29237170472273677))
          s2 (SpectralDetail.sample-landform-2d atlas (+ (* rx2 4.830188679245283) 41.3) (- (* rz2 4.830188679245283) 19.7))
          amp2 (* 1.35 rough-env)
          g2 (* amp2 4.830188679245283)
          h2 (* amp2 @(LandformSample.h &s2))
          du2 @(LandformSample.dhx &s2)
          dv2 @(LandformSample.dhz &s2)
          dhx2 (* g2 (+ (* du2 0.29237170472273677) (* dv2 0.9563047559630354)))
          dhz2 (* g2 (- (* dv2 0.29237170472273677) (* du2 0.9563047559630354)))
          cr2 @(LandformSample.crag &s2)
          raw-dh (+ (+ h0 h1) h2)
          raw-dhx (+ dhx01 dhx2)
          raw-dhz (+ dhz01 dhz2)
          ;; Walkable sunlit meadow clearing envelope around player spawn (32, 32) & Surface Citadel (32, 11)
          dx-sp (- fdx 32.0)
          dz-sp (- fdz 22.0)
          d2-sp (+ (* dx-sp dx-sp) (* dz-sp dz-sp))
          w-sp (Terrain.smooth01 120.0 900.0 d2-sp)
          env (+ 0.28 (* 0.72 w-sp))
          u-sp (/ (- d2-sp 120.0) 780.0)
          dw-dd2 (if (and (> u-sp 0.0) (< u-sp 1.0))
                   (/ (* 6.0 (* u-sp (- 1.0 u-sp))) 780.0)
                   0.0)
          denv-dx (* 1.44 (* dw-dd2 dx-sp))
          denv-dz (* 1.44 (* dw-dd2 dz-sp))
          h (+ 33.5 (* raw-dh env))
          dhx (+ (* raw-dhx env) (* raw-dh denv-dx))
          dhz (+ (* raw-dhz env) (* raw-dh denv-dz))
          crag (* (+ (* 0.50 cr0) (+ (* 0.30 cr1) (* 0.20 cr2))) env)]
      (SurfProfile.init h dhx dhz crag)))

  (defn surface-height-at [_noise-state strata fdx fdz]
    (let [prof (Terrain.surface-profile-at strata fdx fdz)]
      @(SurfProfile.h &prof)))
)

(load "structures.carp")

(defmodule Terrain
  (defn biome-name [b]
    (if (= b 0)  @"Overgrown Spore Karst"
    (if (= b 1)  @"Firedamp Coal Seam"
    (if (= b 2)  @"Glacial Waterfall Shafts"
    (if (= b 3)  @"Caustic Obsidian Vaults"
    (if (= b 4)  @"Sandstone & Oil Tar Pits"
    (if (= b 5)  @"Amethyst & Volatile Chasms"
    (if (= b 6)  @"Vitrified Rad-Geodes"
    (if (= b 7)  @"Magma & Brimstone Abyss"
    (if (= b 8)  @"Halite & Alkali Salt Domes"
    (if (= b 9)  @"Saponified Lye & Nitro Cisterns"
    (if (= b 10) @"Carbide & Acetylene Lampworks"
                 @"Cryo-Phosphor Abyss"))))))))))))

  (defn lcg-step [s]
    (Double.mod (+ (* s 1664525.0) 1013904223.0) 4294967296.0))

  (defn make-strata [seed]
    (let [s (Terrain.lcg-step (Double.from-int seed))
          shallow-pool [0 1 2 4 5 8 10]
          idx0 (Double.to-int (* 7.0 (/ s 4294967296.0)))
          b0 @(Array.unsafe-nth &shallow-pool (if (> idx0 6) 6 idx0))
          rem-pool []
          biomes (Array.allocate 12)
          splits (Array.allocate 12)]
      (do
        (for [cand 0 12]
          (when (/= cand b0)
            (Array.push-back! &rem-pool cand)))
        ;; Fisher-Yates shuffle on all 11 remaining biomes so every run deals a full 12-biome deck across segments!
        (for [i 0 10]
          (do
            (set! s (Terrain.lcg-step s))
            (let [span (- 11 i)
                  r (/ s 4294967296.0)
                  j (+ i (Double.to-int (* (Double.from-int span) r)))
                  jj (if (>= j 11) 10 j)
                  tmp @(Array.unsafe-nth &rem-pool i)]
              (do
                (Array.aset! &rem-pool i @(Array.unsafe-nth &rem-pool jj))
                (Array.aset! &rem-pool jj tmp)))))
        (Array.aset! &biomes 0 b0)
        (for [k 0 11]
          (Array.aset! &biomes (+ k 1) @(Array.unsafe-nth &rem-pool k)))

        ;; Roll 3 distinct 4-split depth banks (guaranteed >= 27m thickness per layer across Segments 0, 1, 2+)
        (for [bank 0 3]
          (let [base (* bank 4)]
            (do
              (set! s (Terrain.lcg-step s))
              (Array.aset! &splits (+ base 0) (+ -18.0 (- (* 16.0 (/ s 4294967296.0)) 8.0)))
              (set! s (Terrain.lcg-step s))
              (Array.aset! &splits (+ base 1) (+ -61.0 (- (* 16.0 (/ s 4294967296.0)) 8.0)))
              (set! s (Terrain.lcg-step s))
              (Array.aset! &splits (+ base 2) (+ -104.0 (- (* 16.0 (/ s 4294967296.0)) 8.0)))
              (set! s (Terrain.lcg-step s))
              (Array.aset! &splits (+ base 3) (+ -147.0 (- (* 16.0 (/ s 4294967296.0)) 8.0))))))

        (IO.println &(str* "=== Run Seed #" seed " — Segment 1 Stratigraphy (0m .. -192m) ==="))
        (IO.println &(str* "  [1] Surface .. " (Double.to-int @(Array.unsafe-nth &splits 0)) "m : " (Terrain.biome-name @(Array.unsafe-nth &biomes 0))))
        (IO.println &(str* "  [2] " (Double.to-int @(Array.unsafe-nth &splits 0)) "m .. " (Double.to-int @(Array.unsafe-nth &splits 1)) "m : " (Terrain.biome-name @(Array.unsafe-nth &biomes 1))))
        (IO.println &(str* "  [3] " (Double.to-int @(Array.unsafe-nth &splits 1)) "m .. " (Double.to-int @(Array.unsafe-nth &splits 2)) "m : " (Terrain.biome-name @(Array.unsafe-nth &biomes 2))))
        (IO.println &(str* "  [4] " (Double.to-int @(Array.unsafe-nth &splits 2)) "m .. " (Double.to-int @(Array.unsafe-nth &splits 3)) "m : " (Terrain.biome-name @(Array.unsafe-nth &biomes 3))))
        (IO.println &(str* "  [5] " (Double.to-int @(Array.unsafe-nth &splits 3)) "m .. -192m : " (Terrain.biome-name @(Array.unsafe-nth &biomes 4))))
        (IO.println &(str* "  [Beyond Seal 1 (-192m..-384m)] : "
                           (Terrain.biome-name @(Array.unsafe-nth &biomes 5)) " -> "
                           (Terrain.biome-name @(Array.unsafe-nth &biomes 6)) " -> "
                           (Terrain.biome-name @(Array.unsafe-nth &biomes 7)) " -> "
                           (Terrain.biome-name @(Array.unsafe-nth &biomes 8)) " -> "
                           (Terrain.biome-name @(Array.unsafe-nth &biomes 9))))

        (let [sdf-spec (SpectralDetail.make-sdf-bank-3d seed)
              landform-2d (SpectralDetail.make-landform-atlas-2d seed)]
          (StrataConfig.init seed biomes splits sdf-spec landform-2d)))))

  (defn lerp5 [v0 v1 v2 v3 v4 t0 t1 t2 t3]
    (let [a (+ v0 (* t0 (- v1 v0)))
          b (+ a (* t1 (- v2 a)))
          c (+ b (* t2 (- v3 b)))]
      (+ c (* t3 (- v4 c)))))

  ;; 4-Way Partition of Unity for Subterranean Spectral Cave Morphologies:
  ;;   1. Sedimentary flat-roof galleries & stepped benches (Biomes 1 Coal, 4 Sandstone, 10 Carbide)
  ;;   2. Travertine rimstone bowls & cistern terraces (Biomes 8 Salt, 9 Saponified)
  ;;   3. Razor fault chasms & hexagonal Giant's Causeway columns (Biomes 2 Glacial, 3 Obsidian, 5 Amethyst, 11 Cryo)
  ;;   4. Vesicular geode blisters & karst solution arches (Biomes 0 Karst, 6 Rad-Geodes, 7 Magma)
  (defn sed-morph-w [b]
    (if (or (= b 1) (or (= b 4) (= b 10))) 1.0 0.0))

  (defn rim-morph-w [b]
    (if (or (= b 8) (= b 9)) 1.0 0.0))

  (defn hex-morph-w [b]
    (if (or (= b 2) (or (= b 3) (or (= b 5) (= b 11)))) 1.0 0.0))

  (defn geo-morph-w [b]
    (if (or (= b 0) (or (= b 6) (= b 7))) 1.0 0.0))

  (defn vein-ore-for-biome [b]
    (if (or (= b 0) (or (= b 1) (or (= b 4) (= b 10)))) 4.0f
    (if (or (= b 2) (or (= b 3) (or (= b 8) (= b 9)))) 14.0f
    (if (= b 6) 17.0f
        15.0f))))

  (defn macro-w [b]
    (if (= b 0)  0.42
    (if (= b 1)  0.24
    (if (= b 2)  0.44
    (if (= b 3)  0.58
    (if (= b 4)  0.62
    (if (= b 5)  0.54
    (if (= b 6)  0.66
    (if (= b 7)  0.68
    (if (= b 8)  0.56
    (if (= b 9)  0.54
    (if (= b 10) 0.38
                 0.52))))))))))))

  (defn chasm-w [b]
    (if (= b 0)  0.28
    (if (= b 1)  0.18
    (if (= b 2)  0.52
    (if (= b 3)  0.28
    (if (= b 4)  0.18
    (if (= b 5)  0.46
    (if (= b 6)  0.24
    (if (= b 7)  0.34
    (if (= b 8)  0.30
    (if (= b 9)  0.22
    (if (= b 10) 0.36
                 0.48))))))))))))

  (defn tun-w [b]
    (if (= b 0)  0.42
    (if (= b 1)  0.54
    (if (= b 2)  0.24
    (if (= b 3)  0.26
    (if (= b 4)  0.30
    (if (= b 5)  0.25
    (if (= b 6)  0.22
    (if (= b 7)  0.20
    (if (= b 8)  0.24
    (if (= b 9)  0.32
    (if (= b 10) 0.46
                 0.22))))))))))))

  (defn thresh-w [b]
    (if (= b 0)  0.14
    (if (= b 1)  0.16
    (if (= b 2)  0.12
    (if (= b 3)  0.11
    (if (= b 4)  0.10
    (if (= b 5)  0.11
    (if (= b 6)  0.11
    (if (= b 7)  0.09
    (if (= b 8)  0.11
    (if (= b 9)  0.11
    (if (= b 10) 0.13
                 0.11))))))))))))

  (defn cauldron-biome? [b]
    (or (= b 3) (or (= b 7) (or (= b 9) (= b 11)))))

  (defn cauldron-seal [b band-bot wy]
    (if (and (Terrain.cauldron-biome? b) (> band-bot -190.0))
      (let [dist (Double.abs (- wy (+ band-bot 2.5)))]
        (if (< dist 3.5)
          (* 0.40 (- 1.0 (/ dist 3.5)))
          0.0))
      0.0))

  (defn seed-fluid-for-biome [b wy band-bot band-top n-macro n-chasm n-tun]
    (if (or (< wy (+ band-bot 5.0)) (> wy (- band-top 5.0)))
      0.0f
      (if (= b 0)
        ;; 0: Overgrown Spore Karst -> perched Water pools (-1) + high Spore Cloud canopies (+8)
        (if (and (<= wy (+ band-bot 13.0)) (< n-tun -0.18))
          -1.0f
          (if (and (>= wy (- band-top 12.0)) (> n-tun 0.36)) 8.0f 0.0f))
      (if (= b 1)
        ;; 1: Firedamp Coal Seam -> buoyant Methane domes (+6) in upper galleries + heavy Butane pockets (+10) in low coal sumps
        (if (and (>= wy (- band-top 16.0)) (> n-tun 0.20))
          6.0f
          (if (and (<= wy (+ band-bot 11.5)) (< n-tun -0.32)) 10.0f 0.0f))
      (if (= b 2)
        ;; 2: Glacial Waterfall Shafts -> Ambrosia shrines (-6) + rare cryo Liquid Nitrogen pockets (-15) + deep Water shafts (-1)
        (if (and (>= wy (- band-top 11.0)) (> n-tun 0.48))
          -6.0f
          (if (and (<= wy (+ band-bot 9.5)) (< n-tun -0.52))
            -15.0f
            (if (and (<= wy (+ band-bot 15.0)) (< n-chasm -0.14)) -1.0f 0.0f)))
      (if (= b 3)
        ;; 3: Caustic Obsidian Vaults -> high Ambrosia alcoves (-6) + Caustic Lye vats (-13) + Acid lakes (-3) + heavy Chlorine trench pockets (+11)
        (if (and (>= wy (- band-top 11.0)) (> n-tun 0.46))
          -6.0f
          (if (and (<= wy (+ band-bot 10.5)) (< n-tun -0.44))
            -13.0f
            (if (and (<= wy (+ band-bot 12.5)) (> n-macro 0.02))
              -3.0f
              (if (and (<= wy (+ band-bot 15.0)) (> n-tun 0.44)) 11.0f 0.0f))))
      (if (= b 4)
        ;; 4: Sandstone & Oil Tar Pits -> Stratified Hydrocarbon Reservoirs!
        ;; Bottom-to-top by density: Water boilover lens (-1) -> Diesel (-9) -> Crude Oil (-4) -> Kerosene (-10) -> Naphtha (-11) -> Butane vapor blanket (+10) -> upper Methane dome (+6)
        (if (and (>= wy (- band-top 14.0)) (> n-tun 0.24))
          6.0f
          (if (> n-macro 0.02)
            (if (<= wy (+ band-bot 6.5))
              -1.0f
              (if (<= wy (+ band-bot 8.5))
                -9.0f
                (if (<= wy (+ band-bot 10.2))
                  -4.0f
                  (if (<= wy (+ band-bot 11.5))
                    -10.0f
                    (if (<= wy (+ band-bot 12.6))
                      -11.0f
                      (if (<= wy (+ band-bot 14.2)) 10.0f 0.0f))))))
            0.0f))
      (if (= b 5)
        ;; 5: Amethyst & Volatile Chasms -> rare high Nitroglycerin weeping pockets (-14) + Toxic Sludge (-8) & Volatile Gel (-7)
        (if (and (>= wy (- band-top 10.5)) (< n-tun -0.52))
          -14.0f
          (if (<= wy (+ band-bot 12.0))
            (if (> n-tun 0.30)
              -8.0f
              (if (< n-tun -0.38) -7.0f 0.0f))
            0.0f))
      (if (= b 6)
        ;; 6: Vitrified Rad-Geodes -> ultra-dense liquid Mercury pools (-12), Toxic Sludge (-8), and glowing heavy Radon gas basins (+12)
        (if (and (<= wy (+ band-bot 9.0)) (< n-tun -0.38))
          -12.0f
          (if (and (<= wy (+ band-bot 10.5)) (> n-tun 0.34))
            -8.0f
            (if (and (<= wy (+ band-bot 14.0)) (> n-tun 0.22)) 12.0f 0.0f)))
      (if (= b 7)
        ;; 7: Magma & Brimstone Abyss -> glowing Lava seas (-2) + volcanic Acid Vapor fumarole plumes (+5)
        (if (and (<= wy (+ band-bot 14.0)) (> n-macro -0.10))
          -2.0f
          (if (and (>= wy (- band-top 13.0)) (> n-tun 0.40)) 5.0f 0.0f))
      (if (= b 8)
        ;; 8: Halite & Alkali Salt Domes -> buoyant Hydrogen domes (+9) + perched Caustic Lye vats (-13) + lower Water brine pools (-1) + Chlorine trenches (+11)
        (if (and (>= wy (- band-top 13.5)) (> n-tun 0.28))
          9.0f
          (if (and (>= wy (- band-top 11.5)) (< n-tun -0.46))
            -13.0f
            (if (and (<= wy (+ band-bot 10.5)) (> n-tun 0.28))
              -1.0f
              (if (and (<= wy (+ band-bot 14.0)) (< n-macro -0.34)) 11.0f 0.0f))))
      (if (= b 9)
        ;; 9: Saponified Lye & Nitro Cisterns -> small high Nitroglycerin (-14) & Ambrosia (-6) cisterns + lower Caustic Lye (-13) & Diesel (-9) vats + Acid Vapor (+5)
        (if (>= wy (- band-top 10.5))
          (if (< n-tun -0.52)
            -14.0f
            (if (> n-tun 0.46) -6.0f 0.0f))
          (if (<= wy (+ band-bot 10.5))
            (if (< n-tun -0.32)
              -13.0f
              (if (> n-tun 0.36) -9.0f 0.0f))
            (if (and (<= wy (+ band-bot 14.5)) (> n-macro 0.42)) 5.0f 0.0f)))
      (if (= b 10)
        ;; 10: Carbide & Acetylene Lampworks -> volatile Acetylene (+13) & Hydrogen (+9) ceiling domes + perched Water (-1) & Kerosene/Naphtha (-10/-11) lamp sumps
        (if (>= wy (- band-top 13.5))
          (if (> n-tun 0.32)
            13.0f
            (if (< n-tun -0.42) 9.0f 0.0f))
          (if (<= wy (+ band-bot 10.0))
            (if (< n-tun -0.36)
              -1.0f
              (if (> n-tun 0.42) -10.0f (if (> n-tun 0.30) -11.0f 0.0f)))
            0.0f))
        ;; 11: Cryo-Phosphor Abyss -> contained sub-zero Liquid Nitrogen basins (-15) + deep Mercury trenches (-12) + heavy Butane/Radon (+10/+12) cold-traps
        (if (and (<= wy (+ band-bot 8.5)) (< n-tun -0.44))
          -12.0f
          (if (and (<= wy (+ band-bot 10.0)) (> n-tun 0.32))
            -15.0f
            (if (<= wy (+ band-bot 14.5))
              (if (> n-tun 0.40) 12.0f (if (< n-tun -0.40) 10.0f 0.0f))
              0.0f))))))))))))))))

  (defn solid-mat-for-biome [b wy band-bot cave-skin? deep-core? n3 n-tun n-det spinodal]
    ;; Percolating 3D Spinodal Ore Dendrites (`Gold 5.0f` cores + biome signature ore filaments!)
    (if (and (< (Double.abs spinodal) 0.085)
             (and (> n-det 0.26)
                  (not (and (Terrain.cauldron-biome? b) (<= wy (+ band-bot 7.5))))))
      (if (> n-det 0.48) 5.0f (Terrain.vein-ore-for-biome b))
    (if (= b 0)
      ;; 0: Overgrown Spore Karst (Spore Pod + Slime + Sponge moss + Wood roots + Gold + Coal)
      (if (and cave-skin? (> n3 0.48))
        13.0f
        (if (and cave-skin? (< n3 -0.52))
          10.0f
          (if (and cave-skin? (and (> n3 0.28) (<= n3 0.40)))
            11.0f
            (if (and cave-skin? (and (> n3 -0.22) (< n3 -0.08)))
              3.0f
              (if (> n-det 0.65)
                5.0f
                (if (< n-det -0.54) 4.0f 1.0f))))))
    (if (= b 1)
      ;; 1: Firedamp Coal Seam (thick Coal veins + Calcium Carbide miner's gravel + Gunpowder pockets + faint Crystal lanterns + Gold)
      (if (and cave-skin? (> n3 0.54))
        7.0f
        (if (and cave-skin? (and (> wy (+ band-bot 17.0)) (and (> n3 0.32) (< n3 0.48))))
          24.0f
          (if (and cave-skin? (< n3 -0.60))
            14.0f
            (if (> n-det 0.64)
              5.0f
              (if (< n-det -0.22) 4.0f 1.0f)))))
    (if (= b 2)
      ;; 2: Glacial Waterfall Shafts (Crystal spires + deeply ice-encased White Phosphorus geodes + slippery Ice & Glass ribs + Gold)
      (if (and deep-core? (and (<= wy (+ band-bot 14.0)) (< n-det -0.60)))
        25.0f
        (if (and cave-skin? (> n3 0.44))
          14.0f
          (if (and cave-skin? (< n3 -0.36))
            (if (> n-tun 0.0) 8.0f 9.0f)
            (if (> n-det 0.60)
              5.0f
              (if (< n-det -0.25) 8.0f 1.0f)))))
    (if (= b 3)
      ;; 3: Caustic Obsidian Vaults (non-corrodible Obsidian basins + Sulfur crusts + submerged Gold + Crystal + high Glass)
      (if (and cave-skin? (> n3 0.48))
        14.0f
        (if (and cave-skin? (and (> wy (+ band-bot 16.0)) (and (> n3 0.22) (<= n3 0.38))))
          23.0f
          (if (and cave-skin? (and (> wy (+ band-bot 18.0)) (< n3 -0.52)))
            9.0f
            (if (> n-det 0.56) 5.0f 16.0f))))
    (if (= b 4)
      ;; 4: Sandstone & Oil Tar Pits (Bitumen tar basin linings + Salt evaporite domes + dry upper Sodium nodules + Sponge + Crystal + Gold/Coal/Sand)
      (if (and cave-skin? (and (<= wy (+ band-bot 14.5)) (> n-tun -0.15)))
        19.0f
        (if (and cave-skin? (and (> wy (+ band-bot 15.0)) (and (> n3 0.24) (< n3 0.44))))
          21.0f
          (if (and cave-skin? (and (> wy (+ band-bot 22.0)) (> n3 0.62)))
            20.0f
            (if (and cave-skin? (and (> wy (+ band-bot 18.0)) (< n3 -0.56)))
              11.0f
              (if (and cave-skin? (> n3 0.52))
                14.0f
                (if (> n-det 0.58)
                  5.0f
                  (if (< n-det -0.52)
                    4.0f
                    (if (> n-det -0.18) 6.0f 1.0f))))))))
    (if (= b 5)
      ;; 5: Amethyst & Volatile Chasms (Amethyst walls + C4 seams + Crystal + rich Gold/Coal)
      (if (and cave-skin? (> n3 0.40))
        15.0f
        (if (and cave-skin? (and (> wy (+ band-bot 18.0)) (and (> n3 0.18) (<= n3 0.32))))
          12.0f
          (if (and cave-skin? (< n3 -0.54))
            14.0f
            (if (> n-det 0.55)
              5.0f
              (if (< n-det -0.54) 4.0f 1.0f)))))
    (if (= b 6)
      ;; 6: Vitrified Rad-Geodes (glowing Rad-Ore + vitrified Glass & Obsidian + Amethyst + Gold)
      (if (and cave-skin? (> n3 0.40))
        17.0f
        (if (and cave-skin? (< n3 -0.46))
          9.0f
          (if (and cave-skin? (and (> n3 0.18) (< n3 0.30)))
            15.0f
            (if (> n-det 0.54)
              5.0f
              (if (< n-det 0.10) 16.0f 9.0f)))))
    (if (= b 7)
      ;; 7: Magma & Brimstone Abyss (Obsidian & Stone + yellow Brimstone Sulfur crusts + Amethyst/Crystal + high-arch Gold & Gunpowder)
      (if (and cave-skin? (> n3 0.40))
        15.0f
        (if (and cave-skin? (< n3 -0.50))
          14.0f
          (if (and cave-skin? (and (> wy (+ band-bot 16.5)) (and (> n3 0.05) (< n3 0.22))))
            23.0f
            (if (and cave-skin? (and (> wy (+ band-bot 21.0)) (and (>= n3 0.22) (< n3 0.34))))
              7.0f
              (if (and (> wy (+ band-bot 20.0)) (> n-det 0.52))
                5.0f
                (if (or (<= wy (+ band-bot 18.0)) (< n-det -0.15))
                  16.0f
                  1.0f))))))
    (if (= b 8)
      ;; 8: Halite & Alkali Salt Domes (glittering white Salt pillars + Crystal chandeliers + Glass crusts + dry upper Sodium shelves + Gold)
      (if (and cave-skin? (> n3 0.46))
        14.0f
        (if (and cave-skin? (and (> wy (+ band-bot 19.0)) (and (> n3 0.16) (<= n3 0.44))))
          20.0f
          (if (and cave-skin? (< n3 -0.44))
            9.0f
            (if (> n-det 0.56)
              5.0f
              (if (> n-det -0.22) 21.0f 1.0f)))))
    (if (= b 9)
      ;; 9: Saponified Lye & Nitro Cisterns (frictionless ivory-pink Soap terraces + bouncy Slime bumpers + Sponge vats + Obsidian cauldron rims + C4/Gold)
      (if (and cave-skin? (> n3 0.48))
        11.0f
        (if (and cave-skin? (and (> wy (+ band-bot 15.0)) (and (> n3 -0.24) (<= n3 0.38))))
          22.0f
          (if (and cave-skin? (< n3 -0.40))
            10.0f
            (if (and cave-skin? (and (> wy (+ band-bot 20.0)) (and (> n3 0.38) (<= n3 0.48))))
              12.0f
              (if (> n-det 0.55)
                5.0f
                (if (or (<= wy (+ band-bot 15.0)) (< n-det -0.20))
                  16.0f
                  22.0f))))))
    (if (= b 10)
      ;; 10: Carbide & Acetylene Lampworks (Calcium Carbide gravel ledges + yellow Sulfur ribs + Gunpowder pockets + Bitumen beams + Crystal lanterns + Coal/Gold)
      (if (and cave-skin? (and (> wy (+ band-bot 15.0)) (and (> n3 0.08) (< n3 0.46))))
        24.0f
        (if (and cave-skin? (>= n3 0.46))
          23.0f
          (if (and cave-skin? (< n3 -0.52))
            7.0f
            (if (and cave-skin? (and (>= n3 -0.52) (< n3 -0.34)))
              14.0f
              (if (> n-det 0.56)
                5.0f
                (if (< n-det -0.24)
                  4.0f
                  (if (> n-det 0.22) 19.0f 1.0f)))))))
      ;; 11: Cryo-Phosphor Abyss (deeply ice-encased White Phosphorus geode cores + Ice/Crystal/Amethyst cryo-spires + Obsidian trenches + Gold)
      (if (and deep-core? (< n-det -0.58))
        25.0f
        (if (and cave-skin? (> n3 0.42))
          14.0f
          (if (and cave-skin? (and (> n3 0.14) (<= n3 0.42)))
            15.0f
            (if (and cave-skin? (< n3 -0.30))
              8.0f
              (if (> n-det 0.52)
                5.0f
                (if (or (<= wy (+ band-bot 14.5)) (< n-det -0.18))
                  16.0f
                  8.0f)))))))))))))))))))

  ;; Shared Lipschitz-safe 3-Octave Ridged Overworld Crag + 4-Biome Subterranean Cave Morphology Evaluator
  (defn eval-morph-sdf [sdf-spec seg local-fdy fdx fdy fdz surf-sdf slope crag-2d cave-sdf w-sed w-rim w-hex w-geo]
    (let [surf-shaped (if (and (= seg 0) (< (Double.abs surf-sdf) 6.0))
                        (let [c0 (SpectralDetail.sample-bank-ch sdf-spec 0 (* fdx 0.38) (* fdy 0.46) (* fdz 0.38))
                              c1 (SpectralDetail.sample-bank-ch sdf-spec 0 (+ (* fdx 0.96) 17.3) (* fdy 1.18) (- (* fdz 0.96) 29.1))
                              r1 (- 0.60 (Double.sqrt (+ (* c1 c1) 0.022)))
                              c2 (SpectralDetail.sample-bank-ch sdf-spec 0 (- (* fdx 1.92) 41.7) (* fdy 2.35) (+ (* fdz 1.92) 13.9))
                              st2 (SpectralDetail.sample-bank-ch sdf-spec 2 (* fdx 1.25) (* fdy 2.40) (* fdz 1.25))
                              r2 (+ (* 0.55 (- 0.56 (Double.sqrt (+ (* c2 c2) 0.026)))) (* 0.45 st2))
                              ;; 0.08 on flat ground (zero stalagmites!) -> 1.0 on slopes, shoulders & ridges
                              crag-gate (+ 0.08 (* 0.92 (Terrain.smooth01 0.24 0.78 (+ slope (* 0.26 (Double.max 0.0 crag-2d))))))
                              surf-env (- 1.0 (Terrain.smooth01 2.2 6.0 (Double.abs surf-sdf)))
                              protrude (* crag-gate (* surf-env (+ (* -1.10 c0) (+ (* 0.68 r1) (* 0.34 r2)))))
                              raw-s (- surf-sdf protrude)
                              damp-s (- 1.0 (* 0.24 surf-env))]
                          (Double.clamp -12.0 12.0 (if (> raw-s 0.0) (* damp-s raw-s) raw-s)))
                        (Double.clamp -12.0 12.0 surf-sdf))
          cave-shaped (if (and (< surf-sdf -3.2)
                               (and (< (Double.abs cave-sdf) 5.4)
                                    (and (> local-fdy -184.5)
                                         (or (= seg 0) (< local-fdy -4.0)))))
                        (let [seal-env (* (Terrain.smooth01 -184.5 -181.5 local-fdy)
                                          (if (> seg 0) (- 1.0 (Terrain.smooth01 -7.0 -4.0 local-fdy)) 1.0))
                              surf-gate (- 1.0 (Terrain.smooth01 -7.5 -3.2 surf-sdf))
                              wall-env (- 1.0 (Terrain.smooth01 2.0 5.4 (Double.abs cave-sdf)))
                              env (* seal-env (* surf-gate wall-env))]
                          (if (<= env 0.004)
                            cave-sdf
                            (let [c-base (SpectralDetail.sample-bank-ch sdf-spec 0 (* fdx 0.40) (* fdy 0.40) (* fdz 0.40))
                                  c1 (SpectralDetail.sample-bank-ch sdf-spec 0 (+ (* fdx 0.96) 17.3) (* fdy 1.18) (- (* fdz 0.96) 29.1))
                                  r1 (- 0.60 (Double.sqrt (+ (* c1 c1) 0.022)))
                                  c2 (SpectralDetail.sample-bank-ch sdf-spec 0 (- (* fdx 1.92) 41.7) (* fdy 2.35) (+ (* fdz 1.92) 13.9))
                                  st2 (SpectralDetail.sample-bank-ch sdf-spec 2 (* fdx 1.25) (* fdy 2.40) (* fdz 1.25))
                                  r2 (+ (* 0.55 (- 0.56 (Double.sqrt (+ (* c2 c2) 0.026)))) (* 0.45 st2))
                                  cave-ribs (- 0.0 (+ (* 0.58 r1) (* 0.30 r2)))
                                  d-sed (if (> w-sed 0.02)
                                          (let [st (SpectralDetail.sample-bank-ch sdf-spec 2 (* fdx 0.28) (* fdy 0.52) (* fdz 0.28))]
                                            (* w-sed (+ (* 1.60 st) (* 0.80 c-base))))
                                          0.0)
                                  d-rim (if (> w-rim 0.02)
                                          (let [st (SpectralDetail.sample-bank-ch sdf-spec 2 (* fdx 0.30) (* fdy 0.56) (* fdz 0.30))
                                                flr-b (- 1.0 (Terrain.smooth01 0.0 2.8 (Double.abs (- cave-sdf 0.2))))]
                                            (* w-rim (+ (* (+ 0.85 (* 0.72 flr-b)) st) (* 0.55 c-base))))
                                          0.0)
                                  d-hex (if (> w-hex 0.02)
                                          (let [hc (SpectralDetail.sample-bank-ch sdf-spec 1 (* fdx 0.58) (* fdy 0.16) (* fdz 0.58))]
                                            (* w-hex (+ (* 1.55 hc) (* 0.65 c-base))))
                                          0.0)
                                  d-geo (if (> w-geo 0.02)
                                          (let [sp (SpectralDetail.sample-bank-ch sdf-spec 3 (* fdx 0.48) (* fdy 0.48) (* fdz 0.48))]
                                            (* w-geo (+ (* 1.35 c-base) (* 0.95 sp))))
                                          0.0)
                                  raw-sum (+ cave-sdf (* env (+ (+ (+ d-sed d-rim) (+ d-hex d-geo)) cave-ribs)))
                                  damp-c (- 1.0 (* 0.22 env))]
                              (Double.clamp -12.0 12.0 (if (> raw-sum 0.0) (* damp-c raw-sum) raw-sum)))))
                        cave-sdf)]
      (if (and (= seg 0) (> surf-shaped cave-shaped)) surf-shaped cave-shaped)))

  ;; Stateless point evaluator for full Post-Morphology Landform + Cave + Seal SDF (`[-12.0 .. 12.0]`)
  ;; Used by `Flora` and `Geysers` to bisect exact rock/air zero-crossings with zero `32m` chunk-boundary seams!
  (defn eval-base-sdf-at [noise-state strata fdx fdy fdz]
    (let [iy (Double.to-int (Double.floor fdy))
          seg (if (>= iy -192) 0 (+ 1 (/ (- -193 iy) 192)))
          local-fdy (+ fdy (Double.from-int (* seg 192)))]
      (if (and (<= local-fdy -186.5) (>= local-fdy -192.0))
        (Double.clamp -12.0 12.0 (- (Double.abs (- local-fdy -189.5)) 3.2))
        (let [prof (Terrain.surface-profile-at strata fdx fdz)
              surface-h @(SurfProfile.h &prof)
              dhx @(SurfProfile.dhx &prof)
              dhz @(SurfProfile.dhz &prof)
              crag-2d @(SurfProfile.crag &prof)
              slope2 (+ (* dhx dhx) (* dhz dhz))
              slope (Double.sqrt slope2)
              inv-grad-sol (/ 1.0 (Double.sqrt (+ 1.0 slope2)))
              inv-grad-air (/ 0.88 (Double.sqrt (+ 1.0 (+ slope2 (* 0.45 (* crag-2d crag-2d))))))
              dy-h (- fdy surface-h)
              surf-sdf (* dy-h (if (> dy-h 0.0) inv-grad-air inv-grad-sol))
              sky-cutoff (+ surface-h (/ 6.8 inv-grad-air))]
          (if (and (= seg 0) (> fdy sky-cutoff))
            (if (> surf-sdf 12.0) 12.0 surf-sdf)
            (let [b0 (StrataConfig.biome-for strata seg 0)
                  b1 (StrataConfig.biome-for strata seg 1)
                  b2 (StrataConfig.biome-for strata seg 2)
                  b3 (StrataConfig.biome-for strata seg 3)
                  b4 (StrataConfig.biome-for strata seg 4)
                  s0 (StrataConfig.split-for strata seg 0)
                  s1 (StrataConfig.split-for strata seg 1)
                  s2 (StrataConfig.split-for strata seg 2)
                  s3 (StrataConfig.split-for strata seg 3)
                  fold-y (+ (* 10.5 (Noise.noise2d noise-state (+ (* fdx 0.011) 131.0) (- (* fdz 0.011) 83.0)))
                            (* 4.0 (Noise.noise2d noise-state (- (* fdx 0.029) 41.0) (+ (* fdz 0.029) 67.0))))
                  n-sink (Noise.noise2d noise-state (+ (* fdx 0.022) 91.0) (- (* fdz 0.022) 47.0))
                  sink-open (if (> n-sink 0.46) 0.0 (if (< n-sink 0.26) 1.0 (/ (- 0.46 n-sink) 0.20)))
                  wy (+ local-fdy fold-y)
                  t0 (Terrain.smooth01 -7.0 7.0 (- s0 wy))
                  t1 (Terrain.smooth01 -7.0 7.0 (- s1 wy))
                  t2 (Terrain.smooth01 -7.0 7.0 (- s2 wy))
                  t3 (Terrain.smooth01 -7.0 7.0 (- s3 wy))
                  w-macro (Terrain.lerp5 (Terrain.macro-w b0) (Terrain.macro-w b1) (Terrain.macro-w b2) (Terrain.macro-w b3) (Terrain.macro-w b4) t0 t1 t2 t3)
                  w-chasm (Terrain.lerp5 (Terrain.chasm-w b0) (Terrain.chasm-w b1) (Terrain.chasm-w b2) (Terrain.chasm-w b3) (Terrain.chasm-w b4) t0 t1 t2 t3)
                  w-tun   (Terrain.lerp5 (Terrain.tun-w b0)   (Terrain.tun-w b1)   (Terrain.tun-w b2)   (Terrain.tun-w b3)   (Terrain.tun-w b4)   t0 t1 t2 t3)
                  base-th (Terrain.lerp5 (Terrain.thresh-w b0) (Terrain.thresh-w b1) (Terrain.thresh-w b2) (Terrain.thresh-w b3) (Terrain.thresh-w b4) t0 t1 t2 t3)
                  w-sed   (Terrain.lerp5 (Terrain.sed-morph-w b0) (Terrain.sed-morph-w b1) (Terrain.sed-morph-w b2) (Terrain.sed-morph-w b3) (Terrain.sed-morph-w b4) t0 t1 t2 t3)
                  w-rim   (Terrain.lerp5 (Terrain.rim-morph-w b0) (Terrain.rim-morph-w b1) (Terrain.rim-morph-w b2) (Terrain.rim-morph-w b3) (Terrain.rim-morph-w b4) t0 t1 t2 t3)
                  w-hex   (Terrain.lerp5 (Terrain.hex-morph-w b0) (Terrain.hex-morph-w b1) (Terrain.hex-morph-w b2) (Terrain.hex-morph-w b3) (Terrain.hex-morph-w b4) t0 t1 t2 t3)
                  w-geo   (Terrain.lerp5 (Terrain.geo-morph-w b0) (Terrain.geo-morph-w b1) (Terrain.geo-morph-w b2) (Terrain.geo-morph-w b3) (Terrain.geo-morph-w b4) t0 t1 t2 t3)
                  n-macro (Noise.noise3d noise-state (* fdx 0.018) (* fdy 0.022) (* fdz 0.018))
                  n-chasm (Noise.noise3d noise-state (- (* fdx 0.028) 63.0) (* fdy 0.011) (+ (* fdz 0.028) 29.0))
                  n-tun (Noise.noise3d noise-state (+ (* fdx 0.038) 17.0) (* fdy 0.044) (- (* fdz 0.038) 41.0))
                  n-det (Noise.noise3d noise-state (+ (* fdx 0.095) 37.0) (* fdy 0.095) (- (* fdz 0.095) 19.0))
                  fault-crease (* w-hex (* 0.28 (- 0.42 (Double.abs n-chasm))))
                  roof-guard (if (and (= seg 0) (> surf-sdf -8.0)) (* (* (+ surf-sdf 8.0) 0.032) sink-open) 0.0)
                  seal-open (if (< local-fdy -178.0) (* (- -178.0 local-fdy) 0.055) 0.0)
                  vault-open (if (and (> seg 0) (> local-fdy -11.0)) (* (+ local-fdy 11.0) 0.055) 0.0)
                  cauld-guard (+ (Terrain.cauldron-seal b0 s0 wy)
                                 (+ (Terrain.cauldron-seal b1 s1 wy)
                                    (+ (Terrain.cauldron-seal b2 s2 wy)
                                       (Terrain.cauldron-seal b3 s3 wy))))
                  cave-blend (+ (* n-macro w-macro)
                                (+ (* n-chasm w-chasm)
                                   (+ (* n-tun w-tun)
                                      (+ fault-crease (+ (* n-det 0.12) (+ seal-open vault-open))))))
                  cave-raw (- cave-blend (+ base-th (+ roof-guard cauld-guard)))
                  depth-below (- surface-h fdy)
                  deep-raw (/ (- depth-below 12.0) 55.0)
                  deep-scale (if (< deep-raw 0.30) 0.30 (if (> deep-raw 1.0) 1.0 deep-raw))
                  sdf-scale (+ 12.0 (* 12.0 deep-scale))
                  cave-sdf-raw (* cave-raw sdf-scale)
                  cave-sdf (if (> cave-sdf-raw 12.0) 12.0 (if (< cave-sdf-raw -12.0) -12.0 cave-sdf-raw))
                  sdf-spec (StrataConfig.sdf-spec strata)]
              (Terrain.eval-morph-sdf sdf-spec seg local-fdy fdx fdy fdz surf-sdf slope crag-2d cave-sdf w-sed w-rim w-hex w-geo)))))))

  (defn biome-at [noise-state strata fdx fdy fdz]
    (Structures.biome-at noise-state strata fdx fdy fdz))

  (defn seed-fluid-at [noise-state strata fdx fdy fdz]
    (let [prof (Terrain.surface-profile-at strata fdx fdz)
          surface-h @(SurfProfile.h &prof)
          dhx @(SurfProfile.dhx &prof)
          dhz @(SurfProfile.dhz &prof)
          inv-grad (/ 1.0 (Double.sqrt (+ 1.0 (+ (* dhx dhx) (* dhz dhz)))))
          surf-sdf (* (- fdy surface-h) inv-grad)]
      (if (>= surf-sdf -12.0)
        0.0f
        (let [iy (Double.to-int (Double.floor fdy))
              seg (if (>= iy -192) 0 (+ 1 (/ (- -193 iy) 192)))
              local-fdy (+ fdy (Double.from-int (* seg 192)))
              fold-y (+ (* 10.5 (Noise.noise2d noise-state (+ (* fdx 0.011) 131.0) (- (* fdz 0.011) 83.0)))
                        (* 4.0 (Noise.noise2d noise-state (- (* fdx 0.029) 41.0) (+ (* fdz 0.029) 67.0))))
              wy (+ local-fdy fold-y)
              s0 (StrataConfig.split-for strata seg 0)
              s1 (StrataConfig.split-for strata seg 1)
              s2 (StrataConfig.split-for strata seg 2)
              s3 (StrataConfig.split-for strata seg 3)
              slot (if (>= wy s0) 0 (if (>= wy s1) 1 (if (>= wy s2) 2 (if (>= wy s3) 3 4))))
              b-curr (StrataConfig.biome-for strata seg slot)
              band-top (if (= slot 0) 24.0 (if (= slot 1) s0 (if (= slot 2) s1 (if (= slot 3) s2 s3))))
              band-bot (if (= slot 0) s0 (if (= slot 1) s1 (if (= slot 2) s2 (if (= slot 3) s3 -187.0))))
              n-macro (Noise.noise3d noise-state (* fdx 0.018) (* fdy 0.022) (* fdz 0.018))
              n-chasm (Noise.noise3d noise-state (- (* fdx 0.028) 63.0) (* fdy 0.011) (+ (* fdz 0.028) 29.0))
              n-tun (Noise.noise3d noise-state (+ (* fdx 0.038) 17.0) (* fdy 0.044) (- (* fdz 0.038) 41.0))]
          (Terrain.seed-fluid-for-biome b-curr wy band-bot band-top n-macro n-chasm n-tun)))))
)

;; =============================================================================
;; Self-Pumping Relaxation-Oscillator Geysers & Subterranean Fumaroles (64m Grid)
;; =============================================================================

(deftype GeyserDesc [
  active Bool
  biome Int
  gx Double
  gy Double
  gz Double
])

(deftype GeyserHit [
  active Bool
  sdf Double
  mat Float
  fluid Float
])

(deftype ChunkGeysers [
  count Int
  min-y Double
  max-y Double
  items (Array GeyserDesc)
  col-mask (Array Int)
])

(defmodule Terrain
  (defn floor-div [a b]
    (let [q (/ a b)
          r (Int.mod a b)]
      (if (and (< r 0) (/= r 0)) (- q 1) q)))

  (defn inside-vault-collar? [noise-state strata px py pz]
    (let [rx (Terrain.floor-div (Double.to-int (Double.floor px)) 96)
          ry (Terrain.floor-div (Double.to-int (Double.floor py)) 64)
          rz (Terrain.floor-div (Double.to-int (Double.floor pz)) 96)
          sd (Structures.supercell-desc noise-state strata rx ry rz)]
      (if (not @(StructureDesc.active &sd))
        false
        (and (<= (Double.abs (- px @(StructureDesc.sx &sd))) (+ @(StructureDesc.hx &sd) 8.0))
             (and (<= (Double.abs (- py @(StructureDesc.sy &sd))) (+ @(StructureDesc.hy &sd) 8.0))
                  (<= (Double.abs (- pz @(StructureDesc.sz &sd))) (+ @(StructureDesc.hz &sd) 8.0)))))))

  (defn bisect-floor-y [noise-state strata px pz y-lo s-lo y-hi]
    (let [lo y-lo
          slo s-lo
          hi y-hi]
      (do
        (for [_i 0 4]
          (let [mid (* 0.5 (+ lo hi))
                 sm (Terrain.eval-base-sdf-at noise-state strata px mid pz)]
            (if (or (and (<= slo 0.0) (<= sm 0.0))
                    (and (> slo 0.0) (> sm 0.0)))
              (do (set! lo mid) (set! slo sm))
              (set! hi mid))))
        (* 0.5 (+ lo hi)))))

  ;; Deterministic Overworld Valley Hot-Spring Geyser inside 64x64 cell `(kx, kz)`
  (defn geyser-for-overworld [noise-state strata kx kz]
    (let [seed @(StrataConfig.seed strata)
          h0 (csg-hash4 (+ seed 61909) kx 0 kz)]
      (if (>= (Int.mod (Int.abs h0) 1000) 145)
        (GeyserDesc.init false -1 0.0 0.0 0.0)
        (let [h1 (csg-hash4 (+ seed 27457) kx 1 kz)
              gx0 (Double.from-int (+ (* kx 64) (+ 12 (Int.mod (Int.abs h1) 40))))
              gz0 (Double.from-int (+ (* kz 64) (+ 12 (Int.mod (Int.abs (/ h1 64)) 40))))
              d2-sp (+ (* (- gx0 32.0) (- gx0 32.0)) (* (- gz0 22.0) (- gz0 22.0)))]
          (if (<= d2-sp 1600.0)
            (GeyserDesc.init false -1 0.0 0.0 0.0)
            (let [prof (Terrain.surface-profile-at strata gx0 gz0)
                  est-h @(SurfProfile.h &prof)
                  dhx @(SurfProfile.dhx &prof)
                  dhz @(SurfProfile.dhz &prof)
                  slope (Double.sqrt (+ (* dhx dhx) (* dhz dhz)))]
              (if (>= slope 0.42)
                (GeyserDesc.init false -1 0.0 0.0 0.0)
                (let [s-lo (Terrain.eval-base-sdf-at noise-state strata gx0 (- est-h 3.0) gz0)
                      s-deep (Terrain.eval-base-sdf-at noise-state strata gx0 (- est-h 7.0) gz0)
                      s-hi (Terrain.eval-base-sdf-at noise-state strata gx0 (+ est-h 4.0) gz0)]
                  (if (or (> s-lo -0.6) (or (> s-deep -1.6) (< s-hi 2.0)))
                    (GeyserDesc.init false -1 0.0 0.0 0.0)
                    (let [flr-y (Terrain.bisect-floor-y noise-state strata gx0 gz0 (- est-h 3.0) s-lo (+ est-h 3.0))]
                      (if (Terrain.inside-vault-collar? noise-state strata gx0 flr-y gz0)
                        (GeyserDesc.init false -1 0.0 0.0 0.0)
                        (GeyserDesc.init true -1 gx0 flr-y gz0))))))))))))

  ;; Deterministic Subterranean Fumarole Geyser inside 64x64x64 cell `(kx, ky, kz)`
  (defn geyser-for-cave [noise-state strata kx ky kz]
    (let [y-base (Double.from-int (* ky 64))
          gy-mid (+ (* ky 64) 32)
          seg (if (>= gy-mid -192) 0 (+ 1 (/ (- -193 gy-mid) 192)))
          local-mid (+ (+ y-base 32.0) (Double.from-int (* seg 192)))]
      (if (or (>= y-base 32.0)
              (or (<= local-mid -174.0)
                  (and (> seg 0) (>= local-mid -14.0))))
        (GeyserDesc.init false 0 0.0 0.0 0.0)
        (let [seed @(StrataConfig.seed strata)
              h0 (csg-hash4 (+ seed 90371) kx ky kz)]
          (if (>= (Int.mod (Int.abs h0) 1000) 220)
            (GeyserDesc.init false 0 0.0 0.0 0.0)
            (let [h1 (csg-hash4 (+ seed 44711) kx ky kz)
                  gx0 (Double.from-int (+ (* kx 64) (+ 12 (Int.mod (Int.abs h1) 40))))
                  gz0 (Double.from-int (+ (* kz 64) (+ 12 (Int.mod (Int.abs (/ h1 64)) 40))))
                  y0 (+ y-base 12.0)
                  y1 (+ y-base 24.0)
                  y2 (+ y-base 36.0)
                  y3 (+ y-base 48.0)
                  s0 (Terrain.eval-base-sdf-at noise-state strata gx0 y0 gz0)
                  s1 (Terrain.eval-base-sdf-at noise-state strata gx0 y1 gz0)
                  s2 (Terrain.eval-base-sdf-at noise-state strata gx0 y2 gz0)
                  s3 (Terrain.eval-base-sdf-at noise-state strata gx0 y3 gz0)
                  f01 (and (<= s0 -0.8) (>= s1 1.5))
                  f12 (and (not f01) (and (<= s1 -0.8) (>= s2 1.5)))
                  f23 (and (not (or f01 f12)) (and (<= s2 -0.8) (>= s3 1.5)))]
              (if (not (or f01 (or f12 f23)))
                (GeyserDesc.init false 0 0.0 0.0 0.0)
                (let [ylo (if f01 y0 (if f12 y1 y2))
                      slo (if f01 s0 (if f12 s1 s2))
                      yhi (if f01 y1 (if f12 y2 y3))
                      flr-y (Terrain.bisect-floor-y noise-state strata gx0 gz0 ylo slo yhi)
                      b (Terrain.biome-at noise-state strata gx0 flr-y gz0)]
                  (if (not (or (= b 0) (or (= b 2) (or (= b 7) (or (= b 8) (= b 11))))))
                    (GeyserDesc.init false 0 0.0 0.0 0.0)
                    (let [surf-h (Terrain.surface-height-at noise-state strata gx0 gz0)]
                      (if (>= (+ flr-y 12.0) (- surf-h 8.0))
                        (GeyserDesc.init false 0 0.0 0.0 0.0)
                        (let [s-sub (Terrain.eval-base-sdf-at noise-state strata gx0 (- flr-y 6.5) gz0)
                              s-head (Terrain.eval-base-sdf-at noise-state strata gx0 (+ flr-y 9.0) gz0)]
                          (if (or (> s-sub -1.2)
                                  (or (< s-head 1.8)
                                      (Terrain.inside-vault-collar? noise-state strata gx0 flr-y gz0)))
                            (GeyserDesc.init false 0 0.0 0.0 0.0)
                            (GeyserDesc.init true b gx0 flr-y gz0))))))))))))))

  ;; O(1) Query used by `Flora` so trees/toadstools never root inside an active geyser cone!
  (defn near-geyser? [noise-state strata px py pz]
    (let [kx (Terrain.floor-div (Double.to-int (Double.floor px)) 64)
          ky (Terrain.floor-div (Double.to-int (Double.floor py)) 64)
          kz (Terrain.floor-div (Double.to-int (Double.floor pz)) 64)
          go (Terrain.geyser-for-overworld noise-state strata kx kz)
          hit-o (if @(GeyserDesc.active &go)
                  (and (<= (Double.abs (- px @(GeyserDesc.gx &go))) 7.5)
                       (and (<= (Double.abs (- pz @(GeyserDesc.gz &go))) 7.5)
                            (<= (Double.abs (- py @(GeyserDesc.gy &go))) 10.0)))
                  false)]
      (if hit-o
        true
        (let [gc (Terrain.geyser-for-cave noise-state strata kx ky kz)]
          (if @(GeyserDesc.active &gc)
            (and (<= (Double.abs (- px @(GeyserDesc.gx &gc))) 7.5)
                 (and (<= (Double.abs (- pz @(GeyserDesc.gz &gc))) 7.5)
                      (<= (Double.abs (- py @(GeyserDesc.gy &gc))) 10.0)))
            false)))))

  ;; O(1) Chunk Pre-Culler (`<= 2` geyser candidates per `32^3` chunk because `gx,gz in [12..52]` never cross `64m` walls!)
  (defn prepare-chunk-geysers [noise-state strata qx qy qz]
    (let [c-min-x (Double.from-int (* qx 32))
          c-max-x (+ c-min-x 32.0)
          c-min-y (Double.from-int (* qy 32))
          c-max-y (+ c-min-y 32.0)
          c-min-z (Double.from-int (* qz 32))
          c-max-z (+ c-min-z 32.0)
          kx (Terrain.floor-div qx 2)
          ky (Terrain.floor-div qy 2)
          kz (Terrain.floor-div qz 2)
          items (the (Array GeyserDesc) [])
          col-mask (the (Array Int) (Array.replicate 1024 &0))
          all-min-y 99999.0
          all-max-y -99999.0]
      (do
        (when (and (>= qy -1) (<= qy 2))
          (let [go (Terrain.geyser-for-overworld noise-state strata kx kz)]
            (when @(GeyserDesc.active &go)
              (Array.push-back! &items go))))
        (when (<= qy 1)
          (let [gc (Terrain.geyser-for-cave noise-state strata kx ky kz)]
            (when @(GeyserDesc.active &gc)
              (Array.push-back! &items gc))))

        (let [kept (the (Array GeyserDesc) [])
              n-cand (Array.length &items)]
          (do
            (for [i 0 n-cand]
              (let [gd @(Array.unsafe-nth &items i)
                    gx0 @(GeyserDesc.gx &gd)
                    gy0 @(GeyserDesc.gy &gd)
                    gz0 @(GeyserDesc.gz &gd)
                    g-min-x (- gx0 5.6)
                    g-max-x (+ gx0 5.6)
                    g-min-y (- gy0 8.6)
                    g-max-y (+ gy0 5.2)
                    g-min-z (- gz0 5.6)
                    g-max-z (+ gz0 5.6)]
                (when (and (<= g-min-x c-max-x)
                           (and (>= g-max-x c-min-x)
                                (and (<= g-min-y c-max-y)
                                     (and (>= g-max-y c-min-y)
                                          (and (<= g-min-z c-max-z)
                                               (>= g-max-z c-min-z))))))
                  (let [slot (Array.length &kept)
                        bit (Int.bit-shift-left 1 slot)
                        lx0 (Int.clamp 0 31 (Double.to-int (Double.floor (- g-min-x c-min-x))))
                        lx1 (Int.clamp 0 31 (Double.to-int (Double.floor (- g-max-x c-min-x))))
                        lz0 (Int.clamp 0 31 (Double.to-int (Double.floor (- g-min-z c-min-z))))
                        lz1 (Int.clamp 0 31 (Double.to-int (Double.floor (- g-max-z c-min-z))))]
                    (do
                      (when (< g-min-y all-min-y) (set! all-min-y g-min-y))
                      (when (> g-max-y all-max-y) (set! all-max-y g-max-y))
                      (for [lz lz0 (+ lz1 1)]
                        (let [z-row (* lz 32)]
                          (for [lx lx0 (+ lx1 1)]
                            (let [mi (+ z-row lx)]
                              (Array.aset! &col-mask mi (Int.bit-or @(Array.unsafe-nth &col-mask mi) bit))))))
                      (Array.push-back! &kept gd))))))
            (ChunkGeysers.init (Array.length &kept) all-min-y all-max-y kept col-mask))))))

  (defn geyser-column-mask [cg lx lz]
    (if (= @(ChunkGeysers.count cg) 0)
      0
      @(Array.unsafe-nth (ChunkGeysers.col-mask cg) (+ (* lz 32) lx))))

  ;; Evaluate 3-Zone CSG Sinter Cone + Buried Obsidian Boiler Flask + Self-Oscillating Fluid Charge!
  (defn eval-single-geyser [gd fdx fdy fdz rock-sdf n-det]
    (let [dx (- fdx @(GeyserDesc.gx gd))
          dy (- fdy @(GeyserDesc.gy gd))
          dz (- fdz @(GeyserDesc.gz gd))]
      (if (or (> (Double.abs dx) 5.6)
              (or (> (Double.abs dz) 5.6)
                  (or (< dy -8.6) (> dy 5.2))))
        (GeyserHit.init false rock-sdf 0.0f 0.0f)
        (let [b @(GeyserDesc.biome gd)
              d-cone (+ (CSG.sd-capped-cone-y dx (- dy 0.45) dz 4.0 1.68 1.80) (* 0.14 n-det))
              d-flask-out (CSG.sd-sphere dx (+ dy 4.3) dz 3.10)
              d-liner (CSG.sd-cyl-y dx (+ dy 1.4) dz 2.30 3.0)
              d-shell-raw (CSG.op-smooth-union d-cone (CSG.dmin d-flask-out d-liner) 0.45)
              d-boiler (CSG.sd-sphere dx (+ dy 4.3) dz 2.02)
              d-torus (CSG.sd-torus-y dx (+ dy 2.3) dz 2.08 1.12)
              d-throat (CSG.sd-cyl-y dx (+ dy 0.6) dz 1.22 3.8)
              d-carve (CSG.dmin d-boiler (CSG.dmin d-torus d-throat))
              d-wall (CSG.op-sub d-shell-raw d-carve)
              merged-solid (CSG.op-smooth-union rock-sdf d-wall 0.30)
              out-sdf (CSG.dclamp -12.0 12.0 (CSG.op-sub merged-solid d-carve))]
          (if (> out-sdf 0.0)
            (let [fl (if (< d-carve 0.0)
                       (if (and (< d-boiler 0.0) (<= dy -4.5))
                         -2.0f
                         (if (and (< d-torus 0.0) (> dy -3.1))
                           (if (= b 7) -3.0f (if (= b 11) -15.0f -1.0f))
                           0.0f))
                       0.0f)]
              (GeyserHit.init true out-sdf 0.0f fl))
            (let [g-mat (if (<= d-wall (+ rock-sdf 0.28))
                          (if (< dy -1.1)
                            16.0f
                            (if (= b 7)
                              (if (and (> dy 1.1) (< (CSG.len2 dx dz) 2.6)) 23.0f 16.0f)
                              (if (or (= b 2) (= b 11))
                                (if (> n-det 0.15) 14.0f 8.0f)
                                (if (or (> dy 0.80) (> n-det 0.05)) 21.0f 1.0f))))
                          0.0f)
                  safe-d (if (and (or (= g-mat 21.0f) (= g-mat 23.0f))
                                  (and (> out-sdf -0.55) (< out-sdf -0.45)))
                           -0.57
                           out-sdf)]
              (GeyserHit.init true safe-d g-mat 0.0f)))))))

  (defn eval-geyser-masked [cg mask fdx fdy fdz rock-sdf n-det]
    (if (or (< fdy @(ChunkGeysers.min-y cg)) (> fdy @(ChunkGeysers.max-y cg)))
      (GeyserHit.init false rock-sdf 0.0f 0.0f)
      (let [items (ChunkGeysers.items cg)
            cnt @(ChunkGeysers.count cg)
            cur-sdf rock-sdf
            cur-mat 0.0f
            cur-fl 0.0f
            any-hit false]
        (do
          (for [i 0 cnt]
            (when (/= (Int.bit-and mask (Int.bit-shift-left 1 i)) 0)
              (let [gd (Array.unsafe-nth items i)
                    gh (Terrain.eval-single-geyser gd fdx fdy fdz cur-sdf n-det)]
                (when @(GeyserHit.active &gh)
                  (do
                    (set! any-hit true)
                    (set! cur-sdf @(GeyserHit.sdf &gh))
                    (when (> @(GeyserHit.mat &gh) 0.5f)
                      (set! cur-mat @(GeyserHit.mat &gh)))
                    (when (/= @(GeyserHit.fluid &gh) 0.0f)
                      (set! cur-fl @(GeyserHit.fluid &gh))))))))
          (GeyserHit.init any-hit cur-sdf cur-mat cur-fl)))))
)

(load "flora.carp")

(defmodule Terrain
  (defn generate! [noise-state strata qx qy qz p-data]
    (let [res 32
          ;; Every 32m chunk qy belongs strictly to one 192m (6-chunk) depth segment!
          chunk-seg (if (>= qy -6) 0 (+ 1 (/ (- -7 qy) 6)))
          b0 (StrataConfig.biome-for strata chunk-seg 0)
          b1 (StrataConfig.biome-for strata chunk-seg 1)
          b2 (StrataConfig.biome-for strata chunk-seg 2)
          b3 (StrataConfig.biome-for strata chunk-seg 3)
          b4 (StrataConfig.biome-for strata chunk-seg 4)
          s0 (StrataConfig.split-for strata chunk-seg 0)
          s1 (StrataConfig.split-for strata chunk-seg 1)
          s2 (StrataConfig.split-for strata chunk-seg 2)
          s3 (StrataConfig.split-for strata chunk-seg 3)
          mw0 (Terrain.macro-w b0) mw1 (Terrain.macro-w b1) mw2 (Terrain.macro-w b2) mw3 (Terrain.macro-w b3) mw4 (Terrain.macro-w b4)
          cw0 (Terrain.chasm-w b0) cw1 (Terrain.chasm-w b1) cw2 (Terrain.chasm-w b2) cw3 (Terrain.chasm-w b3) cw4 (Terrain.chasm-w b4)
          tw0 (Terrain.tun-w b0)   tw1 (Terrain.tun-w b1)   tw2 (Terrain.tun-w b2)   tw3 (Terrain.tun-w b3)   tw4 (Terrain.tun-w b4)
          th0 (Terrain.thresh-w b0) th1 (Terrain.thresh-w b1) th2 (Terrain.thresh-w b2) th3 (Terrain.thresh-w b3) th4 (Terrain.thresh-w b4)
          sm0 (Terrain.sed-morph-w b0) sm1 (Terrain.sed-morph-w b1) sm2 (Terrain.sed-morph-w b2) sm3 (Terrain.sed-morph-w b3) sm4 (Terrain.sed-morph-w b4)
          rm0 (Terrain.rim-morph-w b0) rm1 (Terrain.rim-morph-w b1) rm2 (Terrain.rim-morph-w b2) rm3 (Terrain.rim-morph-w b3) rm4 (Terrain.rim-morph-w b4)
          hm0 (Terrain.hex-morph-w b0) hm1 (Terrain.hex-morph-w b1) hm2 (Terrain.hex-morph-w b2) hm3 (Terrain.hex-morph-w b3) hm4 (Terrain.hex-morph-w b4)
          gm0 (Terrain.geo-morph-w b0) gm1 (Terrain.geo-morph-w b1) gm2 (Terrain.geo-morph-w b2) gm3 (Terrain.geo-morph-w b3) gm4 (Terrain.geo-morph-w b4)
          sdf-spec (StrataConfig.sdf-spec strata)
          ;; O(1) Supercell + Connector Graph Pre-Culler (~78% of chunks & ~75% of columns skip CSG!)
          ccsg (Structures.prepare-chunk noise-state strata qx qy qz)
          ;; O(1) Relaxation-Oscillator Geyser & Fumarole Pre-Culler (`<= 2` geysers/chunk, `0` on >85% of chunks!)
          cgeys (Terrain.prepare-chunk-geysers noise-state strata qx qy qz)
          ;; Stateless CSG Botanical Pre-Culler (`32x32` column bitmask for trees, toadstools, vines, shelf-fungi & briars)
          cflora (Flora.prepare-chunk noise-state strata qx qy qz)]
      (do
        (for [z 0 res]
          (for [x 0 res]
            (let [gx (+ (* qx 32) x)
                  gz (+ (* qz 32) z)
                  fdx (Double.from-int gx)
                  fdz (Double.from-int gz)
                  col-mask (Structures.column-mask &ccsg fdx fdz)
                  geyser-mask (Terrain.geyser-column-mask &cgeys x z)
                  flora-mask (Flora.column-mask &cflora x z)
                  prof (Terrain.surface-profile-at strata fdx fdz)
                  surface-h @(SurfProfile.h &prof)
                  dhx @(SurfProfile.dhx &prof)
                  dhz @(SurfProfile.dhz &prof)
                  crag-2d @(SurfProfile.crag &prof)
                  slope2 (+ (* dhx dhx) (* dhz dhz))
                  slope (Double.sqrt slope2)
                  inv-grad-sol (/ 1.0 (Double.sqrt (+ 1.0 slope2)))
                  inv-grad-air (/ 0.88 (Double.sqrt (+ 1.0 (+ slope2 (* 0.45 (* crag-2d crag-2d))))))
                  sky-cutoff (+ surface-h (/ 6.8 inv-grad-air))
                  ;; Geological folding/faulting warps stratum boundaries by +-14m across (x, z)
                  fold-y (+ (* 10.5 (Noise.noise2d noise-state (+ (* fdx 0.011) 131.0) (- (* fdz 0.011) 83.0)))
                            (* 4.0 (Noise.noise2d noise-state (- (* fdx 0.029) 41.0) (+ (* fdz 0.029) 67.0))))
                  n-sink (Noise.noise2d noise-state (+ (* fdx 0.022) 91.0) (- (* fdz 0.022) 47.0))
                  sink-open (if (> n-sink 0.46) 0.0 (if (< n-sink 0.26) 1.0 (/ (- 0.46 n-sink) 0.20)))]
              (for [y 0 res]
                (let [gy (+ (* qy 32) y)
                      fdy (Double.from-int gy)
                      seg (if (>= gy -192) 0 (+ 1 (/ (- -193 gy) 192)))
                      local-gy (+ gy (* seg 192))
                      local-fdy (Double.from-int local-gy)
                      idx (+ (* z 1024) (+ (* y 32) x))
                      offset (* idx 4)]
                  (if (and (<= local-gy -187) (>= local-gy -192))
                      ;; Segment Boundary Abyssal Seal (MAT_SEAL = 18.0f) at local-gy in [-192 .. -187]
                      ;; Dissolves ONLY when Gold (5) or Ambrosia (262) is poured onto it!
                      (let [seal-sdf (Double.to-float (- (Double.abs (- local-fdy -189.5)) 3.2))]
                        (do
                          (Pointer.set (Pointer.add p-data (Long.from-int offset)) 18.0f)
                          (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) seal-sdf)
                          (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 2))) 0.0f)
                          (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 3))) 10.0f)))
                      (let [dy-h (- fdy surface-h)
                            surf-sdf (* dy-h (if (> dy-h 0.0) inv-grad-air inv-grad-sol))]
                        (if (and (= seg 0)
                                 (and (> fdy sky-cutoff)
                                      (and (not (and (/= (Int.bit-and col-mask 1) 0)
                                                     (and (>= fdy @(ChunkCSG.s-min-y &ccsg))
                                                          (<= fdy @(ChunkCSG.s-max-y &ccsg)))))
                                           (and (not (and (/= geyser-mask 0)
                                                          (and (>= fdy @(ChunkGeysers.min-y &cgeys))
                                                               (<= fdy @(ChunkGeysers.max-y &cgeys)))))
                                                (not (and (/= flora-mask 0)
                                                          (and (>= fdy @(ChunkFlora.min-y &cflora))
                                                               (<= fdy @(ChunkFlora.max-y &cflora)))))))))
                            (do
                              (Pointer.set (Pointer.add p-data (Long.from-int offset)) 0.0f)
                              (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) (Double.to-float (if (> surf-sdf 12.0) 12.0 surf-sdf)))
                              (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 2))) 0.0f)
                              (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 3))) 0.0f))
                            (let [wy (+ local-fdy fold-y)
                                  t0 (Terrain.smooth01 -7.0 7.0 (- s0 wy))
                                  t1 (Terrain.smooth01 -7.0 7.0 (- s1 wy))
                                  t2 (Terrain.smooth01 -7.0 7.0 (- s2 wy))
                                  t3 (Terrain.smooth01 -7.0 7.0 (- s3 wy))
                                  w-macro (Terrain.lerp5 mw0 mw1 mw2 mw3 mw4 t0 t1 t2 t3)
                                  w-chasm (Terrain.lerp5 cw0 cw1 cw2 cw3 cw4 t0 t1 t2 t3)
                                  w-tun   (Terrain.lerp5 tw0 tw1 tw2 tw3 tw4 t0 t1 t2 t3)
                                  base-th (Terrain.lerp5 th0 th1 th2 th3 th4 t0 t1 t2 t3)
                                  w-sed   (Terrain.lerp5 sm0 sm1 sm2 sm3 sm4 t0 t1 t2 t3)
                                  w-rim   (Terrain.lerp5 rm0 rm1 rm2 rm3 rm4 t0 t1 t2 t3)
                                  w-hex   (Terrain.lerp5 hm0 hm1 hm2 hm3 hm4 t0 t1 t2 t3)
                                  w-geo   (Terrain.lerp5 gm0 gm1 gm2 gm3 gm4 t0 t1 t2 t3)
                                  n-macro (Noise.noise3d noise-state (* fdx 0.018) (* fdy 0.022) (* fdz 0.018))
                                  n-chasm (Noise.noise3d noise-state (- (* fdx 0.028) 63.0) (* fdy 0.011) (+ (* fdz 0.028) 29.0))
                                  n-tun (Noise.noise3d noise-state (+ (* fdx 0.038) 17.0) (* fdy 0.044) (- (* fdz 0.038) 41.0))
                                  n-det (Noise.noise3d noise-state (+ (* fdx 0.095) 37.0) (* fdy 0.095) (- (* fdz 0.095) 19.0))
                                  fault-crease (* w-hex (* 0.28 (- 0.42 (Double.abs n-chasm))))
                                  roof-guard (if (and (= seg 0) (> surf-sdf -8.0)) (* (* (+ surf-sdf 8.0) 0.032) sink-open) 0.0)
                                  ;; Open wide Seal Chambers right above (-178..-186) and Vaults right below (-1..-11) each Abyssal Seal!
                                  seal-open (if (< local-fdy -178.0) (* (- -178.0 local-fdy) 0.055) 0.0)
                                  vault-open (if (and (> seg 0) (> local-fdy -11.0)) (* (+ local-fdy 11.0) 0.055) 0.0)
                                  cauld-guard (+ (Terrain.cauldron-seal b0 s0 wy)
                                                 (+ (Terrain.cauldron-seal b1 s1 wy)
                                                    (+ (Terrain.cauldron-seal b2 s2 wy)
                                                       (Terrain.cauldron-seal b3 s3 wy))))
                                  cave-blend (+ (* n-macro w-macro)
                                                (+ (* n-chasm w-chasm)
                                                   (+ (* n-tun w-tun)
                                                      (+ fault-crease (+ (* n-det 0.12) (+ seal-open vault-open))))))
                                  cave-raw (- cave-blend (+ base-th (+ roof-guard cauld-guard)))
                                  depth-below (- surface-h fdy)
                                  deep-raw (/ (- depth-below 12.0) 55.0)
                                  deep-scale (if (< deep-raw 0.30) 0.30 (if (> deep-raw 1.0) 1.0 deep-raw))
                                  sdf-scale (+ 12.0 (* 12.0 deep-scale))
                                  cave-sdf-raw (* cave-raw sdf-scale)
                                  cave-sdf (if (> cave-sdf-raw 12.0) 12.0 (if (< cave-sdf-raw -12.0) -12.0 cave-sdf-raw))
                                  final-sdf (Terrain.eval-morph-sdf sdf-spec seg local-fdy fdx fdy fdz surf-sdf slope crag-2d cave-sdf w-sed w-rim w-hex w-geo)
                                  csg-s (if (/= col-mask 0)
                                          (Structures.eval-masked &ccsg col-mask fdx fdy fdz n-det)
                                          (CSGSample.init 0 0.0f 12.0f 0.0f 0.0f))
                                  csg-mode @(CSGSample.mode &csg-s)]
                              (if (or (= csg-mode 1) (and (= csg-mode 4) (> final-sdf -0.6)))
                                  ;; Mode 1 (`CSG_SOLID`) or Mode 4 (`CSG_FOUNDATION` bridging cave/valley air into solid rock)!
                                  (let [s-out (if (= csg-mode 4)
                                                (Float.min (Double.to-float final-sdf) @(CSGSample.sdf &csg-s))
                                                @(CSGSample.sdf &csg-s))]
                                    (do
                                      (Pointer.set (Pointer.add p-data (Long.from-int offset)) @(CSGSample.mat &csg-s))
                                      (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) s-out)
                                      (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 2))) 0.0f)
                                      (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 3))) 15.4f)))
                                  (if (= csg-mode 2)
                                      ;; Mode 2 (`CSG_AIR_OR_VAT`): Carved room air, pipe bore, fluid vat, or doorway apron!
                                      (let [c-fl @(CSGSample.fluid &csg-s)
                                            c-sdf @(CSGSample.sdf &csg-s)
                                            w-lim @(CSGSample.wall-sdf &csg-s)
                                            f-sdf (Double.to-float final-sdf)
                                            out-sdf (if (/= c-fl 0.0f)
                                                      c-sdf
                                                      (Float.clamp 0.06f 12.0f (Float.min w-lim (Float.max f-sdf c-sdf))))]
                                        (do
                                          (Pointer.set (Pointer.add p-data (Long.from-int offset)) 0.0f)
                                          (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) out-sdf)
                                          (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 2))) c-fl)
                                          (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 3))) 0.0f)))
                                      ;; Mode 0 (`CSG_NONE`), buried Mode 4 (`final-sdf <= -0.6`), or Mode 3 (`CSG_COLLAR`):
                                      (let [rock-base-sdf (if (= csg-mode 3)
                                                            (Double.from-float
                                                              (Float.clamp -12.0f 12.0f
                                                                (Float.min @(CSGSample.wall-sdf &csg-s)
                                                                           (Float.max (Double.to-float final-sdf) @(CSGSample.sdf &csg-s)))))
                                                            (if (= csg-mode 4)
                                                              (CSG.dmin final-sdf (Double.from-float @(CSGSample.sdf &csg-s)))
                                                              final-sdf))
                                            gh (if (/= geyser-mask 0)
                                                 (Terrain.eval-geyser-masked &cgeys geyser-mask fdx fdy fdz rock-base-sdf n-det)
                                                 (GeyserHit.init false rock-base-sdf 0.0f 0.0f))
                                            rock-eff-sdf @(GeyserHit.sdf &gh)
                                            g-mat @(GeyserHit.mat &gh)
                                            g-fl @(GeyserHit.fluid &gh)
                                            fl-msdf (if (and (/= flora-mask 0)
                                                             (and (not @(GeyserHit.active &gh))
                                                                  (> rock-eff-sdf -1.45)))
                                                      (Flora.eval-masked &cflora sdf-spec flora-mask fdx fdy fdz n-det)
                                                      (CSG.m-none))
                                            fl-d @(MatSDF.d &fl-msdf)
                                            fl-mat @(MatSDF.mat &fl-msdf)
                                            ;; Fold nearby & solid CSG flora into BOTH solid and air SDF so GPU sphere-tracing never oversteps thin vines/branches!
                                            eff-sdf (if (< fl-d 12.0)
                                                      (CSG.dclamp -12.0 12.0 (CSG.op-smooth-union rock-eff-sdf fl-d 0.25))
                                                      rock-eff-sdf)
                                            slot (if (>= wy s0) 0 (if (>= wy s1) 1 (if (>= wy s2) 2 (if (>= wy s3) 3 4))))
                                            b-curr (if (= slot 0) b0 (if (= slot 1) b1 (if (= slot 2) b2 (if (= slot 3) b3 b4))))
                                            band-top (if (= slot 0) 24.0 (if (= slot 1) s0 (if (= slot 2) s1 (if (= slot 3) s2 s3))))
                                            band-bot (if (= slot 0) s0 (if (= slot 1) s1 (if (= slot 2) s2 (if (= slot 3) s3 -187.0))))]
                                        (if (> eff-sdf 0.0)
                                            (let [seed-fluid (if (/= g-fl 0.0f)
                                                                 g-fl
                                                                 (if (< surf-sdf -12.0)
                                                                     (Terrain.seed-fluid-for-biome b-curr wy band-bot band-top n-macro n-chasm n-tun)
                                                                     0.0f))]
                                              (do
                                                (Pointer.set (Pointer.add p-data (Long.from-int offset)) 0.0f)
                                                (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) (Double.to-float eff-sdf))
                                                (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 2))) seed-fluid)
                                                (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 3))) 0.0f)))
                                            (let [cave-skin? (and (< surf-sdf -5.0) (> rock-eff-sdf -1.6))
                                                  deep-core? (and (< surf-sdf -8.0) (< rock-eff-sdf -5.0))
                                                  n3 (if cave-skin?
                                                         (Noise.noise3d noise-state (- (* fdx 0.17) 11.0) (+ (* fdy 0.17) 53.0) (* fdz 0.17))
                                                         0.0)
                                                  spinodal (if (> n-det 0.26)
                                                             (SpectralDetail.sample-bank-ch sdf-spec 3 (* fdx 0.52) (* fdy 0.52) (* fdz 0.52))
                                                             1.0)
                                                  wy-dither (+ wy (* n-det 2.4))
                                                  slot-m (if (>= wy-dither s0) 0 (if (>= wy-dither s1) 1 (if (>= wy-dither s2) 2 (if (>= wy-dither s3) 3 4))))
                                                  b-mat (if (= slot-m 0) b0 (if (= slot-m 1) b1 (if (= slot-m 2) b2 (if (= slot-m 3) b3 b4))))
                                                  bot-m (if (= slot-m 0) s0 (if (= slot-m 1) s1 (if (= slot-m 2) s2 (if (= slot-m 3) s3 -187.0))))
                                                  under-cauldron? (or (and (Terrain.cauldron-biome? b0) (< (Double.abs (- wy s0)) 5.0))
                                                                      (or (and (Terrain.cauldron-biome? b1) (< (Double.abs (- wy s1)) 5.0))
                                                                          (or (and (Terrain.cauldron-biome? b2) (< (Double.abs (- wy s2)) 5.0))
                                                                              (and (Terrain.cauldron-biome? b3) (< (Double.abs (- wy s3)) 5.0)))))
                                                  moss-cand? (and (not under-cauldron?)
                                                                  (and (> rock-eff-sdf -1.15)
                                                                       (or (and (= seg 0) (and (< slope 0.68) (and (> surf-sdf -1.25) (> n-det -0.16))))
                                                                           (and (< surf-sdf -6.0)
                                                                                (or (and (= b-curr 0) (> n3 -0.22))
                                                                                    (and (or (= b-curr 2) (= b-curr 9)) (> n3 0.30)))))))
                                                  moss-top? (if moss-cand?
                                                              (> (Terrain.eval-base-sdf-at noise-state strata fdx (+ fdy 1.15) fdz)
                                                                 (+ final-sdf 0.32))
                                                              false)
                                                  mat-id (if (> g-mat 0.5f)
                                                             g-mat
                                                             (if (and (> fl-mat 0.5f) (<= fl-d (+ rock-eff-sdf 0.14)))
                                                                 fl-mat
                                                                 (if (and (= seg 0) (> surf-sdf -3.8))
                                                                     ;; Overworld Slope, Crag Spine & Elevation Stratification:
                                                                     (let [ridge-exp (+ slope (* 0.42 (Double.max 0.0 crag-2d)))]
                                                                       (if (and (< ridge-exp 0.46) (< surf-sdf 0.32))
                                                                           ;; 1. Lush valley meadows & sheltered terrace benches
                                                                           (if moss-top? 26.0f 2.0f)
                                                                           (if (< slope 0.68)
                                                                               ;; 2. Rocky talus shoulders & hogback crests: jutting Stone crag spines + Soil/Moss pockets
                                                                               (let [spec-crag (SpectralDetail.sample-bank-ch sdf-spec 0 (* fdx 0.38) (* fdy 0.46) (* fdz 0.38))
                                                                                     c1-m (SpectralDetail.sample-bank-ch sdf-spec 0 (+ (* fdx 0.96) 17.3) (* fdy 1.18) (- (* fdz 0.96) 29.1))
                                                                                     r1-m (- 0.60 (Double.sqrt (+ (* c1-m c1-m) 0.022)))]
                                                                                 (if (or (> surf-sdf 0.28) (or (> r1-m 0.20) (or (< spec-crag -0.10) (or (> ridge-exp 0.62) (<= surf-sdf -2.2)))))
                                                                                     (if (and (> surface-h 48.0) (> n-det 0.12)) 8.0f 1.0f)
                                                                                     (if (and (> surf-sdf -1.10) (and (> n-det 0.08) moss-top?)) 26.0f 2.0f)))
                                                                               ;; 3. Steep cliff escarpments & pinched arêtes: zero Soil/Grass, bare stratified Stone + veins + alpine frost!
                                                                               (if (and (> surface-h 46.5) (and (> surf-sdf -1.8) (> n-det -0.15)))
                                                                                   8.0f
                                                                                   (if (and (< (Double.abs spinodal) 0.085) (> n-det 0.28))
                                                                                       (if (> n-det 0.48) 5.0f (Terrain.vein-ore-for-biome b0))
                                                                                       (if (and (> (Double.sin (+ (* wy 0.52) (* n-det 0.85))) 0.84) (> n-det 0.05))
                                                                                           (if (= b0 4) 6.0f (if (= b0 8) 21.0f (Terrain.vein-ore-for-biome b0)))
                                                                                           1.0f))))))
                                                                     ;; Subterranean caves & deep bedrock
                                                                     (if moss-top?
                                                                         26.0f
                                                                         (if under-cauldron?
                                                                             16.0f
                                                                             (Terrain.solid-mat-for-biome b-mat wy-dither bot-m cave-skin? deep-core? n3 n-tun n-det spinodal))))))
                                                  f-out-raw (Double.to-float eff-sdf)
                                                  f-out (if (and (or (= mat-id 6.0f) (or (= mat-id 21.0f) (= mat-id 23.0f)))
                                                                 (and (= seg 0) (and (> surf-sdf -3.4) (and (> f-out-raw -0.55f) (< f-out-raw -0.45f)))))
                                                          -0.57f
                                                          f-out-raw)
                                                  b-clv (if (and (= seg 0) (> surf-sdf -3.8)) b0 b-mat)
                                                  cleav (if (or (= b-clv 1) (or (= b-clv 4) (or (= b-clv 8) (or (= b-clv 9) (= b-clv 10)))))
                                                          ;; Sedimentary biomes: weak horizontal bedding partings along |strata_step| == 0
                                                          (let [st-c (SpectralDetail.sample-bank-ch sdf-spec 2 (* fdx 0.34) (* fdy 0.68) (* fdz 0.34))]
                                                            (+ 0.06 (* 0.86 (Terrain.smooth01 0.03 0.28 (Double.abs st-c)))))
                                                          (if (or (= b-clv 2) (or (= b-clv 3) (or (= b-clv 5) (= b-clv 11))))
                                                            ;; Columnar / Crystalline biomes: vertical hexagonal prism joints + crag facets
                                                            (let [hx-c (SpectralDetail.sample-bank-ch sdf-spec 1 (* fdx 0.62) (* fdy 0.18) (* fdz 0.62))
                                                                  cr-c (SpectralDetail.sample-bank-ch sdf-spec 0 (* fdx 0.50) (* fdy 0.50) (* fdz 0.50))]
                                                              (+ 0.06 (+ (* 0.64 (Terrain.smooth01 0.04 0.30 (Double.abs hx-c)))
                                                                         (* 0.26 (Terrain.smooth01 0.04 0.32 (Double.abs cr-c))))))
                                                            ;; Karst / Geode / Magma & Overworld rock: spinodal fault webs + crag cleavage
                                                            (let [sp-c (SpectralDetail.sample-bank-ch sdf-spec 3 (* fdx 0.52) (* fdy 0.52) (* fdz 0.52))
                                                                  cr-c (SpectralDetail.sample-bank-ch sdf-spec 0 (* fdx 0.45) (* fdy 0.45) (* fdz 0.45))]
                                                              (+ 0.06 (+ (* 0.60 (Terrain.smooth01 0.04 0.26 (Double.abs sp-c)))
                                                                         (* 0.30 (Terrain.smooth01 0.04 0.32 (Double.abs cr-c))))))))
                                                  cleav-w (Double.to-float (+ 10.05 (* 5.85 (Double.clamp 0.02 0.98 cleav))))]
                                              (do
                                                (Pointer.set (Pointer.add p-data (Long.from-int offset)) mat-id)
                                                (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) f-out)
                                                (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 2))) 0.0f)
                                                (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 3))) cleav-w)))))))))))))))))))
)

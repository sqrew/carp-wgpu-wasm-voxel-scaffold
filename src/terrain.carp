(load "../../carp-math/noise.carp")

(defmodule Terrain
  (defn generate! [noise-state qx qy qz p-data]
    (let [res 32]
      (do
        (for [z 0 res]
          (for [x 0 res]
            (let [gx (+ (* qx 32) x)
                  gz (+ (* qz 32) z)
                  ;; Procedural rolling hills (2D simplex noise)
                  nx (* (Double.from-int gx) 0.015)
                  nz (* (Double.from-int gz) 0.015)
                  surface-height (Double.to-int (+ 20.0 (* 16.0 (Noise.noise2d noise-state nx nz))))]
              (for [y 0 res]
                (let [gy (+ (* qy 32) y)
                      idx (+ (* z 1024) (+ (* y 32) x))
                      offset (* idx 4)]
                  (if (<= gy 0)
                      ;; Absolute Bedrock Floor
                      (do
                        (Pointer.set (Pointer.add p-data (Long.from-int offset)) 255.0f)
                        (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) -1.0f)
                        (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 2))) 0.0f)
                        (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 3))) 10.0f))
                      (if (> gy surface-height)
                          ;; Air above the ground
                          (do
                            (Pointer.set (Pointer.add p-data (Long.from-int offset)) 0.0f)
                            (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) (Float.from-int (- gy surface-height)))
                            (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 2))) 0.0f)
                            (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 3))) 0.0f))
                          ;; Solid Terrain
                          (let [mat-id (if (> gy (- surface-height 3)) 2.0f 1.0f)
                                sdf (Float.from-int (- gy surface-height))]
                            (do
                              (Pointer.set (Pointer.add p-data (Long.from-int offset)) mat-id)
                              (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) sdf)
                              (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 2))) 0.0f)
                              (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 3))) 10.0f)))))))))))))
)

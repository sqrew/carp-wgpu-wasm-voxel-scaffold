(load "GLFW.carp")
(load "WGPURender.carp")

(deftemplate glfw-window->voidptr (Fn [(Ptr GLFWwindow)] (Ptr ()))
  "void* $NAME(GLFWwindow* w)"
  "$DECL { return (void*)w; }")

(deftemplate ref-to-ptr (Fn [(Ref a)] (Ptr a))
  "void* $NAME(void* r)"
  "$DECL { return r; }")

(deftemplate emscripten-sleep (Fn [Int] ())
  "void $NAME(int ms)"
  "$DECL {
#ifdef __EMSCRIPTEN__
    emscripten_sleep(ms);
#endif
  }")

(deftemplate js-globals-setup (Fn [] ())
  "#ifndef JS_GLOBALS_DEFINED
   #define JS_GLOBALS_DEFINED
   float js_brush_radius = 3.0f;
   float js_solid_mat = 2.0f;
   float js_liq_mat = 1.0f;
   float js_gas_mat = 1.0f;
   float js_flying = 1.0f;
   float js_flashlight = 1.0f;

   #ifdef __EMSCRIPTEN__
   #include <emscripten.h>
   EMSCRIPTEN_KEEPALIVE void set_brush_radius(float r) { js_brush_radius = r; }
   EMSCRIPTEN_KEEPALIVE void set_solid_mat(float m) { js_solid_mat = m; }
   EMSCRIPTEN_KEEPALIVE void set_liq_mat(float m) { js_liq_mat = m; }
   EMSCRIPTEN_KEEPALIVE void set_gas_mat(float m) { js_gas_mat = m; }
   EMSCRIPTEN_KEEPALIVE void set_flying(float f) { js_flying = f; }
   EMSCRIPTEN_KEEPALIVE void set_flashlight(float f) { js_flashlight = f; }
   #endif
   #endif

   void $NAME(void)"
  "$DECL {}")

(deftemplate js-sync-all (Fn [Float Float Float Float Float Float] ())
  "void $NAME(float r, float s, float l, float g, float fly, float light)"
  "$DECL {
#ifdef __EMSCRIPTEN__
      char buf[512];
      sprintf(buf, \"window.player_brush_radius = %f; window.player_solid_mat = %f; window.player_liq_mat = %f; window.player_gas_mat = %f; window.player_flying = %f > 0.5; window.player_flashlight = %f > 0.5; if (window.sync_ui) window.sync_ui();\", r, s, l, g, fly, light);
      emscripten_run_script(buf);
#endif
  }")

(deftemplate get-js-brush-radius (Fn [] Float) "float $NAME(void)" "$DECL { return js_brush_radius; }")
(deftemplate get-js-solid-mat (Fn [] Float) "float $NAME(void)" "$DECL { return js_solid_mat; }")
(deftemplate get-js-liq-mat (Fn [] Float) "float $NAME(void)" "$DECL { return js_liq_mat; }")
(deftemplate get-js-gas-mat (Fn [] Float) "float $NAME(void)" "$DECL { return js_gas_mat; }")
(deftemplate get-js-flying (Fn [] Float) "float $NAME(void)" "$DECL { return js_flying; }")
(deftemplate get-js-flashlight (Fn [] Float) "float $NAME(void)" "$DECL { return js_flashlight; }")

(deftemplate set-js-brush-radius (Fn [Float] ()) "void $NAME(float r)" "$DECL { js_brush_radius = r; }")
(deftemplate set-js-solid-mat (Fn [Float] ()) "void $NAME(float m)" "$DECL { js_solid_mat = m; }")
(deftemplate set-js-liq-mat (Fn [Float] ()) "void $NAME(float m)" "$DECL { js_liq_mat = m; }")
(deftemplate set-js-gas-mat (Fn [Float] ()) "void $NAME(float m)" "$DECL { js_gas_mat = m; }")
(deftemplate set-js-flying (Fn [Float] ()) "void $NAME(float f)" "$DECL { js_flying = f; }")
(deftemplate set-js-flashlight (Fn [Float] ()) "void $NAME(float f)" "$DECL { js_flashlight = f; }")

(register-type GLFWwindow)

(deftemplate create-voxel-scaffold-bind-group (Fn [(Ptr WGPUContext) (Ptr WGPURenderPipelineWrapper) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) WGPUSampler (Ptr WGPUUniformBufferWrapper)] WGPUBindGroup)
  "WGPUBindGroup $NAME(WGPUContext* ctx, WGPURenderPipelineWrapper* pipe, WGPURenderTexture* solid_tex, WGPURenderTexture* liquid_tex, WGPURenderTexture* gas_tex, WGPURenderTexture* light_tex, WGPURenderTexture* stress_tex, WGPUSampler sampler, WGPUUniformBufferWrapper* ub)"
  "$DECL {
      if (!ctx || !pipe || !solid_tex || !liquid_tex || !gas_tex || !light_tex || !stress_tex || !sampler || !ub) {
          return NULL;
      }
      WGPUBindGroupEntry entries[7] = {
          {
              .binding = 0,
              .buffer  = ub->buffer,
              .offset  = 0,
              .size    = ub->size,
          },
          {
              .binding     = 1,
              .textureView = solid_tex->view,
          },
          {
              .binding = 2,
              .sampler = sampler,
          },
          {
              .binding     = 3,
              .textureView = liquid_tex->view,
          },
          {
              .binding     = 4,
              .textureView = gas_tex->view,
          },
          {
              .binding     = 5,
              .textureView = light_tex->view,
          },
          {
              .binding     = 6,
              .textureView = stress_tex->view,
          }
      };
      WGPUBindGroupLayout layout = wgpuRenderPipelineGetBindGroupLayout(pipe->pipeline, 0);
      if (!layout) {
          return NULL;
      }
      WGPUBindGroupDescriptor desc = {
          .layout     = layout,
          .entryCount = 7,
          .entries    = entries,
      };
      WGPUBindGroup bg = wgpuDeviceCreateBindGroup(ctx->device, &desc);
      wgpuBindGroupLayoutRelease(layout);
      return bg;
  }")

(deftype Engine [
  ctx (Ptr WGPUContext)
  win (Ptr GLFWwindow)
  surf (Ptr WGPURenderSurface)
  width Int
  height Int
  start-time Double
])

(defmodule Engine
  (defn create [title init-w init-h]
    (match (WGPU.create-context)
      (Result.Error e) (Result.Error (str* "GPU context creation failed: " e))
      (Result.Success ctx)
        (let [glfw-ok (GLFW.init)]
          (if (= glfw-ok GLFW.FALSE)
            (do
              (WGPU.free-context ctx)
              (Result.Error @"GLFW init failed"))
            (do
              (GLFW.window-hint GLFW.CLIENT_API GLFW.NO_API)
              (let [win (GLFW.create-window init-w init-h (String.cstr title) NULL NULL)]
                (if (null? win)
                  (do
                    (GLFW.terminate)
                    (WGPU.free-context ctx)
                    (Result.Error @"Failed to create GLFW window"))
                  (match (WGPURender.create-surface ctx (glfw-window->voidptr win) init-w init-h)
                    (Result.Error e)
                      (do
                        (GLFW.destroy-window win)
                        (GLFW.terminate)
                        (WGPU.free-context ctx)
                        (Result.Error (str* "Surface failed: " e)))
                    (Result.Success surf)
                      (Result.Success (Engine.init ctx win surf init-w init-h (GLFW.get-time)))))))))))

  (defn should-close? [eng]
    (= (GLFW.window-should-close @(Engine.win eng)) GLFW.TRUE))

  (defn update-time [eng]
    (Double.to-float (- (GLFW.get-time) @(Engine.start-time eng))))

  (defn poll-events [eng]
    (GLFW.poll-events))

  (defn handle-resize [eng]
    (let [win @(Engine.win eng)
          ctx @(Engine.ctx eng)
          surf @(Engine.surf eng)
          w 0
          h 0]
      (do
        (GLFW.get-framebuffer-size win (ref-to-ptr &w) (ref-to-ptr &h))
        (when (or (/= w @(Engine.width eng)) (/= h @(Engine.height eng)))
          (do
            (WGPURender.resize-surface surf ctx w h)
            (Engine.set-width! eng w)
            (Engine.set-height! eng h))))))

  (defn begin-frame [eng]
    (let [surf @(Engine.surf eng)
          ctx @(Engine.ctx eng)]
      (match (WGPURender.begin-frame surf ctx)
        (Result.Error _e) (Maybe.Nothing)
        (Result.Success frame) (Maybe.Just frame))))

  (defn end-frame [eng frame]
    (let [surf @(Engine.surf eng)
          ctx @(Engine.ctx eng)]
      (do
        (WGPURender.end-frame frame surf ctx)
        (WGPURender.free-frame frame))))

  (defn create-pipeline [eng wgsl vs-entry fs-entry]
    (WGPURender.create-pipeline @(Engine.ctx eng) wgsl vs-entry fs-entry &(WGPURender.surface-format @(Engine.surf eng))))

  (defn create-uniform-buffer [eng size]
    (WGPURender.create-uniform-buffer @(Engine.ctx eng) size))

  (defn update-uniform-buffer [eng ub data]
    (WGPURender.update-uniform-buffer- @(Engine.ctx eng) ub (WGPU.array->ptr data) (Uint64.from-long (Long.from-int (* (Array.length data) 4)))))

  (defn create-bind-group [eng pipeline uniform-buffer]
    (WGPURender.create-render-uniform-bind-group @(Engine.ctx eng) pipeline uniform-buffer))

(deftemplate create-simulation-bind-group-raw
  (Fn [(Ptr WGPUContext)
       WGPUComputePipeline
       WGPUBuffer
       WGPUBuffer
       WGPUBuffer
       WGPUBuffer
       WGPUBuffer
       (Ptr WGPURenderTexture)
       (Ptr WGPURenderTexture)
       (Ptr WGPURenderTexture)
       (Ptr WGPURenderTexture)
       ] WGPUBindGroup)
  "WGPUBindGroup $NAME(WGPUContext* ctx, WGPUComputePipeline pipe, WGPUBuffer in_buf, WGPUBuffer out_buf, WGPUBuffer ub, WGPUBuffer solid_buf, WGPUBuffer lookup_buf, WGPURenderTexture* solid_tex, WGPURenderTexture* liquid_tex, WGPURenderTexture* gas_tex, WGPURenderTexture* stress_tex)"
  "$DECL {
      if (!ctx || !pipe || !in_buf || !out_buf || !ub || !solid_buf || !lookup_buf || !solid_tex || !liquid_tex || !gas_tex || !stress_tex) {
          return NULL;
      }
      WGPUBindGroupLayout layout = wgpuComputePipelineGetBindGroupLayout(pipe, 0);
      if (!layout) {
          return NULL;
      }
      WGPUBindGroupEntry entries[9] = {
          { .binding = 0, .buffer = in_buf, .offset = 0, .size = WGPU_WHOLE_SIZE },
          { .binding = 1, .buffer = out_buf, .offset = 0, .size = WGPU_WHOLE_SIZE },
          { .binding = 2, .buffer = ub, .offset = 0, .size = WGPU_WHOLE_SIZE },
          { .binding = 3, .buffer = solid_buf, .offset = 0, .size = WGPU_WHOLE_SIZE },
          { .binding = 4, .buffer = lookup_buf, .offset = 0, .size = WGPU_WHOLE_SIZE },
          { .binding = 5, .textureView = solid_tex->view },
          { .binding = 6, .textureView = liquid_tex->view },
          { .binding = 7, .textureView = gas_tex->view },
          { .binding = 8, .textureView = stress_tex->view }
      };
      WGPUBindGroupDescriptor desc = {
          .layout     = layout,
          .entryCount = 9,
          .entries    = entries,
      };
      WGPUBindGroup bg = wgpuDeviceCreateBindGroup(ctx->device, &desc);
      wgpuBindGroupLayoutRelease(layout);
      return bg;
  }")

  (defn create-simulation-bind-group [ctx pipeline in-buf out-buf ub solid-buf lookup-buf solid-tex liquid-tex gas-tex stress-tex]
    (let [bg (create-simulation-bind-group-raw ctx pipeline in-buf out-buf ub solid-buf lookup-buf solid-tex liquid-tex gas-tex stress-tex)]
      (if (WGPURender.bindgroup-null?- bg)
        (Result.Error @"Failed to create simulation bind group")
        (Result.Success bg))))

  (defn create-voxel-bind-group [eng pipeline solid-tex liquid-tex gas-tex light-tex stress-tex sampler uniforms]
    (let [bg (create-voxel-scaffold-bind-group @(Engine.ctx eng) pipeline solid-tex liquid-tex gas-tex light-tex stress-tex sampler uniforms)]
      (if (WGPURender.bindgroup-null?- bg)
        (Result.Error @"Failed to create voxel scaffold bind group")
        (Result.Success bg))))

  (defn free-bind-group [bg]
    (WGPURender.free-bind-group bg))

  (defn free-pipeline [pipe]
    (WGPURender.free-pipeline pipe))

  (defn free-uniform-buffer [ub]
    (WGPURender.free-uniform-buffer ub))

  (defn cleanup [eng]
    (do
      (WGPURender.free-surface @(Engine.surf &eng))
      (GLFW.destroy-window @(Engine.win &eng))
      (GLFW.terminate)
      (WGPU.free-context @(Engine.ctx &eng))))
)

(defmodule WGPUVertexBufferWrapper
  (deftemplate get-buffer (Fn [(Ptr WGPUVertexBufferWrapper)] WGPUBuffer)
    "WGPUBuffer $NAME(WGPUVertexBufferWrapper* vb)"
    "$DECL { return vb->buffer; }")
  (deftemplate update-offset (Fn [(Ptr WGPUContext) (Ptr WGPUVertexBufferWrapper) Uint64 (Ptr Float) Uint64] ())
    "void $NAME(WGPUContext* ctx, WGPUVertexBufferWrapper* vb, uint64_t offset, float* data, uint64_t size)"
    "$DECL { wgpuQueueWriteBuffer(ctx->queue, vb->buffer, offset, data, size); }")
  (deftemplate create-empty-storage-vertex-buffer- (Fn [(Ptr WGPUContext) Uint64] (Ptr WGPUVertexBufferWrapper))
    "WGPUVertexBufferWrapper* $NAME(WGPUContext* ctx, uint64_t size)"
    "$DECL { return wgpu_create_storage_vertex_buffer(ctx, NULL, size); }")

  (defn create-empty-storage-vertex-buffer [ctx size]
    (let [vb (create-empty-storage-vertex-buffer- ctx (Uint64.from-long (Long.from-int size)))]
      (if (WGPURender.vertex-buffer-null?- vb)
        (Result.Error (WGPURender.get-error))
        (Result.Success vb))))
)


(load "GLFW.carp")
(load "WGPURender.carp")

(deftemplate glfw-window->voidptr (Fn [(Ptr GLFWwindow)] (Ptr ()))
  "void* $NAME(GLFWwindow* w)"
  "$DECL { return (void*)w; }")

(deftemplate ref-to-ptr (Fn [(Ref a)] (Ptr a))
  "void* $NAME(void* r)"
  "$DECL { return r; }")


(deftemplate js-globals-setup (Fn [] ())
  "#ifndef JS_GLOBALS_DEFINED
   #define JS_GLOBALS_DEFINED
   float js_brush_radius = 3.0f;
   float js_solid_mat = 2.0f;
   float js_liq_mat = 1.0f;
   float js_gas_mat = 1.0f;
   float js_flying = 1.0f;
   float js_flashlight = 1.0f;
   int js_rig_slot = 0;

   typedef struct {
       WGPUBindGroupEntry entries[16];
       int count;
   } C_Builder;




   #ifdef __EMSCRIPTEN__
   #include <emscripten.h>
   EMSCRIPTEN_KEEPALIVE void set_brush_radius(float r) { js_brush_radius = r; }
   EMSCRIPTEN_KEEPALIVE void set_solid_mat(float m) { js_solid_mat = m; }
   EMSCRIPTEN_KEEPALIVE void set_liq_mat(float m) { js_liq_mat = m; }
   EMSCRIPTEN_KEEPALIVE void set_gas_mat(float m) { js_gas_mat = m; }
   EMSCRIPTEN_KEEPALIVE void set_flying(float f) { js_flying = f; }
   EMSCRIPTEN_KEEPALIVE void set_flashlight(float f) { js_flashlight = f; }
   EMSCRIPTEN_KEEPALIVE void set_rig_slot(int s) { if (s >= 0 && s <= 4) js_rig_slot = s; }
   #endif
   #endif

   void $NAME(void)"
  "$DECL {}")

(deftemplate js-sync-all (Fn [Float Float Float Float Float Float] ())
  "void $NAME(float r, float s, float l, float g, float fly, float light)"
  "$DECL {
#ifdef __EMSCRIPTEN__
      char buf[512];
      sprintf(buf, \"window.player_brush_radius = %f; window.player_solid_mat = %f; window.player_liq_mat = %f; window.player_gas_mat = %f; window.player_flying = %f > 0.5; window.player_flashlight = %f > 0.5; if (window.sync_ui) window.sync_ui();\", r, s, l, g, fly, light);
      emscripten_run_script(buf);
#endif
  }")

(deftemplate js-sync-rig (Fn [Int Float Float Float Float Float Float Float Float Float Float] ())
  "void $NAME(int slot, float sm, float sf, float lm, float lf, float gm, float gf, float gmat, float mode, float probe, float pstress)"
  "$DECL {
#ifdef __EMSCRIPTEN__
      static int prev_slot = -1;
      static float p_sm = -1.0f, p_sf = -1.0f, p_lm = -1.0f, p_lf = -1.0f, p_gm = -1.0f, p_gf = -1.0f, p_gmat = -1.0f, p_mode = -9.0f, p_probe = -1.0f, p_st = -1.0f;
      float dsf = sf - p_sf; if (dsf < 0.0f) dsf = -dsf;
      float dlf = lf - p_lf; if (dlf < 0.0f) dlf = -dlf;
      float dgf = gf - p_gf; if (dgf < 0.0f) dgf = -dgf;
      float dsm = sm - p_sm; if (dsm < 0.0f) dsm = -dsm;
      float dlm = lm - p_lm; if (dlm < 0.0f) dlm = -dlm;
      float dgm = gm - p_gm; if (dgm < 0.0f) dgm = -dgm;
      float dgmat = gmat - p_gmat; if (dgmat < 0.0f) dgmat = -dgmat;
      float dmode = mode - p_mode; if (dmode < 0.0f) dmode = -dmode;
      float dprobe = probe - p_probe; if (dprobe < 0.0f) dprobe = -dprobe;
      float dst = pstress - p_st; if (dst < 0.0f) dst = -dst;
      if (slot == prev_slot && dsm < 0.05f && dsf < 0.004f && dlm < 0.05f && dlf < 0.004f && dgm < 0.05f && dgf < 0.004f && dgmat < 0.05f && dmode < 0.05f && dprobe < 0.05f && dst < 0.02f) return;
      prev_slot = slot; p_sm = sm; p_sf = sf; p_lm = lm; p_lf = lf; p_gm = gm; p_gf = gf; p_gmat = gmat; p_mode = mode; p_probe = probe; p_st = pstress;
      char buf[384];
      sprintf(buf, \"if (window.sync_rig) window.sync_rig(%d, %.1f, %.4f, %.1f, %.4f, %.1f, %.4f, %.1f, %.2f, %.1f, %.3f);\", slot, sm, sf, lm, lf, gm, gf, gmat, mode, probe, pstress);
      emscripten_run_script(buf);
#endif
  }")

(deftemplate js-sync-match (Fn [Int Float] ())
  "void $NAME(int lit_count, float flash_state)"
  "$DECL {
#ifdef __EMSCRIPTEN__
      static int prev_lit = -1;
      static float prev_flash = -9.0f;
      float df = flash_state - prev_flash; if (df < 0.0f) df = -df;
      if (lit_count == prev_lit && df < 0.05f) return;
      prev_lit = lit_count; prev_flash = flash_state;
      char buf[160];
      sprintf(buf, \"if (window.sync_matchbox) window.sync_matchbox(%d, %.2f);\", lit_count, flash_state);
      emscripten_run_script(buf);
#endif
  }")

(deftemplate js-sync-wand (Fn [Int Int Float Int] ())
  "void $NAME(int slot, int wand_idx, float mana_frac, int cast_state)"
  "$DECL {
#ifdef __EMSCRIPTEN__
      static int prev_slot = -1;
      static int prev_wand = -1;
      static int prev_state = -9;
      static float prev_mana = -1.0f;
      float dm = mana_frac - prev_mana; if (dm < 0.0f) dm = -dm;
      if (slot == prev_slot && wand_idx == prev_wand && cast_state == prev_state && dm < 0.005f) return;
      prev_slot = slot; prev_wand = wand_idx; prev_state = cast_state; prev_mana = mana_frac;
      char buf[192];
      sprintf(buf, \"if (window.sync_wand) window.sync_wand(%d, %d, %.4f, %d);\", slot, wand_idx, mana_frac, cast_state);
      emscripten_run_script(buf);
#endif
  }")

(deftemplate get-js-brush-radius (Fn [] Float) "float $NAME(void)" "$DECL { return js_brush_radius; }")
(deftemplate get-js-solid-mat (Fn [] Float) "float $NAME(void)" "$DECL { return js_solid_mat; }")
(deftemplate get-js-liq-mat (Fn [] Float) "float $NAME(void)" "$DECL { return js_liq_mat; }")
(deftemplate get-js-gas-mat (Fn [] Float) "float $NAME(void)" "$DECL { return js_gas_mat; }")
(deftemplate get-js-flying (Fn [] Float) "float $NAME(void)" "$DECL { return js_flying; }")
(deftemplate get-js-flashlight (Fn [] Float) "float $NAME(void)" "$DECL { return js_flashlight; }")
(deftemplate get-js-rig-slot (Fn [] Int) "int $NAME(void)" "$DECL { return js_rig_slot; }")

(deftemplate set-js-brush-radius (Fn [Float] ()) "void $NAME(float r)" "$DECL { js_brush_radius = r; }")
(deftemplate set-js-solid-mat (Fn [Float] ()) "void $NAME(float m)" "$DECL { js_solid_mat = m; }")
(deftemplate set-js-liq-mat (Fn [Float] ()) "void $NAME(float m)" "$DECL { js_liq_mat = m; }")
(deftemplate set-js-gas-mat (Fn [Float] ()) "void $NAME(float m)" "$DECL { js_gas_mat = m; }")
(deftemplate set-js-flying (Fn [Float] ()) "void $NAME(float f)" "$DECL { js_flying = f; }")
(deftemplate set-js-flashlight (Fn [Float] ()) "void $NAME(float f)" "$DECL { js_flashlight = f; }")
(deftemplate set-js-rig-slot (Fn [Int] ()) "void $NAME(int s)" "$DECL { if (s >= 0 && s <= 4) js_rig_slot = s; }")

(register-type GLFWwindow)

(deftemplate create-voxel-scaffold-bind-group (Fn [(Ptr WGPUContext) (Ptr WGPURenderPipelineWrapper) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) WGPUSampler (Ptr WGPUUniformBufferWrapper) (Ptr WGPUVertexBufferWrapper) (Ptr WGPUVertexBufferWrapper)] WGPUBindGroup)
  "WGPUBindGroup $NAME(WGPUContext* ctx, WGPURenderPipelineWrapper* pipe, WGPURenderTexture* solid_tex, WGPURenderTexture* liquid_tex, WGPURenderTexture* gas_tex, WGPURenderTexture* light_tex, WGPUSampler sampler, WGPUUniformBufferWrapper* ub, WGPUVertexBufferWrapper* mat_buf, WGPUVertexBufferWrapper* entities_buf)"
  "$DECL {
      if (!ctx || !pipe || !solid_tex || !liquid_tex || !gas_tex || !light_tex || !sampler || !ub || !mat_buf || !entities_buf) {
          return NULL;
      }
      WGPUBindGroupLayout layout = wgpuRenderPipelineGetBindGroupLayout(pipe->pipeline, 0);
      if (!layout) {
          return NULL;
      }
      WGPUBindGroupEntry entries[8] = {
          {
              .binding = 0,
              .buffer  = ub->buffer,
              .offset  = 0,
              .size    = ub->size,
          },
          {
              .binding     = 1,
              .textureView = solid_tex->view,
          },
          {
              .binding = 2,
              .sampler = sampler,
          },
          {
              .binding     = 3,
              .textureView = liquid_tex->view,
          },
          {
              .binding     = 4,
              .textureView = gas_tex->view,
          },
          {
              .binding     = 5,
              .textureView = light_tex->view,
          },
          {
              .binding     = 6,
              .buffer      = mat_buf->buffer,
              .offset      = 0,
              .size        = mat_buf->size,
          },
          {
              .binding     = 7,
              .buffer      = entities_buf->buffer,
              .offset      = 0,
              .size        = entities_buf->size,
          }
      };
      WGPUBindGroupDescriptor desc = {
          .layout     = layout,
          .entryCount = 8,
          .entries    = entries,
      };
      WGPUBindGroup bg = wgpuDeviceCreateBindGroup(ctx->device, &desc);
      wgpuBindGroupLayoutRelease(layout);
      return bg;
  }")


(deftemplate create-raycast-bind-group-with-entities (Fn [(Ptr WGPUContext) WGPUComputePipeline WGPUBuffer WGPUBuffer WGPUBuffer WGPUBuffer WGPUBuffer (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) WGPUBuffer] WGPUBindGroup)
  "WGPUBindGroup $NAME(WGPUContext* ctx, WGPUComputePipeline pipe, WGPUBuffer input_buf, WGPUBuffer output_buf, WGPUBuffer uniform_buf, WGPUBuffer chunk_info_buf, WGPUBuffer chunk_lookup_buf, WGPURenderTexture* voxel_tex, WGPURenderTexture* water_tex, WGPURenderTexture* gas_tex, WGPUBuffer entities_buf)"
  "$DECL {
      if (!ctx || !pipe || !input_buf || !output_buf || !uniform_buf || !chunk_info_buf || !chunk_lookup_buf || !voxel_tex || !water_tex || !gas_tex || !entities_buf) {
          return NULL;
      }
      WGPUBindGroupLayout layout = wgpuComputePipelineGetBindGroupLayout(pipe, 0);
      if (!layout) {
          return NULL;
      }
      WGPUBindGroupEntry entries[9];
      entries[0] = (WGPUBindGroupEntry){ .binding = 0, .buffer = input_buf, .offset = 0, .size = wgpuBufferGetSize(input_buf) };
      entries[1] = (WGPUBindGroupEntry){ .binding = 1, .buffer = output_buf, .offset = 0, .size = wgpuBufferGetSize(output_buf) };
      entries[2] = (WGPUBindGroupEntry){ .binding = 2, .buffer = uniform_buf, .offset = 0, .size = wgpuBufferGetSize(uniform_buf) };
      entries[3] = (WGPUBindGroupEntry){ .binding = 3, .buffer = chunk_info_buf, .offset = 0, .size = wgpuBufferGetSize(chunk_info_buf) };
      entries[4] = (WGPUBindGroupEntry){ .binding = 4, .buffer = chunk_lookup_buf, .offset = 0, .size = wgpuBufferGetSize(chunk_lookup_buf) };
      entries[5] = (WGPUBindGroupEntry){ .binding = 5, .textureView = voxel_tex->view };
      entries[6] = (WGPUBindGroupEntry){ .binding = 6, .textureView = water_tex->view };
      entries[7] = (WGPUBindGroupEntry){ .binding = 7, .textureView = gas_tex->view };
      entries[8] = (WGPUBindGroupEntry){ .binding = 8, .buffer = entities_buf, .offset = 0, .size = wgpuBufferGetSize(entities_buf) };
      
      WGPUBindGroupDescriptor desc = {
          .layout     = layout,
          .entryCount = 9,
          .entries    = entries,
      };
      WGPUBindGroup bg = wgpuDeviceCreateBindGroup(ctx->device, &desc);
      wgpuBindGroupLayoutRelease(layout);
      return bg;
  }")





;; --- BindGroupBuilder ---
(deftype Builder [p (Ptr ())])

(deftemplate builder-new (Fn [] (Ptr ()))
  "void* $NAME()"
  "$DECL {
      C_Builder* b = (C_Builder*)malloc(sizeof(C_Builder));
      b->count = 0;
      return (void*)b;
  }")

(deftemplate builder-free (Fn [(Ptr ())] ())
  "void $NAME(void* b_ptr)"
  "$DECL {
      C_Builder* b = (C_Builder*)b_ptr;
      if (b) free(b);
  }")

(deftemplate builder-add-buffer (Fn [(Ptr ()) WGPUBuffer] ())
  "void $NAME(void* b_ptr, WGPUBuffer buf)"
  "$DECL {
      C_Builder* b = (C_Builder*)b_ptr;
      if (!b || b->count >= 16) return;
      b->entries[b->count] = (WGPUBindGroupEntry){
          .binding = b->count,
          .buffer = buf,
          .offset = 0,
          .size = wgpuBufferGetSize(buf)
      };
      b->count++;
  }")

(deftemplate builder-add-texture (Fn [(Ptr ()) (Ptr WGPURenderTexture)] ())
  "void $NAME(void* b_ptr, WGPURenderTexture* tex)"
  "$DECL {
      C_Builder* b = (C_Builder*)b_ptr;
      if (!b || !tex || b->count >= 16) return;
      b->entries[b->count] = (WGPUBindGroupEntry){
          .binding = b->count,
          .textureView = tex->view
      };
      b->count++;
  }")

(deftemplate builder-add-sampler (Fn [(Ptr ()) WGPUSampler] ())
  "void $NAME(void* b_ptr, WGPUSampler samp)"
  "$DECL {
      C_Builder* b = (C_Builder*)b_ptr;
      if (!b || b->count >= 16) return;
      b->entries[b->count] = (WGPUBindGroupEntry){
          .binding = b->count,
          .sampler = samp
      };
      b->count++;
  }")

(deftemplate builder-build-compute (Fn [(Ptr WGPUContext) WGPUComputePipeline (Ptr ())] WGPUBindGroup)
  "WGPUBindGroup $NAME(WGPUContext* ctx, WGPUComputePipeline pipe, void* b_ptr)"
  "$DECL {
      C_Builder* b = (C_Builder*)b_ptr;
      if (!ctx || !pipe || !b) return NULL;
      WGPUBindGroupLayout layout = wgpuComputePipelineGetBindGroupLayout(pipe, 0);
      WGPUBindGroupDescriptor desc = {
          .layout = layout,
          .entryCount = b->count,
          .entries = b->entries,
      };
      WGPUBindGroup bg = wgpuDeviceCreateBindGroup(ctx->device, &desc);
      wgpuBindGroupLayoutRelease(layout);
      return bg;
  }")
  
(deftemplate builder-build-render (Fn [(Ptr WGPUContext) WGPURenderPipeline (Ptr ())] WGPUBindGroup)
  "WGPUBindGroup $NAME(WGPUContext* ctx, WGPURenderPipeline pipe, void* b_ptr)"
  "$DECL {
      C_Builder* b = (C_Builder*)b_ptr;
      if (!ctx || !pipe || !b) return NULL;
      WGPUBindGroupLayout layout = wgpuRenderPipelineGetBindGroupLayout(pipe, 0);
      WGPUBindGroupDescriptor desc = {
          .layout = layout,
          .entryCount = b->count,
          .entries = b->entries,
      };
      WGPUBindGroup bg = wgpuDeviceCreateBindGroup(ctx->device, &desc);
      wgpuBindGroupLayoutRelease(layout);
      return bg;
  }")
;; ------------------------
(deftype M-WGPUContext [p (Ptr WGPUContext)])
(defmodule M-WGPUContext
  (defn delete [x] (WGPU.free-context @(M-WGPUContext.p x))))
(implements delete M-WGPUContext.delete)

(deftype M-GLFWWindow [p (Ptr GLFWwindow)])
(defmodule M-GLFWWindow
  (defn delete [x]
    (do
      (GLFW.destroy-window @(M-GLFWWindow.p x))
      (GLFW.terminate))))
(implements delete M-GLFWWindow.delete)

(deftype M-WGPUSurface [p (Ptr WGPURenderSurface)])
(defmodule M-WGPUSurface
  (defn delete [x] (WGPURender.free-surface @(M-WGPUSurface.p x))))
(implements delete M-WGPUSurface.delete)

(deftype Engine [
  ctx M-WGPUContext
  win M-GLFWWindow
  surf M-WGPUSurface
  width Int
  height Int
  start-time Double
])
(defmodule Engine
  (defn create [title init-w init-h]
    (result-do [
      c-ptr (match (WGPU.create-context)
              (Result.Error e) (Result.Error (str* "GPU context creation failed: " e))
              (Result.Success c) (Result.Success c))
      ctx (Result.Success (M-WGPUContext.init c-ptr))
      _ (if (= (GLFW.init) GLFW.FALSE)
          (Result.Error @"GLFW init failed")
          (Result.Success ()))
      w-ptr (do
              (GLFW.window-hint GLFW.CLIENT_API GLFW.NO_API)
              (let [w (GLFW.create-window init-w init-h (String.cstr title) NULL NULL)]
                (if (null? w)
                  (Result.Error @"Failed to create GLFW window")
                  (Result.Success w))))
      win (Result.Success (M-GLFWWindow.init w-ptr))
      s-ptr (match (WGPURender.create-surface c-ptr (glfw-window->voidptr w-ptr) init-w init-h)
               (Result.Error e) (Result.Error (str* "Surface failed: " e))
               (Result.Success s) (Result.Success s))
      surf (Result.Success (M-WGPUSurface.init s-ptr))]
      (Result.Success (Engine.init ctx win surf init-w init-h (GLFW.get-time)))))

  (defn should-close? [eng]
    (= (GLFW.window-should-close @(M-GLFWWindow.p (Engine.win eng))) GLFW.TRUE))

  (defn update-time [eng]
    (Double.to-float (- (GLFW.get-time) @(Engine.start-time eng))))

  (defn poll-events [eng]
    (GLFW.poll-events))

  (defn handle-resize [eng]
    (let [win @(M-GLFWWindow.p (Engine.win eng))
          ctx @(M-WGPUContext.p (Engine.ctx eng))
          surf @(M-WGPUSurface.p (Engine.surf eng))
          w 0
          h 0]
      (do
        (GLFW.get-framebuffer-size win (ref-to-ptr &w) (ref-to-ptr &h))
        (when (or (/= w @(Engine.width eng)) (/= h @(Engine.height eng)))
          (do
            (WGPURender.resize-surface surf ctx w h)
            (Engine.set-width! eng w)
            (Engine.set-height! eng h))))))

  (defn begin-frame [eng]
    (let [surf @(M-WGPUSurface.p (Engine.surf eng))
          ctx @(M-WGPUContext.p (Engine.ctx eng))]
      (match (WGPURender.begin-frame surf ctx)
        (Result.Error _e) (Maybe.Nothing)
        (Result.Success frame) (Maybe.Just frame))))

  (defn end-frame [eng frame]
    (let [surf @(M-WGPUSurface.p (Engine.surf eng))
          ctx @(M-WGPUContext.p (Engine.ctx eng))]
      (do
        (WGPURender.end-frame frame surf ctx)
        (WGPURender.free-frame frame))))

  (defn create-pipeline [eng wgsl vs-entry fs-entry]
    (WGPURender.create-pipeline @(M-WGPUContext.p (Engine.ctx eng)) wgsl vs-entry fs-entry &(WGPURender.surface-format @(M-WGPUSurface.p (Engine.surf eng)))))

  (defn create-uniform-buffer [eng size]
    (WGPURender.create-uniform-buffer @(M-WGPUContext.p (Engine.ctx eng)) size))

  (defn update-uniform-buffer [eng ub data]
    (WGPURender.update-uniform-buffer- @(M-WGPUContext.p (Engine.ctx eng)) ub (WGPU.array->ptr data) (Uint64.from-long (Long.from-int (* (Array.length data) 4)))))

  (defn create-bind-group [eng pipeline uniform-buffer]
    (WGPURender.create-render-uniform-bind-group @(M-WGPUContext.p (Engine.ctx eng)) pipeline uniform-buffer))

  (defn create-voxel-bind-group [eng pipeline solid-tex liquid-tex gas-tex light-tex sampler uniforms mat-buf entities-buf]
    (let [bg (create-voxel-scaffold-bind-group @(M-WGPUContext.p (Engine.ctx eng)) pipeline solid-tex liquid-tex gas-tex light-tex sampler uniforms mat-buf entities-buf)]
      (if (WGPURender.bindgroup-null?- bg)
        (Result.Error @"Failed to create voxel scaffold bind group")
        (Result.Success bg))))

  (defn free-bind-group [bg]
    (WGPURender.free-bind-group bg))

  (defn free-pipeline [pipe]
    (WGPURender.free-pipeline pipe))

  (defn free-uniform-buffer [ub]
    (WGPURender.free-uniform-buffer ub))


)

(defmodule WGPUVertexBufferWrapper
  (deftemplate get-buffer (Fn [(Ptr WGPUVertexBufferWrapper)] WGPUBuffer)
    "WGPUBuffer $NAME(WGPUVertexBufferWrapper* vb)"
    "$DECL { return vb->buffer; }")
  (deftemplate update-offset (Fn [(Ptr WGPUContext) (Ptr WGPUVertexBufferWrapper) Uint64 (Ptr Float) Uint64] ())
    "void $NAME(WGPUContext* ctx, WGPUVertexBufferWrapper* vb, uint64_t offset, float* data, uint64_t size)"
    "$DECL { wgpuQueueWriteBuffer(ctx->queue, vb->buffer, offset, data, size); }")
)


(deftemplate set-emscripten-main-loop-arg (Fn [(Ptr ()) (Ptr ())] ())
  "void $NAME(void* func, void* arg)"
  "$DECL {
#ifdef __EMSCRIPTEN__
    emscripten_set_main_loop_arg((em_arg_callback_func)func, arg, 0, 1);
#endif
  }")


(deftemplate alloc-state (Fn [EngineState] (Ptr EngineState))
  "EngineState* $NAME(EngineState state)"
  "$DECL { EngineState* ptr = malloc(sizeof(EngineState)); *ptr = state; return ptr; }")

(deftemplate c-loop-callback (Fn [] (Ptr ()))
  "void* $NAME()"
  "$DECL { 
     extern void main_MINUS_loop_MINUS_tick(EngineState*);
     return (void*)main_MINUS_loop_MINUS_tick; 
  }")


(deftemplate start-main-loop (Fn [(Ptr EngineState)] ())
  "void $NAME(EngineState* state)"
  "$DECL {
#ifdef __EMSCRIPTEN__
    extern void main_MINUS_loop_MINUS_tick(EngineState*);
    emscripten_set_main_loop_arg((em_arg_callback_func)main_MINUS_loop_MINUS_tick, state, 0, 1);
#endif
  }")

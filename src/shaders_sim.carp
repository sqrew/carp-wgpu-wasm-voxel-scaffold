")

(def liquid-sim-wgsl
  (String.append wgsl-tag-constants "
struct LiquidProps {
    density: f32,
    g_rate: f32,
    l_rate: f32,
}

fn get_liq_props(id: f32) -> LiquidProps {
    if (id < 0.5) { return LiquidProps(0.0, 0.0, 0.0); }
    let mat_id = clamp(u32(round(id)), 0u, 255u);
    let idx = (256u + mat_id) * 8u;
    let density = bitcast<f32>(registry_data[idx + 5u]);
    let tags = registry_data[idx + 7u];
    
    var g = min(1.0, 0.4 / max(density, 0.1));
    var l = min(1.0, 0.2 / max(density, 0.1));
    let t_rate = abs(g) + 4.0 * l;
    if (t_rate > 1.0) {
        g = g / t_rate;
        l = l / t_rate;
    }
    if ((tags & TAG_STICKY) != 0u) {
        g = g * 0.05;
        l = l * 0.02;
    }
    return LiquidProps(density, g, l);
}

@group(0) @binding(0) var<storage, read>       input_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> output_buffer: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> solid_buffer: array<vec4<f32>>;
@group(0) @binding(4) var<storage, read>       registry_data: array<u32>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;
@group(0) @binding(8) var vel_texture:         texture_3d<f32>;

fn positive_mod(n: i32, m: i32) -> i32 {
    let r = n % m;
    if (r < 0) {
        return r + m;
    }
    return r;
}

fn get_win_min() -> vec3<i32> {
    let cx = i32(floor(u.cam_pos.x / 32.0)) - 2;
    let cy = i32(floor(u.cam_pos.y / 32.0)) - 2;
    let cz = i32(floor(u.cam_pos.z / 32.0)) - 2;
    return vec3<i32>(
        positive_mod(cx, 5) * 32,
        positive_mod(cy, 5) * 32,
        positive_mod(cz, 5) * 32
    );
}

fn step_in_window(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let lp = (base_ip - win_min + vec3<i32>(160)) % 160;
    let nlp = lp + delta;
    return nlp.x >= 0 && nlp.x < 160 && nlp.y >= 0 && nlp.y < 160 && nlp.z >= 0 && nlp.z < 160;
}

fn get_solid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(255.0, -1.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(solid_texture, wrapped, 0);
}

fn is_solid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let sol = get_solid(base_ip, delta, win_min);
    return sol.y * 0.5 < 0.008;
}

fn get_liquid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0, 0.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(liquid_texture, wrapped, 0);
}

fn get_gas(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0, 0.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(gas_texture, wrapped, 0);
}

fn get_vel(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(vel_texture, wrapped, 0);
}

fn has_law_tg_liq() -> bool {
    for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
        if (u.mancer_pos[mk].w > 0.05 && u.mancer_mat[mk].x >= 768.5) {
            let m_id = i32(round(u.mancer_mat[mk].x));
            if (m_id == 771 || m_id == 772) { return true; }
            if (m_id >= 780 && m_id <= 815) {
                let pair = m_id - 780;
                let l0 = pair / 6;
                let l1 = pair % 6;
                if (l0 == 2 || l0 == 3 || l1 == 2 || l1 == 3) { return true; }
            }
        }
    }
    return false;
}

fn eval_law_tg_liq(world_p: vec3<f32>, active_tg: bool) -> vec2<f32> {
    if (!active_tg) { return vec2<f32>(0.50, 0.50); }
    var tau: f32 = 0.50;
    var g_val: f32 = 0.50;
    for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
        let mp = u.mancer_pos[mk];
        let mm = u.mancer_mat[mk];
        if (mp.w > 0.05 && mm.x >= 768.5) {
            let m_id = i32(round(mm.x));
            var l0: i32 = -1;
            var l1: i32 = -1;
            if (m_id >= 769 && m_id <= 774) { l0 = m_id - 769; }
            else if (m_id >= 780 && m_id <= 815) {
                let pair = m_id - 780;
                l0 = pair / 6;
                l1 = pair % 6;
            }
            let dome_r = max(5.4, abs(mm.z) + 1.5);
            let dm = distance(world_p, mp.xyz);
            if (dm < dome_r) {
                let s_d = clamp(1.2 - dm / dome_r, 0.55, 1.0);
                let pol = select(mm.w, sign(mm.z), abs(mm.z) > 0.15);
                if (l0 == 2 || l1 == 2) {
                    g_val = select(min(g_val, mix(0.50, 0.04, s_d)), max(g_val, mix(0.50, 0.96, s_d)), pol >= 0.0);
                }
                if (l0 == 3 || l1 == 3) {
                    tau = select(min(tau, mix(0.50, 0.03, s_d)), max(tau, mix(0.50, 0.96, s_d)), pol >= 0.0);
                }
            }
        }
    }
    return vec2<f32>(tau, g_val);
}

fn get_world_pos(ip: vec3<i32>, cam_pos: vec3<f32>) -> vec3<f32> {
    let cx = i32(floor(cam_pos.x / 32.0));
    let cy = i32(floor(cam_pos.y / 32.0));
    let cz = i32(floor(cam_pos.z / 32.0));
    
    let offset_cx = cx - 2;
    let offset_cy = cy - 2;
    let offset_cz = cz - 2;
    
    let slot_x = ip.x / 32;
    let slot_y = ip.y / 32;
    let slot_z = ip.z / 32;
    
    let lx = ip.x % 32;
    let ly = ip.y % 32;
    let lz = ip.z % 32;
    
    let qx = offset_cx + positive_mod(slot_x - positive_mod(offset_cx, 5), 5);
    let qy = offset_cy + positive_mod(slot_y - positive_mod(offset_cy, 5), 5);
    let qz = offset_cz + positive_mod(slot_z - positive_mod(offset_cz, 5), 5);
    
    let gx = qx * 32 + lx;
    let gy = qy * 32 + ly;
    let gz = qz * 32 + lz;
    
    return vec3<f32>(f32(gx), f32(gy), f32(gz));
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    // Dummy reads to prevent compiler from optimizing out unused bindings
    let dummy_val = input_buffer[0] + solid_buffer[0] + vec4<f32>(bitcast<f32>(registry_data[0])) + textureLoad(vel_texture, vec3<i32>(0), 0);
    if (dummy_val.x > 999999.0) {
        output_buffer[idx] = textureLoad(gas_texture, vec3<i32>(0), 0);
    }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));
    let win_min = get_win_min();
    let lp = (ip - win_min + vec3<i32>(160)) % 160;
    let zero_d = vec3<i32>(0, 0, 0);

    let sol_val = get_solid(ip, zero_d, win_min);
    let sol_id = sol_val.x;
    let is_sol_block = sol_val.y * 0.5 < 0.008;
    let rx_hash_l = fract(sin(dot(vec3<f32>(ip), vec3<f32>(12.9898, 78.233, 37.719)) + floor(u.time * 60.0) * 1.17) * 43758.5453);
    if (is_sol_block) {
        // Solid -> Liquid Hand-Off: if this solid voxel is melting/reacting into a Liquid (256 <= rx.x < 512), spawn that liquid!
        var melt_liq_id = 0.0;
        if (abs(sol_id) > 0.5 && abs(sol_id) != 255.0) {
            let s_id_u = clamp(u32(round(abs(sol_id))), 0u, 255u);
            let s_tough = bitcast<f32>(registry_data[s_id_u * 8u + 6u]);
            let rx_prob = clamp(1.25 / max(s_tough, 0.8), 0.12, 1.0);
            if (rx_hash_l < rx_prob) {
                let s_dirs = array<vec3<i32>, 6>(
                    vec3<i32>(1,0,0), vec3<i32>(-1,0,0),
                    vec3<i32>(0,1,0), vec3<i32>(0,-1,0),
                    vec3<i32>(0,0,1), vec3<i32>(0,0,-1)
                );
                for (var si = 0u; si < 6u; si++) {
                    let sd = s_dirs[si];
                    if (!step_in_window(ip, sd, win_min)) { continue; }
                    let ns = get_solid(ip, sd, win_min);
                    if (ns.y <= 0.0 && abs(ns.x) > 0.5) {
                        let rx = get_reaction(abs(sol_id), 0u, abs(ns.x), 0u);
                        if (rx.x >= 256.0 && rx.x < 512.0) { melt_liq_id = rx.x - 256.0; break; }
                    }
                    let nl = get_liquid(ip, sd, win_min);
                    if (nl.y > 0.05 && nl.x > 0.5) {
                        let rx = get_reaction(abs(sol_id), 0u, nl.x, 256u);
                        if (rx.x >= 256.0 && rx.x < 512.0) { melt_liq_id = rx.x - 256.0; break; }
                    }
                    let ng = get_gas(ip, sd, win_min);
                    if (ng.y > 0.05 && ng.x > 0.5) {
                        let rx = get_reaction(abs(sol_id), 0u, ng.x, 512u);
                        if (rx.x >= 256.0 && rx.x < 512.0) { melt_liq_id = rx.x - 256.0; break; }
                    }
                }
            }
        }
        if (melt_liq_id > 0.5) {
            output_buffer[idx] = vec4<f32>(melt_liq_id, 0.95, 0.0, 0.0);
        } else {
            output_buffer[idx] = vec4<f32>(0.0);
        }
        return;
    }

    let self_liq = get_liquid(ip, zero_d, win_min);
    let self_vol = self_liq.y;
    let self_vel = get_vel(ip, zero_d, win_min);
    let self_v2 = dot(self_vel.xyz, self_vel.xyz);
    let active_tg = has_law_tg_liq();
    let wp_self = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
    let tg_self = eval_law_tg_liq(wp_self, active_tg);
    var next_id = self_liq.x;
    var next_vol = self_vol;
    var next_age = self_liq.z;
    var next_sleep = self_liq.w;
    
    if (next_sleep >= 10.0 && self_liq.z < 0.01 && self_v2 < 0.0005 && abs(self_vel.w) < 0.5) {
        let l1 = get_liquid(ip, vec3<i32>(-1,0,0), win_min);
        let l2 = get_liquid(ip, vec3<i32>(1,0,0), win_min);
        let l3 = get_liquid(ip, vec3<i32>(0,-1,0), win_min);
        let l4 = get_liquid(ip, vec3<i32>(0,1,0), win_min);
        let l5 = get_liquid(ip, vec3<i32>(0,0,-1), win_min);
        let l6 = get_liquid(ip, vec3<i32>(0,0,1), win_min);
        let nv1 = get_vel(ip, vec3<i32>(-1,0,0), win_min).xyz;
        let nv2 = get_vel(ip, vec3<i32>(1,0,0), win_min).xyz;
        let nv3 = get_vel(ip, vec3<i32>(0,-1,0), win_min).xyz;
        let nv4 = get_vel(ip, vec3<i32>(0,1,0), win_min).xyz;
        let nv5 = get_vel(ip, vec3<i32>(0,0,-1), win_min).xyz;
        let nv6 = get_vel(ip, vec3<i32>(0,0,1), win_min).xyz;
        let max_nv2 = max(max(dot(nv1, nv1), dot(nv2, nv2)), max(max(dot(nv3, nv3), dot(nv4, nv4)), max(dot(nv5, nv5), dot(nv6, nv6))));
        let n1 = l1.w; let n2 = l2.w; let n3 = l3.w;
        let n4 = l4.w; let n5 = l5.w; let n6 = l6.w;
        let max_c = max(max(l1.z, l2.z), max(max(l3.z, l4.z), max(l5.z, l6.z)));
        let my_gas = get_gas(ip, zero_d, win_min).w;
        var match_near = false;
        if (u.match_info.x > 0.5) {
            for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
                let m = u.matches[mi];
                if (m.w > 0.01 && distance(wp_self, m.xyz) <= 2.4) { match_near = true; break; }
            }
        }
        let law_wake = tg_self.y < 0.30 || tg_self.x < 0.20;
        var vox_near = false;
        let vox_cnt_l = min(u32(round(u.match_info.z)), 12u);
        for (var vi: u32 = 0u; vi < vox_cnt_l; vi = vi + 1u) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && va.x >= 256.5 && va.x < 511.5 && abs(va.y) > 0.001 && distance(wp_self, vp.xyz) <= (vp.w + 1.5)) {
                vox_near = true;
                break;
            }
        }
        if (!match_near && !vox_near && !law_wake && max_nv2 < 0.0005 && max_c < 0.01 && n1 >= 10.0 && n2 >= 10.0 && n3 >= 10.0 && n4 >= 10.0 && n5 >= 10.0 && n6 >= 10.0 && my_gas >= 10.0 && u.edit_params.y == 0.0) {
             output_buffer[idx] = self_liq;
             return;
        }
    }

    let self_props = get_liq_props(self_liq.x);

    let down_d = vec3<i32>(0, -1, 0);
    let up_d = vec3<i32>(0, 1, 0);

    let neighbors = array<vec3<i32>, 4>(
        vec3<i32>(-1, 0, 0),
        vec3<i32>(1, 0, 0),
        vec3<i32>(0, 0, -1),
        vec3<i32>(0, 0, 1)
    );

    let tg_up = eval_law_tg_liq(wp_self + vec3<f32>(0.0, 0.5, 0.0), active_tg);
    let tg_dn = eval_law_tg_liq(wp_self + vec3<f32>(0.0, -0.5, 0.0), active_tg);
    let tau_up = select(clamp(tg_up.x * 2.0, 0.0, 1.35), 0.0, tg_up.x < 0.12);
    let tau_dn = select(clamp(tg_dn.x * 2.0, 0.0, 1.35), 0.0, tg_dn.x < 0.12);
    let anti_up = tg_up.y < 0.30;
    let anti_dn = tg_dn.y < 0.30;

    // --- 1. Density Buoyancy Swapping (1-to-1 parity matching; paused under high shear or Chrono Stasis, inverted by -Gravi!) ---
    var swapped = false;
    let frame_step = i32(u.time) % 2;
    let is_even_pair = (lp.y % 2) == frame_step;

    if (self_vol > 0.05 && self_v2 < 0.04) {
        if (is_even_pair) {
            if (lp.y > 0 && tau_dn > 0.25 && !is_solid(ip, down_d, win_min)) {
                let below = get_liquid(ip, down_d, win_min);
                let below_props = get_liq_props(below.x);
                let gsign_dn = select(1.0, -1.0, anti_dn);
                if (below.y > 0.05 && (self_props.density - below_props.density) * gsign_dn > 0.0 && dot(get_vel(ip, down_d, win_min).xyz, get_vel(ip, down_d, win_min).xyz) < 0.04) {
                    next_id = below.x;
                    next_vol = below.y;
                    swapped = true;
                }
            }
        } else {
            if (lp.y < 159 && tau_up > 0.25 && !is_solid(ip, up_d, win_min)) {
                let above = get_liquid(ip, up_d, win_min);
                let above_props = get_liq_props(above.x);
                let gsign_up = select(1.0, -1.0, anti_up);
                if (above.y > 0.05 && (above_props.density - self_props.density) * gsign_up > 0.0 && dot(get_vel(ip, up_d, win_min).xyz, get_vel(ip, up_d, win_min).xyz) < 0.04) {
                    next_id = above.x;
                    next_vol = above.y;
                    swapped = true;
                }
            }
        }
    }

    // --- 2. Gravity / Anti-Gravity, Lateral Leveling & 3D Kinetic Splash Advection (exact face-symmetric conservation!) ---
    var net_flow = 0.0;
    var max_inflow = 0.0;

    if (!swapped) {
        let g_rate = self_props.g_rate;
        let l_rate = self_props.l_rate;

        // Vertical face with below (ip + down_d): normal gravity drains down, -Gravi drains up from below!
        if (!is_solid(ip, down_d, win_min)) {
            let below = get_liquid(ip, down_d, win_min);
            let below_props = get_liq_props(below.x);
            let vy_dn = abs(0.5 * (self_vel.y + get_vel(ip, down_d, win_min).y));
            let pec_dn = clamp(1.0 - vy_dn * 1.8, 0.0, 1.0) * tau_dn;
            if (!anti_dn) {
                if (below.y <= 0.05 || self_props.density >= below_props.density) {
                    let flow_out = min(self_vol, max(0.0, 1.0 - below.y)) * g_rate * pec_dn;
                    net_flow -= flow_out;
                }
            } else {
                if (self_vol <= 0.05 || below_props.density >= self_props.density) {
                    let flow_in = min(below.y, max(0.0, 1.0 - self_vol)) * below_props.g_rate * pec_dn;
                    net_flow += flow_in;
                    if (flow_in > max_inflow) {
                        max_inflow = flow_in;
                        next_id = below.x;
                    }
                }
            }
        }
        // Vertical face with above (ip + up_d): normal gravity receives from above, -Gravi drains UP onto cave ceilings!
        if (!is_solid(ip, up_d, win_min)) {
            let above = get_liquid(ip, up_d, win_min);
            let above_props = get_liq_props(above.x);
            let vy_up = abs(0.5 * (self_vel.y + get_vel(ip, up_d, win_min).y));
            let pec_up = clamp(1.0 - vy_up * 1.8, 0.0, 1.0) * tau_up;
            if (!anti_up) {
                if (self_vol <= 0.05 || above_props.density >= self_props.density) {
                    let flow_in = min(above.y, max(0.0, 1.0 - self_vol)) * above_props.g_rate * pec_up;
                    net_flow += flow_in;
                    if (flow_in > max_inflow) {
                        max_inflow = flow_in;
                        next_id = above.x;
                    }
                }
            } else {
                if (above.y <= 0.05 || self_props.density >= above_props.density) {
                    let flow_out = min(self_vol, max(0.0, 1.0 - above.y)) * g_rate * pec_up;
                    net_flow -= flow_out;
                }
            }
        }

        // Lateral flow (Peclet-damped & Chrono-scaled across shared faces!)
        for (var i = 0; i < 4; i = i + 1) {
            let nd = neighbors[i];
            if (!is_solid(ip, nd, win_min)) {
                let tg_lat = eval_law_tg_liq(wp_self + vec3<f32>(nd) * 0.5, active_tg);
                let tau_lat = select(clamp(tg_lat.x * 2.0, 0.0, 1.35), 0.0, tg_lat.x < 0.12);
                let n_liq = get_liquid(ip, nd, win_min);
                let n_props = get_liq_props(n_liq.x);
                let vn_lat = abs(0.5 * dot(self_vel.xyz + get_vel(ip, nd, win_min).xyz, vec3<f32>(nd)));
                let pec_lat = clamp(1.0 - vn_lat * 1.8, 0.0, 1.0) * tau_lat;
                if (self_vol > n_liq.y && (n_liq.y <= 0.05 || self_props.density >= n_props.density)) {
                    let flow_out = (self_vol - n_liq.y) * l_rate * pec_lat;
                    net_flow -= flow_out;
                }
                if (n_liq.y > self_vol && (self_vol <= 0.05 || n_props.density >= self_props.density)) {
                    let flow_in = (n_liq.y - self_vol) * n_props.l_rate * pec_lat;
                    net_flow += flow_in;
                    if (flow_in > max_inflow) {
                        max_inflow = flow_in;
                        next_id = n_liq.x;
                    }
                }
            }
        }

        // 6-face symmetric upwind kinetic advection (carves troughs, piles bow-waves up to 1.35, throws +Y rooster-tails, Chrono-scaled!)
        let adv_dirs = array<vec3<i32>, 6>(
            vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
            vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
            vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
        );
        let dens_resist = 1.0 / max(0.65, sqrt(max(self_props.density, 0.25)));
        for (var ai = 0; ai < 6; ai = ai + 1) {
            let ad = adv_dirs[ai];
            if (!is_solid(ip, ad, win_min)) {
                let tg_ad = eval_law_tg_liq(wp_self + vec3<f32>(ad) * 0.5, active_tg);
                let tau_ad = select(clamp(tg_ad.x * 2.0, 0.0, 1.35), 0.0, tg_ad.x < 0.12);
                let n_liq = get_liquid(ip, ad, win_min);
                let n_vel = get_vel(ip, ad, win_min);
                let v_ab = 0.5 * dot(self_vel.xyz + n_vel.xyz, vec3<f32>(ad));
                let vy_pair = 0.5 * (self_vel.y + n_vel.y);
                let vy_eff = select(vy_pair, max(0.0, vy_pair - 0.18), vy_pair > 0.0);
                let v_drive = select(v_ab, vy_eff * f32(ad.y), ad.y != 0);
                let can_mix_l = self_vol <= 0.04 || n_liq.y <= 0.04 || abs(self_liq.x - n_liq.x) < 0.5;
                if (can_mix_l && v_drive > 0.015 && self_vol > 0.01) {
                    let w_out = min(self_vol, max(0.0, 1.35 - n_liq.y)) * clamp(v_drive * 0.22 * dens_resist, 0.0, 0.145) * tau_ad;
                    net_flow -= w_out;
                } else if (can_mix_l && v_drive < -0.015 && n_liq.y > 0.01) {
                    let n_dens = max(0.25, get_liq_props(n_liq.x).density);
                    let n_resist = 1.0 / max(0.65, sqrt(n_dens));
                    let w_in = min(n_liq.y, max(0.0, 1.35 - self_vol)) * clamp((-v_drive) * 0.22 * n_resist, 0.0, 0.145) * tau_ad;
                    net_flow += w_in;
                    if (self_vol <= 0.04 && w_in > max_inflow) {
                        max_inflow = w_in;
                        next_id = n_liq.x;
                    }
                }
            }
        }

        next_vol = next_vol + net_flow;
    }

    // --- 3. Spawn liquid if click is active ---
    if (u.hit_pos.w > 0.5) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz);
        let dist = distance(world_pos, u.hit_pos.xyz);
        if (dist <= u.brush_radius && u.edit_params.x > 0.5) {
            var p_id = u.edit_params.x;
            if (p_id >= 256.0) { p_id = p_id - 256.0; }
            next_id = p_id;
            next_vol = min(1.0, next_vol + u.edit_params.y);
        }
    }

    // --- 3.2. Multi-Slot GPU Voxel Action Queue (Liquids: Siphon/Slurp va.y < 0, Squirt/Splash va.y > 0) ---
    let vox_cnt = min(u32(round(u.match_info.z)), 12u);
    if (vox_cnt > 0u) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
        for (var vi: u32 = 0u; vi < vox_cnt; vi = vi + 1u) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && va.x >= 256.5 && va.x < 511.5 && abs(va.y) > 0.001) {
                let fdist = distance(world_pos, vp.xyz);
                if (fdist <= vp.w) {
                    let target_lid = round(va.x - 256.0);
                    let falloff = clamp(1.15 - 0.65 * (fdist / max(vp.w, 0.5)), 0.25, 1.0);
                    if (va.y < 0.0) {
                        if (abs(round(abs(next_id)) - target_lid) < 0.5 && next_vol > 0.0) {
                            next_vol = max(0.0, next_vol + va.y * falloff);
                            next_sleep = 0.0;
                        }
                    } else {
                        next_id = target_lid;
                        next_vol = min(1.0, next_vol + va.y * falloff);
                        next_sleep = 0.0;
                    }
                }
            }
        }
    }

    // --- 3.5. Steam condensation & Gas -> Liquid Reaction Condensation (e.g. Acid Vapor + Steam -> Acid) ---
    let my_gas = get_gas(ip, zero_d, win_min);
    if (my_gas.x == 1.0 && my_gas.y > 0.05) {
        if (is_solid(ip, up_d, win_min)) {
            if (next_vol <= 0.05 || next_id == 1.0) {
                next_id = 1.0; // Water
                next_vol = min(1.0, next_vol + 0.02);
            }
        }
    } else if (next_vol <= 0.05 && my_gas.y > 0.08 && abs(my_gas.x) > 0.5) {
        let g_dirs = array<vec3<i32>, 6>(
            vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
            vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
            vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
        );
        for (var gi = 0u; gi < 6u; gi++) {
            let gd = g_dirs[gi];
            if (!step_in_window(ip, gd, win_min)) { continue; }
            let ng = get_gas(ip, gd, win_min);
            if (ng.y > 0.08 && abs(ng.x) > 0.5) {
                let rxg = get_reaction(abs(my_gas.x), 512u, abs(ng.x), 512u);
                if (rxg.y >= 256.0 && rxg.y < 512.0) {
                    next_id = rxg.y - 256.0;
                    next_vol = 0.45;
                    next_sleep = 0.0;
                    break;
                }
            }
        }
    }

    // --- 4. Multi-Phase Reactions (including co-located gas at zero_d!) ---
    if (next_vol > 0.05) {
        var reacted_l = false;
        // 0. Co-located gas check in the exact same voxel ip
        if (my_gas.y > 0.05) {
            let rx0 = get_reaction(abs(next_id), 256u, my_gas.x, 512u);
            if (rx0.x != abs(next_id) + 256.0) {
                if (rx0.x > 0.5 && rx0.x < 256.0) {
                    let self_s_idx = u32(ip.x) + u32(ip.y) * 160u + u32(ip.z) * 25600u;
                    let is_gran = (registry_data[clamp(u32(round(rx0.x)), 0u, 255u) * 8u + 7u] & TAG_GRANULAR) != 0u;
                    solid_buffer[self_s_idx] = vec4<f32>(select(rx0.x, -rx0.x, is_gran), select(-1.0, -0.5, is_gran), 0.0, 0.0);
                    next_id = 0.0; next_vol = 0.0;
                } else if (rx0.x >= 256.0 && rx0.x < 512.0) {
                    next_id = rx0.x - 256.0;
                } else if (rx0.x == 515.0) {
                    // Sustained pool fire: burn rate scales inversely with material toughness!
                    // Nitroglycerin (0.15) & Naphtha (0.35) flash off fast -> Kerosene (0.95) -> Crude Oil (2.0) -> Diesel (3.2) burns slow & heavy!
                    let l_tough = max(0.15, bitcast<f32>(registry_data[(256u + clamp(u32(round(abs(next_id))), 0u, 255u)) * 8u + 6u]));
                    let burn_step = clamp(0.18 / l_tough, 0.028, 0.65);
                    next_vol = max(0.0, next_vol - burn_step);
                    if (next_vol < 0.02) { next_id = 0.0; next_vol = 0.0; }
                } else {
                    next_id = 0.0; next_vol = 0.0;
                }
                reacted_l = true;
                next_sleep = 0.0;
            }
        }
        let all_neighbors = array<vec3<i32>, 6>(
            vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
            vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
            vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
        );
        for (var i = 0u; i < 6u; i++) {
            if (reacted_l) { break; }
            let nd = all_neighbors[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            
            // 1. Solid check
            let n_sol = get_solid(ip, nd, win_min);
            if (n_sol.y <= 0.0 && abs(n_sol.x) > 0.5) {
                let rx = get_reaction(abs(next_id), 256u, abs(n_sol.x), 0u);
                if (rx.x != abs(next_id) + 256.0) {
                    if (rx.x > 0.5 && rx.x < 256.0) { // Spawning Solid (granular precipitate vs cohesive block)
                        let self_s_idx = u32(ip.x) + u32(ip.y) * 160u + u32(ip.z) * 25600u;
                        let is_gran = (registry_data[clamp(u32(round(rx.x)), 0u, 255u) * 8u + 7u] & TAG_GRANULAR) != 0u;
                        solid_buffer[self_s_idx] = vec4<f32>(select(rx.x, -rx.x, is_gran), select(-1.0, -0.5, is_gran), 0.0, 0.0);
                        next_id = 0.0; next_vol = 0.0;
                    } else if (rx.x >= 256.0 && rx.x < 512.0) { // Becoming another Liquid
                        next_id = rx.x - 256.0;
                    } else if (rx.x == 515.0) {
                        let l_tough = max(0.15, bitcast<f32>(registry_data[(256u + clamp(u32(round(abs(next_id))), 0u, 255u)) * 8u + 6u]));
                        let burn_step = clamp(0.18 / l_tough, 0.028, 0.65);
                        next_vol = max(0.0, next_vol - burn_step);
                        if (next_vol < 0.02) { next_id = 0.0; next_vol = 0.0; }
                    } else { // Becoming Gas / Air
                        next_id = 0.0; next_vol = 0.0;
                    }
                    next_sleep = 0.0;
                    break;
                }
            }
            
            // 2. Liquid check
            let n_liq = get_liquid(ip, nd, win_min);
            if (n_liq.y > 0.05) {
                let rx = get_reaction(abs(next_id), 256u, n_liq.x, 256u);
                if (rx.x != abs(next_id) + 256.0) {
                    if (rx.x > 0.5 && rx.x < 256.0) { 
                        let self_s_idx = u32(ip.x) + u32(ip.y) * 160u + u32(ip.z) * 25600u;
                        let is_gran = (registry_data[clamp(u32(round(rx.x)), 0u, 255u) * 8u + 7u] & TAG_GRANULAR) != 0u;
                        solid_buffer[self_s_idx] = vec4<f32>(select(rx.x, -rx.x, is_gran), select(-1.0, -0.5, is_gran), 0.0, 0.0);
                        next_id = 0.0; next_vol = 0.0;
                    } else if (rx.x >= 256.0 && rx.x < 512.0) { 
                        next_id = rx.x - 256.0;
                    } else if (rx.x == 515.0) {
                        let l_tough = max(0.15, bitcast<f32>(registry_data[(256u + clamp(u32(round(abs(next_id))), 0u, 255u)) * 8u + 6u]));
                        let burn_step = clamp(0.18 / l_tough, 0.028, 0.65);
                        next_vol = max(0.0, next_vol - burn_step);
                        if (next_vol < 0.02) { next_id = 0.0; next_vol = 0.0; }
                    } else { 
                        next_id = 0.0; next_vol = 0.0;
                    }
                    next_sleep = 0.0;
                    break;
                }
            }
            
            // 3. Gas check
            let n_gas = get_gas(ip, nd, win_min);
            if (n_gas.y > 0.05) {
                let rx = get_reaction(abs(next_id), 256u, n_gas.x, 512u);
                if (rx.x != abs(next_id) + 256.0) {
                    if (rx.x > 0.5 && rx.x < 256.0) { 
                        let self_s_idx = u32(ip.x) + u32(ip.y) * 160u + u32(ip.z) * 25600u;
                        let is_gran = (registry_data[clamp(u32(round(rx.x)), 0u, 255u) * 8u + 7u] & TAG_GRANULAR) != 0u;
                        solid_buffer[self_s_idx] = vec4<f32>(select(rx.x, -rx.x, is_gran), select(-1.0, -0.5, is_gran), 0.0, 0.0);
                        next_id = 0.0; next_vol = 0.0;
                    } else if (rx.x >= 256.0 && rx.x < 512.0) { 
                        next_id = rx.x - 256.0;
                    } else if (rx.x == 515.0) {
                        let l_tough = max(0.15, bitcast<f32>(registry_data[(256u + clamp(u32(round(abs(next_id))), 0u, 255u)) * 8u + 6u]));
                        let burn_step = clamp(0.18 / l_tough, 0.028, 0.65);
                        next_vol = max(0.0, next_vol - burn_step);
                        if (next_vol < 0.02) { next_id = 0.0; next_vol = 0.0; }
                    } else { 
                        next_id = 0.0; next_vol = 0.0;
                    }
                    next_sleep = 0.0;
                    break;
                }
            }
        }
    }



    // --- 5. Evaporate and clamp ---
    if (next_vol < 0.01) {
        next_vol = 0.0;
        next_id = 0.0;
    }
    
    next_vol = clamp(next_vol, 0.0, 1.35);
    if (next_vol == 0.0) {
        next_id = 0.0;
    }

    if (abs(next_vol - self_vol) < 0.001 && self_v2 < 0.0005) {
        next_sleep = min(next_sleep + 1.0, 10.0);
    } else {
        next_sleep = 0.0;
    }
    
    if (next_vol > 0.05) {
        let lid_u = clamp(u32(round(abs(next_id))), 0u, 255u);
        let l_tags = registry_data[(256u + lid_u) * 8u + 7u];
        if ((l_tags & TAG_CONDUCTIVE) != 0u) {
            var charge = self_liq.z * 0.88;
            let c_dirs = array<vec3<i32>, 6>(
                vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
                vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
                vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
            );
            var touches_gold = false;
            var touches_acid = (lid_u == 3u);
            for (var ci = 0u; ci < 6u; ci++) {
                let cd = c_dirs[ci];
                let nl = get_liquid(ip, cd, win_min);
                if (nl.y > 0.05) {
                    charge = max(charge, nl.z * 0.94);
                    if (round(abs(nl.x)) == 3.0) { touches_acid = true; }
                }
                let ns = get_solid(ip, cd, win_min);
                if (ns.y <= 0.0) {
                    let ns_id = round(abs(ns.x));
                    if (ns_id == 5.0) { touches_gold = true; }
                    if (ns.z < -0.05) {
                        charge = max(charge, clamp(-ns.z * 0.95, 0.0, 1.0));
                    }
                }
            }
            if (touches_gold && touches_acid) {
                charge = max(charge, 0.92);
            }
            next_age = clamp(charge, 0.0, 1.0);
            if (next_age > 0.02) { next_sleep = 0.0; }
        } else {
            next_age = 0.0;
        }
    } else {
        next_age = 0.0;
    }


    if (self_vel.w >= 4.3 || (abs(self_vel.w) > 1.95 && round(abs(next_id)) == 14.0 && next_vol > 0.05)) {
        next_id = 0.0;
        next_vol = 0.0;
        next_age = 0.0;
        next_sleep = 0.0;
    }

    output_buffer[idx] = vec4<f32>(next_id, next_vol, next_age, next_sleep);
}
"))

(def gas-sim-wgsl
  (String.append wgsl-tag-constants "
struct GasProps {
    g_rate: f32,
    l_rate: f32,
    decay: f32,
    density: f32,
}

fn get_gas_props(id: f32) -> GasProps {
    if (id < 0.5) { return GasProps(0.0, 0.0, 0.0, 0.0); }
    let mat_id = clamp(u32(round(id)), 0u, 255u);
    let idx = (512u + mat_id) * 8u;
    let density = bitcast<f32>(registry_data[idx + 5u]);
    let tags = registry_data[idx + 7u];
    
    var g = min(1.0, 0.34 / max(density, 0.1));
    var l = min(1.0, 0.11 / max(density, 0.1));
    var dec = 0.0;
    if ((tags & TAG_HEAVY_GAS) != 0u) {
        g = -min(1.0, density * 0.12);
    }
    if ((tags & TAG_DISSIPATES) != 0u) {
        dec = 0.014;
    }
    if (mat_id == 3u) {
        // Fire (3): fierce upward tongue, tight lateral column, crisp flame tip decay into Smoke
        g = 0.44;
        l = 0.048;
        dec = 0.028;
    } else if (mat_id == 4u) {
        // Smoke (4): strong buoyant chimney rise, tight plume confinement in open air, slow lingering decay!
        g = 0.42;
        l = 0.042;
        dec = 0.0028;
    } else if (mat_id == 1u) {
        // Steam (1): brisk buoyant plume that lingers in ceiling domes before condensing
        g = 0.40;
        l = 0.052;
        dec = 0.0045;
    }
    let t_rate = abs(g) + 4.0 * l;
    if (t_rate > 1.0) {
        g = g / t_rate;
        l = l / t_rate;
    }
    return GasProps(g, l, dec, density);
}

@group(0) @binding(0) var<storage, read>       input_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> output_buffer: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> solid_buffer: array<vec4<f32>>;
@group(0) @binding(4) var<storage, read>       registry_data: array<u32>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;
@group(0) @binding(8) var vel_texture:         texture_3d<f32>;

fn positive_mod(n: i32, m: i32) -> i32 {
    let r = n % m;
    if (r < 0) {
        return r + m;
    }
    return r;
}

fn get_win_min() -> vec3<i32> {
    let cx = i32(floor(u.cam_pos.x / 32.0)) - 2;
    let cy = i32(floor(u.cam_pos.y / 32.0)) - 2;
    let cz = i32(floor(u.cam_pos.z / 32.0)) - 2;
    return vec3<i32>(
        positive_mod(cx, 5) * 32,
        positive_mod(cy, 5) * 32,
        positive_mod(cz, 5) * 32
    );
}

fn step_in_window(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let lp = (base_ip - win_min + vec3<i32>(160)) % 160;
    let nlp = lp + delta;
    return nlp.x >= 0 && nlp.x < 160 && nlp.y >= 0 && nlp.y < 160 && nlp.z >= 0 && nlp.z < 160;
}

fn get_solid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(255.0, -1.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(solid_texture, wrapped, 0);
}

fn is_solid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let sol = get_solid(base_ip, delta, win_min);
    return sol.y * 0.5 < 0.008;
}

fn get_gas(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0, 0.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(gas_texture, wrapped, 0);
}

fn get_liquid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0, 0.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(liquid_texture, wrapped, 0);
}

fn get_vel(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(vel_texture, wrapped, 0);
}

fn get_world_pos(ip: vec3<i32>, cam_pos: vec3<f32>) -> vec3<f32> {
    let cx = i32(floor(cam_pos.x / 32.0));
    let cy = i32(floor(cam_pos.y / 32.0));
    let cz = i32(floor(cam_pos.z / 32.0));
    
    let offset_cx = cx - 2;
    let offset_cy = cy - 2;
    let offset_cz = cz - 2;
    
    let slot_x = ip.x / 32;
    let slot_y = ip.y / 32;
    let slot_z = ip.z / 32;
    
    let lx = ip.x % 32;
    let ly = ip.y % 32;
    let lz = ip.z % 32;
    
    let qx = offset_cx + positive_mod(slot_x - positive_mod(offset_cx, 5), 5);
    let qy = offset_cy + positive_mod(slot_y - positive_mod(offset_cy, 5), 5);
    let qz = offset_cz + positive_mod(slot_z - positive_mod(offset_cz, 5), 5);
    
    let gx = qx * 32 + lx;
    let gy = qy * 32 + ly;
    let gz = qz * 32 + lz;
    
    return vec3<f32>(f32(gx), f32(gy), f32(gz));
}

fn has_law_tg_gas() -> bool {
    for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
        if (u.mancer_pos[mk].w > 0.05 && u.mancer_mat[mk].x >= 768.5) {
            let m_id = i32(round(u.mancer_mat[mk].x));
            if (m_id == 771 || m_id == 772) { return true; }
            if (m_id >= 780 && m_id <= 815) {
                let pair = m_id - 780;
                let l0 = pair / 6;
                let l1 = pair % 6;
                if (l0 == 2 || l0 == 3 || l1 == 2 || l1 == 3) { return true; }
            }
        }
    }
    return false;
}

fn eval_law_tg_gas(world_p: vec3<f32>, active_tg: bool) -> vec2<f32> {
    if (!active_tg) { return vec2<f32>(0.50, 0.50); }
    var tau: f32 = 0.50;
    var g_val: f32 = 0.50;
    for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
        let mp = u.mancer_pos[mk];
        let mm = u.mancer_mat[mk];
        if (mp.w > 0.05 && mm.x >= 768.5) {
            let m_id = i32(round(mm.x));
            var l0: i32 = -1;
            var l1: i32 = -1;
            if (m_id >= 769 && m_id <= 774) { l0 = m_id - 769; }
            else if (m_id >= 780 && m_id <= 815) {
                let pair = m_id - 780;
                l0 = pair / 6;
                l1 = pair % 6;
            }
            let dome_r = max(5.4, abs(mm.z) + 1.5);
            let dm = distance(world_p, mp.xyz);
            if (dm < dome_r) {
                let s_d = clamp(1.2 - dm / dome_r, 0.55, 1.0);
                let pol = select(mm.w, sign(mm.z), abs(mm.z) > 0.15);
                if (l0 == 2 || l1 == 2) {
                    g_val = select(min(g_val, mix(0.50, 0.04, s_d)), max(g_val, mix(0.50, 0.96, s_d)), pol >= 0.0);
                }
                if (l0 == 3 || l1 == 3) {
                    tau = select(min(tau, mix(0.50, 0.03, s_d)), max(tau, mix(0.50, 0.96, s_d)), pol >= 0.0);
                }
            }
        }
    }
    return vec2<f32>(tau, g_val);
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    // Dummy reads to prevent compiler from optimizing out unused bindings
    let dummy_val = input_buffer[0] + solid_buffer[0] + vec4<f32>(bitcast<f32>(registry_data[0])) + textureLoad(vel_texture, vec3<i32>(0), 0);
    if (dummy_val.x > 999999.0) {
        output_buffer[idx] = textureLoad(liquid_texture, vec3<i32>(0), 0);
    }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));
    let win_min = get_win_min();
    let zero_d = vec3<i32>(0, 0, 0);

    if (is_solid(ip, zero_d, win_min)) {
        output_buffer[idx] = vec4<f32>(0.0, 0.0, 0.0, 10.0);
        return;
    }

    let self_gas = get_gas(ip, zero_d, win_min);
    let self_vol = self_gas.y;
    let self_vel = get_vel(ip, zero_d, win_min);
    let self_v2 = dot(self_vel.xyz, self_vel.xyz);
    let active_tg = has_law_tg_gas();
    let wp_self = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
    let tg_self = eval_law_tg_gas(wp_self, active_tg);
    var next_id = self_gas.x;
    var next_vol = self_vol;
    var next_age = self_gas.z;
    var next_sleep = self_gas.w;
    
    if (next_sleep >= 10.0 && self_v2 < 0.0004 && abs(self_vel.w) < 0.5) {
        let n1 = get_gas(ip, vec3<i32>(-1,0,0), win_min).w;
        let n2 = get_gas(ip, vec3<i32>(1,0,0), win_min).w;
        let n3 = get_gas(ip, vec3<i32>(0,-1,0), win_min).w;
        let n4 = get_gas(ip, vec3<i32>(0,1,0), win_min).w;
        let n5 = get_gas(ip, vec3<i32>(0,0,-1), win_min).w;
        let n6 = get_gas(ip, vec3<i32>(0,0,1), win_min).w;
        let gv1 = get_vel(ip, vec3<i32>(-1,0,0), win_min).xyz;
        let gv2 = get_vel(ip, vec3<i32>(1,0,0), win_min).xyz;
        let gv3 = get_vel(ip, vec3<i32>(0,-1,0), win_min).xyz;
        let gv4 = get_vel(ip, vec3<i32>(0,1,0), win_min).xyz;
        let gv5 = get_vel(ip, vec3<i32>(0,0,-1), win_min).xyz;
        let gv6 = get_vel(ip, vec3<i32>(0,0,1), win_min).xyz;
        let max_gv2 = max(max(dot(gv1, gv1), dot(gv2, gv2)), max(max(dot(gv3, gv3), dot(gv4, gv4)), max(dot(gv5, gv5), dot(gv6, gv6))));
        let my_liq = get_liquid(ip, zero_d, win_min).w;
        var match_near = false;
        if (u.match_info.x > 0.5) {
            for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
                let m = u.matches[mi];
                if (m.w > 0.01 && distance(wp_self, m.xyz) <= 2.4) { match_near = true; break; }
            }
        }
        let law_wake = tg_self.y < 0.30 || tg_self.x < 0.20;
        var vox_near = false;
        let vox_cnt_g = min(u32(round(u.match_info.z)), 12u);
        for (var vi: u32 = 0u; vi < vox_cnt_g; vi = vi + 1u) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && va.x >= 512.5 && abs(va.y) > 0.001 && distance(wp_self, vp.xyz) <= (vp.w + 1.5)) {
                vox_near = true;
                break;
            }
        }
        if (!match_near && !vox_near && !law_wake && max_gv2 < 0.0004 && n1 >= 10.0 && n2 >= 10.0 && n3 >= 10.0 && n4 >= 10.0 && n5 >= 10.0 && n6 >= 10.0 && my_liq >= 10.0 && u.edit_params.w == 0.0) {
             output_buffer[idx] = self_gas;
             return;
        }
    }

    let down_d = vec3<i32>(0, -1, 0);
    let up_d = vec3<i32>(0, 1, 0);

    let neighbors = array<vec3<i32>, 4>(
        vec3<i32>(-1, 0, 0),
        vec3<i32>(1, 0, 0),
        vec3<i32>(0, 0, -1),
        vec3<i32>(0, 0, 1)
    );

    let self_props = get_gas_props(self_gas.x);
    let g_rate = self_props.g_rate;
    let l_rate = self_props.l_rate;
    let tg_up = eval_law_tg_gas(wp_self + vec3<f32>(0.0, 0.5, 0.0), active_tg);
    let tg_dn = eval_law_tg_gas(wp_self + vec3<f32>(0.0, -0.5, 0.0), active_tg);
    let tau_up = select(clamp(tg_up.x * 2.0, 0.0, 1.35), 0.0, tg_up.x < 0.12);
    let tau_dn = select(clamp(tg_dn.x * 2.0, 0.0, 1.35), 0.0, tg_dn.x < 0.12);
    let gsign_up = select(1.0, -1.0, tg_up.y < 0.30);
    let gsign_dn = select(1.0, -1.0, tg_dn.y < 0.30);

    // --- 0. 1-to-1 Gas Density Buoyancy Swapping (paused under active kinetic wakes or Chrono Stasis, inverted by -Gravi!) ---
    var gas_swapped = false;
    if (self_vol > 0.08 && self_v2 < 0.03 && tau_up > 0.25 && !is_solid(ip, up_d, win_min)) {
        let above = get_gas(ip, up_d, win_min);
        let up_v = get_vel(ip, up_d, win_min).xyz;
        if (above.y > 0.08 && abs(above.x - self_gas.x) > 0.1 && dot(up_v, up_v) < 0.03) {
            let above_props = get_gas_props(above.x);
            if ((above_props.density - self_props.density) * gsign_up > 0.05) {
                next_id = above.x;
                next_vol = above.y;
                next_age = above.z;
                next_sleep = 0.0;
                gas_swapped = true;
            }
        }
    }
    if (!gas_swapped && self_vol > 0.08 && self_v2 < 0.03 && tau_dn > 0.25 && !is_solid(ip, down_d, win_min)) {
        let below = get_gas(ip, down_d, win_min);
        let dn_v = get_vel(ip, down_d, win_min).xyz;
        if (below.y > 0.08 && abs(below.x - self_gas.x) > 0.1 && dot(dn_v, dn_v) < 0.03) {
            let below_props = get_gas_props(below.x);
            if ((self_props.density - below_props.density) * gsign_dn > 0.05) {
                next_id = below.x;
                next_vol = below.y;
                next_age = below.z;
                next_sleep = 0.0;
                gas_swapped = true;
            }
        }
    }

    var net_flow = 0.0;
    var max_inflow = 0.0;

    if (!gas_swapped) {
        let vy_up_abs = abs(0.5 * (self_vel.y + get_vel(ip, up_d, win_min).y));
        let vy_dn_abs = abs(0.5 * (self_vel.y + get_vel(ip, down_d, win_min).y));
        let pec_up = clamp(1.0 - vy_up_abs * 1.6, 0.0, 1.0) * tau_up;
        let pec_dn = clamp(1.0 - vy_dn_abs * 1.6, 0.0, 1.0) * tau_dn;

        // --- 1. Vertical buoyancy flow (face-symmetric & species-conserving under -Gravi inversion & -Chrono stasis!) ---
        let g_self_up = g_rate * gsign_up;
        let g_self_dn = g_rate * gsign_dn;
        if (!is_solid(ip, up_d, win_min)) {
            let above = get_gas(ip, up_d, win_min);
            let can_mix_up = self_vol <= 0.04 || above.y <= 0.04 || abs(self_gas.x - above.x) < 0.5;
            if (can_mix_up && g_self_up > 0.0) {
                let flow_out = min(self_vol, max(0.0, 1.0 - above.y)) * g_self_up * pec_up;
                net_flow -= flow_out;
            }
            let above_g = get_gas_props(above.x).g_rate * gsign_up;
            if (can_mix_up && above_g < 0.0) {
                let flow_in = min(above.y, max(0.0, 1.0 - self_vol)) * abs(above_g) * pec_up;
                net_flow += flow_in;
                if (self_vol <= 0.04 && flow_in > max_inflow) {
                    max_inflow = flow_in;
                    next_id = above.x;
                }
            }
        }
        if (!is_solid(ip, down_d, win_min)) {
            let below = get_gas(ip, down_d, win_min);
            let can_mix_dn = self_vol <= 0.04 || below.y <= 0.04 || abs(self_gas.x - below.x) < 0.5;
            if (can_mix_dn && g_self_dn < 0.0) {
                let flow_out = min(self_vol, max(0.0, 1.0 - below.y)) * abs(g_self_dn) * pec_dn;
                net_flow -= flow_out;
            }
            let below_g = get_gas_props(below.x).g_rate * gsign_dn;
            if (can_mix_dn && below_g > 0.0) {
                let flow_in = min(below.y, max(0.0, 1.0 - self_vol)) * below_g * pec_dn;
                net_flow += flow_in;
                if (self_vol <= 0.04 && flow_in > max_inflow) {
                    max_inflow = flow_in;
                    next_id = below.x;
                }
            }
        }

        // --- 2. Lateral diffusion (Peclet-damped, Chrono-scaled & species-conserving across shared faces!) ---
        let self_capped_up = is_solid(ip, up_d, win_min) || get_gas(ip, up_d, win_min).y > 0.65;
        let eff_self_l = select(l_rate, min(0.135, l_rate * 2.85), self_capped_up && g_rate > 0.0);
        for (var i = 0; i < 4; i = i + 1) {
            let nd = neighbors[i];
            if (!is_solid(ip, nd, win_min)) {
                let tg_lat = eval_law_tg_gas(wp_self + vec3<f32>(nd) * 0.5, active_tg);
                let tau_lat = select(clamp(tg_lat.x * 2.0, 0.0, 1.35), 0.0, tg_lat.x < 0.12);
                let n_gas = get_gas(ip, nd, win_min);
                let can_mix_lat = self_vol <= 0.04 || n_gas.y <= 0.04 || abs(self_gas.x - n_gas.x) < 0.5;
                if (can_mix_lat) {
                    let n_props = get_gas_props(n_gas.x);
                    let vn_abs = abs(0.5 * dot(self_vel.xyz + get_vel(ip, nd, win_min).xyz, vec3<f32>(nd)));
                    let pec_lat = clamp(1.0 - vn_abs * 1.6, 0.0, 1.0) * tau_lat;
                    let n_capped_up = is_solid(ip, nd + up_d, win_min) || get_gas(ip, nd + up_d, win_min).y > 0.65;
                    let eff_n_l = select(n_props.l_rate, min(0.135, n_props.l_rate * 2.85), n_capped_up && n_props.g_rate > 0.0);
                    if (self_vol > n_gas.y) {
                        let flow_out = (self_vol - n_gas.y) * eff_self_l * pec_lat;
                        net_flow -= flow_out;
                    }
                    if (n_gas.y > self_vol) {
                        let flow_in = (n_gas.y - self_vol) * eff_n_l * pec_lat;
                        net_flow += flow_in;
                        if (self_vol <= 0.04 && flow_in > max_inflow) {
                            max_inflow = flow_in;
                            next_id = n_gas.x;
                        }
                    }
                }
            }
        }

        // --- 2.5. 6-Face Symmetric Species-Conserving Velocity Advection (Mach tunnels + slipstream plumes!) ---
        let adv_dirs = array<vec3<i32>, 6>(
            vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
            vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
            vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
        );
        for (var ai = 0; ai < 6; ai = ai + 1) {
            let ad = adv_dirs[ai];
            if (!is_solid(ip, ad, win_min)) {
                let tg_ad = eval_law_tg_gas(wp_self + vec3<f32>(ad) * 0.5, active_tg);
                let tau_ad = select(clamp(tg_ad.x * 2.0, 0.0, 1.35), 0.0, tg_ad.x < 0.12);
                let n_gas = get_gas(ip, ad, win_min);
                let can_mix_ad = self_vol <= 0.04 || n_gas.y <= 0.04 || abs(self_gas.x - n_gas.x) < 0.5;
                if (can_mix_ad) {
                    let n_vel = get_vel(ip, ad, win_min);
                    let v_ab = 0.5 * dot(self_vel.xyz + n_vel.xyz, vec3<f32>(ad));
                    if (v_ab > 0.012 && self_vol > 0.005) {
                        let w_out = min(self_vol, max(0.0, 1.85 - n_gas.y)) * clamp(v_ab * 0.23, 0.0, 0.148) * tau_ad;
                        net_flow -= w_out;
                    } else if (v_ab < -0.012 && n_gas.y > 0.005) {
                        let w_in = min(n_gas.y, max(0.0, 1.85 - self_vol)) * clamp((-v_ab) * 0.23, 0.0, 0.148) * tau_ad;
                        net_flow += w_in;
                        if (self_vol <= 0.04 && w_in > max_inflow) {
                            max_inflow = w_in;
                            next_id = n_gas.x;
                        }
                    }
                }
            }
        }

        next_vol = next_vol + net_flow;
    }

    // --- 3. Spawn gas if click is active ---
    if (u.hit_pos.w > 0.5) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz);
        let dist = distance(world_pos, u.hit_pos.xyz);
        if (dist <= u.brush_radius && u.edit_params.z > 0.5) {
            var p_id = u.edit_params.z;
            if (p_id >= 512.0) { p_id = p_id - 512.0; }
            next_id = p_id;
            next_vol = min(1.0, next_vol + u.edit_params.w);
        }
    }

    // --- 3.2. Multi-Slot GPU Voxel Action Queue (Gases: Inhale va.y < 0, Plume/Blast va.y > 0, Burst va.z > 0.5) ---
    let vox_cnt = min(u32(round(u.match_info.z)), 12u);
    if (vox_cnt > 0u) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
        for (var vi: u32 = 0u; vi < vox_cnt; vi = vi + 1u) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && va.x >= 512.5 && abs(va.y) > 0.001) {
                let fdist = distance(world_pos, vp.xyz);
                if (fdist <= vp.w) {
                    let target_gid = round(va.x - 512.0);
                    if (va.y < 0.0) {
                        let falloff = clamp(1.15 - 0.65 * (fdist / max(vp.w, 0.5)), 0.25, 1.0);
                        if (abs(round(abs(next_id)) - target_gid) < 0.5 && next_vol > 0.0) {
                            next_vol = max(0.0, next_vol + va.y * falloff);
                            next_sleep = 0.0;
                        }
                    } else if (va.z > 0.5) {
                        next_id = target_gid;
                        next_vol = max(next_vol, va.y);
                        next_sleep = 0.0;
                    } else {
                        let falloff = clamp(1.15 - 0.65 * (fdist / max(vp.w, 0.5)), 0.25, 1.0);
                        next_id = target_gid;
                        next_vol = min(1.0, next_vol + va.y * falloff);
                        next_sleep = 0.0;
                    }
                }
            }
        }
    }

    // --- 4. Matrix-Driven Gas Spawns ---
    var spawn_gas_id = 0.0;
    var spawn_gas_vol = 0.0;
    
    let my_liq = get_liquid(ip, zero_d, win_min);
    let my_sol = get_solid(ip, zero_d, win_min);

    // --- 3.3. Thrown Lit Matches: Spawn Fire wisp (igniting CA fuels/explosives) or Steam if wet ---
    if (u.match_info.x > 0.5) {
        let m_wp = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
        for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
            let m = u.matches[mi];
            if (m.w > 0.01 && distance(m_wp, m.xyz) <= 1.25) {
                let l_id_u = clamp(u32(round(abs(my_liq.x))), 0u, 255u);
                if (l_id_u > 0u && my_liq.y > 0.08 && (registry_data[(256u + l_id_u) * 8u + 7u] & TAG_EXTINGUISHER) != 0u) {
                    next_id = 1.0; // MAT_STEAM (tssst!)
                    next_vol = max(next_vol, 0.85);
                } else {
                    next_id = 3.0; // MAT_FIRE (TAG_IGNITER -> ignites Oil, Methane, Gel, Gunpowder, Wood, melts Ice)
                    next_vol = max(next_vol, 0.82 * clamp(m.w + 0.25, 0.4, 1.0));
                }
                next_sleep = 0.0;
                break;
            }
        }
    }
    let dirs6 = array<vec3<i32>, 6>(
        vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
        vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
        vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
    );

    // 4.0. Self-Gas Reactions (Gas + Co-located Liquid or 6-Neighbor Solid/Liquid/Gas)
    if (next_vol > 0.05 && next_id > 0.5) {
        var gas_reacted = false;
        if (my_liq.y > 0.05 && my_liq.x > 0.5) {
            let rx0 = get_reaction(abs(next_id), 512u, abs(my_liq.x), 256u);
            if (rx0.x != abs(next_id) + 512.0) {
                if (rx0.x >= 512.0) {
                    next_id = rx0.x - 512.0;
                } else {
                    next_id = 0.0; next_vol = 0.0;
                }
                next_sleep = 0.0;
                gas_reacted = true;
            }
        }
        for (var gi = 0u; gi < 6u; gi++) {
            if (gas_reacted) { break; }
            let nd = dirs6[gi];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let n_sol = get_solid(ip, nd, win_min);
            if (n_sol.y <= 0.0 && abs(n_sol.x) > 0.5) {
                // Oil-stained rock/surfaces (n_sol.z == 6.0) sustain and feed adjacent Fire (3.0)!
                if (abs(next_id) == 3.0 && round(n_sol.z) == 6.0) {
                    next_vol = min(1.0, next_vol + 0.38);
                    next_sleep = 0.0;
                }
                let rx = get_reaction(abs(next_id), 512u, abs(n_sol.x), 0u);
                if (rx.x != abs(next_id) + 512.0) {
                    if (round(n_sol.z) == 3.0 && abs(next_id) == 3.0) {
                        // Fire hitting a [WET] Water-stained block flashes to Steam (1.0)!
                        next_id = 1.0;
                    } else if (rx.x >= 512.0) {
                        next_id = rx.x - 512.0;
                    } else {
                        next_id = 0.0; next_vol = 0.0;
                    }
                    next_sleep = 0.0;
                    break;
                }
            }
            let n_liq = get_liquid(ip, nd, win_min);
            if (n_liq.y > 0.05 && n_liq.x > 0.5) {
                let rx = get_reaction(abs(next_id), 512u, abs(n_liq.x), 256u);
                if (rx.x != abs(next_id) + 512.0) {
                    if (rx.x >= 512.0) { next_id = rx.x - 512.0; } else { next_id = 0.0; next_vol = 0.0; }
                    next_sleep = 0.0;
                    break;
                }
            }
            let n_gas = get_gas(ip, nd, win_min);
            if (n_gas.y > 0.05 && n_gas.x > 0.5) {
                let rx = get_reaction(abs(next_id), 512u, abs(n_gas.x), 512u);
                if (rx.x != abs(next_id) + 512.0) {
                    if (rx.x >= 512.0) { next_id = rx.x - 512.0; } else { next_id = 0.0; next_vol = 0.0; }
                    next_sleep = 0.0;
                    break;
                }
            }
        }
    }
    
    if (my_liq.y > 0.04) {
        if (self_vol > 0.05 && abs(self_gas.x) > 0.5) {
            let rx_self = get_reaction(abs(my_liq.x), 256u, abs(self_gas.x), 512u);
            if (rx_self.x >= 512.0) {
                spawn_gas_id = rx_self.x - 512.0; spawn_gas_vol = 1.0;
            }
        }
        for (var i = 0u; i < 6u; i++) {
            if (spawn_gas_vol > 0.0) { break; }
            let nd = dirs6[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let n_sol = get_solid(ip, nd, win_min);
            if (n_sol.y <= 0.0 && abs(n_sol.x) > 0.5) {
                let rx = get_reaction(abs(my_liq.x), 256u, abs(n_sol.x), 0u);
                if (rx.x >= 512.0) {
                    spawn_gas_id = rx.x - 512.0; spawn_gas_vol = 1.0; break;
                }
            }
            let n_liq = get_liquid(ip, nd, win_min);
            if (n_liq.y > 0.05) {
                let rx = get_reaction(abs(my_liq.x), 256u, n_liq.x, 256u);
                if (rx.x >= 512.0) {
                    spawn_gas_id = rx.x - 512.0; spawn_gas_vol = 1.0; break;
                }
            }
            let n_gas = get_gas(ip, nd, win_min);
            if (n_gas.y > 0.05) {
                let rx = get_reaction(abs(my_liq.x), 256u, n_gas.x, 512u);
                if (rx.x >= 512.0) {
                    spawn_gas_id = rx.x - 512.0; spawn_gas_vol = 1.0; break;
                }
            }
        }
    } else if (my_sol.y <= 0.0 && abs(my_sol.x) > 0.5) {
        let is_wet_sol = round(my_sol.z) == 3.0;
        for (var i = 0u; i < 6u; i++) {
            let nd = dirs6[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let n_liq = get_liquid(ip, nd, win_min);
            if (n_liq.y > 0.05) {
                let rx = get_reaction(abs(my_sol.x), 0u, n_liq.x, 256u);
                if (rx.x >= 512.0) {
                    spawn_gas_id = select(rx.x - 512.0, 1.0, is_wet_sol && rx.x == 515.0);
                    spawn_gas_vol = 1.0; break;
                }
            }
            let n_gas = get_gas(ip, nd, win_min);
            if (n_gas.y > 0.05) {
                let rx = get_reaction(abs(my_sol.x), 0u, n_gas.x, 512u);
                if (rx.x >= 512.0) {
                    spawn_gas_id = select(rx.x - 512.0, 1.0, is_wet_sol && rx.x == 515.0);
                    spawn_gas_vol = 1.0; break;
                }
            }
        }
    } else {
        // 4.2. Passive Volatile Outgassing & Pyrophoric Air Ignition into open air above surface:
        // - Naphtha (11.0) slowly evaporates heavy Butane vapor (10.0) right on top of the hydrocarbon pool!
        // - Liquid Nitrogen (15.0) gently boils off cold vapor plumes (1.0) as it chills the cave!
        // - Rad-Ore (17.0) slowly exhales heavy radioactive Radon gas (12.0) into low cave basins!
        // - White Phosphorus (25.0) is pyrophoric: calm while submerged under Water, but spontaneously ignites into Fire (3.0) when exposed to open air!
        let liq_below = get_liquid(ip, down_d, win_min);
        if (liq_below.y > 0.35 && round(abs(liq_below.x)) == 11.0 && next_vol < 0.32) {
            spawn_gas_id = 10.0;
            spawn_gas_vol = 0.04;
        } else if (liq_below.y > 0.25 && round(abs(liq_below.x)) == 15.0 && next_vol < 0.28) {
            spawn_gas_id = 1.0;
            spawn_gas_vol = 0.035;
        } else {
            let sol_below = get_solid(ip, down_d, win_min);
            if (sol_below.y <= 0.0 && round(abs(sol_below.x)) == 17.0 && next_vol < 0.28) {
                spawn_gas_id = 12.0;
                spawn_gas_vol = 0.025;
            } else if (sol_below.y <= 0.0 && round(abs(sol_below.x)) == 25.0 && my_liq.y < 0.04 && next_vol < 0.35) {
                spawn_gas_id = 3.0;
                spawn_gas_vol = 0.85;
            }
        }
    }
    
    if (spawn_gas_vol > 0.0) {
        if (next_vol < 0.95) {
            next_id = spawn_gas_id;
            next_vol = min(1.0, next_vol + spawn_gas_vol);
            next_sleep = 0.0;
        }
    }



    // --- 5. Evaporate, decay and clamp (Chrono-scaled; detonation pulse flashes into Fire!) ---
    let tau_self = select(clamp(tg_self.x * 2.0, 0.0, 1.35), 0.0, tg_self.x < 0.12);
    let next_props = get_gas_props(next_id);
    let under_roof = is_solid(ip, up_d, win_min) || is_solid(ip, vec3<i32>(0, 2, 0), win_min);
    let eff_decay = select(next_props.decay, next_props.decay * 0.42, under_roof && (abs(next_id) == 4.0 || abs(next_id) == 1.0)) * tau_self;
    next_vol = max(0.0, next_vol - eff_decay);

    if (self_vel.w >= 4.3 || (abs(self_vel.w) > 2.05 && round(abs(next_id)) == 13.0 && next_vol > 0.10)) {
        next_id = 3.0; // Detonated explosive or shock-ignited Acetylene flashes into Fire!
        next_vol = 0.92;
        next_sleep = 0.0;
    } else if (abs(next_id) == 3.0 && next_vol > 0.0 && next_vol < 0.22) {
        next_id = 4.0; // Dying Fire plume turns into rising Smoke without creating excess volume!
        next_vol = min(0.24, next_vol + 0.04);
    } else if (next_vol < 0.01) {
        next_vol = 0.0;
        next_id = 0.0;
    }
    
    next_vol = clamp(next_vol, 0.0, 1.85);
    if (next_vol == 0.0) {
        next_id = 0.0;
    }

    if (abs(next_vol - self_vol) < 0.001 && self_v2 < 0.0004 && tau_self > 0.25) {
        next_sleep = min(next_sleep + 1.0, 10.0);
    } else {
        next_sleep = 0.0;
    }
    
    if (next_vol > 0.0) {
        next_age = next_age + tau_self;
    } else {
        next_age = 0.0;
    }

    output_buffer[idx] = vec4<f32>(next_id, next_vol, next_age, next_sleep);
}
"))

(def solid-sim-wgsl
  (String.append wgsl-tag-constants "
@group(0) @binding(0) var<storage, read>       input_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> output_buffer: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> solid_buffer: array<vec4<f32>>;
@group(0) @binding(4) var<storage, read>       registry_data: array<u32>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;
@group(0) @binding(8) var vel_texture:         texture_3d<f32>;

fn positive_mod(n: i32, m: i32) -> i32 {
    let r = n % m;
    if (r < 0) {
        return r + m;
    }
    return r;
}

fn get_win_min() -> vec3<i32> {
    let cx = i32(floor(u.cam_pos.x / 32.0)) - 2;
    let cy = i32(floor(u.cam_pos.y / 32.0)) - 2;
    let cz = i32(floor(u.cam_pos.z / 32.0)) - 2;
    return vec3<i32>(
        positive_mod(cx, 5) * 32,
        positive_mod(cy, 5) * 32,
        positive_mod(cz, 5) * 32
    );
}

fn step_in_window(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let lp = (base_ip - win_min + vec3<i32>(160)) % 160;
    let nlp = lp + delta;
    return nlp.x >= 0 && nlp.x < 160 && nlp.y >= 0 && nlp.y < 160 && nlp.z >= 0 && nlp.z < 160;
}

fn get_world_pos(ip: vec3<i32>, cam_pos: vec3<f32>) -> vec3<f32> {
    let cx = i32(floor(cam_pos.x / 32.0));
    let cy = i32(floor(cam_pos.y / 32.0));
    let cz = i32(floor(cam_pos.z / 32.0));
    
    let offset_cx = cx - 2;
    let offset_cy = cy - 2;
    let offset_cz = cz - 2;
    
    let slot_x = ip.x / 32;
    let slot_y = ip.y / 32;
    let slot_z = ip.z / 32;
    
    let lx = ip.x % 32;
    let ly = ip.y % 32;
    let lz = ip.z % 32;
    
    let qx = offset_cx + positive_mod(slot_x - positive_mod(offset_cx, 5), 5);
    let qy = offset_cy + positive_mod(slot_y - positive_mod(offset_cy, 5), 5);
    let qz = offset_cz + positive_mod(slot_z - positive_mod(offset_cz, 5), 5);
    
    let gx = qx * 32 + lx;
    let gy = qy * 32 + ly;
    let gz = qz * 32 + lz;
    
    return vec3<f32>(f32(gx), f32(gy), f32(gz));
}

fn get_solid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) {
        return vec4<f32>(255.0, -1.0, 0.0, 10.0);
    }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    let s_idx = u32(wrapped.x) + u32(wrapped.y) * 160u + u32(wrapped.z) * 25600u;
    return input_buffer[s_idx];
}

fn get_vel_sol(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(vel_texture, wrapped, 0);
}

fn effective_grain_vel(base_ip: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    var best = get_vel_sol(base_ip, vec3<i32>(0), win_min);
    var best_e = dot(best.xyz, best.xyz) + best.w * best.w * 0.25;
    let d6 = array<vec3<i32>, 6>(
        vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
        vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
        vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
    );
    for (var i = 0; i < 6; i = i + 1) {
        let nv = get_vel_sol(base_ip, d6[i], win_min);
        let ne = dot(nv.xyz, nv.xyz) + nv.w * nv.w * 0.25;
        if (ne > best_e) {
            best_e = ne;
            best = nv;
        }
    }
    return best;
}

fn has_law_tg_sol() -> bool {
    for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
        if (u.mancer_pos[mk].w > 0.05 && u.mancer_mat[mk].x >= 768.5) {
            let m_id = i32(round(u.mancer_mat[mk].x));
            if (m_id == 771 || m_id == 772) { return true; }
            if (m_id >= 780 && m_id <= 815) {
                let pair = m_id - 780;
                let l0 = pair / 6;
                let l1 = pair % 6;
                if (l0 == 2 || l0 == 3 || l1 == 2 || l1 == 3) { return true; }
            }
        }
    }
    return false;
}

fn eval_law_tg_sol(world_p: vec3<f32>, active_tg: bool) -> vec2<f32> {
    if (!active_tg) { return vec2<f32>(0.50, 0.50); }
    var tau: f32 = 0.50;
    var g_val: f32 = 0.50;
    for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
        let mp = u.mancer_pos[mk];
        let mm = u.mancer_mat[mk];
        if (mp.w > 0.05 && mm.x >= 768.5) {
            let m_id = i32(round(mm.x));
            var l0: i32 = -1;
            var l1: i32 = -1;
            if (m_id >= 769 && m_id <= 774) { l0 = m_id - 769; }
            else if (m_id >= 780 && m_id <= 815) {
                let pair = m_id - 780;
                l0 = pair / 6;
                l1 = pair % 6;
            }
            let dome_r = max(5.4, abs(mm.z) + 1.5);
            let dm = distance(world_p, mp.xyz);
            if (dm < dome_r) {
                let s_d = clamp(1.2 - dm / dome_r, 0.55, 1.0);
                let pol = select(mm.w, sign(mm.z), abs(mm.z) > 0.15);
                if (l0 == 2 || l1 == 2) {
                    g_val = select(min(g_val, mix(0.50, 0.04, s_d)), max(g_val, mix(0.50, 0.96, s_d)), pol >= 0.0);
                }
                if (l0 == 3 || l1 == 3) {
                    tau = select(min(tau, mix(0.50, 0.03, s_d)), max(tau, mix(0.50, 0.96, s_d)), pol >= 0.0);
                }
            }
        }
    }
    return vec2<f32>(tau, g_val);
}

fn grain_desired_step(s_ip: vec3<i32>, win_min: vec3<i32>, tick: f32, active_tg: bool) -> vec3<i32> {
    let slp = (s_ip - win_min + vec3<i32>(160)) % 160;
    if (slp.x <= 1 || slp.x >= 158 || slp.y <= 1 || slp.y >= 158 || slp.z <= 1 || slp.z >= 158) {
        return vec3<i32>(0);
    }
    let s_idx = u32(s_ip.x) + u32(s_ip.y) * 160u + u32(s_ip.z) * 25600u;
    let s = input_buffer[s_idx];
    if (s.y > 0.0 || abs(s.x) < 0.5 || abs(s.x) == 255.0 || abs(s.x) == 18.0) {
        return vec3<i32>(0);
    }
    let is_falling = s.x < -0.5;
    let is_granular = (get_mat_tags(abs(s.x), 0u) & TAG_GRANULAR) != 0u;
    let is_loose_grain = abs(s.y + 0.5) < 0.02;
    if (!is_falling) {
        // Only discrete poured/settled granular grains (s.y == -0.5) can be lifted by wind or -Gravimancer;
        // continuous smooth-SDF worldgen hills & packed arches stay cohesive!
        if (!is_granular || !is_loose_grain) {
            return vec3<i32>(0);
        }
    }
    let wp = get_world_pos(s_ip, u.cam_pos.xyz) + vec3<f32>(0.5);
    let tg = eval_law_tg_sol(wp, active_tg);
    if (tg.x < 0.14) {
        // Chronomancer -Stasis freezes airborne sand, gunpowder dust, & falling rubble motionless in mid-air!
        return vec3<i32>(0);
    }
    let gv = effective_grain_vel(s_ip, win_min);
    let w_spd = length(gv.xyz);
    let anti_g = tg.y < 0.30;
    if (!is_falling && !anti_g && w_spd < 1.35 && abs(gv.w) < 1.65) {
        return vec3<i32>(0);
    }

    let h1 = fract(sin(dot(vec3<f32>(s_ip), vec3<f32>(12.9898, 78.233, 37.719)) + tick * 1.37) * 43758.5453);
    let wind_lifts = select(w_spd > 3.10 || abs(gv.w) > 2.15, w_spd > 1.35 || abs(gv.w) > 1.65, is_granular);
    if (wind_lifts) {
        let lift_y = clamp(max(0.0, abs(gv.w) - 0.85) * 0.42 + max(0.0, w_spd - 1.35) * 0.30, 0.0, 1.15);
        let tv = gv.xyz + vec3<f32>(0.0, lift_y, 0.0);
        let ax = abs(tv.x);
        let ay = abs(tv.y);
        let az = abs(tv.z);
        let asum = ax + ay + az;
        if (asum > 0.20) {
            let pick = h1 * asum;
            var wd = vec3<i32>(0, 0, select(-1, 1, tv.z >= 0.0));
            if (pick < ax) {
                wd = vec3<i32>(select(-1, 1, tv.x >= 0.0), 0, 0);
            } else if (pick < ax + ay) {
                wd = vec3<i32>(0, select(-1, 1, tv.y >= 0.0), 0);
            }
            if (step_in_window(s_ip, wd, win_min) && get_solid(s_ip, wd, win_min).y > 0.0) {
                return wd;
            }
            if (w_spd > 1.75 && step_in_window(s_ip, vec3<i32>(0, 1, 0), win_min) && get_solid(s_ip, vec3<i32>(0, 1, 0), win_min).y > 0.0) {
                return vec3<i32>(0, 1, 0);
            }
        }
    }

    if (!is_falling && !anti_g) {
        return vec3<i32>(0);
    }

    let gy = select(-1, 1, anti_g);
    let vd = vec3<i32>(0, gy, 0);
    if (step_in_window(s_ip, vd, win_min) && get_solid(s_ip, vd, win_min).y > 0.0) {
        return vd;
    }
    let dx = select(-1, 1, h1 > 0.5);
    let dz = select(1, -1, h1 > 0.5);
    let diags = array<vec3<i32>, 4>(
        vec3<i32>(dx, gy, 0), vec3<i32>(-dx, gy, 0),
        vec3<i32>(0, gy, dz), vec3<i32>(0, gy, -dz)
    );
    for (var di = 0; di < 4; di = di + 1) {
        let dd = diags[di];
        if (step_in_window(s_ip, dd, win_min) && get_solid(s_ip, dd, win_min).y > 0.0) {
            return dd;
        }
    }
    return vec3<i32>(0);
}

fn claim_source(e_ip: vec3<i32>, win_min: vec3<i32>, tick: f32, active_tg: bool) -> vec3<i32> {
    let elp = (e_ip - win_min + vec3<i32>(160)) % 160;
    if (elp.x <= 1 || elp.x >= 158 || elp.y <= 1 || elp.y >= 158 || elp.z <= 1 || elp.z >= 158) {
        return vec3<i32>(0);
    }
    let cands = array<vec3<i32>, 14>(
        vec3<i32>(0, 1, 0), vec3<i32>(0, -1, 0),
        vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
        vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1),
        vec3<i32>(-1, 1, 0), vec3<i32>(1, 1, 0),
        vec3<i32>(0, 1, -1), vec3<i32>(0, 1, 1),
        vec3<i32>(-1, -1, 0), vec3<i32>(1, -1, 0),
        vec3<i32>(0, -1, -1), vec3<i32>(0, -1, 1)
    );
    for (var k = 0; k < 14; k = k + 1) {
        let off = cands[k];
        if (step_in_window(e_ip, off, win_min)) {
            let s_ip = (e_ip + off + vec3<i32>(160)) % 160;
            let want = grain_desired_step(s_ip, win_min, tick, active_tg);
            if (all(want == -off)) {
                return off;
            }
        }
    }
    return vec3<i32>(0);
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));
    let win_min = get_win_min();
    let zero_d = vec3<i32>(0, 0, 0);

    let self_sol = get_solid(ip, zero_d, win_min);
    let self_vol = self_sol.y;
    var next_id = self_sol.x;
    var next_vol = self_vol;
    var next_age = self_sol.z;
    var next_sleep = self_sol.w;

    let dummy_val = u.time + solid_buffer[0].x + vec4<f32>(bitcast<f32>(registry_data[0])).x + textureLoad(solid_texture, vec3<i32>(0), 0).x + textureLoad(liquid_texture, vec3<i32>(0), 0).x + textureLoad(gas_texture, vec3<i32>(0), 0).x + textureLoad(vel_texture, vec3<i32>(0), 0).x;
    if (dummy_val < -99999.0) { return; }

    let active_tg = has_law_tg_sol();
    let self_gv = effective_grain_vel(ip, win_min);
    let wind_wake = dot(self_gv.xyz, self_gv.xyz) > 0.08 || abs(self_gv.w) > 0.85;

    if (next_sleep >= 10.0 && !wind_wake) {
        let n1 = get_solid(ip, vec3<i32>(-1,0,0), win_min).w;
        let n2 = get_solid(ip, vec3<i32>(1,0,0), win_min).w;
        let n3 = get_solid(ip, vec3<i32>(0,-1,0), win_min).w;
        let n4 = get_solid(ip, vec3<i32>(0,1,0), win_min).w;
        let n5 = get_solid(ip, vec3<i32>(0,0,-1), win_min).w;
        let n6 = get_solid(ip, vec3<i32>(0,0,1), win_min).w;
        var match_near = false;
        let wp_s = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
        if (u.match_info.x > 0.5) {
            for (var mi = 0u; mi < 8u; mi++) {
                let m = u.matches[mi];
                if (m.w > 0.01 && distance(wp_s, m.xyz) <= 2.4) {
                    match_near = true;
                    break;
                }
            }
        }
        var law_near = false;
        if (active_tg) {
            let tg_s = eval_law_tg_sol(wp_s, true);
            if (tg_s.y < 0.30 || tg_s.x < 0.20) { law_near = true; }
        }
        var vox_near = false;
        let vox_cnt_s = min(u32(round(u.match_info.z)), 12u);
        for (var vi = 0u; vi < vox_cnt_s; vi++) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && abs(va.x) > 0.5 && abs(va.x) < 254.5 && abs(va.y) > 0.001 && distance(wp_s, vp.xyz) <= (vp.w + 8.5)) {
                vox_near = true;
                break;
            }
        }
        if (n1 >= 10.0 && n2 >= 10.0 && n3 >= 10.0 && n4 >= 10.0 && n5 >= 10.0 && n6 >= 10.0 && u.hit_pos.w == 0.0 && !match_near && !vox_near && !law_near) {
             output_buffer[idx] = self_sol;
             return;
        }
    }

    // --- 1-to-1 Bijection: Granular Wind Saltation, Blast Scour, Falling Sand & Lawmancer -G / -Chrono! ---
    let sim_tick = select(floor(u.time * 60.0), u.pad2, u.pad2 > 0.5);
    var grain_moved = false;
    if (self_vol > 0.0) {
        let src_off = claim_source(ip, win_min, sim_tick, active_tg);
        if (any(src_off != vec3<i32>(0))) {
            let src_sol = get_solid(ip, src_off, win_min);
            next_id = -abs(src_sol.x);
            next_vol = -0.5;
            next_age = src_sol.z;
            next_sleep = 0.0;
            grain_moved = true;
        }
    } else {
        let my_step = grain_desired_step(ip, win_min, sim_tick, active_tg);
        if (any(my_step != vec3<i32>(0)) && step_in_window(ip, my_step, win_min)) {
            let e_ip = (ip + my_step + vec3<i32>(160)) % 160;
            if (get_solid(ip, my_step, win_min).y > 0.0) {
                let win_off = claim_source(e_ip, win_min, sim_tick, active_tg);
                if (all(win_off == -my_step)) {
                    next_id = 0.0;
                    next_vol = 0.5;
                    next_age = 0.0;
                    next_sleep = 0.0;
                    grain_moved = true;
                }
            }
        }
    }

    if (!grain_moved && abs(next_vol - self_vol) < 0.001 && !wind_wake) {
        next_sleep = min(next_sleep + 1.0, 10.0);
    } else {
        next_sleep = 0.0;
    }
    
    if (next_vol <= 0.0 && next_id < 0.0 && next_sleep >= 10.0) {
        next_id = abs(next_id);
    }
    
    if ((next_vol > 0.0) == (self_vol > 0.0)) {
        next_age = self_sol.z;
    } else {
        next_age = 0.0;
    }


    // --- 2.5 Reaction Matrix Lookup (Toughness-Scaled Kinetics, Locked in Sync with Liquid/Gas Passes!) ---
    if (next_vol <= 0.0 && abs(next_id) > 0.5 && abs(next_id) != 255.0) {
        let s_id_u = clamp(u32(round(abs(next_id))), 0u, 255u);
        let s_tough = bitcast<f32>(registry_data[s_id_u * 8u + 6u]);
        let rx_prob = clamp(1.25 / max(s_tough, 0.8), 0.12, 1.0);
        let rx_hash_s = fract(sin(dot(vec3<f32>(ip), vec3<f32>(12.9898, 78.233, 37.719)) + floor(u.time * 60.0) * 1.17) * 43758.5453);
        let neighbors = array<vec3<i32>, 6>(
            vec3<i32>(1,0,0), vec3<i32>(-1,0,0),
            vec3<i32>(0,1,0), vec3<i32>(0,-1,0),
            vec3<i32>(0,0,1), vec3<i32>(0,0,-1)
        );
        for (var i = 0u; i < 6u; i++) {
            let nd = neighbors[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let nip = (ip + nd + vec3<i32>(160)) % 160;
            
            // 1. Check solid
            let n_sol = get_solid(ip, nd, win_min);
            if (n_sol.y <= 0.0 && abs(n_sol.x) > 0.5) {
                let rx = get_reaction(abs(next_id), 0u, abs(n_sol.x), 0u);
                if (rx.x != abs(next_id)) {
                    next_sleep = 0.0;
                    if (rx_hash_s < rx_prob) {
                        if (rx.x > 0.5 && rx.x < 256.0) { next_id = rx.x; } else { next_id = 0.0; next_vol = 2.2; }
                    }
                    break;
                }
            }
            
            // 2. Check liquid
            let n_liq = textureLoad(liquid_texture, nip, 0);
            if (n_liq.x > 0.5 && n_liq.y > 0.05) {
                let rx = get_reaction(abs(next_id), 0u, n_liq.x, 256u);
                if (rx.x != abs(next_id)) {
                    next_sleep = 0.0;
                    if (round(next_age) == 3.0 && rx.x == 515.0) {
                        next_age = 0.0;
                    } else if (rx_hash_s < rx_prob) {
                        if (rx.x > 0.5 && rx.x < 256.0) { next_id = rx.x; } else { next_id = 0.0; next_vol = 2.2; }
                    }
                    break;
                }
            }
            
            // 3. Check gas
            let n_gas = textureLoad(gas_texture, nip, 0);
            if (n_gas.x > 0.5 && n_gas.y > 0.05) {
                if (round(next_age) == 6.0 && n_gas.x == 3.0) {
                    // Oil stain on non-flammable stone burns off as it feeds the flame!
                    next_age = 0.0;
                }
                let rx = get_reaction(abs(next_id), 0u, n_gas.x, 512u);
                if (rx.x != abs(next_id)) {
                    next_sleep = 0.0;
                    if (round(next_age) == 3.0 && rx.x == 515.0) {
                        next_age = 0.0;
                    } else if (rx_hash_s < rx_prob) {
                        if (rx.x > 0.5 && rx.x < 256.0) { next_id = rx.x; } else { next_id = 0.0; next_vol = 2.2; }
                    }
                    break;
                }
            }
        }
    }

    // 3. Carve and Build natively on the GPU (Proper SDF Math; True Bedrock 255.0 & Abyssal Seal 18.0 are indestructible)
    if (u.hit_pos.w > 0.5) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz);
        let dist = distance(world_pos, u.hit_pos.xyz);
        
        if (u.solid_params.x > 998.0 && next_id != 255.0 && abs(next_id) != 18.0) { // Carving (Intersection)
            if (dist <= u.brush_radius + 8.0) {
                let carve_val = u.brush_radius - dist;
                if (carve_val > next_vol) {
                    next_vol = carve_val;
                    if (next_vol > 0.0) {
                        next_id = 0.0;
                    }
                }
            }
        } else if (u.solid_params.x > 0.0 && next_id != 255.0 && abs(next_id) != 18.0) { // Spawning Rigid (Union)
            if (dist <= u.brush_radius + 8.0) {
                let build_val = dist - u.brush_radius;
                if (build_val < next_vol) {
                    next_vol = build_val;
                    if (next_vol <= 0.0) {
                        next_id = u.solid_params.x;
                    }
                }
            }
        } else if (u.solid_params.x < 0.0 && next_id != 255.0 && abs(next_id) != 18.0) { // Spawning CA (Discrete)
            if (dist <= u.brush_radius) {
                next_vol = -0.5;
                next_id = u.solid_params.x;
                next_sleep = 0.0;
            }
        }
    }

    // 3.2. Multi-Slot GPU Voxel Action Queue (Solids: Carve va.y < 0, Cohesive Pack va.y > 0 && va.x > 0, Granular Pour va.y > 0 && va.x < 0)
    let vox_cnt = min(u32(round(u.match_info.z)), 12u);
    if (vox_cnt > 0u) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz);
        for (var vi: u32 = 0u; vi < vox_cnt; vi = vi + 1u) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && abs(va.x) > 0.5 && abs(va.x) < 254.5 && abs(va.y) > 0.001) {
                let fdist = distance(world_pos, vp.xyz);
                let sr = vp.w;
                let is_gold_melt = abs(abs(va.x) - 5.0) < 0.2;
                if (va.y < 0.0) {
                    if (next_id != 255.0 && (abs(next_id) != 18.0 || is_gold_melt) && fdist <= sr + 8.0) {
                        let carve_val = sr - fdist;
                        if (carve_val > next_vol) {
                            next_vol = carve_val;
                            if (next_vol > 0.0) { next_id = 0.0; }
                            next_sleep = 0.0;
                        }
                    }
                } else if (va.x > 0.0) {
                    if (next_id != 255.0 && abs(next_id) != 18.0 && fdist <= sr + 8.0) {
                        let build_val = fdist - sr;
                        if (build_val < next_vol) {
                            let was_empty = next_vol > 0.0;
                            next_vol = build_val;
                            if (next_vol <= 0.0 && was_empty) { next_id = va.x; }
                            next_sleep = 0.0;
                        }
                    }
                } else {
                    if (abs(next_id) == 18.0 && is_gold_melt && fdist <= sr + 8.0) {
                        // Pouring 24k Gold (-5.0) onto Abyssal Seal (18.0) smoothly melts the Seal's SDF!
                        let carve_val = sr - fdist;
                        if (carve_val > next_vol) {
                            next_vol = carve_val;
                            if (next_vol > 0.0) { next_id = 0.0; }
                            next_sleep = 0.0;
                        }
                    } else if (next_vol > 0.0 && fdist <= sr) {
                        next_vol = -0.5;
                        next_id = va.x;
                        next_sleep = 0.0;
                    }
                }
            }
        }
    }


    if (next_vol <= 0.0 && next_id != 255.0 && abs(next_id) != 18.0 && get_vel_sol(ip, zero_d, win_min).w >= 4.3) {
        next_id = 0.0;
        next_vol = 2.2;
        next_age = 0.0;
        next_sleep = 0.0;
    }

    output_buffer[idx] = vec4<f32>(next_id, next_vol, next_age, next_sleep);
}
"))


(def field-sim-wgsl
  (String.append wgsl-tag-constants "
@group(0) @binding(0) var<storage, read>       field_in: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> field_out: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> solid_buffer: array<vec4<f32>>; // read/write so we can break things!
@group(0) @binding(4) var<storage, read>       registry_data: array<u32>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;
@group(0) @binding(8) var<storage, read_write> light_buffer: array<vec4<f32>>; // buffer backed light!
@group(0) @binding(9) var vel_texture:         texture_3d<f32>;

fn positive_mod(n: i32, m: i32) -> i32 {
    let r = n % m;
    if (r < 0) {
        return r + m;
    }
    return r;
}

fn get_win_min() -> vec3<i32> {
    let cx = i32(floor(u.cam_pos.x / 32.0)) - 2;
    let cy = i32(floor(u.cam_pos.y / 32.0)) - 2;
    let cz = i32(floor(u.cam_pos.z / 32.0)) - 2;
    return vec3<i32>(
        positive_mod(cx, 5) * 32,
        positive_mod(cy, 5) * 32,
        positive_mod(cz, 5) * 32
    );
}

fn step_in_window(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let lp = (base_ip - win_min + vec3<i32>(160)) % 160;
    let nlp = lp + delta;
    return nlp.x >= 0 && nlp.x < 160 && nlp.y >= 0 && nlp.y < 160 && nlp.z >= 0 && nlp.z < 160;
}

fn get_solid(p: vec3<i32>) -> vec4<f32> {
    let wrapped = (p + vec3<i32>(160)) % 160;
    let s_idx = u32(wrapped.x) + u32(wrapped.y) * 160u + u32(wrapped.z) * 25600u;
    return solid_buffer[s_idx];
}

// Basic utility to parse material tags
fn get_tags(id: f32) -> u32 {
    if (id < 0.5) { return 0u; }
    let mat_id = clamp(u32(round(id)), 0u, 255u);
    let idx = (256u + mat_id) * 8u;
    return registry_data[idx + 7u];
}

fn get_world_pos(ip: vec3<i32>, cam_pos: vec3<f32>) -> vec3<f32> {
    let cx = i32(floor(cam_pos.x / 32.0));
    let cy = i32(floor(cam_pos.y / 32.0));
    let cz = i32(floor(cam_pos.z / 32.0));
    let offset_cx = cx - 2;
    let offset_cy = cy - 2;
    let offset_cz = cz - 2;
    let slot_x = ip.x / 32;
    let slot_y = ip.y / 32;
    let slot_z = ip.z / 32;
    let lx = ip.x % 32;
    let ly = ip.y % 32;
    let lz = ip.z % 32;
    let qx = offset_cx + positive_mod(slot_x - positive_mod(offset_cx, 5), 5);
    let qy = offset_cy + positive_mod(slot_y - positive_mod(offset_cy, 5), 5);
    let qz = offset_cz + positive_mod(slot_z - positive_mod(offset_cz, 5), 5);
    return vec3<f32>(f32(qx * 32 + lx), f32(qy * 32 + ly), f32(qz * 32 + lz));
}

// IEEE-754 exact mantissa pair packing (2 x 12-bit [0..1] in finite f32)
fn pack_pair(a: f32, b: f32) -> f32 {
    let qa = floor(clamp(a, 0.0, 1.0) * 4095.0 + 0.5);
    let qb = clamp(b, 0.0, 1.0) * 0.9992;
    return qa + qb;
}

fn unpack_pair(p: f32) -> vec2<f32> {
    let cp = max(0.0, p);
    let qa = floor(cp);
    let qb = (cp - qa) / 0.9992;
    return vec2<f32>(clamp(qa / 4095.0, 0.0, 1.0), clamp(qb, 0.0, 1.0));
}

// IEEE-754 exact mantissa quartet packing (4 x 6-bit [0..1] in finite f32)
fn pack_quartet(v: vec4<f32>) -> f32 {
    let q = floor(clamp(v, vec4<f32>(0.0), vec4<f32>(1.0)) * 63.0 + vec4<f32>(0.5));
    return q.x + q.y * 64.0 + q.z * 4096.0 + q.w * 262144.0;
}

fn unpack_quartet(p: f32) -> vec4<f32> {
    let cp = max(0.0, floor(p + 0.5));
    let qx = cp % 64.0;
    let qy = floor(cp / 64.0) % 64.0;
    let qz = floor(cp / 4096.0) % 64.0;
    let qw = floor(cp / 262144.0) % 64.0;
    return clamp(vec4<f32>(qx, qy, qz, qw) / 63.0, vec4<f32>(0.0), vec4<f32>(1.0));
}

fn unpack_air_tp(f: vec4<f32>) -> vec2<f32> {
    if (f.w > -0.5) { return vec2<f32>(0.20, 0.0); }
    return unpack_pair(f.x);
}

fn unpack_air_vm(f: vec4<f32>) -> vec2<f32> {
    if (f.w > -0.5) { return vec2<f32>(0.0, 0.0); }
    return unpack_pair(f.y);
}

fn unpack_air_tg(f: vec4<f32>) -> vec2<f32> {
    if (f.w > -0.5) { return vec2<f32>(0.50, 0.50); }
    return unpack_pair(f.z);
}

fn unpack_air_rec(f: vec4<f32>) -> vec4<f32> {
    if (f.w > -0.5) { return vec4<f32>(0.0); }
    return unpack_quartet(-f.w - 1.0);
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));
    let win_min = get_win_min();
    let lp = (ip - win_min + vec3<i32>(160)) % 160;
    let world_p = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);

    let sol = solid_buffer[idx];
    // Dummy use of all bindings to prevent WebGPU from optimizing them out of the pipeline layout!
    let dummy_val = u.time + textureLoad(solid_texture, vec3<i32>(0), 0).x + textureLoad(liquid_texture, vec3<i32>(0), 0).x + textureLoad(gas_texture, vec3<i32>(0), 0).x + textureLoad(vel_texture, vec3<i32>(0), 0).x + vec4<f32>(bitcast<f32>(registry_data[0])).x;
    if (dummy_val < -99999.0) { return; }

    let raw_sol = textureLoad(solid_texture, ip, 0);
    let raw_liq = textureLoad(liquid_texture, ip, 0);
    let raw_gas = textureLoad(gas_texture, ip, 0);
    let raw_vel = textureLoad(vel_texture, ip, 0);
    let liq_id_u = clamp(u32(round(abs(raw_liq.r))), 0u, 255u);
    let gas_id_u = clamp(u32(round(abs(raw_gas.r))), 0u, 255u);

    // 6-neighbor stencil offsets
    let dirs6 = array<vec3<i32>, 6>(
        vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
        vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
        vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
    );

    // Track normalized structural stress [0..1] for packing into light_buffer.a
    var solid_stress: f32 = 0.0;
    var air_voltage: f32 = 0.0;
    var emit_darklight: bool = false;
    var law_flare: f32 = 0.0;

    if (sol.y <= 0.0 && sol.x <= 0.0) {
        // Falling Sand or empty interior voxel: keep field_out zeroed so it never leaks into Air or Solid passes!
        field_out[idx] = vec4<f32>(0.0);
        if (sol.x < -0.5) {
            solid_stress = 0.78;
        }
    } else if (sol.y > 0.0) {
        // =====================================================================
        // AIR VOXEL: Master Ambient Field Architecture in field_out[idx]
        //   .x = pack_pair(Temperature T, Pressure P)
        //   .y = pack_pair(Voltage V, Magnetic Potential M)
        //   .z = pack_pair(Chrono tau, Gravity G)
        //   .w = -(1.0 + pack_quartet(Prey/Blood, Siren Stank, Fear/Apex, Neuro-Spore)) [strictly <= -1.0!]
        // Plus Refractive Index Offset Delta_n in solid_buffer[idx].z!
        // =====================================================================
        let self_f = field_in[idx];
        let self_tp = unpack_air_tp(self_f);
        let self_vm = unpack_air_vm(self_f);
        let self_tg = unpack_air_tg(self_f);
        let self_rec = unpack_air_rec(self_f);

        var sum_T: f32 = 0.0;
        var t_cnt: f32 = 0.0;
        var updraft_T: f32 = 0.20;
        var sum_P: f32 = 0.0;
        var max_V: f32 = self_vm.x * 0.72;
        var sum_M: f32 = 0.0;
        var sum_tau: f32 = 0.0;
        var sum_G: f32 = 0.0;
        var air_cnt: f32 = 0.0;
        var p_neg = vec3<f32>(self_tp.y);
        var p_pos = vec3<f32>(self_tp.y);
        var rec_acc = self_rec * 0.36;
        var rec_w: f32 = 0.36;

        // First pass over 6 neighbors: gather T (with upward buoyancy chimney bias!), P, V, M, tau, G
        for (var i = 0u; i < 6u; i++) {
            let nd = dirs6[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let nip = (ip + nd + vec3<i32>(160)) % 160;
            let n_idx = u32(nip.x) + u32(nip.y) * 160u + u32(nip.z) * 25600u;
            let n_sol_tex = textureLoad(solid_texture, nip, 0);
            if (n_sol_tex.g > 0.0) {
                let nf = field_in[n_idx];
                let ntp = unpack_air_tp(nf);
                let nvm = unpack_air_vm(nf);
                let ntg = unpack_air_tg(nf);
                // Upward convective buoyancy: pull hot air strongly from the voxel below (i == 2u, nd.y == -1)!
                let tw = select(1.0, 2.5, i == 2u && ntp.x > 0.23);
                sum_T += ntp.x * tw;
                t_cnt += tw;
                sum_P += ntp.y;
                max_V = max(max_V, nvm.x * 0.80);
                sum_M += nvm.y;
                sum_tau += ntg.x;
                sum_G += ntg.y;
                air_cnt += 1.0;
                if (i == 0u) { p_neg.x = ntp.y; }
                if (i == 1u) { p_pos.x = ntp.y; }
                if (i == 2u) {
                    p_neg.y = ntp.y;
                    // Vertical chimney updraft: hot plumes rise 4-5m straight up above Lava/Fire/Matches without flooding horizontally!
                    updraft_T = max(updraft_T, (ntp.x - 0.20) * 0.84 + 0.20);
                }
                if (i == 3u) { p_pos.y = ntp.y; }
                if (i == 4u) { p_neg.z = ntp.y; }
                if (i == 5u) { p_pos.z = ntp.y; }
                // Radiant heat from Lava (2) or Liquid Fire (7) in the neighbor below (even thin splashes > 0.01)!
                if (i == 2u) {
                    let nl_below = textureLoad(liquid_texture, nip, 0);
                    if (nl_below.g > 0.01) {
                        let nlid = round(abs(nl_below.r));
                        if (nlid == 2.0 || nlid == 7.0) {
                            updraft_T = max(updraft_T, 0.95);
                        }
                    }
                }
            } else if (n_sol_tex.r > 0.5) {
                // Solid neighbor boundary condition (read from immutable solid_texture!)
                let ns_id = u32(round(abs(n_sol_tex.r)));
                if (ns_id == 8u) {
                    sum_T += 0.06;
                    t_cnt += 1.0;
                } else if (n_sol_tex.b >= 2.5) {
                    let ns_stain = u32(round(n_sol_tex.b)) - 2u;
                    if (ns_stain == 5u) { rec_acc.x = max(rec_acc.x, 0.42); }
                    if (ns_stain == 6u) { rec_acc.y = max(rec_acc.y, 0.48); }
                } else if (n_sol_tex.b > 0.02 && n_sol_tex.b < 1.5) {
                    sum_T += clamp(0.20 + n_sol_tex.b, 0.20, 1.0);
                    t_cnt += 1.0;
                } else if (n_sol_tex.b < -0.05) {
                    max_V = max(max_V, clamp(-n_sol_tex.b * 0.88, 0.0, 1.0));
                    if (ns_id == 5u) { sum_M += clamp(-n_sol_tex.b * 0.80, 0.0, 1.0); }
                }
                if (ns_id == 15u) {
                    sum_tau += 0.35;
                    sum_G += 0.35;
                }
            }
        }

        let avg_T = select(self_tp.x, sum_T / t_cnt, t_cnt > 0.5);
        let avg_P = select(self_tp.y, sum_P / air_cnt, air_cnt > 0.5);
        var next_T = max(updraft_T, mix(mix(self_tp.x, avg_T, 0.45), 0.20, 0.14));
        var next_P = max(mix(self_tp.y, avg_P, 0.50) * 0.78, clamp(raw_vel.w * 0.42, 0.0, 0.92));
        var next_V = max_V;
        var next_M = mix(self_vm.y, sum_M / max(air_cnt, 1.0), 0.45) * 0.84;
        var next_tau = mix(mix(self_tg.x, select(0.50, sum_tau / air_cnt, air_cnt > 0.5), 0.35), 0.50, 0.10);
        var next_G = mix(mix(self_tg.y, select(0.50, sum_G / air_cnt, air_cnt > 0.5), 0.35), 0.50, 0.10);

        // Wind velocity u_wind = -grad(P) + thermal buoyancy updraft + 3D kinetic velocity field!
        let grad_P = (p_pos - p_neg) * 0.5;
        let wind = -grad_P * 1.8 + vec3<f32>(0.0, (next_T - 0.20) * 0.65, 0.0) + raw_vel.xyz * 0.85;

        // Second pass: upwind advection of the 4 Biochemical Receptors (.w)
        for (var i = 0u; i < 6u; i++) {
            let nd = dirs6[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let nip = (ip + nd + vec3<i32>(160)) % 160;
            let n_idx = u32(nip.x) + u32(nip.y) * 160u + u32(nip.z) * 25600u;
            let nf = field_in[n_idx];
            if (nf.w <= -0.5) {
                let n_rec = unpack_air_rec(nf);
                let align = clamp(1.0 - dot(vec3<f32>(nd), wind) * 1.25, 0.20, 2.0);
                let w_i = 0.11 * align;
                rec_acc += n_rec * w_i;
                rec_w += w_i;
            }
        }
        var next_rec = (rec_acc / max(rec_w, 0.01)) * 0.95;

        // Local Material & Fluid Field Injections (even thin Lava/Fire films > 0.01!)
        if (liq_id_u > 0u && raw_liq.g > 0.01) {
            if (liq_id_u == 2u) { next_T = max(next_T, 0.96); } // Lava
            if (liq_id_u == 7u) { next_T = max(next_T, 0.90); } // Liquid Fire
            if (liq_id_u == 15u) { next_T = min(next_T, 0.02); } // Liquid Nitrogen cryo-chilling
            if (liq_id_u == 5u) { next_rec.x = max(next_rec.x, 0.95); } // Blood -> Prey/Blood Receptor (R)
            if (liq_id_u == 6u) { next_rec.y = max(next_rec.y, 0.98); } // Ambrosia -> Siren/Pussy-Stank Receptor (G)
            if (raw_liq.b > 0.05) {
                next_V = max(next_V, raw_liq.b * 0.90);
                next_M = max(next_M, raw_liq.b * 0.60);
            }
        }
        if (gas_id_u > 0u && raw_gas.g > 0.02) {
            if (gas_id_u == 1u) { // Steam
                next_T = max(next_T, 0.45);
                next_P = max(next_P, clamp(raw_gas.g * 0.28, 0.0, 0.55));
            }
            if (gas_id_u == 3u) { // Fire (extra intense T & P when burning Oil 4u, Diesel 9u, Kerosene 10u, Naphtha 11u, or Nitroglycerin 14u!)
                let is_hc_pool = liq_id_u == 4u || (liq_id_u >= 9u && liq_id_u <= 11u) || liq_id_u == 14u;
                next_T = max(next_T, select(0.92, 0.98, is_hc_pool));
                next_P = max(next_P, select(0.22, 0.52, is_hc_pool));
                next_rec.z = max(next_rec.z, 0.65); // Fire projects Fear (B)
            }
            if (gas_id_u == 4u) { // Smoke from fire carries warm rising updraft!
                next_T = max(next_T, 0.48);
                next_P = max(next_P, 0.14);
            }
            if (gas_id_u == 8u || gas_id_u == 2u || gas_id_u == 11u || gas_id_u == 12u) { // Spore Cloud / Toxic Gas / Chlorine / Radon -> Neuro-Spore/Hazard Receptor (A)
                next_rec.w = max(next_rec.w, clamp(raw_gas.g * 1.15, 0.0, 1.0));
            }
            if (gas_id_u == 7u) { // Miasma -> Fear + Darklight resonance
                next_rec.z = max(next_rec.z, 0.55);
            }
        }

        // Thrown Lit [Z] Matches inject a rising candle-plume right above the burning match!
        if (u.match_info.x > 0.5) {
            for (var mi = 0u; mi < 8u; mi++) {
                let m = u.matches[mi];
                if (m.w > 0.01) {
                    let md = world_p - m.xyz;
                    if (md.y >= -0.4 && md.y <= 2.4) {
                        let r_horiz = length(md.xz);
                        if (r_horiz < 1.15) {
                            let h_fall = (1.0 - r_horiz / 1.15) * clamp(1.0 - max(0.0, md.y) / 2.4, 0.25, 1.0);
                            next_T = max(next_T, 0.42 + 0.50 * h_fall);
                        }
                    }
                }
            }
        }

        // Player scent trail (subtle Prey scent around player so Hoppers can track around blind baffles!)
        let d_player = distance(world_p, u.cam_pos.xyz);
        if (d_player < 2.2) {
            next_rec.x = max(next_rec.x, 0.72);
        }

        // GPU Detonation Spike in Ambient Field (T = 1.0, P = 1.0, blinding GI flash!)
        if (raw_vel.w >= 4.2) {
            next_T = 1.0;
            next_P = 1.0;
            law_flare = max(law_flare, 1.35);
        }

        // Predator Cloak / Mirage, Thermal Aura, Apex Ward & All 6 Lawmancer Field Laws!
        var cloak_dn: f32 = 0.0;
        for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
            let mp = u.mancer_pos[mk];
            if (mp.w > 0.05) {
                let dm = distance(world_p, mp.xyz);
                let mm = u.mancer_mat[mk];
                let mmat = round(mm.x);
                if (dm < 3.2) {
                    next_rec.z = max(next_rec.z, clamp(1.0 - dm / 3.2, 0.0, 0.90));
                }
                if (mmat < 768.5) {
                    if (dm < 3.2) {
                        if (mmat == 258.0 || mmat == 263.0 || mmat == 515.0) {
                            next_T = max(next_T, 0.42 + 0.52 * clamp(1.0 - dm / 2.8, 0.0, 1.0));
                        }
                        if (mmat == 9.0 || mmat == 14.0 || mmat == 15.0 || mmat == 16.0) {
                            let core = -0.045 * exp(-(dm * dm) / 0.85);
                            let ring = 0.032 * exp(-((dm - 1.55) * (dm - 1.55)) / 0.30);
                            cloak_dn += core + ring;
                        }
                        if (mmat == 16.0 && dm < 2.6) {
                            emit_darklight = true;
                        }
                    }
                } else {
                    // Lawmancer (769..774 Single Law, 780..815 Dual Law): Personal Shell + Wavefront + Gravi/Chrono Dome!
                    let m_id = i32(mmat);
                    var law0: i32 = -1;
                    var law1: i32 = -1;
                    if (m_id >= 769 && m_id <= 774) {
                        law0 = m_id - 769;
                    } else if (m_id >= 780 && m_id <= 815) {
                        let pair = m_id - 780;
                        law0 = pair / 6;
                        law1 = pair % 6;
                    }
                    let w_r = abs(mm.z);
                    let fall_p = clamp(1.0 - dm / 3.8, 0.0, 1.0);
                    let shell_d = abs(dm - w_r);
                    let fall_w = select(0.0, clamp(1.0 - shell_d / 1.95, 0.0, 1.0), w_r > 0.15 && shell_d < 1.95);
                    let s_law = max(fall_p, fall_w);
                    let dome_r = max(5.2, w_r + 1.4);
                    let s_dome = select(0.0, clamp(1.2 - dm / dome_r, 0.45, 1.0), dm < dome_r);
                    let pol = select(mm.w, sign(mm.z), fall_w > fall_p && w_r > 0.15);

                    for (var li: i32 = 0; li < 2; li = li + 1) {
                        let lw = select(law0, law1, li == 1);
                        if (lw < 0) { continue; }
                        if (lw == 0 && s_law > 0.01) {
                            if (pol >= 0.0) { next_T = max(next_T, mix(next_T, 0.96, s_law)); }
                            else { next_T = min(next_T, mix(next_T, 0.02, s_law)); }
                        } else if (lw == 1 && s_law > 0.01) {
                            if (pol >= 0.0) { next_P = max(next_P, 0.96 * s_law); }
                            else { next_P = next_P * (1.0 - s_law); }
                            cloak_dn += pol * 0.052 * s_law;
                        } else if (lw == 2 && s_dome > 0.01) {
                            if (pol >= 0.0) { next_G = max(next_G, mix(0.50, 0.96, s_dome)); }
                            else { next_G = min(next_G, mix(0.50, 0.04, s_dome)); }
                            cloak_dn += pol * 0.042 * max(s_law, s_dome * 0.5);
                        } else if (lw == 3 && s_dome > 0.01) {
                            if (pol >= 0.0) { next_tau = max(next_tau, mix(0.50, 0.96, s_dome)); }
                            else { next_tau = min(next_tau, mix(0.50, 0.03, s_dome)); }
                            cloak_dn -= 0.038 * max(s_law, s_dome * 0.5);
                        } else if (lw == 4 && s_law > 0.01) {
                            if (pol >= 0.0) { law_flare = max(law_flare, s_law); }
                            else if (s_law > 0.22) { emit_darklight = true; }
                        } else if (lw == 5 && s_law > 0.01) {
                            if (pol >= 0.0) {
                                next_V = max(next_V, 0.95 * s_law);
                                next_M = max(next_M, 0.92 * s_law);
                            } else {
                                next_V = max(next_V, 0.55 * s_law);
                                next_M = min(next_M, 0.05);
                            }
                        }
                    }
                }
            }
        }

        // High heat (> 350 C) rapidly denatures and incinerates biochemical pheromones & spores!
        if (next_T > 0.52) {
            next_rec *= 0.22;
        }

        air_voltage = next_V;
        field_out[idx] = vec4<f32>(
            pack_pair(next_T, next_P),
            pack_pair(next_V, next_M),
            pack_pair(next_tau, next_G),
            -(1.0 + pack_quartet(next_rec))
        );

        // Compute Refractive Index Offset Delta_n in rising heat plumes (T > 0.42), blast shockwaves, & hypersonic Mach wakes!
        let t_excess = max(0.0, next_T - 0.42);
        let p_excess = max(0.0, next_P - 0.16);
        let plume_wave = 1.0 + 0.72 * sin(u.time * 10.5 - world_p.y * 2.8 + sin(world_p.x * 2.2 + world_p.z * 2.0 + u.time * 4.2) * 1.5);
        let thermal_dn = -0.092 * t_excess * plume_wave;
        let shock_dn = 0.065 * p_excess;
        let mach_dn = clamp(raw_vel.w * 0.038, -0.055, 0.065);
        var target_dn = clamp(thermal_dn + shock_dn + mach_dn + cloak_dn, -0.078, 0.078);
        if (abs(target_dn) < 0.002) { target_dn = 0.0; }
        let prev_dn = select(raw_sol.b, 0.0, raw_sol.b >= 2.0);
        let smooth_dn = mix(prev_dn, target_dn, 0.32);
        let final_dn = select(smooth_dn, 0.0, abs(smooth_dn) < 0.0015);
        solid_buffer[idx] = vec4<f32>(sol.x, sol.y, final_dn, sol.w);
    } else {
        var max_neighbor_w = 0.0;
        var max_adj_T: f32 = 0.20;
        var max_adj_P: f32 = select(0.0, 1.0, raw_vel.w >= 4.2);
        var max_shock_p: f32 = select(0.0, 4.5, raw_vel.w >= 4.2);
        var max_adj_V: f32 = 0.0;
        var touches_acid_liq: bool = false;
        var touches_miasma: bool = false;
        var adj_stain_liq: f32 = 0.0;
        if (raw_vel.w >= 4.2) { law_flare = max(law_flare, 1.35); }
        if (liq_id_u > 0u && liq_id_u != 2u && raw_liq.g > 0.03) {
            adj_stain_liq = f32(liq_id_u);
        }
        
        // --- Step 1: Load Path Gradient (W) & Solid Boundary Field Probe ---
        var my_w = 0.0;
        for (var i = 0u; i < 6u; i++) {
            let nd = dirs6[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let nip = (ip + nd + vec3<i32>(160)) % 160;
            let n_idx = u32(nip.x) + u32(nip.y) * 160u + u32(nip.z) * 25600u;
            let n_sol = get_solid(nip);
            let n_vel = textureLoad(vel_texture, nip, 0);
            max_shock_p = max(max_shock_p, n_vel.w);
            if (n_vel.w >= 4.2) {
                max_adj_P = max(max_adj_P, 1.0);
                law_flare = max(law_flare, 0.95);
            }
            if (n_sol.y <= 0.0 && n_sol.x > 0.0) { // If neighbor is rigid solid
                let n_field = field_in[n_idx];
                var decay = 1.0;
                if (nd.y == -1) { decay = 0.0; }
                // If neighbor just turned from Air/Sand into Solid this frame (n_field.w <= 0.0), treat its support as 96.0!
                let nw = select(96.0, n_field.w, n_field.w > 0.0);
                let supported_w = max(0.0, nw - decay);
                if (supported_w > max_neighbor_w) {
                    max_neighbor_w = supported_w;
                }
                let n_sol_tex = textureLoad(solid_texture, nip, 0);
                if (n_sol_tex.g <= 0.0) {
                    if (n_sol_tex.b > 0.01 && n_sol_tex.b < 1.5) {
                        max_adj_T = max(max_adj_T, 0.20 + n_sol_tex.b * 0.92);
                    } else if (n_sol_tex.b < -0.02) {
                        max_adj_V = max(max_adj_V, -n_sol_tex.b * 0.90);
                    }
                }
            } else {
                let nf = field_in[n_idx];
                if (nf.w <= -0.5) {
                    let ntp = unpack_air_tp(nf);
                    let nvm = unpack_air_vm(nf);
                    max_adj_T = max(max_adj_T, ntp.x);
                    max_adj_P = max(max_adj_P, ntp.y);
                    max_adj_V = max(max_adj_V, nvm.x);
                }
                let nl = textureLoad(liquid_texture, nip, 0);
                if (nl.g > 0.04) {
                    let nl_id = round(abs(nl.r));
                    if (nl_id == 2.0) {
                        max_adj_T = max(max_adj_T, 0.96);
                    } else if (nl_id >= 1.0 && nl_id <= 15.0) {
                        if (adj_stain_liq < 0.5 || nl_id != 1.0) {
                            adj_stain_liq = nl_id;
                        }
                    }
                    if (nl_id == 3.0) { touches_acid_liq = true; }
                    if (nl.b > 0.05) { max_adj_V = max(max_adj_V, nl.b); }
                }
                let ng = textureLoad(gas_texture, nip, 0);
                if (ng.g > 0.05 && round(abs(ng.r)) == 7.0) {
                    touches_miasma = true;
                }
            }
        }
        if (sol.x == 255.0 || abs(sol.x) == 18.0 || lp.y <= 32 || lp.x <= 32 || lp.x >= 127 || lp.z <= 32 || lp.z >= 127) {
            my_w = 96.0; // Anchor at True Bedrock, Abyssal Seal & outer streaming shell of active 5x5x5 window
        } else {
            my_w = max_neighbor_w;
        }

        // --- Step 2: Accumulate Stress (X, Y, Z) + Overpressure / Sonic Boom Brittle Load ---
        var compressive = 0.0;
        var tensile = 0.0;
        var shear = 0.0;

        for (var i = 0u; i < 6u; i++) {
            let nd = dirs6[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let nip = (ip + nd + vec3<i32>(160)) % 160;
            let n_sol = get_solid(nip);
            if (n_sol.y <= 0.0 && n_sol.x > 0.0) {
                let n_idx = u32(nip.x) + u32(nip.y) * 160u + u32(nip.z) * 25600u;
                let n_field = field_in[n_idx];
                // ONLY accumulate structural stress from neighbors that already have valid solid stress state (n_field.w > 0.0)!
                if (n_field.w > 0.0) {
                    var decay = 1.0;
                    if (nd.y == 1) { decay = 0.0; }
                    
                    if (abs(n_field.w - (my_w - decay)) < 0.1) {
                        let n_mat_id = clamp(u32(round(n_sol.x)), 0u, 255u);
                        let n_reg_idx = n_mat_id * 8u;
                        let n_mass = bitcast<f32>(registry_data[n_reg_idx + 5u]);
                        
                        if (nd.y == 1) {
                            compressive += n_field.x * 0.88 + n_mass;
                        } else if (nd.y == -1) {
                            tensile += n_field.y * 0.85 + n_mass;
                        } else {
                            shear += n_field.z * 0.30 + n_field.x * 0.06 + n_mass * 0.25;
                        }
                    }
                }
            }
        }

        // --- Step 3: Break Condition & Solid Field Transmutations ---
        var broken = false;
        if (my_w <= 0.0 && sol.x != 255.0 && abs(sol.x) != 18.0) {
            broken = true;
        }

        let my_mat_id = clamp(u32(round(sol.x)), 0u, 255u);
        let my_reg_idx = my_mat_id * 8u;
        let toughness = bitcast<f32>(registry_data[my_reg_idx + 6u]);
        let my_tags = registry_data[my_reg_idx + 7u];
        let is_brittle = (my_tags & TAG_BRITTLE) != 0u;
        // Sonic booms (Mach Railgun wakes > 2.05) & blast waves shatter TAG_BRITTLE (Ice, Glass, Crystal, Amethyst),
        // while ordinary Bellows wind & thermal plumes never fracture solid cave walls or hillsides!
        if (is_brittle) {
            shear += max(0.0, max_shock_p - 2.05) * 320.0 + max(0.0, max_adj_P - 0.78) * 650.0;
        } else if (max_shock_p >= 4.2) {
            shear += 240.0;
        }
        let struct_t = max(toughness, 2.5);
        
        let limit_c = struct_t * 120.0; 
        let limit_t = struct_t * 50.0;
        let limit_s = struct_t * 60.0;
        
        if (sol.x != 255.0 && abs(sol.x) != 18.0) {
            if (compressive > limit_c || tensile > limit_t || shear > limit_s) {
                broken = true;
            }
            if (broken) {
                solid_stress = 1.0;
            } else {
                let rc = compressive / max(limit_c, 1.0);
                let rt = tensile / max(limit_t, 1.0);
                let rs = shear / max(limit_s, 1.0);
                var load_ratio = max(rc, max(rt, rs));
                let span = max(0.0, 96.0 - my_w);
                if (span > 0.5 && load_ratio > 0.035) {
                    load_ratio = max(load_ratio, clamp(load_ratio * (1.0 + span * 0.16) + span * 0.022, 0.0, 0.98));
                }
                solid_stress = clamp(load_ratio, 0.0, 1.0);
            }
        }

        // Solid Thermal, Piezoelectric/Galvanic, & Surface Stain State in solid_buffer[idx].z
        var next_sol_id = sol.x;
        var next_sol_z: f32 = select(raw_sol.b * 0.88, raw_sol.b, raw_sol.b >= 2.5);
        if ((my_tags & TAG_STAINABLE) != 0u) {
            if (adj_stain_liq > 0.5) {
                next_sol_z = 2.0 + adj_stain_liq;
            } else if (next_sol_z >= 2.5) {
                // High heat dries out wet rock (3.0) or burns off surface stains!
                if ((round(next_sol_z) == 3.0 && max_adj_T > 0.44) || max_adj_T > 0.62) {
                    next_sol_z = 0.0;
                }
            }
        }
        if (my_mat_id == 5u) {
            // 24k Gold Vein: high-diffusivity Fourier heat conductor (+z) AND electric conductor (-z)
            if (touches_acid_liq) {
                next_sol_z = -0.92; // Galvanic Gold+Acid cave battery electrode!
                air_voltage = 0.92;
            } else if (max_adj_V > 0.15) {
                next_sol_z = -clamp(max_adj_V * 0.90, 0.0, 1.0);
                air_voltage = -next_sol_z;
            } else if (max_adj_T > 0.28) {
                next_sol_z = clamp((max_adj_T - 0.20) * 0.92, 0.0, 0.80);
            }
        } else if ((my_mat_id == 14u || my_mat_id == 15u) && solid_stress > 0.58) {
            // Piezoelectric Crystal (14) / Amethyst (15): high pillar stress generates high voltage!
            let piezo_v = clamp((solid_stress - 0.55) * 1.85, 0.0, 1.0);
            next_sol_z = -piezo_v;
            air_voltage = piezo_v;
        }

        // Obsidian (16) + Miasma (519) emits Negative GI Darklight!
        if (my_mat_id == 16u && touches_miasma) {
            emit_darklight = true;
        }

        // Emergent Solid Transmutations:
        // 1. Sealed-Chamber Fourier Flashpoint Auto-Ignition on Gunpowder (7) & C4 (12)
        if ((my_mat_id == 7u || my_mat_id == 12u) && max_adj_T > 0.72) {
            broken = true;
            next_sol_z = 0.80;
        }
        // 2. Fulgurite Glass Fusion: Lightning / High Voltage fuses Sand (6) into Glass (9)!
        if (my_mat_id == 6u && max_adj_V > 0.65) {
            next_sol_id = 9.0;
            broken = false;
        }
        // 3. High-Pressure Autoclave Synthesis: Stressed + Superheated Coal (4) crystallizes into Crystal (14)!
        if (my_mat_id == 4u && solid_stress > 0.72 && max_adj_T > 0.70) {
            next_sol_id = 14.0;
            broken = false;
        }

        if (broken) {
            solid_buffer[idx] = vec4<f32>(-abs(next_sol_id), -0.5, 0.0, 0.0);
            field_out[idx] = vec4<f32>(0.0);
        } else {
            solid_buffer[idx] = vec4<f32>(next_sol_id, sol.y, next_sol_z, sol.w);
            field_out[idx] = vec4<f32>(compressive, tensile, shear, my_w);
        }
    }

    // --- Step 4: Global Illumination (.rgb, with Negative GI Darklight!) + Smoothed Structural Stress (.a) ---
    let prev_entry = light_buffer[idx];
    let current_light = prev_entry.rgb;
    let prev_stress = prev_entry.a;
    var next_pos_light = max(vec3<f32>(0.0), current_light) * 0.90;
    var next_neg_light = min(vec3<f32>(0.0), current_light) * 0.90;
    var max_adj_solid_stress: f32 = 0.0;
    
    // Check neighbors to pull both positive light and negative Darklight across the active 5x5x5 window
    for (var i = 0u; i < 6u; i++) {
        let nd = dirs6[i];
        if (!step_in_window(ip, nd, win_min)) { continue; }
        let np = (ip + nd + vec3<i32>(160)) % 160;
        let n_idx = u32(np.x) + u32(np.y) * 160u + u32(np.z) * 25600u;
        let neighbor_entry = light_buffer[n_idx];
        let neighbor_light = neighbor_entry.rgb;
        
        let in_pos = max(vec3<f32>(0.0), neighbor_light - vec3<f32>(0.10, 0.10, 0.10));
        let in_neg = min(vec3<f32>(0.0), neighbor_light + vec3<f32>(0.10, 0.10, 0.10));
        next_pos_light = max(next_pos_light, in_pos);
        next_neg_light = min(next_neg_light, in_neg);

        // Dilate solid stress 1 voxel outward into adjacent surface-skin air so SDF zero-crossings don't dilute to 0
        if (sol.y > 0.0 && raw_sol.g < 1.8) {
            let n_sol_tex = textureLoad(solid_texture, np, 0);
            if (n_sol_tex.g <= 0.0 && abs(n_sol_tex.r) > 0.5) {
                max_adj_solid_stress = max(max_adj_solid_stress, neighbor_entry.a);
            }
        }
    }
    
    // Registry-driven TAG_LUMINESCENT emission across exposed cave solids, liquids, and gases (supports negative Darklight!)
    var is_lum_solid = false;
    let sol_id_abs = round(abs(raw_sol.r));
    if (raw_sol.g <= 0.0 && raw_sol.g > -1.6 && sol_id_abs > 0.5) {
        let s_base = clamp(u32(sol_id_abs), 0u, 255u) * 8u;
        let s_tags = registry_data[s_base + 7u];
        if ((s_tags & TAG_LUMINESCENT) != 0u) {
            is_lum_solid = true;
            let s_col = vec3<f32>(
                bitcast<f32>(registry_data[s_base + 1u]),
                bitcast<f32>(registry_data[s_base + 2u]),
                bitcast<f32>(registry_data[s_base + 3u])
            );
            let s_str = bitcast<f32>(registry_data[s_base + 4u]);
            if (s_str >= 0.0) {
                next_pos_light = max(next_pos_light, s_col * s_str);
            } else {
                next_neg_light = min(next_neg_light, s_col * s_str);
            }
        }
    }

    if (liq_id_u > 0u && raw_liq.g > 0.05) {
        let l_base = (256u + liq_id_u) * 8u;
        let l_tags = registry_data[l_base + 7u];
        if ((l_tags & TAG_LUMINESCENT) != 0u) {
            let l_col = vec3<f32>(
                bitcast<f32>(registry_data[l_base + 1u]),
                bitcast<f32>(registry_data[l_base + 2u]),
                bitcast<f32>(registry_data[l_base + 3u])
            );
            let l_str = bitcast<f32>(registry_data[l_base + 4u]);
            if (l_str >= 0.0) {
                next_pos_light = max(next_pos_light, l_col * l_str);
            } else {
                next_neg_light = min(next_neg_light, l_col * l_str);
            }
        }
    }

    if (gas_id_u > 0u && raw_gas.g > 0.05) {
        let g_base = (512u + gas_id_u) * 8u;
        let g_tags = registry_data[g_base + 7u];
        if ((g_tags & TAG_LUMINESCENT) != 0u) {
            let g_col = vec3<f32>(
                bitcast<f32>(registry_data[g_base + 1u]),
                bitcast<f32>(registry_data[g_base + 2u]),
                bitcast<f32>(registry_data[g_base + 3u])
            );
            let g_str = bitcast<f32>(registry_data[g_base + 4u]);
            if (g_str >= 0.0) {
                next_pos_light = max(next_pos_light, g_col * g_str);
            } else {
                next_neg_light = min(next_neg_light, g_col * g_str);
            }
        }
    }

    // Cave Lightning, Piezoelectric Discharge & Electrified Puddle Cyan-Violet Glow!
    let elec_glow = max(air_voltage, select(0.0, raw_liq.b, liq_id_u > 0u && raw_liq.g > 0.05));
    if (elec_glow > 0.12) {
        is_lum_solid = true;
        let arc_flicker = 0.82 + 0.28 * sin(u.time * 37.0 + f32(idx % 97u));
        next_pos_light = max(next_pos_light, vec3<f32>(0.38, 0.88, 2.75) * (elec_glow * arc_flicker));
    }

    // Photomancer Solar Flare & Blinding Detonation GI Flash!
    if (law_flare > 0.05) {
        is_lum_solid = true;
        next_pos_light = max(next_pos_light, vec3<f32>(3.4, 2.65, 1.55) * law_flare);
    }

    // Negative GI (Darklight) sink emission!
    if (emit_darklight) {
        is_lum_solid = true;
        next_neg_light = min(next_neg_light, vec3<f32>(-1.85, -1.65, -1.35));
    }

    // Held Luminescent Vessel (Crystal Sack, Lava/Ambrosia Flask, or Bottled Fire Bellows) acts as a live hand-lantern!
    if (u.match_info.y > 0.02 && u.flask_action.z > 0.5) {
        let f_mat = clamp(u32(round(u.flask_action.z)), 0u, 1023u);
        let f_base = f_mat * 8u;
        let f_tags = registry_data[f_base + 7u];
        if ((f_tags & TAG_LUMINESCENT) != 0u) {
            let hand_world = u.cam_pos.xyz + normalize(u.cam_right.xyz) * 0.4 + normalize(u.cam_dir.xyz) * 0.75;
            let hw = hand_world - floor(hand_world / 160.0) * 160.0;
            let hand_ip = vec3<i32>(clamp(hw, vec3<f32>(0.0), vec3<f32>(159.0)));
            if (all(ip == hand_ip)) {
                let f_col = vec3<f32>(
                    bitcast<f32>(registry_data[f_base + 1u]),
                    bitcast<f32>(registry_data[f_base + 2u]),
                    bitcast<f32>(registry_data[f_base + 3u])
                );
                let f_str = bitcast<f32>(registry_data[f_base + 4u]);
                next_pos_light = max(next_pos_light, f_col * f_str * (0.45 + 0.65 * u.match_info.y));
            }
        }
    }

    // Thrown Lit Matches act as warm flickering mobile cave torches as they bounce down shafts!
    if (u.match_info.x > 0.5) {
        for (var mi = 0u; mi < 8u; mi++) {
            let m = u.matches[mi];
            if (m.w > 0.01 && all(abs(m.xyz - u.cam_pos.xyz) < vec3<f32>(76.0))) {
                let mw = m.xyz - floor(m.xyz / 160.0) * 160.0;
                let mip = vec3<i32>(clamp(mw, vec3<f32>(0.0), vec3<f32>(159.0)));
                let d_ip = abs(ip - mip);
                if (d_ip.x <= 1 && d_ip.y <= 1 && d_ip.z <= 1) {
                    let flicker = 0.88 + 0.14 * sin(u.time * 23.0 + f32(mi) * 2.1);
                    let fall = select(0.58, 1.0, all(d_ip == vec3<i32>(0)));
                    next_pos_light = max(next_pos_light, vec3<f32>(1.0, 0.56, 0.16) * (2.75 * clamp(m.w + 0.25, 0.35, 1.0) * flicker * fall));
                }
            }
        }
    }

    // Bioluminescent & Burning Ditto-Amoebas act as crawling 3D Global Illumination cave-lanterns!
    var glow_mask = u32(round(u.critter_action.w));
    while (glow_mask != 0u) {
        let ak = firstTrailingBit(glow_mask);
        glow_mask = glow_mask & (glow_mask - 1u);
        let cl = u.critter_lights[ak];
        let cc = u.critter_colors[ak];
        if (abs(cl.w) > 0.5 && all(abs(cl.xyz - u.cam_pos.xyz) < vec3<f32>(76.0))) {
            let cw = cl.xyz - floor(cl.xyz / 160.0) * 160.0;
            let cip = vec3<i32>(clamp(cw, vec3<f32>(0.0), vec3<f32>(159.0)));
            let d_ip = abs(ip - cip);
            if (d_ip.x <= 1 && d_ip.y <= 1 && d_ip.z <= 1) {
                let pulse = 0.90 + 0.10 * sin(u.time * 4.8 + f32(ak) * 1.7);
                let fall = select(0.62, 1.0, all(d_ip == vec3<i32>(0)));
                if (cl.w >= 0.0) {
                    next_pos_light = max(next_pos_light, cc.rgb * (pulse * fall));
                } else {
                    next_neg_light = min(next_neg_light, -cc.rgb * (pulse * fall));
                }
            }
        }
    }
    
    var next_light = next_pos_light + next_neg_light;
    // Non-luminescent interior rock blocks light transmission while letting surface texels catch neighbor glow
    if (!is_lum_solid && raw_sol.g <= -0.5 && sol_id_abs != 0.0) { 
        next_light *= 0.05; 
    }
    
    var next_stress: f32 = 0.0;
    if (sol.y <= 0.0 && abs(sol.x) > 0.5) {
        next_stress = mix(prev_stress, solid_stress, 0.20);
    } else if (raw_sol.g < 1.8) {
        next_stress = max_adj_solid_stress;
    }
    light_buffer[idx] = vec4<f32>(next_light, next_stress);
}

"))

(def vel-sim-wgsl
  (String.append wgsl-tag-constants "
@group(0) @binding(0) var<storage, read_write> vel_out:        array<vec4<f32>>;
@group(0) @binding(1) var<uniform>             u:              Uniforms;
@group(0) @binding(2) var solid_texture:       texture_3d<f32>;
@group(0) @binding(3) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(4) var gas_texture:         texture_3d<f32>;
@group(0) @binding(5) var vel_texture:         texture_3d<f32>;
@group(0) @binding(6) var<storage, read>       field_in:       array<vec4<f32>>;
@group(0) @binding(7) var<storage, read>       registry_data:  array<u32>;

fn positive_mod(n: i32, m: i32) -> i32 {
    let r = n % m;
    if (r < 0) {
        return r + m;
    }
    return r;
}

fn get_win_min() -> vec3<i32> {
    let cx = i32(floor(u.cam_pos.x / 32.0)) - 2;
    let cy = i32(floor(u.cam_pos.y / 32.0)) - 2;
    let cz = i32(floor(u.cam_pos.z / 32.0)) - 2;
    return vec3<i32>(
        positive_mod(cx, 5) * 32,
        positive_mod(cy, 5) * 32,
        positive_mod(cz, 5) * 32
    );
}

fn get_world_pos(ip: vec3<i32>, cam_pos: vec3<f32>) -> vec3<f32> {
    let cx = i32(floor(cam_pos.x / 32.0));
    let cy = i32(floor(cam_pos.y / 32.0));
    let cz = i32(floor(cam_pos.z / 32.0));
    let offset_cx = cx - 2;
    let offset_cy = cy - 2;
    let offset_cz = cz - 2;
    let slot_x = ip.x / 32;
    let slot_y = ip.y / 32;
    let slot_z = ip.z / 32;
    let lx = ip.x % 32;
    let ly = ip.y % 32;
    let lz = ip.z % 32;
    let qx = offset_cx + positive_mod(slot_x - positive_mod(offset_cx, 5), 5);
    let qy = offset_cy + positive_mod(slot_y - positive_mod(offset_cy, 5), 5);
    let qz = offset_cz + positive_mod(slot_z - positive_mod(offset_cz, 5), 5);
    return vec3<f32>(f32(qx * 32 + lx), f32(qy * 32 + ly), f32(qz * 32 + lz));
}

fn unpack_pair_v(p: f32) -> vec2<f32> {
    let cp = max(0.0, p);
    let qa = floor(cp);
    let qb = (cp - qa) / 0.9992;
    return vec2<f32>(clamp(qa / 4095.0, 0.0, 1.0), clamp(qb, 0.0, 1.0));
}

fn unpack_air_tp_v(f: vec4<f32>) -> vec2<f32> {
    if (f.w > -0.5) { return vec2<f32>(0.20, 0.0); }
    return unpack_pair_v(f.x);
}

fn unpack_air_vm_v(f: vec4<f32>) -> vec2<f32> {
    if (f.w > -0.5) { return vec2<f32>(0.0, 0.0); }
    return unpack_pair_v(f.y);
}

fn unpack_air_tg_v(f: vec4<f32>) -> vec2<f32> {
    if (f.w > -0.5) { return vec2<f32>(0.50, 0.50); }
    return unpack_pair_v(f.z);
}

fn is_solid_ip(c_ip: vec3<i32>) -> bool {
    return textureLoad(solid_texture, c_ip, 0).g * 0.5 < 0.008;
}

fn load_vel_air(lp_c: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    let c_ip = (win_min + lp_c) % 160;
    let rv = textureLoad(vel_texture, c_ip, 0);
    if (is_solid_ip(c_ip)) {
        if (rv.w >= 4.3) { return vec4<f32>(0.0, 0.0, 0.0, rv.w); }
        return vec4<f32>(0.0);
    }
    return rv;
}

fn sample_vel_trilinear(back_lp: vec3<f32>, win_min: vec3<i32>) -> vec4<f32> {
    let b0 = clamp(back_lp - vec3<f32>(0.5), vec3<f32>(1.0), vec3<f32>(157.999));
    let i0 = vec3<i32>(floor(b0));
    let f = b0 - vec3<f32>(i0);
    let c000 = load_vel_air(i0 + vec3<i32>(0, 0, 0), win_min);
    let c100 = load_vel_air(i0 + vec3<i32>(1, 0, 0), win_min);
    let c010 = load_vel_air(i0 + vec3<i32>(0, 1, 0), win_min);
    let c110 = load_vel_air(i0 + vec3<i32>(1, 1, 0), win_min);
    let c001 = load_vel_air(i0 + vec3<i32>(0, 0, 1), win_min);
    let c101 = load_vel_air(i0 + vec3<i32>(1, 0, 1), win_min);
    let c011 = load_vel_air(i0 + vec3<i32>(0, 1, 1), win_min);
    let c111 = load_vel_air(i0 + vec3<i32>(1, 1, 1), win_min);
    let cx00 = mix(c000, c100, f.x);
    let cx10 = mix(c010, c110, f.x);
    let cx01 = mix(c001, c101, f.x);
    let cx11 = mix(c011, c111, f.x);
    let cxy0 = mix(cx00, cx10, f.y);
    let cxy1 = mix(cx01, cx11, f.y);
    return mix(cxy0, cxy1, f.z);
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    let dummy = u.time + textureLoad(solid_texture, vec3<i32>(0), 0).x +
                textureLoad(liquid_texture, vec3<i32>(0), 0).x +
                textureLoad(gas_texture, vec3<i32>(0), 0).x +
                textureLoad(vel_texture, vec3<i32>(0), 0).x +
                field_in[0].x + bitcast<f32>(registry_data[0]);
    if (dummy < -999999.0) {
        vel_out[idx] = vec4<f32>(0.0);
        return;
    }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));
    let win_min = get_win_min();
    let lp = (ip - win_min + vec3<i32>(160)) % 160;

    if (lp.x <= 1 || lp.x >= 158 || lp.y <= 1 || lp.y >= 158 || lp.z <= 1 || lp.z >= 158) {
        vel_out[idx] = vec4<f32>(0.0);
        return;
    }

    let raw_sol = textureLoad(solid_texture, ip, 0);
    let raw_liq = textureLoad(liquid_texture, ip, 0);
    let raw_gas = textureLoad(gas_texture, ip, 0);
    let self_v  = textureLoad(vel_texture, ip, 0);
    let world_p = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);

    // 0. Unified GPU Chemical, Thermobaric Dust & Sympathetic Shockwave Detonation Detector!
    // Stamps a single-frame hardware blast pulse (vel.w in [4.95 .. 5.90]) BEFORE solid obstacle zeroing!
    if (self_v.w < 4.2 && lp.x >= 4 && lp.x <= 155 && lp.y >= 4 && lp.y <= 155 && lp.z >= 4 && lp.z <= 155) {
        var expl_yield: f32 = 0.0;
        var shock_sens = false;
        var is_sodium = false;

        if (raw_sol.g <= 0.0) {
            let s_abs = round(abs(raw_sol.r));
            if (s_abs > 0.5 && s_abs != 1.0 && s_abs != 6.0 && s_abs != 255.0) {
                if ((get_mat_tags(s_abs, 0u) & TAG_EXPLOSIVE) != 0u) {
                    if (s_abs == 7.0) {
                        // Airborne Gunpowder (-7.0) triggers a high-brisance THERMOBARIC DUST EXPLOSION!
                        let dust = raw_sol.r < -0.5;
                        expl_yield = max(expl_yield, select(0.58, 0.94, dust));
                        if (dust) { shock_sens = true; }
                    } else if (s_abs == 12.0) {
                        expl_yield = max(expl_yield, 1.00);
                        shock_sens = true;
                    } else if (s_abs == 22.0) {
                        expl_yield = max(expl_yield, 0.65);
                        is_sodium = true;
                    } else {
                        expl_yield = max(expl_yield, 0.56);
                    }
                }
            }
        }
        if (raw_liq.g > 0.12) {
            let l_abs = round(abs(raw_liq.r));
            if (l_abs > 1.5) {
                if ((get_mat_tags(l_abs, 256u) & TAG_EXPLOSIVE) != 0u) {
                    if (l_abs == 14.0) {
                        expl_yield = max(expl_yield, 0.95);
                        shock_sens = true;
                    } else if (l_abs == 8.0) {
                        expl_yield = max(expl_yield, 0.72);
                    } else {
                        expl_yield = max(expl_yield, 0.62);
                    }
                }
            }
        }
        if (raw_gas.g > 0.18) {
            let g_abs = round(abs(raw_gas.r));
            if (g_abs > 1.5 && g_abs != 3.0 && g_abs != 4.0) {
                if ((get_mat_tags(g_abs, 512u) & TAG_EXPLOSIVE) != 0u) {
                    if (g_abs == 13.0) {
                        expl_yield = max(expl_yield, 0.88);
                        shock_sens = true;
                    } else if (g_abs == 9.0) {
                        expl_yield = max(expl_yield, 0.78);
                    } else if (g_abs == 10.0) {
                        expl_yield = max(expl_yield, 0.68);
                    } else {
                        expl_yield = max(expl_yield, 0.60);
                    }
                }
            }
        }

        if (expl_yield > 0.0) {
            var ignited = false;
            var max_shock = abs(self_v.w);
            let sf = field_in[idx];
            if (sf.w <= -0.5) {
                if (unpack_air_tp_v(sf).x > 0.74 || unpack_air_vm_v(sf).x > 0.68) { ignited = true; }
            }
            if (raw_gas.g > 0.08 && (get_mat_tags(abs(raw_gas.r), 512u) & TAG_IGNITER) != 0u) { ignited = true; }
            if (raw_liq.g > 0.08 && (get_mat_tags(abs(raw_liq.r), 256u) & TAG_IGNITER) != 0u) { ignited = true; }
            if (is_sodium && raw_liq.g > 0.08 && round(abs(raw_liq.r)) == 1.0) { ignited = true; }

            if (!ignited && u.match_info.x > 0.5) {
                for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
                    let m = u.matches[mi];
                    if (m.w > 0.01 && distance(world_p, m.xyz) <= 1.85) { ignited = true; break; }
                }
            }

            if (!ignited) {
                let d6 = array<vec3<i32>, 6>(
                    vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
                    vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
                    vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
                );
                for (var di: u32 = 0u; di < 6u; di = di + 1u) {
                    let nip = (win_min + lp + d6[di]) % 160;
                    let nv = textureLoad(vel_texture, nip, 0);
                    max_shock = max(max_shock, select(abs(nv.w), 3.6, nv.w >= 4.3));
                    let ng = textureLoad(gas_texture, nip, 0);
                    if (ng.g > 0.08 && (get_mat_tags(abs(ng.r), 512u) & TAG_IGNITER) != 0u) { ignited = true; break; }
                    let nl = textureLoad(liquid_texture, nip, 0);
                    if (nl.g > 0.08) {
                        let nlid = round(abs(nl.r));
                        if (is_sodium && nlid == 1.0) { ignited = true; break; }
                        if ((get_mat_tags(nlid, 256u) & TAG_IGNITER) != 0u) { ignited = true; break; }
                    }
                    let ns = textureLoad(solid_texture, nip, 0);
                    if (ns.g <= 0.0 && abs(ns.r) > 1.5 && (get_mat_tags(abs(ns.r), 0u) & TAG_IGNITER) != 0u) { ignited = true; break; }
                    let n_idx = u32(nip.x) + u32(nip.y) * 160u + u32(nip.z) * 25600u;
                    let nf = field_in[n_idx];
                    if (nf.w <= -0.5) {
                        if (unpack_air_tp_v(nf).x > 0.74 || unpack_air_vm_v(nf).x > 0.68) { ignited = true; break; }
                    }
                }
                if (!ignited && ((shock_sens && max_shock > 1.95) || max_shock > 3.10)) {
                    ignited = true;
                }
            }

            if (ignited) {
                vel_out[idx] = vec4<f32>(0.0, 0.35 * expl_yield, 0.0, 4.4 + 1.5 * expl_yield);
                return;
            }
        }
    }

    if (raw_sol.g * 0.5 < 0.008) {
        vel_out[idx] = vec4<f32>(0.0);
        return;
    }

    // Read local Master Ambient Field (T, P, tau, G) for two-way thermodynamic/barometric/chrono/gravitational coupling!
    let self_f = field_in[idx];
    let self_tp = unpack_air_tp_v(self_f);
    let self_tg = unpack_air_tg_v(self_f);
    let time_scale = clamp(self_tg.x * 2.0, 0.05, 1.85);

    // 1. Semi-Lagrangian backtrace in local window coordinates [1.5 .. 158.5], scaled by Chronomancer tau!
    let p_local = vec3<f32>(lp) + vec3<f32>(0.5);
    let adv_base = select(self_v, vec4<f32>(self_v.xyz, 3.6), self_v.w >= 4.3);
    let back_lp = clamp(p_local - adv_base.xyz * (0.65 * time_scale), vec3<f32>(1.5), vec3<f32>(158.5));
    var adv = sample_vel_trilinear(back_lp, win_min);
    adv.w = min(adv.w, 3.6);

    // 2. 6-neighbor divergence & dynamic + ambient pressure-gradient projection (with blast pulse pass-through)
    let ip_xm = (win_min + lp + vec3<i32>(-1, 0, 0)) % 160;
    let ip_xp = (win_min + lp + vec3<i32>( 1, 0, 0)) % 160;
    let ip_ym = (win_min + lp + vec3<i32>( 0,-1, 0)) % 160;
    let ip_yp = (win_min + lp + vec3<i32>( 0, 1, 0)) % 160;
    let ip_zm = (win_min + lp + vec3<i32>( 0, 0,-1)) % 160;
    let ip_zp = (win_min + lp + vec3<i32>( 0, 0, 1)) % 160;

    let s_xm = is_solid_ip(ip_xm);
    let s_xp = is_solid_ip(ip_xp);
    let s_ym = is_solid_ip(ip_ym);
    let s_yp = is_solid_ip(ip_yp);
    let s_zm = is_solid_ip(ip_zm);
    let s_zp = is_solid_ip(ip_zp);

    let r_xm = textureLoad(vel_texture, ip_xm, 0);
    let r_xp = textureLoad(vel_texture, ip_xp, 0);
    let r_ym = textureLoad(vel_texture, ip_ym, 0);
    let r_yp = textureLoad(vel_texture, ip_yp, 0);
    let r_zm = textureLoad(vel_texture, ip_zm, 0);
    let r_zp = textureLoad(vel_texture, ip_zp, 0);

    let v_xm = select(r_xm, vec4<f32>(0.0, 0.0, 0.0, select(adv.w, r_xm.w, r_xm.w >= 4.3)), s_xm);
    let v_xp = select(r_xp, vec4<f32>(0.0, 0.0, 0.0, select(adv.w, r_xp.w, r_xp.w >= 4.3)), s_xp);
    let v_ym = select(r_ym, vec4<f32>(0.0, 0.0, 0.0, select(adv.w, r_ym.w, r_ym.w >= 4.3)), s_ym);
    let v_yp = select(r_yp, vec4<f32>(0.0, 0.0, 0.0, select(adv.w, r_yp.w, r_yp.w >= 4.3)), s_yp);
    let v_zm = select(r_zm, vec4<f32>(0.0, 0.0, 0.0, select(adv.w, r_zm.w, r_zm.w >= 4.3)), s_zm);
    let v_zp = select(r_zp, vec4<f32>(0.0, 0.0, 0.0, select(adv.w, r_zp.w, r_zp.w >= 4.3)), s_zp);

    let f_xm = select(unpack_air_tp_v(field_in[u32(ip_xm.x) + u32(ip_xm.y) * 160u + u32(ip_xm.z) * 25600u]).y, self_tp.y, s_xm);
    let f_xp = select(unpack_air_tp_v(field_in[u32(ip_xp.x) + u32(ip_xp.y) * 160u + u32(ip_xp.z) * 25600u]).y, self_tp.y, s_xp);
    let f_ym = select(unpack_air_tp_v(field_in[u32(ip_ym.x) + u32(ip_ym.y) * 160u + u32(ip_ym.z) * 25600u]).y, self_tp.y, s_ym);
    let f_yp = select(unpack_air_tp_v(field_in[u32(ip_yp.x) + u32(ip_yp.y) * 160u + u32(ip_yp.z) * 25600u]).y, self_tp.y, s_yp);
    let f_zm = select(unpack_air_tp_v(field_in[u32(ip_zm.x) + u32(ip_zm.y) * 160u + u32(ip_zm.z) * 25600u]).y, self_tp.y, s_zm);
    let f_zp = select(unpack_air_tp_v(field_in[u32(ip_zp.x) + u32(ip_zp.y) * 160u + u32(ip_zp.z) * 25600u]).y, self_tp.y, s_zp);
    let grad_field_P = vec3<f32>(f_xp - f_xm, f_yp - f_ym, f_zp - f_zm) * 0.5;

    let div_v = ((v_xp.x - v_xm.x) + (v_yp.y - v_ym.y) + (v_zp.z - v_zm.z)) * 0.5;
    let avg_p = (min(v_xm.w, 3.8) + min(v_xp.w, 3.8) + min(v_ym.w, 3.8) + min(v_yp.w, 3.8) + min(v_zm.w, 3.8) + min(v_zp.w, 3.8)) / 6.0;
    let avg_v = (v_xm.xyz + v_xp.xyz + v_ym.xyz + v_yp.xyz + v_zm.xyz + v_zp.xyz) / 6.0;
    let grad_p = vec3<f32>(v_xp.w - v_xm.w, v_yp.w - v_ym.w, v_zp.w - v_zm.w) * 0.5;

    let base_drag = select(0.935, 0.84, raw_liq.g > 0.22);
    let drag = mix(0.992, base_drag, clamp(time_scale, 0.0, 1.0));
    let p_damp = mix(0.995, 0.88, clamp(time_scale, 0.0, 1.0));
    var next_p = mix(adv.w, avg_p, 0.34 * min(time_scale, 1.25)) * p_damp - div_v * (0.42 * time_scale) + max(0.0, self_tp.y - 0.36) * 0.05;
    var next_v = (mix(adv.xyz, avg_v, 0.08 * min(time_scale, 1.25)) - (grad_p * 0.58 + grad_field_P * 0.65) * time_scale) * drag;

    // 3. Swept Capsule Wake Injection (Single-frame blasts/Mach slugs add directly; sustained Bellows/Flask jets blend framerate-independently!)
    let wake_cnt = min(u32(round(u.pad1)), 16u);
    for (var wi: u32 = 0u; wi < wake_cnt; wi = wi + 1u) {
        let wp0 = u.wake_p0[wi];
        let wp1 = u.wake_p1[wi];
        let wv  = u.wake_vel[wi];
        let rad = wp0.w;
        if (rad > 0.05) {
            let seg = wp1.xyz - wp0.xyz;
            let seg_len2 = dot(seg, seg);
            let t_seg = select(0.0, clamp(dot(world_p - wp0.xyz, seg) / max(seg_len2, 0.0001), 0.0, 1.0), seg_len2 > 0.0001);
            let closest = wp0.xyz + seg * t_seg;
            let rel = world_p - closest;
            let d = length(rel);
            if (d < rad) {
                let u_fall = 1.0 - d / rad;
                let core_fall = u_fall * u_fall;
                let axis_dir = select(vec3<f32>(0.0), seg * inverseSqrt(max(seg_len2, 0.0001)), seg_len2 > 0.0001);
                let perp = rel - axis_dir * dot(rel, axis_dir);
                let perp_len = length(perp);
                let sph_dir = select(vec3<f32>(0.0, 1.0, 0.0), rel / max(d, 0.001), d > 0.001);
                let rad_dir = select(sph_dir, perp / max(perp_len, 0.001), perp_len > 0.001 && seg_len2 > 0.02);
                let sheath = smoothstep(0.0, 0.38, u_fall);
                let jet_v = rad_dir * (wp1.w * sheath) + wv.xyz * core_fall;
                let jet_p = wv.w * u_fall;
                if (abs(wv.w) > 1.65 || abs(wp1.w) > 2.10) {
                    next_v += jet_v;
                    next_p += jet_p;
                } else {
                    let k_jet = clamp(0.28 * u_fall + 0.08, 0.0, 0.42);
                    next_v = mix(next_v, jet_v, k_jet);
                    next_p = mix(next_p, jet_p, 0.26 * u_fall);
                }
            }
        }
    }

    // 4. Baromancer (Law 1 ONLY!) Expanding Shockwave / Implosion Rings + Thermal Buoyancy & Gravimancer Drift!
    for (var mk: u32 = 0u; mk < 4u; mk = mk + 1u) {
        let mp = u.mancer_pos[mk];
        let mm = u.mancer_mat[mk];
        let m_id = i32(round(mm.x));
        let is_baro = (m_id == 770) || (m_id >= 780 && m_id <= 815 && (((m_id - 780) / 6) == 1 || ((m_id - 780) % 6) == 1));
        if (is_baro && mp.w > 0.05 && abs(mm.z) > 0.15) {
            let w_r = abs(mm.z);
            let w_pol = sign(mm.z);
            let rel_m = world_p - mp.xyz;
            let dm = length(rel_m);
            let shell = abs(dm - w_r);
            if (shell < 1.45 && dm > 0.1) {
                let s_fall = 1.0 - shell / 1.45;
                let dir_m = rel_m / dm;
                next_v = mix(next_v, dir_m * (w_pol * 2.65 * s_fall), 0.38 * s_fall);
                next_p = mix(next_p, w_pol * 1.55 * s_fall, 0.35 * s_fall);
            }
        }
    }

    let g_buoy = (self_tg.y - 0.25) / 0.25;
    if (raw_gas.g > 0.08 && round(abs(raw_gas.r)) == 3.0) {
        next_v.y += 0.085 * min(raw_gas.g, 1.0) * g_buoy * time_scale;
    } else if (abs(self_tp.x - 0.20) > 0.08) {
        // Hot air plumes rise (and Cryo air sinks!), inverted when Gravimancer flips G < 0.25!
        next_v.y += (self_tp.x - 0.20) * 0.095 * g_buoy * time_scale;
    }
    if (abs(self_tg.y - 0.50) > 0.16) {
        next_v.y += (0.50 - self_tg.y) * 0.32 * time_scale;
    }

    // 5. Free-slip cave wall clamp (wakes splay tangentially along rock walls/floors instead of vanishing!)
    if (s_xm && next_v.x < 0.0) { next_v.x = 0.0; }
    if (s_xp && next_v.x > 0.0) { next_v.x = 0.0; }
    if (s_ym && next_v.y < 0.0) { next_v.y = 0.0; }
    if (s_yp && next_v.y > 0.0) { next_v.y = 0.0; }
    if (s_zm && next_v.z < 0.0) { next_v.z = 0.0; }
    if (s_zp && next_v.z > 0.0) { next_v.z = 0.0; }

    let v_mag = length(next_v);
    if (v_mag > 6.0) {
        next_v = next_v * (6.0 / v_mag);
    } else if (v_mag < 0.004) {
        next_v = vec3<f32>(0.0);
    }
    // Normal pressure clamps to [-3.8, 3.8] so >= 4.3 exclusively marks single-frame detonation pulses!
    next_p = clamp(next_p, -3.8, 3.8);
    if (abs(next_p) < 0.003) { next_p = 0.0; }

    vel_out[idx] = vec4<f32>(next_v, next_p);
}
"))


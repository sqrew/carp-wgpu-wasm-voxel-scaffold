(def pack-wgsl
  "@group(0) @binding(0) var<storage, read>       voxel_gpu_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> voxel_half_buffer: array<vec2<u32>>;

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    let val = voxel_gpu_buffer[idx];
    let p1 = pack2x16float(val.xy);
    let p2 = pack2x16float(val.zw);

    voxel_half_buffer[idx] = vec2<u32>(p1, p2);
}
")

(def copy-wgsl
  "struct Params {
    offset_x: f32,
    offset_y: f32,
    offset_z: f32,
    _pad: f32,
}

@group(0) @binding(0) var<storage, read>       staging_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> voxel_gpu_buffer_read: array<vec4<f32>>;
@group(0) @binding(2) var<storage, read_write> voxel_gpu_buffer_write: array<vec4<f32>>;
@group(0) @binding(3) var<uniform>             p: Params;
@group(0) @binding(4) var<storage, read_write> field_gpu_buffer_read: array<vec4<f32>>;
@group(0) @binding(5) var<storage, read_write> field_gpu_buffer_write: array<vec4<f32>>;
@group(0) @binding(6) var<storage, read_write> liquid_gpu_buffer: array<vec4<f32>>;
@group(0) @binding(7) var<storage, read_write> gas_gpu_buffer: array<vec4<f32>>;
@group(0) @binding(8) var<storage, read_write> light_gpu_buffer: array<vec4<f32>>;

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 32768u) { return; }

    let lx = idx % 32u;
    let ly = (idx / 32u) % 32u;
    let lz = idx / 1024u;

    let cpu_val = staging_buffer[idx];
    let seed_fluid = cpu_val.z;

    let ox = u32(p.offset_x);
    let oy = u32(p.offset_y);
    let oz = u32(p.offset_z);

    let gx = ox + lx;
    let gy = oy + ly;
    let gz = oz + lz;
    let g_idx = gx + gy * 160u + gz * 25600u;
    
    var final_val = cpu_val;
    if (final_val.x == 0.0) {
        final_val.z = 0.0;
    }

    voxel_gpu_buffer_read[g_idx] = final_val;
    voxel_gpu_buffer_write[g_idx] = final_val;
    light_gpu_buffer[g_idx] = vec4<f32>(0.0);

    if (final_val.y <= 0.0 && final_val.x > 0.0) {
        let init_field = vec4<f32>(0.0, 0.0, 0.0, 96.0);
        field_gpu_buffer_read[g_idx] = init_field;
        field_gpu_buffer_write[g_idx] = init_field;
    } else {
        field_gpu_buffer_read[g_idx] = vec4<f32>(0.0);
        field_gpu_buffer_write[g_idx] = vec4<f32>(0.0);
    }

    if (final_val.y > 0.0 && seed_fluid < -0.5) {
        liquid_gpu_buffer[g_idx] = vec4<f32>(abs(seed_fluid), 1.0, 0.0, 0.0);
        gas_gpu_buffer[g_idx] = vec4<f32>(0.0);
    } else if (final_val.y > 0.0 && seed_fluid > 0.5) {
        liquid_gpu_buffer[g_idx] = vec4<f32>(0.0);
        gas_gpu_buffer[g_idx] = vec4<f32>(seed_fluid, 0.9, 0.0, 0.0);
    } else {
        liquid_gpu_buffer[g_idx] = vec4<f32>(0.0);
        gas_gpu_buffer[g_idx] = vec4<f32>(0.0);
    }
}
")

(def wgsl-tag-constants "
const TAG_FLAMMABLE: u32 = 1u;
const TAG_IGNITER: u32 = 2u;
const TAG_EXPLOSIVE: u32 = 4u;
const TAG_MELTABLE: u32 = 8u;
const TAG_FREEZABLE: u32 = 16u;
const TAG_EVAPORABLE: u32 = 32u;
const TAG_CORRODIBLE: u32 = 64u;
const TAG_ACIDIC: u32 = 128u;
const TAG_SOLUBLE: u32 = 256u;
const TAG_CONDUCTIVE: u32 = 512u;
const TAG_SHOCKING: u32 = 1024u;
const TAG_GRANULAR: u32 = 2048u;
const TAG_LIGHT_FLUID: u32 = 4096u;
const TAG_HEAVY_GAS: u32 = 8192u;
const TAG_BRITTLE: u32 = 16384u;
const TAG_TOXIC: u32 = 32768u;
const TAG_HEALING: u32 = 65536u;
const TAG_RADIOACTIVE: u32 = 131072u;
const TAG_SLIPPERY: u32 = 262144u;
const TAG_STICKY: u32 = 524288u;
const TAG_BREATHABLE: u32 = 1048576u;
const TAG_LUMINESCENT: u32 = 2097152u;
const TAG_TRANSPARENT: u32 = 4194304u;
const TAG_EXTINGUISHER: u32 = 8388608u;
const TAG_INDESTRUCTIBLE: u32 = 16777216u;
const TAG_ANTI_GRAVITY: u32 = 33554432u;
const TAG_BOUNCY: u32 = 67108864u;
const TAG_ABSORBENT: u32 = 134217728u;
const TAG_DISSIPATES: u32 = 268435456u;
const TAG_ORGANIC: u32 = 536870912u;
const TAG_MAGNETIC: u32 = 1073741824u;
const TAG_STAINABLE: u32 = 2147483648u;


fn get_mat_tags(id: f32, cat: u32) -> u32 {
    if (id < 0.5) { return 0u; }
    let mat_id = clamp(u32(round(id)), 0u, 255u);
    let idx = (cat + mat_id) * 8u;
    return registry_data[idx + 7u];
}

fn get_reaction(id_A: f32, cat_A: u32, id_B: f32, cat_B: u32) -> vec2<f32> {
    if (id_A < 0.5 || id_B < 0.5) { return vec2<f32>(0.0, 0.0); }
    let a = cat_A + clamp(u32(round(id_A)), 0u, 255u);
    let b = cat_B + clamp(u32(round(id_B)), 0u, 255u);
    
    let offset = 8192u;
    let idx = offset + (a * 1024u + b) * 2u;
    
    let res_a = bitcast<f32>(registry_data[idx]);
    let res_b = bitcast<f32>(registry_data[idx + 1u]);
    return vec2<f32>(res_a, res_b);
}

struct Uniforms {
    time: f32,
    width: f32,
    height: f32,
    brush_radius: f32,
    cam_pos: vec4<f32>,
    cam_dir: vec4<f32>,
    cam_right: vec4<f32>,
    cam_up: vec4<f32>,
    sun_dir: vec4<f32>,
    hit_pos: vec4<f32>,
    edit_params: vec4<f32>,
    solid_params: vec4<f32>,
    entity_count: f32,
    pad1: f32,
    pad2: f32,
    pad3: f32,
    view_proj: mat4x4<f32>,
    flask_pos: vec4<f32>,
    flask_action: vec4<f32>,
    matches: array<vec4<f32>, 8>,
    match_info: vec4<f32>,
    critter_pos: vec4<f32>,
    critter_action: vec4<f32>,
    critter_lights: array<vec4<f32>, 16>,
    critter_colors: array<vec4<f32>, 16>,
    vox_pos: array<vec4<f32>, 12>,
    vox_act: array<vec4<f32>, 12>,
}
")

(def liquid-sim-wgsl
  (String.append wgsl-tag-constants "
struct LiquidProps {
    density: f32,
    g_rate: f32,
    l_rate: f32,
}

fn get_liq_props(id: f32) -> LiquidProps {
    if (id < 0.5) { return LiquidProps(0.0, 0.0, 0.0); }
    let mat_id = clamp(u32(round(id)), 0u, 255u);
    let idx = (256u + mat_id) * 8u;
    let density = bitcast<f32>(registry_data[idx + 5u]);
    let tags = registry_data[idx + 7u];
    
    var g = min(1.0, 0.4 / max(density, 0.1));
    var l = min(1.0, 0.2 / max(density, 0.1));
    let t_rate = abs(g) + 4.0 * l;
    if (t_rate > 1.0) {
        g = g / t_rate;
        l = l / t_rate;
    }
    if ((tags & TAG_STICKY) != 0u) {
        g = g * 0.05;
        l = l * 0.02;
    }
    return LiquidProps(density, g, l);
}

@group(0) @binding(0) var<storage, read>       input_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> output_buffer: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> solid_buffer: array<vec4<f32>>;
@group(0) @binding(4) var<storage, read>       registry_data: array<u32>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;
@group(0) @binding(8) var<storage, read_write> light_buffer: array<vec4<f32>>; // buffer backed light!

fn positive_mod(n: i32, m: i32) -> i32 {
    let r = n % m;
    if (r < 0) {
        return r + m;
    }
    return r;
}

fn get_win_min() -> vec3<i32> {
    let cx = i32(floor(u.cam_pos.x / 32.0)) - 2;
    let cy = i32(floor(u.cam_pos.y / 32.0)) - 2;
    let cz = i32(floor(u.cam_pos.z / 32.0)) - 2;
    return vec3<i32>(
        positive_mod(cx, 5) * 32,
        positive_mod(cy, 5) * 32,
        positive_mod(cz, 5) * 32
    );
}

fn step_in_window(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let lp = (base_ip - win_min + vec3<i32>(160)) % 160;
    let nlp = lp + delta;
    return nlp.x >= 0 && nlp.x < 160 && nlp.y >= 0 && nlp.y < 160 && nlp.z >= 0 && nlp.z < 160;
}

fn get_solid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(255.0, -1.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(solid_texture, wrapped, 0);
}

fn is_solid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let sol = get_solid(base_ip, delta, win_min);
    return sol.y * 0.5 < 0.008;
}

fn get_liquid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0, 0.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(liquid_texture, wrapped, 0);
}

fn get_gas(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0, 0.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(gas_texture, wrapped, 0);
}

fn is_explosion_center(p: vec3<i32>, win_min: vec3<i32>) -> bool {
    var is_exp = false;
    let zero_d = vec3<i32>(0, 0, 0);
    
    let g = get_gas(p, zero_d, win_min);
    if (g.y > 0.1) {
        let g_id = round(abs(g.x));
        if (g_id != 0.0 && g_id != 1.0 && g_id != 4.0) { // Optimize: skip common inert gases (Steam, Smoke)
            let mat_id = clamp(u32(g_id), 0u, 255u);
            let tags = registry_data[(512u + mat_id) * 8u + 7u];
            if ((tags & 4u) != 0u) { is_exp = true; } // TAG_EXPLOSIVE
        }
    }
    
    let l = get_liquid(p, zero_d, win_min);
    if (l.y > 0.1) {
        let l_id = round(abs(l.x));
        if (l_id != 0.0 && l_id != 1.0) { // Optimize: skip common inert liquids (Water)
            let mat_id = clamp(u32(l_id), 0u, 255u);
            let tags = registry_data[(256u + mat_id) * 8u + 7u];
            if ((tags & 4u) != 0u) { is_exp = true; }
        }
    }
    
    let s = get_solid(p, zero_d, win_min);
    if (s.y <= 0.0) {
        let s_id = round(abs(s.x));
        if (s_id != 0.0 && s_id != 1.0 && s_id != 6.0 && s_id != 255.0) { // Optimize: skip Empty, Stone, Sand, Bedrock
            let mat_id = clamp(u32(s_id), 0u, 255u);
            let tags = registry_data[mat_id * 8u + 7u];
            if ((tags & 4u) != 0u) { is_exp = true; }
        }
    }
    
    if (is_exp) {
        let dirs = array<vec3<i32>, 6>(
            vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
            vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
            vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
        );
        for (var i = 0; i < 6; i = i + 1) {
            let d = dirs[i];
            
            let n_g = get_gas(p, d, win_min);
            if (n_g.y > 0.1) {
                let n_id = round(abs(n_g.x));
                if (n_id != 0.0 && n_id != 1.0 && n_id != 4.0) {
                    let n_mat = clamp(u32(n_id), 0u, 255u);
                    let n_tags = registry_data[(512u + n_mat) * 8u + 7u];
                    if ((n_tags & 2u) != 0u) { return true; } // TAG_IGNITER
                }
            }
            
            let n_l = get_liquid(p, d, win_min);
            if (n_l.y > 0.1) {
                let n_id = round(abs(n_l.x));
                if (n_id != 0.0 && n_id != 1.0) {
                    let n_mat = clamp(u32(n_id), 0u, 255u);
                    let n_tags = registry_data[(256u + n_mat) * 8u + 7u];
                    if ((n_tags & 2u) != 0u) { return true; }
                }
            }
            
            let n_s = get_solid(p, d, win_min);
            if (n_s.y <= 0.0) {
                let n_id = round(abs(n_s.x));
                if (n_id != 0.0 && n_id != 1.0 && n_id != 6.0 && n_id != 255.0) {
                    let n_mat = clamp(u32(n_id), 0u, 255u);
                    let n_tags = registry_data[n_mat * 8u + 7u];
                    if ((n_tags & 2u) != 0u) { return true; }
                }
            }
        }
    }
    
    return false;
}

fn get_world_pos(ip: vec3<i32>, cam_pos: vec3<f32>) -> vec3<f32> {
    let cx = i32(floor(cam_pos.x / 32.0));
    let cy = i32(floor(cam_pos.y / 32.0));
    let cz = i32(floor(cam_pos.z / 32.0));
    
    let offset_cx = cx - 2;
    let offset_cy = cy - 2;
    let offset_cz = cz - 2;
    
    let slot_x = ip.x / 32;
    let slot_y = ip.y / 32;
    let slot_z = ip.z / 32;
    
    let lx = ip.x % 32;
    let ly = ip.y % 32;
    let lz = ip.z % 32;
    
    let qx = offset_cx + positive_mod(slot_x - positive_mod(offset_cx, 5), 5);
    let qy = offset_cy + positive_mod(slot_y - positive_mod(offset_cy, 5), 5);
    let qz = offset_cz + positive_mod(slot_z - positive_mod(offset_cz, 5), 5);
    
    let gx = qx * 32 + lx;
    let gy = qy * 32 + ly;
    let gz = qz * 32 + lz;
    
    return vec3<f32>(f32(gx), f32(gy), f32(gz));
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    // Dummy reads to prevent compiler from optimizing out unused bindings
    let dummy_val = input_buffer[0] + solid_buffer[0] + vec4<f32>(bitcast<f32>(registry_data[0]));
    if (dummy_val.x > 999999.0) {
        output_buffer[idx] = textureLoad(gas_texture, vec3<i32>(0), 0);
    }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));
    let win_min = get_win_min();
    let lp = (ip - win_min + vec3<i32>(160)) % 160;
    let zero_d = vec3<i32>(0, 0, 0);


    // --- 5. Explosion Carving (O(E) instead of O(N)) ---
    if (is_explosion_center(ip, win_min)) {
        for (var dx = -3; dx <= 3; dx = dx + 1) {
            for (var dy = -3; dy <= 3; dy = dy + 1) {
                for (var dz = -3; dz <= 3; dz = dz + 1) {
                    let d = vec3<i32>(dx, dy, dz);
                    if (length(vec3<f32>(d)) <= 3.5 && step_in_window(ip, d, win_min)) {
                        let wrapped = (ip + d + vec3<i32>(160)) % 160;
                        let s_idx = u32(wrapped.x) + u32(wrapped.y) * 160u + u32(wrapped.z) * 25600u;
                        if (solid_buffer[s_idx].x != 255.0) {
                            solid_buffer[s_idx] = vec4<f32>(0.0, 1.0, 0.0, 0.0);
                        }
                    }
                }
            }
        }
    }


    let sol_val = get_solid(ip, zero_d, win_min);
    let sol_id = sol_val.x;
    let is_sol_block = sol_val.y * 0.5 < 0.008;
    if (is_sol_block) {
        output_buffer[idx] = vec4<f32>(0.0);
        return;
    }

    let self_liq = get_liquid(ip, zero_d, win_min);
    let self_vol = self_liq.y;
    var next_id = self_liq.x;
    var next_vol = self_vol;
    var next_age = self_liq.z;
    var next_sleep = self_liq.w;
    
    if (next_sleep >= 10.0) {
        let n1 = get_liquid(ip, vec3<i32>(-1,0,0), win_min).w;
        let n2 = get_liquid(ip, vec3<i32>(1,0,0), win_min).w;
        let n3 = get_liquid(ip, vec3<i32>(0,-1,0), win_min).w;
        let n4 = get_liquid(ip, vec3<i32>(0,1,0), win_min).w;
        let n5 = get_liquid(ip, vec3<i32>(0,0,-1), win_min).w;
        let n6 = get_liquid(ip, vec3<i32>(0,0,1), win_min).w;
        let my_gas = get_gas(ip, zero_d, win_min).w;
        var match_near = false;
        let wp_l = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
        if (u.match_info.x > 0.5) {
            for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
                let m = u.matches[mi];
                if (m.w > 0.01 && distance(wp_l, m.xyz) <= 2.4) { match_near = true; break; }
            }
        }
        var vox_near = false;
        let vox_cnt_l = min(u32(round(u.match_info.z)), 12u);
        for (var vi: u32 = 0u; vi < vox_cnt_l; vi = vi + 1u) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && va.x >= 256.5 && va.x < 511.5 && abs(va.y) > 0.001 && distance(wp_l, vp.xyz) <= (vp.w + 1.5)) {
                vox_near = true;
                break;
            }
        }
        if (!match_near && !vox_near && n1 >= 10.0 && n2 >= 10.0 && n3 >= 10.0 && n4 >= 10.0 && n5 >= 10.0 && n6 >= 10.0 && my_gas >= 10.0 && u.edit_params.y == 0.0) {
             output_buffer[idx] = self_liq;
             return;
        }
    }

    let self_props = get_liq_props(self_liq.x);

    let down_d = vec3<i32>(0, -1, 0);
    let up_d = vec3<i32>(0, 1, 0);

    let neighbors = array<vec3<i32>, 4>(
        vec3<i32>(-1, 0, 0),
        vec3<i32>(1, 0, 0),
        vec3<i32>(0, 0, -1),
        vec3<i32>(0, 0, 1)
    );

    // --- 1. Density Buoyancy Swapping (1-to-1 parity matching) ---
    var swapped = false;
    let frame_step = i32(u.time) % 2;
    let is_even_pair = (lp.y % 2) == frame_step;

    if (self_vol > 0.05) {
        if (is_even_pair) {
            // Look down
            if (lp.y > 0 && !is_solid(ip, down_d, win_min)) {
                let below = get_liquid(ip, down_d, win_min);
                let below_props = get_liq_props(below.x);
                if (below.y > 0.05 && self_props.density > below_props.density) {
                    next_id = below.x;
                    next_vol = below.y;
                    swapped = true;
                }
            }
        } else {
            // Look up
            if (lp.y < 159 && !is_solid(ip, up_d, win_min)) {
                let above = get_liquid(ip, up_d, win_min);
                let above_props = get_liq_props(above.x);
                if (above.y > 0.05 && above_props.density > self_props.density) {
                    next_id = above.x;
                    next_vol = above.y;
                    swapped = true;
                }
            }
        }
    }

    // --- 2. Gravity & Lateral Flow (only calculated if not swapped) ---
    var net_flow = 0.0;
    var max_inflow = 0.0;

    if (!swapped) {
        let g_rate = self_props.g_rate;
        let l_rate = self_props.l_rate;

        // Downward gravity flow
        if (!is_solid(ip, down_d, win_min)) {
            let below = get_liquid(ip, down_d, win_min);
            let below_props = get_liq_props(below.x);
            if (below.y <= 0.05 || self_props.density >= below_props.density) {
                let flow_out = min(self_vol, max(0.0, 1.0 - below.y)) * g_rate;
                net_flow -= flow_out;
            }
        }
        if (!is_solid(ip, up_d, win_min)) {
            let above = get_liquid(ip, up_d, win_min);
            let above_props = get_liq_props(above.x);
            if (self_vol <= 0.05 || above_props.density >= self_props.density) {
                let flow_in = min(above.y, max(0.0, 1.0 - self_vol)) * above_props.g_rate;
                net_flow += flow_in;
                if (flow_in > max_inflow) {
                    max_inflow = flow_in;
                    next_id = above.x;
                }
            }
        }

        // Lateral flow
        for (var i = 0; i < 4; i = i + 1) {
            let nd = neighbors[i];
            if (!is_solid(ip, nd, win_min)) {
                let n_liq = get_liquid(ip, nd, win_min);
                let n_props = get_liq_props(n_liq.x);
                if (self_vol > n_liq.y && (n_liq.y <= 0.05 || self_props.density >= n_props.density)) {
                    let flow_out = (self_vol - n_liq.y) * l_rate;
                    net_flow -= flow_out;
                }
                if (n_liq.y > self_vol && (self_vol <= 0.05 || n_props.density >= self_props.density)) {
                    let flow_in = (n_liq.y - self_vol) * n_props.l_rate;
                    net_flow += flow_in;
                    if (flow_in > max_inflow) {
                        max_inflow = flow_in;
                        next_id = n_liq.x;
                    }
                }
            }
        }

        next_vol = next_vol + net_flow;
    }

    // --- 3. Spawn liquid if click is active ---
    if (u.hit_pos.w > 0.5) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz);
        let dist = distance(world_pos, u.hit_pos.xyz);
        if (dist <= u.brush_radius && u.edit_params.x > 0.5) {
            var p_id = u.edit_params.x;
            if (p_id >= 256.0) { p_id = p_id - 256.0; }
            next_id = p_id;
            next_vol = min(1.0, next_vol + u.edit_params.y);
        }
    }

    // --- 3.2. Multi-Slot GPU Voxel Action Queue (Liquids: Siphon/Slurp va.y < 0, Squirt/Splash va.y > 0) ---
    let vox_cnt = min(u32(round(u.match_info.z)), 12u);
    if (vox_cnt > 0u) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
        for (var vi: u32 = 0u; vi < vox_cnt; vi = vi + 1u) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && va.x >= 256.5 && va.x < 511.5 && abs(va.y) > 0.001) {
                let fdist = distance(world_pos, vp.xyz);
                if (fdist <= vp.w) {
                    let target_lid = round(va.x - 256.0);
                    let falloff = clamp(1.15 - 0.65 * (fdist / max(vp.w, 0.5)), 0.25, 1.0);
                    if (va.y < 0.0) {
                        if (abs(round(abs(next_id)) - target_lid) < 0.5 && next_vol > 0.0) {
                            next_vol = max(0.0, next_vol + va.y * falloff);
                            next_sleep = 0.0;
                        }
                    } else {
                        next_id = target_lid;
                        next_vol = min(1.0, next_vol + va.y * falloff);
                        next_sleep = 0.0;
                    }
                }
            }
        }
    }

    // --- 3.5. Steam condensation ---
    let my_gas = get_gas(ip, zero_d, win_min);
    if (my_gas.x == 1.0 && my_gas.y > 0.05) {
        if (is_solid(ip, up_d, win_min)) {
            if (next_vol <= 0.05 || next_id == 1.0) {
                next_id = 1.0; // Water
                next_vol = min(1.0, next_vol + 0.02);
            }
        }
    }

    // --- 4. Multi-Phase Reactions ---
    if (next_vol > 0.05) {
        let all_neighbors = array<vec3<i32>, 6>(
            vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
            vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
            vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
        );
        for (var i = 0u; i < 6u; i++) {
            let nd = all_neighbors[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            
            // 1. Solid check
            let n_sol = get_solid(ip, nd, win_min);
            if (n_sol.y <= 0.0 && abs(n_sol.x) > 0.5) {
                let rx = get_reaction(abs(next_id), 256u, abs(n_sol.x), 0u);
                if (rx.x != abs(next_id) + 256.0) {
                    if (rx.x < 256.0) { // Spawning Solid
                        let self_s_idx = u32(ip.x) + u32(ip.y) * 160u + u32(ip.z) * 25600u;
                        solid_buffer[self_s_idx] = vec4<f32>(rx.x, -1.0, 0.0, 0.0);
                        next_id = 0.0; next_vol = 0.0;
                    } else if (rx.x < 512.0) { // Becoming another Liquid
                        next_id = rx.x - 256.0;
                    } else { // Becoming Gas
                        next_id = 0.0; next_vol = 0.0;
                    }
                    break;
                }
            }
            
            // 2. Liquid check
            let n_liq = get_liquid(ip, nd, win_min);
            if (n_liq.y > 0.05) {
                let rx = get_reaction(abs(next_id), 256u, n_liq.x, 256u);
                if (rx.x != abs(next_id) + 256.0) {
                    if (rx.x < 256.0) { 
                        let self_s_idx = u32(ip.x) + u32(ip.y) * 160u + u32(ip.z) * 25600u;
                        solid_buffer[self_s_idx] = vec4<f32>(rx.x, -1.0, 0.0, 0.0);
                        next_id = 0.0; next_vol = 0.0;
                    } else if (rx.x < 512.0) { 
                        next_id = rx.x - 256.0;
                    } else { 
                        next_id = 0.0; next_vol = 0.0;
                    }
                    break;
                }
            }
            
            // 3. Gas check
            let n_gas = get_gas(ip, nd, win_min);
            if (n_gas.y > 0.05) {
                let rx = get_reaction(abs(next_id), 256u, n_gas.x, 512u);
                if (rx.x != abs(next_id) + 256.0) {
                    if (rx.x < 256.0) { 
                        let self_s_idx = u32(ip.x) + u32(ip.y) * 160u + u32(ip.z) * 25600u;
                        solid_buffer[self_s_idx] = vec4<f32>(rx.x, -1.0, 0.0, 0.0);
                        next_id = 0.0; next_vol = 0.0;
                    } else if (rx.x < 512.0) { 
                        next_id = rx.x - 256.0;
                    } else { 
                        next_id = 0.0; next_vol = 0.0;
                    }
                    break;
                }
            }
        }
    }



    // --- 5. Evaporate and clamp ---
    if (next_vol < 0.01) {
        next_vol = 0.0;
        next_id = 0.0;
    }
    
    next_vol = clamp(next_vol, 0.0, 1.0);
    if (next_vol == 0.0) {
        next_id = 0.0;
    }

    if (abs(next_vol - self_vol) < 0.001) {
        next_sleep = min(next_sleep + 1.0, 10.0);
    } else {
        next_sleep = 0.0;
    }
    
    if (next_id == 5.0 && next_sleep >= 10.0 && next_vol > 0.05) {
        next_id = 0.0;
        next_vol = 0.0;
        let s_idx = u32(ip.x) + u32(ip.y) * 160u + u32(ip.z) * 25600u;
        solid_buffer[s_idx] = vec4<f32>(1.0, -0.5, 0.0, 0.0);
    }
    
    if (next_vol > 0.0) {
        next_age = next_age + 1.0;
    } else {
        next_age = 0.0;
    }


    output_buffer[idx] = vec4<f32>(next_id, next_vol, next_age, next_sleep);
}
"))

(def gas-sim-wgsl
  (String.append wgsl-tag-constants "
struct GasProps {
    g_rate: f32,
    l_rate: f32,
    decay: f32,
}

fn get_gas_props(id: f32) -> GasProps {
    if (id < 0.5) { return GasProps(0.0, 0.0, 0.0); }
    let mat_id = clamp(u32(round(id)), 0u, 255u);
    let idx = (512u + mat_id) * 8u;
    let density = bitcast<f32>(registry_data[idx + 5u]);
    let tags = registry_data[idx + 7u];
    
    var g = min(1.0, 0.3 / max(density, 0.1));
    var l = min(1.0, 0.15 / max(density, 0.1));
    let t_rate = abs(g) + 4.0 * l;
    if (t_rate > 1.0) {
        g = g / t_rate;
        l = l / t_rate;
    }
    var dec = 0.0;
    if ((tags & TAG_HEAVY_GAS) != 0u) {
        g = -min(1.0, density * 0.1);
    }
    if ((tags & TAG_DISSIPATES) != 0u) {
        dec = 0.02; // Very fast decay
    }
    return GasProps(g, l, dec);
}

@group(0) @binding(0) var<storage, read>       input_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> output_buffer: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> solid_buffer: array<vec4<f32>>;
@group(0) @binding(4) var<storage, read>       registry_data: array<u32>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;
@group(0) @binding(8) var<storage, read_write> light_buffer: array<vec4<f32>>; // buffer backed light!

fn positive_mod(n: i32, m: i32) -> i32 {
    let r = n % m;
    if (r < 0) {
        return r + m;
    }
    return r;
}

fn get_win_min() -> vec3<i32> {
    let cx = i32(floor(u.cam_pos.x / 32.0)) - 2;
    let cy = i32(floor(u.cam_pos.y / 32.0)) - 2;
    let cz = i32(floor(u.cam_pos.z / 32.0)) - 2;
    return vec3<i32>(
        positive_mod(cx, 5) * 32,
        positive_mod(cy, 5) * 32,
        positive_mod(cz, 5) * 32
    );
}

fn step_in_window(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let lp = (base_ip - win_min + vec3<i32>(160)) % 160;
    let nlp = lp + delta;
    return nlp.x >= 0 && nlp.x < 160 && nlp.y >= 0 && nlp.y < 160 && nlp.z >= 0 && nlp.z < 160;
}

fn get_solid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(255.0, -1.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(solid_texture, wrapped, 0);
}

fn is_solid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let sol = get_solid(base_ip, delta, win_min);
    return sol.y * 0.5 < 0.008;
}

fn get_gas(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0, 0.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(gas_texture, wrapped, 0);
}

fn get_liquid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) { return vec4<f32>(0.0, 0.0, 0.0, 10.0); }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    return textureLoad(liquid_texture, wrapped, 0);
}

fn get_world_pos(ip: vec3<i32>, cam_pos: vec3<f32>) -> vec3<f32> {
    let cx = i32(floor(cam_pos.x / 32.0));
    let cy = i32(floor(cam_pos.y / 32.0));
    let cz = i32(floor(cam_pos.z / 32.0));
    
    let offset_cx = cx - 2;
    let offset_cy = cy - 2;
    let offset_cz = cz - 2;
    
    let slot_x = ip.x / 32;
    let slot_y = ip.y / 32;
    let slot_z = ip.z / 32;
    
    let lx = ip.x % 32;
    let ly = ip.y % 32;
    let lz = ip.z % 32;
    
    let qx = offset_cx + positive_mod(slot_x - positive_mod(offset_cx, 5), 5);
    let qy = offset_cy + positive_mod(slot_y - positive_mod(offset_cy, 5), 5);
    let qz = offset_cz + positive_mod(slot_z - positive_mod(offset_cz, 5), 5);
    
    let gx = qx * 32 + lx;
    let gy = qy * 32 + ly;
    let gz = qz * 32 + lz;
    
    return vec3<f32>(f32(gx), f32(gy), f32(gz));
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    // Dummy reads to prevent compiler from optimizing out unused bindings
    let dummy_val = input_buffer[0] + solid_buffer[0] + vec4<f32>(bitcast<f32>(registry_data[0]));
    if (dummy_val.x > 999999.0) {
        output_buffer[idx] = textureLoad(liquid_texture, vec3<i32>(0), 0);
    }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));
    let win_min = get_win_min();
    let zero_d = vec3<i32>(0, 0, 0);

    if (is_solid(ip, zero_d, win_min)) {
        output_buffer[idx] = vec4<f32>(0.0, 0.0, 0.0, 10.0);
        return;
    }

    let self_gas = get_gas(ip, zero_d, win_min);
    let self_vol = self_gas.y;
    var next_id = self_gas.x;
    var next_vol = self_vol;
    var next_age = self_gas.z;
    var next_sleep = self_gas.w;
    
    if (next_sleep >= 10.0) {
        let n1 = get_gas(ip, vec3<i32>(-1,0,0), win_min).w;
        let n2 = get_gas(ip, vec3<i32>(1,0,0), win_min).w;
        let n3 = get_gas(ip, vec3<i32>(0,-1,0), win_min).w;
        let n4 = get_gas(ip, vec3<i32>(0,1,0), win_min).w;
        let n5 = get_gas(ip, vec3<i32>(0,0,-1), win_min).w;
        let n6 = get_gas(ip, vec3<i32>(0,0,1), win_min).w;
        let my_liq = get_liquid(ip, zero_d, win_min).w;
        var match_near = false;
        let wp_g = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
        if (u.match_info.x > 0.5) {
            for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
                let m = u.matches[mi];
                if (m.w > 0.01 && distance(wp_g, m.xyz) <= 2.4) { match_near = true; break; }
            }
        }
        var vox_near = false;
        let vox_cnt_g = min(u32(round(u.match_info.z)), 12u);
        for (var vi: u32 = 0u; vi < vox_cnt_g; vi = vi + 1u) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && va.x >= 512.5 && abs(va.y) > 0.001 && distance(wp_g, vp.xyz) <= (vp.w + 1.5)) {
                vox_near = true;
                break;
            }
        }
        if (!match_near && !vox_near && n1 >= 10.0 && n2 >= 10.0 && n3 >= 10.0 && n4 >= 10.0 && n5 >= 10.0 && n6 >= 10.0 && my_liq >= 10.0 && u.edit_params.w == 0.0) {
             output_buffer[idx] = self_gas;
             return;
        }
    }

    let down_d = vec3<i32>(0, -1, 0);
    let up_d = vec3<i32>(0, 1, 0);

    let neighbors = array<vec3<i32>, 4>(
        vec3<i32>(-1, 0, 0),
        vec3<i32>(1, 0, 0),
        vec3<i32>(0, 0, -1),
        vec3<i32>(0, 0, 1)
    );

    let self_props = get_gas_props(self_gas.x);
    let g_rate = self_props.g_rate;
    let l_rate = self_props.l_rate;

    var net_flow = 0.0;
    var max_inflow = 0.0;

    // --- 1. Vertical flow ---
    // Flow out to above (if we rise)
    if (g_rate > 0.0 && !is_solid(ip, up_d, win_min)) {
        let above = get_gas(ip, up_d, win_min);
        let flow_out = min(self_vol, max(0.0, 1.0 - above.y)) * g_rate;
        net_flow -= flow_out;
    }
    // Flow out to below (if we fall)
    if (g_rate < 0.0 && !is_solid(ip, down_d, win_min)) {
        let below = get_gas(ip, down_d, win_min);
        let flow_out = min(self_vol, max(0.0, 1.0 - below.y)) * abs(g_rate);
        net_flow -= flow_out;
    }
    // Flow in from below (if they rise)
    if (!is_solid(ip, down_d, win_min)) {
        let below = get_gas(ip, down_d, win_min);
        let below_props = get_gas_props(below.x);
        if (below_props.g_rate > 0.0) {
            let flow_in = min(below.y, max(0.0, 1.0 - self_vol)) * below_props.g_rate;
            net_flow += flow_in;
            if (flow_in > max_inflow) {
                max_inflow = flow_in;
                next_id = below.x;
            }
        }
    }
    // Flow in from above (if they fall)
    if (!is_solid(ip, up_d, win_min)) {
        let above = get_gas(ip, up_d, win_min);
        let above_props = get_gas_props(above.x);
        if (above_props.g_rate < 0.0) {
            let flow_in = min(above.y, max(0.0, 1.0 - self_vol)) * abs(above_props.g_rate);
            net_flow += flow_in;
            if (flow_in > max_inflow) {
                max_inflow = flow_in;
                next_id = above.x;
            }
        }
    }

    // --- 2. Lateral flow ---
    for (var i = 0; i < 4; i = i + 1) {
        let nd = neighbors[i];
        if (!is_solid(ip, nd, win_min)) {
            let n_gas = get_gas(ip, nd, win_min);
            let n_props = get_gas_props(n_gas.x);
            // Flow out to neighbor if we have more
            if (self_vol > n_gas.y) {
                let flow_out = (self_vol - n_gas.y) * l_rate;
                net_flow -= flow_out;
            }
            // Flow in from neighbor if it has more
            if (n_gas.y > self_vol) {
                let flow_in = (n_gas.y - self_vol) * n_props.l_rate;
                net_flow += flow_in;
                if (flow_in > max_inflow) {
                    max_inflow = flow_in;
                    next_id = n_gas.x;
                }
            }
        }
    }

    next_vol = next_vol + net_flow;

    // --- 3. Spawn gas if click is active ---
    if (u.hit_pos.w > 0.5) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz);
        let dist = distance(world_pos, u.hit_pos.xyz);
        if (dist <= u.brush_radius && u.edit_params.z > 0.5) {
            var p_id = u.edit_params.z;
            if (p_id >= 512.0) { p_id = p_id - 512.0; }
            next_id = p_id;
            next_vol = min(1.0, next_vol + u.edit_params.w);
        }
    }

    // --- 3.2. Multi-Slot GPU Voxel Action Queue (Gases: Inhale va.y < 0, Plume/Blast va.y > 0, Burst va.z > 0.5) ---
    let vox_cnt = min(u32(round(u.match_info.z)), 12u);
    if (vox_cnt > 0u) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
        for (var vi: u32 = 0u; vi < vox_cnt; vi = vi + 1u) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && va.x >= 512.5 && abs(va.y) > 0.001) {
                let fdist = distance(world_pos, vp.xyz);
                if (fdist <= vp.w) {
                    let target_gid = round(va.x - 512.0);
                    if (va.y < 0.0) {
                        let falloff = clamp(1.15 - 0.65 * (fdist / max(vp.w, 0.5)), 0.25, 1.0);
                        if (abs(round(abs(next_id)) - target_gid) < 0.5 && next_vol > 0.0) {
                            next_vol = max(0.0, next_vol + va.y * falloff);
                            next_sleep = 0.0;
                        }
                    } else if (va.z > 0.5) {
                        next_id = target_gid;
                        next_vol = max(next_vol, va.y);
                        next_sleep = 0.0;
                    } else {
                        let falloff = clamp(1.15 - 0.65 * (fdist / max(vp.w, 0.5)), 0.25, 1.0);
                        next_id = target_gid;
                        next_vol = min(1.0, next_vol + va.y * falloff);
                        next_sleep = 0.0;
                    }
                }
            }
        }
    }

    // --- 4. Matrix-Driven Gas Spawns ---
    var spawn_gas_id = 0.0;
    var spawn_gas_vol = 0.0;
    
    let my_liq = get_liquid(ip, zero_d, win_min);
    let my_sol = get_solid(ip, zero_d, win_min);

    // --- 3.3. Thrown Lit Matches: Spawn Fire wisp (igniting CA fuels/explosives) or Steam if wet ---
    if (u.match_info.x > 0.5) {
        let m_wp = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
        for (var mi: u32 = 0u; mi < 8u; mi = mi + 1u) {
            let m = u.matches[mi];
            if (m.w > 0.01 && distance(m_wp, m.xyz) <= 1.25) {
                let l_id_u = clamp(u32(round(abs(my_liq.x))), 0u, 255u);
                if (l_id_u > 0u && my_liq.y > 0.08 && (registry_data[(256u + l_id_u) * 8u + 7u] & TAG_EXTINGUISHER) != 0u) {
                    next_id = 1.0; // MAT_STEAM (tssst!)
                    next_vol = max(next_vol, 0.85);
                } else {
                    next_id = 3.0; // MAT_FIRE (TAG_IGNITER -> ignites Oil, Methane, Gel, Gunpowder, Wood, melts Ice)
                    next_vol = max(next_vol, 0.82 * clamp(m.w + 0.25, 0.4, 1.0));
                }
                next_sleep = 0.0;
                break;
            }
        }
    }
    let dirs6 = array<vec3<i32>, 6>(
        vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
        vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
        vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
    );
    
    if (my_liq.y > 0.05) {
        for (var i = 0u; i < 6u; i++) {
            let nd = dirs6[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let n_sol = get_solid(ip, nd, win_min);
            if (n_sol.y <= 0.0 && abs(n_sol.x) > 0.5) {
                let rx = get_reaction(abs(my_liq.x), 256u, abs(n_sol.x), 0u);
                if (rx.x >= 512.0) {
                    spawn_gas_id = rx.x - 512.0; spawn_gas_vol = 1.0; break;
                }
            }
            let n_liq = get_liquid(ip, nd, win_min);
            if (n_liq.y > 0.05) {
                let rx = get_reaction(abs(my_liq.x), 256u, n_liq.x, 256u);
                if (rx.x >= 512.0) {
                    spawn_gas_id = rx.x - 512.0; spawn_gas_vol = 1.0; break;
                }
            }
        }
    } else if (my_sol.y <= 0.0 && abs(my_sol.x) > 0.5) {
        for (var i = 0u; i < 6u; i++) {
            let nd = dirs6[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let n_liq = get_liquid(ip, nd, win_min);
            if (n_liq.y > 0.05) {
                let rx = get_reaction(abs(my_sol.x), 0u, n_liq.x, 256u);
                if (rx.x >= 512.0) {
                    spawn_gas_id = rx.x - 512.0; spawn_gas_vol = 1.0; break;
                }
            }
            let n_gas = get_gas(ip, nd, win_min);
            if (n_gas.y > 0.05) {
                let rx = get_reaction(abs(my_sol.x), 0u, n_gas.x, 512u);
                if (rx.x >= 512.0) {
                    spawn_gas_id = rx.x - 512.0; spawn_gas_vol = 1.0; break;
                }
            }
        }
    }
    
    if (spawn_gas_vol > 0.0) {
        if (next_vol < 0.95) {
            next_id = spawn_gas_id;
            next_vol = min(1.0, next_vol + spawn_gas_vol);
        }
    }



    // --- 5. Evaporate, decay and clamp ---
    let next_props = get_gas_props(next_id);
    next_vol = max(0.0, next_vol - next_props.decay);

    if (next_vol < 0.01) {
        next_vol = 0.0;
        next_id = 0.0;
    }
    
    next_vol = clamp(next_vol, 0.0, 1.0);
    if (next_vol == 0.0) {
        next_id = 0.0;
    }

    if (abs(next_vol - self_vol) < 0.001) {
        next_sleep = min(next_sleep + 1.0, 10.0);
    } else {
        next_sleep = 0.0;
    }
    

    
    if (next_vol > 0.0) {
        next_age = next_age + 1.0;
    } else {
        next_age = 0.0;
    }


    output_buffer[idx] = vec4<f32>(next_id, next_vol, next_age, next_sleep);
}
"))

(def solid-sim-wgsl
  (String.append wgsl-tag-constants "
@group(0) @binding(0) var<storage, read>       input_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> output_buffer: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> solid_buffer: array<vec4<f32>>;
@group(0) @binding(4) var<storage, read>       registry_data: array<u32>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;
@group(0) @binding(8) var<storage, read_write> light_buffer: array<vec4<f32>>; // buffer backed light!

fn positive_mod(n: i32, m: i32) -> i32 {
    let r = n % m;
    if (r < 0) {
        return r + m;
    }
    return r;
}

fn get_win_min() -> vec3<i32> {
    let cx = i32(floor(u.cam_pos.x / 32.0)) - 2;
    let cy = i32(floor(u.cam_pos.y / 32.0)) - 2;
    let cz = i32(floor(u.cam_pos.z / 32.0)) - 2;
    return vec3<i32>(
        positive_mod(cx, 5) * 32,
        positive_mod(cy, 5) * 32,
        positive_mod(cz, 5) * 32
    );
}

fn step_in_window(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let lp = (base_ip - win_min + vec3<i32>(160)) % 160;
    let nlp = lp + delta;
    return nlp.x >= 0 && nlp.x < 160 && nlp.y >= 0 && nlp.y < 160 && nlp.z >= 0 && nlp.z < 160;
}

fn get_world_pos(ip: vec3<i32>, cam_pos: vec3<f32>) -> vec3<f32> {
    let cx = i32(floor(cam_pos.x / 32.0));
    let cy = i32(floor(cam_pos.y / 32.0));
    let cz = i32(floor(cam_pos.z / 32.0));
    
    let offset_cx = cx - 2;
    let offset_cy = cy - 2;
    let offset_cz = cz - 2;
    
    let slot_x = ip.x / 32;
    let slot_y = ip.y / 32;
    let slot_z = ip.z / 32;
    
    let lx = ip.x % 32;
    let ly = ip.y % 32;
    let lz = ip.z % 32;
    
    let qx = offset_cx + positive_mod(slot_x - positive_mod(offset_cx, 5), 5);
    let qy = offset_cy + positive_mod(slot_y - positive_mod(offset_cy, 5), 5);
    let qz = offset_cz + positive_mod(slot_z - positive_mod(offset_cz, 5), 5);
    
    let gx = qx * 32 + lx;
    let gy = qy * 32 + ly;
    let gz = qz * 32 + lz;
    
    return vec3<f32>(f32(gx), f32(gy), f32(gz));
}

fn get_solid(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> vec4<f32> {
    if (!step_in_window(base_ip, delta, win_min)) {
        return vec4<f32>(255.0, -1.0, 0.0, 10.0);
    }
    let wrapped = (base_ip + delta + vec3<i32>(160)) % 160;
    let s_idx = u32(wrapped.x) + u32(wrapped.y) * 160u + u32(wrapped.z) * 25600u;
    return input_buffer[s_idx];
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));
    let win_min = get_win_min();
    let zero_d = vec3<i32>(0, 0, 0);

    let self_sol = get_solid(ip, zero_d, win_min);
    let self_vol = self_sol.y;
    var next_id = self_sol.x;
    var next_vol = self_vol;
    var next_age = self_sol.z;
    var next_sleep = self_sol.w;

    let dummy_val = u.time + solid_buffer[0].x + vec4<f32>(bitcast<f32>(registry_data[0])).x + textureLoad(solid_texture, vec3<i32>(0), 0).x + textureLoad(liquid_texture, vec3<i32>(0), 0).x + textureLoad(gas_texture, vec3<i32>(0), 0).x;
    if (dummy_val < -99999.0) { return; }

    if (next_sleep >= 10.0) {
        let n1 = get_solid(ip, vec3<i32>(-1,0,0), win_min).w;
        let n2 = get_solid(ip, vec3<i32>(1,0,0), win_min).w;
        let n3 = get_solid(ip, vec3<i32>(0,-1,0), win_min).w;
        let n4 = get_solid(ip, vec3<i32>(0,1,0), win_min).w;
        let n5 = get_solid(ip, vec3<i32>(0,0,-1), win_min).w;
        let n6 = get_solid(ip, vec3<i32>(0,0,1), win_min).w;
        var match_near = false;
        let wp_s = get_world_pos(ip, u.cam_pos.xyz) + vec3<f32>(0.5);
        if (u.match_info.x > 0.5) {
            for (var mi = 0u; mi < 8u; mi++) {
                let m = u.matches[mi];
                if (m.w > 0.01 && distance(wp_s, m.xyz) <= 2.4) {
                    match_near = true;
                    break;
                }
            }
        }
        var vox_near = false;
        let vox_cnt_s = min(u32(round(u.match_info.z)), 12u);
        for (var vi = 0u; vi < vox_cnt_s; vi++) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && abs(va.x) > 0.5 && abs(va.x) < 254.5 && abs(va.y) > 0.001 && distance(wp_s, vp.xyz) <= (vp.w + 8.5)) {
                vox_near = true;
                break;
            }
        }
        // Wake up if the mouse is clicking (u.hit_pos.w == 1.0), any queued solid action is nearby, or a lit match is nearby
        if (n1 >= 10.0 && n2 >= 10.0 && n3 >= 10.0 && n4 >= 10.0 && n5 >= 10.0 && n6 >= 10.0 && u.hit_pos.w == 0.0 && !match_near && !vox_near) {
             output_buffer[idx] = self_sol;
             return;
        }
    }

    // --- Falling Sand Gravity & Liquid Rubble Logic (SDF-Safe) ---
    let rand = fract(sin(dot(vec2<f32>(f32(ip.x), f32(ip.z)) + f32(u32(u.time) % 1000u), vec2<f32>(12.9898, 78.233))) * 43758.5453);
    let diag_x = select(-1, 1, rand > 0.5);
    let diag_z = select(1, -1, rand > 0.5);
    
    // 1. If we are EMPTY (positive SDF), check if sand wants to fall into us
    if (self_vol > 0.0) {
        let up_sol = get_solid(ip, vec3<i32>(0, 1, 0), win_min);
        
        if (up_sol.y <= 0.0 && up_sol.x < 0.0) {
            next_id = up_sol.x;
            next_vol = up_sol.y;
            next_age = up_sol.z;
            next_sleep = 0.0;
        } else {
            let dirs = array<vec3<i32>, 4>(
                vec3<i32>(diag_x, 1, 0), vec3<i32>(-diag_x, 1, 0),
                vec3<i32>(0, 1, diag_z), vec3<i32>(0, 1, -diag_z)
            );
            
            for (var i = 0; i < 4; i++) {
                let d_up = dirs[i];
                let diag_sol = get_solid(ip, d_up, win_min);
                if (diag_sol.y <= 0.0 && diag_sol.x < 0.0) {
                    let diag_down_sol = get_solid(ip, d_up + vec3<i32>(0, -1, 0), win_min);
                    if (diag_down_sol.y <= 0.0) {
                        next_id = diag_sol.x;
                        next_vol = diag_sol.y;
                        next_age = diag_sol.z;
                        next_sleep = 0.0;
                        break;
                    }
                }
            }
        }
    } 
    // 2. If we are FALLING SAND (negative SDF AND negative Material ID), check if we should fall or slide
    else if (self_vol <= 0.0 && self_sol.x < 0.0) {
        let down_sol = get_solid(ip, vec3<i32>(0, -1, 0), win_min);
        
        if (down_sol.y > 0.0) {
            next_id = 0.0;
            next_vol = 0.5;
            next_age = 0.0;
            next_sleep = 0.0;
        } else {
            let dirs = array<vec3<i32>, 4>(
                vec3<i32>(-diag_x, -1, 0), vec3<i32>(diag_x, -1, 0),
                vec3<i32>(0, -1, -diag_z), vec3<i32>(0, -1, diag_z)
            );
            
            for (var i = 0; i < 4; i++) {
                let diag_down_sol = get_solid(ip, dirs[i], win_min);
                if (diag_down_sol.y > 0.0) {
                    next_id = 0.0;
                    next_vol = 0.5;
                    next_age = 0.0;
                    next_sleep = 0.0;
                    break;
                }
            }
        }
    }


    if (abs(next_vol - self_vol) < 0.001) {
        next_sleep = min(next_sleep + 1.0, 10.0);
    } else {
        next_sleep = 0.0;
    }
    
    if (next_vol <= 0.0 && next_id < 0.0 && next_sleep >= 10.0) {
        next_id = abs(next_id);
    }
    
    if (next_vol > 0.0) {
        next_age = next_age + 1.0;
    } else {
        next_age = 0.0;
    }


    // --- 2.5 Reaction Matrix Lookup ---
    if (next_vol <= 0.0 && next_id > 0.0 && next_id != 255.0) {
        let neighbors = array<vec3<i32>, 6>(
            vec3<i32>(1,0,0), vec3<i32>(-1,0,0),
            vec3<i32>(0,1,0), vec3<i32>(0,-1,0),
            vec3<i32>(0,0,1), vec3<i32>(0,0,-1)
        );
        for (var i = 0u; i < 6u; i++) {
            let nd = neighbors[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let nip = (ip + nd + vec3<i32>(160)) % 160;
            
            // 1. Check solid
            let n_sol = get_solid(ip, nd, win_min);
            if (n_sol.y <= 0.0 && abs(n_sol.x) > 0.5) {
                let rx = get_reaction(abs(next_id), 0u, abs(n_sol.x), 0u);
                if (rx.x != abs(next_id)) {
                    if (rx.x < 256.0) {
                        next_id = rx.x;
                    } else {
                        next_id = 0.0; next_vol = 1.0;
                    }
                    next_sleep = 0.0;
                    break;
                }
            }
            
            // 2. Check liquid
            let n_liq = textureLoad(liquid_texture, nip, 0);
            if (n_liq.x > 0.5) {
                let rx = get_reaction(abs(next_id), 0u, n_liq.x, 256u);
                if (rx.x != abs(next_id)) {
                    if (rx.x < 256.0) {
                        next_id = rx.x;
                    } else {
                        next_id = 0.0; next_vol = 1.0;
                    }
                    next_sleep = 0.0;
                    break;
                }
            }
            
            // 3. Check gas
            let n_gas = textureLoad(gas_texture, nip, 0);
            if (n_gas.x > 0.5) {
                let rx = get_reaction(abs(next_id), 0u, n_gas.x, 512u);
                if (rx.x != abs(next_id)) {
                    if (rx.x < 256.0) {
                        next_id = rx.x;
                    } else {
                        next_id = 0.0; next_vol = 1.0;
                    }
                    next_sleep = 0.0;
                    break;
                }
            }
        }
    }

    // 3. Carve and Build natively on the GPU (Proper SDF Math; True Bedrock 255.0 is indestructible)
    if (u.hit_pos.w > 0.5) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz);
        let dist = distance(world_pos, u.hit_pos.xyz);
        
        if (u.solid_params.x > 998.0 && next_id != 255.0) { // Carving (Intersection)
            if (dist <= u.brush_radius + 8.0) {
                let carve_val = u.brush_radius - dist;
                if (carve_val > next_vol) {
                    next_vol = carve_val;
                    if (next_vol > 0.0) {
                        next_id = 0.0;
                    }
                }
            }
        } else if (u.solid_params.x > 0.0) { // Spawning Rigid (Union)
            if (dist <= u.brush_radius + 8.0) {
                let build_val = dist - u.brush_radius;
                if (build_val < next_vol) {
                    next_vol = build_val;
                    if (next_vol <= 0.0) {
                        next_id = u.solid_params.x;
                    }
                }
            }
        } else if (u.solid_params.x < 0.0) { // Spawning CA (Discrete)
            if (dist <= u.brush_radius) {
                next_vol = -0.5;
                next_id = u.solid_params.x;
                next_sleep = 0.0;
            }
        }
    }

    // 3.2. Multi-Slot GPU Voxel Action Queue (Solids: Carve va.y < 0, Cohesive Pack va.y > 0 && va.x > 0, Granular Pour va.y > 0 && va.x < 0)
    let vox_cnt = min(u32(round(u.match_info.z)), 12u);
    if (vox_cnt > 0u) {
        let world_pos = get_world_pos(ip, u.cam_pos.xyz);
        for (var vi: u32 = 0u; vi < vox_cnt; vi = vi + 1u) {
            let vp = u.vox_pos[vi];
            let va = u.vox_act[vi];
            if (vp.w > 0.05 && abs(va.x) > 0.5 && abs(va.x) < 254.5 && abs(va.y) > 0.001) {
                let fdist = distance(world_pos, vp.xyz);
                let sr = vp.w;
                if (va.y < 0.0) {
                    if (next_id != 255.0 && fdist <= sr + 8.0) {
                        let carve_val = sr - fdist;
                        if (carve_val > next_vol) {
                            next_vol = carve_val;
                            if (next_vol > 0.0) { next_id = 0.0; }
                            next_sleep = 0.0;
                        }
                    }
                } else if (va.x > 0.0) {
                    if (next_id != 255.0 && fdist <= sr + 8.0) {
                        let build_val = fdist - sr;
                        if (build_val < next_vol) {
                            let was_empty = next_vol > 0.0;
                            next_vol = build_val;
                            if (next_vol <= 0.0 && was_empty) { next_id = va.x; }
                            next_sleep = 0.0;
                        }
                    }
                } else {
                    if (next_vol > 0.0 && fdist <= sr) {
                        next_vol = -0.5;
                        next_id = va.x;
                        next_sleep = 0.0;
                    }
                }
            }
        }
    }


    output_buffer[idx] = vec4<f32>(next_id, next_vol, next_age, next_sleep);
}
"))


(def field-sim-wgsl
  (String.append wgsl-tag-constants "
@group(0) @binding(0) var<storage, read>       field_in: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> field_out: array<vec4<f32>>;
@group(0) @binding(2) var<uniform>             u: Uniforms;
@group(0) @binding(3) var<storage, read_write> solid_buffer: array<vec4<f32>>; // read/write so we can break things!
@group(0) @binding(4) var<storage, read>       registry_data: array<u32>;
@group(0) @binding(5) var solid_texture:       texture_3d<f32>;
@group(0) @binding(6) var liquid_texture:      texture_3d<f32>;
@group(0) @binding(7) var gas_texture:         texture_3d<f32>;
@group(0) @binding(8) var<storage, read_write> light_buffer: array<vec4<f32>>; // buffer backed light!

fn positive_mod(n: i32, m: i32) -> i32 {
    let r = n % m;
    if (r < 0) {
        return r + m;
    }
    return r;
}

fn get_win_min() -> vec3<i32> {
    let cx = i32(floor(u.cam_pos.x / 32.0)) - 2;
    let cy = i32(floor(u.cam_pos.y / 32.0)) - 2;
    let cz = i32(floor(u.cam_pos.z / 32.0)) - 2;
    return vec3<i32>(
        positive_mod(cx, 5) * 32,
        positive_mod(cy, 5) * 32,
        positive_mod(cz, 5) * 32
    );
}

fn step_in_window(base_ip: vec3<i32>, delta: vec3<i32>, win_min: vec3<i32>) -> bool {
    let lp = (base_ip - win_min + vec3<i32>(160)) % 160;
    let nlp = lp + delta;
    return nlp.x >= 0 && nlp.x < 160 && nlp.y >= 0 && nlp.y < 160 && nlp.z >= 0 && nlp.z < 160;
}

fn get_solid(p: vec3<i32>) -> vec4<f32> {
    let wrapped = (p + vec3<i32>(160)) % 160;
    let s_idx = u32(wrapped.x) + u32(wrapped.y) * 160u + u32(wrapped.z) * 25600u;
    return solid_buffer[s_idx];
}

// Basic utility to parse material tags
fn get_tags(id: f32) -> u32 {
    if (id < 0.5) { return 0u; }
    let mat_id = clamp(u32(round(id)), 0u, 255u);
    let idx = (256u + mat_id) * 8u;
    return registry_data[idx + 7u];
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    let x = idx % 160u;
    let y = (idx / 160u) % 160u;
    let z = idx / 25600u;
    let ip = vec3<i32>(i32(x), i32(y), i32(z));
    let win_min = get_win_min();
    let lp = (ip - win_min + vec3<i32>(160)) % 160;

    let sol = solid_buffer[idx];
    // Dummy use of all bindings to prevent WebGPU from optimizing them out of the pipeline layout!
    let dummy_val = u.time + textureLoad(solid_texture, vec3<i32>(0), 0).x + textureLoad(liquid_texture, vec3<i32>(0), 0).x + textureLoad(gas_texture, vec3<i32>(0), 0).x + vec4<f32>(bitcast<f32>(registry_data[0])).x;
    if (dummy_val < -99999.0) { return; }

    
    // We need 6 neighbors for both Structural Stress and Global Illumination
    let dirs6 = array<vec3<i32>, 6>(
        vec3<i32>(-1, 0, 0), vec3<i32>(1, 0, 0),
        vec3<i32>(0, -1, 0), vec3<i32>(0, 1, 0),
        vec3<i32>(0, 0, -1), vec3<i32>(0, 0, 1)
    );

    // If it's empty space or falling sand (negative id), zero stress fields (do NOT return early so GI still runs in air!).
    // Track normalized structural stress [0..1] for packing into light_buffer.a (used by voxel-wgsl fracture veins).
    var solid_stress: f32 = 0.0;
    if (sol.y > 0.0 || sol.x <= 0.0) {
        field_out[idx] = vec4<f32>(0.0);
        if (sol.y <= 0.0 && sol.x < -0.5) {
            // Falling rubble that just fractured retains visible shatter cracks as it tumbles
            solid_stress = 0.78;
        }
    } else {
        var max_neighbor_w = 0.0;
        
        // --- Step 1: Load Path Gradient (W) ---
        var my_w = 0.0;
        if (sol.x == 255.0 || lp.y <= 32 || lp.x <= 32 || lp.x >= 127 || lp.z <= 32 || lp.z >= 127) {
            my_w = 96.0; // Anchor at True Bedrock & outer streaming shell of active 5x5x5 window
        } else {
            for (var i = 0u; i < 6u; i++) {
                let nd = dirs6[i];
                if (!step_in_window(ip, nd, win_min)) { continue; }
                let nip = (ip + nd + vec3<i32>(160)) % 160;
                let n_sol = get_solid(nip);
                if (n_sol.y <= 0.0 && n_sol.x > 0.0) { // If neighbor is rigid solid
                    let n_idx = u32(nip.x) + u32(nip.y) * 160u + u32(nip.z) * 25600u;
                    let n_field = field_in[n_idx];
                    
                    // Vertical support (from directly below) does not decay!
                    var decay = 1.0;
                    if (nd.y == -1) { decay = 0.0; } // Supported from below
                    
                    let supported_w = max(0.0, n_field.w - decay);
                    if (supported_w > max_neighbor_w) {
                        max_neighbor_w = supported_w;
                    }
                }
            }
            my_w = max_neighbor_w;
        }

        // --- Step 2: Accumulate Stress (X, Y, Z) ---
        // Contractive 3D dome transfer (3 * 0.30 = 0.90 < 1.0) keeps massive cathedral vaults stable while collapsing severed pillars
        var compressive = 0.0;
        var tensile = 0.0;
        var shear = 0.0;

        for (var i = 0u; i < 6u; i++) {
            let nd = dirs6[i];
            if (!step_in_window(ip, nd, win_min)) { continue; }
            let nip = (ip + nd + vec3<i32>(160)) % 160;
            let n_sol = get_solid(nip);
            if (n_sol.y <= 0.0 && n_sol.x > 0.0) {
                let n_idx = u32(nip.x) + u32(nip.y) * 160u + u32(nip.z) * 25600u;
                let n_field = field_in[n_idx];
                
                // Does this neighbor route its load through me?
                var decay = 1.0;
                if (nd.y == 1) { decay = 0.0; } // The block ABOVE me sees ME as below, so its decay was 0!
                
                if (abs(n_field.w - (my_w - decay)) < 0.1) {
                    let n_mat_id = clamp(u32(round(n_sol.x)), 0u, 255u);
                    let n_reg_idx = n_mat_id * 8u;
                    let n_mass = bitcast<f32>(registry_data[n_reg_idx + 5u]); // density as mass
                    
                    if (nd.y == 1) {
                        compressive += n_field.x * 0.88 + n_mass;
                    } else if (nd.y == -1) {
                        tensile += n_field.y * 0.85 + n_mass;
                    } else {
                        shear += n_field.z * 0.30 + n_field.x * 0.06 + n_mass * 0.25;
                    }
                }
            }
        }

        // --- Step 3: Break Condition ---
        // If we have no support path to bedrock (W == 0), we break immediately.
        var broken = false;
        if (my_w <= 0.0 && sol.x != 255.0) {
            broken = true;
        }

        // Check strength (floor at 2.5 so brittle flora/crystals embedded in huge vault walls don't self-crush)
        let my_mat_id = clamp(u32(round(sol.x)), 0u, 255u);
        let my_reg_idx = my_mat_id * 8u;
        let toughness = bitcast<f32>(registry_data[my_reg_idx + 6u]);
        let struct_t = max(toughness, 2.5);
        
        let limit_c = struct_t * 120.0; 
        let limit_t = struct_t * 50.0;
        let limit_s = struct_t * 60.0;
        
        // Bedrock never breaks or cracks
        if (sol.x != 255.0) {
            if (compressive > limit_c || tensile > limit_t || shear > limit_s) {
                broken = true;
            }
            if (broken) {
                solid_stress = 1.0;
            } else {
                let rc = compressive / max(limit_c, 1.0);
                let rt = tensile / max(limit_t, 1.0);
                let rs = shear / max(limit_s, 1.0);
                var load_ratio = max(rc, max(rt, rs));
                // Cantilever / undercut span amplification (grounded columns sit at my_w == 96.0;
                // arches, overhangs, and acid-undercut pillars have my_w < 96.0)
                let span = max(0.0, 96.0 - my_w);
                if (span > 0.5 && load_ratio > 0.035) {
                    load_ratio = max(load_ratio, clamp(load_ratio * (1.0 + span * 0.16) + span * 0.022, 0.0, 0.98));
                }
                solid_stress = clamp(load_ratio, 0.0, 1.0);
            }
        }

        if (broken) {
            // Break the block! Turn it into falling sand by negating its ID.
            solid_buffer[idx] = vec4<f32>(-abs(sol.x), sol.y, sol.z, 0.0);
            field_out[idx] = vec4<f32>(0.0);
        } else {
            field_out[idx] = vec4<f32>(compressive, tensile, shear, my_w);
        }
    }

    // --- Step 4: Global Illumination (.rgb) + Smoothed Structural Stress (.a) ---
    // NOTE: light_buffer packs GI RGB block light in .rgb and normalized structural stress [0..1] in .a
    // so voxel-wgsl gets hardware 3D trilinear stress interpolation with zero extra 3D textures.
    let raw_sol = textureLoad(solid_texture, ip, 0);
    let raw_liq = textureLoad(liquid_texture, ip, 0);
    let raw_gas = textureLoad(gas_texture, ip, 0);

    let prev_entry = light_buffer[idx];
    var current_light = prev_entry.rgb;
    let prev_stress = prev_entry.a;
    var next_light = current_light * 0.90; // Fast decay for moving sources
    var max_adj_solid_stress: f32 = 0.0;
    
    // Check neighbors to pull light in across the active 5x5x5 window (without bleeding across outer toroidal seam)
    for (var i = 0u; i < 6u; i++) {
        let nd = dirs6[i];
        if (!step_in_window(ip, nd, win_min)) { continue; }
        let np = (ip + nd + vec3<i32>(160)) % 160;
        let n_idx = u32(np.x) + u32(np.y) * 160u + u32(np.z) * 25600u;
        let neighbor_entry = light_buffer[n_idx];
        let neighbor_light = neighbor_entry.rgb;
        
        // Light loses power as it travels (color bleed)
        let incoming = max(vec3<f32>(0.0), neighbor_light - vec3<f32>(0.1, 0.1, 0.1));
        next_light = max(next_light, incoming);

        // Dilate solid stress 1 voxel outward into adjacent surface-skin air so SDF zero-crossings don't dilute to 0
        if (sol.y > 0.0 && raw_sol.g < 1.8) {
            let n_sol_tex = textureLoad(solid_texture, np, 0);
            if (n_sol_tex.g <= 0.0 && abs(n_sol_tex.r) > 0.5) {
                max_adj_solid_stress = max(max_adj_solid_stress, neighbor_entry.a);
            }
        }
    }
    
    // Registry-driven TAG_LUMINESCENT emission across exposed cave solids, liquids, and gases
    var is_lum_solid = false;
    let sol_id_abs = round(abs(raw_sol.r));
    if (raw_sol.g <= 0.0 && raw_sol.g > -1.6 && sol_id_abs > 0.5) {
        let s_base = clamp(u32(sol_id_abs), 0u, 255u) * 8u;
        let s_tags = registry_data[s_base + 7u];
        if ((s_tags & TAG_LUMINESCENT) != 0u) {
            is_lum_solid = true;
            let s_col = vec3<f32>(
                bitcast<f32>(registry_data[s_base + 1u]),
                bitcast<f32>(registry_data[s_base + 2u]),
                bitcast<f32>(registry_data[s_base + 3u])
            );
            let s_str = bitcast<f32>(registry_data[s_base + 4u]);
            next_light = max(next_light, s_col * s_str);
        }
    }

    let liq_id_u = clamp(u32(round(abs(raw_liq.r))), 0u, 255u);
    if (liq_id_u > 0u && raw_liq.g > 0.05) {
        let l_base = (256u + liq_id_u) * 8u;
        let l_tags = registry_data[l_base + 7u];
        if ((l_tags & TAG_LUMINESCENT) != 0u) {
            let l_col = vec3<f32>(
                bitcast<f32>(registry_data[l_base + 1u]),
                bitcast<f32>(registry_data[l_base + 2u]),
                bitcast<f32>(registry_data[l_base + 3u])
            );
            let l_str = bitcast<f32>(registry_data[l_base + 4u]);
            next_light = max(next_light, l_col * l_str);
        }
    }

    let gas_id_u = clamp(u32(round(abs(raw_gas.r))), 0u, 255u);
    if (gas_id_u > 0u && raw_gas.g > 0.05) {
        let g_base = (512u + gas_id_u) * 8u;
        let g_tags = registry_data[g_base + 7u];
        if ((g_tags & TAG_LUMINESCENT) != 0u) {
            let g_col = vec3<f32>(
                bitcast<f32>(registry_data[g_base + 1u]),
                bitcast<f32>(registry_data[g_base + 2u]),
                bitcast<f32>(registry_data[g_base + 3u])
            );
            let g_str = bitcast<f32>(registry_data[g_base + 4u]);
            next_light = max(next_light, g_col * g_str);
        }
    }

    // Held Luminescent Vessel (Crystal Sack, Lava/Ambrosia Flask, or Bottled Fire Bellows) acts as a live hand-lantern!
    if (u.match_info.y > 0.02 && u.flask_action.z > 0.5) {
        let f_mat = clamp(u32(round(u.flask_action.z)), 0u, 1023u);
        let f_base = f_mat * 8u;
        let f_tags = registry_data[f_base + 7u];
        if ((f_tags & TAG_LUMINESCENT) != 0u) {
            let hand_world = u.cam_pos.xyz + normalize(u.cam_right.xyz) * 0.4 + normalize(u.cam_dir.xyz) * 0.75;
            let hw = hand_world - floor(hand_world / 160.0) * 160.0;
            let hand_ip = vec3<i32>(clamp(hw, vec3<f32>(0.0), vec3<f32>(159.0)));
            if (all(ip == hand_ip)) {
                let f_col = vec3<f32>(
                    bitcast<f32>(registry_data[f_base + 1u]),
                    bitcast<f32>(registry_data[f_base + 2u]),
                    bitcast<f32>(registry_data[f_base + 3u])
                );
                let f_str = bitcast<f32>(registry_data[f_base + 4u]);
                next_light = max(next_light, f_col * f_str * (0.45 + 0.65 * u.match_info.y));
            }
        }
    }

    // Thrown Lit Matches act as warm flickering mobile cave torches as they bounce down shafts!
    if (u.match_info.x > 0.5) {
        for (var mi = 0u; mi < 8u; mi++) {
            let m = u.matches[mi];
            if (m.w > 0.01 && all(abs(m.xyz - u.cam_pos.xyz) < vec3<f32>(76.0))) {
                let mw = m.xyz - floor(m.xyz / 160.0) * 160.0;
                let mip = vec3<i32>(clamp(mw, vec3<f32>(0.0), vec3<f32>(159.0)));
                let d_ip = abs(ip - mip);
                if (d_ip.x <= 1 && d_ip.y <= 1 && d_ip.z <= 1) {
                    let flicker = 0.88 + 0.14 * sin(u.time * 23.0 + f32(mi) * 2.1);
                    let fall = select(0.58, 1.0, all(d_ip == vec3<i32>(0)));
                    next_light = max(next_light, vec3<f32>(1.0, 0.56, 0.16) * (2.75 * clamp(m.w + 0.25, 0.35, 1.0) * flicker * fall));
                }
            }
        }
    }

    // Bioluminescent & Burning Ditto-Amoebas act as crawling 3D Global Illumination cave-lanterns!
    var glow_mask = u32(round(u.critter_action.w));
    while (glow_mask != 0u) {
        let ak = firstTrailingBit(glow_mask);
        glow_mask = glow_mask & (glow_mask - 1u);
        let cl = u.critter_lights[ak];
        let cc = u.critter_colors[ak];
        if (abs(cl.w) > 0.5 && all(abs(cl.xyz - u.cam_pos.xyz) < vec3<f32>(76.0))) {
            let cw = cl.xyz - floor(cl.xyz / 160.0) * 160.0;
            let cip = vec3<i32>(clamp(cw, vec3<f32>(0.0), vec3<f32>(159.0)));
            let d_ip = abs(ip - cip);
            if (d_ip.x <= 1 && d_ip.y <= 1 && d_ip.z <= 1) {
                let pulse = 0.90 + 0.10 * sin(u.time * 4.8 + f32(ak) * 1.7);
                let fall = select(0.62, 1.0, all(d_ip == vec3<i32>(0)));
                next_light = max(next_light, cc.rgb * (pulse * fall));
            }
        }
    }
    
    // Non-luminescent interior rock blocks light transmission while letting surface texels catch neighbor glow
    if (!is_lum_solid && raw_sol.g <= -0.5 && sol_id_abs != 0.0) { 
        next_light *= 0.05; 
    }
    
    var next_stress: f32 = 0.0;
    if (sol.y <= 0.0 && abs(sol.x) > 0.5) {
        next_stress = mix(prev_stress, solid_stress, 0.20);
    } else if (raw_sol.g < 1.8) {
        next_stress = max_adj_solid_stress;
    }
    light_buffer[idx] = vec4<f32>(next_light, next_stress);
}

"))

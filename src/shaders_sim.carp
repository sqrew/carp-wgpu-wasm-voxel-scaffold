(def pack-wgsl
  "@group(0) @binding(0) var<storage, read>       voxel_gpu_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> voxel_half_buffer: array<vec2<u32>>;

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 4096000u) { return; }

    let val = voxel_gpu_buffer[idx];
    let p1 = pack2x16float(val.xy);
    let p2 = pack2x16float(val.zw);

    voxel_half_buffer[idx] = vec2<u32>(p1, p2);
}
")

(def copy-wgsl
  "struct Params {
    offset_x: f32,
    offset_y: f32,
    offset_z: f32,
    _pad: f32,
}

@group(0) @binding(0) var<storage, read>       staging_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> voxel_gpu_buffer_read: array<vec4<f32>>;
@group(0) @binding(2) var<storage, read_write> voxel_gpu_buffer_write: array<vec4<f32>>;
@group(0) @binding(3) var<uniform>             p: Params;
@group(0) @binding(4) var<storage, read_write> field_gpu_buffer_read: array<vec4<f32>>;
@group(0) @binding(5) var<storage, read_write> field_gpu_buffer_write: array<vec4<f32>>;
@group(0) @binding(6) var<storage, read_write> liquid_gpu_buffer: array<vec4<f32>>;
@group(0) @binding(7) var<storage, read_write> gas_gpu_buffer: array<vec4<f32>>;
@group(0) @binding(8) var<storage, read_write> light_gpu_buffer: array<vec4<f32>>;

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 32768u) { return; }

    let lx = idx % 32u;
    let ly = (idx / 32u) % 32u;
    let lz = idx / 1024u;

    let cpu_val = staging_buffer[idx];
    let seed_fluid = cpu_val.z;

    let ox = u32(p.offset_x);
    let oy = u32(p.offset_y);
    let oz = u32(p.offset_z);

    let gx = ox + lx;
    let gy = oy + ly;
    let gz = oz + lz;
    let g_idx = gx + gy * 160u + gz * 25600u;
    
    var final_val = cpu_val;
    if (final_val.x == 0.0) {
        final_val.z = 0.0;
    }

    voxel_gpu_buffer_read[g_idx] = final_val;
    voxel_gpu_buffer_write[g_idx] = final_val;
    light_gpu_buffer[g_idx] = vec4<f32>(0.0);

    if (final_val.y <= 0.0 && final_val.x > 0.0) {
        let init_field = vec4<f32>(0.0, 0.0, 0.0, 96.0);
        field_gpu_buffer_read[g_idx] = init_field;
        field_gpu_buffer_write[g_idx] = init_field;
    } else {
        field_gpu_buffer_read[g_idx] = vec4<f32>(0.0);
        field_gpu_buffer_write[g_idx] = vec4<f32>(0.0);
    }

    if (final_val.y > 0.0 && seed_fluid < -0.5) {
        liquid_gpu_buffer[g_idx] = vec4<f32>(abs(seed_fluid), 1.0, 0.0, 0.0);
        gas_gpu_buffer[g_idx] = vec4<f32>(0.0);
    } else if (final_val.y > 0.0 && seed_fluid > 0.5) {
        liquid_gpu_buffer[g_idx] = vec4<f32>(0.0);
        gas_gpu_buffer[g_idx] = vec4<f32>(seed_fluid, 0.9, 0.0, 0.0);
    } else {
        liquid_gpu_buffer[g_idx] = vec4<f32>(0.0);
        gas_gpu_buffer[g_idx] = vec4<f32>(0.0);
    }
}
")

(def wgsl-tag-constants "
const TAG_FLAMMABLE: u32 = 1u;
const TAG_IGNITER: u32 = 2u;
const TAG_EXPLOSIVE: u32 = 4u;
const TAG_MELTABLE: u32 = 8u;
const TAG_FREEZABLE: u32 = 16u;
const TAG_EVAPORABLE: u32 = 32u;
const TAG_CORRODIBLE: u32 = 64u;
const TAG_ACIDIC: u32 = 128u;
const TAG_SOLUBLE: u32 = 256u;
const TAG_CONDUCTIVE: u32 = 512u;
const TAG_SHOCKING: u32 = 1024u;
const TAG_GRANULAR: u32 = 2048u;
const TAG_LIGHT_FLUID: u32 = 4096u;
const TAG_HEAVY_GAS: u32 = 8192u;
const TAG_BRITTLE: u32 = 16384u;
const TAG_TOXIC: u32 = 32768u;
const TAG_HEALING: u32 = 65536u;
const TAG_RADIOACTIVE: u32 = 131072u;
const TAG_SLIPPERY: u32 = 262144u;
const TAG_STICKY: u32 = 524288u;
const TAG_BREATHABLE: u32 = 1048576u;
const TAG_LUMINESCENT: u32 = 2097152u;
const TAG_TRANSPARENT: u32 = 4194304u;
const TAG_EXTINGUISHER: u32 = 8388608u;
const TAG_INDESTRUCTIBLE: u32 = 16777216u;
const TAG_ANTI_GRAVITY: u32 = 33554432u;
const TAG_BOUNCY: u32 = 67108864u;
const TAG_ABSORBENT: u32 = 134217728u;
const TAG_DISSIPATES: u32 = 268435456u;
const TAG_ORGANIC: u32 = 536870912u;
const TAG_MAGNETIC: u32 = 1073741824u;
const TAG_STAINABLE: u32 = 2147483648u;


fn get_mat_tags(id: f32, cat: u32) -> u32 {
    if (id < 0.5) { return 0u; }
    let mat_id = clamp(u32(round(id)), 0u, 255u);
    let idx = (cat + mat_id) * 8u;
    return registry_data[idx + 7u];
}

fn get_reaction(id_A: f32, cat_A: u32, id_B: f32, cat_B: u32) -> vec2<f32> {
    if (id_A < 0.5 || id_B < 0.5) { return vec2<f32>(0.0, 0.0); }
    let a = cat_A + clamp(u32(round(id_A)), 0u, 255u);
    let b = cat_B + clamp(u32(round(id_B)), 0u, 255u);
    
    let offset = 8192u;
    let idx = offset + (a * 1024u + b) * 2u;
    
    let res_a = bitcast<f32>(registry_data[idx]);
    let res_b = bitcast<f32>(registry_data[idx + 1u]);
    return vec2<f32>(res_a, res_b);
}

struct Uniforms {
    time: f32,
    width: f32,
    height: f32,
    brush_radius: f32,
    cam_pos: vec4<f32>,
    cam_dir: vec4<f32>,
    cam_right: vec4<f32>,
    cam_up: vec4<f32>,
    sun_dir: vec4<f32>,
    hit_pos: vec4<f32>,
    edit_params: vec4<f32>,
    solid_params: vec4<f32>,
    entity_count: f32,
    pad1: f32,
    pad2: f32,
    pad3: f32,
    view_proj: mat4x4<f32>,
    flask_pos: vec4<f32>,
    flask_action: vec4<f32>,
    matches: array<vec4<f32>, 8>,
    match_info: vec4<f32>,
    critter_pos: vec4<f32>,
    critter_action: vec4<f32>,
    critter_lights: array<vec4<f32>, 16>,
    critter_colors: array<vec4<f32>, 16>,
    vox_pos: array<vec4<f32>, 12>,
    vox_act: array<vec4<f32>, 12>,
    hopper_pos: array<vec4<f32>, 16>,
    mancer_pos: array<vec4<f32>, 4>,
    mancer_mat: array<vec4<f32>, 4>,
    wake_p0: array<vec4<f32>, 16>,
    wake_p1: array<vec4<f32>, 16>,
    wake_vel: array<vec4<f32>, 16>,
}
")


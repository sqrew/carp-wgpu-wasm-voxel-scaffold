(defmodule CritterSystem
  (defn fmax [a b] (if (> a b) a b))
  (defn fsin [x] (Double.to-float (sin (Double.from-float x))))
  (defn fcos [x] (Double.to-float (cos (Double.from-float x))))
  (defn ffloor [x] (Double.to-float (Double.floor (Double.from-float x))))

  ;; Growth curve: Grey stem-cell babies start at 0.36m; locked slimes swell from 0.42m -> 0.92m (~16.6x volume!)
  (defn amoeba-radius [mat-id fill]
    (if (<= (Float.round mat-id) 0)
      0.36f
      (+ 0.42f (* 0.50f (Float.clamp 0.0f 1.0f fill)))))

  ;; Once a Grey Slime imprints on an element, its breed is permanently locked:
  ;; it only fattens up on its own element family (or golden Ambrosia 262 universal chow)!
  (defn compatible-diet? [locked-mat cand-mat]
    (let [l (Float.round locked-mat)
          c (Float.round cand-mat)]
      (if (<= l 0)
        (Materials.imprintable? cand-mat)
        (if (or (= c l) (= c 262))
          true
          (let [hydro? (and (or (= l 8) (or (= l 257) (= l 513)))
                            (or (= c 8) (or (= c 257) (= c 513))))
                acid?  (and (or (= l 259) (= l 517))
                            (or (= c 259) (= c 517)))
                spore? (and (or (= l 13) (= l 520))
                            (or (= c 13) (= c 520)))
                pyro?  (and (or (= l 258) (or (= l 515) (= l 519)))
                            (or (= c 258) (or (= c 515) (= c 519))))
                boom?  (and (or (= l 7) (or (= l 12) (or (= l 263) (= l 518))))
                            (or (= c 7) (or (= c 12) (or (= c 263) (= c 518)))))
                sponge? (and (= l 11) (and (>= c 257) (<= c 264)))]
            (or hydro? (or acid? (or spore? (or pyro? (or boom? sponge?))))))))))

  ;; Alchemical Refinement: what reagent a full Amoeba excretes right as it undergoes mitosis!
  (defn transmute-product [mat-id]
    (let [m (Float.round mat-id)]
      (if (= m 4)    14.0f   ;; Coal -> compressed glowing Crystal!
      (if (= m 260)  263.0f  ;; Oil -> refined Volatile Gel!
      (if (= m 6)    9.0f    ;; Sand -> fused Glass!
      (if (= m 2)    13.0f   ;; Soil -> luminescent Spore Pod!
      (if (= m 3)    13.0f   ;; Wood -> luminescent Spore Pod!
      (if (= m 1)    5.0f    ;; Stone -> Gold nugget!
      (if (= m 5)    5.0f    ;; Gold -> Gold!
      (if (= m 7)    263.0f  ;; Gunpowder -> Volatile Gel!
      (if (= m 12)   263.0f  ;; C4 -> Volatile Gel!
      (if (= m 13)   262.0f  ;; Spore Pod -> fermented Golden Ambrosia!
      (if (= m 264)  262.0f  ;; Toxic Sludge -> purified Golden Ambrosia!
      (if (= m 520)  262.0f  ;; Spore Cloud -> Golden Ambrosia!
      (if (= m 261)  262.0f  ;; Blood -> Golden Ambrosia!
      (if (= m 259)  17.0f   ;; Acid -> concentrated Rad-Ore!
      (if (= m 517)  17.0f   ;; Acid Vapor -> Rad-Ore!
      (if (= m 14)   15.0f   ;; Crystal -> Amethyst!
      (if (= m 15)   262.0f  ;; Amethyst -> Ambrosia!
      (if (= m 257)  10.0f   ;; Water -> bouncy Slime!
      (if (= m 513)  10.0f   ;; Steam -> bouncy Slime!
      (if (= m 258)  5.0f    ;; Lava -> molten Gold!
      (if (> m 0)    mat-id
                     10.0f)))))))))))))))))))))))

  (defn amoeba-slot-by-idx [state idx]
    (let [cbank (EngineState.critters state)
          a-alive (CritterBank.alive cbank)
          a-idx (CritterBank.idx cbank)
          found -1]
      (do
        (for [k 0 16]
          (when (and (< found 0)
                     (and @(Array.unsafe-nth a-alive k)
                          (Uint64.= idx @(Array.unsafe-nth a-idx k))))
            (set! found k)))
        found)))

  (defn amoeba-mat-at [state slot]
    (if (and (>= slot 0) (< slot 16))
      @(Array.unsafe-nth (CritterBank.mat (EngineState.critters state)) slot)
      0.0f))

  (defn find-free-slot [state]
    (let [a-alive (CritterBank.alive (EngineState.critters state))
          found -1]
      (do
        (for [k 0 16]
          (when (and (< found 0) (not @(Array.unsafe-nth a-alive k)))
            (set! found k)))
        found)))

  (defn spawn-reagent-boulder! [state spawn-pos vel radius mat-id col ttl-ms]
    (let [ecs (EngineState.ecs-world state)
          e (GameWorld.create-entity! ecs)
          m (Float.round mat-id)
          restit (if (= m 10) 0.92 0.44)
          fric (if (= m 8) 0.05 0.48)
          rb (RigidBody.new @&spawn-pos (Quaternion.identity) 1.6 restit fric 0.08 0.12 0.22)
          vol (Volume.Ball (Sphere.init @&spawn-pos radius))]
      (do
        (Body.set-velocity! (RigidBody.body &rb) vel)
        (add-component! ecs &e (CompBody.init rb))
        (add-component! ecs &e (CompVolume.init vol))
        (add-component! ecs &e (CompColor.init col))
        (let [idx (ECS.Entity.index &e)
              gen (ECS.Entity.generation &e)
              ecs-ptr (Unsafe.coerce (EngineState.ecs-world state))
              _ (Coordinator.schedule! (EngineState.coord state) (AppEvent.DespawnEntity ecs-ptr idx gen) ttl-ms)]
          e))))

  (defn destroy-amoeba-slot! [state slot]
    (let [cbank (EngineState.critters state)
          rig (EngineState.rig state)
          a-alive (CritterBank.alive cbank)
          a-idx (CritterBank.idx cbank)
          a-gen (CritterBank.gen cbank)
          ecs (EngineState.ecs-world state)]
      (when @(Array.unsafe-nth a-alive slot)
        (let [idx @(Array.unsafe-nth a-idx slot)
              gen @(Array.unsafe-nth a-gen slot)
              ent (ECS.Entity.init (Handle.init idx gen))]
          (do
            (when (Uint64.= @(RigBelt.grab-idx rig) idx)
              (do
                (RigBelt.set-grab-idx! rig (Uint64.from-long 0l))
                (RigBelt.set-grab-mat! rig 0.0f)))
            (GameWorld.destroy-entity! ecs &ent)
            (Array.aset! a-alive slot false)
            (Array.aset! (CritterBank.mat cbank) slot 0.0f)
            (Array.aset! (CritterBank.fill cbank) slot 0.0f)
            (Array.aset! (CritterBank.state cbank) slot 0))))))

  (defn spawn-amoeba! [state spawn-pos vel init-mat init-fill init-state]
    (let [slot (CritterSystem.find-free-slot state)]
      (if (< slot 0)
        -1
        (let [cbank (EngineState.critters state)
              ecs (EngineState.ecs-world state)
              e (GameWorld.create-entity! ecs)
              restit (if (Materials.bouncy? init-mat) 0.96 0.34)
              fric (if (Materials.slippery? init-mat) 0.08 0.55)
              rad-f (CritterSystem.amoeba-radius init-mat init-fill)
              rad-d (Double.from-float rad-f)
              col (Materials.slime-color init-mat init-state)
              rb (RigidBody.new @&spawn-pos (Quaternion.identity) 1.0 restit fric 0.18 0.18 0.25)
              vol (Volume.Ball (Sphere.init @&spawn-pos rad-d))
              base3 (* slot 3)
              phase-seed (* (Float.from-int (+ slot 1)) 1.618f)]
          (do
            (Body.set-velocity! (RigidBody.body &rb) vel)
            (add-component! ecs &e (CompBody.init rb))
            (add-component! ecs &e (CompVolume.init vol))
            (add-component! ecs &e (CompColor.init col))
            (Array.aset! (CritterBank.alive cbank) slot true)
            (Array.aset! (CritterBank.idx cbank) slot (ECS.Entity.index &e))
            (Array.aset! (CritterBank.gen cbank) slot (ECS.Entity.generation &e))
            (Array.aset! (CritterBank.mat cbank) slot init-mat)
            (Array.aset! (CritterBank.fill cbank) slot init-fill)
            (Array.aset! (CritterBank.rad cbank) slot rad-f)
            (Array.aset! (CritterBank.state cbank) slot init-state)
            (Array.aset! (CritterBank.timer cbank) slot 0.0f)
            (Array.aset! (CritterBank.phase cbank) slot phase-seed)
            (Array.aset! (CritterBank.pod cbank) base3 0.0f)
            (Array.aset! (CritterBank.pod cbank) (+ base3 1) 0.25f)
            (Array.aset! (CritterBank.pod cbank) (+ base3 2) 0.0f)
            (Array.aset! (CritterBank.norm cbank) base3 0.0f)
            (Array.aset! (CritterBank.norm cbank) (+ base3 1) 1.0f)
            (Array.aset! (CritterBank.norm cbank) (+ base3 2) 0.0f)
            (Array.aset! (CritterBank.goal cbank) base3 (CritterSystem.fcos phase-seed))
            (Array.aset! (CritterBank.goal cbank) (+ base3 1) 0.0f)
            (Array.aset! (CritterBank.goal cbank) (+ base3 2) (CritterSystem.fsin phase-seed))
            slot)))))

  ;; Sample nearest voxel material ID in CPU chunk by reference (zero allocations!)
  (defn sample-solid-mat-near [world p]
    (let [x @(Vector3.x p)
          y @(Vector3.y p)
          z @(Vector3.z p)
          qx (Double.to-int (Double.floor (/ x 32.0)))
          qy (Double.to-int (Double.floor (/ y 32.0)))
          qz (Double.to-int (Double.floor (/ z 32.0)))
          chunks (World.chunks world)
          tx (World.positive-mod qx 5)
          ty (World.positive-mod qy 5)
          tz (World.positive-mod qz 5)
          slot-idx (+ tx (+ (* ty 5) (* tz 25)))]
      (if (< slot-idx (Array.length chunks))
        (let [chunk (Array.unsafe-nth chunks slot-idx)]
          (if (and (= qx @(Chunk.coord-x chunk))
                   (and (= qy @(Chunk.coord-y chunk))
                        (= qz @(Chunk.coord-z chunk))))
            (let [lx (Double.to-int (Double.clamp 0.0 31.0 (- x (Double.from-int (* qx 32)))))
                  ly (Double.to-int (Double.clamp 0.0 31.0 (- y (Double.from-int (* qy 32)))))
                  lz (Double.to-int (Double.clamp 0.0 31.0 (- z (Double.from-int (* qz 32)))))
                  idx (+ (* lz 1024) (+ (* ly 32) lx))
                  offset (* idx 4)]
              @(Array.unsafe-nth (Chunk.voxel-data chunk) offset))
            0.0f))
        0.0f)))

  ;; Fast local CPU SDF update for tiny amoeba nibbles/excretions (pad=2.4 scans ~380 voxels vs World.edit-sdf! pad=16.0 scanning ~43,000!)
  (defn edit-amoeba-sdf! [world hit-pos radius mat-id carve?]
    (let [chunks (World.chunks world)
          len (Array.length chunks)
          hx @(Vector3.x hit-pos)
          hy @(Vector3.y hit-pos)
          hz @(Vector3.z hit-pos)
          pad 2.4
          r-pad (+ radius pad)]
      (for [i 0 len]
        (let [chunk (Array.unsafe-nth chunks i)
              qx @(Chunk.coord-x chunk)
              qy @(Chunk.coord-y chunk)
              qz @(Chunk.coord-z chunk)
              c-base-x (Double.from-int (* qx 32))
              c-base-y (Double.from-int (* qy 32))
              c-base-z (Double.from-int (* qz 32))
              min-x (Double.to-int (Double.floor (- (- hx r-pad) c-base-x)))
              max-x (Double.to-int (Double.ceil (- (+ hx r-pad) c-base-x)))
              min-y (Double.to-int (Double.floor (- (- hy r-pad) c-base-y)))
              max-y (Double.to-int (Double.ceil (- (+ hy r-pad) c-base-y)))
              min-z (Double.to-int (Double.floor (- (- hz r-pad) c-base-z)))
              max-z (Double.to-int (Double.ceil (- (+ hz r-pad) c-base-z)))
              clamped-min-x (if (< min-x 0) 0 min-x)
              clamped-max-x (if (> max-x 31) 31 max-x)
              clamped-min-y (if (< min-y 0) 0 min-y)
              clamped-max-y (if (> max-y 31) 31 max-y)
              clamped-min-z (if (< min-z 0) 0 min-z)
              clamped-max-z (if (> max-z 31) 31 max-z)]
          (when (and (<= clamped-min-x clamped-max-x)
                     (and (<= clamped-min-y clamped-max-y)
                          (<= clamped-min-z clamped-max-z)))
            (let [p-data (Array.unsafe-raw (Chunk.voxel-data chunk))]
              (for [z clamped-min-z (+ clamped-max-z 1)]
                (for [y clamped-min-y (+ clamped-max-y 1)]
                  (for [x clamped-min-x (+ clamped-max-x 1)]
                    (let [idx (+ (* z 1024) (+ (* y 32) x))
                          offset (* idx 4)
                          vx (- (+ c-base-x (Double.from-int x)) hx)
                          vy (- (+ c-base-y (Double.from-int y)) hy)
                          vz (- (+ c-base-z (Double.from-int z)) hz)
                          dist-to-hit (Double.sqrt (+ (+ (* vx vx) (* vy vy)) (* vz vz)))]
                      (when (< dist-to-hit r-pad)
                        (let [old-id (Pointer.to-value (Pointer.add p-data (Long.from-int offset)))
                              sphere-sdf (Double.to-float (- dist-to-hit radius))
                              neg-s (- 0.0f sphere-sdf)
                              old-sdf (Pointer.to-value (Pointer.add p-data (Long.from-int (+ offset 1))))
                              new-sdf (if carve?
                                        (if (> old-sdf neg-s) old-sdf neg-s)
                                        (if (< old-sdf sphere-sdf) old-sdf sphere-sdf))]
                          (when (not (and carve? (= old-id 255.0f)))
                            (do
                              (Pointer.set (Pointer.add p-data (Long.from-int (+ offset 1))) new-sdf)
                              (when (and (not carve?) (< dist-to-hit radius))
                                (Pointer.set (Pointer.add p-data (Long.from-int offset)) mat-id))))))))))))))))

  ;; Probe a deterministic golden-angle ray from player to populate natural cave walls/floors/ceilings
  (defn try-natural-cave-spawn! [state world cam-pos fc]
    (let [seed (Float.from-int (+ (* fc 17) 31))
          theta (* seed 2.399963f)
          u-seed (* seed 0.3183099f)
          y-raw (- (* (- u-seed (CritterSystem.ffloor u-seed)) 1.56f) 0.72f)
          r-xy (Float.sqrt (CritterSystem.fmax 0.05f (- 1.0f (* y-raw y-raw))))
          dx (Double.from-float (* (CritterSystem.fcos theta) r-xy))
          dy (Double.from-float y-raw)
          dz (Double.from-float (* (CritterSystem.fsin theta) r-xy))
          dir (Vector3.init dx dy dz)
          start-p (Vector3.add cam-pos &(Vector3.mul &dir 13.5))
          start-sdf (World.sample-sdf-nearest world &start-p)]
      (when (and (> start-sdf 1.4f) (< start-sdf 500.0f))
        (match (World.raycast world &start-p &dir 36.0)
          (Maybe.Nothing) ()
          (Maybe.Just hit-p)
            (let [hmat (CritterSystem.sample-solid-mat-near world &hit-p)]
              (when (and (< hmat 250.0f) (> @(Vector3.y &hit-p) -185.0))
                (let [nrm (Physics.estimate-sdf-normal world &hit-p)
                      spawn-p (Vector3.add &hit-p &(Vector3.mul &nrm 0.56))
                      clear-sdf (World.sample-sdf-nearest world &spawn-p)
                      pdist (Vector3.mag &(Vector3.sub &spawn-p cam-pos))]
                  ;; Every wild cave slime starts as a pure Grey stem-cell baby (0.0f) and imprints on local cave chemistry!
                  (when (and (> clear-sdf 0.36f) (and (> pdist 14.0) (< pdist 54.0)))
                    (let [slot (CritterSystem.spawn-amoeba! state spawn-p (Vector3.init 0.0 0.0 0.0) 0.0f 0.0f 0)]
                      (when (>= slot 0)
                        (let [cbank (EngineState.critters state)
                              b3 (* slot 3)]
                          (do
                            (Array.aset! (CritterBank.norm cbank) b3 (Double.to-float @(Vector3.x &nrm)))
                            (Array.aset! (CritterBank.norm cbank) (+ b3 1) (Double.to-float @(Vector3.y &nrm)))
                            (Array.aset! (CritterBank.norm cbank) (+ b3 2) (Double.to-float @(Vector3.z &nrm)))
                            (CritterBank.set-last-spawn-frame! cbank fc)))))))))))))

  ;; Detonate an Explosive Amoeba into a size-scaled crater, GPU MAT_FIRE bloom, and radial shockwave!
  (defn detonate-amoeba! [state world ps ecs pos slot]
    (let [cbank (EngineState.critters state)
          px @(Vector3.x pos)
          py @(Vector3.y pos)
          pz @(Vector3.z pos)
          fx (Double.to-float px)
          fy (Double.to-float py)
          fz (Double.to-float pz)
          cfill @(Array.unsafe-nth (CritterBank.fill cbank) slot)
          blast-r (+ 3.20f (* 1.35f cfill))
          carve-r (Double.from-float (- blast-r 0.15f))]
      (do
        (EngineState.push-voxel-action! state fx fy fz blast-r 1.0f -1.0f 0.0f)
        (EngineState.push-voxel-action! state fx fy fz (+ blast-r 1.2f) 515.0f 0.94f 1.0f)
        (ignore (World.edit-sdf! world pos carve-r 1.0f true))
        (ParticleSystem.emit-sparks! ps fx fy fz 0.0f 1.0f 0.0f 48)
        (ParticleSystem.emit-debris! ps fx fy fz 0.0f 1.0f 0.0f 24)
        (ParticleSystem.emit-smoke! ps fx (+ fy 0.4f) fz 26)
        (ParticleSystem.emit! ps fx fy fz 0.0f 6.5f 0.0f 2.4f 36 203.0f 0.85f 0.15f)
        ;; Radial shockwave on nearby rigid bodies, Cave Hoppers & non-flying player
        (let [a-idx (CritterBank.idx cbank)
              self-idx @(Array.unsafe-nth a-idx slot)
              player-id @(EngineState.player-ent-id state)
              flying? @(Player.flying (EngineState.player state))
              eb (EngineState.enemies state)
              h-alive (EnemyBank.alive eb)
              h-idx (EnemyBank.idx eb)]
          (query ecs (e (cb CompBody))
            (let [eidx (ECS.Entity.index &e)
                  eid (Long.to-int (Uint64.to-long eidx))]
              (when (and (not (Uint64.= eidx self-idx))
                         (or (/= eid player-id) (not flying?)))
                (let [rb (CompBody.rb cb)
                      epos (RigidBody.position rb)
                      dx (- @(Vector3.x epos) px)
                      dy (- @(Vector3.y epos) py)
                      dz (- @(Vector3.z epos) pz)
                      dist (Double.sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz)))]
                  (when (< dist 8.5)
                    (let [inv-d (if (> dist 0.15) (/ 1.0 dist) 0.0)
                          falloff (- 1.0 (/ dist 8.8))
                          push (* 24.0 falloff)]
                      (if (= eid player-id)
                        (ignore (PlayerSystem.damage-player! state
                                  (Float.clamp 8.0f 30.0f (* 28.0f (Double.to-float falloff)))
                                  true
                                  (* (* dx inv-d) push)
                                  (+ (* (* dy inv-d) push) 7.5)
                                  (* (* dz inv-d) push)))
                        (let [b (RigidBody.body rb)
                              old-v @(Body.velocity b)
                              dv (Vector3.init (* (* dx inv-d) push)
                                               (+ (* (* dy inv-d) push) 7.5)
                                               (* (* dz inv-d) push))
                              nv (Vector3.add &old-v &dv)
                              nv-spd (Double.to-float (Vector3.mag &nv))]
                          (do
                            (Body.set-body-type! b (BodyType.Dynamic))
                            (Body.set-inv-mass! b 1.0)
                            (Body.set-inv-inertia! b 4.0)
                            (Body.set-velocity! b nv)
                            (RigidBody.set-body! rb @b)
                            (ECS.add-component! ecs &e (CompBody.init @rb))
                            (for [hk 0 16]
                              (when (and @(Array.unsafe-nth h-alive hk)
                                         (Uint64.= eidx @(Array.unsafe-nth h-idx hk)))
                                (do
                                  (Array.aset! (EnemyBank.hurt-cd eb) hk 0.0f)
                                  (Array.aset! (EnemyBank.prev-spd eb) hk (+ nv-spd 29.0f)))))))))))))))
        (CritterSystem.destroy-amoeba-slot! state slot))))

  (defn update! [state input dt]
    (let [world (EngineState.world state)
          player (EngineState.player state)
          cam (Player.camera player)
          cam-pos (Camera.pos cam)
          cam-dir (Camera.front cam)
          ps (EngineState.particles state)
          ecs (EngineState.ecs-world state)
          rig (EngineState.rig state)
          cbank (EngineState.critters state)
          fc @(EngineState.frame-count state)
          fdt (Double.to-float dt)
          raw-rb (gpu-readback-get-raw)
          ;; Direct Rig spray check so squirting [1]/[2]/[3] at an Amoeba feeds/reacts immediately!
          rslot @(RigBelt.slot rig)
          lmb? (InputManager.action-digital? input "click-left")
          jet-x (gpu-readback-get-jet-x)
          jet-y (gpu-readback-get-jet-y)
          jet-z (gpu-readback-get-jet-z)
          jet-w (gpu-readback-get-jet-w)
          spray-mat (if (not (and lmb? (and (< rslot 3) (> jet-w 0.5f))))
                      0.0f
                      (if (= rslot 0)
                        (if (> @(RigBelt.sack-fill rig) 0.004f) @(RigBelt.sack-mat rig) 0.0f)
                        (if (= rslot 1)
                          (if (> @(RigBelt.flask-fill rig) 0.004f) @(RigBelt.flask-mat rig) 0.0f)
                          (if (> @(RigBelt.bellows-fill rig) 0.004f) @(RigBelt.bellows-mat rig) 0.0f))))
          p-ent (ECS.Entity.init (Handle.init (Uint64.from-long (the Long (Long.from-int @(EngineState.player-ent-id state)))) (Uint32.from-long 1l)))
          flying? @(Player.flying player)
          a-alive (CritterBank.alive cbank)
          a-idx (CritterBank.idx cbank)
          a-gen (CritterBank.gen cbank)
          a-mat (CritterBank.mat cbank)
          a-fill (CritterBank.fill cbank)
          a-rad (CritterBank.rad cbank)
          a-state (CritterBank.state cbank)
          a-timer (CritterBank.timer cbank)
          a-phase (CritterBank.phase cbank)
          a-pod (CritterBank.pod cbank)
          a-norm (CritterBank.norm cbank)
          a-goal (CritterBank.goal cbank)
          active-count 0]
      (do

        ;; T Key: Toss a fresh Grey stem-cell Slime right from the camera for instant alchemy imprinting!
        (when (and (InputManager.action-pressed? input "spawn-amoeba")
                   (> (- fc @(CritterBank.last-spawn-frame cbank)) 10))
          (let [spawn-p (Vector3.add cam-pos &(Vector3.mul cam-dir 1.85))
                toss-v (Vector3.init (* @(Vector3.x cam-dir) 9.5)
                                     (+ (* @(Vector3.y cam-dir) 9.5) 2.2)
                                     (* @(Vector3.z cam-dir) 9.5))
                sx (Double.to-float @(Vector3.x &spawn-p))
                sy (Double.to-float @(Vector3.y &spawn-p))
                sz (Double.to-float @(Vector3.z &spawn-p))
                slot (CritterSystem.spawn-amoeba! state spawn-p toss-v 0.0f 0.0f 4)]
            (when (>= slot 0)
              (do
                (CritterBank.set-last-spawn-frame! cbank fc)
                (ParticleSystem.emit! ps sx sy sz 0.0f 2.2f 0.0f 0.85f 14 101.0f 0.25f 0.15f)))))

        ;; Step all 16 Amoeba slots
        (for [k 0 16]
          (when @(Array.unsafe-nth a-alive k)
            (let [idx @(Array.unsafe-nth a-idx k)
                  gen @(Array.unsafe-nth a-gen k)
                  ent (ECS.Entity.init (Handle.init idx gen))
                  cb-opt (the (Maybe CompBody) (get-component ecs &ent))]
              (match cb-opt
                (Maybe.Nothing)
                  (do
                    (Array.aset! a-alive k false)
                    (Array.aset! a-mat k 0.0f)
                    (Array.aset! a-fill k 0.0f))
                (Maybe.Just cb)
                  (let [rb (CompBody.rb &cb)
                        pos @(RigidBody.position rb)
                        px @(Vector3.x &pos)
                        py @(Vector3.y &pos)
                        pz @(Vector3.z &pos)
                        fx (Double.to-float px)
                        fy (Double.to-float py)
                        fz (Double.to-float pz)
                        to-cam (Vector3.sub cam-pos &pos)
                        cam-dist (Vector3.mag &to-cam)
                        held? (Uint64.= @(RigBelt.grab-idx rig) idx)]
                    ;; Recycle wild amoebas that drift > 78m away or fall below world floor
                    (if (and (not held?) (or (> cam-dist 78.0) (< py -210.0)))
                      (CritterSystem.destroy-amoeba-slot! state k)
                      (let [rb-base (+ 16 (* k 8))
                            smell-x (Pointer.to-value (Pointer.add raw-rb (Long.from-int rb-base)))
                            smell-y (Pointer.to-value (Pointer.add raw-rb (Long.from-int (+ rb-base 1))))
                            smell-z (Pointer.to-value (Pointer.add raw-rb (Long.from-int (+ rb-base 2))))
                            smell-mat (Pointer.to-value (Pointer.add raw-rb (Long.from-int (+ rb-base 3))))
                            touch-liq (Pointer.to-value (Pointer.add raw-rb (Long.from-int (+ rb-base 4))))
                            touch-gas (Pointer.to-value (Pointer.add raw-rb (Long.from-int (+ rb-base 5))))
                            touch-ign-raw (Pointer.to-value (Pointer.add raw-rb (Long.from-int (+ rb-base 6))))
                            touch-ext-raw (Pointer.to-value (Pointer.add raw-rb (Long.from-int (+ rb-base 7))))
                            ;; Check if player's active [1]/[2]/[3] stream is splashing this amoeba right now
                            jdx (- fx jet-x)
                            jdy (- fy jet-y)
                            jdz (- fz jet-z)
                            jdist (Float.sqrt (+ (+ (* jdx jdx) (* jdy jdy)) (* jdz jdz)))
                            cur-mat @(Array.unsafe-nth a-mat k)
                            cur-fill @(Array.unsafe-nth a-fill k)
                            cur-state @(Array.unsafe-nth a-state k)
                            cur-timer @(Array.unsafe-nth a-timer k)
                            cur-phase @(Array.unsafe-nth a-phase k)
                            rad-f (CritterSystem.amoeba-radius cur-mat cur-fill)
                            rad-d (Double.from-float rad-f)
                            sprayed? (and (> spray-mat 0.5f) (< jdist (+ rad-f 1.85f)))
                            touch-ign (or (> touch-ign-raw 0.5f)
                                          (and sprayed? (Materials.igniter? spray-mat)))
                            touch-ext (or (> touch-ext-raw 0.5f)
                                          (and sprayed? (Materials.extinguisher? spray-mat)))
                            b (RigidBody.body rb)
                            vel @(Body.velocity b)
                            speed (Vector3.mag &vel)
                            d-sdf (Physics.sample-euclidean-sdf world &pos)
                            b3 (* k 3)
                            ;; Check proximity to siblings for chain ignition AND gentle squishy separation!
                            hot-sibling? false
                            sep-x 0.0
                            sep-y 0.0
                            sep-z 0.0]
                        (do
                          (for [ok 0 16]
                            (when (and (/= ok k) @(Array.unsafe-nth a-alive ok))
                              (let [om @(Array.unsafe-nth a-mat ok)
                                    os @(Array.unsafe-nth a-state ok)
                                    orad (Double.from-float @(Array.unsafe-nth a-rad ok))
                                    oent (ECS.Entity.init (Handle.init @(Array.unsafe-nth a-idx ok) @(Array.unsafe-nth a-gen ok)))
                                    ocb-opt (the (Maybe CompBody) (get-component ecs &oent))]
                                (match ocb-opt
                                  (Maybe.Nothing) ()
                                  (Maybe.Just ocb)
                                    (let [opos (RigidBody.position (CompBody.rb &ocb))
                                          away (Vector3.sub &pos opos)
                                          od (Vector3.mag &away)
                                          min-sep (* (+ rad-d orad) 0.90)]
                                      (do
                                        (when (and (or (= os 3) (Materials.igniter? om))
                                                   (< od (+ (+ rad-d orad) 0.55)))
                                          (set! hot-sibling? true))
                                        (when (and (< od min-sep) (> od 0.02))
                                          (let [push (/ (* (- min-sep od) 1.45) od)]
                                            (do
                                              (set! sep-x (+ sep-x (* @(Vector3.x &away) push)))
                                              (set! sep-y (+ sep-y (* @(Vector3.y &away) push)))
                                              (set! sep-z (+ sep-z (* @(Vector3.z &away) push))))))))))))

                          (let [ignited? (or touch-ign hot-sibling?)]
                            ;; --- 1. LETHAL / TRANSFORMATIVE COUNTER-REACTIONS ---
                            ;; 1a. Lava / Fire Amoeba doused with Water -> *tssst!* Flash-Petrifies into Solid Obsidian!
                            (if (and (Materials.igniter? cur-mat) touch-ext)
                              (let [was-held? held?
                                    obs-col (Materials.boulder-color 16.0f)
                                    obs-r (+ 0.46 (* 0.42 (Double.from-float cur-fill)))
                                    obs-ent (CritterSystem.spawn-reagent-boulder! state pos (Vector3.mul &vel 0.35) obs-r 16.0f obs-col 60000l)]
                                (do
                                  (EngineState.push-voxel-action! state fx fy fz (+ 2.30f (* 0.85f cur-fill)) 513.0f 0.85f 0.0f)
                                  (ParticleSystem.emit! ps fx fy fz 0.0f 4.2f 0.0f 1.8f 28 201.0f 0.55f 0.0f)
                                  (ParticleSystem.emit-smoke! ps fx (+ fy 0.2f) fz 12)
                                  (CritterSystem.destroy-amoeba-slot! state k)
                                  (when was-held?
                                    (do
                                      (RigBelt.set-grab-idx! rig (ECS.Entity.index &obs-ent))
                                      (RigBelt.set-grab-gen! rig (ECS.Entity.generation &obs-ent))
                                      (RigBelt.set-grab-mat! rig 16.0f)))))

                              ;; 1b. Explosive Amoeba + Igniter OR High-Speed Punt Impact -> KABOOM!
                              (if (and (Materials.explosive? cur-mat)
                                       (or ignited?
                                           (and (= cur-state 4) (and (> speed 15.5) (< d-sdf (+ rad-d 0.72))))))
                                (CritterSystem.detonate-amoeba! state world ps ecs &pos k)

                                ;; 1c. Ice Amoeba + Heat -> Melts into a splash of Water!
                                (if (and (= (Float.round cur-mat) 8) ignited?)
                                  (do
                                    (EngineState.push-voxel-action! state fx fy fz (+ 2.00f (* 0.90f cur-fill)) 257.0f 0.75f 0.0f)
                                    (ParticleSystem.emit! ps fx fy fz 0.0f 3.5f 0.0f 1.5f 24 101.0f 0.45f 0.25f)
                                    (CritterSystem.destroy-amoeba-slot! state k))

                                  ;; 1d. Burning Amoeba burnout check (after ~5.5s -> chars into Coal lump)
                                  (if (and (= cur-state 3) (and (not touch-ext) (>= (+ cur-timer fdt) 5.5f)))
                                    (let [coal-col (Materials.boulder-color 4.0f)
                                          coal-r (+ 0.36 (* 0.32 (Double.from-float cur-fill)))]
                                      (do
                                        (ignore (CritterSystem.spawn-reagent-boulder! state pos (Vector3.mul &vel 0.25) coal-r 4.0f coal-col 45000l))
                                        (ParticleSystem.emit-smoke! ps fx (+ fy 0.25f) fz 16)
                                        (CritterSystem.destroy-amoeba-slot! state k)))

                                    ;; --- 2. SURVIVING AMOEBA UPDATE ---
                                    (let [next-mat cur-mat
                                          next-fill cur-fill
                                          next-state cur-state
                                          next-timer cur-timer
                                          gait-rate (if (= cur-state 3) 6.8f (- 3.65f (* 1.05f cur-fill)))
                                          next-phase (+ cur-phase (* fdt gait-rate))]
                                      (do
                                        (set! active-count (+ active-count 1))

                                        ;; Flammable ignition / Water extinguishing transitions
                                        (when (and (Materials.flammable? next-mat) (and (/= next-state 3) ignited?))
                                          (do
                                            (set! next-state 3)
                                            (set! next-timer 0.0f)
                                            (ParticleSystem.emit-sparks! ps fx fy fz 0.0f 1.0f 0.0f 18)))
                                        (when (and (= next-state 3) touch-ext)
                                          (do
                                            (set! next-state 0)
                                            (set! next-timer 0.0f)
                                            (ParticleSystem.emit! ps fx fy fz 0.0f 2.8f 0.0f 1.1f 14 201.0f 0.4f 0.0f)))

                                        ;; Direct [1]/[2]/[3] Rig stream feeding:
                                        ;; Grey Slimes (mat == 0) permanently lock onto the first valid element sprayed!
                                        ;; Locked Slimes strictly fatten up on their locked element family (or golden Ambrosia)!
                                        (when (and sprayed?
                                                   (and (/= next-state 2)
                                                        (and (CritterSystem.compatible-diet? next-mat spray-mat)
                                                             (not (and (Materials.igniter? next-mat) (Materials.extinguisher? spray-mat))))))
                                          (if (<= (Float.round next-mat) 0)
                                            (do
                                              (set! next-mat spray-mat)
                                              (set! next-fill (Float.clamp 0.16f 1.0f (+ next-fill (* 0.65f fdt)))))
                                            (set! next-fill (Float.clamp 0.0f 1.0f (+ next-fill (* 0.56f fdt))))))

                                        ;; Burning amoeba trails live GPU Fire & sparks!
                                        (when (= next-state 3)
                                          (do
                                            (set! next-timer (+ next-timer fdt))
                                            (when (= (Int.mod (+ fc k) 3) 0)
                                              (do
                                                (ParticleSystem.emit! ps fx (+ fy 0.15f) fz 0.0f 2.6f 0.0f 0.85f 3 PARTICLE-TYPE-SPARKS 0.45f 0.25f)
                                                (ParticleSystem.emit-smoke! ps fx (+ fy 0.25f) fz 1)))
                                            (when (= (Int.mod (+ fc (* k 5)) 10) 0)
                                              (EngineState.push-voxel-action! state fx (+ fy 0.2f) fz 1.65f 515.0f 0.55f 0.0f))))

                                        ;; Player interactions (Chonk-scaled Slime Trampoline Bounce or Spicy Enemy Bite!)
                                        (when (and (not held?) (not flying?))
                                          (let [p-cb-opt (the (Maybe CompBody) (get-component ecs &p-ent))]
                                            (match p-cb-opt
                                              (Maybe.Nothing) ()
                                              (Maybe.Just p-cb)
                                                (let [p-rb (CompBody.rb &p-cb)
                                                      p-pos (RigidBody.position p-rb)
                                                      pdx (- @(Vector3.x p-pos) px)
                                                      pdy (- @(Vector3.y p-pos) py)
                                                      pdz (- @(Vector3.z p-pos) pz)
                                                      h-dist (Double.sqrt (+ (* pdx pdx) (* pdz pdz)))
                                                      full-dist (Double.sqrt (+ (+ (* pdx pdx) (* pdy pdy)) (* pdz pdz)))
                                                      fill-d (Double.from-float next-fill)]
                                                  ;; Slime Amoeba -> Living Super-Trampoline (bigger chonk = higher launch!)
                                                  (if (and (Materials.bouncy? next-mat)
                                                           (and (< h-dist (+ rad-d 0.85))
                                                                (and (> pdy -0.35) (< pdy (+ rad-d 1.25)))))
                                                    (let [pb (RigidBody.body p-rb)
                                                          pv @(Body.velocity pb)
                                                          boing-vy (+ 17.5 (* 6.0 fill-d))]
                                                      (when (< @(Vector3.y &pv) 10.0)
                                                        (do
                                                          (Body.set-velocity! pb (Vector3.init @(Vector3.x &pv) boing-vy @(Vector3.z &pv)))
                                                          (RigidBody.set-body! p-rb @pb)
                                                          (ECS.add-component! ecs &p-ent (CompBody.init @p-rb))
                                                          (ParticleSystem.emit! ps fx (+ fy 0.35f) fz 0.0f 6.0f 0.0f 1.6f 18 410.0f 0.35f 0.25f))))
                                                    ;; Spicy / Burning Amoeba -> Size-Scaled Sizzle Bite + Knockback!
                                                    (when (and (or (= next-state 3) (Materials.spicy-hazard? next-mat))
                                                               (and (< full-dist (+ rad-d 0.95))
                                                                    (>= (- fc @(CritterBank.last-hurt-frame cbank)) 22)))
                                                      (let [inv-h (if (> h-dist 0.05) (/ 1.0 h-dist) 0.0)
                                                            kx (if (> h-dist 0.05) (* pdx inv-h) 1.0)
                                                            kz (if (> h-dist 0.05) (* pdz inv-h) 1.0)
                                                            kb-h (+ 9.5 (* 6.0 fill-d))
                                                            kb-y (+ 6.6 (* 2.8 fill-d))
                                                            bite-dmg (+ 11.0f (* 6.0f next-fill))
                                                            hpt (Materials.jet-ptype (if (= next-state 3) 515.0f next-mat))]
                                                        (do
                                                          (CritterBank.set-last-hurt-frame! cbank fc)
                                                          (when (PlayerSystem.damage-player! state bite-dmg true (* kx kb-h) kb-y (* kz kb-h))
                                                            (ParticleSystem.emit! ps fx (+ fy 0.3f) fz (Double.to-float (* kx 8.0)) 4.5f (Double.to-float (* kz 8.0)) 1.5f 20 hpt 0.35f 0.2f))))))))))

                                        ;; --- 3. LOCOMOTION, PSEUDOPOD REACH, FEEDING & MITOSIS ---
                                        (if held?
                                          ;; 3a. Held in [4] Gauntlet: Dynamic body so spring grasp & LMB Power-Punt work seamlessly!
                                          (let [wiggle-x (+ (* (Double.to-float @(Vector3.x cam-dir)) (* rad-f 0.95f)) (* 0.22f (CritterSystem.fsin (* next-phase 1.7f))))
                                                wiggle-y (+ (* (Double.to-float @(Vector3.y cam-dir)) (* rad-f 0.95f)) (* 0.18f (CritterSystem.fcos (* next-phase 1.3f))))
                                                wiggle-z (+ (* (Double.to-float @(Vector3.z cam-dir)) (* rad-f 0.95f)) (* 0.22f (CritterSystem.fcos (* next-phase 1.7f))))]
                                            (do
                                              (Body.set-body-type! b (BodyType.Dynamic))
                                              (Body.set-inv-mass! b 1.0)
                                              (Body.set-inv-inertia! b 4.0)
                                              (RigBelt.set-grab-mat! rig (+ 1000.0f (Float.from-int (Float.round next-mat))))
                                              (when (/= next-state 3) (set! next-state 4))
                                              (Array.aset! a-pod b3 wiggle-x)
                                              (Array.aset! a-pod (+ b3 1) wiggle-y)
                                              (Array.aset! a-pod (+ b3 2) wiggle-z)))

                                          (if (= next-state 2)
                                            ;; 3b. MITOSIS PINCHING DUMBBELL: giant chonk anchors -> wobbles two lobes -> excretes -> splits into 1 LOCKED + 1 GREY!
                                            (let [raw-n (Physics.smooth-sdf-normal world &pos)
                                                  ny @(Vector3.y &raw-n)
                                                  ref-v (if (< (Double.abs ny) 0.85) (Vector3.init 0.0 1.0 0.0) (Vector3.init 1.0 0.0 0.0))
                                                  t-raw (Vector3.cross &raw-n &ref-v)
                                                  t-mag (Vector3.mag &t-raw)
                                                  axis (if (> t-mag 0.01) (Vector3.mul &t-raw (/ 1.0 t-mag)) (Vector3.init 1.0 0.0 0.0))
                                                  prog (+ next-timer fdt)
                                                  split-norm (Float.clamp 0.0f 1.0f (/ prog 1.32f))
                                                  wob (+ (* split-norm (* rad-f 0.90f)) (* 0.06f (CritterSystem.fsin (* prog 22.0f))))
                                                  target-d (* rad-d 0.72)
                                                  dn (Double.clamp -0.12 0.12 (* (- target-d d-sdf) 0.35))]
                                              (do
                                                (Body.set-body-type! b (BodyType.Kinematic))
                                                (Body.set-inv-mass! b 0.0)
                                                (Body.set-inv-inertia! b 0.0)
                                                (Body.set-velocity! b (Vector3.init 0.0 0.0 0.0))
                                                (when (< d-sdf (+ rad-d 0.55))
                                                  (Transform.set-position! (RigidBody.transform rb) (Vector3.add &pos &(Vector3.mul &raw-n dn))))
                                                (Array.aset! a-pod b3 (* (Double.to-float @(Vector3.x &axis)) wob))
                                                (Array.aset! a-pod (+ b3 1) (* (Double.to-float @(Vector3.y &axis)) wob))
                                                (Array.aset! a-pod (+ b3 2) (* (Double.to-float @(Vector3.z &axis)) wob))
                                                (if (< prog 1.32f)
                                                  (set! next-timer prog)
                                                  ;; *BLOOP!* Excrete refined reagent & bud into 1 LOCKED original + 1 fresh GREY baby!
                                                  (let [prod (CritterSystem.transmute-product next-mat)
                                                        ppt (Materials.jet-ptype prod)
                                                        ex-p (Vector3.add &pos &(Vector3.mul &raw-n (* rad-d 0.78)))
                                                        ex-x (Double.to-float @(Vector3.x &ex-p))
                                                        ex-y (Double.to-float @(Vector3.y &ex-p))
                                                        ex-z (Double.to-float @(Vector3.z &ex-p))
                                                        off (Vector3.mul &axis (* rad-d 0.68))
                                                        lift (Vector3.mul &raw-n 0.10)
                                                        pos-a (Vector3.add &(Vector3.add &pos &off) &lift)
                                                        pos-b (Vector3.add &(Vector3.sub &pos &off) &lift)
                                                        vel-b (Vector3.init 0.0 0.0 0.0)]
                                                    (do
                                                      (if (= (Float.round prod) 5)
                                                        (let [gv1 (Vector3.add &(Vector3.mul &raw-n 5.2) &(Vector3.mul &axis 2.4))
                                                              gv2 (Vector3.sub &(Vector3.mul &raw-n 5.2) &(Vector3.mul &axis 2.4))]
                                                          (do
                                                            (ignore (GoldSystem.spawn-nugget! state @&ex-p gv1 0.30 20))
                                                            (ignore (GoldSystem.spawn-nugget! state ex-p gv2 0.30 20))
                                                            (ParticleSystem.emit-sparks! ps ex-x ex-y ex-z 0.0f 1.0f 0.0f 18)))
                                                        (let [gran? (Materials.granular? prod)
                                                              prad (if (< prod 256.0f) 1.18f (if (< prod 512.0f) 1.85f 2.65f))]
                                                          (do
                                                            (EngineState.push-voxel-action! state ex-x ex-y ex-z prad (if gran? (- 0.0f prod) prod) 0.85f 0.0f)
                                                            (when (and (< prod 256.0f) (not gran?))
                                                              (CritterSystem.edit-amoeba-sdf! world &ex-p 1.12 prod false)))))
                                                      (ParticleSystem.emit! ps ex-x ex-y ex-z 0.0f 4.2f 0.0f 1.5f 24 ppt 0.35f 0.25f)
                                                      ;; Daughter A: Keeps locked breed (next-mat), shrinks back to 0.42m hungry breeder!
                                                      (Transform.set-position! (RigidBody.transform rb) pos-a)
                                                      (set! next-fill 0.0f)
                                                      (set! next-state 0)
                                                      (set! next-timer -10.0f)
                                                      ;; Daughter B: Fresh 0.36m Grey stem-cell baby (0.0f) ready to imprint or relocate!
                                                      (let [cslot (CritterSystem.spawn-amoeba! state pos-b vel-b 0.0f 0.0f 0)]
                                                        (when (>= cslot 0)
                                                          (Array.aset! a-timer cslot -5.5f))))))))

                                            ;; 3c. AIRBORNE BALLISTIC ARC vs KINEMATIC ISO-SURFACE CRAWL
                                            (let [smooth-n (Physics.smooth-sdf-normal world &pos)
                                                  vn-out (Vector3.dot &vel &smooth-n)
                                                  slime-bounce? (and (Materials.bouncy? next-mat) (> speed 5.5))
                                                  launching? (and (> speed 4.5) (> vn-out 1.25))
                                                  airborne? (or (> d-sdf (+ rad-d 0.58))
                                                                (or launching?
                                                                    (and slime-bounce? (> d-sdf (- rad-d 0.15)))))]
                                              (if airborne?
                                                ;; Airborne arc (tossed with T, punted, or falling): Dynamic gravity + trailing tail!
                                                (let [tx (Float.clamp -0.95f 0.95f (* (Double.to-float @(Vector3.x &vel)) -0.045f))
                                                      ty (Float.clamp -0.95f 0.95f (* (Double.to-float @(Vector3.y &vel)) -0.045f))
                                                      tz (Float.clamp -0.95f 0.95f (* (Double.to-float @(Vector3.z &vel)) -0.045f))]
                                                  (do
                                                    (Body.set-body-type! b (BodyType.Dynamic))
                                                    (Body.set-inv-mass! b 1.0)
                                                    (Body.set-inv-inertia! b 4.0)
                                                    (when (/= next-state 3) (set! next-state 4))
                                                    (Array.aset! a-pod b3 tx)
                                                    (Array.aset! a-pod (+ b3 1) ty)
                                                    (Array.aset! a-pod (+ b3 2) tz)))

                                                ;; Clinging to cave rock (floor, vertical cliff, or upside-down ceiling!):
                                                ;; Smooth Kinematic iso-surface gliding so Solver never bounces or catapults them!
                                                (let [old-nx (Double.from-float @(Array.unsafe-nth a-norm b3))
                                                      old-ny (Double.from-float @(Array.unsafe-nth a-norm (+ b3 1)))
                                                      old-nz (Double.from-float @(Array.unsafe-nth a-norm (+ b3 2)))
                                                      blend-n (Vector3.init (+ (* old-nx 0.76) (* @(Vector3.x &smooth-n) 0.24))
                                                                            (+ (* old-ny 0.76) (* @(Vector3.y &smooth-n) 0.24))
                                                                            (+ (* old-nz 0.76) (* @(Vector3.z &smooth-n) 0.24)))
                                                      bn-mag (Vector3.mag &blend-n)
                                                      nrm (if (> bn-mag 0.01) (Vector3.mul &blend-n (/ 1.0 bn-mag)) @&smooth-n)
                                                      has-smell? (and (> smell-mat 0.5f)
                                                                      (and (/= next-state 3)
                                                                           (CritterSystem.compatible-diet? next-mat smell-mat)))
                                                      s-pos (Vector3.init (Double.from-float smell-x) (Double.from-float smell-y) (Double.from-float smell-z))
                                                      to-snack (Vector3.sub &s-pos &pos)
                                                      snack-dist (if has-smell? (Vector3.mag &to-snack) 999.0)
                                                      snack-reach (+ rad-d 1.78)
                                                      ;; Refresh wander tangent leisurely when no snack is smelled
                                                      wander-ang (+ (* (Float.from-int (+ k 1)) 2.1f) (* (CritterSystem.ffloor (/ next-phase 6.28318f)) 1.65f))
                                                      w-raw (Vector3.init (Double.from-float (CritterSystem.fcos wander-ang))
                                                                          (Double.from-float (* 0.38f (CritterSystem.fsin (* wander-ang 1.7f))))
                                                                          (Double.from-float (CritterSystem.fsin wander-ang)))
                                                      ;; Spicy hazard amoebas stalk non-flying players who step within 5.2m!
                                                      stalk-player? (and (not flying?)
                                                                         (and (< cam-dist 5.2)
                                                                              (Materials.spicy-hazard? next-mat)))
                                                      raw-seek (if stalk-player?
                                                                 @&to-cam
                                                                 (if has-smell? @&to-snack @&w-raw))
                                                      ;; Project seek direction onto tangent plane of the cave surface
                                                      dot-n (Vector3.dot &raw-seek &nrm)
                                                      tang-raw (Vector3.sub &raw-seek &(Vector3.mul &nrm dot-n))
                                                      tang-mag (Vector3.mag &tang-raw)
                                                      tang (if (> tang-mag 0.01)
                                                             (Vector3.mul &tang-raw (/ 1.0 tang-mag))
                                                             (Vector3.init 1.0 0.0 0.0))
                                                      ;; Project soft sibling separation onto tangent plane
                                                      sep-v (Vector3.init sep-x sep-y sep-z)
                                                      sep-dot (Vector3.dot &sep-v &nrm)
                                                      sep-tang (Vector3.sub &sep-v &(Vector3.mul &nrm sep-dot))
                                                      ;; Squishy smin inchworm gait scaled to body size (chonkers lumber heavily!)
                                                      cyc (CritterSystem.fsin next-phase)
                                                      cyc-cos (CritterSystem.fcos next-phase)
                                                      max-pod (* rad-f 2.05f)
                                                      reach-len (if (and has-smell? (< snack-dist snack-reach))
                                                                  (Float.clamp (* rad-f 0.65f) max-pod (+ (Double.to-float snack-dist) (* 0.14f cyc)))
                                                                  (+ (* rad-f 0.82f) (* (* rad-f 1.05f) (CritterSystem.fmax 0.0f cyc))))
                                                      shlorp (Double.from-float (CritterSystem.fmax 0.0f (- 0.0f cyc-cos)))
                                                      chonk-mul (if (<= (Float.round next-mat) 0)
                                                                  1.16
                                                                  (- 1.08 (* 0.32 (Double.from-float next-fill))))
                                                      base-spd (if (= next-state 3)
                                                                 2.85
                                                                 (* (if (or has-smell? stalk-player?) 1.44 0.84) chonk-mul))
                                                      surge (* base-spd (+ 0.14 (* 0.96 shlorp)))
                                                      step-dt (Double.clamp 0.0 0.05 dt)
                                                      target-d (* rad-d 0.70)
                                                      dn1 (Double.clamp -0.18 0.18 (* (- target-d d-sdf) (Double.clamp 0.0 0.75 (* step-dt 9.0))))
                                                      tang-step (Vector3.add &(Vector3.mul &tang (* surge step-dt))
                                                                             &(Vector3.mul &sep-tang step-dt))
                                                      mid-pos (Vector3.add &(Vector3.add &pos &tang-step)
                                                                           &(Vector3.mul &nrm dn1))
                                                      d2 (Physics.sample-euclidean-sdf world &mid-pos)
                                                      dn2 (Double.clamp -0.12 0.12 (* (- target-d d2) 0.55))
                                                      final-pos (Vector3.add &mid-pos &(Vector3.mul &nrm dn2))]
                                                  (do
                                                    (Body.set-body-type! b (BodyType.Kinematic))
                                                    (Body.set-inv-mass! b 0.0)
                                                    (Body.set-inv-inertia! b 0.0)
                                                    (Body.set-velocity! b (Vector3.init 0.0 0.0 0.0))
                                                    (Transform.set-position! (RigidBody.transform rb) final-pos)
                                                    (Array.aset! a-norm b3 (Double.to-float @(Vector3.x &nrm)))
                                                    (Array.aset! a-norm (+ b3 1) (Double.to-float @(Vector3.y &nrm)))
                                                    (Array.aset! a-norm (+ b3 2) (Double.to-float @(Vector3.z &nrm)))

                                                    (if (and has-smell? (< snack-dist snack-reach))
                                                      ;; Point reaching smin pseudopod directly into the snack and SLURP!
                                                      (let [sdir (if (> snack-dist 0.05) (Vector3.mul &to-snack (/ 1.0 snack-dist)) @&tang)
                                                            rl-d (Double.from-float reach-len)
                                                            pod-v (Vector3.mul &sdir rl-d)
                                                            eat-mat smell-mat
                                                            eat-m (Float.round eat-mat)
                                                            base-absorb (if (and (= (Float.round next-mat) 11) (and (> eat-mat 256.5f) (< eat-mat 512.0f)))
                                                                          0.32f
                                                                          (if (= eat-m 3) 0.085f 0.135f))
                                                            absorb-rate (if (< next-timer 0.0f) (* base-absorb 0.30f) base-absorb)]
                                                        (do
                                                          (when (/= next-state 3) (set! next-state 1))
                                                          (Array.aset! a-pod b3 (Double.to-float @(Vector3.x &pod-v)))
                                                          (Array.aset! a-pod (+ b3 1) (Double.to-float @(Vector3.y &pod-v)))
                                                          (Array.aset! a-pod (+ b3 2) (Double.to-float @(Vector3.z &pod-v)))
                                                          ;; Grey Slime locks permanently onto its first meal; Locked Slime grows strictly on its element!
                                                          (if (<= (Float.round next-mat) 0)
                                                            (do
                                                              (set! next-mat eat-mat)
                                                              (set! next-fill (Float.clamp 0.16f 1.0f (+ next-fill (* absorb-rate fdt)))))
                                                            (set! next-fill (Float.clamp 0.0f 1.0f (+ next-fill (* absorb-rate fdt)))))
                                                          ;; Take real smooth SDF bites / fluid siphons out of the GPU + CPU world!
                                                          (when (= (Int.mod (+ fc (* k 5)) 18) 0)
                                                            (let [spt (Materials.succ-ptype eat-mat)
                                                                  bite-r (if (< eat-mat 256.0f) 1.28f (if (< eat-mat 512.0f) 2.15f 2.85f))]
                                                              (do
                                                                (CritterBank.set-last-bite-frame! cbank fc)
                                                                (EngineState.push-voxel-action! state smell-x smell-y smell-z bite-r eat-mat -0.65f 0.0f)
                                                                (when (< eat-mat 256.0f)
                                                                  (CritterSystem.edit-amoeba-sdf! world &s-pos 1.22 eat-mat true))
                                                                (ParticleSystem.emit! ps smell-x smell-y smell-z
                                                                                      (* (- fx smell-x) 3.2f)
                                                                                      (* (- fy smell-y) 3.2f)
                                                                                      (* (- fz smell-z) 3.2f)
                                                                                      0.28f 6 spt 0.08f 0.0f))))))

                                                      ;; Touch-sipping if sitting directly in a diet-compatible puddle/cloud!
                                                      (let [rl-d (Double.from-float reach-len)
                                                            pod-v (Vector3.sub &(Vector3.mul &tang rl-d) &(Vector3.mul &nrm 0.12))
                                                            raw-sip (if (> touch-liq 256.5f) touch-liq
                                                                    (if (or (= (Float.round touch-gas) 513)
                                                                            (or (= (Float.round touch-gas) 517)
                                                                                (or (= (Float.round touch-gas) 518) (= (Float.round touch-gas) 520))))
                                                                      touch-gas
                                                                      0.0f))
                                                            sip-ok? (and (> raw-sip 0.5f)
                                                                         (and (/= next-state 3)
                                                                              (CritterSystem.compatible-diet? next-mat raw-sip)))
                                                            sip-rate (if (< next-timer 0.0f) 0.03f 0.09f)]
                                                        (do
                                                          (when (/= next-state 3) (set! next-state 0))
                                                          (Array.aset! a-pod b3 (Double.to-float @(Vector3.x &pod-v)))
                                                          (Array.aset! a-pod (+ b3 1) (Double.to-float @(Vector3.y &pod-v)))
                                                          (Array.aset! a-pod (+ b3 2) (Double.to-float @(Vector3.z &pod-v)))
                                                          (when sip-ok?
                                                            (if (<= (Float.round next-mat) 0)
                                                              (do
                                                                (set! next-mat raw-sip)
                                                                (set! next-fill (Float.clamp 0.14f 1.0f (+ next-fill (* sip-rate fdt)))))
                                                              (set! next-fill (Float.clamp 0.0f 1.0f (+ next-fill (* sip-rate fdt)))))))))))))))

                                        ;; Tick post-mitosis youth/digestion cooldown toward 0.0
                                        (when (and (< next-timer 0.0f)
                                                   (and (/= next-state 2) (/= next-state 3)))
                                          (set! next-timer (if (< (+ next-timer fdt) 0.0f) (+ next-timer fdt) 0.0f)))

                                        ;; Trigger Mitosis Wobble once locked, full chonk, mature, and below colony cap!
                                        (when (and (> (Float.round next-mat) 0)
                                                   (and (>= next-fill 0.995f)
                                                        (and (>= next-timer 0.0f)
                                                             (and (< @(CritterBank.count cbank) 12)
                                                                  (and (/= next-state 2) (/= next-state 3))))))
                                          (do
                                            (set! next-state 2)
                                            (set! next-timer 0.0f)))

                                        ;; Commit updated physics, radius, visual color & quirk state back to ECS + arrays
                                        (let [new-rad-f (CritterSystem.amoeba-radius next-mat next-fill)
                                              new-rad-d (Double.from-float new-rad-f)
                                              new-restit (if (Materials.bouncy? next-mat) 0.92 0.08)
                                              new-col (Materials.slime-color next-mat next-state)]
                                          (do
                                            (Body.set-restitution! b new-restit)
                                            (RigidBody.set-body! rb @b)
                                            (ECS.add-component! ecs &ent (CompBody.init @rb))
                                            (ECS.add-component! ecs &ent (CompVolume.init (Volume.Ball (Sphere.init @(RigidBody.position rb) new-rad-d))))
                                            (ECS.add-component! ecs &ent (CompColor.init new-col))
                                            (Array.aset! a-mat k next-mat)
                                            (Array.aset! a-fill k next-fill)
                                            (Array.aset! a-rad k new-rad-f)
                                            (Array.aset! a-state k next-state)
                                            (Array.aset! a-timer k next-timer)
                                            (Array.aset! a-phase k next-phase))))))))))))))))))

        (CritterBank.set-count! cbank active-count)

        ;; Natural cave ecology spawner: keep ~6 wild Slimes inhabiting nearby caverns!
        (when (and (< active-count 6)
                   (and (= (Int.mod fc 18) 0)
                        (> (- fc @(CritterBank.last-spawn-frame cbank)) 24)))
          (CritterSystem.try-natural-cave-spawn! state world cam-pos fc)))))
)

;; =============================================================================
;; wands/core.carp — Types, Rune Predicates, FX1..FX4 Bitpacks, Envelopes & Payloads
;;   Spell Runes (1..8):      1=Sparkbolt, 2=Bullet, 3=Minimortar, 4=Lumi-Drill,
;;                            5=Buckshot, 6=Spitter, 7=Caltrop, 8=Chakram
;;   Linker Runes (21..29):   21=Impact, 22=Timer, 23=2x Twin, 24=Expire,
;;                            25=Echo Burst, 26=Bounce, 27=x2, 28=x3, 29=x4
;;   Modifier Runes (31..60): Ricochet..Sticky (31..48), Fission/Fusion (49..50),
;;                            Shrink/Embiggen (51..52), Magnet/Repulse (53..54),
;;                            Long Shot/Point-Blank (55..56), Empower (57),
;;                            Double-Dmg/Zero-Dmg (58..59), Suppressor (60)
;;   Power Spells (101..108): Rail-Lance, Nova, Bolt Gyre, Maelstrom,
;;                            Starburst, Phase-Wave, Ophanim, Supernova
;; =============================================================================

(deftype WandChassis [
  cast-delay Float
  mana-max Float
  mana-regen Float
  mana-cost Float
  multicast Int
  spread Float
  extra-bounces Int
  lantern-mat Float
])

(deftype SpellPayload [
  speed Float
  gravity Float
  radius Float
  lifetime Float
  base-bounces Int
  col-r Float
  col-g Float
  col-b Float
  sdf-delta Float
  solid-mat Float
  spawn-mat Float
  spawn-rad Float
  knockback Float
  elem-tag Int
])

(deftype WandMod [
  mod-kind Int
  trail-mat Float
  trail-ptype Float
  homing-turn Float
  split-on-hit Bool
])

(defmodule WandSystem
  (defn fsin [x] (Double.to-float (sin (Double.from-float x))))
  (defn fcos [x] (Double.to-float (cos (Double.from-float x))))

  (defn hash-signed [seed]
    (let [k (Int.mod (Int.abs seed) 32749)
          h (Int.mod (+ (* k 25173) 13849) 2000)]
      (- (* (Float.from-int h) 0.001f) 1.0f)))

  (defn clamp-int [lo hi v]
    (if (< v lo) lo (if (> v hi) hi v)))

  (defn bit-shl [n]
    (if (<= n 0) 1
    (if (= n 1) 2
    (if (= n 2) 4
    (if (= n 3) 8
    (if (= n 4) 16 32))))))

  (defn bit-set? [mask idx]
    (> (Int.mod (/ mask (WandSystem.bit-shl idx)) 2) 0))

  (defn spell-rune? [r]     (and (>= r 1) (<= r 8)))
  (defn linker-rune? [r]    (and (>= r 21) (<= r 29)))
  (defn infix-linker? [r]   (or (= r 21) (or (= r 22) (or (= r 24) (= r 26)))))
  (defn modifier-rune? [r]  (and (>= r 31) (<= r 60)))
  (defn power-core? [r]     (and (>= r 101) (<= r 108)))
  (defn any-spell-rune? [r] (or (WandSystem.spell-rune? r) (WandSystem.power-core? r)))
  (defn power-bolt-style? [st] (or (= st 6) (and (>= st 9) (<= st 11))))

  ;; 26-bit FX Modifier Pack (`0..3` stacks each for `36=Trail`..`48=Sticky` -> `0..67108863`)
  (defn pack-fx-mods [trl hvr bmg blk glt exp inv imp pls srg hlx sin-m stk]
    (+ (WandSystem.clamp-int 0 3 trl)
       (+ (* (WandSystem.clamp-int 0 3 hvr) 4)
          (+ (* (WandSystem.clamp-int 0 3 bmg) 16)
             (+ (* (WandSystem.clamp-int 0 3 blk) 64)
                (+ (* (WandSystem.clamp-int 0 3 glt) 256)
                   (+ (* (WandSystem.clamp-int 0 3 exp) 1024)
                      (+ (* (WandSystem.clamp-int 0 3 inv) 4096)
                         (+ (* (WandSystem.clamp-int 0 3 imp) 16384)
                            (+ (* (WandSystem.clamp-int 0 3 pls) 65536)
                               (+ (* (WandSystem.clamp-int 0 3 srg) 262144)
                                  (+ (* (WandSystem.clamp-int 0 3 hlx) 1048576)
                                     (+ (* (WandSystem.clamp-int 0 3 sin-m) 4194304)
                                        (* (WandSystem.clamp-int 0 3 stk) 16777216))))))))))))))

  (defn fx-trl [fxp] (Int.mod fxp 4))
  (defn fx-hvr [fxp] (Int.mod (/ fxp 4) 4))
  (defn fx-bmg [fxp] (Int.mod (/ fxp 16) 4))
  (defn fx-blk [fxp] (Int.mod (/ fxp 64) 4))
  (defn fx-glt [fxp] (Int.mod (/ fxp 256) 4))
  (defn fx-exp [fxp] (Int.mod (/ fxp 1024) 4))
  (defn fx-inv [fxp] (Int.mod (/ fxp 4096) 4))
  (defn fx-imp [fxp] (Int.mod (/ fxp 16384) 4))
  (defn fx-pls [fxp] (Int.mod (/ fxp 65536) 4))
  (defn fx-srg [fxp] (Int.mod (/ fxp 262144) 4))
  (defn fx-hlx [fxp] (Int.mod (/ fxp 1048576) 4))
  (defn fx-sin [fxp] (Int.mod (/ fxp 4194304) 4))
  (defn fx-stk [fxp] (Int.mod (/ fxp 16777216) 4))

  ;; 27-bit Nuclear, Pym-Scale & Volley Modifier Pack (`bolt-fx2` / `bolt-trig-fx2` for `49=Fission`, `50=Fusion`, `51=Shrink`, `52=Embiggen`, & `27..29=×2..×4`):
  ;;   - Raw strip pack (`0..255`, `< 67108864`): `fis (0..3) + fus (0..3) * 4 + shr (0..3) * 16 + emb (0..3) * 64`
  ;;   - Trigger `tfx2` pack:                     `fx2-raw (0..255) + (mul1 - 1) * 256 + (mul2 - 1) * 4096`
  ;;   - Live bolt pack (`>= 67108864`):
  ;;       `fis (0..3) * 1 + fus (0..3) * 4 + emp (0..7) * 16 + merges (0..15) * 128 + next-tick (0..1023) * 2048 + szm (0..7) * 2097152 + szs (0..3) * 16777216 + 67108864`
  ;;       where `szm`: `0 = None`, `1 = 🔬 Shrink`, `2 = 🦖 Embiggen`, `3 = 🦟 Flechette Gatling (Embiggen+Invert)`,
  ;;                    `4 = 🪐 Katamari Snowball (Shrink+Invert)`, `5 = 💥 Pym Jackhammer (Shrink+Embiggen)`,
  ;;                    `6 = ☄️ Extinction Meteor (Shrink+Embiggen+(Invert/Empower))`!
  (defn pack-fx2-all [fis fus shr emb]
    (+ (WandSystem.clamp-int 0 3 fis)
       (+ (* (WandSystem.clamp-int 0 3 fus) 4)
          (+ (* (WandSystem.clamp-int 0 3 shr) 16)
             (* (WandSystem.clamp-int 0 3 emb) 64)))))

  (defn pack-fx2-mods [fis fus]
    (WandSystem.pack-fx2-all fis fus 0 0))

  (defn raw-fx2-shr [p] (Int.mod (/ p 16) 4))
  (defn raw-fx2-emb [p] (Int.mod (/ p 64) 4))

  (defn pack-trig-fx2-all [fx2-raw mul1 mul2]
    (+ (WandSystem.clamp-int 0 255 fx2-raw)
       (+ (* (WandSystem.clamp-int 0 15 (- mul1 1)) 256)
          (* (WandSystem.clamp-int 0 3 (- mul2 1)) 4096))))

  (defn pack-trig-fx2 [fis1 fus1 mul1 mul2]
    (WandSystem.pack-trig-fx2-all (WandSystem.pack-fx2-mods fis1 fus1) mul1 mul2))

  (defn tfx2-fx2 [t]  (Int.mod t 256))
  (defn tfx2-mul1 [t] (+ 1 (Int.mod (/ t 256) 16)))
  (defn tfx2-mul2 [t] (+ 1 (Int.mod (/ t 4096) 4)))

  (defn pack-live-fx2-full [fis fus emp merges next-tick szm szs]
    (+ 67108864
       (+ (WandSystem.clamp-int 0 3 fis)
          (+ (* (WandSystem.clamp-int 0 3 fus) 4)
             (+ (* (WandSystem.clamp-int 0 7 emp) 16)
                (+ (* (WandSystem.clamp-int 0 15 merges) 128)
                   (+ (* (WandSystem.clamp-int 0 1023 next-tick) 2048)
                      (+ (* (WandSystem.clamp-int 0 7 szm) 2097152)
                         (* (WandSystem.clamp-int 0 3 szs) 16777216)))))))))

  (defn pack-live-fx2 [fis fus emp merges next-tick]
    (WandSystem.pack-live-fx2-full fis fus emp merges next-tick 0 0))

  (defn fx2-fis [p]  (Int.mod p 4))
  (defn fx2-fus [p]  (Int.mod (/ p 4) 4))
  (defn fx2-emp [p]  (Int.mod (/ p 16) 8))
  (defn fx2-mrg [p]  (Int.mod (/ p 128) 16))
  (defn fx2-tick [p] (Int.mod (/ p 2048) 1024))
  (defn fx2-szm [p]  (Int.mod (/ p 2097152) 8))
  (defn fx2-szs [p]  (Int.mod (/ p 16777216) 4))

  (defn resolve-spawn-fx2-ex [fx2-pack inv-c ovc-c style]
    (if (or (<= fx2-pack 0) (= style 4))
      0
      (if (>= fx2-pack 67108864)
        fx2-pack
        (let [raw-fis (WandSystem.fx2-fis fx2-pack)
              raw-fus (WandSystem.fx2-fus fx2-pack)
              raw-shr (WandSystem.raw-fx2-shr fx2-pack)
              raw-emb (WandSystem.raw-fx2-emb fx2-pack)
              exodia? (or (> inv-c 0) (> ovc-c 0))
              szm (if (and (> raw-shr 0) (> raw-emb 0))
                    (if exodia? 6 5)
                    (if (> raw-emb 0)
                      (if (> inv-c 0) 3 2)
                      (if (> raw-shr 0)
                        (if (> inv-c 0) 4 1)
                        0)))
              szs (if (= szm 6)
                    (WandSystem.clamp-int 1 3 raw-shr)
                    (if (> szm 0)
                      (WandSystem.clamp-int 1 3 (if (> raw-emb raw-shr) raw-emb raw-shr))
                      0))
              pcore-st? (WandSystem.power-bolt-style? style)]
          (if (and (<= raw-fis 0) (and (<= raw-fus 0) (<= szm 0)))
            0
            (if (and (<= raw-fis 0) (<= raw-fus 0))
              (WandSystem.pack-live-fx2-full 0 0 0 0 0 szm szs)
              (if (and (> raw-fis 0) (> raw-fus 0))
                (if exodia?
                  ;; ☢️🕳️ DEMON CORE / KILONOVA (`[🫧 Fission] + [☀️ Fusion] + [🔄 Invert / 👑 Empower]`): `1 -> 3 -> 1` Void-Carving Cascade!
                  (WandSystem.pack-live-fx2-full 1 (WandSystem.clamp-int 1 3 (+ raw-fis raw-fus)) 4 0 (if pcore-st? 24 8) szm szs)
                  ;; ⚛️ Breeder Reactor (`[🫧 Fission] + [☀️ Fusion]`): oscillating split-and-pinch plasma braid!
                  (WandSystem.pack-live-fx2-full 1 (WandSystem.clamp-int 1 3 (+ raw-fis (- raw-fus 1))) 3 0 (if pcore-st? 36 10) szm szs))
                (if (and (> raw-fus 0) (> inv-c 0))
                  ;; ☢️ Supercritical 3-Way Fission (`[☀️ Fusion] + [🔄 Invert]`): `1 -> 3` high-speed trifurcation + Cherenkov blast!
                  (let [eff-fis (if pcore-st? 1 (WandSystem.clamp-int 1 2 raw-fus))
                        t0 (if (= style 13) 40 (if pcore-st? 48 12))]
                    (WandSystem.pack-live-fx2-full eff-fis 0 1 0 t0 szm szs))
                  (if (and (> raw-fis 0) (> inv-c 0))
                    ;; 🌟 Thermonuclear Pinch-Fusion (`[🫧 Fission] + [🔄 Invert]`): wide-radius magnetic snap + shockwave ignition!
                    (WandSystem.pack-live-fx2-full 0 raw-fis 2 0 5 szm szs)
                    (if (> raw-fis 0)
                      ;; 🫧 Clean Mitotic Fission (`1 -> 2 -> 4 -> 8`)
                      (let [eff-fis (if pcore-st? 1 raw-fis)
                            t0 (if (= style 13) 45 (if pcore-st? 50 13))]
                        (WandSystem.pack-live-fx2-full eff-fis 0 0 0 t0 szm szs))
                      ;; ☀️ Clean Magnetic Fusion
                      (WandSystem.pack-live-fx2-full 0 raw-fus 0 0 7 szm szs)))))))))))

  (defn resolve-spawn-fx2 [fx2-pack inv-c style]
    (WandSystem.resolve-spawn-fx2-ex fx2-pack inv-c 0 style))

  ;; Electromagnetic, Kinetic-Sabot & 6-State Range Pack (`bolt-fx3` / `bolt-trig-fx3` for `53=Magnet`, `54=Repulse`, `55=Long Shot`, `56=Point-Blank`, & `🏔️ Massive`):
  ;;   - Raw strip pack (`0..1023`, `< 67108864`): `mag (0..3) + rep (0..3)*4 + mas (0..3)*16 + lng (0..3)*64 + pbk (0..3)*256`
  ;;   - Trigger `tfx3` pack:                      `fx3-raw (0..1023) + md2-fx3 (0..4) * 1024`
  ;;   - Live bolt pack (`>= 67108864`):           `67108864 + mgm (0..7) + mgs (0..3)*8 + mas (0..3)*32 + lsm (0..7)*128 + lss (0..3)*1024 + dist-dm (0..4095)*4096`
  ;;     where `lsm`: `0=None`, `1=🔭 Long Shot`, `2=💢 Point-Blank`, `3=🚀 Gyrojet Torpedo (PBK+Inv)`,
  ;;                  `4=🪝 Scorpion Harpoon (LNG+Inv)`, `5=⚖️ Buck & Ball (LNG+PBK)`, `6=⚡ PARADOX RAIL-CANNON (LNG+PBK+(Inv/Emp))`!
  (defn pack-fx3-all [mag rep mas lng pbk]
    (+ (WandSystem.clamp-int 0 3 mag)
       (+ (* (WandSystem.clamp-int 0 3 rep) 4)
          (+ (* (WandSystem.clamp-int 0 3 mas) 16)
             (+ (* (WandSystem.clamp-int 0 3 lng) 64)
                (* (WandSystem.clamp-int 0 3 pbk) 256))))))

  (defn raw-fx3-mag [p] (Int.mod p 4))
  (defn raw-fx3-rep [p] (Int.mod (/ p 4) 4))
  (defn raw-fx3-mas [p] (Int.mod (/ p 16) 4))
  (defn raw-fx3-lng [p] (Int.mod (/ p 64) 4))
  (defn raw-fx3-pbk [p] (Int.mod (/ p 256) 4))

  (defn pack-trig-fx3 [fx3-raw md2]
    (+ (WandSystem.clamp-int 0 1023 fx3-raw)
       (* (if (= md2 23) 1 (if (= md2 24) 2 (if (= md2 25) 3 (if (= md2 26) 4 0)))) 1024)))

  (defn tfx3-fx3 [t] (Int.mod t 1024))

  (defn pack-live-fx3-full [mgm mgs mas lsm lss dist-dm]
    (+ 67108864
       (+ (WandSystem.clamp-int 0 7 mgm)
          (+ (* (WandSystem.clamp-int 0 3 mgs) 8)
             (+ (* (WandSystem.clamp-int 0 3 mas) 32)
                (+ (* (WandSystem.clamp-int 0 7 lsm) 128)
                   (+ (* (WandSystem.clamp-int 0 3 lss) 1024)
                      (* (WandSystem.clamp-int 0 4095 dist-dm) 4096))))))))

  (defn pack-live-fx3 [mgm mgs mas]
    (WandSystem.pack-live-fx3-full mgm mgs mas 0 0 0))

  (defn fx3-mgm [p]     (if (< p 67108864) 0 (Int.mod (- p 67108864) 8)))
  (defn fx3-mgs [p]     (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 8) 4)))
  (defn fx3-mas [p]     (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 32) 4)))
  (defn fx3-lsm [p]     (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 128) 8)))
  (defn fx3-lss [p]     (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 1024) 4)))
  (defn fx3-dist-dm [p] (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 4096) 4096)))

  (defn resolve-spawn-fx3-ex [fx3-pack inv-c ovc-c style]
    (if (or (<= fx3-pack 0) (= style 4))
      0
      (if (>= fx3-pack 67108864)
        fx3-pack
        (let [raw-mag (WandSystem.raw-fx3-mag fx3-pack)
              raw-rep (WandSystem.raw-fx3-rep fx3-pack)
              raw-mas (WandSystem.raw-fx3-mas fx3-pack)
              raw-lng (WandSystem.raw-fx3-lng fx3-pack)
              raw-pbk (WandSystem.raw-fx3-pbk fx3-pack)
              exodia? (or (> inv-c 0) (> ovc-c 0))
              mgm (if (and (> raw-mag 0) (> raw-rep 0))
                    (if exodia? 6 5)
                    (if (> raw-rep 0)
                      (if (> inv-c 0) 3 2)
                      (if (> raw-mag 0)
                        (if (> inv-c 0) 4 1)
                        0)))
              mgs (if (> mgm 0)
                    (WandSystem.clamp-int 1 3 (if (> raw-mag raw-rep) raw-mag raw-rep))
                    0)
              lsm (if (and (> raw-lng 0) (> raw-pbk 0))
                    (if exodia? 6 5)
                    (if (> raw-pbk 0)
                      (if (> inv-c 0) 3 2)
                      (if (> raw-lng 0)
                        (if (> inv-c 0) 4 1)
                        0)))
              lss (if (> lsm 0)
                    (WandSystem.clamp-int 1 3 (if (> raw-pbk raw-lng) raw-pbk raw-lng))
                    0)]
          (if (and (<= mgm 0) (and (<= raw-mas 0) (<= lsm 0)))
            0
            (WandSystem.pack-live-fx3-full mgm mgs raw-mas lsm lss 0))))))

  (defn resolve-spawn-fx3 [fx3-pack inv-c style]
    (WandSystem.resolve-spawn-fx3-ex fx3-pack inv-c 0 style))

  ;; 6-State Cumulative 3D Path-Distance Damage Curve (`lsm = 1..6`, `dist-m` in meters):
  (defn longshot-dmg-mul [lsm lss dist-m]
    (if (<= lsm 0)
      1.0f
      (let [st (Float.from-int (WandSystem.clamp-int 1 3 lss))]
        (if (= lsm 6)
          ;; `⚡ PARADOX RAIL-CANNON` (`[Long Shot + Point-Blank + (Invert/Empower)]`): `0m == ∞m` (`5.50x / 7.25x / 9.00x` at ALL ranges!)
          (+ 3.75f (* 1.75f st))
          (if (= lsm 1)
            ;; `🔭 Long Shot` Solo: `0.42x` at `0m`, `~1.0x` at `9.5m`, ramping up to `3.40x / 4.75x / 6.10x` at `32m+`!
            (let [t (Float.clamp 0.0f 1.0f (/ dist-m 32.0f))]
              (+ 0.42f (* (+ 1.63f (* 1.35f st)) (* t (+ 0.45f (* 0.55f t))))))
            (if (or (= lsm 2) (= lsm 4))
              ;; `💢 Point-Blank` / `🪝 Scorpion Harpoon`: `3.65x / 4.95x / 6.25x` inside `3.6m`, steep falloff to `0.24x` by `11.5m`!
              (let [peak (+ 2.35f (* 1.30f st))]
                (if (<= dist-m 3.6f)
                  peak
                  (let [u (Float.clamp 0.0f 1.0f (/ (- dist-m 3.6f) 7.9f))]
                    (- peak (* (- peak 0.24f) (* u (- 1.45f (* 0.45f u))))))))
              (if (= lsm 3)
                ;; `🚀 Gyrojet Torpedo` (`[Point-Blank + Invert]`): `0.28x` safety fuse `< 6m`, ignites `3.85x..7.20x` warhead at `>= 6m`!
                (if (< dist-m 6.0f)
                  0.28f
                  (+ (+ 2.50f (* 1.35f st)) (* 0.65f (Float.clamp 0.0f 1.0f (/ (- dist-m 6.0f) 16.0f)))))
                ;; `⚖️ Buck & Ball` (`[Long Shot + Point-Blank]`): U-shaped Barbell (`3.55x+` `< 3.8m` AND `3.85x+` `> 22m`)!
                (let [p-near (+ 2.25f (* 1.30f st))
                      un (Float.clamp 0.0f 1.0f (/ (- dist-m 3.8f) 4.8f))
                      near-m (- p-near (* (- p-near 0.78f) un))
                      uf (Float.clamp 0.0f 1.0f (/ (- dist-m 11.5f) 16.5f))
                      far-m (+ 0.78f (* (- (+ 2.50f (* 1.35f st)) 0.78f) uf))]
                  (if (> near-m far-m) near-m far-m)))))))))

  ;; Overdrive Keystone, 6-State Damage Polarity, & Subsonic Stealth Pack (`bolt-fx4` / `bolt-trig-fx4` for `57=Empower`, `58=Double-Dmg`, `59=Zero-Dmg`, `60=Suppressor`):
  ;;   - Raw strip pack (`0..4095`, `< 67108864`): `ovc (0..3) + ddm (0..3)*4 + zdm (0..3)*16 + sil (0..3)*64 + sp-id (0..15)*256`
  ;;   - Trigger `tfx4` pack:                      `fx4-raw (0..4095) + md2-fx4 (0..4)*4096`
  ;;   - Live bolt pack (`>= 67108864`):           `67108864 + ovm (0..3) + ovs (0..3)*4 + dgm (0..7)*16 + dgs (0..3)*128 + slm (0..7)*512 + sls (0..3)*4096 + awk (0..15)*16384`
  ;;     where `dgm`: `0=None`, `1=💀 Double-Dmg`, `2=🫧 Zero-Dmg`, `3=💉 Mercy Siphon (ZDM+Inv)`, `4=🩸 Berserker (DDM+Inv)`,
  ;;                  `5=🎰 Jackpot Crit (DDM+ZDM Win)`, `6=☢️ NUCLEAR GANDHI (DDM+ZDM+(Inv/Emp))`, `7=🫧 Gamble Blank (DDM+ZDM Miss)`
  ;;     and   `slm`: `0=None`, `1=🔇 Suppressor`, `2=📢 THE LOUDENER (SIL+Inv)`, `3=👻 Ghost-Phase Assassin (SIL+Emp)`!
  (defn pack-fx4-all [ovc ddm zdm sil sp-id]
    (+ (WandSystem.clamp-int 0 3 ovc)
       (+ (* (WandSystem.clamp-int 0 3 ddm) 4)
          (+ (* (WandSystem.clamp-int 0 3 zdm) 16)
             (+ (* (WandSystem.clamp-int 0 3 sil) 64)
                (* (WandSystem.clamp-int 0 15 sp-id) 256))))))

  (defn raw-fx4-ovc [p] (Int.mod p 4))
  (defn raw-fx4-ddm [p] (Int.mod (/ p 4) 4))
  (defn raw-fx4-zdm [p] (Int.mod (/ p 16) 4))
  (defn raw-fx4-sil [p] (Int.mod (/ p 64) 4))
  (defn raw-fx4-sp  [p] (Int.mod (/ p 256) 16))

  (defn pack-trig-fx4 [fx4-raw md2]
    (+ (WandSystem.clamp-int 0 4095 fx4-raw)
       (* (if (= md2 27) 1 (if (= md2 28) 2 (if (= md2 29) 3 (if (= md2 30) 4 0)))) 4096)))

  (defn tfx4-fx4 [t] (Int.mod t 4096))

  (defn pack-live-fx4-full [ovm ovs dgm dgs slm sls awk]
    (+ 67108864
       (+ (WandSystem.clamp-int 0 3 ovm)
          (+ (* (WandSystem.clamp-int 0 3 ovs) 4)
             (+ (* (WandSystem.clamp-int 0 7 dgm) 16)
                (+ (* (WandSystem.clamp-int 0 3 dgs) 128)
                   (+ (* (WandSystem.clamp-int 0 7 slm) 512)
                      (+ (* (WandSystem.clamp-int 0 3 sls) 4096)
                         (* (WandSystem.clamp-int 0 15 awk) 16384)))))))))

  (defn fx4-ovm [p] (if (< p 67108864) 0 (Int.mod (- p 67108864) 4)))
  (defn fx4-ovs [p] (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 4) 4)))
  (defn fx4-dgm [p] (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 16) 8)))
  (defn fx4-dgs [p] (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 128) 4)))
  (defn fx4-slm [p] (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 512) 8)))
  (defn fx4-sls [p] (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 4096) 4)))
  (defn fx4-awk [p] (if (< p 67108864) 0 (Int.mod (/ (- p 67108864) 16384) 16)))

  (defn resolve-spawn-fx4 [fx4-pack inv-c style seed]
    (if (<= fx4-pack 0)
      0
      (if (>= fx4-pack 67108864)
        fx4-pack
        (let [raw-ovc (WandSystem.raw-fx4-ovc fx4-pack)
              raw-ddm (WandSystem.raw-fx4-ddm fx4-pack)
              raw-zdm (WandSystem.raw-fx4-zdm fx4-pack)
              raw-sil (WandSystem.raw-fx4-sil fx4-pack)
              raw-sp  (WandSystem.raw-fx4-sp fx4-pack)
              ovm (if (> raw-ovc 0) 1 0)
              ovs (WandSystem.clamp-int 0 3 raw-ovc)
              exodia? (or (> inv-c 0) (> raw-ovc 0))
              dgm (if (and (> raw-ddm 0) (> raw-zdm 0))
                    (if exodia?
                      6
                      (if (= (Int.mod (Int.abs seed) 2) 1) 5 7))
                    (if (> raw-ddm 0)
                      (if (> inv-c 0) 4 1)
                      (if (> raw-zdm 0)
                        (if (> inv-c 0) 3 2)
                        0)))
              dgs (if (> dgm 0)
                    (WandSystem.clamp-int 1 3 (if (> raw-ddm raw-zdm) raw-ddm raw-zdm))
                    0)
              slm (if (> raw-sil 0)
                    (if (> inv-c 0) 2 (if (> raw-ovc 0) 3 1))
                    0)
              sls (if (> slm 0) (WandSystem.clamp-int 1 3 raw-sil) 0)
              awk (if (and (> raw-ovc 0) (and (>= raw-sp 1) (<= raw-sp 8))) raw-sp 0)]
          (if (and (<= ovm 0) (and (<= dgm 0) (and (<= slm 0) (<= awk 0))))
            0
            (WandSystem.pack-live-fx4-full ovm ovs dgm dgs slm sls awk))))))

  (defn fx4-dmg-mul [ovm ovs dgm dgs slm]
    (let [ov-m (if (> ovm 0) (+ 1.05f (* 0.30f (Float.from-int (WandSystem.clamp-int 1 3 ovs)))) 1.0f)
          st (Float.from-int (WandSystem.clamp-int 1 3 dgs))
          dg-m (if (= dgm 1)
                 (+ 0.50f (* 1.50f st))
                 (if (= dgm 4)
                   (+ 1.00f (* 1.65f st))
                   (if (= dgm 5)
                     (+ 2.50f (* 2.00f st))
                     (if (= dgm 6)
                       (+ 6.50f (* 2.00f st))
                       1.0f))))
          sl-m (if (= slm 2) 1.35f 1.0f)]
      (* (* ov-m dg-m) sl-m)))

  ;; `🍯 Sticky` (`48`) <-> `🪃 Ricochet` (`31`) + `🔄 Invert` (`42`) Restitution Polarity Swap:
  ;;   - `Ricochet + Invert` (`stk == 0, ric > 0`): flips bounce into Sticky glue (`0` bounces, `fx-stk = 1..2`)!
  ;;   - `Sticky + Invert` (`stk > 0`): flips glue into `1.24x` Flubber (`stk * 4` bounces + `ric`, `fx-stk = 3`)!
  (defn eff-ric-bounces [ric stk inv]
    (if (<= inv 0)
      ric
      (if (> stk 0)
        (+ (* (WandSystem.clamp-int 1 3 stk) 4) ric)
        0)))

  (defn encode-stk-fx [ric stk inv]
    (if (<= inv 0)
      (WandSystem.clamp-int 0 3 stk)
      (if (> stk 0)
        3
        (if (> ric 0)
          (WandSystem.clamp-int 1 2 (/ (+ ric 2) 3))
          0))))

  (defn inv-scale [inv]
    (if (<= inv 0) 1.0f (+ 1.0f (* 0.50f (Float.from-int (- (WandSystem.clamp-int 1 3 inv) 1))))))

  (defn imp-scale [imp]
    (if (<= imp 0) 0.0f (+ 1.0f (* 0.62f (Float.from-int (- (WandSystem.clamp-int 1 3 imp) 1))))))

  ;; Compute orthonormal tangent basis `(rtx, rty, rtz)` & `(upx, upy, upz)` from any 3D direction `(fx, fy, fz)`
  (defn ortho-right [fx fy fz]
    (let [fvec (Vector3.init (Double.from-float fx) (Double.from-float fy) (Double.from-float fz))
          up-r (if (< (Float.abs fy) 0.88f) (Vector3.init 0.0 1.0 0.0) (Vector3.init 1.0 0.0 0.0))
          rv (Vector3.cross &fvec &up-r)
          rm (Vector3.mag &rv)]
      (if (> rm 0.001)
        (Vector3.mul &rv (/ 1.0 rm))
        (Vector3.init 1.0 0.0 0.0))))

  ;; `🌀 Helix` (`46`) & `🐍 Sine` (`47`): Zero-drift crosshair-centered transverse velocity `(lvx, lvy, lvz)`!
  ;;   - `Helix` (`46`): 3D cylindrical corkscrew (`0 -> 0.065s` muzzle bloom keeps cylinder centered dead-on crosshair;
  ;;     `2x`/`Echo` counter-phases into a DNA double-helix; `Invert` flips chirality!).
  ;;   - `Sine` (`47`): Horizontal sidewinder wave (`inv == 0`) or vertical sea-serpent wave (`inv > 0`);
  ;;     `2x`/`Echo` braids a symmetric figure-8 weave!
  (defn path-lat-vel [cvx cvy cvz t hlx sin-m inv odd-slot]
    (if (and (<= hlx 0) (<= sin-m 0))
      (Vector3.init 0.0 0.0 0.0)
      (let [cspd (Float.sqrt (+ (+ (* cvx cvx) (* cvy cvy)) (* cvz cvz)))]
        (if (< cspd 0.25f)
          (Vector3.init 0.0 0.0 0.0)
          (let [inv-c (/ 1.0f cspd)
                fx (* cvx inv-c)
                fy (* cvy inv-c)
                fz (* cvz inv-c)
                rv (WandSystem.ortho-right fx fy fz)
                rtx (Double.to-float @(Vector3.x &rv))
                rty (Double.to-float @(Vector3.y &rv))
                rtz (Double.to-float @(Vector3.z &rv))
                fvec (Vector3.init (Double.from-float fx) (Double.from-float fy) (Double.from-float fz))
                uv (Vector3.cross &rv &fvec)
                upx (Double.to-float @(Vector3.x &uv))
                upy (Double.to-float @(Vector3.y &uv))
                upz (Double.to-float @(Vector3.z &uv))
                phi0 (if (= odd-slot 1) 3.1415927f 0.0f)
                spd-fac (Float.clamp 0.25f 1.55f (/ cspd 36.0f))
                ;; `🌀 Helix`: derivative of `a(t) * R * (cos(om*t + phi0), sin(om*t + phi0))`
                sh (WandSystem.clamp-int 1 3 hlx)
                rad-h (if (> hlx 0) (* (+ 0.48f (* 0.24f (Float.from-int (- sh 1)))) spd-fac) 0.0f)
                om-h (* (+ 26.0f (* 4.5f (Float.from-int (- sh 1)))) (if (> inv 0) -1.0f 1.0f))
                th-h (+ (* t om-h) phi0)
                ch (WandSystem.fcos th-h)
                snh (WandSystem.fsin th-h)
                a-h (Float.clamp 0.0f 1.0f (* t 15.384615f))
                da-h (if (< t 0.065f) 15.384615f 0.0f)
                vr-h (* rad-h (- (* da-h ch) (* (* a-h om-h) snh)))
                vu-h (* rad-h (+ (* da-h snh) (* (* a-h om-h) ch)))
                ;; `🐍 Sine`: derivative of `A * sin(om_s*t + phi0)` (`inv == 0` horizontal, `inv > 0` vertical!)
                ss (WandSystem.clamp-int 1 3 sin-m)
                amp-s (if (> sin-m 0) (* (+ 0.76f (* 0.38f (Float.from-int (- ss 1)))) spd-fac) 0.0f)
                om-s (+ 23.5f (* 4.0f (Float.from-int (- ss 1))))
                vs (* (* amp-s om-s) (WandSystem.fcos (+ (* t om-s) phi0)))
                vr (+ vr-h (if (= inv 0) vs 0.0f))
                vu (+ vu-h (if (> inv 0) vs 0.0f))]
            (Vector3.init
              (Double.from-float (+ (* rtx vr) (* upx vu)))
              (Double.from-float (+ (* rty vr) (* upy vu)))
              (Double.from-float (+ (* rtz vr) (* upz vu)))))))))

  ;; `💓 Pulse` (`44`): Smooth size oscillation (`0.37x <-> 2.10x+` around `base-rad`; `Invert` flips muzzle swell & anti-phases swarms!)
  (defn pulse-envelope [t pls inv slot]
    (if (<= pls 0)
      1.0f
      (let [st (WandSystem.clamp-int 1 3 pls)
            omega (+ 10.5f (* 2.4f (Float.from-int (- st 1))))
            phi0 (if (> inv 0)
                   (if (= (Int.mod slot 2) 0) 1.5707963f -1.5707963f)
                   -0.35f)
            u (* 0.5f (+ 1.0f (WandSystem.fsin (+ (* t omega) phi0))))
            us (* u (+ 0.35f (* 0.65f u)))
            rmin (Float.clamp 0.20f 0.42f (- 0.44f (* 0.07f (Float.from-int st))))
            rmax (+ 1.68f (* 0.42f (Float.from-int st)))]
        (+ rmin (* (- rmax rmin) us)))))

  ;; `💨 Surge` (`45`): Coil-and-whiplash speed oscillation (`0.21x <-> 2.42x+`, mean ~`1.04x`; strictly >= `0.14f`!)
  (defn surge-envelope [t srg inv slot]
    (if (<= srg 0)
      1.0f
      (let [st (WandSystem.clamp-int 1 3 srg)
            omega (+ 11.5f (* 2.6f (Float.from-int (- st 1))))
            phi0 (if (> inv 0)
                   (if (= (Int.mod slot 2) 0) 1.5707963f -1.5707963f)
                   -1.5707963f)
            u (* 0.5f (+ 1.0f (WandSystem.fsin (+ (* t omega) phi0))))
            lunge (* u u)
            smin (Float.clamp 0.14f 0.24f (- 0.24f (* 0.03f (Float.from-int st))))
            smax (+ 1.98f (* 0.44f (Float.from-int st)))]
        (+ smin (* (- smax smin) lunge)))))


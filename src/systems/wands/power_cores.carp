;; =============================================================================
;; wands/power_cores.carp — Power-Core In-Flight & Climax Engines (103..108)
;;   - `boulder-entity?`, `ophanim-shred-burst!`, `step-ophanim-cuisinart!`
;;   - `step-supernova-well!`, `unleash-supernova!`, `unleash-starburst!`
;;   - `step-bolt-gyre!`, `step-bolt-maelstrom!`, `step-starburst-succ!`
;;   - `step-bolt-phase-wave!`, `step-bolt-ophanim!`, `step-bolt-supernova!`
;; =============================================================================

(defmodule WandSystem

  ;; ===========================================================================
  ;; Spell-Rune Emitters:
  ;;   1 = Sparkbolt, 2 = Bullet, 3 = Minimortar, 4 = Luminous Drill, 5 = Buckshot, 6 = Spitter

  ;; True iff `e-idx` is a loose physics Boulder (not Player, Gauntlet-held, Gold Nugget, Match, Slime, Hopper, Mancer, or Halo Orb!)
  (defn boulder-entity? [state e-idx]
    (let [eid (Long.to-int (Uint64.to-long e-idx))]
      (if (= eid @(EngineState.player-ent-id state))
        false
        (let [rig (EngineState.rig state)]
          (if (Uint64.= @(RigBelt.grab-idx rig) e-idx)
            false
            (let [gb (EngineState.gold state)
                  g-alive (GoldBank.alive gb)
                  g-idx (GoldBank.idx gb)
                  mb (EngineState.matches state)
                  mt-life (MatchBook.life mb)
                  mt-idx (MatchBook.idx mb)
                  cb (EngineState.critters state)
                  c-alive (CritterBank.alive cb)
                  c-idx (CritterBank.idx cb)
                  eb (EngineState.enemies state)
                  h-alive (EnemyBank.alive eb)
                  h-idx (EnemyBank.idx eb)
                  mbk (EngineState.mancers state)
                  m-alive (MancerBank.alive mbk)
                  m-idx (MancerBank.idx mbk)
                  o-state (MancerBank.orb-state mbk)
                  o-idx (MancerBank.orb-idx mbk)
                  prot? false]
              (do
                (for [i 0 16]
                  (do
                    (when (and @(Array.unsafe-nth g-alive i) (Uint64.= @(Array.unsafe-nth g-idx i) e-idx))
                      (set! prot? true))
                    (when (and @(Array.unsafe-nth c-alive i) (Uint64.= @(Array.unsafe-nth c-idx i) e-idx))
                      (set! prot? true))
                    (when (and @(Array.unsafe-nth h-alive i) (Uint64.= @(Array.unsafe-nth h-idx i) e-idx))
                      (set! prot? true))))
                (for [i 0 8]
                  (when (and (> @(Array.unsafe-nth mt-life i) 0.0f) (Uint64.= @(Array.unsafe-nth mt-idx i) e-idx))
                    (set! prot? true)))
                (for [i 0 4]
                  (when (and @(Array.unsafe-nth m-alive i) (Uint64.= @(Array.unsafe-nth m-idx i) e-idx))
                    (set! prot? true)))
                (for [i 0 20]
                  (when (and (> @(Array.unsafe-nth o-state i) 0) (Uint64.= @(Array.unsafe-nth o-idx i) e-idx))
                    (set! prot? true)))
                (not prot?))))))))


  ;; Pulverize a shredded Boulder, Wall Quarry chunk, or Mancer Orb into supersonic shrapnel along Ophanim's +/-45 deg X-planes!
  (defn ophanim-shred-burst! [state ps x y z hx-a hz-a v1x v1y v1z v2x v2y v2z mat-id cnt spd-base sh-dmg sh-bls sh-fx fc]
    (let [drv (WandSystem.delivery-phase mat-id)
          grav (if (< mat-id 255.5f) 3.4f 1.1f)
          phi0 (* (Float.from-int (Int.mod fc 32)) 0.1963495f)
          step (/ 6.2831853f (Float.from-int (WandSystem.clamp-int 1 20 cnt)))]
      (do
        (ParticleSystem.emit-sparks! ps x y z 0.0f 1.0f 0.0f 26)
        (when (< mat-id 255.5f)
          (ParticleSystem.emit-debris! ps x y z 0.0f 1.0f 0.0f 14))
        (EngineState.push-wake-capsule! state x (- y 0.35f) z x (+ y 0.45f) z
          4.25f 4.80f 0.0f 2.2f 0.0f 3.65f)
        (for [si 0 cnt]
          (let [ang (+ phi0 (* (Float.from-int si) step))
                ca (WandSystem.fcos ang)
                sa (WandSystem.fsin ang)
                plane-b? (= (Int.mod si 2) 1)
                vx-d (if plane-b? (+ (* hx-a ca) (* v2x sa)) (+ (* hx-a ca) (* v1x sa)))
                vy-d (if plane-b? (* v2y sa) (* v1y sa))
                vz-d (if plane-b? (+ (* hz-a ca) (* v2z sa)) (+ (* hz-a ca) (* v1z sa)))]
            (WandSystem.spawn-bolt-fx! state
              (+ x (* vx-d 0.38f)) (+ y (* vy-d 0.38f)) (+ z (* vz-d 0.38f))
              (* vx-d spd-base) (* vy-d spd-base) (* vz-d spd-base)
              drv mat-id -1 0.0f 0.24f grav 0.86f 3 2 0 2 0 sh-dmg sh-bls 0.0f sh-fx))))))


  ;; Step Ophanim's Mancer Halo-Orb Ripper, Slime-Peeler, Creature Blender, & Dual-Boulder Cuisinart!
  (defn step-ophanim-cuisinart! [state world ps ecs px py pz m-sc inv inv-m imp-w
                                 hx-a hz-a v1x v1y v1z v2x v2y v2z t1x t1y t1z t2x t2y t2z
                                 sh-dmg sh-bls sh-fx player-id fdt fc]
    (let [dpx (Double.from-float px)
          dpy (Double.from-float py)
          dpz (Double.from-float pz)
          msc-d (Double.from-float m-sc)
          r-pull (* 14.5 msc-d)
          r-shred (* 3.85 msc-d)
          mbk (EngineState.mancers state)
          o-state (MancerBank.orb-state mbk)
          o-idx (MancerBank.orb-idx mbk)
          o-gen (MancerBank.orb-gen mbk)
          o-mat (MancerBank.orb-mat mbk)
          eb (EngineState.enemies state)
          h-hurt (EnemyBank.hurt-cd eb)
          h-pspd (EnemyBank.prev-spd eb)
          shred1? false
          shred1-idx (Uint64.from-long 0l)
          shred1-gen (Uint32.from-long 0l)
          shred1-x px
          shred1-y py
          shred1-z pz
          shred2? false
          shred2-idx (Uint64.from-long 0l)
          shred2-gen (Uint32.from-long 0l)
          shred2-x px
          shred2-y py
          shred2-z pz]
      (do
        ;; A. Peel wall/ceiling-clinging Slimes inside `r-pull` so they get yanked straight into the Cuisinart!
        (when (= (Int.mod fc 4) 0)
          (let [cbank (EngineState.critters state)
                a-alive (CritterBank.alive cbank)
                a-idx (CritterBank.idx cbank)
                a-gen (CritterBank.gen cbank)
                a-state (CritterBank.state cbank)]
            (for [ak 0 16]
              (when @(Array.unsafe-nth a-alive ak)
                (let [aent (ECS.Entity.init (Handle.init @(Array.unsafe-nth a-idx ak) @(Array.unsafe-nth a-gen ak)))
                      acb-opt (the (Maybe CompBody) (get-component ecs &aent))]
                  (match acb-opt
                    (Maybe.Nothing) ()
                    (Maybe.Just acb)
                      (let [arb (CompBody.rb &acb)
                            apos @(RigidBody.position arb)
                            adx (- @(Vector3.x &apos) dpx)
                            ady (- @(Vector3.y &apos) dpy)
                            adz (- @(Vector3.z &apos) dpz)]
                        (when (< (Double.sqrt (+ (+ (* adx adx) (* ady ady)) (* adz adz))) r-pull)
                          (let [ab (RigidBody.body arb)]
                            (do
                              (when (< @(Array.unsafe-nth a-state ak) 3)
                                (Array.aset! a-state ak 4))
                              (Body.set-body-type! ab (BodyType.Dynamic))
                              (Body.set-inv-mass! ab 1.0)
                              (Body.set-inv-inertia! ab 4.0)
                              (RigidBody.set-body! arb @ab)
                              (ECS.add-component! ecs &aent (CompBody.init @arb))))))))))))

        ;; B. Rip Ecomancer Halo Orbs out of orbit from 15.5m & shred them into 12 Mach-2 shrapnel bolts!
        (for [ok 0 20]
          (let [ost @(Array.unsafe-nth o-state ok)]
            (when (> ost 0)
              (let [oent (ECS.Entity.init (Handle.init @(Array.unsafe-nth o-idx ok) @(Array.unsafe-nth o-gen ok)))
                    ocb-opt (the (Maybe CompBody) (get-component ecs &oent))]
                (match ocb-opt
                  (Maybe.Nothing) ()
                  (Maybe.Just ocb)
                    (let [orb (CompBody.rb &ocb)
                          ob (RigidBody.body orb)
                          opos @(RigidBody.position orb)
                          gx (- dpx @(Vector3.x &opos))
                          gy (- dpy @(Vector3.y &opos))
                          gz (- dpz @(Vector3.z &opos))
                          gd (Double.sqrt (+ (+ (* gx gx) (* gy gy)) (* gz gz)))
                          omat @(Array.unsafe-nth o-mat ok)]
                      (if (and (<= inv 0) (< gd (+ r-shred 0.45)))
                        (if (Materials.explosive? omat)
                          (MancerSystem.detonate-orb-slot! state ok)
                          (let [ox (Double.to-float @(Vector3.x &opos))
                                oy (Double.to-float @(Vector3.y &opos))
                                oz (Double.to-float @(Vector3.z &opos))]
                            (do
                              (MancerSystem.destroy-orb-slot! state ok false)
                              (WandSystem.ophanim-shred-burst! state ps ox oy oz hx-a hz-a v1x v1y v1z v2x v2y v2z
                                omat 12 74.0f sh-dmg sh-bls sh-fx fc))))
                        (when (and (> gd 0.20) (< gd (+ r-pull 1.5)))
                          (let [inv-g (/ 1.0 gd)
                                pull-s (* (if (> inv 0) (* -40.0 (Double.from-float inv-m)) 38.0) (Double.from-float imp-w))
                                nv (Vector3.init (* (* gx inv-g) pull-s)
                                                 (* (* gy inv-g) pull-s)
                                                 (* (* gz inv-g) pull-s))]
                            (do
                              (when (or (= ost 1) (= ost 2))
                                (Array.aset! o-state ok 3))
                              (Body.set-is-sleeping! ob false)
                              (Body.set-velocity! ob nv)
                              (RigidBody.set-body! orb @ob)
                              (ECS.add-component! ecs &oent (CompBody.init @orb))))))))))))

        ;; C. Ferocious 14.5m Cross-Plane Blender Suction on Creatures + Capture up to 2 Boulders per frame!
        (let [k-bl (Physics.clamp 0.0 0.56 (Double.from-float (* 11.5f fdt)))
              imp-d (Double.from-float imp-w)
              cent-spd (* (* 36.5 (Double.from-float inv-m)) imp-d)]
          (query ecs (e (cb CompBody))
            (let [e-idx (ECS.Entity.index &e)
                  eid (Long.to-int (Uint64.to-long e-idx))]
              (when (/= eid player-id)
                (let [rb (CompBody.rb cb)
                      b (RigidBody.body rb)]
                  (when (> @(Body.inv-mass b) 0.0)
                    (let [epos @(RigidBody.position rb)
                          gx (- dpx @(Vector3.x &epos))
                          gy (- dpy @(Vector3.y &epos))
                          gz (- dpz @(Vector3.z &epos))
                          gd (Double.sqrt (+ (+ (* gx gx) (* gy gy)) (* gz gz)))]
                      (when (and (> gd 0.12) (< gd r-pull))
                        (if (and (<= inv 0) (and (< gd r-shred) (WandSystem.boulder-entity? state e-idx)))
                          (if (not shred1?)
                            (do
                              (set! shred1? true)
                              (set! shred1-idx e-idx)
                              (set! shred1-gen (ECS.Entity.generation &e))
                              (set! shred1-x (Double.to-float @(Vector3.x &epos)))
                              (set! shred1-y (Double.to-float @(Vector3.y &epos)))
                              (set! shred1-z (Double.to-float @(Vector3.z &epos))))
                            (when (not shred2?)
                              (do
                                (set! shred2? true)
                                (set! shred2-idx e-idx)
                                (set! shred2-gen (ECS.Entity.generation &e))
                                (set! shred2-x (Double.to-float @(Vector3.x &epos)))
                                (set! shred2-y (Double.to-float @(Vector3.y &epos)))
                                (set! shred2-z (Double.to-float @(Vector3.z &epos))))))
                          (let [plane-b? (= (Int.mod eid 2) 1)
                                sx-t (Double.from-float (if plane-b? t2x t1x))
                                sy-t (Double.from-float (if plane-b? t2y t1y))
                                sz-t (Double.from-float (if plane-b? t2z t1z))
                                inv-g (/ 1.0 gd)
                                pull-mag (* (+ 19.5 (* 16.5 (- 1.0 (/ gd r-pull)))) imp-d)
                                shear-mag (* (+ 22.0 (* 18.0 (Physics.clamp 0.0 1.0 (- 1.15 (/ gd (* 5.5 msc-d)))))) imp-d)
                                old-v @(Body.velocity b)
                                tvx (+ (* (* gx inv-g) pull-mag) (* sx-t shear-mag))
                                tvy (+ (+ (* (* gy inv-g) (* pull-mag 1.25)) (* sy-t shear-mag)) 5.2)
                                tvz (+ (* (* gz inv-g) pull-mag) (* sz-t shear-mag))
                                nv (if (> inv 0)
                                     ;; Centrifuge Mode (`Invert`): catapult outward at 36+ m/s along +/-45 deg X-blades!
                                     (Vector3.init
                                       (Physics.clamp -48.0 48.0 (+ (* @(Vector3.x &old-v) 0.25) (* (- (* sx-t 0.72) (* gx (* inv-g 0.72))) cent-spd)))
                                       (Physics.clamp -38.0 42.0 (+ (* @(Vector3.y &old-v) 0.25) (+ (* (- (* sy-t 0.72) (* gy (* inv-g 0.65))) cent-spd) 4.8)))
                                       (Physics.clamp -48.0 48.0 (+ (* @(Vector3.z &old-v) 0.25) (* (- (* sz-t 0.72) (* gz (* inv-g 0.72))) cent-spd))))
                                     ;; Blender Mode: lift off floor & whip violently into the X-intersection!
                                     (Vector3.init
                                       (Physics.clamp -46.0 46.0 (+ @(Vector3.x &old-v) (* (- tvx @(Vector3.x &old-v)) k-bl)))
                                       (Physics.clamp -36.0 38.0 (+ @(Vector3.y &old-v) (* (- tvy @(Vector3.y &old-v)) k-bl)))
                                       (Physics.clamp -46.0 46.0 (+ @(Vector3.z &old-v) (* (- tvz @(Vector3.z &old-v)) k-bl)))))
                                hslot (EnemySystem.hopper-slot-by-idx state e-idx)]
                            (do
                              (when (and (>= hslot 0) (< @(Array.unsafe-nth h-hurt hslot) 0.22f))
                                (do
                                  (Array.aset! h-hurt hslot 0.22f)
                                  (Array.aset! h-pspd hslot (Double.to-float (Vector3.mag &nv)))))
                              (Body.set-is-sleeping! b false)
                              (Body.set-velocity! b nv)
                              (RigidBody.set-body! rb @b)
                              (ECS.add-component! ecs &e (CompBody.init @rb)))))))))))))

        ;; Safely despawn & pulverize captured Boulders outside `(query ecs ...)`!
        (when shred1?
          (let [sent1 (ECS.Entity.init (Handle.init shred1-idx shred1-gen))
                svec1 (Vector3.init (Double.from-float shred1-x) (Double.from-float shred1-y) (Double.from-float shred1-z))
                near-m1 (CritterSystem.sample-solid-mat-near world &svec1)
                bmat1 (if (and (>= near-m1 1.0f) (< near-m1 250.0f)) near-m1 1.0f)]
            (do
              (GameWorld.destroy-entity! ecs &sent1)
              (WandSystem.ophanim-shred-burst! state ps shred1-x shred1-y shred1-z hx-a hz-a v1x v1y v1z v2x v2y v2z
                bmat1 10 72.0f sh-dmg sh-bls sh-fx fc))))
        (when shred2?
          (let [sent2 (ECS.Entity.init (Handle.init shred2-idx shred2-gen))
                svec2 (Vector3.init (Double.from-float shred2-x) (Double.from-float shred2-y) (Double.from-float shred2-z))
                near-m2 (CritterSystem.sample-solid-mat-near world &svec2)
                bmat2 (if (and (>= near-m2 1.0f) (< near-m2 250.0f)) near-m2 1.0f)]
            (do
              (GameWorld.destroy-entity! ecs &sent2)
              (WandSystem.ophanim-shred-burst! state ps shred2-x shred2-y shred2-z hx-a hz-a v1x v1y v1z v2x v2y v2z
                bmat2 10 72.0f sh-dmg sh-bls sh-fx (+ fc 7))))))))


  ;; Step `108 = ◆ Supernova` Solar Corona Gravity & `🔄 Invert` Gargantua Black-Hole Accretion + Boulder/Orb Devouring!
  ;; Returns the number of Boulders / Mancer Orbs swallowed this frame so the Star / Black Hole grows in mass & damage!
  (defn step-supernova-well! [state world ps ecs px py pz brad is-bh? pinch? inv-m imp-w player-id fdt fc]
    (let [dpx (Double.from-float px)
          dpy (Double.from-float py)
          dpz (Double.from-float pz)
          brad-d (Double.from-float brad)
          r-well (if (or is-bh? pinch?)
                   (Physics.clamp 10.5 22.0 (+ 9.5 (* brad-d 2.35)))
                   (Physics.clamp 4.5 14.5 (+ 2.4 (* brad-d 1.95))))
          r-eat (+ (* brad-d (if is-bh? 1.05 0.72)) 0.95)
          mbk (EngineState.mancers state)
          o-state (MancerBank.orb-state mbk)
          o-idx (MancerBank.orb-idx mbk)
          o-gen (MancerBank.orb-gen mbk)
          o-mat (MancerBank.orb-mat mbk)
          eb (EngineState.enemies state)
          h-hurt (EnemyBank.hurt-cd eb)
          h-pspd (EnemyBank.prev-spd eb)
          eaten 0
          eat1? false
          eat1-idx (Uint64.from-long 0l)
          eat1-gen (Uint32.from-long 0l)
          eat1-x px
          eat1-y py
          eat1-z pz
          eat2? false
          eat2-idx (Uint64.from-long 0l)
          eat2-gen (Uint32.from-long 0l)
          eat2-x px
          eat2-y py
          eat2-z pz]
      (do
        ;; A. Peel wall/ceiling-clinging Slimes inside `r-well`!
        (when (= (Int.mod fc 4) 0)
          (let [cbank (EngineState.critters state)
                a-alive (CritterBank.alive cbank)
                a-idx (CritterBank.idx cbank)
                a-gen (CritterBank.gen cbank)
                a-state (CritterBank.state cbank)]
            (for [ak 0 16]
              (when @(Array.unsafe-nth a-alive ak)
                (let [aent (ECS.Entity.init (Handle.init @(Array.unsafe-nth a-idx ak) @(Array.unsafe-nth a-gen ak)))
                      acb-opt (the (Maybe CompBody) (get-component ecs &aent))]
                  (match acb-opt
                    (Maybe.Nothing) ()
                    (Maybe.Just acb)
                      (let [arb (CompBody.rb &acb)
                            apos @(RigidBody.position arb)
                            adx (- @(Vector3.x &apos) dpx)
                            ady (- @(Vector3.y &apos) dpy)
                            adz (- @(Vector3.z &apos) dpz)]
                        (when (< (Double.sqrt (+ (+ (* adx adx) (* ady ady)) (* adz adz))) r-well)
                          (let [ab (RigidBody.body arb)]
                            (do
                              (when (< @(Array.unsafe-nth a-state ak) 3)
                                (Array.aset! a-state ak 4))
                              (Body.set-body-type! ab (BodyType.Dynamic))
                              (Body.set-inv-mass! ab 1.0)
                              (Body.set-inv-inertia! ab 4.0)
                              (RigidBody.set-body! arb @ab)
                              (ECS.add-component! ecs &aent (CompBody.init @arb))))))))))))

        ;; B. Rip Mancer Halo Orbs out of orbit & devour them across the Event Horizon / Solar Core!
        (for [ok 0 20]
          (let [ost @(Array.unsafe-nth o-state ok)]
            (when (> ost 0)
              (let [oent (ECS.Entity.init (Handle.init @(Array.unsafe-nth o-idx ok) @(Array.unsafe-nth o-gen ok)))
                    ocb-opt (the (Maybe CompBody) (get-component ecs &oent))]
                (match ocb-opt
                  (Maybe.Nothing) ()
                  (Maybe.Just ocb)
                    (let [orb (CompBody.rb &ocb)
                          ob (RigidBody.body orb)
                          opos @(RigidBody.position orb)
                          gx (- dpx @(Vector3.x &opos))
                          gy (- dpy @(Vector3.y &opos))
                          gz (- dpz @(Vector3.z &opos))
                          gd (Double.sqrt (+ (+ (* gx gx) (* gy gy)) (* gz gz)))
                          omat @(Array.unsafe-nth o-mat ok)]
                      (if (< gd r-eat)
                        (do
                          (if (and (not is-bh?) (Materials.explosive? omat))
                            (MancerSystem.detonate-orb-slot! state ok)
                            (MancerSystem.destroy-orb-slot! state ok false))
                          (ParticleSystem.emit-sparks! ps
                            (Double.to-float @(Vector3.x &opos))
                            (Double.to-float @(Vector3.y &opos))
                            (Double.to-float @(Vector3.z &opos))
                            0.0f 1.0f 0.0f 16)
                          (set! eaten (+ eaten 1)))
                        (when (and (> gd 0.20) (< gd (+ r-well 1.5)))
                          (let [inv-g (/ 1.0 gd)
                                pull-s (* (if (or is-bh? pinch?) (* 38.0 (Double.from-float inv-m)) 18.0)
                                          (Double.from-float imp-w))
                                nv (Vector3.init (* (* gx inv-g) pull-s)
                                                 (* (* gy inv-g) pull-s)
                                                 (* (* gz inv-g) pull-s))]
                            (do
                              (when (or (= ost 1) (= ost 2))
                                (Array.aset! o-state ok 3))
                              (Body.set-is-sleeping! ob false)
                              (Body.set-velocity! ob nv)
                              (RigidBody.set-body! orb @ob)
                              (ECS.add-component! ecs &oent (CompBody.init @orb))))))))))))

        ;; C. Accretion Spiral / Stellar Gravity on `CompBody` + Devour up to 2 Boulders per frame!
        (let [k-bl (Physics.clamp 0.0 0.54 (Double.from-float (* (if (or is-bh? pinch?) 11.5f 6.8f) fdt)))
              imp-d (Double.from-float imp-w)
              invm-d (Double.from-float (if (> inv-m 0.1f) inv-m 1.0f))]
          (query ecs (e (cb CompBody))
            (let [e-idx (ECS.Entity.index &e)
                  eid (Long.to-int (Uint64.to-long e-idx))]
              (when (/= eid player-id)
                (let [rb (CompBody.rb cb)
                      b (RigidBody.body rb)]
                  (when (> @(Body.inv-mass b) 0.0)
                    (let [epos @(RigidBody.position rb)
                          gx (- dpx @(Vector3.x &epos))
                          gy (- dpy @(Vector3.y &epos))
                          gz (- dpz @(Vector3.z &epos))
                          gd (Double.sqrt (+ (+ (* gx gx) (* gy gy)) (* gz gz)))]
                      (when (and (> gd 0.12) (< gd r-well))
                        (if (and (or is-bh? pinch?) (and (< gd r-eat) (WandSystem.boulder-entity? state e-idx)))
                          (if (not eat1?)
                            (do
                              (set! eat1? true)
                              (set! eat1-idx e-idx)
                              (set! eat1-gen (ECS.Entity.generation &e))
                              (set! eat1-x (Double.to-float @(Vector3.x &epos)))
                              (set! eat1-y (Double.to-float @(Vector3.y &epos)))
                              (set! eat1-z (Double.to-float @(Vector3.z &epos))))
                            (when (not eat2?)
                              (do
                                (set! eat2? true)
                                (set! eat2-idx e-idx)
                                (set! eat2-gen (ECS.Entity.generation &e))
                                (set! eat2-x (Double.to-float @(Vector3.x &epos)))
                                (set! eat2-y (Double.to-float @(Vector3.y &epos)))
                                (set! eat2-z (Double.to-float @(Vector3.z &epos))))))
                          (let [inv-g (/ 1.0 gd)
                                gh (Double.sqrt (+ (* gx gx) (* gz gz)))
                                inv-h (if (> gh 0.08) (/ 1.0 gh) 0.0)
                                tx-s (* (- 0.0 gz) inv-h)
                                tz-s (* gx inv-h)
                                pull-m (if (or is-bh? pinch?)
                                         (* (* (+ 22.0 (* 18.0 (- 1.0 (/ gd r-well)))) invm-d) imp-d)
                                         (* (+ 9.5 (* 8.5 (- 1.0 (/ gd r-well)))) imp-d))
                                swirl-m (if is-bh? (* (* 21.5 invm-d) imp-d) (* 6.5 imp-d))
                                old-v @(Body.velocity b)
                                tvx (+ (* (* gx inv-g) pull-m) (* tx-s swirl-m))
                                tvy (+ (* (* gy inv-g) (* pull-m 1.20)) (if is-bh? 2.8 4.2))
                                tvz (+ (* (* gz inv-g) pull-m) (* tz-s swirl-m))
                                nv (Vector3.init
                                     (Physics.clamp -46.0 46.0 (+ @(Vector3.x &old-v) (* (- tvx @(Vector3.x &old-v)) k-bl)))
                                     (Physics.clamp -38.0 38.0 (+ @(Vector3.y &old-v) (* (- tvy @(Vector3.y &old-v)) k-bl)))
                                     (Physics.clamp -46.0 46.0 (+ @(Vector3.z &old-v) (* (- tvz @(Vector3.z &old-v)) k-bl))))
                                hslot (EnemySystem.hopper-slot-by-idx state e-idx)]
                            (do
                              (when (and (>= hslot 0) (< @(Array.unsafe-nth h-hurt hslot) 0.22f))
                                (do
                                  (Array.aset! h-hurt hslot 0.22f)
                                  (Array.aset! h-pspd hslot (Double.to-float (Vector3.mag &nv)))))
                              (Body.set-is-sleeping! b false)
                              (Body.set-velocity! b nv)
                              (RigidBody.set-body! rb @b)
                              (ECS.add-component! ecs &e (CompBody.init @rb)))))))))))))

        ;; Safely despawn devoured Boulders outside `(query ecs ...)`!
        (when eat1?
          (let [sent1 (ECS.Entity.init (Handle.init eat1-idx eat1-gen))]
            (do
              (GameWorld.destroy-entity! ecs &sent1)
              (ParticleSystem.emit-sparks! ps eat1-x eat1-y eat1-z 0.0f 1.0f 0.0f 18)
              (set! eaten (+ eaten 1)))))
        (when eat2?
          (let [sent2 (ECS.Entity.init (Handle.init eat2-idx eat2-gen))]
            (do
              (GameWorld.destroy-entity! ecs &sent2)
              (ParticleSystem.emit-sparks! ps eat2-x eat2-y eat2-z 0.0f 1.0f 0.0f 18)
              (set! eaten (+ eaten 1)))))
        eaten)))


  ;; `108 = ◆ Supernova` Cataclysmic Core-Collapse Detonation (Solar Supernova OR Black-Hole Quasar Burst!):
  ;;   Carves a spherical blast chamber, fires a 22m GPU shockwave, launches 6 ejecta boulders, and erupts
  ;;   64 Fibonacci `style = 5` superheated plasma / Tank-reagent shock-orbs across the cavern!
  (defn unleash-supernova! [state world ps ecs px py pz is-bh? wid bmat biw bim base-rad bdmg bblast bhom bbnc bprc bspl fxp tkind tpack tfx fc bi]
    (let [pvec (Vector3.init (Double.from-float px) (Double.from-float py) (Double.from-float pz))
          d0 (Physics.sample-sdf-trilinear world &pvec)
          near-surf? (and (< d0 1.25f) (> d0 -900.0f))
          nrm (if near-surf? (Physics.estimate-sdf-normal world &pvec) (Vector3.init 0.0 1.0 0.0))
          nx (Double.to-float @(Vector3.x &nrm))
          ny (Double.to-float @(Vector3.y &nrm))
          nz (Double.to-float @(Vector3.z &nrm))
          push-d (if near-surf? (- 1.15f (Float.clamp -0.80f 1.15f d0)) 0.0f)
          pop-x (+ px (* nx push-d))
          pop-y (+ py (* ny push-d))
          pop-z (+ pz (* nz push-d))
          s-hvy? (>= bspl 110)
          acc (Int.mod (WandSystem.clamp-int 0 9 (if s-hvy? (- bspl 110) (- bspl 100))) 8)
          hvy (if s-hvy? 1 0)
          peak-rad (Float.clamp 1.85f 7.80f (* base-rad 3.85f))
          m-sc (Float.clamp 0.90f 2.40f (/ base-rad 1.08f))
          trl (WandSystem.fx-trl fxp)
          glt (WandSystem.fx-glt fxp)
          exp (WandSystem.fx-exp fxp)
          inv (WandSystem.fx-inv fxp)
          imp (WandSystem.fx-imp fxp)
          pls (WandSystem.fx-pls fxp)
          srg (WandSystem.fx-srg fxp)
          hlx (WandSystem.fx-hlx fxp)
          sin-m (WandSystem.fx-sin fxp)
          blk (WandSystem.fx-blk fxp)
          inv-s (WandSystem.inv-scale inv)
          imp-s (WandSystem.imp-scale imp)
          ;; Strip Invert from outbound shock-shell bolts so BOTH Supernova & Black-Hole Quasar erupt outward at climax!
          shell-fx (WandSystem.pack-fx-mods
                     (if (> trl 0) 1 0) 0 0 0 (if (> glt 0) 1 0) (if (> exp 0) 1 0)
                     0 imp pls srg hlx sin-m 0)
          has-dual? (and (>= biw 0) (> bim 0.5f))
          pay-n (WandSystem.get-coupled-payload wid bmat biw bim)
          raw-tag @(SpellPayload.elem-tag &pay-n)
          stag (if (and (not is-bh?) (and (<= bmat 0.5f) (= raw-tag 0))) 2 raw-tag)
          crad (Float.clamp 2.85f 6.40f (* peak-rad (if s-hvy? 0.92f 0.76f)))
          near-m (CritterSystem.sample-solid-mat-near world &pvec)
          cmat (if (and (>= near-m 1.0f) (< near-m 250.0f)) near-m 1.0f)
          ospd0 (* 44.5f (WandSystem.mod-spd-mul acc 0))
          phi0 (* (Float.from-int (Int.mod (+ fc (* bi 11)) 32)) 0.1963495f)
          player-id @(EngineState.player-ent-id state)]
      (do
        ;; 1. Cavern-Carving Supernova Blast Chamber + Massive Searing Shockwave Damage!
        (EngineState.enqueue-explosion! state pop-x pop-y pop-z crad 1.75f -1)
        (EngineState.push-voxel-action! state pop-x pop-y pop-z (* crad 0.88f) cmat -1.0f 0.0f)
        (MancerSystem.edit-bender-sdf! world &pvec (Double.from-float (* crad 0.88f)) cmat true)
        (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
          pop-x pop-y pop-z 0.0f 1.0f 0.0f (if is-bh? 24.0f 30.0f) (* 11.5f m-sc) stag wid bmat (* bdmg 2.35f))
        (when has-dual?
          (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
            pop-x pop-y pop-z 0.0f 1.0f 0.0f 20.0f (* 10.5f m-sc) (WandSystem.mat-elem-tag bim biw) biw bim (* bdmg 1.65f)))
        (when (> exp 0)
          (ignore (WandSystem.detonate-bolt-explosion! state world ps ecs pop-x pop-y pop-z
                    nx ny nz wid bmat biw bim (* base-rad 1.65f) (* bdmg 1.85f) (* bblast 1.75f) 2 fxp 1.55f 0)))

        ;; 2. 22m GPU Shockwave + Relativistic Quasar Jets (`is-bh?`) + Core Reagent Saturation!
        (ParticleSystem.emit! ps pop-x pop-y pop-z 0.0f 4.8f 0.0f 4.85f 64 PARTICLE-TYPE-MAGIC 0.65f 0.34f)
        (ParticleSystem.emit-sparks! ps pop-x pop-y pop-z 0.0f 1.0f 0.0f 56)
        (ParticleSystem.emit-debris! ps pop-x pop-y pop-z 0.0f 1.0f 0.0f 24)
        (EngineState.push-wake-capsule! state
          pop-x (- pop-y 1.8f) pop-z pop-x (+ pop-y 2.2f) pop-z
          (* 16.5f m-sc) 16.5f 0.0f 5.5f 0.0f 3.75f)
        (when is-bh?
          ;; Relativistic Polar Quasar Jets blasting straight up & down the cavern vault!
          (do
            (EngineState.push-wake-capsule! state
              pop-x (- pop-y 9.5f) pop-z pop-x (+ pop-y 9.5f) pop-z
              5.45f 0.0f 0.0f 38.0f 0.0f 3.75f)))
        (if (> bmat 255.0f)
          (WandSystem.inject-gpu-reagent! state pop-x pop-y pop-z (Float.clamp 2.6f 5.2f (* base-rad 2.8f)) bmat 0.92f)
          (if (and (> bmat 0.5f) (or (Materials.granular? bmat) (WandSystem.reactive-solid? bmat)))
            (WandSystem.inject-gpu-reagent! state pop-x pop-y pop-z (Float.clamp 2.2f 4.4f (* base-rad 2.3f)) (- 0.0f bmat) 0.96f)
            (when (not is-bh?)
              (WandSystem.inject-gpu-reagent! state pop-x pop-y pop-z (Float.clamp 2.8f 5.4f (* base-rad 3.0f)) 515.0f 0.88f))))
        (when (and has-dual? (> bim 255.0f))
          (WandSystem.inject-gpu-reagent! state pop-x (+ pop-y 0.45f) pop-z (Float.clamp 2.5f 5.0f (* base-rad 2.6f)) bim 0.88f))

        ;; 3. Cataclysmic RigidBody Blast Fling (`(/= eid player-id)` protects Boomerang Sun-Gods!)
        (let [dpx (Double.from-float pop-x)
              dpy (Double.from-float pop-y)
              dpz (Double.from-float pop-z)
              r-fling (* 15.5 (Double.from-float m-sc))
              imp-b (if (> imp 0) (+ 1.0 (* 0.65 (Double.from-float imp-s))) 1.0)]
          (query ecs (e (cb CompBody))
            (let [e-idx (ECS.Entity.index &e)
                  eid (Long.to-int (Uint64.to-long e-idx))]
              (when (/= eid player-id)
                (let [rb (CompBody.rb cb)
                      b (RigidBody.body rb)]
                  (when (> @(Body.inv-mass b) 0.0)
                    (let [epos @(RigidBody.position rb)
                          rx (- @(Vector3.x &epos) dpx)
                          ry (- @(Vector3.y &epos) dpy)
                          rz (- @(Vector3.z &epos) dpz)
                          gd (Double.sqrt (+ (+ (* rx rx) (* ry ry)) (* rz rz)))]
                      (when (< gd r-fling)
                        (let [falloff (- 1.0 (* 0.48 (/ gd r-fling)))
                              ang-e (* (Double.from-int (+ (* fc 13) (* eid 7))) 1.15)
                              ux (if (> gd 0.14) (/ rx gd) (Double.cos ang-e))
                              uy (if (> gd 0.14) (Physics.clamp 0.25 0.90 (+ (/ ry gd) 0.42)) 0.58)
                              uz (if (> gd 0.14) (/ rz gd) (Double.sin ang-e))
                              fspd (* (* 34.0 falloff) imp-b)
                              old-v @(Body.velocity b)
                              nv (Vector3.init
                                   (Physics.clamp -48.0 48.0 (+ (* @(Vector3.x &old-v) 0.20) (* ux fspd)))
                                   (Physics.clamp -38.0 44.0 (+ (* @(Vector3.y &old-v) 0.20) (+ (* uy fspd) 7.5)))
                                   (Physics.clamp -48.0 48.0 (+ (* @(Vector3.z &old-v) 0.20) (* uz fspd))))
                              hslot (EnemySystem.hopper-slot-by-idx state e-idx)]
                          (do
                            (when (>= hslot 0)
                              (do
                                (Array.aset! (EnemyBank.hurt-cd (EngineState.enemies state)) hslot 0.32f)
                                (Array.aset! (EnemyBank.prev-spd (EngineState.enemies state)) hslot (Double.to-float (Vector3.mag &nv)))))
                            (Body.set-is-sleeping! b false)
                            (Body.set-velocity! b nv)
                            (RigidBody.set-body! rb @b)
                            (ECS.add-component! ecs &e (CompBody.init @rb))))))))))))

        ;; 4. Launch 6 Molten/Stone Ejecta Boulders + 64-Orb Fibonacci Supernova Shock-Shell!
        (for [bi-e 0 6]
          (let [baz (+ phi0 (* (Float.from-int bi-e) 1.0471976f))
                bdx (WandSystem.fcos baz)
                bdz (WandSystem.fsin baz)
                bpos (Vector3.init (Double.from-float (+ pop-x (* bdx 0.85f)))
                                   (Double.from-float (+ pop-y 0.55f))
                                   (Double.from-float (+ pop-z (* bdz 0.85f))))
                bvel (Vector3.init (Double.from-float (* bdx 24.5f)) 11.5 (Double.from-float (* bdz 24.5f)))
                ej-mat (if (and (> bmat 0.5f) (< bmat 250.0f)) bmat cmat)]
            (ignore (EditingSystem.spawn-boulder! state bpos bvel (Double.from-float (* 0.44f m-sc)) ej-mat 12000l))))

        (when (> blk 0)
          (WandSystem.blink-with-polarity! state world ps ecs pop-x (+ pop-y 0.45f) pop-z nx ny nz inv))

        (for [ni 0 64]
          (let [yn (- 1.0f (* 2.0f (/ (+ (Float.from-int ni) 0.5f) 64.0f)))
                rn (Float.sqrt (Float.clamp 0.0f 1.0f (- 1.0f (* yn yn))))
                theta (+ phi0 (* (Float.from-int ni) 2.3999632f))
                dx (* (WandSystem.fcos theta) rn)
                dy yn
                dz (* (WandSystem.fsin theta) rn)
                swap-t? (and has-dual? (= (Int.mod ni 2) 1))
                odrv (if swap-t? biw (if (and (<= bmat 0.5f) (not is-bh?)) 2 wid))
                obmat (if swap-t? bim (if (and (<= bmat 0.5f) (not is-bh?)) 515.0f bmat))
                oinf (if swap-t? wid biw)
                oimat (if swap-t? bmat bim)
                orad (Float.clamp 0.22f 0.52f (* base-rad 0.26f))
                ospd (* ospd0 (- 1.08f (* 0.0025f (Float.from-int ni))))
                olgt (if (= (Int.mod ni 4) 0) 2 1)
                otk (if (or (= tkind 1) (= tkind 4)) tkind 0)]
            (WandSystem.spawn-bolt-trig! state
              (+ pop-x (* dx 0.65f)) (+ pop-y (* dy 0.65f)) (+ pop-z (* dz 0.65f))
              (* dx ospd) (* dy ospd) (* dz ospd)
              odrv obmat oinf oimat orad 1.4f 1.15f (+ 2 bbnc) (+ 1 bprc) 0 olgt 5
              (* bdmg 0.85f) (* bblast 0.82f) bhom shell-fx otk 0.0f (if (> otk 0) tpack 0) (if (> otk 0) tfx 0)))))))


  ;; `105 = ◆ Starburst` Seismic Detonation + Radial Patooey + 8-Orb Heavy Point-Nova:
  ;;   Fires at the climax of THE BIG SUCC (`0.44s` vacuum implosion), blasting all sucked-in enemies, boulders & fluids
  ;;   radially outward, hawking a 12-way 360-degree arcing fountain of Tank reagents ("radial patooey!"), and launching
  ;;   8 heavy `style = 5` Square-Antiprism star-orbs! (With `🔄 Invert`: Singularity Snap + Convergent 8-Orb Guillotine!)
  (defn unleash-starburst! [state world ps ecs px py pz wid bmat biw bim brad bdmg bblast bhom bbnc bprc bspl fxp tkind tpack tfx fc bi]
    (let [pvec (Vector3.init (Double.from-float px) (Double.from-float py) (Double.from-float pz))
          d0 (Physics.sample-sdf-trilinear world &pvec)
          near-surf? (and (< d0 0.92f) (> d0 -900.0f))
          nrm (if near-surf? (Physics.estimate-sdf-normal world &pvec) (Vector3.init 0.0 1.0 0.0))
          nx (Double.to-float @(Vector3.x &nrm))
          ny (Double.to-float @(Vector3.y &nrm))
          nz (Double.to-float @(Vector3.z &nrm))
          push-d (if near-surf? (- 0.92f (Float.clamp -0.60f 0.92f d0)) 0.0f)
          pop-x (+ px (* nx push-d))
          pop-y (+ py (* ny push-d))
          pop-z (+ pz (* nz push-d))
          m-sc (Float.clamp 0.85f 1.95f (/ brad 0.32f))
          raw-ah (WandSystem.clamp-int 0 63 (- bspl 100))
          acc (Int.mod raw-ah 8)
          hvy (/ raw-ah 8)
          trl (WandSystem.fx-trl fxp)
          hvr (WandSystem.fx-hvr fxp)
          bmg (WandSystem.fx-bmg fxp)
          blk (WandSystem.fx-blk fxp)
          glt (WandSystem.fx-glt fxp)
          exp (WandSystem.fx-exp fxp)
          inv (WandSystem.fx-inv fxp)
          imp (WandSystem.fx-imp fxp)
          pls (WandSystem.fx-pls fxp)
          srg (WandSystem.fx-srg fxp)
          inv-s (WandSystem.inv-scale inv)
          imp-s (WandSystem.imp-scale imp)
          pat-fx (WandSystem.pack-fx-mods (if (> trl 0) 1 0) 0 0 0 (if (> glt 0) 1 0) (if (> exp 0) 1 0) inv imp pls srg (WandSystem.fx-hlx fxp) (WandSystem.fx-sin fxp) (WandSystem.fx-stk fxp))
          ospd0 (* 33.5f (WandSystem.mod-spd-mul acc hvy))
          raw-ograv (if (or (> hvr 0) (> bmg 0))
                      0.0f
                      (* (if (> hvy 0) (* 2.3f (Float.from-int hvy)) 1.25f)
                         (WandSystem.mod-grav-mul acc 0)))
          ograv (if (> inv 0) (* (- 0.0f raw-ograv) inv-s) raw-ograv)
          olife (* (* 1.65f (if (> hvy 0) 1.25f 1.0f)) (WandSystem.mod-life-mul hvr bmg))
          ottimer (if (= tkind 2) 0.34f 0.0f)
          has-dual? (and (>= biw 0) (> bim 0.5f))
          phi0 (* (Float.from-int (Int.mod (+ fc (* bi 7)) 16)) 0.3926991f)
          player-id @(EngineState.player-ent-id state)]
      (do
        ;; 1. Central Seismic Crater, Reagent Core Splash, & Colossal Outward (or Singularity Snap!) GPU Shockwave!
        (WandSystem.trigger-bolt-impact! state world ps ecs pop-x pop-y pop-z
          nx ny nz wid bmat biw bim (* brad 1.30f) (* bdmg 1.35f) (* bblast 1.48f) 0 0 2 0.0f 2 fxp)
        (when (> exp 0)
          (ignore (WandSystem.detonate-bolt-explosion! state world ps ecs pop-x pop-y pop-z
                    nx ny nz wid bmat biw bim (* brad 1.35f) (* bdmg 1.40f) (* bblast 1.50f) 2 fxp 1.32f 0)))
        (ParticleSystem.emit! ps pop-x pop-y pop-z 0.0f (if (> inv 0) -2.4f 3.6f) 0.0f 3.45f 44 PARTICLE-TYPE-MAGIC 0.52f 0.24f)
        (ParticleSystem.emit-sparks! ps pop-x pop-y pop-z nx ny nz 32)
        (if (> inv 0)
          (EngineState.push-wake-capsule! state
            pop-x (- pop-y 1.05f) pop-z pop-x (+ pop-y 1.25f) pop-z
            (* 12.0f m-sc) (* -13.5f inv-s) 0.0f (* -2.8f inv-s) 0.0f (* -8.5f inv-s))
          (EngineState.push-wake-capsule! state
            pop-x (- pop-y 0.90f) pop-z pop-x (+ pop-y 1.15f) pop-z
            (* 11.2f m-sc) 11.5f 0.0f 3.4f 0.0f 7.2f))

        ;; 2. RigidBody Seismic Outward Fling (or `🔄 Invert` Singularity Snap yanking 11.5m of room contents into the guillotine!)
        (let [dpx (Double.from-float pop-x)
              dpy (Double.from-float pop-y)
              dpz (Double.from-float pop-z)
              r-fling (* (if (> inv 0) 11.5 7.8) (Double.from-float m-sc))
              imp-boost (if (> imp 0) (+ 1.0 (* 0.55 (Double.from-float imp-s))) 1.0)]
          (query ecs (e (cb CompBody))
            (let [eid (Long.to-int (Uint64.to-long (ECS.Entity.index &e)))]
              (when (/= eid player-id)
                (let [rb (CompBody.rb cb)
                      b (RigidBody.body rb)]
                  (when (> @(Body.inv-mass b) 0.0)
                    (let [epos @(RigidBody.position rb)
                          rx (- @(Vector3.x &epos) dpx)
                          ry (- @(Vector3.y &epos) dpy)
                          rz (- @(Vector3.z &epos) dpz)
                          gd (Double.sqrt (+ (+ (* rx rx) (* ry ry)) (* rz rz)))]
                      (when (< gd r-fling)
                        (if (> inv 0)
                          (let [in-spd (* (* 27.5 (Double.from-float inv-s)) imp-boost)
                                igd (if (> gd 0.16) (/ 1.0 gd) 0.0)
                                nv (Vector3.init (* (* (- 0.0 rx) igd) in-spd)
                                                 (+ (* (* (- 0.0 ry) igd) in-spd) 2.2)
                                                 (* (* (- 0.0 rz) igd) in-spd))]
                            (do
                              (Body.set-is-sleeping! b false)
                              (Body.set-velocity! b nv)
                              (RigidBody.set-body! rb @b)
                              (ECS.add-component! ecs &e (CompBody.init @rb))))
                          (let [falloff (- 1.0 (* 0.55 (/ gd r-fling)))
                                ang-e (* (Double.from-int (+ (* fc 13) (* eid 7))) 1.15)
                                ux (if (> gd 0.14) (/ rx gd) (Double.cos ang-e))
                                uy (if (> gd 0.14) (Physics.clamp 0.20 0.85 (+ (/ ry gd) 0.38)) 0.52)
                                uz (if (> gd 0.14) (/ rz gd) (Double.sin ang-e))
                                fspd (* (* 24.5 falloff) imp-boost)
                                old-v @(Body.velocity b)
                                nv (Vector3.init
                                     (+ (* @(Vector3.x &old-v) 0.25) (* ux fspd))
                                     (+ (* @(Vector3.y &old-v) 0.25) (+ (* uy fspd) 5.8))
                                     (+ (* @(Vector3.z &old-v) 0.25) (* uz fspd)))]
                            (do
                              (Body.set-is-sleeping! b false)
                              (Body.set-velocity! b nv)
                              (RigidBody.set-body! rb @b)
                              (ECS.add-component! ecs &e (CompBody.init @rb)))))))))))))

        ;; `⚡ Blink` (`39`) on Starburst: warps caster into eye (or Abduct-Snatches eye victims to caster with `Invert`!)
        (when (> blk 0)
          (WandSystem.blink-with-polarity! state world ps ecs pop-x (+ pop-y 0.28f) pop-z nx ny nz inv))

        ;; 3. THE RADIAL PATOOEY: 12-Way 360-Degree Arcing Reagent Gob Fountain (or Convergent Ring-Spit with `Invert`!)
        (let [near-vec (Vector3.init (Double.from-float px) (Double.from-float (- py 0.55f)) (Double.from-float pz))
              near-m (CritterSystem.sample-solid-mat-near world &near-vec)
              boulder-mat (if (and (>= near-m 1.0f) (< near-m 250.0f)) near-m 1.0f)]
          (for [pi 0 12]
            (let [paz (+ phi0 (* (Float.from-int pi) 0.5235988f))
                  pdx (WandSystem.fcos paz)
                  pdz (WandSystem.fsin paz)
                  odd? (= (Int.mod pi 2) 1)
                  pspd (* (if odd? 17.5f 22.5f) m-sc)
                  pvy (if (> inv 0) -2.4f (if odd? 8.4f 5.8f))
                  swap-p? (and has-dual? odd?)
                  pdrv (if swap-p? biw wid)
                  pbmat (if swap-p? bim bmat)
                  pinf (if swap-p? wid biw)
                  pimat (if swap-p? bmat bim)
                  prad (Float.clamp 0.14f 0.42f (* brad 0.62f))
                  ring-t (* 3.60f m-sc)
                  rtvec (Vector3.init (Double.from-float (+ pop-x (* pdx ring-t)))
                                      (Double.from-float (+ pop-y 0.85f))
                                      (Double.from-float (+ pop-z (* pdz ring-t))))
                  rtsdf (if (> inv 0) (Physics.sample-sdf-trilinear world &rtvec) 1.0f)
                  pr-dist (if (> inv 0) (if (and (<= rtsdf 0.25f) (> rtsdf -900.0f)) 1.15f ring-t) 0.42f)
                  pox (+ pop-x (* pdx pr-dist))
                  poy (+ pop-y (if (> inv 0) 0.85f 0.16f))
                  poz (+ pop-z (* pdz pr-dist))
                  pvx (if (> inv 0) (* (- 0.0f pdx) pspd) (* pdx pspd))
                  pvz (if (> inv 0) (* (- 0.0f pdz) pspd) (* pdz pspd))
                  gx (+ pop-x (* pdx (* 1.65f m-sc)))
                  gz (+ pop-z (* pdz (* 1.65f m-sc)))]
              (do
                ;; Immediate radial reagent ring-spit at `1.65m` on every 3rd spoke (`4` compass geysers)!
                (when (= (Int.mod pi 3) 0)
                  (do
                    (if (> pbmat 255.5f)
                      (WandSystem.inject-gpu-reagent! state gx pop-y gz (* 1.55f m-sc) pbmat 0.68f)
                      (when (and (> pbmat 0.5f) (or (Materials.granular? pbmat) (WandSystem.reactive-solid? pbmat)))
                        (WandSystem.inject-gpu-reagent! state gx pop-y gz (* 1.30f m-sc) (- 0.0f pbmat) 0.92f)))
                    (when (and (< d0 1.45f) (> d0 -900.0f))
                      (let [bpos (Vector3.init (Double.from-float (+ pop-x (* pdx (if (> inv 0) 2.25f 0.65f))))
                                               (Double.from-float (+ pop-y (if (> inv 0) 0.95f 0.35f)))
                                               (Double.from-float (+ pop-z (* pdz (if (> inv 0) 2.25f 0.65f)))))
                            bvel (if (> inv 0)
                                   (Vector3.init (Double.from-float (* (- 0.0f pdx) 18.5f)) 2.5 (Double.from-float (* (- 0.0f pdz) 18.5f)))
                                   (Vector3.init (Double.from-float (* pdx 18.5f)) 7.2 (Double.from-float (* pdz 18.5f))))]
                        (ignore (EditingSystem.spawn-boulder! state bpos bvel (Double.from-float (* 0.38f m-sc)) boulder-mat 12000l))))))
                ;; Arcing Patooey Gob (`12` gravity-lobbed alchemical loogies — or convergent crossfire gobs with `Invert`!)
                (WandSystem.spawn-bolt-trig! state pox poy poz
                  pvx pvy pvz
                  pdrv pbmat pinf pimat prad (if (> inv 0) 4.5f 15.2f) (if (> inv 0) 0.38f 0.62f) (if (> bbnc 0) 1 0) 0 0 1 0
                  (* bdmg 0.52f) (* bblast 0.72f) 0.0f
                  pat-fx 0 0.0f 0 0)))))

        ;; 4. THE 8 HEAVY STAR-ORBS: 3D Square-Antiprism Point-Nova (or `🔄 Invert` Convergent 8-Orb Guillotine!)
        (for [oi 0 8]
          (let [upper? (< oi 4)
                az (+ phi0 (+ (* (Float.from-int (Int.mod oi 4)) 1.5707963f) (if upper? 0.0f 0.7853982f)))
                dy (if upper? 0.38f -0.26f)
                rn (if upper? 0.9249865f 0.9656086f)
                dx (* (WandSystem.fcos az) rn)
                dz (* (WandSystem.fsin az) rn)
                srad (if (> inv 0)
                       (let [v4 (Vector3.init (Double.from-float (+ pop-x (* dx 4.4f)))
                                              (Double.from-float (+ pop-y (* dy 4.4f)))
                                              (Double.from-float (+ pop-z (* dz 4.4f))))
                             d4 (Physics.sample-sdf-trilinear world &v4)
                             v2 (Vector3.init (Double.from-float (+ pop-x (* dx 2.2f)))
                                              (Double.from-float (+ pop-y (* dy 2.2f)))
                                              (Double.from-float (+ pop-z (* dz 2.2f))))
                             d2 (Physics.sample-sdf-trilinear world &v2)]
                         (if (and (> d4 0.25f) (> d2 0.25f))
                           4.4f
                           (if (> d2 0.25f) 2.2f 0.75f)))
                       (let [tvec (Vector3.init (Double.from-float (+ pop-x (* dx 0.52f)))
                                                (Double.from-float (+ pop-y (* dy 0.52f)))
                                                (Double.from-float (+ pop-z (* dz 0.52f))))
                             dsdf (Physics.sample-sdf-trilinear world &tvec)]
                         (if (and (<= dsdf 0.16f) (> dsdf -900.0f)) 0.14f 0.52f)))
                ox (+ pop-x (* dx srad))
                oy (+ pop-y (* dy srad))
                oz (+ pop-z (* dz srad))
                swap-t? (and has-dual? (= (Int.mod oi 2) 1))
                odrv (if swap-t? biw wid)
                obmat (if swap-t? bim bmat)
                oinf (if swap-t? wid biw)
                oimat (if swap-t? bmat bim)
                ostag (if (> blk 0) (- 1.16f (* 0.045f (Float.from-int oi))) 1.0f)
                ospd (* (* ospd0 ostag) (if (> inv 0) -1.0f 1.0f))
                eff-olife (if (and (> inv 0) (and (= hvr 0) (= bmg 0))) (* olife 0.52f) olife)
                olgt (if (= (Int.mod oi 2) 0) 2 1)]
            (WandSystem.spawn-bolt-trig! state ox oy oz
              (* dx ospd) (* dy ospd) (* dz ospd)
              odrv obmat oinf oimat brad ograv eff-olife bbnc bprc 0 olgt 5 bdmg bblast bhom
              fxp tkind ottimer tpack tfx))))))


  ;; [103] Bolt Gyre Power Core (`bsty == 3`): Dual-Reagent 360-degree radial sub-bolt sprinkler (or `🔄 Invert` Convergent Crossfire Ring!).
  ;; Returns updated `frame-blinks`.
  (defn step-bolt-gyre! [state world ps ecs px0 py0 pz0 px py pz vx vz
                         wid bmat biw bim base-rad brad base-dmg bblast bhom bounces pierce blgt
                         fxp raw-stk eff-stk inv-m frame-blinks-in fc bi]
    (let [trl (WandSystem.fx-trl fxp)
          hvr (WandSystem.fx-hvr fxp)
          bmg (WandSystem.fx-bmg fxp)
          blk (WandSystem.fx-blk fxp)
          glt (WandSystem.fx-glt fxp)
          exp (WandSystem.fx-exp fxp)
          inv (WandSystem.fx-inv fxp)
          imp (WandSystem.fx-imp fxp)
          pls (WandSystem.fx-pls fxp)
          srg (WandSystem.fx-srg fxp)
          hlx (WandSystem.fx-hlx fxp)
          sin-m (WandSystem.fx-sin fxp)
          frame-blinks frame-blinks-in]
      (do
      (do
        ;; `⚡ Blink` (`39`) on Gyre: strobe-teleports caster (or Abduct-Snatches victims with `Invert`!)
        (when (and (> blk 0) (and (< frame-blinks 3) (or (>= blk 2) (= (Int.mod (+ fc bi) 2) 0))))
          (let [ba (+ (* (Float.from-int fc) 1.35f) (Float.from-int bi))
                bcx (WandSystem.fcos ba)
                bcz (WandSystem.fsin ba)]
            (do
              (WandSystem.blink-with-polarity! state world ps ecs
                (+ px (* bcx 1.65f)) (+ py 0.30f) (+ pz (* bcz 1.65f))
                bcx 0.25f bcz inv)
              (set! frame-blinks (+ frame-blinks 1)))))
        (when (= (Int.mod (+ fc bi) 6) 0)
          (let [base-a (* (Float.from-int fc) 0.55f)
                sub-r (Float.clamp 0.10f 1.50f (* (if (> pls 0) base-rad brad) 0.45f))
                has-dual? (and (>= biw 0) (> bim 0.5f))
                ox (* (WandSystem.fcos base-a) 0.78f)
                oz (* (WandSystem.fsin base-a) 0.78f)
                sub-fx (WandSystem.pack-fx-mods
                         (if (> trl 0) 1 0)
                         (if (>= hvr 2) 1 0)
                         (if (>= bmg 2) 1 0)
                         (if (> blk 0) 1 0)
                         (if (> glt 0) 1 0)
                         exp inv imp pls srg hlx sin-m
                         (if (and (> inv 0) (= raw-stk 3)) 3 (if (>= eff-stk 2) 1 0)))]
            (do
              (if (> bmat 255.0f)
                (WandSystem.inject-gpu-reagent! state (- px ox) py (- pz oz) (* brad 4.2f) bmat 0.52f)
                (when (and (> bmat 0.5f) (or (Materials.granular? bmat) (WandSystem.reactive-solid? bmat)))
                  (WandSystem.inject-gpu-reagent! state (- px ox) py (- pz oz) (* brad 3.2f) (- 0.0f bmat) 0.85f)))
              (when has-dual?
                (if (> bim 255.0f)
                  (WandSystem.inject-gpu-reagent! state (+ px ox) py (+ pz oz) (* brad 4.2f) bim 0.52f)
                  (when (or (Materials.granular? bim) (WandSystem.reactive-solid? bim))
                    (WandSystem.inject-gpu-reagent! state (+ px ox) py (+ pz oz) (* brad 3.2f) (- 0.0f bim) 0.85f))))
              (for [gi 0 4]
                (let [ga (+ base-a (* (Float.from-int gi) 1.570796f))
                      gca (WandSystem.fcos ga)
                      gsa (WandSystem.fsin ga)
                      gvx (* gca 24.0f)
                      gvz (* gsa 24.0f)
                      use-sec? (and has-dual? (= (Int.mod gi 2) 1))
                      sw (if use-sec? biw wid)
                      sm (if use-sec? bim bmat)
                      sgrav (if (> inv 0) (* (if (= sw 1) -8.5f -2.0f) inv-m) (if (= sw 1) 8.5f 2.0f))]
                  (if (> inv 0)
                    (let [rv (Vector3.init (Double.from-float (+ px (* gca 3.2f)))
                                           (Double.from-float (+ py 0.55f))
                                           (Double.from-float (+ pz (* gsa 3.2f))))
                          rd (Physics.sample-sdf-trilinear world &rv)
                          rr (if (and (<= rd 0.22f) (> rd -900.0f)) 1.05f 3.2f)]
                      (WandSystem.spawn-bolt-fx! state (+ px (* gca rr)) (+ py 0.55f) (+ pz (* gsa rr))
                        (- 0.0f gvx) -2.4f (- 0.0f gvz) sw sm -1 0.0f
                        sub-r sgrav 0.36f
                        (if (> bounces 0) 2 1) (if (> pierce 0) 1 0)
                        0 blgt 0 (* base-dmg 0.48f) (* bblast 0.65f) bhom sub-fx))
                    (WandSystem.spawn-bolt-fx! state px py pz gvx 1.8f gvz sw sm -1 0.0f
                      sub-r sgrav 0.55f
                      (if (> bounces 0) 2 1) (if (> pierce 0) 1 0)
                      0 blgt 0 (* base-dmg 0.48f) (* bblast 0.65f) bhom sub-fx)))))))
        (let [gpol (if (> inv 0) (- 0.0f inv-m) 1.0f)]
          (EngineState.push-wake-capsule! state px0 py0 pz0 px py pz
            4.35f (* -3.45f gpol) (* vx 0.25f) (* 1.65f gpol) (* vz 0.25f) (* -2.35f gpol))))
        frame-blinks)))


  ;; [104] Category-5 Maelstrom Hurricane (`bsty == 6`) & `🔄 Invert` Microburst Gravity Anvil!
  ;; Returns `(Pair frame-blinks frame-expls)`.
  (defn step-bolt-maelstrom! [state world ps ecs wb px py pz vx vy vz
                              wid bmat biw bim base-rad brad base-dmg bdmg bblast bhom bbnc bprc bspl
                              fxp raw-stk inv-m imp-m tpack tfx trail-ptype new-t odd-slot player-id
                              frame-blinks-in frame-expls-in fc bi fdt]
    (let [trl (WandSystem.fx-trl fxp)
          hvr (WandSystem.fx-hvr fxp)
          bmg (WandSystem.fx-bmg fxp)
          blk (WandSystem.fx-blk fxp)
          glt (WandSystem.fx-glt fxp)
          exp (WandSystem.fx-exp fxp)
          inv (WandSystem.fx-inv fxp)
          imp (WandSystem.fx-imp fxp)
          pls (WandSystem.fx-pls fxp)
          srg (WandSystem.fx-srg fxp)
          hlx (WandSystem.fx-hlx fxp)
          sin-m (WandSystem.fx-sin fxp)
          frame-blinks frame-blinks-in
          frame-expls frame-expls-in]
      (do
      (let [m-sc (Float.clamp 0.85f 1.95f (/ brad 0.76f))
            cur-spd (Float.sqrt (+ (+ (* vx vx) (* vy vy)) (* vz vz)))
            storm-str (Float.clamp 0.28f 1.0f (- 1.18f (/ cur-spd 22.0f)))
            has-dual? (and (>= biw 0) (> bim 0.5f))
            srg-wmul (if (> srg 0)
                       (Float.clamp 0.45f 2.15f (WandSystem.surge-envelope new-t srg inv odd-slot))
                       1.0f)
            imp-wmul (* (if (> imp 0) (+ 1.0f (* 0.60f imp-m)) 1.0f) srg-wmul)
            ha (- (* (Float.from-int bi) 1.7f) (* (Float.from-int fc) (if (> inv 0) -0.58f 0.58f)))
            hca (WandSystem.fcos ha)
            hsa (WandSystem.fsin ha)
            ba (- (+ (* (Float.from-int bi) 2.3f) 2.094f) (* (Float.from-int fc) (if (> inv 0) -0.41f 0.41f)))
            bca (WandSystem.fcos ba)
            bsa (WandSystem.fsin ba)
            u1 (* 0.125f (Float.from-int (Int.mod (+ fc bi) 8)))
            u2 (* 0.10f (Float.from-int (Int.mod (+ (* fc 3) (* bi 5)) 10)))
            hr1 (* (+ 1.75f (* 1.65f u1)) (* m-sc storm-str))
            hr2 (* (+ 3.35f (* 4.75f u2)) (* m-sc storm-str))
            sy1 (if (> inv 0)
                  (+ (+ py (* 0.45f m-sc)) (* (* 3.4f m-sc) u1))
                  (+ (- py (* 1.15f m-sc)) (* (* 3.4f m-sc) u1)))
            sy2 (if (> inv 0)
                  (+ (+ py (* 0.25f m-sc)) (* (* 2.8f m-sc) u2))
                  (+ (- py (* 1.50f m-sc)) (* (* 2.6f m-sc) u2)))
            sx1 (+ px (* hca hr1))
            sz1 (+ pz (* hsa hr1))
            sx2 (- px (* hca hr1))
            sz2 (- pz (* hsa hr1))
            ox1 (+ px (* bca hr2))
            oz1 (+ pz (* bsa hr2))
            ox2 (- px (* bca hr2))
            oz2 (- pz (* bsa hr2))
            rip-per (if (> bblast 1.55f) 14 24)]
        (do
          ;; `⚡ Blink` (`39`) Eye-Surfing (or `Invert` Storm-Abduction yanking cyclone victims to caster!)
          (when (and (> blk 0) (and (< frame-blinks 2) (= (Int.mod (+ fc bi) 5) 0)))
            (do
              (WandSystem.blink-with-polarity! state world ps ecs px (+ py 0.35f) pz 0.0f 1.0f 0.0f inv)
              (set! frame-blinks (+ frame-blinks 1))))

          ;; `💣 Explosive` (`41`) Eye-Wall Thunderclaps (paired with physical Explosive Storm Orbs below!)
          (when (and (> exp 0) (and (> storm-str 0.62f) (= (Int.mod (+ fc (* bi 5)) (if (>= exp 2) 22 32)) 0)))
            (set! frame-expls
              (WandSystem.detonate-bolt-explosion! state world ps ecs sx1 (- sy1 0.35f) sz1
                hsa 0.25f (- 0.0f hca) wid bmat biw bim (* brad 0.32f) (* bdmg 0.65f) bblast 6 fxp 0.88f frame-expls)))

          ;; 0. Occasional Swirling Storm Orbs (`style = 5`): condense modifier-infused orbs directly into the funnel!
          (let [m-raw (if (>= bspl 100) (- bspl 100) 0)
                m-acc (Int.mod m-raw 8)
                m-hvy (Int.mod (/ m-raw 8) 8)
                m-tk  (Int.mod (/ m-raw 64) 4)
                orb-per (WandSystem.clamp-int 7 18 (- 14 (* m-acc 2)))]
            (when (and (> storm-str 0.44f)
                       (and (< @(WandBelt.bolt-count wb) (- MAX-BOLTS 128))
                            (= (Int.mod (+ fc (* bi 5)) orb-per) 0)))
              (let [seq (/ (+ fc (* bi 5)) orb-per)
                    oa (+ (* (Float.from-int seq) 2.3999632f) (* (Float.from-int bi) 1.37f))
                    oca (WandSystem.fcos oa)
                    osa (WandSystem.fsin oa)
                    ulane (* 0.25f (Float.from-int (Int.mod (+ seq bi) 5)))
                    r-ideal (* (+ 1.75f (* 2.15f ulane)) (* m-sc storm-str))
                    oy-raw (if (> inv 0)
                             (+ py (* (+ 0.75f (* 2.15f ulane)) m-sc))
                             (+ (- py (* 0.55f m-sc)) (* (* 2.25f ulane) m-sc)))
                    v-out (Vector3.init (Double.from-float (+ px (* oca r-ideal)))
                                        (Double.from-float oy-raw)
                                        (Double.from-float (+ pz (* osa r-ideal))))
                    d-out (Physics.sample-sdf-trilinear world &v-out)
                    v-mid (Vector3.init (Double.from-float (+ px (* oca (* r-ideal 0.52f))))
                                        (Double.from-float oy-raw)
                                        (Double.from-float (+ pz (* osa (* r-ideal 0.52f)))))
                    d-mid (Physics.sample-sdf-trilinear world &v-mid)
                    orb-r (if (and (> d-out 0.28f) (> d-mid 0.24f))
                            r-ideal
                            (if (> d-mid 0.26f) (* r-ideal 0.52f) (* 0.36f m-sc)))
                    ox-s (+ px (* oca orb-r))
                    oy-s (if (> d-out 0.28f) oy-raw py)
                    oz-s (+ pz (* osa orb-r))
                    spd-m (WandSystem.mod-spd-mul m-acc m-hvy)
                    tan-s (* (* (* 34.5f spd-m) (if (> imp 0) (+ 1.0f (* 0.45f imp-m)) 1.0f))
                             (if (> inv 0) -0.82f 1.0f))
                    rad-s (if (> inv 0) -4.2f (+ 2.8f (* 2.4f (Float.from-int m-acc))))
                    ovx (+ (* osa tan-s) (* oca rad-s))
                    ovy (if (> inv 0)
                          (* (* -21.5f inv-m) spd-m)
                          (+ 1.8f (* 3.4f (- ulane 0.4f))))
                    ovz (+ (* (- 0.0f oca) tan-s) (* osa rad-s))
                    swap-o? (and has-dual? (= (Int.mod seq 2) 1))
                    odrv (if swap-o? biw wid)
                    obmat (if swap-o? bim bmat)
                    oinf (if swap-o? wid biw)
                    oimat (if swap-o? bmat bim)
                    orad (Float.clamp 0.17f 0.50f (* (if (> pls 0) base-rad brad) 0.26f))
                    ograv (if (> inv 0)
                            (* 14.5f inv-m)
                            (if (> m-hvy 0) (* 1.8f (Float.from-int m-hvy)) 0.25f))
                    olife (* (if (> inv 0) 0.88f 1.08f)
                             (* (if (> hvr 0) 1.35f 1.0f) (if (> bmg 0) 1.25f 1.0f)))
                    obnc (+ 1 (* bbnc 2))
                    olgt (if (= (Int.mod seq 2) 0) 2 1)
                    odmg (* base-dmg 0.52f)
                    obls (* bblast 0.72f)
                    ohom (* bhom 2.15f)
                    orb-fx (WandSystem.pack-fx-mods
                             trl 0 0 (if (> blk 0) 1 0) glt exp inv imp pls srg hlx sin-m raw-stk)
                    orb-tt (if (= m-tk 2) 0.48f 0.0f)]
                (do
                  (ParticleSystem.emit! ps ox-s oy-s oz-s
                    (* ovx 0.12f) (+ (* ovy 0.12f) 1.2f) (* ovz 0.12f)
                    0.95f 6 PARTICLE-TYPE-MAGIC 0.26f 0.10f)
                  (WandSystem.spawn-bolt-trig! state ox-s oy-s oz-s
                    ovx ovy ovz
                    odrv obmat oinf oimat orad ograv olife obnc bprc 0 olgt 5 odmg obls ohom
                    orb-fx m-tk orb-tt tpack tfx)))))

          ;; 1. Dual-Layer Wide 3D GPU `vel_texture` Field (negative `wrad` activates GPU Rankine Swirl!)
          ;;    With `🔄 Invert`: crushing `-11.5` microburst downdraft + radial floor pancake splat!
          (if (> inv 0)
            (do
              (EngineState.push-wake-capsule! state
                px (- py (* 2.60f m-sc)) pz px (+ py (* 5.40f m-sc)) pz
                (* (* -13.8f m-sc) storm-str) (* (* 6.4f inv-m) storm-str)
                (* vx 0.16f) (* (* (* -11.5f (* m-sc inv-m)) storm-str) imp-wmul) (* vz 0.16f) (* (* 3.1f inv-m) storm-str))
              (when (> storm-str 0.55f)
                (EngineState.push-wake-capsule! state
                  px (- py (* 1.20f m-sc)) pz px (+ py (* 7.60f m-sc)) pz
                  (* (* -9.8f m-sc) storm-str) (* -3.2f storm-str)
                  0.0f (* (* (* -14.2f (* m-sc inv-m)) storm-str) imp-wmul) 0.0f (* 2.4f storm-str))))
            (do
              (EngineState.push-wake-capsule! state
                px (- py (* 2.35f m-sc)) pz px (+ py (* 4.40f m-sc)) pz
                (* (* -13.8f m-sc) storm-str) (* -5.6f storm-str)
                (* vx 0.16f) (* (* (* 3.2f m-sc) storm-str) imp-wmul) (* vz 0.16f) (* -1.88f storm-str))
              (when (> storm-str 0.55f)
                (EngineState.push-wake-capsule! state
                  px (- py (* 0.80f m-sc)) pz px (+ py (* 7.40f m-sc)) pz
                  (* (* -9.8f m-sc) storm-str) (* -4.2f storm-str)
                  0.0f (* (* (* 5.0f m-sc) storm-str) imp-wmul) 0.0f (* -1.55f storm-str)))))

          ;; 2. Wind-Coupled 3D Hurricane Rainbands (or violent downward Microburst Hammer Rain with `Invert`!)
          (let [pvy1 (if (> inv 0) (* -21.5f inv-m) 3.4f)
                pvy2 (if (> inv 0) (* -19.0f inv-m) 1.8f)
                tsgn (if (> inv 0) -1.0f 1.0f)]
            (do
              (ParticleSystem.emit! ps sx1 sy1 sz1
                (* (- (* hsa 19.5f) (* hca 4.2f)) tsgn) pvy1 (* (- (* (- 0.0f hca) 19.5f) (* hsa 4.2f)) tsgn)
                0.38f 3 trail-ptype 0.62f 0.13f)
              (when (> storm-str 0.52f)
                (do
                  (ParticleSystem.emit! ps ox1 sy2 oz1
                    (* (- (* bsa 22.0f) (* bca 6.5f)) tsgn) pvy2 (* (- (* (- 0.0f bca) 22.0f) (* bsa 6.5f)) tsgn)
                    0.32f 3 PARTICLE-TYPE-DUST 0.88f 0.16f)
                  (ParticleSystem.emit! ps ox2 (+ sy2 0.45f) oz2
                    (* (+ (* (- 0.0f bsa) 21.0f) (* bca 6.0f)) tsgn) pvy2 (* (+ (* bca 21.0f) (* bsa 6.0f)) tsgn)
                    0.34f 2 (if (= (Int.mod (+ fc bi) 2) 0) PARTICLE-TYPE-SMOKE PARTICLE-TYPE-DUST) 0.82f 0.18f)
                  (when has-dual?
                    (let [imod (WandSystem.get-bolt-mod biw bim)]
                      (ParticleSystem.emit! ps sx2 sy1 sz2
                        (* (+ (* (- 0.0f hsa) 19.5f) (* hca 4.2f)) tsgn) pvy1 (* (+ (* hca 19.5f) (* hsa 4.2f)) tsgn)
                        0.38f 2 @(WandMod.trail-ptype &imod) 0.60f 0.13f)))
                  (when (= (Int.mod (+ fc bi) 2) 0)
                    (let [gvec (Vector3.init (Double.from-float ox1) (Double.from-float (- py (* 1.65f m-sc))) (Double.from-float oz1))
                          gsdf (Physics.sample-sdf-trilinear world &gvec)]
                      (when (and (<= gsdf 1.55f) (> gsdf -900.0f))
                        (ParticleSystem.emit! ps ox1 (- py (* 1.35f m-sc)) oz1
                          (* (- (* bsa 16.5f) (* bca 5.5f)) tsgn) (if (> inv 0) 1.4f 5.2f) (* (- (* (- 0.0f bca) 16.5f) (* bsa 5.5f)) tsgn)
                          0.52f (if (> inv 0) 4 2) PARTICLE-TYPE-DEBRIS 0.68f 0.22f))))))))

          ;; Dual-Tank GPU Reagent Rainband Injection
          (when (and (> storm-str 0.62f) (or (> trl 0) (= (Int.mod (+ fc bi) 2) 0)))
            (let [rrad (Float.clamp 1.15f 2.95f (* (+ 1.45f (* 0.35f (Float.from-int trl))) m-sc))]
              (do
                (if (> bmat 255.5f)
                  (WandSystem.inject-gpu-reagent! state sx1 sy1 sz1 rrad bmat 0.54f)
                  (when (and (> bmat 0.5f) (or (Materials.granular? bmat) (WandSystem.reactive-solid? bmat)))
                    (WandSystem.inject-gpu-reagent! state sx1 sy1 sz1 (* rrad 0.85f) (- 0.0f bmat) 0.88f)))
                (when has-dual?
                  (if (> bim 255.5f)
                    (WandSystem.inject-gpu-reagent! state sx2 sy1 sz2 rrad bim 0.52f)
                    (when (or (Materials.granular? bim) (WandSystem.reactive-solid? bim))
                      (WandSystem.inject-gpu-reagent! state sx2 sy1 sz2 (* rrad 0.85f) (- 0.0f bim) 0.88f)))))))

          ;; 3. Boulder Scouring: Floor/Wall Cyclone Rip (or `🔄 Invert` Ceiling Stalactite Ripper slamming meteors down!)
          (when (and (> storm-str 0.68f) (= (Int.mod (+ fc (* bi 7)) rip-per) 0))
            (let [ra (* (Float.from-int (+ (* fc 17) bi)) 1.91f)
                  rca (WandSystem.fcos ra)
                  rsa (WandSystem.fsin ra)
                  urip (* 0.20f (Float.from-int (Int.mod (+ (* fc 5) bi) 6)))
                  rr (* (+ 1.35f (* 3.15f urip)) m-sc)
                  y-off (* (- (* 0.50f (Float.from-int (Int.mod (+ fc bi) 3))) 0.50f) m-sc)
                  rxp (+ px (* rca rr))
                  rzp (+ pz (* rsa rr))]
              (if (> inv 0)
                (let [cyp (+ (+ py (* 2.85f m-sc)) y-off)
                      cvec (Vector3.init (Double.from-float rxp) (Double.from-float cyp) (Double.from-float rzp))
                      csdf (Physics.sample-sdf-trilinear world &cvec)
                      fyp (+ (- py (* 1.65f m-sc)) y-off)
                      fvec (Vector3.init (Double.from-float rxp) (Double.from-float fyp) (Double.from-float rzp))
                      fsdf (Physics.sample-sdf-trilinear world &fvec)
                      use-ceil? (and (<= csdf 0.65f) (> csdf -900.0f))
                      ryp (if use-ceil? cyp fyp)
                      rvec (if use-ceil? cvec fvec)
                      rsdf (if use-ceil? csdf fsdf)]
                  (when (and (<= rsdf 0.65f) (> rsdf -900.0f))
                    (let [near-m (CritterSystem.sample-solid-mat-near world &rvec)
                          cmat (if (and (>= near-m 1.0f) (< near-m 250.0f)) near-m 1.0f)
                          crad (* 0.88f m-sc)
                          bspawn (Vector3.init (Double.from-float rxp)
                                               (Double.from-float (if use-ceil? (- ryp 0.85f) (+ ryp 1.85f)))
                                               (Double.from-float rzp))
                          bvel (Vector3.init (Double.from-float (* (- 0.0f rsa) 12.5f))
                                             (* -26.0 (Double.from-float inv-m))
                                             (Double.from-float (* rca 12.5f)))]
                      (do
                        (EngineState.push-voxel-action! state rxp ryp rzp crad cmat -1.0f 0.0f)
                        (MancerSystem.edit-bender-sdf! world &rvec (Double.from-float crad) cmat true)
                        (ParticleSystem.emit-dust! ps rxp ryp rzp 12)
                        (ignore (EditingSystem.spawn-boulder! state bspawn bvel (Double.from-float (* 0.46f m-sc)) cmat 11000l))))))
                (let [ryp (+ (- py (* 1.55f m-sc)) y-off)
                      rvec (Vector3.init (Double.from-float rxp) (Double.from-float ryp) (Double.from-float rzp))
                      rsdf (Physics.sample-sdf-trilinear world &rvec)]
                  (when (and (<= rsdf 0.52f) (> rsdf -900.0f))
                    (let [near-m (CritterSystem.sample-solid-mat-near world &rvec)
                          cmat (if (and (>= near-m 1.0f) (< near-m 250.0f)) near-m 1.0f)
                          crad (* 0.86f m-sc)
                          bspawn (Vector3.init (Double.from-float rxp) (Double.from-float (+ ryp 0.85f)) (Double.from-float rzp))
                          bvel (Vector3.init (Double.from-float (* (* rsa 21.5f) imp-wmul))
                                             6.4
                                             (Double.from-float (* (* (- 0.0f rca) 21.5f) imp-wmul)))]
                      (do
                        (EngineState.push-voxel-action! state rxp ryp rzp crad cmat -1.0f 0.0f)
                        (MancerSystem.edit-bender-sdf! world &rvec (Double.from-float crad) cmat true)
                        (ParticleSystem.emit-dust! ps rxp (+ ryp 0.35f) rzp 10)
                        (ignore (EditingSystem.spawn-boulder! state bspawn bvel (Double.from-float (* 0.44f m-sc)) cmat 9500l)))))))))

          ;; 4. Wide Hurricane Eye-Wall Shred & Elemental Reaction Pulse
          (when (and (> storm-str 0.62f) (= (Int.mod (+ fc bi) 8) 0))
            (let [pay-m (WandSystem.get-coupled-payload wid bmat biw bim)
                  etag @(SpellPayload.elem-tag &pay-m)
                  srad (* 5.65f m-sc)
                  sdmg (* bdmg 0.25f)
                  ydir (if (> inv 0) -1.0f 1.0f)]
              (do
                (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
                  px (- py 0.35f) pz 0.0f ydir 0.0f 0.0f srad etag wid bmat sdmg)
                (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
                  px (+ py (* 2.25f m-sc)) pz 0.0f ydir 0.0f 0.0f (* srad 1.12f) etag wid bmat (* sdmg 0.85f))
                (when has-dual?
                  (let [ietag (WandSystem.mat-elem-tag bim biw)]
                    (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
                      px (+ py (* 1.05f m-sc)) pz 0.0f ydir 0.0f 0.0f srad ietag biw bim (* sdmg 0.68f)))))))

          ;; Peel ceiling/wall-clinging Slimes inside Gravity Anvil so they slam into the floor too!
          (when (and (> inv 0) (= (Int.mod (+ fc bi) 6) 0))
            (let [cbank (EngineState.critters state)
                  a-alive (CritterBank.alive cbank)
                  a-idx (CritterBank.idx cbank)
                  a-gen (CritterBank.gen cbank)
                  a-state (CritterBank.state cbank)
                  dpx0 (Double.from-float px)
                  dpy0 (Double.from-float py)
                  dpz0 (Double.from-float pz)
                  r-peel (* 11.5 (Double.from-float m-sc))]
              (for [ak 0 16]
                (when @(Array.unsafe-nth a-alive ak)
                  (let [aent (ECS.Entity.init (Handle.init @(Array.unsafe-nth a-idx ak) @(Array.unsafe-nth a-gen ak)))
                        acb-opt (the (Maybe CompBody) (get-component ecs &aent))]
                    (match acb-opt
                      (Maybe.Nothing) ()
                      (Maybe.Just acb)
                        (let [arb (CompBody.rb &acb)
                              apos @(RigidBody.position arb)
                              adx (- @(Vector3.x &apos) dpx0)
                              ady (- @(Vector3.y &apos) dpy0)
                              adz (- @(Vector3.z &apos) dpz0)]
                          (when (< (Double.sqrt (+ (+ (* adx adx) (* ady ady)) (* adz adz))) r-peel)
                            (let [ab (RigidBody.body arb)]
                              (do
                                (when (< @(Array.unsafe-nth a-state ak) 3)
                                  (Array.aset! a-state ak 4))
                                (Body.set-body-type! ab (BodyType.Dynamic))
                                (Body.set-inv-mass! ab 1.0)
                                (Body.set-inv-inertia! ab 4.0)
                                (RigidBody.set-body! arb @ab)
                                (ECS.add-component! ecs &aent (CompBody.init @arb))))))))))))

          ;; 5. 15-Meter RigidBody Cyclone — OR `🔄 Invert` GRAVITY ANVIL smashing all bodies into the floor at -28 m/s!
          (let [dpx (Double.from-float px)
                dpy (Double.from-float py)
                dpz (Double.from-float pz)
                msc-d (Double.from-float m-sc)
                sstr-d (Double.from-float storm-str)
                imp-d (Double.from-float imp-wmul)
                invm-d (Double.from-float inv-m)
                r-pull (* 15.2 msc-d)
                h-max (* (if (> inv 0) 9.2 6.8) msc-d)
                k-bl (Physics.clamp 0.0 0.52 (Double.from-float (* (* (if (> inv 0) 9.5f 6.8f) storm-str) fdt)))]
            (query ecs (e (cb CompBody))
              (let [eidx (ECS.Entity.index &e)
                    eid (Long.to-int (Uint64.to-long eidx))]
                (when (/= eid player-id)
                  (let [rb (CompBody.rb cb)
                        b (RigidBody.body rb)]
                    (when (> @(Body.inv-mass b) 0.0)
                      (let [epos @(RigidBody.position rb)
                            rx (- @(Vector3.x &epos) dpx)
                            ry (- @(Vector3.y &epos) (- dpy (* 0.95 msc-d)))
                            rz (- @(Vector3.z &epos) dpz)
                            rh (Double.sqrt (+ (* rx rx) (* rz rz)))]
                        (when (and (< rh r-pull) (and (> ry (* -4.0 msc-d)) (< ry h-max)))
                          (let [invh (if (> rh 0.08) (/ 1.0 rh) 0.0)
                                urx (if (> rh 0.08) (* rx invh) 1.0)
                                urz (if (> rh 0.08) (* rz invh) 0.0)
                                utx (if (> inv 0) (- 0.0 urz) urz)
                                utz (if (> inv 0) urx (- 0.0 urx))
                                lane-u (* 0.25 (Double.from-int (Int.mod (Int.abs eid) 5)))
                                bob (Double.from-float (WandSystem.fsin (+ (* (Float.from-int fc) 0.11f) (Float.from-int eid))))
                                rorb (* (+ 2.30 (* 2.75 lane-u)) msc-d)
                                target-ry (* (+ 0.65 (+ (* 1.90 lane-u) (* 0.65 bob))) msc-d)
                                vtan (* (* (+ 22.5 (* 6.5 (- 1.0 (/ rh r-pull)))) sstr-d)
                                        (* imp-d (if (> inv 0) 0.45 1.0)))
                                vrad (if (> inv 0)
                                       (* -11.5 (- 1.0 (* 0.5 (/ rh r-pull))))
                                       (if (> rh rorb)
                                         (* -15.5 (Physics.clamp 0.22 1.95 (/ (- rh rorb) 3.4)))
                                         (* 8.2 (- 1.0 (/ rh (if (> rorb 0.2) rorb 0.2))))))
                                vup (if (> inv 0)
                                      (* (* -28.0 invm-d) imp-d)
                                      (Physics.clamp -8.5 12.0 (* (- target-ry ry) 4.8)))
                                tvx (+ (* utx vtan) (* urx vrad))
                                tvz (+ (* utz vtan) (* urz vrad))
                                old-v @(Body.velocity b)
                                nv (Vector3.init
                                     (+ @(Vector3.x &old-v) (* (- tvx @(Vector3.x &old-v)) k-bl))
                                     (+ @(Vector3.y &old-v) (* (- vup @(Vector3.y &old-v)) k-bl))
                                     (+ @(Vector3.z &old-v) (* (- tvz @(Vector3.z &old-v)) k-bl)))]
                            (do
                              (when (> inv 0)
                                (let [hslot (EnemySystem.hopper-slot-by-idx state eidx)]
                                  (when (>= hslot 0)
                                    (Array.aset! (EnemyBank.hurt-cd (EngineState.enemies state)) hslot 0.18f))))
                              (Body.set-is-sleeping! b false)
                              (Body.set-velocity! b nv)
                              (RigidBody.set-body! rb @b)
                              (ECS.add-component! ecs &e (CompBody.init @rb))))))))))))))
        (Pair.init frame-blinks frame-expls))))


  ;; [105] Starburst THE BIG SUCC (`bsty == 7`, `rem-life <= 0.44s`) — or `🔄 Invert` THE BIG BLOW!
  (defn step-starburst-succ! [state ecs ps px py pz brad rem-life inv inv-m trail-ptype player-id fc bi fdt]
    (let [m-sc (Float.clamp 0.85f 1.95f (/ brad 0.32f))
          succ-prog (Float.clamp 0.0f 1.0f (/ (- 0.44f rem-life) 0.44f))
          succ-str (+ 0.68f (* 0.88f succ-prog))
          spol (if (> inv 0) (- 0.0f inv-m) 1.0f)
          shell-r (if (> inv 0)
                    (* (+ 0.65f (* 3.20f succ-prog)) m-sc)
                    (* (- 3.85f (* 2.05f succ-prog)) m-sc))]
      (do
        (EngineState.push-wake-capsule! state
          px (- py 1.25f) pz px (+ py 1.25f) pz
          (* 10.6f m-sc) (* (* -9.8f succ-str) spol) 0.0f (* 1.35f succ-str) 0.0f (* (* -5.8f succ-str) spol))
        (for [si 0 4]
          (let [sa (+ (* (Float.from-int (+ (* fc 11) bi)) 0.37f) (* (Float.from-int si) 1.5707963f))
                sy-off (* (WandSystem.fsin (+ sa (* (Float.from-int fc) 0.23f))) (* 1.35f m-sc))
                sdx (WandSystem.fcos sa)
                sdz (WandSystem.fsin sa)
                sx-p (+ px (* sdx shell-r))
                sy-p (+ py sy-off)
                sz-p (+ pz (* sdz shell-r))
                in-spd (* (+ 16.5f (* 8.5f succ-prog)) (if (> inv 0) -1.0f 1.0f))]
            (ParticleSystem.emit! ps sx-p sy-p sz-p
              (* (- 0.0f sdx) in-spd) (* (- 0.0f sy-off) (if (> inv 0) -5.5f 5.5f)) (* (- 0.0f sdz) in-spd)
              0.28f 1 (if (= (Int.mod (+ fc si) 2) 0) PARTICLE-TYPE-MAGIC trail-ptype) 0.36f 0.16f)))
        (let [dpx (Double.from-float px)
              dpy (Double.from-float (+ py 0.15f))
              dpz (Double.from-float pz)
              r-succ (* 12.2 (Double.from-float m-sc))
              raw-acc (* (+ 38.0 (* 30.0 (Double.from-float succ-prog))) (Double.from-float fdt))
              pull-acc (* raw-acc (Double.from-float spol))
              damp-v (Double.from-float (/ 1.0f (+ 1.0f (* 3.6f fdt))))]
          (query ecs (e (cb CompBody))
            (let [eid (Long.to-int (Uint64.to-long (ECS.Entity.index &e)))]
              (when (/= eid player-id)
                (let [rb (CompBody.rb cb)
                      b (RigidBody.body rb)]
                  (when (> @(Body.inv-mass b) 0.0)
                    (let [epos @(RigidBody.position rb)
                          gx (- dpx @(Vector3.x &epos))
                          gy (- dpy @(Vector3.y &epos))
                          gz (- dpz @(Vector3.z &epos))
                          gd (Double.sqrt (+ (+ (* gx gx) (* gy gy)) (* gz gz)))]
                      (when (and (> gd 0.22) (< gd r-succ))
                        (let [inv-g (/ pull-acc gd)
                              old-v @(Body.velocity b)
                              nv (Vector3.init
                                   (+ (* @(Vector3.x &old-v) damp-v) (* gx inv-g))
                                   (+ (* @(Vector3.y &old-v) damp-v) (+ (* gy inv-g) (* 0.22 raw-acc)))
                                   (+ (* @(Vector3.z &old-v) damp-v) (* gz inv-g)))]
                          (do
                            (Body.set-is-sleeping! b false)
                            (Body.set-velocity! b nv)
                            (RigidBody.set-body! rb @b)
                            (ECS.add-component! ecs &e (CompBody.init @rb)))))))))))))))


  ;; [106] Phase-Wave Crest (`bsty == 8`): Morphs into Seismic Wave (Solid), Tidal Breaker (Liquid), or Plume (Gas/Dry)!
  ;; Returns `(Pair brad frame-blinks)`.
  (defn step-bolt-phase-wave! [state world ps ecs px py pz vx vy vz
                               wid bmat biw bim base-rad brad-in bspl fxp inv-m imp-m new-t
                               trail-ptype player-id frame-blinks-in fc bi fdt]
    (let [blk (WandSystem.fx-blk fxp)
          inv (WandSystem.fx-inv fxp)
          imp (WandSystem.fx-imp fxp)
          pls (WandSystem.fx-pls fxp)
          brad brad-in
          frame-blinks frame-blinks-in]
      (do
      (let [wi (Int.mod (WandSystem.clamp-int 0 999 bspl) 10)
            wave-hvy? (>= bspl 110)
            w-sol? (and (> bmat 0.5f) (< bmat 255.5f))
            w-liq? (and (> bmat 0.5f) (< bmat 511.5f))
            has-dual? (and (>= biw 0) (> bim 0.5f))
            imp-w (if (> imp 0) (+ 1.0f (* 1.85f imp-m)) 1.0f)
            wpol-c (if (> inv 0) (- 0.0f inv-m) 1.0f)
            vspd (Float.sqrt (+ (+ (* vx vx) (* vy vy)) (* vz vz)))
            vinv (if (> vspd 0.05f) (/ 1.0f vspd) 1.0f)
            ux (* vx vinv)
            uy (* vy vinv)
            uz (* vz vinv)
            hspd (Float.sqrt (+ (* vx vx) (* vz vz)))
            hinv (if (> hspd 0.05f) (/ 1.0f hspd) 1.0f)
            rx-w (if (> hspd 0.05f) (* (- 0.0f vz) hinv) 1.0f)
            rz-w (if (> hspd 0.05f) (* vx hinv) 0.0f)
            wing (Float.clamp 1.45f 3.15f (+ 1.35f (* new-t 2.35f)))
            wcx (+ px (* ux 0.72f))
            wcy (+ (+ py (* uy 0.72f)) (if (or w-sol? w-liq?) 0.48f 0.0f))
            wcz (+ pz (* uz 0.72f))]
        (do
          ;; Gas / Dry Plume swells smoothly in radius as the cone expands downrange!
          (when (and (not w-sol?) (and (not w-liq?) (= pls 0)))
            (set! brad (Float.clamp 0.12f 4.20f (* base-rad (+ 1.0f (* 1.45f new-t))))))
          ;; `⚡ Blink` (`39`) on Center Crest (`wi == 3`): surf right on the nose of your own Phase-Wave!
          (when (and (> blk 0) (and (= wi 3) (and (< frame-blinks 2) (= (Int.mod fc 4) 0))))
            (do
              (WandSystem.blink-with-polarity! state world ps ecs
                px (+ py 0.45f) pz (- 0.0f ux) 0.25f (- 0.0f uz) inv)
              (set! frame-blinks (+ frame-blinks 1))))

          ;; EVERY-FRAME Zero-Backwash Laminar Plough-Wake (`radial-push = 0.0f` prevents back-half cancellation!)
          (if w-sol?
            (EngineState.push-wake-capsule! state
              (- wcx (* rx-w wing)) wcy (- wcz (* rz-w wing))
              (+ wcx (* rx-w wing)) wcy (+ wcz (* rz-w wing))
              4.95f 0.0f
              (* (* ux 25.0f) imp-w) (* (+ (* uy 20.0f) 13.5f) imp-w) (* (* uz 25.0f) imp-w)
              (* 3.35f wpol-c))
            (if w-liq?
              (EngineState.push-wake-capsule! state
                (- wcx (* rx-w wing)) wcy (- wcz (* rz-w wing))
                (+ wcx (* rx-w wing)) wcy (+ wcz (* rz-w wing))
                5.45f 0.0f
                (* (* ux 31.0f) imp-w) (* (+ (* uy 28.0f) 7.5f) imp-w) (* (* uz 31.0f) imp-w)
                (* 3.50f wpol-c))
              (EngineState.push-wake-capsule! state
                (- wcx (* rx-w wing)) wcy (- wcz (* rz-w wing))
                (+ wcx (* rx-w wing)) wcy (+ wcz (* rz-w wing))
                (Float.clamp 5.35f 7.15f (+ 5.25f (* new-t 2.65f))) 0.0f
                (* (* ux 35.0f) imp-w) (* (+ (* uy 35.0f) 3.6f) imp-w) (* (* uz 35.0f) imp-w)
                (* 3.65f wpol-c))))

          ;; Swept RigidBody Wave-Carry (Center Crest `wi == 3` carries boulders, Slimes & Hoppers with the surge!)
          (when (and (= wi 3) (= (Int.mod fc 2) 0))
            (let [dwx (Double.from-float wcx)
                  dwy (Double.from-float wcy)
                  dwz (Double.from-float wcz)
                  r-carry (Double.from-float (+ 4.25f (* new-t 3.2f)))
                  c-push (* (Double.from-float (* (if w-sol? 18.0f (if w-liq? 21.0f 23.0f)) imp-w))
                            (Double.from-float fdt))
                  eb (EngineState.enemies state)
                  h-hurt (EnemyBank.hurt-cd eb)
                  h-pspd (EnemyBank.prev-spd eb)]
              (query ecs (e (cb CompBody))
                (let [e-idx (ECS.Entity.index &e)
                      eid (Long.to-int (Uint64.to-long e-idx))]
                  (when (/= eid player-id)
                    (let [rb (CompBody.rb cb)
                          b (RigidBody.body rb)]
                      (when (> @(Body.inv-mass b) 0.0)
                        (let [epos @(RigidBody.position rb)
                              ex (- @(Vector3.x &epos) dwx)
                              ey (- @(Vector3.y &epos) dwy)
                              ez (- @(Vector3.z &epos) dwz)
                              ed (Double.sqrt (+ (+ (* ex ex) (* ey ey)) (* ez ez)))]
                          (when (< ed r-carry)
                            (let [old-v @(Body.velocity b)
                                  up-k (if w-sol? 0.55 (if w-liq? 0.32 0.18))
                                  nv (Vector3.init
                                       (Physics.clamp -42.0 42.0 (+ @(Vector3.x &old-v) (* (Double.from-float ux) c-push)))
                                       (Physics.clamp -32.0 34.0 (+ @(Vector3.y &old-v) (* (+ (Double.from-float uy) up-k) c-push)))
                                       (Physics.clamp -42.0 42.0 (+ @(Vector3.z &old-v) (* (Double.from-float uz) c-push))))
                                  hslot (EnemySystem.hopper-slot-by-idx state e-idx)]
                              (do
                                (when (and (>= hslot 0) (< @(Array.unsafe-nth h-hurt hslot) 0.18f))
                                  (do
                                    (Array.aset! h-hurt hslot 0.18f)
                                    (Array.aset! h-pspd hslot (Double.to-float (Vector3.mag &nv)))))
                                (Body.set-is-sleeping! b false)
                                (Body.set-velocity! b nv)
                                (RigidBody.set-body! rb @b)
                                (ECS.add-component! ecs &e (CompBody.init @rb)))))))))))))

          ;; Strided CA Reagent Deposition, Dust, & Tumbling Earthbender Boulders
          (when (= (Int.mod (+ fc bi) 3) 0)
            (if w-sol?
              ;; SOLID -> SEISMIC WAVE: rolling ground dust, granular/reactive ridge, & tumbling Earthbender boulders!
              (let [fvec (Vector3.init (Double.from-float px) (Double.from-float (- py 0.65f)) (Double.from-float pz))
                    ds (Physics.sample-sdf-trilinear world &fvec)]
                (when (and (< ds 1.35f) (> ds -900.0f))
                  (do
                    (ParticleSystem.emit-dust! ps px py pz 5)
                    (if (or (Materials.granular? bmat) (WandSystem.reactive-solid? bmat))
                      (WandSystem.inject-gpu-reagent! state px (+ py 0.32f) pz
                        (Float.clamp 1.05f 2.25f (* brad 3.2f)) (- 0.0f bmat) 0.86f)
                      (when (and (= (Int.mod wi 2) 1) (= (Int.mod (+ fc (* wi 3)) 9) 0))
                        (let [bpos (Vector3.init (Double.from-float px)
                                                 (Double.from-float (+ py 0.42f))
                                                 (Double.from-float pz))
                              bvel (Vector3.init (Double.from-float (* vx 0.44f))
                                                 8.4
                                                 (Double.from-float (* vz 0.44f)))
                              b-r (* (if wave-hvy? 0.46f 0.35f) (Float.clamp 0.85f 1.45f (/ brad 0.42f)))]
                          (ignore (EditingSystem.spawn-boulder! state bpos bvel (Double.from-float b-r) bmat 7500l)))))
                    (when (and has-dual? (> bim 255.0f))
                      (WandSystem.inject-gpu-reagent! state px (+ py 0.35f) pz
                        (Float.clamp 1.05f 2.15f (* brad 3.0f)) bim 0.62f)))))
              (if w-liq?
                ;; LIQUID -> TIDAL BREAKER: foaming wall of CA fluid + curling tsunami surf!
                (do
                  (WandSystem.inject-gpu-reagent! state px (+ py 0.24f) pz
                    (Float.clamp 1.25f 2.65f (* brad 3.6f)) bmat 0.78f)
                  (when has-dual?
                    (if (> bim 255.0f)
                      (WandSystem.inject-gpu-reagent! state px (+ py 0.32f) pz
                        (Float.clamp 1.15f 2.40f (* brad 3.3f)) bim 0.66f)
                      (when (or (Materials.granular? bim) (WandSystem.reactive-solid? bim))
                        (WandSystem.inject-gpu-reagent! state px (+ py 0.32f) pz
                          (Float.clamp 1.00f 2.05f (* brad 2.8f)) (- 0.0f bim) 0.82f))))
                  (ParticleSystem.emit! ps px (+ py 0.25f) pz (* vx 0.22f) 3.2f (* vz 0.22f)
                    1.15f 4 trail-ptype 0.32f 0.14f))
                ;; GAS / DRY -> PYROCLASTIC / ARCANE PLUME: expanding volumetric cone + roaring gust!
                (do
                  (when (> bmat 511.5f)
                    (WandSystem.inject-gpu-reagent! state px py pz
                      (Float.clamp 1.50f 3.10f (* brad 3.9f)) bmat 0.82f))
                  (when (and has-dual? (> bim 255.0f))
                    (WandSystem.inject-gpu-reagent! state px py pz
                      (Float.clamp 1.35f 2.85f (* brad 3.6f)) bim 0.70f))
                  (ParticleSystem.emit! ps px py pz (* vx 0.25f) (+ (* vy 0.25f) 1.8f) (* vz 0.25f)
                    1.55f 5 (if (> bmat 0.5f) trail-ptype PARTICLE-TYPE-MAGIC) 0.36f 0.16f)))))))
        (Pair.init brad frame-blinks))))


  ;; [107] Ophanim Gyro-Mill (`bsty == 9`): +/-45 deg Counter-Rotating Concrete-Saw Blender + Boulder & Orb Cuisinart!
  ;; Returns `(Pair (Vector3 vx vy vz) frame-blinks)`.
  (defn step-bolt-ophanim! [state world ps ecs px py pz vx-in vy-in vz-in
                            wid bmat biw bim brad base-dmg bdmg bblast bhom bounces pierce bspl
                            fxp raw-stk eff-stk inv-m imp-m stuck new-t player-id frame-blinks-in fc bi fdt]
    (let [trl (WandSystem.fx-trl fxp)
          hvr (WandSystem.fx-hvr fxp)
          bmg (WandSystem.fx-bmg fxp)
          blk (WandSystem.fx-blk fxp)
          glt (WandSystem.fx-glt fxp)
          exp (WandSystem.fx-exp fxp)
          inv (WandSystem.fx-inv fxp)
          imp (WandSystem.fx-imp fxp)
          pls (WandSystem.fx-pls fxp)
          srg (WandSystem.fx-srg fxp)
          hlx (WandSystem.fx-hlx fxp)
          sin-m (WandSystem.fx-sin fxp)
          vx vx-in
          vy vy-in
          vz vz-in
          frame-blinks frame-blinks-in]
      (do
      (let [m-sc (Float.clamp 0.85f 2.35f (/ brad 0.96f))
            o-hvy? (>= bspl 110)
            has-dual? (and (>= biw 0) (> bim 0.5f))
            imp-w (if (> imp 0) (+ 1.0f (* 0.95f imp-m)) 1.0f)
            psi (+ (* (Float.from-int fc) 0.045f) (* (Float.from-int bi) 1.17f))
            hx-a (WandSystem.fcos psi)
            hz-a (WandSystem.fsin psi)
            px-a (- 0.0f hz-a)
            pz-a hx-a
            v1x (* px-a 0.7071068f)
            v1y 0.7071068f
            v1z (* pz-a 0.7071068f)
            v2x v1x
            v2y -0.7071068f
            v2z v1z
            ring-r (* 3.15f m-sc)
            th1 (+ (* (Float.from-int fc) 0.92f) (Float.from-int bi))
            c1 (WandSystem.fcos th1)
            s1 (WandSystem.fsin th1)
            d1x (* ring-r (+ (* hx-a c1) (* v1x s1)))
            d1y (* ring-r (* v1y s1))
            d1z (* ring-r (+ (* hz-a c1) (* v1z s1)))
            p1x (+ px d1x)
            p1y (+ py d1y)
            p1z (+ pz d1z)
            n1x (- px d1x)
            n1y (- py d1y)
            n1z (- pz d1z)
            t1x (+ (* (- 0.0f hx-a) s1) (* v1x c1))
            t1y (* v1y c1)
            t1z (+ (* (- 0.0f hz-a) s1) (* v1z c1))
            d2x (* ring-r (- (* hx-a c1) (* v2x s1)))
            d2y (* ring-r (* (- 0.0f v2y) s1))
            d2z (* ring-r (- (* hz-a c1) (* v2z s1)))
            p2x (+ px d2x)
            p2y (+ py d2y)
            p2z (+ pz d2z)
            n2x (- px d2x)
            n2y (- py d2y)
            n2z (- pz d2z)
            t2x (- (* (- 0.0f hx-a) s1) (* v2x c1))
            t2y (* (- 0.0f v2y) c1)
            t2z (- (* (- 0.0f hz-a) s1) (* v2z c1))
            sh-fx (WandSystem.pack-fx-mods
                    (if (> trl 0) 1 0) 0 0 0 (if (> glt 0) 1 0) (if (> exp 0) 1 0)
                    inv imp pls srg hlx sin-m
                    (if (and (> inv 0) (= raw-stk 3)) 3 (if (>= eff-stk 2) 1 0)))]
        (do
          ;; Smooth focal air-brake (~6.2m out) unless bank-bouncing or Boomerang-worn!
          (when (and (<= stuck 0) (and (= bmg 0) (> new-t 0.14f)))
            (let [min-s (if (> bounces 0) 18.5f 0.0f)
                  cspd (Float.sqrt (+ (+ (* vx vx) (* vy vy)) (* vz vz)))]
              (when (> cspd (+ min-s 0.4f))
                (let [bdamp (/ 1.0f (+ 1.0f (* (if (> hvr 0) 16.0f 8.8f) fdt)))]
                  (do
                    (set! vx (* vx bdamp))
                    (set! vy (* vy bdamp))
                    (set! vz (* vz bdamp)))))))

          ;; 1. EVERY-FRAME 19m Shear-Vortex Funnel + Full-Chord Counter-Rotating +/-45 deg Blade Wakes!
          (let [in-rpush (if (> inv 0) (* 11.2f inv-m) -8.8f)
                in-press (if (> inv 0) (* 7.4f inv-m) -6.0f)
                bl-rpush (if (> inv 0) (* 7.2f inv-m) -5.6f)
                bl-press (if (> inv 0) (* 4.8f inv-m) -3.9f)
                tslip (* (* 36.0f imp-w) (if (> inv 0) -1.0f 1.0f))]
            (do
              ;; Wide room-spanning intake funnel pulling fluids/fire/gas straight into the X-eye!
              (EngineState.push-wake-capsule! state
                px (- py (* 1.6f m-sc)) pz px (+ py (* 1.6f m-sc)) pz
                (* 9.8f m-sc) in-rpush 0.0f (if (> inv 0) -3.2f 2.8f) 0.0f in-press)
              ;; Plane A (+45 deg CW) vs Plane B (-45 deg CCW) full-diameter shear strokes!
              (EngineState.push-wake-capsule! state n1x n1y n1z p1x p1y p1z
                (* 3.65f m-sc) bl-rpush (* t1x tslip) (* t1y tslip) (* t1z tslip) bl-press)
              (EngineState.push-wake-capsule! state n2x n2y n2z p2x p2y p2z
                (* 3.65f m-sc) bl-rpush (* t2x tslip) (* t2y tslip) (* t2z tslip) bl-press)
              (ParticleSystem.emit-sparks! ps p1x p1y p1z t1x t1y t1z 3)
              (ParticleSystem.emit-sparks! ps p2x p2y p2z t2x t2y t2z 3)))

          ;; 2. High-Throughput Dual-Plane Alchemical Emulsifier (Tank 1 + Tank 2 folded into the X-eye!)
          (when (= (Int.mod (+ fc bi) 3) 0)
            (let [m2 (if has-dual? bim bmat)]
              (do
                (if (> bmat 255.0f)
                  (WandSystem.inject-gpu-reagent! state p1x p1y p1z (* 1.85f m-sc) bmat 0.76f)
                  (when (and (> bmat 0.5f) (or (Materials.granular? bmat) (WandSystem.reactive-solid? bmat)))
                    (WandSystem.inject-gpu-reagent! state p1x p1y p1z (* 1.45f m-sc) (- 0.0f bmat) 0.92f)))
                (if (> m2 255.0f)
                  (WandSystem.inject-gpu-reagent! state p2x p2y p2z (* 1.85f m-sc) m2 0.76f)
                  (when (and (> m2 0.5f) (or (Materials.granular? m2) (WandSystem.reactive-solid? m2)))
                    (WandSystem.inject-gpu-reagent! state p2x p2y p2z (* 1.45f m-sc) (- 0.0f m2) 0.92f)))
                (when (and has-dual? (> bmat 255.0f))
                  (WandSystem.inject-gpu-reagent! state px py pz (* 1.65f m-sc) bmat 0.65f)))))

          ;; 3. Relentless Ricocheting X-Plane Razor-Tooth Barrage (every 4 frames = 30 razor bolts/sec!)
          (when (= (Int.mod (+ fc bi) 4) 0)
            (let [m2 (if has-dual? bim bmat)
                  w2 (if has-dual? biw wid)
                  sub-r (Float.clamp 0.16f 0.48f (* brad 0.25f))
                  sub-bnc (+ 2 (if (> bounces 0) 2 0))
                  sub-prc (+ 2 pierce)]
              (if (> inv 0)
                (do
                  (WandSystem.spawn-bolt-fx! state p1x p1y p1z
                    (* (+ (* t1x 0.82f) (* (/ d1x ring-r) 0.58f)) 56.0f)
                    (* (+ (* t1y 0.82f) (* (/ d1y ring-r) 0.58f)) 56.0f)
                    (* (+ (* t1z 0.82f) (* (/ d1z ring-r) 0.58f)) 56.0f)
                    wid bmat -1 0.0f sub-r 1.2f 0.68f sub-bnc sub-prc
                    0 2 0 (* base-dmg 0.76f) (* bblast 0.80f) bhom sh-fx)
                  (WandSystem.spawn-bolt-fx! state p2x p2y p2z
                    (* (+ (* t2x 0.82f) (* (/ d2x ring-r) 0.58f)) 56.0f)
                    (* (+ (* t2y 0.82f) (* (/ d2y ring-r) 0.58f)) 56.0f)
                    (* (+ (* t2z 0.82f) (* (/ d2z ring-r) 0.58f)) 56.0f)
                    w2 m2 -1 0.0f sub-r 1.2f 0.68f sub-bnc sub-prc
                    0 2 0 (* base-dmg 0.76f) (* bblast 0.80f) bhom sh-fx))
                (do
                  ;; Cross-cutting razor teeth slicing through the X-eye and ricocheting across the room!
                  (WandSystem.spawn-bolt-fx! state p1x p1y p1z
                    (* (+ (* (- 0.0f (/ d1x ring-r)) 0.78f) (* t1x 0.62f)) 48.0f)
                    (* (+ (* (- 0.0f (/ d1y ring-r)) 0.78f) (* t1y 0.62f)) 48.0f)
                    (* (+ (* (- 0.0f (/ d1z ring-r)) 0.78f) (* t1z 0.62f)) 48.0f)
                    wid bmat -1 0.0f sub-r 0.6f 0.58f sub-bnc sub-prc
                    0 2 0 (* base-dmg 0.72f) (* bblast 0.76f) bhom sh-fx)
                  (WandSystem.spawn-bolt-fx! state p2x p2y p2z
                    (* (+ (* (- 0.0f (/ d2x ring-r)) 0.78f) (* t2x 0.62f)) 48.0f)
                    (* (+ (* (- 0.0f (/ d2y ring-r)) 0.78f) (* t2y 0.62f)) 48.0f)
                    (* (+ (* (- 0.0f (/ d2z ring-r)) 0.78f) (* t2z 0.62f)) 48.0f)
                    w2 m2 -1 0.0f sub-r 0.6f 0.58f sub-bnc sub-prc
                    0 2 0 (* base-dmg 0.72f) (* bblast 0.76f) bhom sh-fx)))))

          ;; 4. Ferocious 20-Hz Meat-Grinder Core (`every 3 frames` across `4.45m * m-sc`!) + `⚡ Blink` Eye-Snatch!
          (when (= (Int.mod (+ fc bi) 3) 0)
            (let [pay-o (WandSystem.get-coupled-payload wid bmat biw bim)
                  okb (if (> inv 0) (* 18.5f inv-m) -5.5f)
                  grind-r (* 4.45f m-sc)]
              (do
                (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
                  px py pz t1x t1y t1z okb grind-r @(SpellPayload.elem-tag &pay-o) wid bmat (* bdmg 0.88f))
                (when has-dual?
                  (let [ietag (WandSystem.mat-elem-tag bim biw)]
                    (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
                      px py pz t2x t2y t2z okb (* grind-r 0.92f) ietag biw bim (* bdmg 0.65f)))))))
          (when (and (> blk 0) (and (< frame-blinks 2) (= (Int.mod (+ fc bi) 5) 0)))
            (do
              (WandSystem.blink-with-polarity! state world ps ecs p1x p1y p1z t1x t1y t1z inv)
              (set! frame-blinks (+ frame-blinks 1))))

          ;; 5. Diamond Concrete-Saw Wall/Floor Biting (Base Spell scores stone into 6 supersonic shrapnel; `Heavy` strip-mines 10 shrapnel + boulders!)
          (when (= (Int.mod (+ fc (* bi 3)) (if o-hvy? 5 8)) 0)
            (let [use-b? (= (Int.mod (/ fc 4) 2) 1)
                  qx (if use-b? p2x p1x)
                  qy (if use-b? p2y p1y)
                  qz (if use-b? p2z p1z)
                  qtx (if use-b? t2x t1x)
                  qty (if use-b? t2y t1y)
                  qtz (if use-b? t2z t1z)
                  qv (Vector3.init (Double.from-float qx) (Double.from-float qy) (Double.from-float qz))
                  qd (Physics.sample-sdf-trilinear world &qv)]
              (when (and (<= qd (if o-hvy? 1.25f 0.88f)) (> qd -900.0f))
                (let [qmat-raw (CritterSystem.sample-solid-mat-near world &qv)
                      qmat (if (and (>= qmat-raw 1.0f) (< qmat-raw 250.0f)) qmat-raw 1.0f)
                      crad (* (if o-hvy? 1.48f 0.92f) m-sc)]
                  (do
                    (EngineState.push-voxel-action! state qx qy qz crad qmat -1.0f 0.0f)
                    (MancerSystem.edit-bender-sdf! world &qv (Double.from-float crad) qmat true)
                    (ParticleSystem.emit-dust! ps qx qy qz (if o-hvy? 14 8))
                    (ParticleSystem.emit-sparks! ps qx qy qz qtx qty qtz (if o-hvy? 22 14))
                    (WandSystem.ophanim-shred-burst! state ps qx qy qz hx-a hz-a v1x v1y v1z v2x v2y v2z
                      qmat (if o-hvy? 10 6) 68.0f (* base-dmg 0.82f) (* bblast 0.85f) sh-fx fc)
                    (when o-hvy?
                      (let [bspawn (Vector3.init (Double.from-float px) (Double.from-float (+ py 0.35f)) (Double.from-float pz))
                            bvel (Vector3.init (Double.from-float (* qtx 14.0f)) 4.5 (Double.from-float (* qtz 14.0f)))]
                        (ignore (EditingSystem.spawn-boulder! state bspawn bvel (Double.from-float (* 0.42f m-sc)) qmat 6500l)))))))))

          ;; 6. Mancer Halo-Orb Ripper & Shredder + Dual-Boulder Cuisinart!
          (WandSystem.step-ophanim-cuisinart! state world ps ecs px py pz m-sc inv inv-m imp-w
            hx-a hz-a v1x v1y v1z v2x v2y v2z t1x t1y t1z t2x t2y t2z
            (* base-dmg 1.15f) (* bblast 1.05f) sh-fx player-id fdt fc)))
        (Pair.init (Vector3.init (Double.from-float vx) (Double.from-float vy) (Double.from-float vz)) frame-blinks))))


  ;; [108] Supernova Solar Star (`10`) & Gargantua Black Hole (`11` with `🔄 Invert`)!
  ;; Returns `(Pair (Vector3 vx vy vz) (Pair (Vector3 brad bdmg 0) frame-blinks))`.
  (defn step-bolt-supernova! [state world ps ecs wb px py pz vx-in vy-in vz-in bsty
                              wid bmat biw bim base-rad brad-in base-dmg bdmg-in bblast bhom bounces pierce bspl
                              fxp inv-m imp-m stuck new-t rem-life player-id frame-blinks-in fc bi fdt]
    (let [b-brad0 (WandBelt.bolt-base-rad wb)
          b-dmg (WandBelt.bolt-dmg wb)
          trl (WandSystem.fx-trl fxp)
          hvr (WandSystem.fx-hvr fxp)
          bmg (WandSystem.fx-bmg fxp)
          blk (WandSystem.fx-blk fxp)
          glt (WandSystem.fx-glt fxp)
          exp (WandSystem.fx-exp fxp)
          inv (WandSystem.fx-inv fxp)
          imp (WandSystem.fx-imp fxp)
          pls (WandSystem.fx-pls fxp)
          srg (WandSystem.fx-srg fxp)
          hlx (WandSystem.fx-hlx fxp)
          sin-m (WandSystem.fx-sin fxp)
          vx vx-in
          vy vy-in
          vz vz-in
          brad brad-in
          bdmg bdmg-in
          frame-blinks frame-blinks-in]
      (do
      (let [is-bh? (= bsty 11)
            s-hvy? (>= bspl 110)
            has-dual? (and (>= biw 0) (> bim 0.5f))
            imp-w (if (> imp 0) (+ 1.0f (* 0.90f imp-m)) 1.0f)
            pinch? (<= rem-life 0.36f)
            grow-u (Float.clamp 0.0f 1.0f (/ new-t 3.85f))
            pinch-u (Float.clamp 0.0f 1.0f (/ rem-life 0.36f))
            swell (if pinch?
                    (+ 0.28f (* 3.45f (* pinch-u pinch-u)))
                    (+ 1.0f (* 3.05f grow-u)))
            m-sc (Float.clamp 0.85f 3.20f (/ (* base-rad swell) 1.08f))
            flr-fx (WandSystem.pack-fx-mods
                     (if (> trl 0) 1 0) 0 0 0 (if (> glt 0) 1 0) (if (> exp 0) 1 0)
                     inv imp pls srg hlx sin-m 0)]
        (do
          (when (= pls 0)
            (set! brad (Float.clamp 0.28f 6.50f (* base-rad swell))))
          (set! bdmg (* base-dmg (if pinch? 2.10f (+ 1.0f (* 0.85f grow-u)))))

          ;; Smooth focal air-brake (~6.5m out) + gentle solar floor-clearance rise!
          (when (and (<= stuck 0) (and (= bmg 0) (> new-t 0.14f)))
            (let [min-s (if (> bounces 0) 16.5f 0.0f)
                  cspd (Float.sqrt (+ (+ (* vx vx) (* vy vy)) (* vz vz)))]
              (do
                (when (> cspd (+ min-s 0.35f))
                  (let [bdamp (/ 1.0f (+ 1.0f (* (if (> hvr 0) 15.0f 7.8f) fdt)))]
                    (do
                      (set! vx (* vx bdamp))
                      (set! vy (* vy bdamp))
                      (set! vz (* vz bdamp)))))
                (when (and (not pinch?) (= bounces 0))
                  (let [fvec (Vector3.init (Double.from-float px) (Double.from-float (- py 1.6f)) (Double.from-float pz))
                        ds-f (Physics.sample-sdf-trilinear world &fvec)]
                    (when (and (< ds-f 2.25f) (> ds-f -900.0f))
                      (set! vy (+ vy (* 2.45f fdt)))))))))

          (if pinch?
            ;; FINAL 0.36s CORE-COLLAPSE PINCH: Cataclysmic inward vacuum gasp right before Supernova!
            (let [ang-p (+ (* (Float.from-int fc) 0.65f) (Float.from-int bi))
                  pdx (WandSystem.fcos ang-p)
                  pdz (WandSystem.fsin ang-p)
                  pr (* (+ 1.4f (* 3.6f pinch-u)) (Float.clamp 0.85f 1.85f base-rad))]
              (do
                (EngineState.push-wake-capsule! state
                  px (- py 1.8f) pz px (+ py 1.8f) pz
                  14.5f -14.5f 0.0f 1.2f 0.0f -3.75f)
                (ParticleSystem.emit! ps (+ px (* pdx pr)) py (+ pz (* pdz pr))
                  (* (- 0.0f pdx) 22.0f) 0.0f (* (- 0.0f pdz) 22.0f)
                  0.35f 3 PARTICLE-TYPE-MAGIC 0.42f 0.14f)))
            (if is-bh?
              ;; ACTIVE GARGANTUA BLACK HOLE (`bsty == 11`, `🔄 Invert`): Rankine Accretion Whirlpool + Spaghettification!
              (do
                (EngineState.push-wake-capsule! state
                  px (- py (* 1.8f brad)) pz px (+ py (* 1.8f brad)) pz
                  (- 0.0f (Float.clamp 8.5f 16.0f (+ 7.5f (* brad 1.85f))))
                  (* (* -11.5f inv-m) imp-w) 0.0f 0.8f 0.0f (* -3.65f inv-m))
                (when (= (Int.mod (+ fc bi) 2) 0)
                  (let [da (+ (* (Float.from-int fc) 0.48f) (Float.from-int bi))
                        dr (* brad 1.55f)
                        dcx (WandSystem.fcos da)
                        dsz (WandSystem.fsin da)]
                    (ParticleSystem.emit! ps (+ px (* dcx dr)) (+ py (* (* dsz dr) 0.25f)) (+ pz (* dsz dr))
                      (* (- 0.0f dsz) 18.0f) (* (- 0.0f dcx) 2.5f) (* dcx 18.0f)
                      0.42f 2 PARTICLE-TYPE-MAGIC 0.36f 0.16f)))
                (when (= (Int.mod (+ fc bi) 3) 0)
                  (let [pay-bh (WandSystem.get-coupled-payload wid bmat biw bim)
                        btag @(SpellPayload.elem-tag &pay-bh)
                        hor-r (+ (* brad 1.32f) 0.95f)]
                    (do
                      (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
                        px py pz 0.0f -1.0f 0.0f (* -9.5f inv-m) hor-r btag wid bmat (* bdmg 0.96f))
                      (when has-dual?
                        (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
                          px py pz 0.0f 1.0f 0.0f (* -7.5f inv-m) (* hor-r 0.92f) (WandSystem.mat-elem-tag bim biw) biw bim (* bdmg 0.68f))))))
                (when (= (Int.mod (+ fc bi) 5) 0)
                  (let [m2 (if has-dual? bim bmat)
                        ang-r (* (Float.from-int fc) 0.41f)
                        rx-r (+ px (* (* brad 1.25f) (WandSystem.fcos ang-r)))
                        rz-r (+ pz (* (* brad 1.25f) (WandSystem.fsin ang-r)))]
                    (do
                      (when (> bmat 255.0f)
                        (WandSystem.inject-gpu-reagent! state rx-r py rz-r (Float.clamp 1.15f 2.45f (* brad 0.55f)) bmat 0.68f))
                      (when (and has-dual? (> m2 255.0f))
                        (WandSystem.inject-gpu-reagent! state (- (* 2.0f px) rx-r) py (- (* 2.0f pz) rz-r)
                          (Float.clamp 1.15f 2.45f (* brad 0.55f)) m2 0.68f))))))
              ;; ACTIVE ROILING SOLAR STAR (`bsty == 10`): Expanding Photosphere Burn + Prominence Flares + Wall Melting!
              (let [ang-s (+ (* (Float.from-int fc) 0.52f) (Float.from-int bi))
                    sdx (WandSystem.fcos ang-s)
                    sdz (WandSystem.fsin ang-s)
                    sdy (* 0.55f (WandSystem.fsin (* (Float.from-int fc) 0.31f)))
                    limb-x (+ px (* sdx (* brad 0.92f)))
                    limb-y (+ py (* sdy (* brad 0.92f)))
                    limb-z (+ pz (* sdz (* brad 0.92f)))]
                (do
                  ;; 1. Outbound Solar Wind + Rising Thermal Plume
                  (when (= (Int.mod (+ fc bi) 2) 0)
                    (do
                      (EngineState.push-wake-capsule! state
                        px (- py (* brad 0.65f)) pz px (+ py (* brad 0.85f)) pz
                        (Float.clamp 4.8f 12.8f (+ 3.6f (* brad 2.15f)))
                        (* 4.4f imp-w) 0.0f (* 4.2f imp-w) 0.0f 2.65f)
                      (ParticleSystem.emit-sparks! ps limb-x limb-y limb-z sdx (+ sdy 0.35f) sdz 4)))

                  ;; 2. 20-Hz Searing Photosphere Burn (cooks everything inside the growing sun; dry Sun = Fire elem-tag 2!)
                  (when (= (Int.mod (+ fc bi) 3) 0)
                    (let [pay-s (WandSystem.get-coupled-payload wid bmat biw bim)
                          raw-tag @(SpellPayload.elem-tag &pay-s)
                          stag (if (and (<= bmat 0.5f) (= raw-tag 0)) 2 raw-tag)
                          cook-r (+ (* brad 1.45f) 0.95f)]
                      (do
                        (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
                          px py pz sdx 0.35f sdz -4.2f cook-r stag wid bmat (* bdmg 0.84f))
                        (when has-dual?
                          (WandSystem.apply-impact-forces-and-reactions-scaled! state world ps ecs
                            px py pz (- 0.0f sdx) 0.35f (- 0.0f sdz) -3.2f (* cook-r 0.92f)
                            (WandSystem.mat-elem-tag bim biw) biw bim (* bdmg 0.62f))))))

                  ;; 3. Solar Corona Alchemy, Whipping Prominence Flare Bolts, & Rock-Scorching Photosphere!
                  (when (= (Int.mod (+ fc bi) 6) 0)
                    (let [m2 (if has-dual? bim bmat)
                          w2 (if has-dual? biw wid)
                          use-2? (and has-dual? (= (Int.mod (/ fc 6) 2) 1))
                          fdrv (if use-2? w2 wid)
                          fmat (if use-2? m2 bmat)
                          fspd (+ 18.5f (* grow-u 8.5f))
                          qv (Vector3.init (Double.from-float limb-x) (Double.from-float limb-y) (Double.from-float limb-z))
                          qd (Physics.sample-sdf-trilinear world &qv)]
                      (do
                        (if (> bmat 255.0f)
                          (WandSystem.inject-gpu-reagent! state limb-x limb-y limb-z
                            (Float.clamp 1.35f 2.95f (* brad 0.68f)) bmat 0.78f)
                          (if (and (> bmat 0.5f) (or (Materials.granular? bmat) (WandSystem.reactive-solid? bmat)))
                            (WandSystem.inject-gpu-reagent! state limb-x limb-y limb-z
                              (Float.clamp 1.15f 2.35f (* brad 0.55f)) (- 0.0f bmat) 0.90f)
                            ;; Dry Sun sheds live GPU Fire plasma (`515.0f`) boiling water & igniting gas/oil on contact!
                            (WandSystem.inject-gpu-reagent! state limb-x limb-y limb-z
                              (Float.clamp 1.25f 2.65f (* brad 0.62f)) 515.0f 0.72f)))
                        (when (and has-dual? (> m2 255.0f))
                          (WandSystem.inject-gpu-reagent! state (- (* 2.0f px) limb-x) py (- (* 2.0f pz) limb-z)
                            (Float.clamp 1.30f 2.75f (* brad 0.62f)) m2 0.72f))
                        ;; Arcing Solar Prominence Flare Bolt leaping off the sun's limb!
                        (WandSystem.spawn-bolt-fx! state limb-x limb-y limb-z
                          (* sdx fspd) (+ (* sdy fspd) 9.5f) (* sdz fspd)
                          fdrv fmat -1 0.0f (Float.clamp 0.18f 0.46f (* brad 0.14f))
                          18.5f 0.56f (if (> bounces 0) 2 1) (if (> pierce 0) 2 1)
                          0 2 0 (* base-dmg 0.58f) (* bblast 0.68f) bhom flr-fx)
                        ;; Expanding sun scorches/melts stone walls touching its roiling photosphere!
                        (when (and (<= qd (if s-hvy? 1.15f 0.65f)) (> qd -900.0f))
                          (let [qmat-raw (CritterSystem.sample-solid-mat-near world &qv)
                                qmat (if (and (>= qmat-raw 1.0f) (< qmat-raw 250.0f)) qmat-raw 1.0f)
                                crad (Float.clamp 0.65f 2.25f (* brad (if s-hvy? 0.48f 0.30f)))]
                            (do
                              (EngineState.push-voxel-action! state limb-x limb-y limb-z crad qmat -1.0f 0.0f)
                              (MancerSystem.edit-bender-sdf! world &qv (Double.from-float crad) qmat true)
                              (ParticleSystem.emit-dust! ps limb-x limb-y limb-z 8)))))))))))

          ;; Shared Stellar / Black-Hole Gravity Well + Boulder & Mancer-Orb Feeding!
          (when (and (> blk 0) (and (< frame-blinks 2) (= (Int.mod (+ fc bi) 6) 0)))
            (do
              (WandSystem.blink-with-polarity! state world ps ecs px (+ py (* brad 0.65f)) pz 0.0f 1.0f 0.0f inv)
              (set! frame-blinks (+ frame-blinks 1))))
          (let [eaten (WandSystem.step-supernova-well! state world ps ecs px py pz brad is-bh? pinch? inv-m imp-w player-id fdt fc)]
            (when (> eaten 0)
              (let [next-b0 (Float.clamp 0.50f 2.45f (+ base-rad (* 0.15f (Float.from-int eaten))))
                    next-dm (+ base-dmg (* 0.24f (Float.from-int eaten)))]
                (do
                  (Array.aset! b-brad0 bi next-b0)
                  (Array.aset! b-dmg bi next-dm)))))))
        (Pair.init
          (Vector3.init (Double.from-float vx) (Double.from-float vy) (Double.from-float vz))
          (Pair.init (Vector3.init (Double.from-float brad) (Double.from-float bdmg) 0.0) frame-blinks)))))
)

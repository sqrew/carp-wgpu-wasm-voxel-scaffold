(defmodule SpawningSystem
  (defn update! [state win]
    (let [player (EngineState.player state)
          cam (Player.camera player)]
      (when (= (GLFW.get-key win GLFW.Keycode.R) GLFW.PRESS)
        (let [pos (Camera.pos cam)
              dir (Camera.front cam)
              vel (Vector3.mul dir 15.0)
              color (Vector3.init 0.8 0.2 0.2)
              ecs (EngineState.ecs-world state)
              e (GameWorld.create-entity! ecs)
              rb (RigidBody.new @pos (Quaternion.identity) 1.0 0.6 0.4 0.1 0.1 0.1)
              vol (Volume.Ball (Sphere.init @pos 0.5))]
          (do
            (Body.set-velocity! (RigidBody.body &rb) vel)
            (add-component! ecs &e (CompBody.init rb))
            (add-component! ecs &e (CompVolume.init vol))
            (add-component! ecs &e (CompColor.init color))
            (let [id-long (Uint64.to-long (ECS.Entity.index &e))
                  id-uint id-long]
              (do
                (let [_ (Coordinator.schedule! (EngineState.coord state) (AppEvent.DespawnEntity id-uint) 5000l)] ())
                ())))))))
)

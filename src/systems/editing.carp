(defmodule EditingSystem
  (defn jet-ptype [mat-id]
    (if (< mat-id 512.0f)
      (+ 100.0f (- mat-id 256.0f))
      (+ 200.0f (- mat-id 512.0f))))

  (defn succ-ptype [mat-id]
    (if (< mat-id 512.0f)
      (+ 300.0f (- mat-id 256.0f))
      (+ 308.0f (- mat-id 512.0f))))

  (defn apply-firehose-knockback! [state jet-x jet-y jet-z jet-w rd dt]
    (let [ecs (EngineState.ecs-world state)
          player-id @(EngineState.player-ent-id state)
          target-ei (if (>= jet-w 1.9f) (Float.round (- jet-w 2.0f)) -1)
          jx (Double.from-float jet-x)
          jy (Double.from-float jet-y)
          jz (Double.from-float jet-z)
          fx @(Vector3.x rd)
          fy @(Vector3.y rd)
          fz @(Vector3.z rd)
          curr-ei 0]
      (query ecs (e (cb CompBody) (cv CompVolume) (cc CompColor))
        (let [eid (Long.to-int (Uint64.to-long (ECS.Entity.index &e)))]
          (do
            (when (/= eid player-id)
              (let [rb (CompBody.rb cb)
                    pos (RigidBody.position rb)
                    dx (- @(Vector3.x pos) jx)
                    dy (- @(Vector3.y pos) jy)
                    dz (- @(Vector3.z pos) jz)
                    dist (Double.sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz)))
                    direct? (= curr-ei target-ei)]
                (when (or direct? (< dist 2.4))
                  (let [b (RigidBody.body rb)
                        old-v @(Body.velocity b)
                        strength (if direct? 56.0 (* 38.0 (- 1.0 (/ dist 2.6))))
                        lift (if direct? 11.5 7.5)
                        rx (if (> dist 0.15) (* (/ dx dist) 8.0) 0.0)
                        rz (if (> dist 0.15) (* (/ dz dist) 8.0) 0.0)
                        dv (Vector3.init (* (+ (* fx strength) rx) dt)
                                         (* (+ (* fy strength) lift) dt)
                                         (* (+ (* fz strength) rz) dt))
                        new-v (Vector3.add &old-v &dv)]
                    (do
                      (Body.set-velocity! b new-v)
                      (RigidBody.set-body! rb @b))))))
            (set! curr-ei (+ curr-ei 1)))))))

  (defn update! [state input dt]
    (let [world (EngineState.world state)
          player (EngineState.player state)
          ren (EngineState.renderer state)
          ps (EngineState.particles state)
          cam (Player.camera player)
          ro (Camera.pos cam)
          rd (Camera.front cam)
          right (Camera.right cam)
          up (Camera.up cam)
          hx (gpu-readback-get-hit-x)
          hy (gpu-readback-get-hit-y)
          hz (gpu-readback-get-hit-z)
          hw (gpu-readback-get-hit-w)
          left-pressed (InputManager.action-digital? input "click-left")
          right-pressed (InputManager.action-digital? input "click-right")
          f-held (InputManager.action-digital? input "edit-add")
          h-held (InputManager.action-digital? input "edit-remove")
          g-held (InputManager.action-digital? input "edit-paint")
          x-pressed (InputManager.action-digital? input "purge-flask")
          brush-mod (or f-held (or h-held g-held))
          hit-opt (if (> hw 0.5f) (Maybe.Just (Vector3.init (Double.from-float hx) (Double.from-float hy) (Double.from-float hz))) (Maybe.Nothing))]
      (do
        ;; Reset per-frame Flask GPU action defaults before deciding active verb
        (EngineState.set-flask-pr! state 0.0f)
        (EngineState.set-flask-ax! state 0.0f)
        (EngineState.set-flask-ay! state 0.0f)

        ;; 1. Sandbox Modifier Brushes (Hold F = Solid Carve/Build, H = Liquid Brush, G = Gas Brush)
        (if brush-mod
          (match hit-opt
            (Maybe.Nothing)
              (do
                (Pointer.set (ref-to-ptr (EngineState.hit-active state)) 0.0f)
                (Pointer.set (ref-to-ptr (EngineState.liquid-spawn state)) 0.0f)
                (Pointer.set (ref-to-ptr (EngineState.gas-spawn state)) 0.0f)
                (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) 0.0f))
            (Maybe.Just hit-pos)
              (let [yellow (Vector3.init 1.0 1.0 0.0)
                    vhx @(Vector3.x &hit-pos)
                    vhy @(Vector3.y &hit-pos)
                    vhz @(Vector3.z &hit-pos)]
                (do
                  (EngineState.draw-bounds-wireframe! ren (- vhx 0.5) (- vhy 0.5) (- vhz 0.5) (+ vhx 0.5) (+ vhy 0.5) (+ vhz 0.5) &yellow)
                  (Pointer.set (ref-to-ptr (EngineState.hit-x state)) (Double.to-float vhx))
                  (Pointer.set (ref-to-ptr (EngineState.hit-y state)) (Double.to-float vhy))
                  (Pointer.set (ref-to-ptr (EngineState.hit-z state)) (Double.to-float vhz))
                  (if (or left-pressed right-pressed)
                    (do
                      (Pointer.set (ref-to-ptr (EngineState.hit-active state)) 1.0f)
                      (if h-held
                        (Pointer.set (ref-to-ptr (EngineState.liquid-spawn state)) @(Player.current-liq player))
                        (Pointer.set (ref-to-ptr (EngineState.liquid-spawn state)) 0.0f))
                      (if g-held
                        (Pointer.set (ref-to-ptr (EngineState.gas-spawn state)) @(Player.current-gas player))
                        (Pointer.set (ref-to-ptr (EngineState.gas-spawn state)) 0.0f))
                      (if (and f-held left-pressed)
                        (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) 999.0f)
                        (if (and f-held right-pressed)
                          (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) @(Player.current-mat player))
                          (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) 0.0f))))
                    (do
                      (Pointer.set (ref-to-ptr (EngineState.hit-active state)) 0.0f)
                      (Pointer.set (ref-to-ptr (EngineState.liquid-spawn state)) 0.0f)
                      (Pointer.set (ref-to-ptr (EngineState.gas-spawn state)) 0.0f)
                      (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) 0.0f)))
                  (when (and (or left-pressed right-pressed) f-held)
                    (let [radius @(Player.edit-radius player)
                          mat-id @(Player.current-mat player)
                          carve? left-pressed
                          phx (Double.to-float vhx)
                          phy (Double.to-float vhy)
                          phz (Double.to-float vhz)]
                      (do
                        (if carve?
                          (do
                            (ParticleSystem.emit-sparks! ps phx phy phz 0.0f 1.0f 0.0f 24)
                            (ParticleSystem.emit-debris! ps phx phy phz 0.0f 1.0f 0.0f 8))
                          (do
                            (ParticleSystem.emit-dust! ps phx phy phz 20)
                            (ParticleSystem.emit-debris! ps phx phy phz 0.0f 1.0f 0.0f 4)))
                        (ignore (World.edit-sdf! world &hit-pos radius mat-id carve?))))))))
          ;; 2. Noita-Style Alchemical Flask Mode (Plain Right-Click = BIG SUCC, Plain Left-Click = SQUIRT TILL IT HURT, X = Purge)
          (let [succ-x (gpu-readback-get-succ-x)
                succ-y (gpu-readback-get-succ-y)
                succ-z (gpu-readback-get-succ-z)
                succ-w (gpu-readback-get-succ-w)
                jet-x (gpu-readback-get-jet-x)
                jet-y (gpu-readback-get-jet-y)
                jet-z (gpu-readback-get-jet-z)
                jet-w (gpu-readback-get-jet-w)
                px (Double.to-float @(Vector3.x ro))
                py (Double.to-float @(Vector3.y ro))
                pz (Double.to-float @(Vector3.z ro))
                fx (Double.to-float @(Vector3.x rd))
                fy (Double.to-float @(Vector3.y rd))
                fz (Double.to-float @(Vector3.z rd))
                rx (Double.to-float @(Vector3.x right))
                ry (Double.to-float @(Vector3.y right))
                rz (Double.to-float @(Vector3.z right))
                ux (Double.to-float @(Vector3.x up))
                uy (Double.to-float @(Vector3.y up))
                uz (Double.to-float @(Vector3.z up))
                noz-x (+ (+ px (* rx 0.36f)) (- (* fx 0.65f) (* ux 0.22f)))
                noz-y (+ (+ py (* ry 0.36f)) (- (* fy 0.65f) (* uy 0.22f)))
                noz-z (+ (+ pz (* rz 0.36f)) (- (* fz 0.65f) (* uz 0.22f)))
                fdt (Double.to-float dt)
                cur-mat @(EngineState.flask-mat state)
                cur-fill @(EngineState.flask-fill state)
                ui-mode 0.0f]
            (do
              ;; Ensure sandbox spawns stay off while handling the Flask
              (Pointer.set (ref-to-ptr (EngineState.hit-active state)) 0.0f)
              (Pointer.set (ref-to-ptr (EngineState.liquid-spawn state)) 0.0f)
              (Pointer.set (ref-to-ptr (EngineState.gas-spawn state)) 0.0f)
              (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) 0.0f)

              ;; 2a. X Key: Dump / Purge Flask so you can immediately switch elements
              (if (and (and x-pressed (not @(EngineState.x-last state))) (and (> cur-mat 0.5f) (> cur-fill 0.002f)))
                (let [dump-pt (EditingSystem.jet-ptype cur-mat)
                      dx (+ noz-x (* fx 1.3f))
                      dy (+ noz-y (* fy 1.3f))
                      dz (+ noz-z (* fz 1.3f))]
                  (do
                    (EngineState.set-flask-px! state dx)
                    (EngineState.set-flask-py! state dy)
                    (EngineState.set-flask-pz! state dz)
                    (EngineState.set-flask-pr! state 2.2f)
                    (EngineState.set-flask-ax! state cur-mat)
                    (EngineState.set-flask-ay! state (* 0.85f cur-fill))
                    (ParticleSystem.emit! ps noz-x noz-y noz-z (* fx 9.0f) (- (* fy 9.0f) 1.5f) (* fz 9.0f) 0.85f 36 dump-pt 0.32f 0.2f)
                    (EngineState.set-flask-mat! state 0.0f)
                    (EngineState.set-flask-fill! state 0.0f)
                    (set! ui-mode 2.0f)))

                ;; 2b. Left-Click: SQUIRT TILL IT HURT (High-pressure parabolic stream + entity knockback!)
                (if (and left-pressed (and (> cur-mat 0.5f) (> cur-fill 0.002f)))
                  (let [jpt (EditingSystem.jet-ptype cur-mat)
                        is-liq (< cur-mat 512.0f)
                        next-fill (Float.clamp 0.0f 1.0f (- cur-fill (* 0.24f fdt)))
                        jvx (* fx 26.0f)
                        jvy (+ (* fy 26.0f) 1.8f)
                        jvz (* fz 26.0f)]
                    (do
                      (if is-liq
                        (ParticleSystem.emit! ps noz-x noz-y noz-z jvx jvy jvz 1.35f 14 jpt 0.042f 0.25f)
                        (ParticleSystem.emit! ps noz-x noz-y noz-z (* fx 22.0f) (+ (* fy 22.0f) 1.2f) (* fz 22.0f) 1.15f 10 jpt 0.095f 0.12f))
                      (when (> jet-w 0.5f)
                        (do
                          (EngineState.set-flask-px! state jet-x)
                          (EngineState.set-flask-py! state jet-y)
                          (EngineState.set-flask-pz! state jet-z)
                          (EngineState.set-flask-pr! state (if is-liq 2.15f 2.6f))
                          (EngineState.set-flask-ax! state cur-mat)
                          (EngineState.set-flask-ay! state (if is-liq 0.55f 0.62f))
                          (ParticleSystem.emit! ps jet-x jet-y jet-z (* fx -3.0f) 4.2f (* fz -3.0f) 0.5f 7 jpt 0.48f 0.25f)
                          (EditingSystem.apply-firehose-knockback! state jet-x jet-y jet-z jet-w rd dt)))
                      (if (<= next-fill 0.002f)
                        (do
                          (EngineState.set-flask-fill! state 0.0f)
                          (EngineState.set-flask-mat! state 0.0f))
                        (EngineState.set-flask-fill! state next-fill))
                      (set! ui-mode 1.0f)))

                  ;; 2c. Right-Click: THE BIG SUCC (Vacuum pool/fumes into single-element flask!)
                  (when (and right-pressed
                             (and (> succ-w 0.5f)
                                  (and (< cur-fill 0.999f)
                                       (or (< cur-mat 0.5f) (< (Float.abs (- cur-mat succ-w)) 0.5f)))))
                    (let [lock-mat (if (< cur-mat 0.5f) succ-w cur-mat)
                          next-fill (Float.clamp 0.0f 1.0f (+ cur-fill (* 0.46f fdt)))
                          spt (EditingSystem.succ-ptype lock-mat)
                          dx (- noz-x succ-x)
                          dy (- noz-y succ-y)
                          dz (- noz-z succ-z)
                          dist (Float.clamp 0.30f 20.0f (Float.sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz))))
                          travel (Float.clamp 0.11f 0.55f (/ dist 22.0f))
                          spd (/ dist travel)
                          svx (* (/ dx dist) spd)
                          svy (* (/ dy dist) spd)
                          svz (* (/ dz dist) spd)]
                      (do
                        (EngineState.set-flask-mat! state lock-mat)
                        (EngineState.set-flask-fill! state next-fill)
                        (EngineState.set-flask-px! state succ-x)
                        (EngineState.set-flask-py! state succ-y)
                        (EngineState.set-flask-pz! state succ-z)
                        (EngineState.set-flask-pr! state 2.85f)
                        (EngineState.set-flask-ax! state lock-mat)
                        (EngineState.set-flask-ay! state -0.45f)
                        (ParticleSystem.emit! ps succ-x succ-y succ-z svx svy svz travel 12 spt 0.055f 0.0f)
                        (set! ui-mode -1.0f))))))

              (js-sync-flask @(EngineState.flask-mat state) @(EngineState.flask-fill state) ui-mode succ-w))))

        (EngineState.set-x-last! state x-pressed))))
)

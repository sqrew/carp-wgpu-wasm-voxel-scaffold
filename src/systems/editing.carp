(defmodule EditingSystem
  (defn match-entity? [state idx gen]
    (let [mb (EngineState.matches state)
          m-idx (MatchBook.idx mb)
          m-life (MatchBook.life mb)
          found false]
      (do
        (for [i 0 8]
          (when (and (> @(Array.unsafe-nth m-life i) 0.0f)
                     (Uint64.= idx @(Array.unsafe-nth m-idx i)))
            (set! found true)))
        found)))

  (defn spawn-boulder! [state spawn-pos vel radius mat-id ttl-ms]
    (let [ecs (EngineState.ecs-world state)
          e (GameWorld.create-entity! ecs)
          col (Materials.boulder-color mat-id)
          restit (Materials.boulder-restitution mat-id)
          fric (Materials.boulder-friction mat-id)
          rb (RigidBody.new @&spawn-pos (Quaternion.identity) 1.5 restit fric 0.08 0.12 0.22)
          vol (Volume.Ball (Sphere.init @&spawn-pos radius))]
      (do
        (Body.set-velocity! (RigidBody.body &rb) vel)
        (add-component! ecs &e (CompBody.init rb))
        (add-component! ecs &e (CompVolume.init vol))
        (add-component! ecs &e (CompColor.init col))
        (let [idx (ECS.Entity.index &e)
              gen (ECS.Entity.generation &e)
              ecs-ptr (Unsafe.coerce (EngineState.ecs-world state))
              _ (Coordinator.schedule! (EngineState.coord state) (AppEvent.DespawnEntity ecs-ptr idx gen) ttl-ms)]
          e))))

  (defn punt-cone-entities! [state ro rd ps]
    (let [ecs (EngineState.ecs-world state)
          player-id @(EngineState.player-ent-id state)
          rx @(Vector3.x ro)
          ry @(Vector3.y ro)
          rz @(Vector3.z ro)
          fx @(Vector3.x rd)
          fy @(Vector3.y rd)
          fz @(Vector3.z rd)
          fxf (Double.to-float fx)
          fyf (Double.to-float fy)
          fzf (Double.to-float fz)
          punted-count 0]
      (do
        (query ecs (e (cb CompBody) (cv CompVolume) (cc CompColor))
          (let [eid (Long.to-int (Uint64.to-long (ECS.Entity.index &e)))]
            (when (/= eid player-id)
              (let [rb (CompBody.rb cb)
                    epos (RigidBody.position rb)
                    dx (- @(Vector3.x epos) rx)
                    dy (- @(Vector3.y epos) ry)
                    dz (- @(Vector3.z epos) rz)
                    d2 (+ (+ (* dx dx) (* dy dy)) (* dz dz))
                    along (+ (+ (* dx fx) (* dy fy)) (* dz fz))
                    p2 (- d2 (* along along))
                    perp (Double.sqrt (if (> p2 0.0) p2 0.0))]
                (when (and (> along -0.25) (and (<= along 4.65) (<= perp 1.85)))
                  (let [b (RigidBody.body rb)
                        new-v (Vector3.init (+ (* fx 26.0) (* dx 1.6))
                                            (+ (* fy 24.0) 6.2)
                                            (+ (* fz 26.0) (* dz 1.6)))
                        ex (Double.to-float @(Vector3.x epos))
                        ey (Double.to-float @(Vector3.y epos))
                        ez (Double.to-float @(Vector3.z epos))
                        eidx (ECS.Entity.index &e)
                        hslot (EnemySystem.hopper-slot-by-idx state eidx)
                        mslot (if (>= hslot 0) -1 (MancerSystem.mancer-slot-by-idx state eidx))
                        oslot (MancerSystem.orb-slot-by-idx state eidx)]
                    (do
                      (Body.set-velocity! b new-v)
                      (RigidBody.set-body! rb @b)
                      (ParticleSystem.emit-sparks! ps ex ey ez fxf fyf fzf 14)
                      (ParticleSystem.emit-dust! ps ex ey ez 8)
                      (when (>= oslot 0)
                        (MancerSystem.hijack-orb-by-idx! state eidx))
                      (when (>= hslot 0)
                        (do
                          (ignore (EnemySystem.damage-hopper! state hslot 22.0f fxf fyf fzf 0.0f 0))
                          (Array.aset! (EnemyBank.hurt-cd (EngineState.enemies state)) hslot 0.0f)
                          (Array.aset! (EnemyBank.prev-spd (EngineState.enemies state)) hslot 29.0f)))
                      (when (>= mslot 0)
                        (do
                          (ignore (MancerSystem.damage-mancer! state mslot 24.0f fxf fyf fzf 0.0f 0))
                          (Array.aset! (MancerBank.hurt-cd (EngineState.mancers state)) mslot 0.0f)
                          (Array.aset! (MancerBank.prev-spd (EngineState.mancers state)) mslot 29.0f)))
                      (set! punted-count (+ punted-count 1)))))))))
        punted-count)))

  (defn apply-firehose-knockback! [state jet-x jet-y jet-z jet-w rd dt scale]
    (let [ecs (EngineState.ecs-world state)
          player-id @(EngineState.player-ent-id state)
          target-ei (if (>= jet-w 1.9f) (Float.round (- jet-w 2.0f)) -1)
          jx (Double.from-float jet-x)
          jy (Double.from-float jet-y)
          jz (Double.from-float jet-z)
          fx @(Vector3.x rd)
          fy @(Vector3.y rd)
          fz @(Vector3.z rd)
          dscale (Double.from-float scale)
          max-r (* 2.4 dscale)
          curr-ei 0]
      (query ecs (e (cb CompBody) (cv CompVolume) (cc CompColor))
        (let [eid (Long.to-int (Uint64.to-long (ECS.Entity.index &e)))]
          (do
            (when (/= eid player-id)
              (let [rb (CompBody.rb cb)
                    pos (RigidBody.position rb)
                    dx (- @(Vector3.x pos) jx)
                    dy (- @(Vector3.y pos) jy)
                    dz (- @(Vector3.z pos) jz)
                    dist (Double.sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz)))
                    direct? (= curr-ei target-ei)]
                (when (or direct? (< dist max-r))
                  (let [b (RigidBody.body rb)
                        old-v @(Body.velocity b)
                        strength (* dscale (if direct? 56.0 (* 38.0 (- 1.0 (/ dist (+ max-r 0.2))))))
                        lift (* dscale (if direct? 11.5 7.5))
                        rx (if (> dist 0.15) (* (/ dx dist) 8.0) 0.0)
                        rz (if (> dist 0.15) (* (/ dz dist) 8.0) 0.0)
                        dv (Vector3.init (* (+ (* fx strength) rx) dt)
                                         (* (+ (* fy strength) lift) dt)
                                         (* (+ (* fz strength) rz) dt))
                        new-v (Vector3.add &old-v &dv)]
                    (do
                      (Body.set-velocity! b new-v)
                      (RigidBody.set-body! rb @b))))))
            (set! curr-ei (+ curr-ei 1)))))))

  (defn handle-gauntlet-boot! [state input world ps ro rd right up hx hy hz hw left-pressed right-pressed x-pressed]
    (let [ecs (EngineState.ecs-world state)
          rig (EngineState.rig state)
          player-id @(EngineState.player-ent-id state)
          fc @(EngineState.frame-count state)
          hit-mat (gpu-readback-get-hit-mat)
          hit-stress (gpu-readback-get-hit-stress)
          hit-splash (gpu-readback-get-hit-splash)
          rx @(Vector3.x ro)
          ry @(Vector3.y ro)
          rz @(Vector3.z ro)
          fx @(Vector3.x rd)
          fy @(Vector3.y rd)
          fz @(Vector3.z rd)
          rtx @(Vector3.x right)
          rty @(Vector3.y right)
          rtz @(Vector3.z right)
          upx @(Vector3.x up)
          upy @(Vector3.y up)
          upz @(Vector3.z up)
          fxf (Double.to-float fx)
          fyf (Double.to-float fy)
          fzf (Double.to-float fz)
          hold-x (- (+ rx (* fx 2.35)) (* upx 0.14))
          hold-y (- (+ ry (* fy 2.35)) (* upy 0.14))
          hold-z (- (+ rz (* fz 2.35)) (* upz 0.14))
          wdx (- (Double.from-float hx) rx)
          wdy (- (Double.from-float hy) ry)
          wdz (- (Double.from-float hz) rz)
          wall-t (if (> hw 0.5f) (Double.sqrt (+ (+ (* wdx wdx) (* wdy wdy)) (* wdz wdz))) 999.0)
          g-idx @(RigBelt.grab-idx rig)
          g-gen @(RigBelt.grab-gen rig)
          ui-mode 0.0f
          probe-code 0.0f
          probe-stress 0.0f]
      (do
        ;; 1. Currently Holding / Tugging an Entity
        (when (> (Uint64.to-long g-idx) 0l)
          (if (or x-pressed (not right-pressed))
            ;; Release RMB (or X): cleanly drop/toss with clamped momentum into hazards!
            (do
              (query ecs (e (cb CompBody) (cv CompVolume) (cc CompColor))
                (when (Uint64.= (ECS.Entity.index &e) g-idx)
                  (let [rb (CompBody.rb cb)
                        b (RigidBody.body rb)
                        v @(Body.velocity b)
                        vx (Physics.clamp -13.5 13.5 @(Vector3.x &v))
                        vy (Physics.clamp -13.5 9.0 @(Vector3.y &v))
                        vz (Physics.clamp -13.5 13.5 @(Vector3.z &v))]
                    (do
                      (Body.set-velocity! b (Vector3.init vx vy vz))
                      (RigidBody.set-body! rb @b)))))
              (RigBelt.set-grab-idx! rig (Uint64.from-long 0l))
              (RigBelt.set-grab-mat! rig 0.0f))

            ;; Holding RMB: Check for LMB Power-Punt Combo (30.5 m/s cannonball!) or continue Tug / Spring Hold
            (if (or (InputManager.action-pressed? input "click-left")
                    (and left-pressed (>= (- fc @(RigBelt.last-kick-frame rig)) 16)))
              (let [hslot (EnemySystem.hopper-slot-by-idx state g-idx)
                    mslot (if (>= hslot 0) -1 (MancerSystem.mancer-slot-by-idx state g-idx))
                    oslot (MancerSystem.orb-slot-by-idx state g-idx)]
                (do
                  (query ecs (e (cb CompBody) (cv CompVolume) (cc CompColor))
                    (when (Uint64.= (ECS.Entity.index &e) g-idx)
                      (let [rb (CompBody.rb cb)
                            b (RigidBody.body rb)
                            epos (RigidBody.position rb)
                            ex (Double.to-float @(Vector3.x epos))
                            ey (Double.to-float @(Vector3.y epos))
                            ez (Double.to-float @(Vector3.z epos))
                            punt-v (Vector3.init (* fx 30.5) (+ (* fy 30.5) 3.4) (* fz 30.5))]
                        (do
                          (Body.set-velocity! b punt-v)
                          (RigidBody.set-body! rb @b)
                          (ParticleSystem.emit-sparks! ps ex ey ez fxf fyf fzf 22)
                          (ParticleSystem.emit-dust! ps ex ey ez 14)))))
                  (when (>= oslot 0)
                    (MancerSystem.hijack-orb-by-idx! state g-idx))
                  (when (>= hslot 0)
                    (do
                      (ignore (EnemySystem.damage-hopper! state hslot 16.0f fxf fyf fzf 0.0f 0))
                      (Array.aset! (EnemyBank.hurt-cd (EngineState.enemies state)) hslot 0.0f)
                      (Array.aset! (EnemyBank.prev-spd (EngineState.enemies state)) hslot 31.0f)))
                  (when (>= mslot 0)
                    (do
                      (ignore (MancerSystem.damage-mancer! state mslot 18.0f fxf fyf fzf 0.0f 0))
                      (Array.aset! (MancerBank.hurt-cd (EngineState.mancers state)) mslot 0.0f)
                      (Array.aset! (MancerBank.prev-spd (EngineState.mancers state)) mslot 31.0f)))
                  (RigBelt.set-grab-idx! rig (Uint64.from-long 0l))
                  (RigBelt.set-grab-mat! rig 0.0f)
                  (RigBelt.set-last-kick-frame! rig fc)
                  (set! ui-mode 3.0f)))

              (let [still-alive false]
                (do
                  (query ecs (e (cb CompBody) (cv CompVolume) (cc CompColor))
                    (when (Uint64.= (ECS.Entity.index &e) g-idx)
                      (let [rb (CompBody.rb cb)
                            b (RigidBody.body rb)
                            epos (RigidBody.position rb)
                            ex @(Vector3.x epos)
                            ey @(Vector3.y epos)
                            ez @(Vector3.z epos)
                            dx (- hold-x ex)
                            dy (- hold-y ey)
                            dz (- hold-z ez)
                            d (Double.sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz)))]
                        (do
                          (set! still-alive true)
                          (if (> d 2.25)
                            ;; Mid-Range Hazard Tug: reel violently toward hand (+ lip-hop so targets clear edges into Acid pits!)
                            (let [spd (Physics.clamp 14.5 25.5 (* d 3.6))
                                  inv-d (if (> d 0.1) (/ 1.0 d) 0.0)
                                  hop-y (if (> d 3.1) 2.45 0.65)
                                  tug-v (Vector3.init (* (* dx inv-d) spd)
                                                      (+ (* (* dy inv-d) spd) hop-y)
                                                      (* (* dz inv-d) spd))]
                              (do
                                (Body.set-velocity! b tug-v)
                                (RigidBody.set-body! rb @b)
                                (when (= (Int.mod fc 2) 0)
                                  (ParticleSystem.emit-dust! ps (Double.to-float ex) (Double.to-float ey) (Double.to-float ez) 2))
                                (set! ui-mode -2.0f)
                                (set! probe-code 921.0f)))
                            ;; Close Spring Grasp: smooth weightless hold right in front of your hands
                            (let [vx (Physics.clamp -22.0 22.0 (* dx 17.5))
                                  vy (Physics.clamp -22.0 22.0 (+ (* dy 17.5) 0.25))
                                  vz (Physics.clamp -22.0 22.0 (* dz 17.5))]
                              (do
                                (Body.set-velocity! b (Vector3.init vx vy vz))
                                (RigidBody.set-body! rb @b)
                                (set! ui-mode -1.0f)
                                (set! probe-code 920.0f))))))))
                  (when (not still-alive)
                    (do
                      (RigBelt.set-grab-idx! rig (Uint64.from-long 0l))
                      (RigBelt.set-grab-mat! rig 0.0f))))))))

        ;; 2. Empty Hands: Scan Aim Cone (<= 14.5m), Handle RMB Yank/Wrench & LMB Seismic Boot Kick
        (when (and (= (Uint64.to-long @(RigBelt.grab-idx rig)) 0l) (< (Float.abs ui-mode) 0.1f))
          (let [best-idx (Uint64.from-long 0l)
                best-gen (Uint32.from-long 0l)
                best-score 999.0
                best-along 999.0]
            (do
              (query ecs (e (cb CompBody) (cv CompVolume) (cc CompColor))
                (let [idx (ECS.Entity.index &e)
                      eid (Long.to-int (Uint64.to-long idx))]
                  (when (/= eid player-id)
                    (let [epos (RigidBody.position (CompBody.rb cb))
                          dx (- @(Vector3.x epos) rx)
                          dy (- @(Vector3.y epos) ry)
                          dz (- @(Vector3.z epos) rz)
                          d2 (+ (+ (* dx dx) (* dy dy)) (* dz dz))
                          along (+ (+ (* dx fx) (* dy fy)) (* dz fz))
                          p2 (- d2 (* along along))
                          perp (Double.sqrt (if (> p2 0.0) p2 0.0))
                          max-perp (+ 0.95 (* 0.065 along))
                          score (+ (* perp 2.2) (* along 0.16))]
                      (when (and (> along 0.35)
                                 (and (<= along 14.5)
                                      (and (<= along (+ wall-t 0.85))
                                           (and (<= perp max-perp) (< score best-score)))))
                        (do
                          (set! best-idx idx)
                          (set! best-gen (ECS.Entity.generation &e))
                          (set! best-score score)
                          (set! best-along along)))))))

              (if (> (Uint64.to-long best-idx) 0l)
                (let [aslot (CritterSystem.amoeba-slot-by-idx state best-idx)
                      hslot (EnemySystem.hopper-slot-by-idx state best-idx)
                      mslot (MancerSystem.mancer-slot-by-idx state best-idx)
                      oslot (MancerSystem.orb-slot-by-idx state best-idx)
                      nslot (GoldSystem.nugget-slot-by-idx state best-idx)
                      is-m? (EditingSystem.match-entity? state best-idx best-gen)]
                  (if (>= aslot 0)
                    (let [amat (Float.from-int (Float.round (CritterSystem.amoeba-mat-at state aslot)))]
                      (set! probe-code (+ (if (<= best-along 4.3) 2000.0f 3000.0f) amat)))
                    (if (>= hslot 0)
                      (let [hmat (Float.from-int (Float.round (EnemySystem.hopper-mat-at state hslot)))]
                        (set! probe-code (+ (if (<= best-along 4.3) 4000.0f 5000.0f) hmat)))
                      (if (>= mslot 0)
                        (let [mmat (Float.from-int (Float.round (MancerSystem.mancer-mat-at state mslot)))]
                          (set! probe-code (+ (if (<= best-along 4.3) 6000.0f 7000.0f) mmat)))
                        (if (>= oslot 0)
                          (let [omat (Float.from-int (Float.round (MancerSystem.orb-mat-at state oslot)))]
                            (set! probe-code (+ (if (<= best-along 4.3) 8000.0f 9000.0f) omat)))
                          (if (>= nslot 0)
                            (set! probe-code (if (<= best-along 4.3) 914.0f 915.0f))
                            (set! probe-code (if is-m?
                                               (if (<= best-along 4.3) 912.0f 913.0f)
                                               (if (<= best-along 4.3) 910.0f 911.0f)))))))))
                (when (and (> hw 0.5f) (and (<= wall-t 8.8) (and (>= hit-mat 0.5f) (< hit-mat 254.5f))))
                  (do
                    (set! probe-code hit-mat)
                    (set! probe-stress hit-stress))))

              ;; 2a. RMB Press: Hook & Yank Targeted Entity OR Wrench Boulder / Jumbo Gold Nugget Out of Wall!
              (if (InputManager.action-pressed? input "click-right")
                (if (> (Uint64.to-long best-idx) 0l)
                  (let [aslot (CritterSystem.amoeba-slot-by-idx state best-idx)
                        hslot (EnemySystem.hopper-slot-by-idx state best-idx)
                        mslot (MancerSystem.mancer-slot-by-idx state best-idx)
                        oslot (MancerSystem.orb-slot-by-idx state best-idx)
                        nslot (GoldSystem.nugget-slot-by-idx state best-idx)
                        is-m? (EditingSystem.match-entity? state best-idx best-gen)]
                    (do
                      (when (>= oslot 0)
                        (MancerSystem.hijack-orb-by-idx! state best-idx))
                      (RigBelt.set-grab-idx! rig best-idx)
                      (RigBelt.set-grab-gen! rig best-gen)
                      (RigBelt.set-grab-mat! rig
                        (if (>= aslot 0)
                          (+ 1000.0f (Float.from-int (Float.round (CritterSystem.amoeba-mat-at state aslot))))
                          (if (>= hslot 0)
                            (+ 2000.0f (Float.from-int (Float.round (EnemySystem.hopper-mat-at state hslot))))
                            (if (>= mslot 0)
                              (+ 3000.0f (Float.from-int (Float.round (MancerSystem.mancer-mat-at state mslot))))
                              (if (>= nslot 0)
                                905.0f
                                (if (>= oslot 0)
                                  (+ 4000.0f (Float.from-int (Float.round (MancerSystem.orb-mat-at state oslot))))
                                  (if is-m? 901.0f 900.0f)))))))
                      (query ecs (e (cb CompBody) (cv CompVolume) (cc CompColor))
                        (when (Uint64.= (ECS.Entity.index &e) best-idx)
                          (let [rb (CompBody.rb cb)
                                b (RigidBody.body rb)
                                epos (RigidBody.position rb)
                                ex @(Vector3.x epos)
                                ey @(Vector3.y epos)
                                ez @(Vector3.z epos)
                                dx (- hold-x ex)
                                dy (- hold-y ey)
                                dz (- hold-z ez)
                                d (Double.sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz)))
                                inv-d (if (> d 0.01) (/ 1.0 d) 0.0)
                                yank-v (Vector3.init (* (* dx inv-d) 21.0)
                                                     (+ (* (* dy inv-d) 21.0) 3.2)
                                                     (* (* dz inv-d) 21.0))]
                            (do
                              (Body.set-velocity! b yank-v)
                              (RigidBody.set-body! rb @b)
                              (ParticleSystem.emit-dust! ps (Double.to-float ex) (Double.to-float ey) (Double.to-float ez) 10)))))
                      (set! ui-mode -2.0f)))

                  (when (and (> hw 0.5f)
                             (and (<= wall-t 8.8)
                                  (and (>= hit-mat 0.5f)
                                       (and (< hit-mat 254.5f)
                                            (>= (- fc @(RigBelt.last-wrench-frame rig)) 12)))))
                    (let [hvec (Vector3.init (Double.from-float hx) (Double.from-float hy) (Double.from-float hz))
                          bx (- (Double.from-float hx) (* fx 0.65))
                          by (- (Double.from-float hy) (* fy 0.65))
                          bz (- (Double.from-float hz) (* fz 0.65))
                          dx (- hold-x bx)
                          dy (- hold-y by)
                          dz (- hold-z bz)
                          d (Double.sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz)))
                          inv-d (if (> d 0.01) (/ 1.0 d) 0.0)
                          bpos (Vector3.init bx by bz)
                          bvel (Vector3.init (* (* dx inv-d) 19.5) (+ (* (* dy inv-d) 19.5) 2.2) (* (* dz inv-d) 19.5))
                          is-gold? (= (Float.round hit-mat) 5)
                          boulder (if is-gold?
                                    (GoldSystem.spawn-nugget! state bpos bvel 0.38 25)
                                    (EditingSystem.spawn-boulder! state bpos bvel 0.52 hit-mat 45000l))
                          spt (Materials.succ-ptype hit-mat)]
                      (do
                        (RigBelt.set-last-wrench-frame! rig fc)
                        (EngineState.push-voxel-action! state hx hy hz 1.38f hit-mat -1.0f 0.0f)
                        (ignore (World.edit-sdf! world &hvec 1.38 hit-mat true))
                        (when is-gold?
                          (do
                            (World.set-carved-gold-count! world 0)
                            (ParticleSystem.emit-sparks! ps hx hy hz (* fxf -1.0f) 0.8f (* fzf -1.0f) 18)))
                        (ParticleSystem.emit-dust! ps hx hy hz 12)
                        (ParticleSystem.emit! ps hx hy hz (* fxf -8.0f) 2.5f (* fzf -8.0f) 0.35f 10 spt 0.12f 0.0f)
                        (when (= (Float.round hit-mat) 13)
                          (do
                            (EngineState.push-voxel-action! state hx hy hz 3.18f 520.0f 0.88f 1.0f)
                            (ParticleSystem.emit! ps hx hy hz 0.0f 3.5f 0.0f 1.8f 24 208.0f 0.65f 0.0f)))
                        (RigBelt.set-grab-idx! rig (ECS.Entity.index &boulder))
                        (RigBelt.set-grab-gen! rig (ECS.Entity.generation &boulder))
                        (RigBelt.set-grab-mat! rig (if is-gold? 905.0f hit-mat))
                        (set! ui-mode -2.0f)))))

                ;; 2b. LMB Seismic Boot Kick (16-frame cadence): Cone Entity Punt + Puddle Splash + Pillar Shatter!
                (when (and left-pressed (>= (- fc @(RigBelt.last-kick-frame rig)) 16))
                  (let [boot-x (Double.to-float (- (+ rx (* fx 1.35)) (* upx 0.28)))
                        boot-y (Double.to-float (- (+ ry (* fy 1.35)) (* upy 0.28)))
                        boot-z (Double.to-float (- (+ rz (* fz 1.35)) (* upz 0.28)))
                        punted (EditingSystem.punt-cone-entities! state ro rd ps)]
                    (do
                      (RigBelt.set-last-kick-frame! rig fc)
                      (ParticleSystem.emit-dust! ps boot-x boot-y boot-z 8)
                      (when (>= hit-splash 256.5f)
                        (let [lpt (Materials.jet-ptype hit-splash)]
                          (ParticleSystem.emit! ps boot-x boot-y boot-z (* fxf 19.5f) (+ (* fyf 16.0f) 5.8f) (* fzf 19.5f) 1.65f 24 lpt 0.45f 0.30f)))
                      (if (and (> hw 0.5f) (and (<= wall-t 4.55) (and (>= hit-mat 0.5f) (< hit-mat 254.5f))))
                        (let [hvec (Vector3.init (Double.from-float hx) (Double.from-float hy) (Double.from-float hz))
                              shatter? (or (>= hit-stress 0.22f) (Materials.brittle? hit-mat))
                              bx (- (Double.from-float hx) (* fx 0.55))
                              by (- (Double.from-float hy) (* fy 0.55))
                              bz (- (Double.from-float hz) (* fz 0.55))]
                          (if shatter?
                            ;; Overloaded Load-Bearing Pillar or Brittle Crystal/Ice/Spore -> MASSIVE SHATTER + 3 Rubble Boulders!
                            (let [p0 (Vector3.init bx by bz)
                                  p1 (Vector3.init (+ bx (* rtx 0.45)) (+ by 0.25) (+ bz (* rtz 0.45)))
                                  p2 (Vector3.init (- bx (* rtx 0.45)) (- by 0.15) (- bz (* rtz 0.45)))
                                  v0 (Vector3.init (* fx 14.0) (+ (* fy 11.0) 4.5) (* fz 14.0))
                                  v1 (Vector3.init (+ (* fx 11.5) (* rtx 5.2)) (+ (* fy 9.5) 5.5) (+ (* fz 11.5) (* rtz 5.2)))
                                  v2 (Vector3.init (- (* fx 11.5) (* rtx 5.2)) (+ (* fy 9.5) 3.8) (- (* fz 11.5) (* rtz 5.2)))]
                              (do
                                (EngineState.push-voxel-action! state hx hy hz 2.20f hit-mat -1.0f 0.0f)
                                (ignore (World.edit-sdf! world &hvec 2.20 hit-mat true))
                                (ignore (EditingSystem.spawn-boulder! state p0 v0 0.50 hit-mat 35000l))
                                (ignore (EditingSystem.spawn-boulder! state p1 v1 0.44 hit-mat 35000l))
                                (ignore (EditingSystem.spawn-boulder! state p2 v2 0.42 hit-mat 35000l))
                                (ParticleSystem.emit-sparks! ps hx hy hz fxf fyf fzf 26)
                                (ParticleSystem.emit-debris! ps hx hy hz fxf 1.0f fzf 16)
                                (ParticleSystem.emit-dust! ps hx hy hz 24)
                                (when (= (Float.round hit-mat) 13)
                                  (do
                                    (EngineState.push-voxel-action! state hx hy hz 4.00f 520.0f 0.88f 1.0f)
                                    (ParticleSystem.emit! ps hx hy hz 0.0f 4.2f 0.0f 2.2f 28 208.0f 0.70f 0.0f)))
                                (set! ui-mode 4.0f)))
                            ;; Solid Unstressed Wall -> Heavy Seismic Chip + 1 Loose Rock Chunk!
                            (let [p0 (Vector3.init bx by bz)
                                  v0 (Vector3.init (* fx -6.5) 4.2 (* fz -6.5))]
                              (do
                                (EngineState.push-voxel-action! state hx hy hz 1.25f hit-mat -1.0f 0.0f)
                                (ignore (World.edit-sdf! world &hvec 1.25 hit-mat true))
                                (ignore (EditingSystem.spawn-boulder! state p0 v0 0.38 hit-mat 30000l))
                                (ParticleSystem.emit-sparks! ps hx hy hz (* fxf -1.0f) 0.8f (* fzf -1.0f) 14)
                                (ParticleSystem.emit-debris! ps hx hy hz 0.0f 1.0f 0.0f 8)
                                (ParticleSystem.emit-dust! ps hx hy hz 16)
                                (set! ui-mode 1.0f)))))
                        (set! ui-mode (if (> punted 0) 3.0f 1.0f))))))))))

        ;; Keep brief kick flash on HUD for 9 frames (~150ms) so single clicks register crisply
        (when (and (< (Float.abs ui-mode) 0.1f)
                   (and (> @(RigBelt.last-kick-frame rig) 0)
                        (< (- fc @(RigBelt.last-kick-frame rig)) 9)))
          (set! ui-mode 1.0f))

        (Vector3.init ui-mode probe-code probe-stress))))

  (defn update! [state input dt]
    (let [world (EngineState.world state)
          player (EngineState.player state)
          ren (EngineState.renderer state)
          ps (EngineState.particles state)
          rig (EngineState.rig state)
          cam (Player.camera player)
          ro (Camera.pos cam)
          rd (Camera.front cam)
          right (Camera.right cam)
          up (Camera.up cam)
          hx (gpu-readback-get-hit-x)
          hy (gpu-readback-get-hit-y)
          hz (gpu-readback-get-hit-z)
          hw (gpu-readback-get-hit-w)
          left-pressed (InputManager.action-digital? input "click-left")
          right-pressed (InputManager.action-digital? input "click-right")
          f-held (InputManager.action-digital? input "edit-add")
          h-held (InputManager.action-digital? input "edit-remove")
          g-held (InputManager.action-digital? input "edit-paint")
          x-pressed (InputManager.action-digital? input "purge-flask")
          brush-mod (or f-held (or h-held g-held))
          hit-opt (if (> hw 0.5f) (Maybe.Just (Vector3.init (Double.from-float hx) (Double.from-float hy) (Double.from-float hz))) (Maybe.Nothing))]
      (do
        ;; Sync active Rig Slot (0 = Solid Sack [1], 1 = Liquid Flask [2], 2 = Gas Bellows [3], 3 = Gauntlet & Boot [4])
        (RigBelt.set-slot! rig (get-js-rig-slot))
        (when (InputManager.action-pressed? input "mat-solid")
          (do (RigBelt.set-slot! rig 0) (set-js-rig-slot 0)))
        (when (InputManager.action-pressed? input "mat-liquid")
          (do (RigBelt.set-slot! rig 1) (set-js-rig-slot 1)))
        (when (InputManager.action-pressed? input "mat-gas")
          (do (RigBelt.set-slot! rig 2) (set-js-rig-slot 2)))
        (when (InputManager.action-pressed? input "rig-interact")
          (do (RigBelt.set-slot! rig 3) (set-js-rig-slot 3)))
        (when (InputManager.action-pressed? input "rig-wand")
          (do (RigBelt.set-slot! rig 4) (set-js-rig-slot 4)))

        ;; If player swapped away from [4] Gauntlet & Boot while holding something, drop it cleanly!
        (when (and (/= @(RigBelt.slot rig) 3)
                   (> (Uint64.to-long @(RigBelt.grab-idx rig)) 0l))
          (do
            (RigBelt.set-grab-idx! rig (Uint64.from-long 0l))
            (RigBelt.set-grab-mat! rig 0.0f)))

        ;; 1. Sandbox Modifier Brushes (Hold F = Solid Carve/Build, H = Liquid Brush, G = Gas Brush)
        (if brush-mod
          (match hit-opt
            (Maybe.Nothing)
              (do
                (Pointer.set (ref-to-ptr (EngineState.hit-active state)) 0.0f)
                (Pointer.set (ref-to-ptr (EngineState.liquid-spawn state)) 0.0f)
                (Pointer.set (ref-to-ptr (EngineState.gas-spawn state)) 0.0f)
                (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) 0.0f))
            (Maybe.Just hit-pos)
              (let [yellow (Vector3.init 1.0 1.0 0.0)
                    vhx @(Vector3.x &hit-pos)
                    vhy @(Vector3.y &hit-pos)
                    vhz @(Vector3.z &hit-pos)]
                (do
                  (EngineState.draw-bounds-wireframe! ren (- vhx 0.5) (- vhy 0.5) (- vhz 0.5) (+ vhx 0.5) (+ vhy 0.5) (+ vhz 0.5) &yellow)
                  (Pointer.set (ref-to-ptr (EngineState.hit-x state)) (Double.to-float vhx))
                  (Pointer.set (ref-to-ptr (EngineState.hit-y state)) (Double.to-float vhy))
                  (Pointer.set (ref-to-ptr (EngineState.hit-z state)) (Double.to-float vhz))
                  (if (or left-pressed right-pressed)
                    (do
                      (Pointer.set (ref-to-ptr (EngineState.hit-active state)) 1.0f)
                      (if h-held
                        (Pointer.set (ref-to-ptr (EngineState.liquid-spawn state)) @(Player.current-liq player))
                        (Pointer.set (ref-to-ptr (EngineState.liquid-spawn state)) 0.0f))
                      (if g-held
                        (Pointer.set (ref-to-ptr (EngineState.gas-spawn state)) @(Player.current-gas player))
                        (Pointer.set (ref-to-ptr (EngineState.gas-spawn state)) 0.0f))
                      (if (and f-held left-pressed)
                        (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) 999.0f)
                        (if (and f-held right-pressed)
                          (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) @(Player.current-mat player))
                          (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) 0.0f))))
                    (do
                      (Pointer.set (ref-to-ptr (EngineState.hit-active state)) 0.0f)
                      (Pointer.set (ref-to-ptr (EngineState.liquid-spawn state)) 0.0f)
                      (Pointer.set (ref-to-ptr (EngineState.gas-spawn state)) 0.0f)
                      (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) 0.0f)))
                  (when (and (or left-pressed right-pressed) f-held)
                    (let [radius @(Player.edit-radius player)
                          mat-id @(Player.current-mat player)
                          carve? left-pressed
                          phx (Double.to-float vhx)
                          phy (Double.to-float vhy)
                          phz (Double.to-float vhz)]
                      (do
                        (if carve?
                          (do
                            (ParticleSystem.emit-sparks! ps phx phy phz 0.0f 1.0f 0.0f 24)
                            (ParticleSystem.emit-debris! ps phx phy phz 0.0f 1.0f 0.0f 8))
                          (do
                            (ParticleSystem.emit-dust! ps phx phy phz 20)
                            (ParticleSystem.emit-debris! ps phx phy phz 0.0f 1.0f 0.0f 4)))
                        (EngineState.mark-dirty-sphere! state phx phy phz (Double.to-float radius) 2)
                        (ignore (World.edit-sdf! world &hit-pos radius mat-id carve?))))))))

          ;; 2. Triple-Stack Alchemist's Rig (1: Solid Sack | 2: Liquid Flask | 3: Gas Bellows)
          (let [succ-x (gpu-readback-get-succ-x)
                succ-y (gpu-readback-get-succ-y)
                succ-z (gpu-readback-get-succ-z)
                succ-w (gpu-readback-get-succ-w)
                jet-x (gpu-readback-get-jet-x)
                jet-y (gpu-readback-get-jet-y)
                jet-z (gpu-readback-get-jet-z)
                jet-w (gpu-readback-get-jet-w)
                px (Double.to-float @(Vector3.x ro))
                py (Double.to-float @(Vector3.y ro))
                pz (Double.to-float @(Vector3.z ro))
                fx (Double.to-float @(Vector3.x rd))
                fy (Double.to-float @(Vector3.y rd))
                fz (Double.to-float @(Vector3.z rd))
                rx (Double.to-float @(Vector3.x right))
                ry (Double.to-float @(Vector3.y right))
                rz (Double.to-float @(Vector3.z right))
                ux (Double.to-float @(Vector3.x up))
                uy (Double.to-float @(Vector3.y up))
                uz (Double.to-float @(Vector3.z up))
                noz-x (+ (+ px (* rx 0.36f)) (- (* fx 0.65f) (* ux 0.22f)))
                noz-y (+ (+ py (* ry 0.36f)) (- (* fy 0.65f) (* uy 0.22f)))
                noz-z (+ (+ pz (* rz 0.36f)) (- (* fz 0.65f) (* uz 0.22f)))
                fdt (Double.to-float dt)
                fc @(EngineState.frame-count state)
                slot @(RigBelt.slot rig)
                cur-mat (if (= slot 0)
                          @(RigBelt.sack-mat rig)
                          (if (= slot 1)
                            @(RigBelt.flask-mat rig)
                            @(RigBelt.bellows-mat rig)))
                cur-fill (if (= slot 0)
                           @(RigBelt.sack-fill rig)
                           (if (= slot 1)
                             @(RigBelt.flask-fill rig)
                             @(RigBelt.bellows-fill rig)))
                ui-mode 0.0f
                probe-out succ-w
                stress-out 0.0f]
            (do
              ;; Ensure sandbox spawns stay off while handling the Rig
              (Pointer.set (ref-to-ptr (EngineState.hit-active state)) 0.0f)
              (Pointer.set (ref-to-ptr (EngineState.liquid-spawn state)) 0.0f)
              (Pointer.set (ref-to-ptr (EngineState.gas-spawn state)) 0.0f)
              (Pointer.set (ref-to-ptr (EngineState.solid-spawn state)) 0.0f)

              (if (= slot 3)
                ;; [4] GAUNTLET & BOOT: RMB Tug/Grasp/Wrench + LMB Seismic Boot Kick / Pillar Shatter!
                (let [kb-res (EditingSystem.handle-gauntlet-boot! state input world ps ro rd right up hx hy hz hw left-pressed right-pressed x-pressed)]
                  (do
                    (set! ui-mode @(Vector3.x &kb-res))
                    (set! probe-out @(Vector3.y &kb-res))
                    (set! stress-out @(Vector3.z &kb-res))))

                ;; [1..3] MATTER VESSELS (Solid Sack | Liquid Flask | Gas Bellows); slot 4 ([5] Wand) is handled by WandSystem
                (when (< slot 3)
                ;; 2a. X Key: Dump / Purge ONLY the currently active vessel so the other two stay safe!
                (if (and (and x-pressed (not @(RigBelt.x-last rig))) (and (> cur-mat 0.5f) (> cur-fill 0.002f)))
                  (let [dump-pt (Materials.jet-ptype cur-mat)]
                    (do
                      (if (= slot 0)
                        ;; Dump Solid Sack (pile of grains or cohesive mound safely 2.5m ahead)
                        (let [dx (+ noz-x (* fx 1.9f))
                              dy (+ noz-y (* fy 1.9f))
                              dz (+ noz-z (* fz 1.9f))
                              gran? (Materials.granular? cur-mat)
                              dr (if gran? 1.9f (+ 1.15f (* 0.55f cur-fill)))]
                          (do
                            (EngineState.push-voxel-action! state dx dy dz dr (if gran? (- 0.0f cur-mat) cur-mat) 1.0f 0.0f)
                            (when (not gran?)
                              (let [dvec (Vector3.init (Double.from-float dx) (Double.from-float dy) (Double.from-float dz))]
                                (ignore (World.edit-sdf! world &dvec (Double.from-float dr) cur-mat false))))
                            (ParticleSystem.emit! ps noz-x noz-y noz-z (* fx 9.5f) (- (* fy 9.5f) 1.5f) (* fz 9.5f) 0.85f 32 dump-pt 0.35f 0.25f)
                            (RigBelt.set-sack-mat! rig 0.0f)
                            (RigBelt.set-sack-fill! rig 0.0f)))
                        (let [dx (+ noz-x (* fx 1.35f))
                              dy (+ noz-y (* fy 1.35f))
                              dz (+ noz-z (* fz 1.35f))]
                          (do
                            (EngineState.push-voxel-action! state dx dy dz (if (= slot 1) 2.2f 3.1f) cur-mat (* 0.85f cur-fill) 0.0f)
                            (ParticleSystem.emit! ps noz-x noz-y noz-z (* fx 9.0f) (- (* fy 9.0f) 1.0f) (* fz 9.0f) 0.85f 36 dump-pt 0.34f 0.2f)
                            (if (= slot 1)
                              (do (RigBelt.set-flask-mat! rig 0.0f) (RigBelt.set-flask-fill! rig 0.0f))
                              (do (RigBelt.set-bellows-mat! rig 0.0f) (RigBelt.set-bellows-fill! rig 0.0f))))))
                      (set! ui-mode 2.0f)))

                  ;; 2b. Left-Click: Deploy Active Vessel ([1] Pack/Pour Solid | [2] Squirt Liquid | [3] Blast Gas Bellows)
                  (if (and left-pressed (and (> cur-mat 0.5f) (> cur-fill 0.002f)))
                    (let [jpt (Materials.jet-ptype cur-mat)]
                      (do
                        (if (= slot 0)
                          ;; [1] SOLID SACK: Heavy Lob -> Granular CA Cascade or Cohesive 3D Mound Pack!
                          (let [gran? (Materials.granular? cur-mat)
                                next-fill (Float.clamp 0.0f 1.0f (- cur-fill (* 0.20f fdt)))]
                            (do
                              (ParticleSystem.emit! ps noz-x noz-y noz-z (* fx 21.0f) (+ (* fy 21.0f) 2.2f) (* fz 21.0f) 1.25f 9 jpt 0.055f 0.28f)
                              (when (> jet-w 0.5f)
                                (do
                                  (EditingSystem.apply-firehose-knockback! state jet-x jet-y jet-z jet-w rd dt 1.1f)
                                  (if gran?
                                    (do
                                      (EngineState.push-voxel-action! state jet-x jet-y jet-z 1.35f (- 0.0f cur-mat) 1.0f 0.0f)
                                      (ParticleSystem.emit! ps jet-x jet-y jet-z (* fx -2.2f) 3.4f (* fz -2.2f) 0.45f 5 jpt 0.52f 0.25f))
                                    (when (>= (- fc @(RigBelt.last-sack-bite-frame rig)) 4)
                                      (let [pvec (Vector3.init (Double.from-float jet-x) (Double.from-float jet-y) (Double.from-float jet-z))
                                            pdx (- jet-x px)
                                            pdy (- jet-y py)
                                            pdz (- jet-z pz)
                                            pdist (Float.sqrt (+ (+ (* pdx pdx) (* pdy pdy)) (* pdz pdz)))]
                                        (when (> pdist 1.95f)
                                          (do
                                            (RigBelt.set-last-sack-bite-frame! rig fc)
                                            (EngineState.push-voxel-action! state jet-x jet-y jet-z 1.42f cur-mat 1.0f 0.0f)
                                            (ignore (World.edit-sdf! world &pvec 1.42 cur-mat false))
                                            (ParticleSystem.emit-dust! ps jet-x jet-y jet-z 6)
                                            (ParticleSystem.emit! ps jet-x jet-y jet-z (* fx -2.5f) 3.8f (* fz -2.5f) 0.48f 6 jpt 0.50f 0.28f))))))))
                              (if (<= next-fill 0.002f)
                                (do (RigBelt.set-sack-fill! rig 0.0f) (RigBelt.set-sack-mat! rig 0.0f))
                                (RigBelt.set-sack-fill! rig next-fill))))

                          (if (= slot 1)
                            ;; [2] LIQUID FLASK: High-pressure parabolic squirt stream + knockback
                            (let [next-fill (Float.clamp 0.0f 1.0f (- cur-fill (* 0.24f fdt)))]
                              (do
                                (ParticleSystem.emit! ps noz-x noz-y noz-z (* fx 26.0f) (+ (* fy 26.0f) 1.8f) (* fz 26.0f) 1.35f 14 jpt 0.042f 0.25f)
                                (when (> jet-w 0.5f)
                                  (do
                                    (EngineState.push-voxel-action! state jet-x jet-y jet-z 2.15f cur-mat 0.55f 0.0f)
                                    (ParticleSystem.emit! ps jet-x jet-y jet-z (* fx -3.0f) 4.2f (* fz -3.0f) 0.5f 7 jpt 0.48f 0.25f)
                                    (EditingSystem.apply-firehose-knockback! state jet-x jet-y jet-z jet-w rd dt 1.0f)))
                                (if (<= next-fill 0.002f)
                                  (do (RigBelt.set-flask-fill! rig 0.0f) (RigBelt.set-flask-mat! rig 0.0f))
                                  (RigBelt.set-flask-fill! rig next-fill))))

                            ;; [3] GAS BELLOWS: Wide billowing gust / roaring flamethrower cone + heavy airblast!
                            (let [next-fill (Float.clamp 0.0f 1.0f (- cur-fill (* 0.22f fdt)))]
                              (do
                                (ParticleSystem.emit! ps noz-x noz-y noz-z (* fx 19.0f) (+ (* fy 19.0f) 0.6f) (* fz 19.0f) 1.15f 16 jpt 0.20f 0.12f)
                                (when (> jet-w 0.5f)
                                  (do
                                    (EngineState.push-voxel-action! state jet-x jet-y jet-z 3.25f cur-mat 0.68f 0.0f)
                                    (ParticleSystem.emit! ps jet-x jet-y jet-z (* fx 2.5f) 2.6f (* fz 2.5f) 0.55f 6 jpt 0.55f 0.12f)
                                    (EditingSystem.apply-firehose-knockback! state jet-x jet-y jet-z jet-w rd dt 1.45f)))
                                (if (<= next-fill 0.002f)
                                  (do (RigBelt.set-bellows-fill! rig 0.0f) (RigBelt.set-bellows-mat! rig 0.0f))
                                  (RigBelt.set-bellows-fill! rig next-fill))))))
                        (set! ui-mode 1.0f)))

                    ;; 2c. Right-Click: Gather into Active Vessel ([1] Dredge/Mine Wall | [2] Siphon Pool | [3] Inhale Gas/Fire)
                    (let [mining-gold? (and (= slot 0) (= (Float.round succ-w) 5))]
                      (when (and right-pressed
                                 (and (> succ-w 0.5f)
                                      (or mining-gold?
                                          (and (< cur-fill 0.999f)
                                               (or (< cur-mat 0.5f) (< (Float.abs (- cur-mat succ-w)) 0.5f))))))
                        (let [lock-mat (if mining-gold? 5.0f (if (< cur-mat 0.5f) succ-w cur-mat))
                              spt (Materials.succ-ptype lock-mat)
                              dx (- noz-x succ-x)
                              dy (- noz-y succ-y)
                              dz (- noz-z succ-z)
                              dist (Float.clamp 0.30f 20.0f (Float.sqrt (+ (+ (* dx dx) (* dy dy)) (* dz dz))))
                              travel (Float.clamp 0.11f 0.52f (/ dist 22.0f))
                              spd (/ dist travel)
                              svx (* (/ dx dist) spd)
                              svy (* (/ dy dist) spd)
                              svz (* (/ dz dist) spd)]
                          (do
                            (if (= slot 0)
                              ;; [1] SOLID SACK: Chew into wall & vacuum chunks into Sack (or pop pure Gold Nuggets if mining Gold!)
                              (let [next-fill (Float.clamp 0.0f 1.0f (+ cur-fill (* 0.34f fdt)))]
                                (do
                                  (when (not mining-gold?)
                                    (do
                                      (RigBelt.set-sack-mat! rig lock-mat)
                                      (RigBelt.set-sack-fill! rig next-fill)))
                                  (ParticleSystem.emit! ps succ-x succ-y succ-z svx svy svz travel 10 spt 0.065f 0.0f)
                                  (when (>= (- fc @(RigBelt.last-sack-bite-frame rig)) 4)
                                    (let [svec (Vector3.init (Double.from-float succ-x) (Double.from-float succ-y) (Double.from-float succ-z))]
                                      (do
                                        (RigBelt.set-last-sack-bite-frame! rig fc)
                                        (EngineState.push-voxel-action! state succ-x succ-y succ-z 1.75f lock-mat -1.0f 0.0f)
                                        (ParticleSystem.emit-dust! ps succ-x succ-y succ-z 5)
                                        (ignore (World.edit-sdf! world &svec 1.75 lock-mat true)))))))

                            (if (= slot 1)
                              ;; [2] LIQUID FLASK: Siphon pool
                              (let [next-fill (Float.clamp 0.0f 1.0f (+ cur-fill (* 0.46f fdt)))]
                                (do
                                  (RigBelt.set-flask-mat! rig lock-mat)
                                  (RigBelt.set-flask-fill! rig next-fill)
                                  (EngineState.push-voxel-action! state succ-x succ-y succ-z 2.85f lock-mat -0.45f 0.0f)
                                  (ParticleSystem.emit! ps succ-x succ-y succ-z svx svy svz travel 12 spt 0.055f 0.0f)))

                              ;; [3] GAS BELLOWS: Wide-cone inhale (snags rising Methane & live Match Fire!)
                              (let [next-fill (Float.clamp 0.0f 1.0f (+ cur-fill (* 0.54f fdt)))]
                                (do
                                  (RigBelt.set-bellows-mat! rig lock-mat)
                                  (RigBelt.set-bellows-fill! rig next-fill)
                                  (EngineState.push-voxel-action! state succ-x succ-y succ-z 3.60f lock-mat -0.55f 0.0f)
                                  (ParticleSystem.emit! ps succ-x succ-y succ-z svx svy svz travel 14 spt 0.085f 0.0f)))))
                          (set! ui-mode -1.0f)))))))))

              (js-sync-rig @(RigBelt.slot rig)
                           @(RigBelt.sack-mat rig)
                           @(RigBelt.sack-fill rig)
                           @(RigBelt.flask-mat rig)
                           @(RigBelt.flask-fill rig)
                           @(RigBelt.bellows-mat rig)
                           @(RigBelt.bellows-fill rig)
                           @(RigBelt.grab-mat rig)
                           ui-mode
                           probe-out
                           stress-out))))

        (RigBelt.set-x-last! rig x-pressed))))
)

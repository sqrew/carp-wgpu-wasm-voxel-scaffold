(load "../carp-gamecam/camera.carp")
(load "scaffold.carp")

(defmodule Camera
  (defn update-input [win cam dt]
    (let [speed (* 25.0 dt)]
      (do
        (when (= (GLFW.get-key win GLFW.Keycode.W) GLFW.PRESS)
          (Camera.move-forward! cam speed))
        (when (= (GLFW.get-key win GLFW.Keycode.S) GLFW.PRESS)
          (Camera.move-forward! cam (- 0.0 speed)))
        (when (= (GLFW.get-key win GLFW.Keycode.A) GLFW.PRESS)
          (Camera.move-right! cam (- 0.0 speed)))
        (when (= (GLFW.get-key win GLFW.Keycode.D) GLFW.PRESS)
          (Camera.move-right! cam speed))
        (when (= (GLFW.get-key win GLFW.Keycode.E) GLFW.PRESS)
          (Camera.move-up! cam speed))
        (when (= (GLFW.get-key win GLFW.Keycode.Q) GLFW.PRESS)
          (Camera.move-up! cam (- 0.0 speed))))))

  (defn update-look [win cam first-mouse-ptr last-x-ptr last-y-ptr]
    (let [xpos 0.0
          ypos 0.0]
      (do
        (GLFW.get-cursor-pos win (ref-to-ptr &xpos) (ref-to-ptr &ypos))
        (if (Pointer.to-value first-mouse-ptr)
          (do
            (Pointer.set first-mouse-ptr false)
            (Pointer.set last-x-ptr xpos)
            (Pointer.set last-y-ptr ypos))
          (let [dx (- xpos (Pointer.to-value last-x-ptr))
                dy (- (Pointer.to-value last-y-ptr) ypos)
                sensitivity 0.1
                yaw (+ @(Camera.yaw cam) (* dx sensitivity))
                pitch (+ @(Camera.pitch cam) (* dy sensitivity))]
            (do
              (Pointer.set last-x-ptr xpos)
              (Pointer.set last-y-ptr ypos)
              (Camera.update-yaw! cam yaw)
              (Camera.update-pitch! cam pitch)))))))
)

(load "../../carp-gamecam/camera.carp")
(load "scaffold.carp")

(defmodule Camera
  (defn update-input [input cam dt flying]
    (let [speed (* 15.0 dt)]
      (do
        (if flying
            (do
              (when (InputManager.action-digital? input "forward")
                (Camera.move-forward! cam speed))
              (when (InputManager.action-digital? input "backward")
                (Camera.move-forward! cam (- 0.0 speed)))
              (when (InputManager.action-digital? input "up")
                (Camera.move-up! cam speed))
              (when (InputManager.action-digital? input "down")
                (Camera.move-up! cam (- 0.0 speed))))
            (do
              ;; Walking mode: project forward vector onto X-Z plane
              (let [f (Camera.front cam)
                    fx @(Vector3.x f)
                    fz @(Vector3.z f)
                    flen (Double.sqrt (+ (* fx fx) (* fz fz)))
                    proj-f (if (> flen 0.001)
                               (Vector3.init (/ fx flen) 0.0 (/ fz flen))
                               (Vector3.init 0.0 0.0 0.0))]
                (do
                  (when (InputManager.action-digital? input "forward")
                    (let [p-pos (ref-to-ptr (Camera.pos cam))
                          curr-pos (Pointer.to-value p-pos)]
                      (Pointer.set p-pos (Vector3.add &curr-pos &(Vector3.mul &proj-f speed)))))
                  (when (InputManager.action-digital? input "backward")
                    (let [p-pos (ref-to-ptr (Camera.pos cam))
                          curr-pos (Pointer.to-value p-pos)]
                      (Pointer.set p-pos (Vector3.sub &curr-pos &(Vector3.mul &proj-f speed)))))))))
        (when (InputManager.action-digital? input "left")
          (Camera.move-right! cam (- 0.0 speed)))
        (when (InputManager.action-digital? input "right")
          (Camera.move-right! cam speed)))))

  (defn update-look [input cam]
    (let [dx (InputManager.action-analog input "look-x")
          dy (InputManager.action-analog input "look-y")
          sensitivity 0.1
          yaw (+ @(Camera.yaw cam) (* dx sensitivity))
          ;; Notice in original, pitch dy was: (- last-y ypos) which is -dy.
          ;; InputManager dx/dy is (curr - last). So dy is inverted compared to original.
          ;; Original dy = last-y - ypos = - (ypos - last-y) = - InputManager.dy.
          ;; So we use (- @pitch (* dy sensitivity)) here to maintain the same sign.
          pitch (- @(Camera.pitch cam) (* dy sensitivity))]
      (do
        (Camera.update-yaw! cam yaw)
        (Camera.update-pitch! cam pitch))))
)

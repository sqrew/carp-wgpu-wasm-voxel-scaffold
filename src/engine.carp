(load "scaffold.carp")
(load "camera.carp")
(load "world.carp")
(load "renderer.carp")
(load "../carp-diagnostics/diagnostics.carp")

(deftype EngineState [
  eng Engine
  renderer Renderer
  world World
  camera Camera
  uniforms (Array Float)
  diag Diagnostics
  frame-count Int
])

(defmodule EngineState
  (defn create [title width height]
    (match (Engine.create title width height)
      (Result.Error e) (Result.Error (str* "Engine platform failed: " e))
      (Result.Success platform-eng)
        (match (Renderer.create &platform-eng)
          (Result.Error e) (do (Engine.cleanup platform-eng)
                               (Result.Error (str* "Renderer failed: " e)))
          (Result.Success ren)
            (let [world (World.create)
                  cam (Camera.new (Vector3.init 16.0 16.0 -20.0) -90.0 0.0 1.7777777777777777)
                  uniforms (Array.allocate 20)
                  diag (Diagnostics.new @"diagnostics.log")]
              (do
                ; Upload all chunks to world texture
                (let [chunks (World.chunks &world)
                      num-chunks (Array.length chunks)]
                  (for [i 0 num-chunks]
                    (let [chunk (Array.unsafe-nth chunks i)]
                      (Renderer.update-chunk-texture &platform-eng &ren @(Chunk.coord-x chunk) @(Chunk.coord-y chunk) @(Chunk.coord-z chunk) (Chunk.voxel-data chunk)))))
                (Camera.update-basis! &cam)
                
                (Result.Success (EngineState.init platform-eng ren world cam uniforms diag 0)))))))

  (defn draw-bounds-wireframe! [ren min-x min-y min-z max-x max-y max-z color]
    (let [w0 (Vector3.init min-x min-y min-z)
          w1 (Vector3.init max-x min-y min-z)
          w2 (Vector3.init max-x max-y min-z)
          w3 (Vector3.init min-x max-y min-z)
          w4 (Vector3.init min-x min-y max-z)
          w5 (Vector3.init max-x min-y max-z)
          w6 (Vector3.init max-x max-y max-z)
          w7 (Vector3.init min-x max-y max-z)]
      (do
        (Renderer.draw-line! ren &w0 &w1 color)
        (Renderer.draw-line! ren &w1 &w2 color)
        (Renderer.draw-line! ren &w2 &w3 color)
        (Renderer.draw-line! ren &w3 &w0 color)
        
        (Renderer.draw-line! ren &w4 &w5 color)
        (Renderer.draw-line! ren &w5 &w6 color)
        (Renderer.draw-line! ren &w6 &w7 color)
        (Renderer.draw-line! ren &w7 &w4 color)
        
        (Renderer.draw-line! ren &w0 &w4 color)
        (Renderer.draw-line! ren &w1 &w5 color)
        (Renderer.draw-line! ren &w2 &w6 color)
        (Renderer.draw-line! ren &w3 &w7 color))))

  (defn tick [state win dt first-mouse-ptr last-x-ptr last-y-ptr]
    (let [platform-eng (EngineState.eng state)
          ren (EngineState.renderer state)
          cam (EngineState.camera state)
          diag (EngineState.diag state)]
      (do
        (Diagnostics.start-zone! diag "Total Frame Time")
        
        (Diagnostics.start-zone! diag "Input & Camera")
        ; Read inputs
        (Camera.update-input win cam dt)
        (Camera.update-look win cam first-mouse-ptr last-x-ptr last-y-ptr)
        (Diagnostics.end-zone! diag "Input & Camera")
        
        ; Draw world boundary box (red)
        (let [red-color (Vector3.init 1.0 0.1 0.1)]
          (EngineState.draw-bounds-wireframe! ren 0.0 0.0 0.0 128.0 64.0 128.0 &red-color))
        
        ; Raycast from camera front vector
        (let [ro (Camera.pos cam)
              rd (Camera.front cam)
              world (EngineState.world state)
              hit-opt (World.raycast world ro rd 80.0)]
          (match hit-opt
            (Maybe.Nothing) ()
            (Maybe.Just hit-pos)
              (do
                ;; 1. Draw target highlight box (yellow)
                (let [yellow (Vector3.init 1.0 1.0 0.0)
                      hx @(Vector3.x &hit-pos)
                      hy @(Vector3.y &hit-pos)
                      hz @(Vector3.z &hit-pos)]
                  (EngineState.draw-bounds-wireframe! ren (- hx 0.5) (- hy 0.5) (- hz 0.5) (+ hx 0.5) (+ hy 0.5) (+ hz 0.5) &yellow))
                
                ;; 2. Click to carve (left button) or splat (right button)
                (let [left-pressed (= (GLFW.get-mouse-button win 0) GLFW.PRESS)
                      right-pressed (= (GLFW.get-mouse-button win 1) GLFW.PRESS)]
                  (when (or left-pressed right-pressed)
                    (let [radius 3.0
                          mat-id 2.0f
                          carve? left-pressed
                          modified-coords (World.edit-sdf! world &hit-pos radius mat-id carve?)]
                      (do
                        (for [j 0 (Array.length &modified-coords)]
                          (let [coord (Array.unsafe-nth &modified-coords j)
                                qx @(ChunkCoord.x coord)
                                qy @(ChunkCoord.y coord)
                                qz @(ChunkCoord.z coord)
                                chunk-opt (World.find-chunk world qx qy qz)]
                            (match chunk-opt
                              (Maybe.Nothing) ()
                              (Maybe.Just chunk)
                                (Renderer.update-chunk-texture platform-eng ren qx qy qz (Chunk.voxel-data &chunk))))))))))))
        
        ; Handle resizing
        (Engine.handle-resize platform-eng)
        
        (Diagnostics.start-zone! diag "Renderer & Draw")
        ; Render frame
        (Renderer.update-uniforms platform-eng ren cam (EngineState.uniforms state))
        (Renderer.draw platform-eng ren cam)
        (Diagnostics.end-zone! diag "Renderer & Draw")
        
        ; Poll events
        (Engine.poll-events platform-eng)
        
        (Diagnostics.end-zone! diag "Total Frame Time")
        
        ; Increment frame counter and print stats
        (let [p-frames (ref-to-ptr (EngineState.frame-count state))
              curr-frames (Pointer.to-value p-frames)
              next-frames (inc curr-frames)]
          (do
            (Pointer.set p-frames next-frames)
            (when (= (Int.mod next-frames 300) 0)
              (Diagnostics.print-stats! diag)))))))

  (defn cleanup [state]
    (do
      (Renderer.cleanup (EngineState.eng state) (EngineState.renderer state))
      (Engine.cleanup @(EngineState.eng state))))
)

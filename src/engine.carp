(deftype GoldBank [
  total Int
  last-gain Int
  flash Float
  slot Int
  alive (Array Bool)
  idx (Array Uint64)
  gen (Array Uint32)
  val (Array Int)
  age (Array Float)
])

(defmodule GoldBank
  (defn make []
    (GoldBank.init 0 0 0.0f 0
      (Array.replicate 16 &false)
      (Array.replicate 16 &(Uint64.from-long 0l))
      (Array.replicate 16 &(Uint32.from-long 0l))
      (Array.replicate 16 &0)
      (Array.replicate 16 &0.0f)))
)

(deftype VoxelQueue [
  count Int
  pos (Array Float)
  act (Array Float)
  dirty-count Int
  dirty-coords (Array Int)
  sync-qx Int
  sync-qy Int
  sync-qz Int
])

(defmodule VoxelQueue
  (defn make []
    (VoxelQueue.init 0
      (Array.replicate 48 &0.0f)
      (Array.replicate 48 &0.0f)
      0
      (Array.replicate 64 &0)
      0 0 0))

  (defn clear-actions! [vq]
    (VoxelQueue.set-count! vq 0))

  (defn enqueue-dirty-chunk! [vq qx qy qz ready-frame]
    (let [dc @(VoxelQueue.dirty-count vq)
          coords (VoxelQueue.dirty-coords vq)
          dup? false]
      (do
        (for [i 0 dc]
          (let [b (* i 4)]
            (when (and (= @(Array.unsafe-nth coords b) qx)
                       (and (= @(Array.unsafe-nth coords (+ b 1)) qy)
                            (= @(Array.unsafe-nth coords (+ b 2)) qz)))
              (set! dup? true))))
        (when (and (not dup?) (< dc 16))
          (let [b (* dc 4)]
            (do
              (Array.aset! coords b qx)
              (Array.aset! coords (+ b 1) qy)
              (Array.aset! coords (+ b 2) qz)
              (Array.aset! coords (+ b 3) ready-frame)
              (VoxelQueue.set-dirty-count! vq (+ dc 1))))))))

  (defn pop-ready-dirty! [vq fc]
    (let [dc @(VoxelQueue.dirty-count vq)
          coords (VoxelQueue.dirty-coords vq)
          found-idx -1]
      (do
        (for [i 0 dc]
          (when (and (< found-idx 0)
                     (>= fc @(Array.unsafe-nth coords (+ (* i 4) 3))))
            (set! found-idx i)))
        (if (< found-idx 0)
          false
          (let [fb (* found-idx 4)
                qx @(Array.unsafe-nth coords fb)
                qy @(Array.unsafe-nth coords (+ fb 1))
                qz @(Array.unsafe-nth coords (+ fb 2))
                last-idx (- dc 1)
                lb (* last-idx 4)]
            (do
              (VoxelQueue.set-sync-qx! vq qx)
              (VoxelQueue.set-sync-qy! vq qy)
              (VoxelQueue.set-sync-qz! vq qz)
              (when (< found-idx last-idx)
                (do
                  (Array.aset! coords fb @(Array.unsafe-nth coords lb))
                  (Array.aset! coords (+ fb 1) @(Array.unsafe-nth coords (+ lb 1)))
                  (Array.aset! coords (+ fb 2) @(Array.unsafe-nth coords (+ lb 2)))
                  (Array.aset! coords (+ fb 3) @(Array.unsafe-nth coords (+ lb 3)))))
              (VoxelQueue.set-dirty-count! vq last-idx)
              true))))))
)

